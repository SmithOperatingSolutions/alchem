defmodule StreamFixture do
  def main() do
    evens = Stream.iterate(0, &((&1 + 2)))
    assert((Enum.take(evens, 4) == [0, 2, 4, 6]))
    assert(((((Stream.from_index() |> Stream.map(&((&1 * &1)))) |> Stream.filter(&(((&1 % 2) == 1)))) |> Enum.take(3)) == [1, 9, 25]))
    assert(((Stream.cycle([1, 2, 3]) |> Enum.take(7)) == [1, 2, 3, 1, 2, 3, 1]))
    assert(((Stream.repeatedly(fn ->
      "x"
    end) |> Enum.take(3)) == ["x", "x", "x"]))
    assert(((Stream.unfold(1, fn n ->
      if (n > 20) do
        none
      else
        some({n, (n * 3)})
      end
    end) |> Enum.to_list()) == [1, 3, 9]))
    assert((((Stream.duplicate("ab", 2) |> Enum.join()) == "abab") and ((Stream.from_index(5) |> Enum.take(2)) == [5, 6])))
    lazy = Stream.map((1..1000000000), fn n ->
      IO.write("m#{n} ")
      (n * 10)
    end)
    IO.puts("built")
    assert((Enum.take(lazy, 2) == [10, 20]))
    IO.puts("")
    watched = Stream.each([1, 2, 3], fn n ->
      IO.write("e#{n} ")
    end)
    assert((Enum.find(watched, &((&1 == 2))) == some(2)))
    IO.puts("")
    assert((((Stream.take((1..10), 3) |> Enum.to_list()) == [1, 2, 3]) and ((Stream.take((1..5), -2) |> Enum.to_list()) == [4, 5])))
    assert((((Stream.drop((1..5), 3) |> Enum.to_list()) == [4, 5]) and ((Stream.drop((1..5), -3) |> Enum.to_list()) == [1, 2])))
    assert(((Stream.take_while((1..10), &((&1 < 4))) |> Enum.to_list()) == [1, 2, 3]))
    assert(((Stream.drop_while((1..6), &((&1 < 4))) |> Enum.to_list()) == [4, 5, 6]))
    assert((((Stream.take_every((1..10), 4) |> Enum.to_list()) == [1, 5, 9]) and ((Stream.drop_every((1..6), 2) |> Enum.to_list()) == [2, 4, 6])))
    assert(((Stream.reject((1..6), &(((&1 % 2) == 0))) |> Enum.to_list()) == [1, 3, 5]))
    assert(((Stream.map_every((1..5), 2, &((&1 * 10))) |> Enum.to_list()) == [10, 2, 30, 4, 50]))
    assert(((Stream.chunk_every((1..7), 3) |> Enum.to_list()) == [[1, 2, 3], [4, 5, 6], [7]]))
    assert(((Stream.chunk_every((1..5), 2, 1) |> Enum.take(2)) == [[1, 2], [2, 3]]))
    assert((((Stream.from_index() |> Stream.chunk_every(2)) |> Enum.take(2)) == [[0, 1], [2, 3]]))
    assert(((Stream.chunk_by([1, 1, 2, 3, 3], &(&1)) |> Enum.to_list()) == [[1, 1], [2], [3, 3]]))
    assert((((Stream.concat([1, 2], (3..4)) |> Enum.to_list()) == [1, 2, 3, 4]) and ((Stream.concat([[1], [2, 3]]) |> Enum.to_list()) == [1, 2, 3])))
    assert((((Stream.dedup([1, 1, 2, 1]) |> Enum.to_list()) == [1, 2, 1]) and ((Stream.dedup_by([1, 3, 2], &((&1 % 2))) |> Enum.to_list()) == [1, 2])))
    assert((((Stream.uniq(Stream.cycle([1, 2, 3])) |> Enum.take(3)) == [1, 2, 3]) and ((Stream.uniq_by(["a", "b", "cc"], &(String.length(&1))) |> Enum.to_list()) == ["a", "cc"])))
    assert(((Stream.flat_map((1..3), fn n ->
      [n, (- n)]
    end) |> Enum.to_list()) == [1, -1, 2, -2, 3, -3]))
    assert(((Stream.intersperse((1..3), 0) |> Enum.to_list()) == [1, 0, 2, 0, 3]))
    assert((((Stream.scan((1..4), &((&1 + &2))) |> Enum.to_list()) == [1, 3, 6, 10]) and ((Stream.scan((1..3), 10, &((&1 + &2))) |> Enum.to_list()) == [11, 13, 16])))
    assert((((Stream.with_index(["a", "b"]) |> Enum.to_list()) == [{"a", 0}, {"b", 1}]) and ((Stream.with_index(["a"], 3) |> Enum.to_list()) == [{"a", 3}])))
    assert(((Stream.zip(Stream.from_index(), ["a", "b"]) |> Enum.to_list()) == [{0, "a"}, {1, "b"}]))
    assert(((Stream.zip_with((1..3), Stream.cycle([10]), &((&1 + &2))) |> Enum.to_list()) == [11, 12, 13]))
    running = Stream.transform((1..10), 0, fn n, total ->
      if ((total + n) > 10) do
        none
      else
        some({[(total + n)], (total + n)})
      end
    end)
    assert((Enum.to_list(running) == [1, 3, 6, 10]))
    Stream.run(Stream.each((1..2), fn n ->
      IO.write("r#{n} ")
    end))
    IO.puts("")
    counted = Stream.resource(fn ->
      3
    end, fn left ->
      if (left == 0) do
        none
      else
        some({[left], (left - 1)})
      end
    end, fn _ ->
      IO.write("closed ")
    end)
    assert((Enum.to_list(counted) == [3, 2, 1]))
    assert((Enum.take(counted, 1) == [3]))
    IO.puts("")
    path = "alchem_stream_fixture.txt"
    assert((File.write(path, "one\ntwo\nthree\nfour") == ok({})))
    assert(((File.stream!(path) |> Enum.to_list()) == ["one\n", "two\n", "three\n", "four"]))
    assert(((((File.stream!(path) |> Stream.map(&(String.trim(&1)))) |> Stream.filter(&((String.length(&1) > 3)))) |> Enum.take(1)) == ["three"]))
    assert((((File.stream!(path) |> Stream.chunk_every(3)) |> Enum.map(&(length(&1)))) == [3, 1]))
    assert(((File.stream!(path, 5) |> Enum.to_list()) == ["one\nt", "wo\nth", "ree\nf", "our"]))
    assert((((File.stream!(path, 4) |> Enum.count()) == 5) and ((File.stream!(path) |> Enum.count()) == 4)))
    assert((File.remove(path) == ok({})))
    started = Time.now()
    assert((((Stream.timer(20) |> Enum.to_list()) == [0]) and ((Stream.interval(5) |> Enum.take(3)) == [0, 1, 2])))
    assert(((Time.now() - started) >= 30))
    IO.puts("stream ready")
  end
end
