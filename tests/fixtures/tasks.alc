defmodule Main do
  def fails(): integer do
    Process.sleep(20)
    raise("task broke")
  end

  def main() do
    # A linked task that fails takes its caller with it.
    watcher: pid[integer] = Process.spawn(fn(_: pid[integer]): integer do
      Task.async(fn -> fails() end)
      Process.sleep(1000)
      0
    end, 1)
    IO.inspect(Process.await(watcher, 2000))

    # A caller that traps exits hears of it instead.
    trapper: pid[integer] = Process.spawn(fn(_: pid[integer]): integer do
      Process.trap_exits(true)
      task = Task.async(fn -> fails() end)
      case Task.yield(task, 1000) do
        some(error(reason)) -> IO.puts("yield: " <> reason)
        _ -> IO.puts("unexpected")
      end
      0
    end, 1)
    IO.inspect(Process.await(trapper, 2000))

    # Under a task supervisor, async_nolink keeps failures to the task.
    tasks = Task.Supervisor.start_link()
    quiet = Task.Supervisor.async_nolink(tasks, fn -> fails() end)
    IO.inspect(Task.yield(quiet, 1000))
    fine = Task.Supervisor.async(tasks, fn -> 6 * 7 end)
    IO.inspect(Task.await(fine))
    ok(sleeper) = Task.Supervisor.start_child(tasks, fn ->
      Process.sleep(60000)
      0
    end)
    IO.inspect(length(Task.Supervisor.children(tasks)))
    IO.inspect(Task.Supervisor.terminate_child(tasks, sleeper))
    IO.inspect(Task.Supervisor.children(tasks))

    limited = Task.Supervisor.start_link([max_children: 1])
    ok(_) = Task.Supervisor.start_child(limited, fn ->
      Process.sleep(60000)
      0
    end)
    IO.inspect(Task.Supervisor.start_child(limited, fn -> 1 end))
    DynamicSupervisor.stop(limited)

    # Task.start runs a task nobody awaits; Task.start_link links it.
    started = Task.start(fn -> 5 end)
    IO.inspect(Task.await(started))
    linked = Task.start_link(fn -> 8 end)
    IO.inspect(Task.await(linked, 1000))

    # Agents can be named, and given a timeout.
    Agent.start_link(fn -> 0 end, [name: :counter])
    Agent.update(:counter, fn(n: integer): integer do n + 1 end)
    Agent.cast(:counter, fn(n: integer): integer do n + 10 end)
    IO.inspect(Agent.get(:counter, fn(n: integer): integer do n end))
    IO.inspect(Agent.get_and_update(:counter, fn(n: integer): tuple[integer, integer] do {n, n * 2} end))
    found: option[agent[integer]] = Agent.whereis(:counter)
    case found do
      some(counter) ->
        IO.inspect(Agent.get(counter, fn n -> n end, 1000))
        Agent.update(counter, fn n -> n - 2 end, 1000)
        IO.inspect(Agent.get_and_update(counter, fn n -> {n, n} end, 1000))
      none -> IO.puts("missing")
    end
    other: option[agent[string]] = Agent.whereis(:counter)
    IO.inspect(other)
    checker: pid[integer] = Process.spawn(fn(_: pid[integer]): integer do
      Agent.get(:nobody, fn(n: integer): integer do n end)
    end, 1)
    IO.inspect(Process.await(checker, 1000))
  end
end
