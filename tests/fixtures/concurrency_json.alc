defmodule ConcurrencyJson do
  def slow_square(n: integer): integer do
    Process.sleep(150)
    (n * n)
  end

  def describe(JSON.null: JSON): string do
    "null"
  end

  def describe(JSON.boolean(value)) do
    "boolean #{value}"
  end

  def describe(JSON.integer(value)) do
    "integer #{value}"
  end

  def describe(JSON.float(value)) do
    "float #{value}"
  end

  def describe(JSON.string(value)) do
    "string #{value}"
  end

  def describe(JSON.list(items)) do
    "list of #{length(items)}"
  end

  def describe(JSON.object(fields)) do
    "object with #{Enum.join(Map.keys(fields), ",")}"
  end

  def main() do
    word = Regex.compile!("([a-z]+)([0-9]+)")
    assert(((Regex.match?(word, "see ab12") and (not Regex.match?(word, "SEE"))) and String.match?("ab1", word)))
    assert(((Regex.run(word, "x ab12 cd3") == some(["ab12", "ab", "12"])) and (Regex.run(word, "none") == none)))
    assert(((Regex.scan(word, "ab12 cd3") == [["ab12", "ab", "12"], ["cd3", "cd", "3"]]) and (Regex.scan(Regex.compile!("[0-9]"), "a1b2") == [["1"], ["2"]])))
    assert(((Regex.replace(word, "ab12 cd3", "\\2\\1") == "12ab 3cd") and (Regex.split(Regex.compile!(",\\s*"), "a, b,c") == ["a", "b", "c"])))
    assert((Regex.source(word) == "([a-z]+)([0-9]+)"))
    dated = Regex.compile!("(?P<year>[0-9]{4})-(?P<month>[0-9]{2})")
    assert(((Regex.named_captures(dated, "on 2026-11") == some(%{"month" => "11", "year" => "2026"})) and (Regex.named_captures(dated, "never") == none)))
    case Regex.compile("(") do
      ok(_) ->
        assert(false)
      error(reason) ->
        assert(String.contains?(reason, "missing"))
    end
    started = Time.now()
    tasks = Enum.map([1, 2, 3, 4], fn n ->
      Task.async(fn ->
        slow_square(n)
      end)
    end)
    assert((Task.await_many(tasks) == [1, 4, 9, 16]))
    # Run one after another the four would take 600 ms.
    assert(((Time.now() - started) < 450))
    single = Task.async(fn ->
      "done"
    end)
    assert(((Task.await(single) == "done") and (Task.await(single, 100) == "done")))
    sleeper = Task.async(fn ->
      Process.sleep(60000)
    end)
    assert(((Task.yield(sleeper, 10) == none) and Task.shutdown(sleeper)))
    # A failure is observed, not passed on, by a task that is not linked.
    crashing = Task.Supervisor.async_nolink(Task.Supervisor.start_link(), fn ->
      (1 / (length([1]) - 1))
    end)
    case Task.yield(crashing, 2000) do
      some(error(reason)) ->
        assert(String.contains?(reason, "division by zero"))
      _ ->
        assert(false)
    end
    assert((Task.yield(single, 0) == some(ok("done"))))
    assert(((Task.async_stream((1..6), &(slow_square(&1))) |> Enum.to_list()) == [1, 4, 9, 16, 25, 36]))
    assert(((Task.async_stream((1..1000000), &((&1 * 2)), 2) |> Enum.take(3)) == [2, 4, 6]))
    counter = Agent.start_link(fn ->
      0
    end)
    Agent.update(counter, &((&1 + 5)))
    assert(((Agent.get(counter, &(&1)) == 5) and (Agent.get(counter, &((&1 * 2))) == 10)))
    assert(((Agent.get_and_update(counter, fn n ->
      {n, (n + 1)}
    end) == 5) and (Agent.get(counter, &(&1)) == 6)))
    workers = Enum.map((1..4), fn _ ->
      Task.async(fn ->
        Enum.each((1..25), fn _ ->
          Agent.update(counter, &((&1 + 1)))
        end)
      end)
    end)
    Enum.each(workers, &(Task.await(&1)))
    assert((Agent.get(counter, &(&1)) == 106))
    assert(((Agent.cast(counter, &((&1 - 6))) and (Agent.get(counter, &(&1)) == 100)) and Agent.stop(counter)))
    names = Agent.start(fn ->
      ["ada"]
    end)
    Agent.update(names, &((&1 ++ ["bo"])))
    assert((Agent.get(names, &(Enum.join(&1, "+"))) == "ada+bo"))
    document = JSON.object(%{"name" => JSON.string("Ada \"L\""), "age" => JSON.integer(36), "tags" => JSON.list([JSON.boolean(true), JSON.null, JSON.float(1.5)])})
    text = JSON.encode!(document)
    assert((text == "{\"age\":36,\"name\":\"Ada \\\"L\\\"\",\"tags\":[true,null,1.5]}"))
    assert(((JSON.decode(text) == ok(document)) and (JSON.decode!(" [1, 2.0, \"x\"] ") == JSON.list([JSON.integer(1), JSON.float(2.0), JSON.string("x")]))))
    case JSON.decode("{\"a\": ") do
      ok(_) ->
        assert(false)
      error(reason) ->
        assert((String.length(reason) > 0))
    end
    assert((JSON.decode("1 2") != ok(JSON.integer(1))))
    case JSON.decode!(text) do
      JSON.object(fields) ->
        assert((Map.get(fields, "age") == some(JSON.integer(36))))
        assert((Enum.map(fields, fn {key, value} ->
          "#{key}: #{describe(value)}"
        end) == ["age: integer 36", "name: string Ada \"L\"", "tags: list of 3"]))
      _ ->
        assert(false)
    end
    assert((((describe(JSON.null) == "null") and (describe(document) == "object with age,name,tags")) and (inspect(JSON.integer(1)) == "JSON.integer(1)")))
    IO.puts("concurrency and json ready")
  end
end
