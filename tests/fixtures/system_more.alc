defmodule Main do
  def main() do
    IO.inspect(elem({1, "a", true}, 1))
    IO.inspect(put_elem({1, "a", true}, 2, false))
    IO.inspect(binary_part("hello", 1, 3))
    IO.inspect(Float.ratio(0.75))
    IO.inspect(Float.max_finite() > 1.0e308)
    IO.inspect(Base.encode16("hi", [case: :lower]))
    IO.inspect(Base.encode64("a", [padding: :false]))
    IO.inspect(Base.hex_encode32("f"))
    IO.inspect(Path.type(Path.expand("a")))
    IO.inspect(Path.safe_relative("a/../b"))
    IO.inspect(Path.safe_relative("../b"))
    IO.inspect(System.convert_time_unit(2, :second, :millisecond))
    IO.inspect(System.monotonic_time(:millisecond) >= 0)
    IO.inspect(String.match?("abc", ~r/a b c # spaced/x))
    IO.inspect(Regex.run(~r/a+/U, "aaa"))
    IO.inspect(IO.ANSI.red() <> "x" <> IO.ANSI.reset())
    IO.inspect(IO.ANSI.format([red: "", text: "hi"], true))
    System.stop(3)
    IO.puts("not reached")
  end
end
