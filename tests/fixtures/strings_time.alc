defmodule StringsTime do
  def label(name: string, count: integer): string do
    return ((name <> ": ") <> Integer.to_string(count))
  end

  def shout(word: string): string do
    return (String.upcase(word) <> "!")
  end

  def main() do
    assert(((("a" <> "b") <> "c") == "abc"))
    assert((("" <> "x") == "x"))
    assert((label("total", (1 + 2)) == "total: 3"))
    assert((("n=" <> Integer.to_string(-9223372036854775808)) == "n=-9223372036854775808"))
    assert((String.length("") == 0))
    assert((String.length("héllo") == 5))
    assert((String.length("日本語") == 3))
    assert((String.slice("héllo wörld", 1, 4) == "éllo"))
    assert((String.slice("héllo", 0, 0) == ""))
    assert((String.slice("héllo", 3, 100) == "lo"))
    assert((String.slice("héllo", 5, 1) == ""))
    assert((String.slice("héllo", 99, 1) == ""))
    assert((String.slice("日本語", 1, 1) == "本"))
    assert(String.contains("haystack", "st"))
    assert((not String.contains("haystack", "needle")))
    assert(String.contains("anything", ""))
    assert((String.split("a,b,,c", ",") == ["a", "b", "", "c"]))
    assert((String.split("plain", ",") == ["plain"]))
    assert((String.split("", ",") == [""]))
    assert((String.join(["a", "b", "c"], "-") == "a-b-c"))
    assert((String.join([], "-") == ""))
    assert(((String.split("x y z", " ") |> String.join("+")) == "x+y+z"))
    assert((String.trim("  padded\t\n") == "padded"))
    assert((String.upcase("héllo wörld") == "HÉLLO WÖRLD"))
    assert((String.upcase("Straße") == "STRAßE"))
    assert((String.downcase("LOUD Ünïcode") == "loud ünïcode"))
    assert((map(["a", "b"], &shout) == ["A!", "B!"]))
    assert((Integer.to_string(0) == "0"))
    assert((Integer.parse("42") == ok(42)))
    assert((Integer.parse("-7") == ok(-7)))
    assert((Integer.parse("+5") == ok(5)))
    assert((Integer.parse("9223372036854775807") == ok(9223372036854775807)))
    assert((Integer.parse("9223372036854775808") == error("\"9223372036854775808\" is not an integer")))
    assert((Integer.parse("") == error("\"\" is not an integer")))
    assert((Integer.parse("12a") == error("\"12a\" is not an integer")))
    assert((Integer.parse(" 12") == error("\" 12\" is not an integer")))
    assert((Integer.parse("1_000") == error("\"1_000\" is not an integer")))
    assert((Integer.parse(Integer.to_string(123456789)) == ok(123456789)))
    assert((Integer.parse("a\"b") == error("\"a\\\"b\" is not an integer")))
    before = Time.monotonic()
    Process.sleep(5)
    after = Time.monotonic()
    assert((before >= 0))
    assert(((after - before) >= 4000))
    assert(((after - before) < 5000000))
    assert((Time.now() > 1700000000000))
    IO.puts(label("strings and time", String.length("ready")))
  end
end
