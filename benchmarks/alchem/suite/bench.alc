defmodule Bench do
  # Runs work twice to warm up and seven more times, then prints the case
  # name, the median and fastest time in microseconds and the value work
  # returned, separated by tabs.
  def run(name: string, work: fn[integer]): integer do
    samples = Enum.map(1..9, fn _ ->
      started = Time.monotonic()
      value = work()
      {Time.monotonic() - started, value}
    end)
    times = samples |> Enum.drop(2) |> Enum.map(fn {elapsed, _} -> elapsed end) |> Enum.sort()
    {_, check} = Enum.at(samples, 8, {0, 0})
    IO.puts("#{name}\t#{Enum.at(times, 3, 0)}\t#{Enum.at(times, 0, 0)}\t#{check}")
    0
  end
end
