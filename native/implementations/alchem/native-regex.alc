  def rx_vn(t: bytes, p: integer): integer do if Enum.at(t,p,0) < 128 do p+1 else rx_vn(t,p+1) end end
  # Every other character from lo up to hi, each a range.
  def rx_sg(lo: integer, hi: integer): bytes do
    m = lo+rx_q(rx_q(hi-lo,2),2)*2
    if lo > hi do b[] else if lo == hi do rx_r1(lo,lo) else Enum.concat(rx_sg(lo,m),rx_sg(m+2,hi)) end end
  end
  # Where the characters lo up to hi go that are among s, s+step, ..., e,
  # moved by shift; nothing when that is among lo up to hi again.
  def rx_im(o: bytes, s: integer, e: integer, shift: integer): bytes do
    step = Enum.at(o,6,0)
    a = rx_mx(rx_g(o,0),s)
    z = rx_mi(rx_g(o,3),e)
    a2 = if step == 1 do a else a+a-s-rx_q(a-s,2)*2 end
    z2 = if step == 1 do z else z-(z-s-rx_q(z-s,2)*2) end
    if a > z do b[] else if rx_mi(a2+shift-rx_g(o,0),rx_g(o,3)-z2-shift) >= 0 do b[] else if step == 1 do rx_r1(a+shift,z+shift) else rx_sg(a2+shift,z2+shift) end end end
  end
  # The partners of the characters lo up to hi among the pairs of the
  # tables from p; first: the first character of the run before.
  def rx_fi(t: bytes, lo: integer, hi: integer, p: integer, first: integer): bytes do
    s = first+rx_vv(t,p)
