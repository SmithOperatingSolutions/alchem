    if n <= 0 do b[] else if n == 1 do code else if rx_q(n,2)*2 == n do Enum.concat(h,h) else rx_j(h,h,code) end end end
  end
  # The node at c n times over.
  def rx_gc(t: bytes, c: integer, ctx: integer, nid: integer, n: integer): bytes do
    g = if n <= 0 do rx_gk(1,nid,b[]) else rx_gn(t,c,ctx,nid) end
    x = if n < 2 do g else if rx_g(g,1) == nid do g else rx_gc(t,c,ctx,nid,rx_q(n,2)) end end
    y = if n < 2 do g else if rx_g(g,1) == nid do g else rx_gc(t,c,ctx,rx_g(x,1),n-rx_q(n,2)) end end
    if n < 2 do g else
      if rx_g(g,1) == nid do rx_gk(Enum.at(g,0,0),nid,rx_dp(rx_cd(g),n)) else rx_gk(Enum.at(g,0,0),rx_g(y,1),Enum.concat(rx_cd(x),rx_cd(y))) end
    end
