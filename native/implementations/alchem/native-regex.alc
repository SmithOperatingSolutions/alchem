  def rx_g3(a: bytes, c: bytes): bytes do Enum.concat(rx_s(a,0,Enum.count(a)-10),c) end
  def rx_ga(x: bytes, y: bytes, r: bytes, k: integer, mode: integer): bytes do
    if Enum.at(r,Enum.count(r)-10,0) == 1 do rx_s(r,0,Enum.count(r)-10) else rx_ga(x,y,rx_g3(r,rx_gt(x,y,r,k,mode)),k*2,mode) end
