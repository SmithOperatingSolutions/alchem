  # The names of the groups of a tree from at up to z: per named group its
  # number (3 bytes), the length of its name (2) and the name. A step looks
  # at up to left nodes and gives where the next one starts first.
  def rx_nm(t: bytes, at: integer, z: integer, left: integer): bytes do
    op = Enum.at(t,at+3,0)
    nl = rx_h(t,at+7)
    next = if op == 8 do at+9+nl else if op == 9 do at+10 else if (op-10)*(op-11) == 0 do at+4 else if op == 12 do at+5 else at+rx_g(t,at) end end end end
    rest = if at >= z do b[] else if left == 0 do b[] else rx_nm(t,next,z,left-1) end end
    if at >= z do rx_3(z) else if left == 0 do rx_3(at) else
      if op != 8 do rest else if nl == 0 do rest else rx_j(rx_s(rest,0,3),rx_s(t,at+4,at+9+nl),rx_s(rest,3,Enum.count(rest))) end end
    end end
