  # The optional copies of node{n,m} past the n: levels i up to i+k of
  # node(node(node)?)?. o: ctx, lazy, 1 when the innermost stands bare, the
  # size of a copy and the number of levels (3 bytes each).
  def rx_gh(t: bytes, c: integer, o: bytes, nid: integer, i: integer, k: integer): bytes do
    j = rx_g(o,6)
    if k <= 1 do
      g = rx_gn(t,c,Enum.at(o,0,0),nid)
      bare = if i == j-1 do Enum.at(o,2,0) else 0 end
      Enum.concat(rx_3(rx_g(g,1)),if bare == 1 do rx_cd(g) else Enum.concat(rx_jp(7+Enum.at(o,1,0),(j-i)*(4+rx_g(o,3))-4*Enum.at(o,2,0)),rx_cd(g)) end)
    else
      x = rx_gh(t,c,o,nid,i,rx_q(k,2))
      y = rx_gh(t,c,o,rx_g(x,0),i+rx_q(k,2),k-rx_q(k,2))
      rx_j(rx_s(y,0,3),rx_s(x,3,Enum.count(x)),rx_s(y,3,Enum.count(y)))
    end
  end
  def rx_g9(t: bytes, at: integer, ctx: integer, nid: integer): bytes do
    k = Enum.at(t,at+4,0)
    lz = Enum.at(t,at+5,0)
    mn = rx_h(t,at+6)
    mx = rx_h(t,at+8)
    c = at+10
    if rx_tp(t,at) == 1 do rx_gk(1,nid,b[]) else if k < 3 do rx_gx(t,c,ctx,nid,lz,k) else
      if mx == 65535 do
