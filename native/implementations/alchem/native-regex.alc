  # Where the script k starts among those from p.
  def rx_sk(t: bytes, p: integer, k: integer): integer do
    if k == 0 do p else rx_sk(t,rx_vn(t,p)+rx_vv(t,p),k-1) end
  end
  # The ranges of table id of \p{...}.
  def rx_ut(id: integer): bytes do
    t = rx_tb()
    p = if id < 38 do 0 else if id >= 212 do 0 else rx_sk(t,rx_g(t,18),id-38) end end
    if id == 212 do b[0,0,0,255,255,16] else if id == 213 do b[0,0,0,127,0,0] else
      if id < 30 do rx_ga(t,rx_j(rx_z(id),b[1],rx_z(29-id)),rx_j(Enum.concat(b[0],rx_3(rx_g(t,12))),b[0,0,0],b[0,0,0]),1,1) else
        if id < 38 do rx_ga(t,rx_s(t,rx_g(t,15)+(id-30)*30,rx_g(t,15)+(id-29)*30),rx_j(Enum.concat(b[0],rx_3(rx_g(t,12))),b[0,0,0],b[0,0,0]),1,1) else
          rx_sv(t,rx_vn(t,p)+rx_vv(t,p),rx_sw(t,rx_vn(t,p),rx_vn(t,p)+rx_vv(t,p),0,0),b[])
        end
      end
    end end
  end
  # The characters a character folds with, itself among them.
  def rx_ob(r: integer): bytes do rx_fd(rx_r1(r,r)) end
  # The ranges of \p{...} as rx_uc read it; f: 1 under (?i), where a class
  # holds all its characters fold to, but for U+0345 in LC (table 32), which
  # Go's tables leave out.
  def rx_ur(u: bytes, f: integer): bytes do
    id = Enum.at(u,5,0)
    d = rx_ut(id)
    e = if f == 0 do d else if id == 32 do rx_ng(rx_cu(Enum.concat(rx_ng(rx_fd(d)),b[69,3,0,69,3,0]))) else rx_fd(d) end end
    if Enum.at(u,4,0) == 3 do rx_ng(e) else e end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
