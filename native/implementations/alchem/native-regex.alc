  def rx_f2(o: bytes, s: integer, e: integer, d: integer): bytes do Enum.concat(rx_im(o,s,e,d),rx_im(o,s+d,e+d,0-d)) end
  # 1 when one of the n characters at p is among lo up to hi.
  def rx_b1(t: bytes, lo: integer, hi: integer, p: integer, n: integer): integer do
    if n == 0 do 0 else if (rx_g(t,p)-lo)*(hi-rx_g(t,p)) >= 0 do 1 else rx_b1(t,lo,hi,p+3,n-1) end end
  end
  def rx_b4(t: bytes, p: integer, n: integer): bytes do
    if n == 0 do b[] else rx_j(rx_s(t,p,p+3),rx_s(t,p,p+3),rx_b4(t,p+3,n-1)) end
  end
  # The groups of three and four that fold together and hold one of lo up
  # to hi.
  def rx_bo(t: bytes, lo: integer, hi: integer, p: integer): bytes do
    n = Enum.at(t,p,0)
    if p >= rx_g(t,12) do b[] else
      if rx_b1(t,lo,hi,p+1,n) == 0 do rx_bo(t,lo,hi,p+1+n*3) else Enum.concat(rx_b4(t,p+1,n),rx_bo(t,lo,hi,p+1+n*3)) end
