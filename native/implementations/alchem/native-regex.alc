  end
  def rx_m2(x: bytes, y: bytes): bytes do rx_mg(x,0,rx_rn(x),y,0,rx_rn(y)) end
  # 2 when the ranges of d from i on are in order and apart, 1 when they
  # are in order, else 0.
  def rx_od(d: bytes, i: integer, n: integer, v: integer): integer do
    if i >= n do v else if rx_g(d,i*6) < rx_g(d,i*6-6) do 0 else rx_od(d,i+1,n,if rx_g(d,i*6) > rx_g(d,i*6-3)+1 do v else 1 end) end end
