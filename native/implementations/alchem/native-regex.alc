  def rx_gd(t: bytes, x: bytes, z: integer, cm: integer, k: integer): bytes do
    if rx_g(x,4) >= z do x else rx_gd(t,rx_gm(x,rx_gq(t,rx_g(x,4),z,cm,rx_g(x,1),k),cm),z,cm,k*2) end
  end
  def rx_gs(t: bytes, a: integer, z: integer, cm: integer, nid: integer): bytes do
    x = rx_gd(t,rx_gq(t,a,z,cm,nid,1),z,cm,1)
    if a >= z do rx_gk(1,nid,b[]) else Enum.concat(rx_s(x,0,4),rx_s(x,7,Enum.count(x))) end
  end
  # What Simplify makes of a node: 1 the empty match, 2 and 3 a star, 4 and
  # 5 a plus, 6 and 7 a quest (the odd ones lazy), 0 anything else.
  def rx_tp(t: bytes, at: integer): integer do
    op = Enum.at(t,at+3,0)
    k = Enum.at(t,at+4,0)
    lz = Enum.at(t,at+5,0)
    mn = rx_h(t,at+6)
    mx = rx_h(t,at+8)
    c = if op == 9 do rx_tp(t,at+10) else 0 end
    if op == 1 do 1 else if op != 9 do 0 else
      if k < 3 do if c == 1 do 1 else 2*k+2+lz end else
        if mn+mx == 0 do 1 else
          if mx == 65535 do if mn > 1 do 0 else if c == 1 do 1 else 2*mn+2+lz end end else
            if mn > 0 do if mx == 1 do c else 0 end else if mx > 1 do 6+lz else if c == 1 do 1 else 6+lz end end end
          end
        end
      end
    end end
  end
  # 1 when a node can match the empty string, as Go's compiler has it.
  def rx_nu(t: bytes, at: integer): integer do
    op = Enum.at(t,at+3,0)
    k = Enum.at(t,at+4,0)
    if (op-1)*(op-7) == 0 do 1 else if op == 8 do rx_nu(t,at+9+rx_h(t,at+7)) else
      if op == 9 do if rx_tp(t,at) == 1 do 1 else if (k-0)*(k-2) == 0 do 1 else if k == 1 do rx_nu(t,at+10) else if rx_h(t,at+6) == 0 do 1 else rx_nu(t,at+10) end end end end else
        if op == 10 do rx_n1(t,at+4,at+rx_g(t,at),0) else if op == 11 do rx_n1(t,at+4,at+rx_g(t,at),1) else 0 end end
      end
    end end
