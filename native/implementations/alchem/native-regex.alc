  # All that the ranges d leave out: the gaps i up to i+k of its n ranges.
  def rx_n2(d: bytes, i: integer, k: integer, n: integer): bytes do
    lo = if i == 0 do 0 else rx_g(d,i*6-3)+1 end
    hi = if i == n do 1114111 else rx_g(d,i*6)-1 end
