  def rx_z(n: integer): bytes do if n <= 0 do b[] else if n == 1 do b[0] else Enum.concat(rx_z(rx_q(n,2)),rx_z(n-rx_q(n,2))) end end end
  # The ranges of a script: n pairs of numbers from p, after the character c.
  def rx_sw(t: bytes, p: integer, z: integer, c: integer, left: integer): bytes do
    lo = c+rx_vv(t,p)
    hi = lo+rx_vv(t,rx_vn(t,p))
    if p >= z do Enum.concat(rx_3(p),rx_3(c)) else if left == 0 do Enum.concat(rx_3(p),rx_3(c)) else
      r = rx_sw(t,rx_vn(t,rx_vn(t,p)),z,hi,left-1)
