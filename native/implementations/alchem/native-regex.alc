  def rx_g7(pre: bytes, t: bytes, c: integer, o: bytes): bytes do
    g = rx_gx(t,c,Enum.at(o,0,0),rx_g(pre,1),Enum.at(o,1,0),1)
    rx_gk(Enum.at(pre,0,0)*Enum.at(g,0,0),rx_g(g,1),Enum.concat(rx_cd(pre),rx_cd(g)))
  end
  def rx_g6(pre: bytes, t: bytes, at: integer, ctx: integer): bytes do
    lz = Enum.at(t,at+5,0)
    mn = rx_h(t,at+6)
    j = rx_h(t,at+8)-mn
    tc = rx_tp(t,at+10)
    bare = if tc == 1 do 1 else if tc == 6+lz do 1 else 0 end end
    size = Enum.count(rx_gn(t,at+10,ctx,0))-4
    x = if j <= 0 do rx_3(rx_g(pre,1)) else rx_gh(t,at+10,rx_j(b[ctx,lz,bare],rx_3(size),rx_3(j)),rx_g(pre,1),0,j) end
    made = rx_gk(if mn == 0 do 1 else Enum.at(pre,0,0) end,rx_g(x,0),Enum.concat(rx_cd(pre),rx_s(x,3,Enum.count(x))))
    if j <= 0 do made else rx_go(made,ctx) end
