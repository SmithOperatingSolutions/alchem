  # The first of the ranges a up to z of d that starts at key or after it.
  def rx_lb(d: bytes, key: integer, a: integer, z: integer): integer do
    m = a+rx_q(z-a,2)
    if a >= z do a else if rx_g(d,m*6) < key do rx_lb(d,key,m+1,z) else rx_lb(d,key,a,m) end end
  end
  # The ranges xa up to xz of x and ya up to yz of y, each in order, as one
  # run in order.
  def rx_mg(x: bytes, xa: integer, xz: integer, y: bytes, ya: integer, yz: integer): bytes do
    m = xa+rx_q(xz-xa,2)
    j = rx_lb(y,rx_g(x,m*6),ya,yz)
    if ya >= yz do rx_s(x,xa*6,xz*6) else if xa >= xz do rx_s(y,ya*6,yz*6) else
      if rx_g(x,xz*6-6) <= rx_g(y,ya*6) do Enum.concat(rx_s(x,xa*6,xz*6),rx_s(y,ya*6,yz*6)) else if rx_g(y,yz*6-6) <= rx_g(x,xa*6) do Enum.concat(rx_s(y,ya*6,yz*6),rx_s(x,xa*6,xz*6)) else
        if xz-xa < yz-ya do rx_mg(y,ya,yz,x,xa,xz) else rx_j(rx_mg(x,xa,m,y,ya,j),rx_s(x,m*6,m*6+6),rx_mg(x,m+1,xz,y,j,yz)) end
