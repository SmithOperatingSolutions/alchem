  def rx_sv(t: bytes, z: integer, r: bytes, acc: bytes): bytes do
    if rx_g(r,0) >= z do Enum.concat(acc,rx_s(r,6,Enum.count(r))) else rx_sv(t,z,rx_sw(t,rx_g(r,0),z,rx_g(r,3),48),Enum.concat(acc,rx_s(r,6,Enum.count(r)))) end
