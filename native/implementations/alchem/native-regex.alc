  # A class is its ranges, six bytes each (first and last character), in
  # order and apart, as Go's cleanClass leaves them.
  def rx_rn(d: bytes): integer do rx_q(Enum.count(d),6) end
  def rx_r1(lo: integer, hi: integer): bytes do
    a = if lo < 65536 do 0 else rx_q(lo,65536) end
    c = if lo-a*65536 < 256 do 0 else rx_q(lo-a*65536,256) end
    e = if hi < 65536 do 0 else rx_q(hi,65536) end
    f = if hi-e*65536 < 256 do 0 else rx_q(hi-e*65536,256) end
    b[lo-a*65536-c*256,c,a,hi-e*65536-f*256,f,e]
