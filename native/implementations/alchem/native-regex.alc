  # What is gathered a doubling number of steps at a time: ranges, then 1
  # once it has ended and a state of nine bytes. mode 0: the ranges in
  # order x with those that meet or touch made one (state: the next range,
  # the first character of the one being made plus one, its last). mode 1:
  # the general categories of the tables x that y has a 1 for (rx_pw).
  def rx_gt(x: bytes, y: bytes, r: bytes, k: integer, mode: integer): bytes do
    e = Enum.count(r)-10
    if k <= 1 do if mode == 0 do rx_cw(x,rx_g(r,e+1),rx_g(r,e+4)-1,rx_g(r,e+7),16) else rx_pw(x,y,rx_g(r,e+1),rx_g(r,e+4),rx_g(r,e+7)-1,16) end else
      a = rx_gt(x,y,r,rx_q(k,2),mode)
      if Enum.at(a,Enum.count(a)-10,0) == 1 do a else rx_g3(a,rx_gt(x,y,a,k-rx_q(k,2),mode)) end
    end
