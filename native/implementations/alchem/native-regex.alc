  def rx_n1(t: bytes, a: integer, z: integer, any: integer): integer do
    if a >= z do 1-any else if rx_nu(t,a) == any do any else rx_n1(t,a+rx_g(t,a),z,any) end end
  end
  # 1 for a node that is one instruction taking one character.
  def rx_sc(t: bytes, at: integer): integer do
    op = Enum.at(t,at+3,0)
    if (op-3)*(op-4)*(op-5)*(op-6) == 0 do 1 else 0 end
  end
  def rx_ck(nid: integer): bytes do Enum.concat(b[18],rx_3(nid)) end
  def rx_jp(op: integer, rel: integer): bytes do Enum.concat(b[op],rx_3(rel+8388608)) end
  # node* (k 0), node+ (k 1) and node? (k 2) for the node at c.
  def rx_gx(t: bytes, c: integer, ctx: integer, nid: integer, lz: integer, k: integer): bytes do
    tc = rx_tp(t,c)
    nul = rx_nu(t,c)
    ins = if k == 0 do nul else if k == 1 do rx_mx(nul,ctx) else 0 end end
    mark = if k == 2 do 0 else rx_mx(ins,ctx) end
    g = rx_gn(t,c,if k == 2 do ctx else rx_mx(ins,ctx) end,nid+mark)
    code = rx_cd(g)
    size = Enum.count(code)
    head = if mark == 1 do rx_ck(nid) else b[] end
    aft = rx_g(g,1)
    if tc == 1 do rx_gn(t,c,ctx,nid) else if tc == 2*k+2+lz do rx_gn(t,c,ctx,nid) else
      if k == 2 do rx_go(rx_gk(1,aft,Enum.concat(rx_jp(7+lz,4+size),code)),ctx) else
        if rx_sc(t,c) == 1 do
          if k == 1 do rx_gk(0,nid+ctx,rx_j(if ctx == 1 do rx_ck(nid) else b[] end,code,Enum.concat(b[19+lz],code))) else
            if ctx == 1 do rx_gk(1,nid+1,rx_j(b[21+lz],rx_3(nid),code)) else rx_gk(1,nid,Enum.concat(b[19+lz],code)) end
          end
