  # A pattern compiled: 1, then the number of groups with the whole match,
  # where the program and the pattern's text start (3 bytes each), the
  # names (rx_nm), the text and the program. For a pattern Go's parser
  # refuses: 0, then its error's text.
  def rx_compile(s: bytes): bytes do
    n = Enum.count(s)
    k = rx_al(s,0,b[0,0,0,0])
    bad = if Enum.at(k,0,0) == 0 do k else if rx_g(k,1) < n do rx_e(12,0,n) else b[] end end
    tree = rx_nd(k)
    names = if Enum.count(bad) > 0 do b[] else rx_nn(tree,0,b[]) end
    if Enum.count(bad) > 0 do rx_j(Enum.concat(b[0,101,114,114,111,114,32,112,97,114,115,105,110,103,32,114,101,103,101,120,112,58,32],rx_ms(Enum.at(bad,1,0))),b[58,32,96],Enum.concat(rx_s(s,rx_g(bad,2),rx_g(bad,5)),b[96])) else
      rx_j(rx_j(Enum.concat(b[1],rx_3(rx_g(k,5)+1)),rx_3(9+Enum.count(names)+n),rx_3(9+Enum.count(names))),Enum.concat(names,s),Enum.concat(rx_cd(rx_gn(tree,0,0,0)),b[0]))
    end
