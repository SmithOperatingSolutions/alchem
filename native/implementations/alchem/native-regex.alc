  def rx_nn(t: bytes, at: integer, acc: bytes): bytes do
    r = rx_nm(t,at,Enum.count(t),64)
    if at >= Enum.count(t) do acc else rx_nn(t,rx_g(r,0),Enum.concat(acc,rx_s(r,3,Enum.count(r)))) end
  end
  def rx_ms(c: integer): bytes do
    if c == 1 do b[105,110,118,97,108,105,100,32,99,104,97,114,97,99,116,101,114,32,99,108,97,115,115,32,114,97,110,103,101] else if c == 2 do b[105,110,118,97,108,105,100,32,101,115,99,97,112,101,32,115,101,113,117,101,110,99,101] else if c == 3 do b[105,110,118,97,108,105,100,32,110,97,109,101,100,32,99,97,112,116,117,114,101] else if c == 4 do b[105,110,118,97,108,105,100,32,111,114,32,117,110,115,117,112,112,111,114,116,101,100,32,80,101,114,108,32,115,121,110,116,97,120] else if c == 5 do b[105,110,118,97,108,105,100,32,110,101,115,116,101,100,32,114,101,112,101,116,105,116,105,111,110,32,111,112,101,114,97,116,111,114] else if c == 6 do b[105,110,118,97,108,105,100,32,114,101,112,101,97,116,32,99,111,117,110,116] else if c == 7 do b[105,110,118,97,108,105,100,32,85,84,70,45,56] else if c == 8 do b[109,105,115,115,105,110,103,32,99,108,111,115,105,110,103,32,93] else if c == 9 do b[109,105,115,115,105,110,103,32,99,108,111,115,105,110,103,32,41] else if c == 10 do b[109,105,115,115,105,110,103,32,97,114,103,117,109,101,110,116,32,116,111,32,114,101,112,101,116,105,116,105,111,110,32,111,112,101,114,97,116,111,114] else if c == 11 do b[116,114,97,105,108,105,110,103,32,98,97,99,107,115,108,97,115,104,32,97,116,32,101,110,100,32,111,102,32,101,120,112,114,101,115,115,105,111,110] else if c == 12 do b[117,110,101,120,112,101,99,116,101,100,32,41] else if c == 13 do b[101,120,112,114,101,115,115,105,111,110,32,110,101,115,116,115,32,116,111,111,32,100,101,101,112,108,121] else b[101,120,112,114,101,115,115,105,111,110,32,116,111,111,32,108,97,114,103,101] end end end end end end end end end end end end end
