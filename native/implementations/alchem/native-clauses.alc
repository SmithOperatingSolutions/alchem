  # 1 for a value an operator takes as an integer: one, or a raise.
  def nj_integer(value: bytes): integer do
    if nc_tag(value) == 0 do 1 else if nc_tag(value) != 9 do 0 else if Enum.count(nc_kind(value)) == 1 do 1 else 0 end end end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
