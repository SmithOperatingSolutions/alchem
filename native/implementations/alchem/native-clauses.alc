  # 1 for the value of an if or case that returns on every path.
  def nj_left(value: bytes): integer do
    if nc_tag(value) != 9 do 0 else if Enum.count(nc_kind(value)) != 2 do 0 else if Enum.at(nc_kind(value),1,0) == 1 do 1 else 0 end end end
  end
  # 1 for what stands after the last arm of a case or cond (9, 2): it adds
  # nothing to the type of the arms.
  def nj_ended(value: bytes): integer do
    if nc_tag(value) != 9 do 0 else if Enum.count(nc_kind(value)) != 2 do 0 else if Enum.at(nc_kind(value),1,0) == 2 do 1 else 0 end end end
  end
  # The type of two branches that both leave a value of no known type: left
  # by return only when both are.
  def nj_both_left(first: bytes, second: bytes): bytes do
    if nj_left(first)*nj_left(second) == 1 do b[9,1] else b[9] end
  end
  # raise(message) at pos ends the program with the message and the active
  # calls. It stands for a value of any type.
  def nj_raise(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_expect(source,nc_end(source,pos),b[40])
    value = if begin < 0 do b[] else nc_expression(source,begin,env,table,depth+1) end
    stop = if nc_tag(value) != 2 do -1 else nc_expect(source,nc_pos(value),b[41]) end
    fail = if nz_on(table) == 0 do nc_exit_code(70) else nc_join(b[72,137,198],Enum.concat(b[191],nc_u32(nc_start(source,pos))),nc_call(nz_slot(table))) end
