      if is_identifier_continue(value) == 1 do nj_back(source,pos-1) else if (value-46)*(value-63)*(value-33) == 0 do nj_back(source,pos-1) else pos end end
    end
  end
  # The table for compiling a default value at a call: a failure in the
  # value names the call, whose position the first record keeps.
  def nj_from(table: bytes, pos: integer): bytes do
    nc_join(nc_slice(table,0,27),nc_u32(pos),nc_slice(table,31,Enum.count(table)))
  end
  # The argument packet with the default values of the parameters of
  # function target it leaves out. at: where the call's name ends.
  def nj_full(source: bytes, table: bytes, target: integer, args: bytes, at: integer): bytes do
    count = nc_arg_count(args)
    total = nc_argc(table,target)
    types = nc_arg_types(args)
    extra = if count == total do b[] else nj_defaults(source,nc_meta(table,target,6),nj_from(table,nj_back(source,at)),nc_join(nc_u24(0),Enum.concat(nc_u24(count),nc_u24(total)),nc_u24(target))) end
    size = nc_long(extra,0)
    if count == total do args else if Enum.count(extra) == 0 do b[] else
      nc_arg_packet(nc_pos(args),total,nc_join(nc_slice(types,0,nt_skip(types,0,count)),nc_slice(extra,4,4+size),nt_cell(Enum.concat(nw_marks(args),nc_zeros(total-count)))),Enum.concat(nc_arg_code(args),nc_slice(extra,4+size,Enum.count(extra))))
    end end
  end
  # A direct call whose argument list opens at pos: to function target, or
  # to the function of its name that takes the number of arguments given.
  # plan: target (3 bytes), then 1 when the call is from another module,
  # which only reaches a def.
  def nj_enter(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, plan: bytes): bytes do
    target = nc_cursor(plan,0)
    parsed = if Enum.at(table,target*40+21,0) == 1 do b[] else nc_arguments_open(source,nc_end(source,pos),env,table,depth) end
    first = if nc_pos(parsed) < 0 do -1 else nj_fit(source,table,target,nc_arg_count(parsed)) end
    given = nn_ranged(source,table,first,parsed,0)
    fit = nj_form(source,table,first,given)
