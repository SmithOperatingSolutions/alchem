  # The body of a clause: it ends in a value of the function's result type,
  # and a result type written on the clause is the function's. ids: the
  # function and the clause (3 bytes each).
  def nj_body(source: bytes, table: bytes, ids: bytes, scope: bytes): bytes do
    clause = nc_cursor(ids,3)
    result = nc_return_kind(source,table,nc_cursor(ids,0))
    own = nc_long(table,clause*40+22)
    agrees = if own == 0 do 1 else nt_same(nd_resolve(source,table,nc_owner(table,clause),nc_kind(nc_type(source,own))),result) end
    body = if agrees == 0 do b[] else nn_expected(nc_body(source,nc_meta(table,clause,9),nf_bodied(source,table,nc_cursor(ids,0),scope),table,16777216),result,table) end
    if nc_pos(body) < 0 do b[] else if no_compatible(result,nc_kind(body)) == 0 do b[] else
