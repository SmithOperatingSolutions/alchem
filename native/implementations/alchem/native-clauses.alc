      end
    end end
  end
  # The value with type kind when it has none of its own: a body that ends
  # in return has the type its returns were held to.
  def nj_typed(value: bytes, kind: bytes): bytes do
    if nc_tag(value) != 9 do value else nc_join(nc_slice(value,0,4),nt_cell(kind),nc_code(value)) end
  end
  # The statement return value at start: the value, then the way out of the
  # frame. Its block ends with it, and it leaves a value of no known type
  # (9, with a 1 that says a return left it), which agrees with what the
  # other branches give. In a fn whose result type
  # is not known yet it leaves its value's type, which gives the fn its type.
  def nj_return(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    scope = nj_context(env,3,b[])
    id = nc_cursor(env,0)
    wanted = if Enum.count(scope) > 0 do if Enum.at(scope,0,0) == 40 do b[] else nc_slice(scope,1,Enum.count(scope)) end else
      if Enum.at(table,id*40+21,0) == 1 do b[] else if nj_result(table,id) == 0 do b[] else nc_return_kind(source,table,id) end end
    end
    value = if Enum.count(wanted) == 0 do b[] else nc_expression(source,nc_end(source,start),if nt_tag(wanted) == 9 do env else if nw_last_call(source,nc_end(source,start)) >= 0 do nw_expect(env,nw_last_call(source,nc_end(source,start)),wanted) else nf_expecting(source,env,nc_end(source,start),wanted) end end,table,depth) end
