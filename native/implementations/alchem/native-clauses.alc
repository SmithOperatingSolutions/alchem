    if fits == 0 do b[] else if ty_ends(source,stop,env) == 0 do b[] else
      nx_pack(stop,1,Enum.concat(nc_code(tl_return(source,nc_end(source,start),env,table,depth,value)),tl_leave(source,table,nc_cursor(env,0))),nx_tail(if nt_tag(wanted) == 9 do nc_kind(value) else b[9,1] end,env))
    end end
