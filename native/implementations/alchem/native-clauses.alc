  # plan: the function (3 bytes), then its arguments.
  def nj_call(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, plan: bytes): bytes do
    target = nc_cursor(plan,0)
    parsed = nc_slice(plan,3,Enum.count(plan))
    if nu_generic(source,table,target) == 1 do nf_postfix(source,nu_call(source,env,table,depth,parsed,Enum.concat(nc_u24(target),nw_seed(source,nc_start(source,pos),env,table,target))),env,table,depth) else
      cells = nj_cells(source,table,target)
      args = if nf_has_pending(parsed,0) == 0 do parsed else nf_typed_all(source,env,table,depth,parsed,Enum.concat(nc_u24(nc_arg_count(parsed)-1),cells)) end
      if nc_pos(args) < 0 do b[] else if nj_check(cells,args,0) == 0 do b[] else
        tail = tl_at(env,nc_pos(args),target)
        called = nc_value(nc_pos(args),Enum.concat(nc_arg_code(args),tl_passed(source,env,table,nc_pos(args),nc_arg_count(args),target)),nc_return_kind(source,table,target))
        nf_postfix(source,if tail == 1 do called else ne_called(source,table,target,called) end,env,table,depth)
