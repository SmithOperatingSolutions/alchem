  # A function written as clauses: its parameters stay in their slots and
  # each clause matches them in turn.
  def nj_function(source: bytes, table: bytes, id: integer, extra: bytes): bytes do
    count = nc_argc(table,id)
    names = nu_signature(source,table,id)
    body = if nj_result(table,id) == 0 do b[] else pc_clauses(source,table,id,extra) end
    enter = tl_enter(source,table,id)
