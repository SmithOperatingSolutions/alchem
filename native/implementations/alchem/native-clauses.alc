    inside = nc_join(Enum.concat(nc_store_params(count+nu_name_count(names,0),0),enter),Enum.concat(zf_cover_in(source,table,id,nc_meta(table,id,0)),nc_code(body)),tl_leave(source,table,id))
    if nc_pos(body) < 0 do b[] else Enum.concat(nc_guard(inside),inside) end
  end
  # return value leaves the function or fn it stands in. Two kinds of record
  # with no name say where a statement stands: one of type 40 inside an if,
  # case or cond whose value is used, where return may not stand; one of
  # type 41 and a result type at the start of a fn. The last of them counts.
  def nj_mark(env: bytes, kind: bytes): bytes do
    Enum.concat(env,nc_env_record(0,0,kind))
  end
  def nj_valued(env: bytes): bytes do nj_mark(env,b[40]) end
  def nj_context(env: bytes, offset: integer, found: bytes): bytes do
    kind = nt_read(env,offset+7)
    if offset >= Enum.count(env) do found else
      nj_context(env,nc_env_next(env,offset),if (nt_tag(kind)-40)*(nt_tag(kind)-41) == 0 do kind else found end)
    end
  end
  # The environment of a fn: spec holds its declared result type, unknown
  # (9) when its body is to give it.
  def nj_scoped(env: bytes, spec: bytes): bytes do
    if Enum.count(env) == 0 do b[] else nj_mark(env,Enum.concat(b[41],if nc_tag(spec) == 9 do if Enum.count(nc_kind(spec)) > 6 do nc_slice(nc_kind(spec),6,Enum.count(nc_kind(spec))) else b[9] end else nc_kind(spec) end)) end
  end
  # The body of a fn. When its result type comes from its body and it holds
  # a return, the body is compiled again with that type for each return to
  # meet.
  def nj_lambda_body(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    first = nc_branch(source,pos,env,table,depth)
    open = if nt_tag(nc_slice(nj_context(env,3,b[]),1,2)) == 9 do 1 else 0 end
    if nc_pos(first) < 0 do first else if open == 0 do first else
      if ny_has(source,pos,nc_pos(first),b[114,101,116,117,114,110]) == 0 do first else
