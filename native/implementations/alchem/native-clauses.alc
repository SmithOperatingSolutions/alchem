defmodule NativeClauses do
  # Function definitions as the pinned language has them: functions of one
  # name with different numbers of parameters, default arguments, functions
  # written as several clauses with patterns and guards, forms of a function
  # for arguments of different types, return and raise
  # (spec/alchem-clauses.md).
  #
  # A table record of a function keeps, after its flags: where its result
  # type is written (3 bytes, 0 when it is left out), how many of its
  # parameters have default values, and where its guard starts (3 bytes, 0
  # for none). The first clause of a function has the function's record;
  # every further clause has a record of its own with flags 40, which no
  # lookup finds and which has no code.

  # The position after the pattern of a parameter.
  def nj_pattern_end(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    if byte_at(source,start) == 58 do nc_end(source,start+1) else np_skip(source,start) end
  end
  # The parameter at pos: pattern, then ": type", then "\\ value", each of
  # the last two optional. Where it ends (at its "," or ")"), where its
  # default value starts (0 for none), where its pattern ends, then its type
  # as written, empty when it has none.
  def nj_param(source: bytes, pos: integer): bytes do
    stop = nj_pattern_end(source,pos)
    typed = if stop < 0 do 0 else nc_word(source,stop,b[58]) end
    kind = if typed == 1 do nc_type(source,nc_end(source,stop)) else b[] end
    after = if typed == 1 do nc_pos(kind) else stop end
    mark = nc_start(source,after)
    given = if after < 0 do 0 else if byte_at(source,mark)*256+byte_at(source,mark+1) == 23644 do 1 else 0 end end
    value = if given == 1 do nc_start(source,mark+2) else 0 end
    last = if given == 1 do nc_span(source,nc_span_state(value,0,0,0,0),16777216) else after end
    if after < 0 do b[] else if last <= value do b[] else
      nc_join(nc_join(nc_u32(last),nc_u32(value),nc_u32(stop)),nc_kind(kind),b[])
    end end
  end
  # The position after a parameter's type: past its default value, if it has
  # one, and its "," or ")".
  def nj_after(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    if byte_at(source,start) != 92 do nc_end(source,pos) else
      if byte_at(source,start+1) != 92 do -1 else nc_end(source,nc_span(source,nc_span_state(nc_start(source,start+2),0,0,0,0),16777216)) end
    end
  end
  # The parameters from pos to the ")": the position after it, how many
  # there are and how many have a default value. One without a default
  # cannot follow one that has it, only a parameter that is a name has one,
  # and the value is a constant.
  def nj_params(source: bytes, pos: integer, count: integer, defaults: integer): bytes do
    item = nj_param(source,pos)
    next = nc_at(item)
    given = if nc_long(item,4) > 0 do 1 else 0 end
    sound = if given == 0 do 1 else nj_plain(source,nc_start(source,pos),b[0])*nj_constant(source,nc_long(item,4),next,16777216) end
    if count >= 65535 do b[] else if next < 0 do b[] else if defaults*(1-given) > 0 do b[] else if sound == 0 do b[] else
      if nc_word(source,next,b[41]) == 1 do nc_join(nc_u32(nc_end(source,next)),nc_u24(count+1),nc_u24(defaults+given)) else
        if nc_word(source,next,b[44]) == 1 do nj_params(source,nc_end(source,next),count+1,defaults+given) else b[] end
      end
    end end end end
  end
  # The do that opens a body after the guard at pos.
  def nj_guard_end(source: bytes, pos: integer, budget: integer): integer do
    start = nc_start(source,pos)
    if start < 0 do -1 else if budget == 0 do -1 else if start >= Enum.count(source) do -1 else
      if nc_opens(source,start) == 1 do start else
        if nc_word(source,start,b[101,110,100])+nc_word(source,start,b[100,101,102])+nc_word(source,start,b[100,101,102,112]) > 0 do -1 else nj_guard_end(source,nc_end(source,start),budget-1) end
      end
    end end end
  end
  # The rest of a definition after its parameters: ": type", "when guard",
  # the body. head: the positions of the name, its end and the parameters,
  # the position after them (4 bytes each), their number and the number of
  # defaults (3 bytes each).
  def nj_signature(source: bytes, pos: integer, owner: integer, head: bytes): bytes do
    after = nc_long(head,12)
    is_main = nc_word(source,nc_long(head,0),b[109,97,105,110])
    typed = nc_word(source,after,b[58])
    result = if typed == 1 do nc_type(source,nc_end(source,after)) else nc_value(after,b[],b[0]) end
    rest = nc_pos(result)
    guarded = if rest < 0 do 0 else nc_word(source,rest,b[119,104,101,110]) end
    open = if guarded == 1 do nj_guard_end(source,nc_end(source,rest),16777216) else rest end
    body = nc_expect(source,open,b[100,111])
    stop = if body < 0 do -1 else nc_body_end(source,body,16777216) end
    flags = if is_main == 1 do 1 else nc_word(source,pos,b[100,101,102,112])*16 end
    # A record holds up to 255 defaults in a byte; more are counted again
    # where they are needed (nj_defaulted).
    more = nc_record_more(if typed == 1 do nc_start(source,nc_end(source,after)) else 0 end,if nc_cursor(head,19) > 255 do 255 else nc_cursor(head,19) end,if guarded == 1 do nc_start(source,nc_end(source,rest)) else 0 end)
    if stop < 0 do b[] else if is_main*(nc_cursor(head,16)+typed+guarded+nc_word(source,pos,b[100,101,102,112])) != 0 do b[] else
      nc_record(nc_places(nc_long(head,0),nc_long(head,4),nc_long(head,8),body,stop),nc_read(head,16),flags,more,owner,nc_wide(source))
    end end
  end
  # Record index of the table when it is a function of module owner with the
  # name at pos, -1 otherwise.
  def nj_named(source: bytes, pos: integer, table: bytes, index: integer, owner: integer): integer do
    start = nc_meta(table,index,0)
    size = nc_meta(table,index,3)-start
    if Enum.at(table,index*40+21,0) >= 32 do -1 else if nc_owner(table,index) != owner do -1 else
      if nc_end(source,pos)-pos != size do -1 else if nc_equal(source,pos,start,size) == 1 do index else -1 end end
    end end
  end
  # The first function from first up to stop with the name at pos in module
  # owner, -1 when there is none.
  def nj_scan(source: bytes, pos: integer, table: bytes, first: integer, stop: integer, owner: integer): integer do
    if nc_indexed(table) == 0 do nj_scan_plain(source,pos,table,first,stop,owner) else
      found = if first >= stop do -1 else nc_index_find(source,table,nc_index_key(table,pos,nc_end(source,pos)-pos,owner,first),0) end
      if found >= stop do -1 else found end
    end
  end
  def nj_scan_plain(source: bytes, pos: integer, table: bytes, first: integer, stop: integer, owner: integer): integer do
    middle = first+nc_half(stop-first)
    if first >= stop do -1 else if stop-first == 1 do nj_named(source,pos,table,first,owner) else
      left = nj_scan_plain(source,pos,table,first,middle,owner)
      if left >= 0 do left else nj_scan_plain(source,pos,table,middle,stop,owner) end
    end end
  end
  # 1 when function id takes count arguments: all its parameters, or all but
  # some of those with defaults. exact 1 asks for all of them.
  def nj_takes(source: bytes, table: bytes, id: integer, count: integer, exact: integer): integer do
    total = nc_argc(table,id)
    if count > total do 0 else if count < total-nj_defaulted(source,table,id*40)*(1-exact) do 0 else 1 end end
  end
  # How many parameters of the record at offset have a default value.
  def nj_defaulted(source: bytes, table: bytes, at: integer): integer do
    if Enum.at(table,at+26,0) < 255 do Enum.at(table,at+26,0) else nc_cursor(nj_params(source,nc_long(table,at+8),0,0),7) end
  end
  # The function with the name and module of function target that takes
  # count arguments, -1 when none does.
  def nj_fit(source: bytes, table: bytes, target: integer, count: integer): integer do
    if target < 0 do -1 else if nj_takes(source,table,target,count,0) == 1 do target else nj_fit_from(source,table,target,count,b[0,0,0,0]) end end
  end
  # plan: where to look from (3 bytes) and exact.
  def nj_fit_from(source: bytes, table: bytes, target: integer, count: integer, plan: bytes): integer do
    other = nj_scan(source,nc_meta(table,target,0),table,nc_cursor(plan,0),nc_records(Enum.count(table)),nc_owner(table,target))
    if other < 0 do -1 else if nj_takes(source,table,other,count,Enum.at(plan,3,0)) == 1 do other else
      nj_fit_from(source,table,target,count,Enum.concat(nc_u24(other+1),b[Enum.at(plan,3,0)]))
    end end
  end
  # 1 when no other function has the name and module of function id.
  def nj_alone(source: bytes, table: bytes, id: integer): integer do
    count = nc_records(Enum.count(table))
    first = nj_scan(source,nc_meta(table,id,0),table,0,count,nc_owner(table,id))
    if nj_scan(source,nc_meta(table,id,0),table,first+1,count,nc_owner(table,id)) < 0 do 1 else 0 end
  end
  # 1 when record index of the table is a clause of a function with the name,
  # module and number of parameters of record.
  def nj_same(source: bytes, table: bytes, index: integer, record: bytes): integer do
    flags = if index < 0 do 1 else Enum.at(table,index*40+21,0) end
    start = nc_meta(table,index,0)
    size = nc_meta(table,index,3)-start
    if flags*(flags-16)*(flags-40) != 0 do 0 else if nc_owner(table,index) != nc_long(record,32) do 0 else
      if nc_argc(table,index) != nc_argc(record,0) do 0 else
        if nc_meta(record,0,3)-nc_meta(record,0,0) != size do 0 else nc_equal(source,nc_meta(record,0,0),start,size) end
      end
    end end
  end
  # The first clause of the function that clause index belongs to.
  def nj_head(table: bytes, index: integer): integer do
    if Enum.at(table,index*40+21,0) >= 40 do nj_head(table,index-1) else index end
  end
  # The clause after clause id of its function, -1 when it is the last. The
  # records of structs and sum types declared between two clauses lie
  # between theirs, since records are in source order.
  def nj_more(table: bytes, id: integer): integer do
    flags = Enum.at(table,id*40+61,0)
    if flags == 40 do id+1 else if flags >= 64 do nj_more(table,id+1) else -1 end end
  end
  # 1 when a function from record first on has the record's name and takes
  # a number of arguments that the record's function takes too.
  def nj_clash(source: bytes, table: bytes, record: bytes, first: integer): integer do
    nj_clash_before(source,table,record,first,nc_records(Enum.count(table)))
  end
  # The same among the records before record stop.
  def nj_clash_before(source: bytes, table: bytes, record: bytes, first: integer, stop: integer): integer do
    other = nj_scan(source,nc_meta(record,0,0),table,first,stop,nc_long(record,32))
    high = nc_argc(record,0)
    top = nc_argc(table,other)
    if other < 0 do 0 else
      if high-nj_defaulted(source,record,0) > top do nj_clash_before(source,table,record,other+1,stop) else
        if top-nj_defaulted(source,table,other*40) > high do nj_clash_before(source,table,record,other+1,stop) else 1 end
      end
    end
  end
  # The last record up to index that is no struct or sum type: those may
  # stand between the clauses of a function.
  def nj_last_clause(table: bytes, index: integer): integer do
    if index < 0 do -1 else if Enum.at(table,index*40+21,0) >= 64 do nj_last_clause(table,index-1) else index end end
  end
  # The table of count records with the record added, b[] when it may not
  # stand where it does: as it is for a new function or one that begins
  # another form, with flags 40 as a further clause of the function declared
  # last. Clauses are adjacent, have parameters and are all def or all defp;
  # two functions of one name take different numbers of arguments.
  def nj_place(source: bytes, table: bytes, record: bytes, count: integer): bytes do
    last = nj_last_clause(table,count-1)
    if nj_same(source,table,last,record) == 1 do
      if nc_argc(record,0) == 0 do b[] else if Enum.at(table,nj_head(table,last)*40+21,0) != Enum.at(record,21,0) do b[] else
        # A clause that declares another type for a parameter begins another form.
        Enum.concat(table,if nj_other_form(source,table,nj_head(table,last),record,0) == 1 do record else nc_join(nc_slice(record,0,21),b[40],nc_slice(record,22,40)) end)
      end end
    else
      if nj_clash(source,table,record,0) == 1 do b[] else Enum.concat(table,record) end
    end
  end
  # A function may be defined for arguments of different types: clauses of
  # one name and number of parameters whose declared types differ are forms
  # of it, each a function with a record of its own, one after another. A
  # call takes the first form its arguments fit.
  #
  # What the clause whose parameters start at pos declares of parameter
  # index: where its type is written (4 bytes, 0 when a literal gives it),
  # then the type; empty when the clause declares none.
  def nj_declared(source: bytes, pos: integer, index: integer): bytes do
    item = nj_param(source,pos)
    written = nc_slice(item,12,Enum.count(item))
    kind = if Enum.count(written) == 0 do nj_literal(source,pos) else written end
    if Enum.count(item) == 0 do b[] else
      if index > 0 do nj_declared(source,nc_end(source,nc_at(item)),index-1) else
        if Enum.count(kind) == 0 do b[] else Enum.concat(nc_u32(if Enum.count(written) == 0 do 0 else nc_start(source,nc_end(source,nc_long(item,8))) end),kind) end
      end
    end
  end
  # 1 when the texts from first up to stop and from other up to last hold the
  # same tokens.
  def nj_same_text(source: bytes, first: integer, stop: integer, other: integer, last: integer): integer do
    left = nc_start(source,first)
    right = nc_start(source,other)
    size = nc_end(source,left)-left
    if left >= nc_start(source,stop) do if right >= nc_start(source,last) do 1 else 0 end else if right >= nc_start(source,last) do 0 else
      if nc_end(source,right)-right != size do 0 else if nc_equal(source,left,right,size) == 0 do 0 else nj_same_text(source,nc_end(source,left),stop,nc_end(source,right),last) end end
    end end
  end
  # 1 when two declared types are one type: the same text when both are
  # written, as the pinned compiler compares them.
  def nj_alike(source: bytes, one: bytes, two: bytes): integer do
    first = nc_long(one,0)
    second = nc_long(two,0)
    if first*second == 0 do nt_same(nc_slice(one,4,Enum.count(one)),nc_slice(two,4,Enum.count(two))) else
      nj_same_text(source,first,nc_pos(nc_type(source,first)),second,nc_pos(nc_type(source,second)))
    end
  end
  # What the clauses of a form from clause on declare of parameter index.
  def nj_form_declared(source: bytes, table: bytes, clause: integer, index: integer): bytes do
    own = nj_declared(source,nc_meta(table,clause,6),index)
    if Enum.count(own) > 0 do own else if nj_more(table,clause) < 0 do b[] else nj_form_declared(source,table,nj_more(table,clause),index) end end
  end
  # 1 when the record's clause declares, from parameter index on, another
  # type than the clauses of the form at head declare.
  def nj_other_form(source: bytes, table: bytes, head: integer, record: bytes, index: integer): integer do
    mine = if index >= nc_argc(record,0) do b[] else nj_declared(source,nc_meta(record,0,6),index) end
    theirs = if Enum.count(mine) == 0 do b[] else nj_form_declared(source,table,head,index) end
    if index >= nc_argc(record,0) do 0 else
      if Enum.count(theirs) == 0 do nj_other_form(source,table,head,record,index+1) else
        if nj_alike(source,mine,theirs) == 1 do nj_other_form(source,table,head,record,index+1) else 1 end
      end
    end
  end
  def nj_record(table: bytes, id: integer): bytes do nc_slice(table,id*40,id*40+40) end
  # The last clause of the function whose clause id is.
  def nj_last_of(table: bytes, id: integer): integer do
    if nj_more(table,id) < 0 do id else nj_last_of(table,nj_more(table,id)) end
  end
  # The first record from index on that is no struct or sum type.
  def nj_next_clause(table: bytes, index: integer): integer do
    if Enum.at(table,index*40+21,0) >= 64 do nj_next_clause(table,index+1) else index end
  end
  # The form after form id of its function, -1 when it is the last.
  def nj_next_form(source: bytes, table: bytes, id: integer): integer do
    next = nj_next_clause(table,nj_last_of(table,id)+1)
    if next >= nc_records(Enum.count(table)) do -1 else if Enum.at(table,next*40+21,0) == 40 do -1 else if nj_same(source,table,next,nj_record(table,id)) == 1 do next else -1 end end end
  end
  # The first form of the function that form id belongs to.
  def nj_first_form(source: bytes, table: bytes, id: integer): integer do
    before = nj_last_clause(table,id-1)
    if nj_same(source,table,before,nj_record(table,id)) == 1 do nj_first_form(source,table,nj_head(table,before)) else id end
  end
  # 1 when function id is one of several forms.
  def nj_formed(source: bytes, table: bytes, id: integer): integer do
    if nj_first_form(source,table,id) != id do 1 else if nj_next_form(source,table,id) < 0 do 0 else 1 end end
  end
  # The first form from form id on that takes the arguments, by their number
  # and types; an argument that is a function still to be typed fits.
  def nj_form_from(source: bytes, table: bytes, id: integer, args: bytes): integer do
    if id < 0 do -1 else
      if nj_takes(source,table,id,nc_arg_count(args),0)*Enum.count(nu_arguments(nj_cells(source,table,id),args,b[],0))*nf_arities(source,nj_cells(source,table,id),args,0) > 0 do id else
        nj_form_from(source,table,nj_next_form(source,table,id),args)
      end
    end
  end
  # The form of function id that the arguments fit: id when it has one form.
  def nj_form(source: bytes, table: bytes, id: integer, args: bytes): integer do
    if id < 0 do -1 else if nj_formed(source,table,id) == 0 do id else nj_form_from(source,table,nj_first_form(source,table,id),args) end end
  end
  # What a trace adds to the name of form id: nothing for the first form of
  # a function, #2 for the second and so on, as the pinned runtime names them.
  def nj_form_suffix(source: bytes, table: bytes, id: integer): bytes do
    first = nj_first_form(source,table,id)
    if first == id do b[] else Enum.concat(b[35],ny_digits(nj_form_number(source,table,first,id,1))) end
  end
  def nj_form_number(source: bytes, table: bytes, form: integer, id: integer, number: integer): integer do
    if form < 0 do number else if form >= id do number else nj_form_number(source,table,nj_next_form(source,table,form),id,number+1) end end
  end
  # 1 when a form before form id, from form other on, declares the same
  # parameter types.
  def nj_twice(source: bytes, table: bytes, id: integer, other: integer): integer do
    if other < 0 do 0 else if other >= id do 0 else
      if nt_same(nj_cells(source,table,other),nj_cells(source,table,id)) == 1 do 1 else nj_twice(source,table,id,nj_next_form(source,table,other)) end
    end end
  end
  # The function of the name of function id with exactly count parameters,
  # for a reference that gives its arity; id itself when it gives none.
  def nj_aimed(source: bytes, table: bytes, id: integer, count: integer): integer do
    if id < 0 do -1 else if count < 0 do id else nj_fit_from(source,table,id,count,b[0,0,0,1]) end end
  end
  # 1 for the flags of a record that has no code: a module header or a
  # further clause.
  def nj_silent(flags: integer): integer do
    if (flags-32)*(flags-40) == 0 do 1 else 0 end
  end
  # Where the result type of function id is written, in its first clause
  # that has one; 0 when none has.
  def nj_result(table: bytes, id: integer): integer do
    own = nc_long(table,id*40+22)
    if own > 0 do own else if nj_more(table,id) < 0 do 0 else nj_result(table,nj_more(table,id)) end end
  end
  # The type a literal pattern gives its parameter, none for other patterns.
  def nj_literal(source: bytes, pos: integer): bytes do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    if is_digit(value) == 1 do b[0] else if value == 45 do b[0] else if value == 34 do b[2] else if value == 58 do b[22] else
      if nc_word(source,start,b[116,114,117,101])+nc_word(source,start,b[102,97,108,115,101]) == 1 do b[3] else b[] end
    end end end end
  end
  # The types of the count parameters from pos on as one clause gives them,
  # as a type list: an entry is empty for a parameter the clause gives none.
  def nj_clause_cells(source: bytes, pos: integer, count: integer, table: bytes, owner: integer): bytes do
    item = if count == 0 do b[] else nj_param(source,pos) end
    written = nc_slice(item,12,Enum.count(item))
    kind = if Enum.count(written) == 0 do nj_literal(source,pos) else nd_resolve(source,table,owner,written) end
    if count == 0 do b[] else if Enum.count(item) == 0 do b[] else
      Enum.concat(nt_cell(kind),nj_clause_cells(source,nc_end(source,nc_at(item)),count-1,table,owner))
    end end
  end
  # Two type lists as one: each entry from first, or from second where first
  # has none.
  def nj_merge(first: bytes, second: bytes, at: integer, other: integer): bytes do
    one = nt_read(first,at)
    two = nt_read(second,other)
    if at >= Enum.count(first) do b[] else
      Enum.concat(nt_cell(if Enum.count(one) == 0 do two else one end),nj_merge(first,second,nt_after(first,at),nt_after(second,other)))
    end
  end
  def nj_fill(source: bytes, table: bytes, clause: integer, cells: bytes): bytes do
    if clause < 0 do cells else
      nj_fill(source,table,nj_more(table,clause),nj_merge(cells,nj_clause_cells(source,nc_meta(table,clause,6),nc_argc(table,clause),table,nc_owner(table,clause)),0,0))
    end
  end
  # The types of the parameters of function id, as a type list: each from the
  # first clause that gives it one.
  def nj_cells(source: bytes, table: bytes, id: integer): bytes do
    first = nj_clause_cells(source,nc_meta(table,id,6),nc_argc(table,id),table,nc_owner(table,id))
    if nj_more(table,id) < 0 do first else nj_fill(source,table,nj_more(table,id),first) end
  end
  # 1 when each argument of the packet fits its parameter's type.
  def nj_check(cells: bytes, args: bytes, index: integer): integer do
    if index == nc_arg_count(args) do 1 else
      if no_compatible(nt_item(cells,index),nc_arg_kind(args,index)) == 0 do 0 else nj_check(cells,args,index+1) end
    end
  end
  # 1 when the text from pos up to stop is a constant as a default value may
  # be: literals and operators, with no name but true, false, none, some, ok
  # and error, so nothing is called and no binding read. A name before a
  # colon is a key, one after a colon an atom, one after @ a constant, one
  # after % or a dot the name of a struct.
  def nj_constant(source: bytes, pos: integer, stop: integer, budget: integer): integer do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    next = nc_end(source,start)
    words = nc_word(source,start,b[116,114,117,101])+nc_word(source,start,b[102,97,108,115,101])+nc_word(source,start,b[110,111,110,101])+nc_word(source,start,b[115,111,109,101])+nc_word(source,start,b[111,107])+nc_word(source,start,b[101,114,114,111,114])+nc_word(source,start,b[110,111,116])+nc_word(source,start,b[97,110,100])+nc_word(source,start,b[111,114])+nc_word(source,start,b[105,110])
    named = if classify_ascii(value) != 2 do 0 else if (byte_at(source,start-1)-58)*(byte_at(source,start-1)-64)*(byte_at(source,start-1)-37)*(byte_at(source,start-1)-46) == 0 do 0 else if byte_at(source,next) == 58 do 0 else 1-words end end end
    text = if value == 34 do nj_text_constant(source,start+1,next) else if value == 126 do sg_sigil_constant(source,start,0) else 1 end end
    if start < 0 do 0 else if start >= stop do 1 else if budget == 0 do 0 else
      if named == 1 do 0 else if text == 0 do 0 else nj_constant(source,next,stop,budget-1) end end
    end end end
  end
  # The same for the text of a string from pos up to stop: every #{...} in
  # it holds a constant.
  def nj_text_constant(source: bytes, pos: integer, stop: integer): integer do
    at = ns_plain_run(source,pos,64)
    value = byte_at(source,at)
    close = if value == 35 do if byte_at(source,at+1) == 123 do np_close(source,at+2,1,100000) else at+1 end else at+1 end
    if at >= stop-1 do 1 else if close < 0 do 0 else
      if value == 92 do nj_text_constant(source,at+2,stop) else
        if value != 35 do nj_text_constant(source,if at == pos do at+1 else at end,stop) else
          if close == at+1 do nj_text_constant(source,close,stop) else
            if nj_constant(source,at+2,close-1,16777216) == 0 do 0 else nj_text_constant(source,close,stop) end
          end
