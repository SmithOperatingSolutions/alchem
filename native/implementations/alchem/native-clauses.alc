  # The parameters of a clause from pos on. plan as for nj_slots.
  def nj_patterns(source: bytes, pos: integer, env: bytes, table: bytes, plan: bytes): bytes do
    index = nc_cursor(plan,0)
    if index == nc_cursor(plan,3) do np_pack(pos,b[0,0,0,0],env) else
      one = nj_pattern(source,pos,env,table,Enum.concat(nc_u24(index),nt_item(nc_slice(plan,6,Enum.count(plan)),index)))
      rest = if nc_pos(one) < 0 do b[] else nj_patterns(source,nc_pos(one),np_env(one),table,Enum.concat(nc_u24(index+1),nc_slice(plan,3,Enum.count(plan)))) end
      if nc_pos(rest) < 0 do b[] else np_pack(nc_pos(rest),nj_both(np_tree(one),np_tree(rest)),np_env(rest)) end
    end
