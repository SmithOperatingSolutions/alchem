  # 1 when function id is compiled clause by clause: it has more than one,
  # or its only one has a guard.
  def nj_clausal(table: bytes, id: integer): integer do
    if nj_more(table,id) >= 0 do 1 else if nc_long(table,id*40+27) > 0 do 1 else 0 end end
  end
  # 1 when the parameter at start is a plain name, which is the parameter's
  # own slot: not _, a literal, a constructor or, for an option, none.
  def nj_plain(source: bytes, start: integer, kind: bytes): integer do
    next = nc_end(source,start)
    first = byte_at(source,start)
    if nc_identifier(source,start) == 0 do 0 else if nc_word(source,start,b[95]) == 1 do 0 else if (first-65)*(90-first) >= 0 do 0 else
      if nc_word(source,next,b[40])+nc_word(source,next,b[46]) > 0 do 0 else
        if nc_word(source,start,b[110,111,110,101]) == 1 do if nt_tag(kind) == 4 do 0 else 1 end else 1 end
      end
    end end end
  end
  # The environment with a slot for each parameter of a clause: under its
  # name for a plain name, under no name for a pattern. plan: the parameter
  # at pos and their number, then their types.
  def nj_slots(source: bytes, pos: integer, env: bytes, plan: bytes): bytes do
    index = nc_cursor(plan,0)
    kind = nt_item(nc_slice(plan,6,Enum.count(plan)),index)
    item = if index == nc_cursor(plan,3) do b[] else nj_param(source,pos) end
    start = nc_start(source,pos)
    if index == nc_cursor(plan,3) do env else if Enum.count(item) == 0 do b[] else
      bound = if nj_plain(source,start,kind) == 1 do nc_bind(source,start,env,kind) else np_hidden(env,start,kind) end
      if Enum.count(bound) == 0 do b[] else nj_slots(source,nc_end(source,nc_at(item)),bound,Enum.concat(nc_u24(index+1),nc_slice(plan,3,Enum.count(plan)))) end
    end end
  end
  # Matched parameters travel as: the length of their trees (2 bytes), the
  # trees one after another, then the code that matches them, which leaves 1
  # or 0 in AL and is empty when they match everything.
  def nj_trees(packed: bytes): bytes do nc_slice(packed,4,4+nc_long(packed,0)) end
  def nj_match(packed: bytes): bytes do nc_slice(packed,4+nc_long(packed,0),Enum.count(packed)) end
  def nj_both(left: bytes, right: bytes): bytes do
    first = nj_match(left)
    second = nj_match(right)
    code = if Enum.count(first) == 0 do second else if Enum.count(second) == 0 do first else nc_join(first,Enum.concat(b[132,192,15,132],nc_u32(Enum.count(second))),second) end end
    nc_join(nc_u32(nc_long(left,0)+nc_long(right,0)),Enum.concat(nj_trees(left),nj_trees(right)),code)
  end
  # One parameter of a clause against its slot. spec: its index, then its
  # type. A type written here must be the parameter's.
  def nj_pattern(source: bytes, pos: integer, env: bytes, table: bytes, spec: bytes): bytes do
    kind = nc_slice(spec,3,Enum.count(spec))
    start = nc_start(source,pos)
    item = nj_param(source,pos)
    agrees = if Enum.count(item) <= 12 do 1 else nt_same(nd_resolve(source,table,nc_owner(table,nc_cursor(env,0)),nc_slice(item,12,Enum.count(item))),kind) end
    parsed = if Enum.count(item) == 0 do b[] else if nj_plain(source,start,kind) == 1 do np_pack(nc_long(item,8),b[0],env) else np_parse(source,start,env,table,kind) end end
    tree = np_tree(parsed)
    whole = if nc_pos(parsed) < 0 do 0 else if nc_start(source,nc_pos(parsed)) != nc_start(source,nc_long(item,8)) do 0 else agrees end end
    test = if whole == 0 do b[] else if Enum.at(tree,0,0) == 0 do b[176,1] else np_emit(source,np_env(parsed),table,tree,0) end end
    match = if Enum.at(tree,0,0) == 0 do b[] else Enum.concat(nc_slot(b[72,139,69],nc_cursor(spec,0)),test) end
    if Enum.count(test) == 0 do b[] else
      np_pack(nc_end(source,nc_at(item)),nc_join(nc_u32(Enum.count(tree)),tree,match),np_env(parsed))
