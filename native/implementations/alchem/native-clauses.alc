  # 1 when no name from pos up to stop starts with a capital: a struct or a
  # sum variant is no default value at a call.
  def nj_lower(source: bytes, pos: integer, stop: integer, budget: integer): integer do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    if start < 0 do 0 else if start >= stop do 1 else if budget == 0 do 0 else
      if (value-65)*(90-value) >= 0 do 0 else nj_lower(source,nc_end(source,start),stop,budget-1) end
    end end end
  end
  # The default values of the parameters of a function from one of them on,
  # as arguments: the length of their types (2 bytes), their types as a type
  # list, then the code that pushes them. plan: the parameter at pos, the
  # first to give, their number, and the function (3 bytes).
  def nj_defaults(source: bytes, pos: integer, table: bytes, plan: bytes): bytes do
    index = nc_cursor(plan,0)
    wanted = if index < nc_cursor(plan,3) do 0 else 1 end
    item = if index == nc_cursor(plan,6) do b[] else nj_param(source,pos) end
    begin = nc_long(item,4)
    value = if wanted == 0 do b[] else if begin == 0 do b[] else if nj_lower(source,begin,nc_at(item),16777216) == 0 do b[] else nc_expression(source,begin,nc_slice(plan,9,12),table,0) end end end
    whole = if wanted == 0 do 1 else if nc_pos(value) < 0 do 0 else if nc_start(source,nc_pos(value)) == nc_at(item) do 1 else 0 end end end
    if index == nc_cursor(plan,6) do b[0,0,0,0] else if Enum.count(item) == 0 do b[] else if whole == 0 do b[] else
      rest = nj_defaults(source,nc_end(source,nc_at(item)),table,Enum.concat(nc_u24(index+1),nc_slice(plan,3,12)))
      cell = if wanted == 0 do b[] else nt_cell(nc_kind(value)) end
      push = if wanted == 0 do b[] else Enum.concat(nc_code(value),b[80]) end
      if Enum.count(rest) == 0 do b[] else
        nc_join(nc_u32(Enum.count(cell)+nc_long(rest,0)),Enum.concat(cell,nc_slice(rest,4,4+nc_long(rest,0))),Enum.concat(push,nc_slice(rest,4+nc_long(rest,0),Enum.count(rest))))
