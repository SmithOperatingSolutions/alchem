  # 3: zf_cover_text) is counted where the table says the capture stands.
  def zf_cover_fn(source: bytes, table: bytes, env: bytes, plan: bytes, shaped: integer): bytes do
    flag = Enum.at(table,20,0)
    if flag < 2 do b[] else
      if Enum.at(plan,0,0) == 0 do if shaped == 0 do b[] else if nc_cursor(plan,4) == 0 do b[] else zf_cover(source,table,env,nc_cursor(plan,4)) end end else
