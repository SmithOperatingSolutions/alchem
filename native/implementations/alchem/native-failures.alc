    if word >= stop do b[] else
      if zf_same(code,word*4,call,0) == 0 do zf_arm_sites_run(code,call,word+1,stop) else
        nc_join(nc_u32(word*4+Enum.count(call)-9),nc_slice(code,word*4+Enum.count(call),word*4+Enum.count(call)+4),zf_arm_sites_run(code,call,word+1,stop))
      end
    end
  end
  # What a call stands as before its word, in the code that is compiled.
  def zf_cover_site(table: bytes): bytes do
    call = zf_cover_call(table,0)
    nc_slice(call,0,Enum.count(call)-4)
  end
  # The pinned compiler makes a cond nested ifs, each a statement of its own
  # on its arm's line, and counts no statement where the cond stands: the
  # statement that starts with one counts nothing here (nk_cond_arms counts
  # the arms).
  def zf_cover_step(source: bytes, table: bytes, env: bytes, pos: integer): bytes do
    if Enum.at(table,20,0) != 2 do b[] else if nc_word(source,pos,b[99,111,110,100])*nc_word(source,nc_end(source,pos),b[100,111]) == 1 do b[] else if zf_asserting(source,pos) == 1 do b[] else zf_cover(source,table,env,pos) end end end
  end
  # 1 for a statement the rewriting of an assert made inside the one that
  # stands for it (tm_: case left do l -> case T.__as(l, right) do r -> if
  # not (l op r) do flunk(...) end end end, or if not (...) do flunk(...)
  # end): the pinned compiler counts the assert alone.
  def zf_asserting(source: bytes, pos: integer): integer do
    if nc_word_at(source,pos,b[99,97,115,101,32,84,127,46,95,95,97,115,40],0)+nc_word_at(source,pos,b[105,102,32,110,111,116,32,40,108,127,32],0) > 0 do 1 else
      if nc_word_at(source,pos,b[102,108,117,110,107,40,34,97,115,115,101,114,116,105,111,110,32,102,97,105,108,101,100],0) == 0 do 0 else if mx_stop(source) == Enum.count(source) do 0 else zf_placed(mx_part(source,0),pos) end end
    end
