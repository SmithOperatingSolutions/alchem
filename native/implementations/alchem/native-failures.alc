  # body of a for that is a statement or ends in a call without a value, and
  # the body and the arms of a try that is a statement. last: where the last
  # statement starts; a block that ends in {} has it already.
  def zf_unit(source: bytes, table: bytes, env: bytes, value: bytes, last: integer): bytes do
    count = if nc_pos(value) < 0 do b[] else if last < 0 do b[] else if byte_at(source,last)*256+byte_at(source,nc_start(source,last+1)) == 31613 do b[] else zf_cover(source,table,env,last) end end end
    if Enum.count(count) == 0 do value else Enum.concat(nc_slice(value,0,nt_after(value,4)),Enum.concat(nc_code(value),count)) end
  end
  # Sys.panic(text): the library fails as the pinned runtime's own panics do.
  def zf_panic_call(table: bytes, args: bytes): bytes do
    if nc_pos(args) < 0 do b[] else if nc_arg_count(args) != 1 do b[] else if nt_tag(nc_arg_kind(args,0)) != 2 do b[] else if nz_on(table) == 0 do b[] else
      nc_value(nc_pos(args),nc_join(nc_arg_code(args),b[94,191,254,255,255,127],nc_call(nz_slot(table))),b[0])
    end end end end
  end
  # String.slice's bounds before the grapheme runtime (spec/failures-x86_64.s).
  def zf_slice_check(): bytes do if nc_a64() == 1 do zf_slice_check_marked() else zf_slice_check_plain() end end
