  end
  # An if, unless, case or with used as a value is a statement of its own to
  # the pinned compiler, where it stands.
  def zf_valued(source: bytes, table: bytes, env: bytes, value: bytes, pos: integer): bytes do
    count = if Enum.at(table,20,0) != 2 do b[] else if nc_pos(value) < 0 do b[] else zf_cover(source,table,env,pos) end end
    if Enum.count(count) == 0 do value else Enum.concat(nc_slice(value,0,nt_after(value,4)),Enum.concat(count,nc_code(value))) end
  end
  # The first module of the program: the one whose tests run.
  def zf_entry(table: bytes, index: integer): integer do
    if index >= nc_records(Enum.count(table)) do -1 else if Enum.at(table,index*40+21,0) == 32 do index else zf_entry(table,index+1) end end
  end
  # Sys.cover(): the address of the coverage routine and what follows it, 0
  # in a program that counts nothing.
  def zf_cover_at(table: bytes): bytes do
    if Enum.at(table,20,0) != 2 do b[49,192] else Enum.concat(b[72,139,4,37],nc_u32(4195456+zf_cover_slot(table)*8)) end
  end
  # The routine as an extra table entry, slot functions+8: its code (the word
  # at 4 says how long it is), then the address of the trace routine's
  # table slot and that routine's length (the tables of places follow it),
  # the number of statements counted and their positions, 32 bits each, as
  # the calls stand in the code.
  def zf_shared(shared: bytes, table: bytes, code: bytes): bytes do
    # On ARM64 the routine and the trace routine are their translations, and
    # the blob is ARM64 code with its data (xa_raw); where the calls stand is
    # put in once the code is translated (zf_cover_arm_points).
    routine = if nc_a64() == 1 do cv_blob_arm() else zf_cover_code() end
    call = zf_cover_site(table)
    points = if Enum.at(table,20,0) != 2 do b[] else zf_points(code,call,0,Enum.count(code)-Enum.count(call)-3) end
    head = nc_join(nc_slice(routine,0,4),nc_u32(Enum.count(routine)),nc_slice(routine,8,Enum.count(routine)))
    trace = if nc_a64() == 1 do Enum.count(tr_blob_arm()) else Enum.count(tr_blob()) end
    # Where the code starts: after the table, which has nine more slots than the program has records.
    blob = nc_join(head,nc_join(nc_u32(4195456+nz_slot(table)*8),nc_u32(trace),Enum.concat(nc_u32(nc_units(Enum.count(points),8)),nc_u32(4195456+nc_records(Enum.count(table))*8+72))),points)
