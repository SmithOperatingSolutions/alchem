  # An arm of a cond whose condition starts at pos: its if is counted, but
  # for an arm that is just true, which is the else of the one before.
  def zf_cover_arm(source: bytes, table: bytes, env: bytes, condition: bytes, pos: integer): bytes do
    count = if Enum.at(table,20,0) != 2 do b[] else if zf_else(source,pos) == 1 do b[] else zf_cover(source,table,env,nc_start(source,pos)) end end
    if Enum.count(count) == 0 do condition else if nc_pos(condition) < 0 do condition else Enum.concat(nc_slice(condition,0,nt_after(condition,4)),Enum.concat(count,nc_code(condition))) end end
