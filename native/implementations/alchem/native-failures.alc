  def zf_points_run(code: bytes, call: bytes, pos: integer, stop: integer): bytes do
    if pos >= stop do b[] else
      if Enum.at(code,pos,0) != Enum.at(call,0,0) do zf_points_run(code,call,pos+1,stop) else
        if zf_same(code,pos,call,1) == 0 do zf_points_run(code,call,pos+1,stop) else nc_join(nc_u32(pos),nc_slice(code,pos+Enum.count(call),pos+Enum.count(call)+4),zf_points_run(code,call,pos+1,stop)) end
