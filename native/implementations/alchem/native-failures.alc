      marks = nc_join(zf_cover_call(table,1073741824+first),nc_join(zf_cover_call(table,805306368+second),zf_cover_call(table,805306368+third),zf_cover_call(table,805306368+fourth)),zf_cover_call(table,805306368+fifth))
      Enum.concat(if Enum.count(marks) < 128 do b[235,Enum.count(marks)] else Enum.concat(b[233],nc_u32(Enum.count(marks))) end,marks)
    end end
