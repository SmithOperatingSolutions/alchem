  # 1 when the position of the rewritten text is in a piece that stands for
  # one place: text the rewriting wrote. records: the moved records.
  def zf_placed(records: bytes, pos: integer): integer do
    at = zf_moved(records,0,nc_units(Enum.count(records),16),pos)
    if at < 0 do 0 else if nc_long(records,at*16+4) >= 1073741824 do 1 else 0 end end
  end
  # The last of the records first up to stop that starts at or before pos; -1 for none.
  def zf_moved(records: bytes, first: integer, stop: integer, pos: integer): integer do
    middle = first+nc_half(stop-first)
    if stop-first <= 0 do -1 else if nc_long(records,first*16) > pos do -1 else
