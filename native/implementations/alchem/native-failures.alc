  def zf_same(code: bytes, at: integer, word: bytes, index: integer): integer do
    if index >= Enum.count(word) do 1 else if Enum.at(code,at+index,0) != Enum.at(word,index,0) do 0 else zf_same(code,at,word,index+1) end end
  end
  # A value whose code counts one more statement at pos before it runs.
  def zf_counted(source: bytes, table: bytes, env: bytes, value: bytes, pos: integer): bytes do
    count = if nc_pos(value) < 0 do b[] else zf_cover(source,table,env,pos) end
    if Enum.count(count) == 0 do value else Enum.concat(nc_slice(value,0,nt_after(value,4)),Enum.concat(count,nc_code(value))) end
  end
  # How many calls of the routine a piece of code holds.
  def zf_count(table: bytes, code: bytes): integer do
    call = zf_cover_site(table)
    nc_units(Enum.count(zf_points(code,call,0,Enum.count(code)-Enum.count(call)-3)),8)
  end
  # The pinned compiler lists the statements of a try's after block first,
  # then those of its catch arms, its rescue arms, its body and its else
  # arms; the code has the body, the rescue arms, the catch arms, the else
  # arms, the block. A mark before them, which never runs, says how many
  # calls each of the five holds, and the list is put in the pinned order
  # when it is written (Testing._cordered). arms: the code of the arms;
  # cuts: where its catch arms and its else arms start (32 bits each).
  def zf_tried(table: bytes, body: bytes, arms: bytes, cuts: bytes, block: bytes): bytes do
    first = zf_count(table,body)
    second = zf_count(table,nc_slice(arms,0,nc_long(cuts,0)))
    third = zf_count(table,nc_slice(arms,nc_long(cuts,0),nc_long(cuts,4)))
    fourth = zf_count(table,nc_slice(arms,nc_long(cuts,4),Enum.count(arms)))
    fifth = zf_count(table,block)
