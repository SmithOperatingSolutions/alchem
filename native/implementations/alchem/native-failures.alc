  # cond stands; after an arm that is just true there is none.
  def zf_cover_end(source: bytes, table: bytes, env: bytes, origin: integer): bytes do
    zf_cover(source,table,env,origin)
  end
  def zf_cover_rest(source: bytes, table: bytes, env: bytes, pos: integer, rest: bytes): bytes do
    lead = zf_cover(source,table,env,0)
    size = Enum.count(lead)
