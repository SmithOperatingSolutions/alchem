defmodule NativeScope do
  # The statements of a block, each compiled in a window of the environment.
  #
  # An environment is one byte string, and a statement that binds a name
  # makes a longer one: a block of n bindings copied n environments of up to
  # n records, and every search of one read them all. A block whose
  # environment has grown past ev_plain() bytes is compiled otherwise: the
  # records are kept in two indexed stores and a short list (big, mid,
  # small: the last 512 statements' records are in mid and small, the last
  # 16 in small), and each statement is compiled in an environment of its
  # own that holds only the records it can name, which are those whose name
  # stands somewhere in its text, and the records without a name. A record
  # of type 47 stands for each run of records left out (nc_env_gap), so the
  # slots are the same. A statement's text is read to where the next
  # statement starts (ev_extent); when a statement compiled so ends after
  # that, or does not compile, it is compiled once more in the whole
  # environment, which a record of type 48 marks: blocks inside it use no
  # windows, so a failure costs one more compilation and not one at every
  # level.
  #
  # An entry of an index is 15 bytes: where the name starts and stops, the
  # slot, and the offset of the record in the store's records.
  def ev_plain(): integer do 1024 end
  def ev_few(): integer do 4 end
  def ev_many(): integer do 9 end
  def ev_entry(start: integer, stop: integer, slot: integer, offset: integer): bytes do
    nc_join(nc_u32(start),nc_u32(stop),Enum.concat(nc_u24(slot),nc_u32(offset)))
  end
  def ev_units(items: bytes): integer do nc_units(Enum.count(items),15) end
  # The order of two names of the source: by length, then by their bytes.
  def ev_order(source: bytes, a: integer, astop: integer, b: integer, bstop: integer): integer do
    if astop-a != bstop-b do astop-a-bstop+b else if a == b do 0 else ev_order_at(source,a,b,astop-a) end end
  end
  def ev_order_at(source: bytes, a: integer, b: integer, size: integer): integer do
    if size == 0 do 0 else
      if byte_at(source,a) != byte_at(source,b) do byte_at(source,a)-byte_at(source,b) else ev_order_at(source,a+1,b+1,size-1) end
    end
  end
  # The offset of the first of count entries from lo whose name is not
  # before start..stop; of the first whose slot is not below slot.
  def ev_bound(source: bytes, data: bytes, lo: integer, count: integer, start: integer, stop: integer): integer do
    half = nc_half(count)
    at = lo+half*15
    if count == 0 do lo else
      if ev_order(source,nc_long(data,at),nc_long(data,at+4),start,stop) < 0 do ev_bound(source,data,at+15,count-half-1,start,stop) else ev_bound(source,data,lo,half,start,stop) end
    end
  end
  def ev_bound_slot(data: bytes, lo: integer, count: integer, slot: integer): integer do
    half = nc_half(count)
    at = lo+half*15
    if count == 0 do lo else
      if nc_cursor(data,at+8) < slot do ev_bound_slot(data,at+15,count-half-1,slot) else ev_bound_slot(data,lo,half,slot) end
    end
  end
  # 0 when the entries at a and b are the same by name (mode 0) or slot.
  def ev_differ(source: bytes, first: bytes, a: integer, second: bytes, b: integer, mode: integer): integer do
    if mode == 1 do nc_cursor(first,a+8)-nc_cursor(second,b+8) else ev_order(source,nc_long(first,a),nc_long(first,a+4),nc_long(second,b),nc_long(second,b+4)) end
  end
  # Two sorted lists as one, by name (mode 0) or by slot (mode 1); of two
  # entries that are the same the one of a stays.
  def ev_merge(source: bytes, a: bytes, b: bytes, mode: integer): bytes do
    if Enum.count(a) == 0 do b else if Enum.count(b) == 0 do a else
      if ev_differ(source,a,Enum.count(a)-15,b,0,mode) < 0 do Enum.concat(a,b) else ev_merge_at(source,a,b,mode) end
    end end
  end
  def ev_merge_at(source: bytes, a: bytes, b: bytes, mode: integer): bytes do
    at = nc_half(ev_units(b))*15
    split = if mode == 1 do ev_bound_slot(a,0,ev_units(a),nc_cursor(b,at+8)) else ev_bound(source,a,0,ev_units(a),nc_long(b,at),nc_long(b,at+4)) end
    same = if split >= Enum.count(a) do 0 else if ev_differ(source,a,split,b,at,mode) == 0 do 1 else 0 end end
    nc_join(ev_merge(source,nc_slice(a,0,split),nc_slice(b,0,at),mode),if same == 1 do b[] else nc_slice(b,at,at+15) end,ev_merge(source,nc_slice(a,split,Enum.count(a)),nc_slice(b,at+15,Enum.count(b)),mode))
  end
  # The names in the text from lo to hi, wherever they stand (a string, a
  # sigil, a comment), sorted. A name before ? or ! is there with and
  # without it.
  def ev_names(source: bytes, lo: integer, hi: integer): bytes do
    half = nc_half(hi-lo)
    if hi-lo <= 0 do b[] else if hi-lo == 1 do ev_name_at(source,lo) else ev_merge(source,ev_names(source,lo,lo+half),ev_names(source,lo+half,hi),0) end end
  end
  def ev_name_at(source: bytes, pos: integer): bytes do
    stop = nc_scan(source,pos,2,16777216)
    mark = byte_at(source,stop)
    if classify_ascii(byte_at(source,pos)) != 2 do b[] else if is_identifier_continue(byte_at(source,pos-1)) == 1 do b[] else
      if (mark-63)*(mark-33) == 0 do Enum.concat(ev_entry(pos,stop,0,0),ev_entry(pos,stop+1,0,0)) else ev_entry(pos,stop,0,0) end
    end end
  end
  # A store: its records, the entries of those found without a name, in
  # slot order (pinned), the entries of those found by name in sorted runs,
  # the oldest first, the length of each run, and 26 bytes: the sizes of
  # these four, the first slot, the slot after the last and the function.
  def ev_tail(store: bytes): integer do Enum.count(store)-27 end
  def ev_records(store: bytes): integer do nc_long(store,ev_tail(store)) end
  def ev_pinned(store: bytes): integer do nc_long(store,ev_tail(store)+4) end
  def ev_sorted(store: bytes): integer do nc_long(store,ev_tail(store)+8) end
  def ev_base(store: bytes): integer do nc_long(store,ev_tail(store)+16) end
  def ev_total(store: bytes): integer do nc_long(store,ev_tail(store)+20) end
  def ev_empty(base: integer, id: integer): bytes do
    Enum.concat(nc_zeros(16),nc_join(nc_u32(base),nc_u32(base),nc_u24(id)))
  end
  # The number of records from offset on.
  def ev_count(run: bytes, offset: integer, count: integer): integer do
    if offset >= Enum.count(run) do count else ev_count(run,nc_env_next(run,offset),count+1) end
  end
  # The entries of count records of run from where at says (offset and
  # slot, four bytes each), behind where the next starts. shift: the offset
  # of the run in its store.
  def ev_scan(run: bytes, at: bytes, count: integer, shift: integer): bytes do
    half = nc_half(count)
    left = if count < 2 do b[] else ev_scan(run,at,half,shift) end
    right = if count < 2 do b[] else ev_scan(run,nc_slice(left,0,8),count-half,shift) end
    if count == 0 do at else if count == 1 do ev_scan_one(run,nc_long(at,0),nc_long(at,4),shift) else
      nc_join(nc_slice(right,0,8),nc_slice(left,8,Enum.count(left)),nc_slice(right,8,Enum.count(right)))
    end end
  end
  def ev_scan_one(run: bytes, offset: integer, slot: integer, shift: integer): bytes do
    gap = nc_env_gap(run,offset)
    if gap > 0 do Enum.concat(nc_u32(nc_env_next(run,offset)),nc_u32(slot+gap)) else
      nc_join(nc_u32(nc_env_next(run,offset)),nc_u32(slot+1),ev_entry(nc_long(run,offset),nc_env_stop(run,offset),slot,shift+offset))
    end
  end
  # 1 for a record found by its name: one whose name starts as a name does.
  # A placeholder's (&1) and a record without a name are found otherwise.
  def ev_named(source: bytes, start: integer, stop: integer): integer do
    if stop <= start do 0 else if classify_ascii(byte_at(source,start)) == 2 do 1 else 0 end end
  end
  # Of count entries from lo those found by name, sorted by it (named 1), or the others.
  def ev_pick(source: bytes, items: bytes, lo: integer, count: integer, named: integer): bytes do
    half = nc_half(count)
    if count == 0 do b[] else if count == 1 do if ev_named(source,nc_long(items,lo),nc_long(items,lo+4)) == named do nc_slice(items,lo,lo+15) else b[] end else
      if named == 1 do ev_merge(source,ev_pick(source,items,lo,half,1),ev_pick(source,items,lo+half*15,count-half,1),0) else Enum.concat(ev_pick(source,items,lo,half,0),ev_pick(source,items,lo+half*15,count-half,0)) end
    end end
  end
  # The store with the records of extra after its own.
  def ev_freeze(source: bytes, store: bytes, extra: bytes): bytes do
    held = ev_records(store)
    scan = ev_scan(extra,Enum.concat(nc_u32(0),nc_u32(ev_total(store))),ev_count(extra,0,0),held)
    entries = nc_slice(scan,8,Enum.count(scan))
    runs = ev_runs(source,store,ev_pick(source,entries,0,ev_units(entries),1))
    pinned = Enum.concat(nc_slice(store,held,held+ev_pinned(store)),ev_pick(source,entries,0,ev_units(entries),0))
    sizes = nc_join(Enum.concat(nc_u32(held+Enum.count(extra)),nc_u32(Enum.count(pinned))),Enum.concat(nc_u32(nc_long(runs,0)),nc_u32(Enum.count(runs)-4-nc_long(runs,0))),Enum.concat(nc_u32(ev_base(store)),nc_u32(nc_long(scan,4))))
    if Enum.count(extra) == 0 do store else
      Enum.concat(nc_slice(store,0,held),Enum.concat(extra,Enum.concat(pinned,nc_join(nc_slice(runs,4,Enum.count(runs)),sizes,nc_slice(store,Enum.count(store)-3,Enum.count(store))))))
    end
  end
  # The runs of the store and their lengths with one more run: it is joined
  # with the runs before it that are not twice as long, so the runs stay few.
  def ev_runs(source: bytes, store: bytes, named: bytes): bytes do
    first = ev_records(store)+ev_pinned(store)
    if Enum.count(named) == 0 do wc_both(nc_slice(store,first,first+ev_sorted(store)),nc_slice(store,first+ev_sorted(store),ev_tail(store))) else
      ev_compact(source,store,named,nc_units(ev_tail(store)-first-ev_sorted(store),4),first+ev_sorted(store))
    end
  end
  # kept: the runs of the store left as they are; they end at stop.
  def ev_compact(source: bytes, store: bytes, last: bytes, kept: integer, stop: integer): bytes do
    first = ev_records(store)+ev_pinned(store)
    lengths = first+ev_sorted(store)
    before = nc_long(store,lengths+kept*4-4)
    if kept == 0 do wc_both(last,nc_u32(ev_units(last))) else
      if before >= ev_units(last)*2 do wc_both(Enum.concat(nc_slice(store,first,stop),last),Enum.concat(nc_slice(store,lengths,lengths+kept*4),nc_u32(ev_units(last)))) else
        ev_compact(source,store,ev_merge(source,nc_slice(store,stop-before*15,stop),last,0),kept-1,stop-before*15)
      end
    end
  end
  # The offset in the store of the entry of the name start..stop, -1 when
  # it has none: the oldest run first, as the first record of a name counts.
  def ev_find(source: bytes, store: bytes, start: integer, stop: integer, run: integer, lengths: integer): integer do
    count = if lengths >= ev_tail(store) do 0 else nc_long(store,lengths) end
    at = ev_bound(source,store,run,count,start,stop)
    if lengths >= ev_tail(store) do -1 else
      if at >= run+count*15 do ev_find(source,store,start,stop,run+count*15,lengths+4) else
        if ev_order(source,nc_long(store,at),nc_long(store,at+4),start,stop) == 0 do at else ev_find(source,store,start,stop,run+count*15,lengths+4) end
      end
    end
  end
  # The entries of the store for count names from lo, by slot.
  def ev_matches(source: bytes, store: bytes, names: bytes, lo: integer, count: integer): bytes do
    half = nc_half(count)
    first = ev_records(store)+ev_pinned(store)
    at = if count != 1 do -1 else ev_find(source,store,nc_long(names,lo),nc_long(names,lo+4),first,first+ev_sorted(store)) end
    if count == 0 do b[] else if count == 1 do if at < 0 do b[] else nc_slice(store,at,at+15) end else
      ev_merge(source,ev_matches(source,store,names,lo,half),ev_matches(source,store,names,lo+half*15,count-half),1)
    end end
  end
  # The records of the entries, each behind a record for the slots left out
  # before it, and one for those after the last.
  def ev_emit(store: bytes, entries: bytes): bytes do
    count = ev_units(entries)
    Enum.concat(ev_emit_run(store,entries,0,count),nc_env_left(ev_total(store)-(if count == 0 do ev_base(store) else nc_cursor(entries,count*15-7)+1 end)))
  end
  def ev_emit_run(store: bytes, entries: bytes, first: integer, count: integer): bytes do
    half = nc_half(count)
    if count == 0 do b[] else if count == 1 do ev_emit_one(store,entries,first*15) else
      Enum.concat(ev_emit_run(store,entries,first,half),ev_emit_run(store,entries,first+half,count-half))
    end end
  end
  def ev_emit_one(store: bytes, entries: bytes, at: integer): bytes do
    offset = nc_long(entries,at+11)
    before = if at == 0 do ev_base(store) else nc_cursor(entries,at-7)+1 end
    Enum.concat(nc_env_left(nc_cursor(entries,at+8)-before),nc_slice(store,offset,nc_env_next(store,offset)))
  end
  def ev_view(source: bytes, store: bytes, names: bytes): bytes do
    ev_emit(store,ev_merge(source,ev_matches(source,store,names,0,ev_units(names)),ev_pins(source,store,names,ev_records(store),nc_units(ev_pinned(store),15)),1))
  end
  # Of count pinned entries from lo those a statement of these names needs.
  def ev_pins(source: bytes, store: bytes, names: bytes, lo: integer, count: integer): bytes do
    half = nc_half(count)
    if count == 0 do b[] else if count == 1 do if ev_near_by(source,store,nc_long(store,lo+11),names) == 1 do nc_slice(store,lo,lo+15) else b[] end else
      Enum.concat(ev_pins(source,store,names,lo,half),ev_pins(source,store,names,lo+half*15,count-half))
    end end
  end
  # 1 for a record without a name that only what made it reads, by its
  # slot: one whose type is a value's (the value of a case or of a with
  # clause, a parameter that is a pattern). The others say where a
  # statement stands or what type is expected (tags 17, 21, 40 and up; 24
  # with positions behind it), or are a capture's placeholders carried
  # into a function (they stand at its &: nf_nested).
  def ev_loose(source: bytes, run: bytes, offset: integer): integer do
    tag = nc_env_tag(run,offset)
    if nc_env_stop(run,offset) != nc_long(run,offset) do 0 else if byte_at(source,nc_long(run,offset)) == 38 do 0 else
      if tag == 24 do if nt_size(run,offset+7) == 1 do 1 else 0 end else
        if tag < 17 do 1 else if (tag-18)*(tag-19)*(tag-20)*(tag-22)*(tag-23) == 0 do 1 else if (tag-25)*(tag-26)*(tag-29) == 0 do 1 else 0 end end end
      end
    end end
  end
  # 1 for a record without an identifier's name that a statement of the
  # text the names end with (where it starts and stops, three bytes each)
  # may need: any but a loose one made outside that text.
  def ev_near_by(source: bytes, run: bytes, offset: integer, names: bytes): integer do
    at = nc_long(run,offset)
    if ev_loose(source,run,offset) == 0 do 1 else if at+1 < nc_long(names,Enum.count(names)-8) do 0 else if at > nc_long(names,Enum.count(names)-4) do 0 else 1 end end end
  end
  # The records of a list that a statement of these names can find. mark:
  # where the records kept since the last one left out start, or below
  # zero one less than minus the slots left out since the last one kept.
  # Records kept one after another are copied together.
  def ev_sift(source: bytes, run: bytes, names: bytes, offset: integer, mark: integer, done: bytes): bytes do
    gap = nc_env_gap(run,offset)
    if offset >= Enum.count(run) do if mark >= 0 do Enum.concat(done,nc_slice(run,mark,Enum.count(run))) else Enum.concat(done,nc_env_left(0-mark-1)) end else
      if gap+(1-ev_kept(source,names,run,offset)) > 0 do
        if mark >= 0 do ev_sift(source,run,names,nc_env_next(run,offset),0-1-(if gap > 0 do gap else 1 end),Enum.concat(done,nc_slice(run,mark,offset))) else ev_sift(source,run,names,nc_env_next(run,offset),mark-(if gap > 0 do gap else 1 end),done) end
      else
        if mark >= 0 do ev_sift(source,run,names,nc_env_next(run,offset),mark,done) else ev_sift(source,run,names,nc_env_next(run,offset),offset,Enum.concat(done,nc_env_left(0-mark-1))) end
      end
    end
  end
  def ev_kept(source: bytes, names: bytes, run: bytes, offset: integer): integer do
    start = nc_long(run,offset)
    stop = nc_env_stop(run,offset)
    at = if ev_named(source,start,stop) == 0 do -1 else ev_bound(source,names,0,ev_units(names),start,stop) end
    if at < 0 do ev_near_by(source,run,offset,names) else if at+15 > Enum.count(names) do 0 else
      if ev_order(source,nc_long(names,at),nc_long(names,at+4),start,stop) == 0 do 1 else 0 end
    end end
  end
  # The environment of a statement of these names, and the whole one.
  def ev_window(source: bytes, big: bytes, mid: bytes, small: bytes, names: bytes): bytes do
    nc_join(nc_slice(big,Enum.count(big)-3,Enum.count(big)),Enum.concat(ev_view(source,big,names),ev_view(source,mid,names)),ev_sift(source,small,names,0,0-1,b[]))
  end
  def ev_whole(big: bytes, mid: bytes, small: bytes): bytes do
    nc_join(nc_slice(big,Enum.count(big)-3,Enum.count(big)),Enum.concat(nc_slice(big,0,ev_records(big)),nc_slice(mid,0,ev_records(mid))),small)
  end
  # The environment for text from start to stop: env itself when it is
  # short, marked for a second compilation, or the text is not known to end.
  def ev_near(source: bytes, env: bytes, start: integer, stop: integer): bytes do
    if Enum.count(env) <= ev_plain() do env else if stop < 0 do env else if ev_marked(env,3) == 1 do env else
      ev_sift(source,env,ev_named_in(source,start,stop),3,0-1,nc_slice(env,0,3))
    end end end
  end
  # For the parts of a long literal (nl_items): 1 when count parts in env
  # are worth a store, the store, and the window of it for one part's text.
  def ev_wide(env: bytes, bounds: bytes, count: integer): integer do
    if count < 64 do 0 else if Enum.at(bounds,6,0) >= 2 do 0 else if Enum.count(env) <= ev_plain() do 0 else 1-ev_marked(env,3) end end end
  end
  def ev_stored(source: bytes, env: bytes): bytes do
    ev_freeze(source,ev_empty(0,nc_cursor(env,0)),nc_slice(env,3,Enum.count(env)))
  end
  def ev_part(source: bytes, store: bytes, start: integer, stop: integer): bytes do
    Enum.concat(nc_slice(store,Enum.count(store)-3,Enum.count(store)),ev_view(source,store,ev_named_in(source,start,stop)))
  end
  # The names of the text from start to stop, and behind them the two.
  def ev_named_in(source: bytes, start: integer, stop: integer): bytes do
    nc_join(ev_names(source,start,stop),nc_u32(start),nc_u32(stop))
  end
  # An expression in a long environment is compiled in a window of it, and
  # once more in the whole one when it does not compile so or ends later
  # than its text was read to.
  def ev_expression(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    stop = ev_reach(source,nc_start(source,pos))
    # One token finds its record sooner in the whole environment than a window is made.
    near = if nc_start(source,nc_end(source,pos)) >= stop do env else ev_near(source,env,nc_start(source,pos),stop) end
    value = if Enum.count(near) == Enum.count(env) do b[] else nb_expression(source,pos,near,table,depth) end
    if Enum.count(near) == Enum.count(env) do nb_expression(source,pos,env,table,depth) else
      if nc_pos(value) < 0 do nb_expression(source,pos,nj_mark(env,b[48]),table,depth) else if nc_pos(value) > stop do nb_expression(source,pos,nj_mark(env,b[48]),table,depth) else value end end
    end
  end
  # Where the text of the statement at start ends for certain: after the
  # first word of the next statement, or at what closes the block. Read by
  # tokens with brackets and do/fn ... end nesting, as wc_scan reads. A
  # state: the position after the last token, the nesting, 2 while reading
  # (1 found, 0 lost), and where the last token started.
  def ev_state(pos: integer, depth: integer, verdict: integer, last: integer): bytes do
    Enum.concat(nk_state(pos,depth,verdict),nc_u24(last))
  end
  def ev_extent(source: bytes, start: integer): integer do
    state = if start < 0 do b[] else ev_extent_grow(source,ev_state(start,0,2,16777215),1,0) end
    if Enum.at(state,5,0) == 1 do nc_cursor(state,0) else -1 end
  end
  # The same for an expression, which also ends at a comma or a do outside
  # brackets, but for one that starts with a word whose form has them.
  def ev_reach(source: bytes, start: integer): integer do
    wordy = nc_word(source,start,b[105,102])+nc_word(source,start,b[117,110,108,101,115,115])+nc_word(source,start,b[99,97,115,101])+nc_word(source,start,b[99,111,110,100])+nc_word(source,start,b[119,105,116,104])+nc_word(source,start,b[102,111,114])+nc_word(source,start,b[116,114,121])+nc_word(source,start,b[102,110])+nc_word(source,start,b[114,97,105,115,101])
    state = if start < 0 do b[] else ev_extent_grow(source,ev_state(start,0,2,16777215),1,if wordy > 0 do 0 else 1 end) end
    if Enum.at(state,5,0) == 1 do nc_cursor(state,0) else -1 end
  end
  def ev_extent_grow(source: bytes, state: bytes, size: integer, mode: integer): bytes do
    if Enum.at(state,5,0) != 2 do state else if size > 16777216 do b[] else ev_extent_grow(source,ev_extent_run(source,state,size,mode),size*2,mode) end end
  end
  def ev_extent_run(source: bytes, state: bytes, size: integer, mode: integer): bytes do
    half = nc_half(size)
    if Enum.at(state,5,0) != 2 do state else
      if size == 1 do ev_extent_one(source,state,mode) else ev_extent_run(source,ev_extent_run(source,state,half,mode),size-half,mode) end
    end
  end
  def ev_extent_one(source: bytes, state: bytes, mode: integer): bytes do
    start = nc_start(source,nc_cursor(state,0))
    if mode*(1-nc_read(state,3)) != 1 do ev_extent_step(source,nc_cursor(state,0),nc_read(state,3),nc_cursor(state,6)) else
      if byte_at(source,start) == 44 do ev_state(start,0,1,0) else if nc_opens(source,start) == 1 do ev_state(start,0,1,0) else ev_extent_step(source,nc_cursor(state,0),nc_read(state,3),nc_cursor(state,6)) end end
    end
  end
  def ev_extent_step(source: bytes, pos: integer, depth: integer, last: integer): bytes do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    opens = if (value-40)*(value-91)*(value-123) == 0 do 1 else if value == 100 do nc_opens(source,start) else if value == 102 do nf_untyped(source,start) else 0 end end end
    closes = if (value-41)*(value-93)*(value-125) == 0 do 1 else if value == 101 do nc_word(source,start,b[101,110,100]) else 0 end end
    stop = if start < 0 do -1 else nc_end(source,start) end
    if stop < 0 do ev_state(0,0,0,0) else if start >= Enum.count(source) do ev_state(Enum.count(source),0,1,0) else
      if depth > 0 do ev_state(stop,depth+opens-closes,2,start) else
        if closes+wc_other(source,start)+ty_word(source,start) > 0 do ev_state(start,0,1,0) else
          if last == 16777215 do ev_state(stop,opens,2,start) else if nf_same_line(source,pos,start) == 1 do ev_state(stop,opens,2,start) else
            if ev_continues(source,last,pos,start) == 1 do ev_state(stop,opens,2,start) else ev_state(stop,0,1,0) end
          end end
        end
      end
    end end
  end
  # 1 when the token at start, on a later line than the token before it
  # (from last to pos), may go on with the statement of that one: after or
  # before an operator, a comma, a dot or an opening bracket. A doubt is 1.
  def ev_continues(source: bytes, last: integer, pos: integer, start: integer): integer do
    before = byte_at(source,pos-1)
    value = byte_at(source,start)
    held = if (before-61)*(before-43)*(before-45)*(before-42)*(before-47)*(before-60) == 0 do 1 else if (before-62)*(before-124)*(before-38)*(before-44)*(before-46)*(before-92) == 0 do 1 else if (before-94)*(before-126)*(before-58)*(before-40)*(before-91)*(before-123) == 0 do 1 else ev_joins(source,last) end end end
    led = if (value-61)*(value-43)*(value-45)*(value-42)*(value-47)*(value-60) == 0 do 1 else if (value-62)*(value-124)*(value-38)*(value-44)*(value-46)*(value-94) == 0 do 1 else if value == 33 do 1 else ev_joins(source,start)+nc_word(source,start,b[100,111]) end end end
    if held+led > 0 do 1 else 0 end
  end
  def ev_joins(source: bytes, start: integer): integer do
    nc_word(source,start,b[97,110,100])+nc_word(source,start,b[111,114])+nc_word(source,start,b[110,111,116])+nc_word(source,start,b[105,110])+nc_word(source,start,b[119,104,101,110])
  end
  # A run of statements: its code, the type of its value as a cell, the
  # records the statements added or the whole environment after them, the
  # packet of the last statement (wf_block; empty when none is asked for),
  # and 18 bytes: the position after the run, a step's flags (nx_pack), 1
  # when the environment is the whole one, and the sizes of the code, the
  # environment and the packet. The code stands first: two runs are joined
  # with two copies of the first one's code.
  def ev_foot(pos: integer, flags: integer, all: integer, size: integer, added: integer, last: integer): bytes do
    nc_join(Enum.concat(nc_u32(pos),b[flags,all]),nc_u32(size),Enum.concat(nc_u32(added),nc_u32(last)))
  end
  def ev_pos(run: bytes): integer do if Enum.count(run) < 18 do -1 else nc_long(run,Enum.count(run)-18) end end
  def ev_flags(run: bytes): integer do Enum.at(run,Enum.count(run)-14,0) end
  def ev_all(run: bytes): integer do Enum.at(run,Enum.count(run)-13,0) end
  def ev_size(run: bytes): integer do nc_long(run,Enum.count(run)-12) end
  def ev_code(run: bytes): bytes do nc_slice(run,0,ev_size(run)) end
  def ev_kind(run: bytes): bytes do nt_read(run,ev_size(run)) end
  def ev_added(run: bytes): bytes do nc_slice(run,nt_after(run,ev_size(run)),nt_after(run,ev_size(run))+nc_long(run,Enum.count(run)-8)) end
  def ev_last(run: bytes): bytes do nc_slice(run,Enum.count(run)-18-nc_long(run,Enum.count(run)-4),Enum.count(run)-18) end
  def ev_ended(run: bytes): integer do
    flags = ev_flags(run)
    low = if flags >= 4 do flags-4 else flags end
    if low >= 2 do low-2 else low end
  end
  # Two runs as one. Only a block of a single expression keeps its mark.
  def ev_join(first: bytes, second: bytes): bytes do
    if Enum.count(first) == 0 do b[] else if Enum.count(second) == 0 do b[] else ev_joined(first,second) end end
  end
  def ev_joined(first: bytes, second: bytes): bytes do
    flags = ev_flags(second)
    size = ev_size(second)
    added = if ev_all(second) == 1 do ev_added(second) else Enum.concat(ev_added(first),ev_added(second)) end
    last = ev_last(second)
    foot = ev_foot(ev_pos(second),if flags >= 4 do flags-4 else flags end,if ev_all(second) == 1 do 1 else ev_all(first) end,ev_size(first)+size,Enum.count(added),Enum.count(last))
    Enum.concat(ev_code(first),Enum.concat(nc_slice(second,0,nt_after(second,size)),nc_join(added,last,foot)))
  end
  # plan: the depth, the level (a run of 2^level statements), 1 when the
  # last statement's packet is asked for, 1 when statements have windows,
  # and the position.
  def ev_plan(plan: bytes, level: integer, pos: integer, mode: integer): bytes do
    Enum.concat(b[Enum.at(plan,0,0),level,Enum.at(plan,2,0),mode],nc_u32(pos))
  end
  # The statement of the plan compiled in env. all: 1 when env is the whole
  # environment, and what the run has is the whole one after the statement;
  # 2 when the last record of env is the mark of a second compilation,
  # which no later statement is to see: its slot is one left out.
  def ev_made(source: bytes, table: bytes, plan: bytes, env: bytes, all: integer): bytes do
    pos = nc_long(plan,4)
    step = nx_step(source,pos,env,table,Enum.at(plan,0,0))
    kind = nt_after(step,8+nx_size(step))
    from = if all == 1 do kind else kind+Enum.count(env) end
    last = if Enum.at(plan,2,0) == 0 do b[] else nc_value(nc_start(source,pos),wc_both(env,nx_code(step)),b[0]) end
    added = Enum.count(step)-from+(if all == 2 do 12 else 0 end)
    if nc_pos(step) < 0 do b[] else if from > Enum.count(step) do b[] else
      nc_join(nc_slice(step,8,kind),Enum.concat(nc_env_left(if all == 2 do 1 else 0 end),nc_slice(step,from,Enum.count(step))),Enum.concat(last,ev_foot(nc_pos(step),nx_flags(step),if all == 1 do 1 else 0 end,nx_size(step),added,Enum.count(last))))
    end end
  end
  def ev_leaf(source: bytes, table: bytes, plan: bytes, big: bytes, mid: bytes, small: bytes): bytes do
    start = nc_start(source,nc_long(plan,4))
    stop = if Enum.at(plan,3,0) == 0 do -1 else ev_extent(source,start) end
    near = if stop < 0 do b[] else ev_made(source,table,plan,ev_window(source,big,mid,small,ev_named_in(source,start,stop)),0) end
    if Enum.at(plan,3,0) == 0 do ev_made(source,table,plan,big,1) else
      if ev_pos(near) >= 0 do if ev_pos(near) <= stop do near else ev_again(source,table,plan,ev_whole(big,mid,small)) end else ev_again(source,table,plan,ev_whole(big,mid,small)) end
    end
  end
  # In the whole environment, marked.
  def ev_again(source: bytes, table: bytes, plan: bytes, env: bytes): bytes do
    ev_made(source,table,plan,nj_mark(env,b[48]),2)
  end
  def ev_span(source: bytes, table: bytes, plan: bytes, big: bytes, mid: bytes, small: bytes): bytes do
    level = Enum.at(plan,1,0)
    first = if level == 0 do b[] else ev_span(source,table,ev_plan(plan,level-1,nc_long(plan,4),Enum.at(plan,3,0)),big,mid,small) end
    if level == 0 do ev_leaf(source,table,plan,big,mid,small) else
      if Enum.count(first) == 0 do b[] else if ev_ended(first) == 1 do first else
        ev_join(first,ev_next(source,table,ev_plan(plan,level-1,ev_pos(first),Enum.at(plan,3,0)),big,mid,if Enum.at(plan,3,0) == 0 do ev_added(first) else Enum.concat(small,ev_added(first)) end))
      end end
    end
  end
  # What follows a run of 2^level statements inside a longer run: fresh
  # holds the short list with what the run added (with windows), or the
  # whole environment after it. The records move to the stores as the runs
  # get longer, and a block of eight statements whose environment has grown
  # long gets its stores.
  def ev_next(source: bytes, table: bytes, plan: bytes, big: bytes, mid: bytes, fresh: bytes): bytes do
    level = Enum.at(plan,1,0)
    if Enum.at(plan,3,0) == 0 do
      if ev_turns(fresh,level) == 0 do ev_span(source,table,plan,fresh,b[],b[]) else
        ev_begin(source,table,ev_plan(plan,level,nc_long(plan,4),1),ev_big(source,plan,big,mid,fresh))
      end
    else
      if level < ev_few() do ev_span(source,table,plan,big,mid,fresh) else
        if level < ev_many() do ev_span(source,table,plan,big,ev_freeze(source,mid,fresh),b[]) else
          ev_begin(source,table,plan,ev_big(source,plan,big,mid,fresh))
        end
      end
    end
  end
  def ev_begin(source: bytes, table: bytes, plan: bytes, big: bytes): bytes do
    ev_span(source,table,plan,big,ev_empty(ev_total(big),0),b[])
  end
  # The first store after a run of the plan's level, and the second store
  # with the short list (wc_both) given the first.
  def ev_big(source: bytes, plan: bytes, big: bytes, mid: bytes, fresh: bytes): bytes do
    if Enum.at(plan,3,0) == 0 do
      if ev_turns(fresh,Enum.at(plan,1,0)) == 0 do fresh else ev_freeze(source,ev_empty(0,nc_cursor(fresh,0)),nc_slice(fresh,3,Enum.count(fresh))) end
    else
      if Enum.at(plan,1,0) < ev_many() do big else ev_freeze(source,big,Enum.concat(nc_slice(mid,0,ev_records(mid)),fresh)) end
    end
  end
  def ev_over(source: bytes, plan: bytes, big: bytes, mid: bytes, fresh: bytes): bytes do
    level = Enum.at(plan,1,0)
    if Enum.at(plan,3,0) == 0 do
      if ev_turns(fresh,level) == 0 do nc_u32(0) else wc_both(ev_empty(ev_total(big),0),b[]) end
    else
      if level < ev_few() do wc_both(mid,fresh) else if level < ev_many() do wc_both(ev_freeze(source,mid,fresh),b[]) else wc_both(ev_empty(ev_total(big),0),b[]) end end
    end
  end
  # 1 when a block gets its stores: after eight statements, with an
  # environment longer than ev_plain() that no second compilation marks.
  def ev_turns(env: bytes, level: integer): integer do
    if level < 3 do 0 else if Enum.count(env) <= ev_plain() do 0 else 1-ev_marked(env,3) end end
  end
  def ev_marked(env: bytes, offset: integer): integer do
    if offset >= Enum.count(env) do 0 else if nc_env_tag(env,offset) == 48 do 1 else ev_marked(env,nc_env_next(env,offset)) end end
  end
  # The block from the plan's position on, after the run done: runs of
  # twice the length each time. over: the second store and the short list.
  def ev_grow(source: bytes, table: bytes, plan: bytes, done: bytes, big: bytes, over: bytes): bytes do
    more = ev_span(source,table,plan,big,wc_first(over),wc_second(over))
    whole = if Enum.count(done) == 0 do more else ev_join(done,more) end
    if Enum.count(more) == 0 do b[] else if ev_ended(more) == 1 do whole else
      ev_grown(source,table,plan,whole,big,wc_both(wc_first(over),if Enum.at(plan,3,0) == 0 do ev_added(more) else Enum.concat(wc_second(over),ev_added(more)) end))
    end end
  end
  def ev_grown(source: bytes, table: bytes, plan: bytes, whole: bytes, big: bytes, given: bytes): bytes do
    next = ev_big(source,plan,big,wc_first(given),wc_second(given))
    mode = if Enum.at(plan,3,0) == 1 do 1 else ev_turns(wc_second(given),Enum.at(plan,1,0)) end
    ev_grow(source,table,ev_plan(plan,Enum.at(plan,1,0)+1,ev_pos(whole),mode),whole,next,ev_over(source,plan,next,wc_first(given),wc_second(given)))
  end
  # The block at pos (nx_block, wf_block) as a run. spec: the depth, and 1
  # when the last statement's packet is asked for.
  def ev_block(source: bytes, pos: integer, env: bytes, table: bytes, spec: bytes): bytes do
    ev_grow(source,table,Enum.concat(b[Enum.at(spec,0,0),0,Enum.at(spec,1,0),0],nc_u32(pos)),b[],env,nc_u32(0))
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
