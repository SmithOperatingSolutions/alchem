      left = ac_search(source,table,name,nc_join(nc_u24(first),nc_u24(middle),nc_slice(bounds,6,9)))
      if left >= 0 do left else ac_search(source,table,name,nc_join(nc_u24(middle+1),nc_u24(stop),nc_slice(bounds,6,9))) end
