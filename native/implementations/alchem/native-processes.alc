      middle = first+nc_half(stop-first)
      Enum.concat(ac_quoted(text,first,middle),ac_quoted(text,middle,stop))
    else if stop <= first do b[] else if (value-34)*(value-92)*(value-35) == 0 do b[92,value] else b[value] end end end
  end
  def ac_number(value: integer): bytes do
    if value < 10 do b[48+value] else Enum.concat(ac_number(nt_div(value,10)),b[48+nt_mod(value,10)]) end
  end
  # Where the word when stands outside every bracket from pos up to stop; -1.
  def ac_guard(source: bytes, pos: integer, stop: integer, depth: integer): integer do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    next = if (value-40)*(value-91)*(value-123) == 0 do depth+1 else if (value-41)*(value-93)*(value-125) == 0 do depth-1 else depth end end
    if start < 0 do -1 else if start >= stop do -1 else
      if depth == 0 do if nc_word(source,start,b[119,104,101,110]) == 1 do start else ac_guard(source,nc_end(source,start),stop,next) end else ac_guard(source,nc_end(source,start),stop,next) end
    end end
  end
  # The names the pattern pins, each as "name = " <> inspect(name), with
  # commas between; a name twice is told twice.
  def ac_pins(source: bytes, pos: integer, stop: integer, found: bytes): bytes do
    start = nc_start(source,pos)
    name = nc_start(source,nc_end(source,start))
    text = nc_slice(source,name,nc_end(source,name))
    one = nc_join(nc_join(b[34],text,b[32,61,32,34,32,60,62,32,105,110,115,112,101,99,116,40]),text,b[41])
    if start < 0 do found else if start >= stop do found else
      if byte_at(source,start) != 94 do ac_pins(source,nc_end(source,start),stop,found) else
        ac_pins(source,nc_end(source,name),stop,if Enum.count(found) == 0 do one else nc_join(found,b[44,32],one) end)
      end
    end end
  end
  # The statement that starts at start, its arguments from open: where it
  # ends (three bytes), then its new text. b[] when it is not one.
  def ac_statement_text(source: bytes, start: integer, open: integer, plan: bytes): bytes do
    spans = if nc_word(source,open,b[41]) == 1 do b[] else nc_list_collect(source,open,b[],0,41) end
    items = nc_code(spans)
    count = if nc_pos(spans) < 0 do 0 else nc_units(Enum.count(items),8) end
    stop = nc_pos(spans)
    most = if Enum.at(plan,1,0) == 1 do 3 else 4 end
    if count < 2 do b[] else if count > most do b[] else
      whole = ac_text(source,nc_long(items,8),nc_long(items,12))
      guard = ac_guard(source,nc_long(items,8),nc_long(items,12),0)
      pattern = if guard < 0 do whole else ac_text(source,nc_long(items,8),guard) end
      plain = if guard >= 0 do 0 else if nc_identifier(source,nc_long(items,8)) == 0 do 0 else if nc_end(source,nc_long(items,8))-nc_start(source,nc_long(items,8)) == Enum.count(pattern) do 1 else 0 end end end
      name = Enum.concat(b[109,95,95],ac_number(start))
      test = if plain == 1 do nc_join(b[102,110,32],name,b[32,45,62,32,116,114,117,101,32,101,110,100]) else nc_join(nc_join(b[102,110,32],name,b[32,45,62,32,99,97,115,101,32]),nc_join(name,b[32,100,111,32],whole),b[32,45,62,32,116,114,117,101,32,95,32,45,62,32,102,97,108,115,101,32,101,110,100,32,101,110,100]) end
      show = nc_join(nc_join(b[102,110,32],name,b[32,45,62,32,105,110,115,112,101,99,116,40]),name,b[41,32,101,110,100])
      wait = if Enum.at(plan,1,0) == 1 do b[48] else if count < 3 do b[45,49] else ac_text(source,nc_long(items,16),nc_long(items,20)) end end
      extra = if Enum.at(plan,1,0) == 1 do 2 else 3 end
      custom = if count <= extra do b[34,34] else ac_text(source,nc_long(items,extra*8),nc_long(items,extra*8+4)) end
      bound = if Enum.at(plan,0,0) == 1 do Enum.concat(pattern,b[32,61,32]) else b[] end
      head = nc_join(bound,if Enum.at(plan,0,0) == 1 do b[80,114,111,99,101,115,115,46,97,115,115,101,114,116,95,114,101,99,101,105,118,101,40] else b[80,114,111,99,101,115,115,46,114,101,102,117,116,101,95,114,101,99,101,105,118,101,40] end,ac_text(source,nc_long(items,0),nc_long(items,4)))
      tail = nc_join(nc_join(b[44,32,34],ac_quoted(whole,0,Enum.count(whole)),b[34,44,32,91]),nc_join(ac_pins(source,nc_long(items,8),nc_long(items,12),b[]),b[93,44,32],custom),nc_join(b[44,32],ac_number(Enum.count(bound)),b[41]))
      text = nc_join(nc_join(head,b[44,32],wait),nc_join(b[44,32],test,b[44,32]),Enum.concat(show,tail))
      nc_join(nc_u32(stop),text,ac_newlines(ac_lines(source,start,stop)))
    end end
  end
  def ac_newlines(count: integer): bytes do
    if count <= 0 do b[] else Enum.concat(b[10],ac_newlines(count-1)) end
  end
  # A program is compiled: its receive statements as calls, then with the
  # library functions it mentions.
  # explain: 1 for why a program is refused (nc_explain), 2 for a check
  # (nc_checked), 0 for its image.
  def ac_compiled(given: bytes, explain: integer): bytes do
    ac_compiled_with(ac_receives(given),explain)
  end
  def ac_compiled_with(source: bytes, explain: integer): bytes do
    if Enum.count(source) > nc_limit() do b[] else nc_rewritten(source,explain) end
  end
  # The call of a generic function once its arguments are typed. order is
  # nw_order's verdict: 1 when only the call's own expected type could
  # settle a type variable an argument needed, 2 when nothing could. For a
  # function of the process library a call whose result came out whole
  # needs nothing more.
  def ac_settled(source: bytes, table: bytes, target: integer, value: bytes, order: integer): bytes do
    whole = if order == 0 do 0 else if nc_pos(value) < 0 do 0 else if ac_lenient(source,table,target) == 0 do 0 else 1-nn_open(nc_kind(value)) end end end
    if whole == 1 do value else if order == 2 do b[] else nw_when(value,order) end end
  end
  # System.stop(status) in a program with processes: the status is checked
  # as System.halt checks it, and Process._halted ends the program as the
  # pinned runtime does, the other processes stopped first. halt, and stop
  # in a program without them, leave at once.
  def ac_exit(source: bytes, table: bytes, start: integer, dot: integer): bytes do
    code = nz_exit(table,start)
    halted = if nc_word(source,dot,b[115,116,111,112]) == 0 do -1 else if nz_on(table) == 0 do -1 else ac_function(source,table,ny_module(source,table,b[65,108,99,104,127,109,80,114,111,99,101,115,115,49],Enum.concat(nc_u24(0),nc_u24(nc_records(Enum.count(table))))),b[95,104,97,108,116,101,100]) end end
    if halted < 0 do code else Enum.concat(nc_slice(code,0,Enum.count(code)-7),nc_call(halted)) end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
