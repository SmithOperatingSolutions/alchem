  # process types.
  def ac_typeword(source: bytes, pos: integer): integer do
    if nc_word(source,pos,b[102,105,108,101]) == 1 do 1 else if ac_word(source,pos,0) == 1 do 1 else sk_word(source,pos,0) end end
