  def ac_search(source: bytes, table: bytes, name: bytes, bounds: bytes): integer do
    first = nc_cursor(bounds,0)
    stop = nc_cursor(bounds,3)
    middle = first+nc_half(stop-first)
    start = nc_meta(table,middle,0)
    match = if first >= stop do 0 else if Enum.at(table,middle*40+21,0) >= 32 do 0 else if nc_owner(table,middle) != nc_cursor(bounds,6) do 0 else nt_same(nc_slice(source,start,nc_meta(table,middle,3)),name) end end end
