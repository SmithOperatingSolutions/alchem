  # User functions across all modules. Table slots also hold module headers
  # and shared runtimes. A record is named by a 16-bit number (the function of
  # an environment, the module of a record), so tables stop at 65536 records;
  # the runtimes take the slots after them, which call sites address with a
  # 32-bit address.
  def nc_function_limit(): integer do 65535 end
  def nc_record_limit(): integer do 65536 end
  def nc_slot_limit(): integer do 65541 end
