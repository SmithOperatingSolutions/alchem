defmodule NativeSourceCompiler do
  # Integer/function bootstrap profile. All parsing and emitted bytes run in Alchem.
  # Metadata uses little-endian u24 source offsets, never host pointers.
  # value divided by 256 and by 65536, rounded down (0 below 0). There is
  # no division: a quotient below 256 is found a bit at a time, eight
  # comparisons (nc_quot256), where subtracting took up to fifteen a digit.
  def nc_hi(value: integer): integer do
    if value < 65536 do nc_quot256(value,256) else
      upper = nc_upper(value)
      256*upper+nc_hi(value-65536*upper)
    end
  end

  def nc_u16(value: integer): bytes do
    high = nc_hi(value)
    b[value - high * 256, high]
  end
  def nc_upper(value: integer): integer do
    if value >= 4294967296 do 65536+nc_upper(value-4294967296) else
      top = nc_quot256(value,16777216)
      256*top+nc_quot256(value-top*16777216,65536)
    end
  end
  # value divided by unit, rounded down, for value below 256 units.
  def nc_quot256(value: integer, unit: integer): integer do
    high = nc_quot_high(value,unit)
    high+nc_quot_low(value-high*unit,unit)
  end
  def nc_quot_high(value: integer, unit: integer): integer do
    h1 = if value >= 128*unit do 128 else 0 end
    h2 = if value-h1*unit >= 64*unit do 64 else 0 end
    h3 = if value-(h1+h2)*unit >= 32*unit do 32 else 0 end
    h4 = if value-(h1+h2+h3)*unit >= 16*unit do 16 else 0 end
    h1+h2+h3+h4
  end
  def nc_quot_low(value: integer, unit: integer): integer do
    h1 = if value >= 8*unit do 8 else 0 end
    h2 = if value-h1*unit >= 4*unit do 4 else 0 end
    h3 = if value-(h1+h2)*unit >= 2*unit do 2 else 0 end
    h4 = if value-(h1+h2+h3)*unit >= unit do 1 else 0 end
    h1+h2+h3+h4
  end
  def nc_u32(value: integer): bytes do
    upper = nc_upper(value)
    Enum.concat(nc_u16(value-upper*65536),nc_u16(upper))
  end
  # 1 when neither a nor b is 0. A test that a byte is one of many is a
  # product of differences, and a product of more than seven of them can
  # leave 64 bits: it is split in two, each part tested here.
  def nc_and(a: integer, b: integer): integer do
    if a == 0 do 0 else if b == 0 do 0 else 1 end end
  end
  # A source has millions of bytes: the first steps are for the halves of its ranges.
  def nc_half(value: integer): integer do
    if value >= 65536 do
      if value >= 1048576 do if value >= 16777216 do 8388608+nc_half(value-16777216) else 524288+nc_half(value-1048576) end else 32768+nc_half(value-65536) end
    else
      if value >= 4096 do 2048+nc_half(value-4096) else
        if value >= 256 do 128+nc_half(value-256) else
          if value >= 16 do 8+nc_half(value-16) else
            if value >= 2 do 1+nc_half(value-2) else 0 end
          end
        end
      end
    end
  end
  # Division by subtraction in steps of 4096, 256, 16 and 1 keeps recursion shallow.
  def nc_units(size: integer, width: integer): integer do
    if size >= width*4096 do 4096+nc_units(size-width*4096,width) else
      if size >= width*256 do 256+nc_units(size-width*256,width) else
        if size >= width*16 do 16+nc_units(size-width*16,width) else
          if size >= width do 1+nc_units(size-width,width) else 0 end
        end
      end
    end
  end
  # Table records are 27 bytes: five u24 source positions, argc, flags, an
  # eight-byte return type and the u16 index of the owning module's header.
  # A finished table has after its records one record of zeros, the name
  # index (the number of every record as a u32, in the order of nc_order) and
  # up to 26 bytes that make its size one more than a multiple of 27, which
  # is how it is told from records alone.
  def nc_records(size: integer): integer do
    count = nc_units(size,27)
    if count*27 == size do count else nc_units(size-27,31) end
  end
  def nc_indexed(table: bytes): integer do
    if nc_units(Enum.count(table),27)*27 == Enum.count(table) do 0 else 1 end
  end
  def nc_u24(value: integer): bytes do
    high = nc_upper(value)
    Enum.concat(nc_u16(value-high*65536),b[high])
  end
  def nc_cursor(data: bytes, pos: integer): integer do
    nc_read(data,pos)+Enum.at(data,pos+2,0)*65536
  end
  # A 32-bit field: code lengths and addresses.
  def nc_long(data: bytes, pos: integer): integer do
    nc_read(data,pos)+nc_read(data,pos+2)*65536
  end
  def nc_read(data: bytes, pos: integer): integer do
    Enum.at(data, pos, 0) + Enum.at(data, pos + 1, 0) * 256
  end
  # The position a packet starts with. A value's flags (nw_mark, nx_impure)
  # are the byte after it, so a position takes all 24 bits.
  def nc_pos(result: bytes): integer do
    if Enum.count(result) < 3 do -1 else nc_cursor(result,0) end
  end
  def nc_join(a: bytes, b: bytes, c: bytes): bytes do
    Enum.concat(Enum.concat(a, b), c)
  end
  def nc_chunk(data: bytes, start: integer): bytes do
    b[ Enum.at(data,start+0,0),Enum.at(data,start+1,0),Enum.at(data,start+2,0),Enum.at(data,start+3,0),Enum.at(data,start+4,0),Enum.at(data,start+5,0),Enum.at(data,start+6,0),Enum.at(data,start+7,0),Enum.at(data,start+8,0),Enum.at(data,start+9,0),Enum.at(data,start+10,0),Enum.at(data,start+11,0),Enum.at(data,start+12,0),Enum.at(data,start+13,0),Enum.at(data,start+14,0),Enum.at(data,start+15,0) ]
  end
  def nc_block(data: bytes, start: integer): bytes do
    left = nc_join(nc_chunk(data,start),nc_chunk(data,start+16),nc_chunk(data,start+32))
    middle = nc_join(nc_chunk(data,start+48),nc_chunk(data,start+64),nc_chunk(data,start+80))
    nc_join(left,middle,Enum.concat(nc_chunk(data,start+96),nc_chunk(data,start+112)))
  end
  def nc_slice(data: bytes, start: integer, stop: integer): bytes do
    if start >= stop do b[] else Enum.slice(data,start,stop-start) end
  end
  # A compiled value: position after it (3 bytes), its flags (1 byte: 128
  # nw_mark, 64 nx_impure), its type as a cell (nt_cell: the type after its
  # length), then its code. An empty byte string is failure, also for no type.
  def nc_code(result: bytes): bytes do
    nc_slice(result,nt_after(result,4),Enum.count(result))
  end

  def nc_result(pos: integer, code: bytes): bytes do
    nc_value(pos,code,b[0])
  end
  def nc_value(pos: integer, code: bytes, kind: bytes): bytes do
    if Enum.count(kind) == 0 do b[] else nc_join(nc_u24(pos),Enum.concat(b[0],nt_cell(kind)),code) end
  end
  def nc_kind(result: bytes): bytes do
    if Enum.count(result) < 6 do b[] else nt_read(result,4) end
  end
  # The first byte of the type: the whole type when it is a scalar.
  def nc_tag(result: bytes): integer do
    if Enum.count(result) < 6 do -1 else Enum.at(result,4+nt_head(result,4),0) end
  end

  def nc_spaces(source: bytes, pos: integer, count: integer): integer do
    if count == 0 do pos else
      if is_space(byte_at(source,pos)) == 1 do nc_spaces(source,pos+1,count-1) else pos end
    end
  end
  def nc_ignored(source: bytes, pos: integer): integer do
    if is_space(byte_at(source,pos)) == 1 do 1 else
      if byte_at(source,pos) == 35 do 1 else 0 end
    end
  end
  def nc_skip(source: bytes, pos: integer, steps: integer): integer do
    if pos < 0 do -1 else
      if nc_ignored(source,pos) == 0 do pos else
        if steps <= 1 do
          next = nc_spaces(source,pos,16)
          if byte_at(source,next) == 35 do nc_line(source,next,262144) else next end
        else
          half = nc_half(steps)
          next = nc_skip(source,pos,half)
          if next < 0 do -1 else
            if nc_ignored(source,next) == 0 do next else nc_skip(source,next,steps-half) end
          end
        end
      end
    end
  end
  def nc_line_chunk(source: bytes, pos: integer, count: integer): integer do
    value = byte_at(source,pos)
    if count == 0 do pos else
      if value == -1 do pos else
        if value == 10 do pos else
          if value == 13 do pos else nc_line_chunk(source,pos+1,count-1) end
        end
      end
    end
  end
  def nc_line(source: bytes, pos: integer, count: integer): integer do
    next = nc_line_chunk(source,pos,16)
    if next-pos == 16 do
      if count == 0 do -1 else nc_line(source,next,count-1) end
    else next end
  end
  def nc_start(source: bytes, pos: integer): integer do
    if pos < 0 do -1 else
      if nc_ignored(source,pos) == 0 do pos else
        # One blank between two tokens is the common case.
        if nc_single(source,pos) == 1 do pos+1 else
          next = nc_skip(source,pos,16)
          if next < 0 do -1 else
            if nc_ignored(source,next) == 0 do next else nc_skip(source,next,16777216) end
          end
        end
      end
    end
  end
  # 1 when pos holds a blank, not the start of a comment, and a token follows it.
  def nc_single(source: bytes, pos: integer): integer do
    if byte_at(source,pos) == 35 do 0 else 1-nc_ignored(source,pos+1) end
  end
  def nc_scan(source: bytes, pos: integer, kind: integer, count: integer): integer do
    value = byte_at(source,pos)
    continues = if kind == 3 do is_digit(value) else is_identifier_continue(value) end
    if continues == 0 do pos else
      if count == 0 do -1 else nc_scan(source,pos+1,kind,count-1) end
    end
  end
  def nc_end(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    if start < 0 do -1 else
      if byte_at(source,start) == 34 do ns_token_end(source,start) else
      kind = classify_ascii(byte_at(source,start))
      # A name may end in ? or !; != after a name is the operator.
      if kind == 2 do
        stop = nc_scan(source,start,2,16777216)
        if byte_at(source,stop) == 63 do stop+1 else if byte_at(source,stop) == 33 do if byte_at(source,stop+1) == 61 do stop else stop+1 end else stop end end
      else
        if kind == 3 do nh_end(source,start) else nc_punctuation_end(source,start) end
      end
      end
    end
  end
  def nc_punctuation_end(source: bytes, pos: integer): integer do
    value = byte_at(source,pos)
    # The bitwise operators: &&& ||| ^^^ <<< >>> ~~~.
    if nk_tripled(source,pos) == 1 do pos+3 else
    if value == 45 do
      if byte_at(source,pos+1) == 62 do pos+2 else nc_equal_end(source,pos) end
    else
      if value == 61 do if (byte_at(source,pos+1)-62)*(byte_at(source,pos+1)-126) == 0 do pos+2 else nc_pair_end(source,pos) end else if value == 126 do sg_token_end(source,pos) else nc_pair_end(source,pos) end end
    end
    end
  end
  def nc_pair_end(source: bytes, pos: integer): integer do
    value = byte_at(source,pos)
    if value == 60 do
      if byte_at(source,pos+1) == 62 do pos+2 else nc_equal_end(source,pos) end
    else nc_equal_end(source,pos) end
  end
  def nc_equal_end(source: bytes, pos: integer): integer do
    value = byte_at(source,pos)
    if byte_at(source,pos+1) == value do
      if (value-42)*(value-43)*(value-45)*(value-38)*(value-124)*(value-46)*(value-47) == 0 do pos+2 else nc_compare_end(source,pos) end
    else nc_compare_end(source,pos) end
  end
  def nc_compare_end(source: bytes, pos: integer): integer do
    value = byte_at(source,pos)
    if byte_at(source,pos+1) == 61 do
      if value == 61 do pos+2 else
        if value == 33 do pos+2 else
          if value == 60 do pos+2 else if value == 62 do pos+2 else pos+1 end end
        end
      end
    else pos+1 end
  end
  def nc_equal(source: bytes, a: integer, b: integer, size: integer): integer do
    if size == 0 do 1 else
      if byte_at(source,a) != byte_at(source,b) do 0 else nc_equal(source,a+1,b+1,size-1) end
    end
  end
  def nc_word_at(source: bytes, pos: integer, word: bytes, index: integer): integer do
    if index == Enum.count(word) do 1 else
      if byte_at(source,pos+index) != Enum.at(word,index,-1) do 0 else nc_word_at(source,pos,word,index+1) end
    end
  end
  def nc_word(source: bytes, pos: integer, word: bytes): integer do
    start = nc_start(source,pos)
    # Most words asked for are not there: the first byte says so without reading the token.
    if start < 0 do 0 else if byte_at(source,start) != Enum.at(word,0,-1) do 0 else
      if nc_end(source,start)-start != Enum.count(word) do 0 else nc_word_at(source,start,word,0) end
    end end
  end
  # 1 for the do that opens a block: not the do: of a one-line if.
  def nc_opens(source: bytes, pos: integer): integer do
    if nc_word(source,pos,b[100,111]) == 0 do 0 else if byte_at(source,nc_end(source,pos)) == 58 do 0 else 1 end end
  end
  def nc_expect(source: bytes, pos: integer, word: bytes): integer do
    if nc_word(source,pos,word) == 1 do nc_end(source,pos) else -1 end
  end
  def nc_identifier(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    if start < 0 do 0 else
      if classify_ascii(byte_at(source,start)) != 2 do 0 else
        if nc_end(source,start) < 0 do 0 else
          if nc_word(source,start,b[100,111]) == 1 do 0 else
            if nc_word(source,start,b[101,110,100]) == 1 do 0 else
              if nc_word(source,start,b[100,101,102]) == 1 do 0 else
                if nc_word(source,start,b[100,101,102,112]) == 1 do 0 else
                  if nc_word(source,start,b[105,110,116,101,103,101,114]) == 2 do 0 else
                    if nc_word(source,start,b[83,121,115,116,101,109]) == 1 do 0 else
 if nc_reserved(source,start) == 1 do 0 else 1 end
 end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  def nc_reserved(source: bytes, pos: integer): integer do
    group = nc_word(source,pos,b[105,102])+nc_word(source,pos,b[101,108,115,101])+nc_word(source,pos,b[100,101,102,109,111,100,117,108,101])+nc_word(source,pos,b[116,114,117,101])+nc_word(source,pos,b[102,97,108,115,101])
    # The words of types (integer, string, boolean, bytes, option, void) and
    # byte_size name bindings like any other, as in the pinned language.
    other = nc_word(source,pos,b[114,101,116,117,114,110])+nc_word(source,pos,b[110,111,116])
    text = nc_word(source,pos,b[73,79])
    option_words = nc_word(source,pos,b[99,97,115,101])
    if group+other+text+option_words+nc_word(source,pos,b[97,110,100])+nc_word(source,pos,b[111,114])+nc_word(source,pos,b[73,110,116,101,103,101,114]) > 0 do 1 else 0 end
  end
  # 1 for a word the pinned language lets no binding or parameter have: its
  # keywords and the functions it keeps without a module.
  def nc_unbindable(source: bytes, pos: integer): integer do
    value = byte_at(source,nc_start(source,pos))
    if nc_and((value-97)*(value-99)*(value-100)*(value-101)*(value-102)*(value-103)*(value-104),(value-105)*(value-108)*(value-109)*(value-112)*(value-114)*(value-117)*(value-119)) != 0 do 0 else
      first = nc_word(source,pos,b[97,115,115,101,114,116])+nc_word(source,pos,b[108,101,110,103,116,104])+nc_word(source,pos,b[119,104,101,110])+nc_word(source,pos,b[112,114,101,112,101,110,100])+nc_word(source,pos,b[99,111,110,99,97,116])+nc_word(source,pos,b[109,97,112])+nc_word(source,pos,b[102,105,108,116,101,114])+nc_word(source,pos,b[114,101,100,117,99,101])+nc_word(source,pos,b[112,117,116])+nc_word(source,pos,b[103,101,116])+nc_word(source,pos,b[104,97,115,95,107,101,121])
      second = nc_word(source,pos,b[105,109,112,111,114,116])+nc_word(source,pos,b[101,120,116,101,114,110])+nc_word(source,pos,b[114,101,113,117,105,114,101])+nc_word(source,pos,b[105,110])+nc_word(source,pos,b[99,111,110,100])+nc_word(source,pos,b[114,97,105,115,101])+nc_word(source,pos,b[119,105,116,104])+nc_word(source,pos,b[102,111,114])+nc_word(source,pos,b[117,110,108,101,115,115])+nc_word(source,pos,b[100,101,102,112,114,111,116,111,99,111,108])+nc_word(source,pos,b[100,101,102,105,109,112,108])+nc_word(source,pos,b[100,101,102,109,97,99,114,111])+nc_word(source,pos,b[102,110])
      if first+second > 0 do 1 else 0 end
    end
  end
  def nc_meta(table: bytes, index: integer, field: integer): integer do
    nc_cursor(table,index*27+field)
  end
  def nc_owner(table: bytes, index: integer): integer do nc_read(table,index*27+25) end
  # The number of parameters of a function's record (of type parameters, for
  # a struct or sum type): its low byte after the positions, its high byte
  # before the owner.
  def nc_argc(table: bytes, index: integer): integer do Enum.at(table,index*27+15,0)+Enum.at(table,index*27+24,0)*256 end
  # The function named at pos in module owner; owner -1 finds a module header.
  def nc_find(source: bytes, pos: integer, table: bytes, owner: integer): integer do
    if nc_indexed(table) == 0 do nc_find_range(source,pos,table,0,nc_records(Enum.count(table)),owner) else
      if owner < 0 do nc_index_find(source,table,nc_index_key(table,pos,nc_end(source,pos)-pos,0,0),1) else
        count = nc_records(Enum.count(table))
        first = nj_scan(source,pos,table,0,count,owner)
        # The only function of the name is the one any search finds.
        if first < 0 do -1 else if nj_scan(source,pos,table,first+1,count,owner) < 0 do first else nc_find_among(source,pos,table,0,count,owner) end end
      end
    end
  end
  # Of several functions of one name the one nc_find_range comes to first:
  # the middle of the range, else the left half's, else the right half's.
  def nc_find_among(source: bytes, pos: integer, table: bytes, first: integer, stop: integer, owner: integer): integer do
    middle = first+nc_half(stop-first)
    least = if first >= stop do -1 else nj_scan(source,pos,table,first,stop,owner) end
    if least < 0 do -1 else if nj_scan(source,pos,table,middle,middle+1,owner) == middle do middle else
      if least < middle do nc_find_among(source,pos,table,first,middle,owner) else nc_find_among(source,pos,table,middle+1,stop,owner) end
    end end
  end
  # The name index. A key: where a name is in the source and its length, a
  # module, a record number and where the index ends in the table (3 bytes
  # each); a name that is not in the source follows the key.
  def nc_index_key(table: bytes, pos: integer, size: integer, owner: integer, from: integer): bytes do
    count = nc_records(Enum.count(table))
    nc_join(nc_join(nc_u24(pos),nc_u24(size),nc_u24(owner)),nc_u24(from),nc_u24(count*31+27))
  end
  # The first difference of count bytes of left from at and of right from
  # start, 0 when there is none.
  def nc_differ(left: bytes, at: integer, right: bytes, start: integer, count: integer): integer do
    if count <= 0 do 0 else
      gap = Enum.at(left,at,0)-Enum.at(right,start,0)
      if gap != 0 do gap else nc_differ(left,at+1,right,start+1,count-1) end
    end
  end
  # The name of record id against the key's: negative when it sorts before.
  def nc_name_order(source: bytes, table: bytes, id: integer, key: bytes): integer do
    start = nc_meta(table,id,0)
    size = nc_meta(table,id,3)-start
    wanted = nc_cursor(key,3)
    least = if size < wanted do size else wanted end
    gap = if Enum.count(key) > 15 do nc_differ(source,start,key,15,least) else nc_differ(source,start,source,nc_cursor(key,0),least) end
    if gap != 0 do gap else size-wanted end
  end
  # Record id against a key, by name, then module, then record number.
  def nc_order(source: bytes, table: bytes, id: integer, key: bytes): integer do
    gap = nc_name_order(source,table,id,key)
    if gap != 0 do gap else
      if nc_owner(table,id) != nc_cursor(key,6) do nc_owner(table,id)-nc_cursor(key,6) else id-nc_cursor(key,9) end
    end
  end
  # Where the key would stand among the record numbers (u32 each, in order)
  # that held has from byte first up to stop.
  def nc_seek(source: bytes, table: bytes, held: bytes, key: bytes, first: integer, stop: integer): integer do
    if first >= stop do first else
      middle = first+nc_half(nc_half(nc_half(stop-first)))*4
      if nc_order(source,table,nc_cursor(held,middle),key) < 0 do nc_seek(source,table,held,key,middle+4,stop) else nc_seek(source,table,held,key,first,middle) end
    end
  end
  # The first record from index byte at on that has the key's name and is of
  # the kind wanted: 0 a function of the key's module, 1 a module header, 2 a
  # struct or sum type of the key's module. -1 when there is none.
  def nc_index_walk(source: bytes, table: bytes, key: bytes, at: integer, kind: integer): integer do
    id = nc_cursor(table,at)
    flags = Enum.at(table,id*27+16,0)
    fits = if kind == 1 do if flags == 32 do 1 else 0 end else if kind == 0 do if flags < 32 do 1 else 0 end else if flags >= 64 do 1 else 0 end end end
    if at >= nc_cursor(key,12) do -1 else if nc_name_order(source,table,id,key) != 0 do -1 else
      if kind != 1 do
        if nc_owner(table,id) != nc_cursor(key,6) do -1 else if fits == 1 do id else nc_index_walk(source,table,key,at+4,kind) end end
      else
        if fits == 1 do id else nc_index_walk(source,table,key,at+4,kind) end
      end
    end end
  end
  def nc_index_find(source: bytes, table: bytes, key: bytes, kind: integer): integer do
    count = nc_records(Enum.count(table))
    if nc_cursor(key,3) <= 0 do -1 else nc_index_walk(source,table,key,nc_seek(source,table,table,key,count*27+27,count*31+27),kind) end
  end
  def nc_zip(source: bytes, table: bytes, left: bytes, right: bytes): bytes do
    if Enum.count(left) == 0 do right else if Enum.count(right) == 0 do left else
      if nc_order(source,table,nc_cursor(left,0),nc_record_key(table,nc_cursor(right,0))) < 0 do
        Enum.concat(nc_slice(left,0,4),nc_zip(source,table,nc_slice(left,4,Enum.count(left)),right))
      else
        Enum.concat(nc_slice(right,0,4),nc_zip(source,table,left,nc_slice(right,4,Enum.count(right))))
      end
    end end
