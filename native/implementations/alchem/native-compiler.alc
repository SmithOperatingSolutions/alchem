  def nc_addresses(lengths: bytes, id: integer, offset: integer): bytes do
    nc_address_range(lengths,id,nc_units(Enum.count(lengths),4),offset)
  end
  def nc_address_range(lengths: bytes, first: integer, stop: integer, offset: integer): bytes do
    if first >= stop do b[] else
