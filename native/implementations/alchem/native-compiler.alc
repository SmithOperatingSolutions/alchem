  def nc_limit(): integer do 16776191 end
  def nc_compile(given: bytes): bytes do
    if Enum.count(given) > nc_limit() do b[] else ac_compiled(given) end
  end
  # Macros, protocols and templates are rewritten (native-macros.alc), after
