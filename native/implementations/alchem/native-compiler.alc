            if nc_word(source,name,b[115,108,105,99,101]) == 1 do 4 else
              if nc_word(source,name,b[115,117,109]) == 1 do 5 else
                if nc_word(source,name,b[114,101,118,101,114,115,101]) == 1 do 6 else
                  if nc_word(source,name,b[116,97,107,101]) == 1 do 7 else
