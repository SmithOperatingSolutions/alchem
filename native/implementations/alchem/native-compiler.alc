          translated = if nc_a64() == 1 do nc_slice(arm,4+nc_long(arm,0),Enum.count(arm)) else plain_code end
          # Coverage counts calls by where they stand: on ARM64 that is known now.
          code = if nc_a64() == 1 do (if Enum.at(table,15,0) == 2 do zf_cover_arm_points(translated,meta,table) else translated end) else plain_code end
          # The image's size and every address in it are 32-bit fields, and a
          # jump reaches 2 GiB: 1 GiB of code keeps the image well within both.
