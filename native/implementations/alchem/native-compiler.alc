  # the places of the rewritten text are turned back to that text. The
  # library is chosen from what is compiled, so a function only a macro's
  # template or a function added by use mentions is there.
  # A test file is rewritten first (native-testing.alc), and what that
  # leaves is rewritten as any program: the places of the second text are
  # turned back through the first.
  def nc_rewritten(source: bytes): bytes do
    tested = tm_prepare(source)
    if Enum.count(tested) == 0 do b[] else if Enum.count(tested) == 1 do nc_rewritten_plain(source) else tm_then(tested) end end
  end
  def nc_rewritten_plain(source: bytes): bytes do
