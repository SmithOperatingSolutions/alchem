    end
  end
  def nc_length_sum(lengths: bytes, first: integer, stop: integer): integer do
    if first >= stop do 0 else
      if stop-first == 1 do nc_long(lengths,first*4) else
        middle = first+nc_half(stop-first)
        nc_length_sum(lengths,first,middle)+nc_length_sum(lengths,middle,stop)
