  # Bundles: metadata length u16, one 32-bit function length each, then code.
  # The bundle of a program's own functions (nc_build) has a 32-bit metadata
  # length: 65536 records have 262144 bytes of lengths.
  def nc_built_meta(bundle: bytes): bytes do
    nc_slice(bundle,4,4+nc_long(bundle,0))
  end
  def nc_built_code(bundle: bytes): bytes do
    nc_slice(bundle,4+nc_long(bundle,0),Enum.count(bundle))
  end
  def nc_bundle_meta(bundle: bytes): bytes do
    nc_slice(bundle,2,2+nc_read(bundle,0))
  end
  def nc_bundle_code(bundle: bytes): bytes do
    nc_slice(bundle,2+nc_read(bundle,0),Enum.count(bundle))
  end
  def nc_build(source: bytes, table: bytes, first: integer, stop: integer): bytes do
