    wrap = nc_join(nc_allocate_emit(8),b[72,199,2,1,0,0,0],b[88,72,137,66,8,72,137,208])
    fail = nc_join(Enum.concat(b[95],ne_refused(source,table)),Enum.concat(b[80],nc_allocate_emit(8)),b[72,199,2,0,0,0,0,88,72,137,66,8,72,137,208])
    good = nc_join(b[72,137,4,36],wrap,Enum.concat(b[233],nc_u32(Enum.count(fail))))
    call = nc_join(b[72,139,60,36],ne_run(table,2),Enum.concat(b[72,133,210,15,133],nc_u32(Enum.count(good))))
    nc_value(nc_pos(args),nc_join(nc_arg_code(args),call,Enum.concat(good,fail)),b[6,24,2])
  end
  # String.to_float(text): the float, or the program ends naming the call.
  def ne_to_float(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    dot = nc_expect(source,nc_end(source,pos),b[46])
    begin = nc_expect(source,nc_end(source,dot),b[40])
    args = if begin < 0 do b[] else nc_arguments(source,begin,env,table,depth) end
    message = if nz_on(table) == 0 do nc_exit_code(70) else nc_join(Enum.concat(b[95],ne_refused(source,table)),Enum.concat(b[72,137,198,191],nc_u32(nc_start(source,pos))),nc_call(nz_slot(table))) end
    call = nc_join(b[72,139,60,36],ne_run(table,2),Enum.concat(b[72,133,210,15,132],nc_u32(Enum.count(message))))
    if nc_pos(args) < 0 do b[] else if nc_arg_count(args) != 1 do b[] else if nt_tag(nc_arg_kind(args,0)) != 2 do b[] else
      nc_value(nc_pos(args),nc_join(nc_arg_code(args),call,Enum.concat(message,b[89])),b[24])
    end end end
  end
  # ---- the runtime ----
  # Whether the source may use floats: the letters "loat" or a point between
  # digits. A false positive only adds the runtime.
  def ne_mentions(source: bytes, first: integer, stop: integer): integer do
    if stop-first > 64 do
      middle = first+nc_half(stop-first)
      if ne_mentions(source,first,middle) == 1 do 1 else ne_mentions(source,middle,stop) end
    else ne_scan(source,first,stop) end
  end
  def ne_scan(source: bytes, pos: integer, stop: integer): integer do
    value = byte_at(source,pos)
    found = if value == 46 do is_digit(byte_at(source,pos-1))*is_digit(byte_at(source,pos+1)) else if value == 108 do nc_word_at(source,pos,b[108,111,97,116],0) else 0 end end
    if pos >= stop do 0 else if found == 1 do 1 else ne_scan(source,pos+1,stop) end end
  end
  # The shared runtimes with the float runtime in the slot after the trace's.
  def ne_shared(shared: bytes, source: bytes, functions: integer): bytes do
    meta = nc_bundle_meta(shared)
    blob = if functions+5 > nc_slot_limit() do b[] else if ne_mentions(source,0,Enum.count(source)) == 0 do b[] else xa_runtime(fl_blob(),fl_blob_arm()) end end
    if Enum.count(blob) == 0 do shared else
      nc_join(nc_u16(24),nc_join(meta,nc_zeros(20-Enum.count(meta)),nc_u32(Enum.count(blob))),Enum.concat(nc_bundle_code(shared),blob))
    end
  end
  # Whether the source needs the quoting of the Integer.parse runtime.
  def ne_quoting(source: bytes, size: integer): integer do
    na_mentions(source,0,size,b[70,108,111,97,116],b[112,97,114,115,101])+na_mentions(source,0,size,na_text(),b[116,111,95,102,108,111,97,116])
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
