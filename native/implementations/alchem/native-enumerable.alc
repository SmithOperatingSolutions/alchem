defmodule NativeEnumerable do
  # A parameter the pinned library writes enum[...] (a list, a map, a set, a
  # stream or a range) gives its argument no type to expect, unless the
  # argument is the literal []: the pinned checker types anything else there
  # on its own (library(), compiler/syntax/library.go). So an argument that
  # needs a type from its context is rejected: Enum.reverse(Enum.reverse([])),
  # Map.new([{"a", []}]), Enum.reverse([none]), and a pipe into such a
  # function from anything but []. Which parameters are enum is the table of
  # native-enumerable-data.alc, made from the pinned registrations.
  #
  # The bits of the enum parameters of the function whose name stands from
  # start with size bytes and that takes arity arguments; 0 when it has none.
  def en_find(source: bytes, start: integer, size: integer, arity: integer, rows: bytes, at: integer): integer do
    span = Enum.at(rows,at,0)
    if span == 0 do 0 else
      if span != size do en_find(source,start,size,arity,rows,at+3+span) else if Enum.at(rows,at+1+span,0) != arity do en_find(source,start,size,arity,rows,at+3+span) else
        if nc_differ(rows,at+1,source,start,span) != 0 do en_find(source,start,size,arity,rows,at+3+span) else Enum.at(rows,at+2+span,0) end
      end end
    end
  end
  # 1 when argument index of the packet needs a type from its context: its
  # value is marked so, or its type has a part still unknown.
  def en_need(args: bytes, index: integer): integer do
    kind = nc_arg_kind(args,index)
    mark = nw_arg_marked(args,index)
    if index >= nc_arg_count(args) do 0 else if nt_tag(kind) == 11 do 0 else
      if mark-nt_div(mark,2)*2 == 1 do 1 else nu_holes(kind,0) end
    end end
  end
  # Where argument index starts, of those from start on; -1 when they are
  # not plainly separated by commas.
  def en_start(source: bytes, start: integer, index: integer): integer do
    stop = if index <= 0 do start else nc_span(source,nc_span_state(start,0,0,0,0),16777216) end
    if index <= 0 do start else if stop <= start do -1 else if nc_word(source,stop,b[44]) == 0 do -1 else
      en_start(source,nc_start(source,nc_end(source,stop)),index-1)
    end end end
  end
  # 1 when [] and then a comma or the closing parenthesis stand at pos.
  def en_empty(source: bytes, pos: integer): integer do
    close = nc_end(source,pos)
    if nc_word(source,pos,b[91])*nc_word(source,close,b[93]) == 0 do 0 else nc_word(source,nc_end(source,close),b[44])+nc_word(source,nc_end(source,close),b[41]) end
  end
  # 1 when what is piped into the call whose name starts at name is the
  # literal []: the two brackets before the |>, at the start of a value.
  def en_piped(source: bytes, name: integer): integer do
    pipe = nz_before(source,name-1)
    close = nz_before(source,pipe-2)
    open = nz_before(source,close-1)
    before = nz_before(source,open-1)
    value = byte_at(source,before)
    if byte_at(source,pipe)*256+byte_at(source,pipe-1) != 15996 do 1 else if byte_at(source,close) != 93 do 0 else if byte_at(source,open) != 91 do 0 else
      if before < 0 do 1 else if nk_line_start(source,open) == 1 do 1 else if (value-40)*(value-44)*(value-123)*(value-91) == 0 do 1 else
        if value == 61 do if (byte_at(source,before-1)-61)*(byte_at(source,before-1)-33)*(byte_at(source,before-1)-60)*(byte_at(source,before-1)-62) == 0 do 0 else 1 end else
          if value == 62 do if byte_at(source,before-1) == 45 do 1 else 0 end else
            if before < 1 do 0 else nc_word_at(source,before-1,b[100,111],0)+(if before < 3 do 0 else nc_word_at(source,before-3,b[101,108,115,101],0) end)+(if before < 5 do 0 else nc_word_at(source,before-5,b[114,101,116,117,114,110],0) end) end
          end
        end
      end end end
    end end end
  end
  # 1 when an enum parameter from index on (the bits of mask) has an
  # argument that needs a type from its context and is not the literal [].
  # place: where the arguments start, where the call's name does and 1 when
  # the first argument is piped in.
  def en_refused(source: bytes, args: bytes, mask: integer, index: integer, place: bytes): integer do
    piped = Enum.at(place,6,0)
    half = nt_div(mask,2)
    at = if index < piped do -1 else en_start(source,nc_start(source,nc_cursor(place,0)),index-piped) end
    literal = if index < piped do en_piped(source,nc_cursor(place,3)) else if at < 0 do 1 else en_empty(source,at) end end
    if mask == 0 do 0 else
      if mask-half*2 == 0 do en_refused(source,args,half,index+1,place) else
        if en_need(args,index) == 0 do en_refused(source,args,half,index+1,place) else
          if literal == 0 do 1 else en_refused(source,args,half,index+1,place) end
        end
      end
    end
  end
  # The arguments parsed for the call whose "(" stands just before pos, or
  # b[] when the call is to a function of the library and gives an enum
  # parameter a value that has no type of its own. The library written in
  # Alchem is not held to it: the pinned compiler has it in Go.
  def en_checked(source: bytes, pos: integer, env: bytes, table: bytes, args: bytes): bytes do
    name = nj_back(source,pos-1)
    first = byte_at(source,name)
    needy = if nc_pos(args) < 0 do 0 else if (first-65)*(90-first) < 0 do 0 else en_need(args,0)+en_need(args,1)+en_need(args,2) end end
    mask = if needy == 0 do 0 else if nn_library(source,env,table) == 1 do 0 else en_find(source,name,pos-1-name,nc_arg_count(args),en_table(),0) end end
    piped = if mask == 0 do 0 else if nc_pos(nf_piped(source,pos,env)) < 0 do 0 else 1 end end
    if mask == 0 do args else if en_refused(source,args,mask,0,nc_join(nc_u24(pos),nc_u24(name),b[piped])) == 1 do b[] else args end end
  end
  # Native smoke test; enum parameters of the library.
  def main() do System.halt(0) end
end
