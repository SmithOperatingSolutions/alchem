defmodule NativeJson do
  # JSON.encode, JSON.encode! and JSON.decode_as go by the static type of
  # their value or of what they are to give, which a function written in
  # Alchem cannot see. The compiler passes the library a description of the
  # type, the one inspect walks (native-inspect.alc), and the library
  # (library/JSON.alc) writes or builds the value by it:
  #   JSON.encode!(value)          encode!(word, description)
  #   JSON.encode!(value, options) encode!(word, options, description)
  #   JSON.encode(value)           encode(word, description)
  #   JSON.decode_as(text or JSON) decode_as(text or JSON, description of
  #                                the type the context expects in ok)
  #   Gen.check(generator, property[, runs])
  #                                check(generator, property[, runs],
  #                                description of the generator's values)
  # For that the library alone has, in any of its modules:
  #   M.__word(value)              the value as the word it is held in
  #   M.__kind(value)              where the description of its type stands
  #   M.__cast(word)               the word as a value of the expected type
  #   M.__show(word, description)  what inspect writes of such a value
  def jn_op(source: bytes, name: integer): integer do
    if nc_word(source,name,b[95,95,119,111,114,100]) == 1 do 1 else if nc_word(source,name,b[95,95,107,105,110,100]) == 1 do 2 else
      if nc_word(source,name,b[95,95,99,97,115,116]) == 1 do 3 else if nc_word(source,name,b[95,95,115,104,111,119]) == 1 do 4 else 0 end end
    end end
  end
  # The address of a description in RAX; the description stands behind the code.
  def jn_node(node: bytes): bytes do
    nc_join(xa_mark(Enum.count(node),b[72,141,5,5,0,0,0]),Enum.concat(b[233],nc_u32(Enum.count(node))),node)
  end
  def jn_intrinsic(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    name = nc_start(source,nc_expect(source,nc_end(source,pos),b[46]))
    op = jn_op(source,name)
    paren = if op == 0 do -1 else nc_expect(source,nc_end(source,name),b[40]) end
    args = if paren < 0 do b[] else nc_arguments(source,paren,env,table,depth) end
    if nc_pos(args) < 0 do b[] else jn_made(source,table,args,op,nw_expected(env,nc_start(source,nc_end(source,name)),3)) end
  end
  def jn_made(source: bytes, table: bytes, args: bytes, op: integer, wanted: bytes): bytes do
    count = nc_arg_count(args)
    code = nc_arg_code(args)
    whole = nt_tag(nc_arg_kind(args,0))+nt_tag(nc_arg_kind(args,1))
    node = if op != 2 do b[] else ni_describe(source,table,nc_arg_kind(args,0),0,b[1,254,0,0]) end
    if op == 4 do
      if count != 2 do b[] else if whole != 0 do b[] else nc_value(nc_pos(args),nc_join(code,b[94,95,186,4,0,0,0],nc_call(nc_records(Enum.count(table)))),b[2]) end end
    else if count != 1 do b[] else
      if op == 1 do nc_value(nc_pos(args),Enum.concat(code,b[88]),b[0]) else
        if op == 2 do if Enum.count(node) == 0 do b[] else nc_value(nc_pos(args),nc_join(code,b[88],jn_node(node)),b[0]) end else
          if nt_tag(nc_arg_kind(args,0)) != 0 do b[] else if Enum.count(wanted) == 0 do b[] else nc_value(nc_pos(args),Enum.concat(code,b[88]),wanted) end end
        end
      end
    end end
  end
  # 1 encode!, 2 encode, 3 decode_as.
  def jn_which(source: bytes, name: integer): integer do
    if nc_word(source,name,b[101,110,99,111,100,101,33]) == 1 do 1 else if nc_word(source,name,b[101,110,99,111,100,101]) == 1 do 2 else if nc_word(source,name,b[100,101,99,111,100,101,95,97,115]) == 1 do 3 else 0 end end end
  end
  # Module.name(...) of a module that is not the program's: the three JSON
  # functions in a program, else the library's function of that name.
  def jn_or(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    name = nc_start(source,nc_expect(source,nc_end(source,pos),b[46]))
    op = if nc_word(source,pos,b[74,83,79,78]) == 0 do 0 else if nn_library(source,env,table) == 1 do 0 else jn_which(source,name) end end
    check = if nc_word(source,pos,b[71,101,110]) == 0 do 0 else if nn_library(source,env,table) == 1 do 0 else nc_word(source,name,b[99,104,101,99,107]) end end
    if nc_word(source,pos,b[84,127]) == 1 do tm_intrinsic(source,pos,env,table,depth) else if check == 1 do jn_check(source,pos,env,table,Enum.concat(b[depth,4],nc_u32(name))) else if op == 0 do mp_or(source,pos,env,table,depth) else jn_call(source,pos,env,table,Enum.concat(b[depth,op],nc_u32(name))) end end end
  end
  def jn_call(source: bytes, pos: integer, env: bytes, table: bytes, plan: bytes): bytes do
    name = nc_long(plan,2)
    op = Enum.at(plan,1,0)
    paren = nc_expect(source,nc_end(source,name),b[40])
    given = if paren < 0 do b[] else nc_arguments(source,paren,env,table,Enum.at(plan,0,0)) end
    # A fn without types has no type to describe.
    args = if nc_pos(given) < 0 do b[] else if nf_has_pending(given,0) == 1 do b[] else given end end
    count = nc_arg_count(args)
    direct = nw_expected(env,nc_start(source,nc_end(source,name)),3)
    piped = if op != 3 do b[] else if Enum.count(direct) > 0 do b[] else if nc_pos(nf_piped(source,paren,env)) < 0 do b[] else jn_annotated(source,pos,env,table) end end end
    wanted = if op != 3 do b[] else if Enum.count(direct) > 0 do direct else if Enum.count(piped) > 0 do piped else jn_tail(source,Enum.concat(nc_u32(name),nc_u32(nc_start(source,pos))),env,table) end end end
    # decode_as gives result[a, string] for the a its context expects.
    target = if op != 3 do nc_arg_kind(args,0) else if nt_tag(wanted) != 6 do b[] else if nt_tag(nt_child(wanted,1)) != 2 do b[] else nt_child(wanted,0) end end end
    fits = if nc_pos(args) < 0 do 0 else if op == 3 do if count != 1 do 0 else nq_comparable(source,table,target,b[])*(1-jd_poisoned(source,table,target)) end else if count == 1 do 1 else if op == 1 do if count == 2 do 1 else 0 end else 0 end end end end
    described = if fits == 0 do b[] else ni_describe(source,table,target,0,Enum.concat(if op == 3 do b[1,255,0,0] else b[1,254,0,0] end,jd_seed(nu_vars(env,3),0))) end
    # JSON's text keys cannot give a tuple back: no map of such keys is read.
    node = if op != 3 do described else if Enum.count(described) == 0 do b[] else if jn_keyed(described,0) == 1 do b[] else described end end end
    kinds = nc_join(nt_cell(if op == 3 do nc_arg_kind(args,0) else b[0] end),if count == 2 do nt_cell(nc_arg_kind(args,1)) else b[] end,Enum.concat(b[1,0],nt_cell(nc_zeros(count+1))))
    packet = if Enum.count(node) == 0 do b[] else nc_arg_packet(nc_pos(args),count+1,kinds,nc_join(nc_arg_code(args),jd_placed(node,nu_vars(env,3)),b[80])) end
    home = Enum.concat(b[65,108,99,104,127,109,74,83,79,78],ny_digits(count+1))
    made = if Enum.count(node) == 0 do b[] else nn_passes(source,pos,name,env,table,nc_join(b[Enum.at(plan,0,0),1,0,Enum.count(home)],home,packet)) end
    if nc_pos(made) < 0 do b[] else nh_placed(table,if op == 3 do nc_join(nc_slice(made,0,4),nt_cell(wanted),nc_code(made)) else made end,nc_start(source,pos)) end
  end
  # Gen.check(generator, property) and Gen.check(generator, property, runs):
  # the library's check gets one argument more, the description of the type
  # of the generator's values, for the failing value it reports. The
  # property may be a fn whose types the library function gives it.
  def jn_check(source: bytes, pos: integer, env: bytes, table: bytes, plan: bytes): bytes do
    name = nc_long(plan,2)
    paren = nc_expect(source,nc_end(source,name),b[40])
    args = if paren < 0 do b[] else nc_arguments_open(source,paren,env,table,Enum.at(plan,0,0)) end
    count = nc_arg_count(args)
    types = nc_arg_types(args)
    first = nc_arg_kind(args,0)
    node = if nc_pos(args) < 0 do b[] else if (count-2)*(count-3) != 0 do b[] else if (nt_tag(first)-18)*(nt_tag(first)-19) != 0 do b[] else if nt_count(first) != 1 do b[] else ni_describe(source,table,nt_child(first,0),0,Enum.concat(b[1,254,0,0],jd_seed(nu_vars(env,3),0))) end end end end
    kinds = if Enum.count(node) == 0 do b[] else nc_join(nc_slice(types,0,nt_skip(types,0,count)),b[1,0],nt_cell(Enum.concat(nt_item(types,count),b[0]))) end
    packet = if Enum.count(node) == 0 do b[] else nc_arg_packet(nc_pos(args),count+1,kinds,nc_join(nc_arg_code(args),jd_placed(node,nu_vars(env,3)),b[80])) end
    home = Enum.concat(b[65,108,99,104,127,109,71,101,110],ny_digits(count+1))
    made = if Enum.count(node) == 0 do b[] else nn_passes(source,pos,name,env,table,nc_join(b[Enum.at(plan,0,0),1,0,Enum.count(home)],home,packet)) end
    if nc_pos(made) < 0 do b[] else nh_placed(table,made,nc_start(source,pos)) end
  end
  # 1 when the description at offset holds a map whose keys are tuples.
  def jn_keyed(node: bytes, offset: integer): integer do
    tag = Enum.at(node,offset+2,0)
    stop = offset+nc_read(node,offset)
    if (tag-4)*(tag-7)*(tag-25)*(tag-34) == 0 do jn_keyed(node,offset+3) else
      if tag == 6 do jn_run(node,offset+3,stop) else if tag == 8 do if Enum.at(node,offset+5,0) == 5 do 1 else jn_run(node,offset+3,stop) end else
        if tag == 5 do jn_run(node,offset+4,stop) else if tag == 13 do jn_fields(node,offset+5+Enum.at(node,offset+3,0),stop) else if tag == 14 do jn_variants(node,offset+5+Enum.at(node,offset+3,0),stop) else 0 end end end
      end end
    end
  end
  # Nodes one after another, the fields of a struct and the variants of a sum type, up to stop.
  def jn_run(node: bytes, offset: integer, stop: integer): integer do
    if offset >= stop do 0 else if jn_keyed(node,offset) == 1 do 1 else jn_run(node,offset+nc_read(node,offset),stop) end end
  end
  def jn_fields(node: bytes, offset: integer, stop: integer): integer do
    start = offset+1+Enum.at(node,offset,0)
    if offset >= stop do 0 else if jn_keyed(node,start) == 1 do 1 else jn_fields(node,start+nc_read(node,start),stop) end end
  end
  def jn_variants(node: bytes, offset: integer, stop: integer): integer do
    if offset >= stop do 0 else if jn_run(node,offset+4+Enum.at(node,offset+2,0),offset+nc_read(node,offset)) == 1 do 1 else jn_variants(node,offset+nc_read(node,offset),stop) end end
  end
  # What decode_as is expected to give where no binding of its own says: at
  # the end of a pipe, the annotation of the binding the pipe is the value
  # of; as the value a function or fn ends with, its result type.
  def jn_back(source: bytes, pos: integer, left: integer): integer do
    value = byte_at(source,pos)
    before = byte_at(source,pos-1)
    after = byte_at(source,pos+1)
    lone = if value != 61 do 0 else if (after-61)*(after-62)*(after-126) == 0 do 0 else if (before-61)*(before-33)*(before-60)*(before-62) == 0 do 0 else 1 end end end
    if pos <= 0 do -1 else if left == 0 do -1 else if lone == 1 do pos else jn_back(source,pos-1,left-1) end end end
  end
  def jn_line(source: bytes, pos: integer): integer do
    if pos <= 0 do 0 else if byte_at(source,pos-1) == 10 do pos else jn_line(source,pos-1) end end
  end
  def jn_annotated(source: bytes, pos: integer, env: bytes, table: bytes): bytes do
    equal = jn_back(source,pos,4000)
    start = if equal < 0 do -1 else nc_start(source,jn_line(source,equal)) end
    colon = if start < 0 do -1 else nc_end(source,start) end
    declared = if start < 0 do b[] else if nc_identifier(source,start) == 0 do b[] else if nc_word(source,colon,b[58]) == 0 do b[] else nc_type(source,nc_end(source,colon)) end end end
    if nc_pos(declared) < 0 do b[] else if nc_start(source,nc_pos(declared)) != equal do b[] else nd_resolve(source,table,nc_owner(table,nc_cursor(env,0)),nc_kind(declared)) end end
  end
  def jn_tail(source: bytes, plan: bytes, env: bytes, table: bytes): bytes do
    name = nc_long(plan,0)
    next = nc_start(source,np_close(source,nc_start(source,nc_end(source,name)),0,16777216))
    scope = nj_context(env,3,b[])
    id = nc_cursor(env,0)
    # What is expected of the call itself, or of the block it ends.
    placed = nw_expected(env,nc_long(plan,4),3)
    held = if Enum.count(placed) > 0 do placed else if ty_ends(source,next,env) == 0 do b[] else nf_ambient(source,env,table) end end
    if nt_tag(held) == 6 do held else if nc_word(source,next,b[101,110,100])+nc_word(source,next,b[101,108,115,101]) == 0 do b[] else
      if Enum.at(scope,0,0) == 41 do nc_slice(scope,1,Enum.count(scope)) else if nj_result(table,id) == 0 do b[] else nc_return_kind(source,table,id) end end
    end end
  end
  # Native smoke test; JSON by the type.
  def main() do System.halt(0) end
end
