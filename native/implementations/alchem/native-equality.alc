  # A comparator stands for the equality of a type that is not known where the
  # code is made: 0 compares words, 1 compares strings, 12 compares floats, an address in the image
  # (below 4 GiB) is code to call, and anything else is a function value in the
  # arena; each takes the two values in RDI and RSI, and 0 in RDX: the comparator
  # of an ordered type variable also orders, when RDX is 1 (native-ordering.alc).
  # vars lists the type
  # variables in reach, each as its name's length, its name and the frame slot
  # that holds its comparator.
  def nq_slot(vars: bytes, name: bytes, offset: integer): integer do
