  end
  # How much longer nq_call is in a position-independent program.
  def nq_grown(): integer do if nc_pic() == 1 do 11 else 0 end end
  def nq_jz(distance: integer): bytes do Enum.concat(b[15,132],nq_rel(distance)) end
  def nq_jnz(distance: integer): bytes do Enum.concat(b[15,133],nq_rel(distance)) end
  def nq_jmp(distance: integer): bytes do Enum.concat(b[233],nq_rel(distance)) end
