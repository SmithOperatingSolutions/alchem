      if (tag-4)*(tag-7)*(tag-25) == 0 do nq_comparable(source,table,nt_child(kind,0),seen) else
        if (tag-6)*(tag-8) == 0 do nq_comparable(source,table,nt_child(kind,0),seen)*nq_comparable(source,table,nt_child(kind,1),seen) else
