  def nq_comparator(source: bytes, table: bytes, kind: bytes, vars: bytes): bytes do
    tag = nt_tag(kind)
    slot = if tag == 16 do nq_slot(vars,nc_slice(kind,2,Enum.count(kind)),0) else -1 end
    if (tag-0)*(tag-3)*(tag-9) == 0 do b[49,192] else if tag == 24 do b[184,12,0,0,0] else if (tag-1)*(tag-2)*(tag-22) == 0 do b[184,1,0,0,0] else
      if tag == 16 do if slot < 0 do b[] else if slot < 16777216 do nc_slot(b[72,139,69],slot) else Enum.concat(b[72,139,69,248,72,139,128],nc_u32((slot-16777216)*8)) end end else
        if (tag-13)*(tag-14) == 0 do if nd_id(table,kind) < 0 do b[] else Enum.concat(b[72,139,4,37],nc_u32(4195456+nd_id(table,kind)*8)) end else
