    # Variant -1 has no fields: the value a receive that ran out of time leaves (zf_zero).
    given = nq_arms(source,table,id,0,vars)
    arms = nc_join(b[72,61,255,255,255,255],nq_jnz(2+Enum.count(nq_return(vars))),nc_join(b[176,1],nq_return(vars),given))
    if Enum.count(given) == 0 do b[] else
      nc_join(Enum.concat(b[72,139,71,8,72,59,70,8],nq_jnz(Enum.count(arms))),arms,Enum.concat(b[49,192],nq_return(vars)))
    end
  end
  def nq_arms(source: bytes, table: bytes, id: integer, index: integer, vars: bytes): bytes do
    nq_arms_at(source,table,Enum.concat(nc_u24(id),nc_u24(nc_meta(table,id,9))),index,vars)
  end
  # at: the type's id (3 bytes) and where variant index is declared.
  def nq_arms_at(source: bytes, table: bytes, at: bytes, index: integer, vars: bytes): bytes do
    id = nc_cursor(at,0)
    found = nv_here(source,nc_cursor(at,3))
    variant = nc_code(found)
    if nc_pos(found) < 0 do b[] else
      body = nq_fields(source,table,nq_cells_of(source,table,id,variant),nc_join(nc_u24(0),nc_u24(nv_fields_of(variant)),b[16]),vars)
      rest = nq_arms_at(source,table,Enum.concat(nc_slice(at,0,3),nc_u24(nc_pos(found))),index+1,vars)
      if Enum.count(body) == 0 do b[] else
        nc_join(nc_join(b[72,61],nc_u32(index),nq_jnz(Enum.count(body)+Enum.count(nq_return(vars)))),Enum.concat(body,nq_return(vars)),rest)
      end
    end
  end
  # left == right or left != right for a compound type: a boolean in RAX.
  def nq_compare(source: bytes, table: bytes, left: bytes, right: bytes, plan: bytes): bytes do
    # plan: the operator's condition code, then the type variables in reach.
    cc = Enum.at(plan,0,0)
    kind = nt_merge(nc_kind(left),nc_kind(right))
    code = if nq_comparable(source,table,kind,b[]) == 0 do b[] else nq_code(source,table,kind,nc_slice(plan,1,Enum.count(plan))) end
    negate = if cc == 149 do b[131,240,1] else b[] end
    if Enum.count(code) == 0 do b[] else
      nc_value(nc_pos(right),nc_join(nc_join(nc_code(left),b[80],nc_code(right)),nc_join(b[72,137,198,95],code,b[15,182,192]),negate),b[3])
    end
  end
  # Native smoke test; structural equality.
  def main() do System.halt(0) end
end
