  end
  def nn_range_stream(): bytes do
    Enum.concat(b[233,128,0,0,0,77,139,66,24,49,192,77,133,192,116,45,73,139,122,8,120,8,73,59,122,16,127,33,235,6,73,59,122,16,124,25,73,137,122,40,76,1,199,113,8,73,199,66,24,0,0,0,0,73,137,122,8,73,141,66,32,195,77,141,92,36,48,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,15,31,68,0,0,77,137,220,72,141,13,164,255,255,255,72,137,8,73,139,74,8,72,137,72,8,73,139,74,16],b[72,137,72,16,73,139,74,24,72,137,72,24,72,199,64,32,1,0,0,0,195,72,139,8,72,1,201,72,141,84,200,8,77,141,92,36,32,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,15,31,68,0,0,77,137,220,72,141,13,139,255,255,255,72,137,8,72,139,10,72,137,72,8,72,139,74,8,72,137,72,16,72,139,74,16,72,137,72,24])
  end
  def nn_list_stream(): bytes do
    Enum.concat(b[235,99,73,139,114,8,49,192,72,131,62,0,116,23,72,139,86,8,72,131,198,16,73,137,114,8,73,137,82,32,73,141,66,24,15,31,0,195,77,141,92,36,40,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,15,31,68,0,0,77,137,220,72,141,13,185,255,255,255,72,137,8,73,139,74,8,72,137,72,8,72,199,64,16,0,0,0,0,72,199,64,24,1,0,0,0,195],b[72,137,194,77,141,92,36,16,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,15,31,68,0,0,77,137,220,72,141,13,155,255,255,255,72,137,8,72,137,80,8])
  end
  # The iterator over the list in RAX.
  def nn_iterator(): bytes do
    b[235,36,73,139,114,8,49,192,72,131,62,0,116,23,72,139,86,8,72,131,198,16,73,137,114,8,73,137,82,32,73,141,66,24,15,31,0,195,72,137,194,77,141,92,36,40,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,15,31,68,0,0,77,137,220,72,141,13,182,255,255,255,72,137,8,72,137,80,8,72,199,64,16,0,0,0,0,72,199,64,24,1,0,0,0]
  end
  # A fresh context in RAX: some(a function that does nothing).
  def nn_context(): bytes do
    b[77,141,92,36,32,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,15,31,68,0,0,77,137,220,72,141,13,21,0,0,0,72,137,72,16,72,199,0,1,0,0,0,72,141,72,16,72,137,72,8,235,3,49,192,195]
  end
  # The context from the stack is ended: its function is called. RAX stays.
  def nn_finish(): bytes do b[90,80,76,139,82,8,65,255,18,88] end
  # The list of what the iterator in RAX still gives.
  def nn_all(): bytes do
    Enum.concat(b[106,0,80,76,139,20,36,65,255,18,72,133,192,116,50,72,139,80,8,72,139,76,36,8,72,255,193,73,137,203,73,193,227,4,79,141,92,28,24,77,57,235,118,12,255,20,37,120,4,64,0,15,31,68,0,0,88,72,137,20,36,81,80,235,194,88,89],nl_pack_blob())
  end
  # The iterator of the stream in RAX, started under a fresh context that
