    nc_join(nn_context(),b[76,139,84,36,8,72,137,68,36,8,72,137,199,65,255,18,72,137,199,65,90,65,255,18],nn_finish())
  end
  # The list in RAX as a list of {element, true}: the entries of a set.
  def nn_pairs(): bytes do
    Enum.concat(b[72,137,198,72,139,14,72,141,20,137,72,193,226,3,72,131,194,24,77,141,28,20,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,15,31,68,0,0,77,137,220,72,199,0,254,255,255,255,72,131,192,16,72,137,202,72,193,226,4,72,141],b[124,16,8,72,199,71,248,0,0,0,0,72,137,194,72,133,201,116,47,76,139,70,8,72,199,7,2,0,0,0,76,137,71,8,72,199,71,16,1,0,0,0,72,137,10,72,137,122,8,72,131,199,24,72,131,194,16,72,131,198,16,72,255,201,235,204])
  end
  # The elements of a set (what 0) or the entries of a map (2), as a list.
  def nn_entries(what: integer): bytes do
    Enum.concat(b[80,65,186,what,0,0,0],nm_entries_emit())
  end
  # value in set: the value waits on the stack and the set is in RAX. tagged
  # says what the map routines need to know of the key type.
  def nn_has(pos: integer, pushed: bytes, tagged: bytes): bytes do
    if Enum.count(tagged) == 0 do b[] else nc_value(pos,nc_join(pushed,Enum.concat(b[94,80,86,106,0],tagged),Enum.concat(b[65,185,2,0,0,0],nm_get_emit())),b[3]) end
  end
  # value in stream: the value waits on the stack and the stream is in RAX.
  # compare takes two values in RDI and RSI and leaves 1 or 0 in AL.
  def nn_member(compare: bytes): bytes do
    nc_join(nc_join(nn_begin(),b[80,76,139,20,36,65,255,18,72,133,192,116,23,72,139,112,8,72,139,124,36,16,232,29,0,0,0,132,192,116,226,184,1,0,0,0,89],nn_finish()),Enum.concat(b[72,131,196,8,233],nc_u32(Enum.count(compare)+1)),Enum.concat(compare,b[195]))
  end
  # The code that turns a value of type given into a list (wanted 7) or a
  # stream (26) of its elements; b[] when it is not an enumerable of another
  # kind.
  def nn_convert(given: bytes, wanted: integer): bytes do
    tag = nt_tag(given)
    if tag == wanted do b[] else
      flat = if tag == 25 do nn_entries(0) else if tag == 8 do nn_entries(2) else if tag == 7 do b[144] else b[] end end end
      if wanted == 7 do
        if tag == 26 do nn_stream_list() else if tag == 23 do nn_range_list() else if tag == 7 do b[] else flat end end end
      else
        if tag == 23 do nn_range_stream() else if Enum.count(flat) == 0 do b[] else Enum.concat(flat,nn_list_stream()) end end
      end
    end
  end
  # What an enumerable holds: the element of a list, set or stream, an
  # integer for a range, {key, value} for a map.
  def nn_element(given: bytes): bytes do
    tag = nt_tag(given)
    if (tag-7)*(tag-25)*(tag-26) == 0 do nt_child(given,0) else if tag == 23 do b[0] else
      if tag != 8 do b[] else nt_tuple(Enum.concat(nt_cell(nt_child(given,0)),nt_cell(nt_child(given,1))),2) end
    end end
  end
  # An argument packet whose argument index is replaced by what code makes
  # of it, with type kind: the arguments are on the stack when code runs.
  def nn_replace(args: bytes, index: integer, kind: bytes, code: bytes): bytes do
    place = nc_u32((nc_arg_count(args)-1-index)*8)
    kinds = nt_replace(nc_arg_types(args),index,kind)
    nc_join(nc_arg_packet(nc_pos(args),nc_arg_count(args),kinds,nc_arg_code(args)),b[],nc_join(Enum.concat(b[72,139,132,36],place),code,Enum.concat(b[72,137,132,36],place)))
  end
  # The arguments from index on, each made the list or stream its parameter
  # is declared as. plan: 1 for streams, 2 for the first argument as a list
  # too, 3 for every argument.
  def nn_coerce(cells: bytes, args: bytes, index: integer, plan: bytes): bytes do
    wanted = nt_tag(nt_item(cells,index))
    given = nc_arg_kind(args,index)
    mode = Enum.at(plan,0,0)
    allowed = if wanted == 26 do 1 else if wanted == 7 do if mode == 3 do 1 else if mode == 2 do if index == 0 do 1 else 0 end else 0 end end else 0 end end
    code = if allowed == 0 do b[] else nn_convert(given,wanted) end
    if index >= nc_arg_count(args) do args else
      nn_coerce(cells,if Enum.count(code) == 0 do args else nn_replace(args,index,nt_unary(wanted,nn_element(given)),code) end,index+1,plan)
    end
  end
  # The first argument of an Enum function the compiler has code for, as a
  # list: a set, a stream or a range. Nothing when it is none of them.
  def nn_listed(args: bytes, listed: integer): bytes do
    tag = nt_tag(nc_arg_kind(args,0))
    if listed == 0 do args else if nc_pos(args) < 0 do b[] else if nc_arg_count(args) == 0 do b[] else
      if (tag-23)*(tag-25)*(tag-26) != 0 do b[] else nn_replace(args,0,nt_unary(7,nn_element(nc_arg_kind(args,0))),nn_convert(nc_arg_kind(args,0),7)) end
    end end end
  end
  # A call of library function target with the arguments parsed. plan: the
  # nesting, what may be converted (0 nothing; 1 to streams, 2 the first
  # argument to a list too, 3 every argument, and something must be; 5 to
  # streams or nothing), the function (2 bytes), then the arguments.
  def nn_enter(source: bytes, name: integer, env: bytes, table: bytes, plan: bytes): bytes do
    mode = Enum.at(plan,1,0)
    parsed = nc_slice(plan,4,Enum.count(plan))
    first = nj_fit(source,table,nc_read(plan,2),nc_arg_count(parsed))
    given = if first < 0 do b[] else if mode == 0 do parsed else nn_coerce(nj_cells(source,table,first),parsed,0,b[mode]) end end
    same = if (mode-1)*(mode-2)*(mode-3) != 0 do 0 else if Enum.count(given) == Enum.count(parsed) do 1 else 0 end end
    fit = if nc_pos(given) < 0 do -1 else if same == 1 do -1 else nj_form(source,table,first,given) end end
    full = if fit < 0 do b[] else nj_full(source,table,fit,given,nc_end(source,name)) end
    if nc_pos(full) < 0 do b[] else nj_call(source,nc_end(source,name),env,table,Enum.at(plan,0,0),Enum.concat(nc_u16(fit),full)) end
  end
  # The forms of a library function in turn. plan: the nesting, the form to
  # try, what may be converted, the module name without its form behind its
  # length, then the arguments.
  def nn_forms(source: bytes, name: integer, env: bytes, table: bytes, plan: bytes): bytes do
    form = Enum.at(plan,1,0)
    size = Enum.at(plan,3,0)
    wanted = if form == 1 do nc_slice(plan,4,4+size) else nc_join(nc_slice(plan,4,4+size),b[118],ny_digits(form)) end
    home = ny_module(source,table,wanted,Enum.concat(nc_u24(0),nc_u24(nc_records(Enum.count(table)))))
    target = if home < 0 do -1 else nc_find(source,name,table,home) end
    call = if target < 0 do b[] else nn_enter(source,name,env,table,nc_join(b[Enum.at(plan,0,0),Enum.at(plan,2,0)],nc_u16(target),nc_slice(plan,4+size,Enum.count(plan)))) end
    if nc_pos(call) >= 0 do call else if form >= 16 do b[] else nn_forms(source,name,env,table,nc_join(b[Enum.at(plan,0,0),form+1],nc_slice(plan,2,4+size),nc_slice(plan,4+size,Enum.count(plan)))) end end
  end
  def nn_mode(plan: bytes, mode: integer): bytes do
    nc_join(b[Enum.at(plan,0,0),1,mode],nc_slice(plan,3,Enum.count(plan)),b[])
  end
  # A library call written in Alchem. The forms are tried with the arguments
  # as they are; then with lists, sets, maps and ranges made streams where a
  # form takes a stream; then, for Enum, Stream's function of the name and
  # the compiler's own code with the first argument made a list; then with
  # the first argument, and at last every one, made the list a form takes.
  def nn_passes(source: bytes, pos: integer, name: integer, env: bytes, table: bytes, plan: bytes): bytes do
    enum = nc_word(source,pos,b[69,110,117,109])
    made = zf_voided(source,table,env,nn_tried(source,pos,name,env,table,plan),zf_void(source,pos,name))
    kind = nc_kind(made)
    # A set holds what a map has as keys, and a map the library makes has
    # such keys too. Enum.each and Stream.run leave no value. The
    # function of Enum.into/3 says what an empty target collects, so the
    # call needs no type from its context once its own has no gap.
    inner = if nt_tag(kind) != 25 do 1 else if nu_open(nt_child(kind,0),0) == 0 do 1 else nn_library(source,env,table) end end
    keyed = if (nt_tag(kind)-25)*(nt_tag(kind)-8) != 0 do 1 else inner*(nn_key(nt_child(kind,0))+nn_open(nt_child(kind,0))) end
    if nc_pos(made) < 0 do b[] else if keyed == 0 do b[] else
      if enum == 0 do if nc_word(source,pos,b[83,116,114,101,97,109])*nc_word(source,name,b[114,117,110]) == 1 do nc_join(nc_slice(made,0,4),b[1,12],nc_code(made)) else made end else
        if nc_word(source,name,b[101,97,99,104]) == 1 do nc_join(nc_slice(made,0,4),b[1,12],nc_code(made)) else
          if nc_word(source,name,b[105,110,116,111]) == 0 do made else if Enum.at(plan,3+Enum.at(plan,3,0),0) != 51 do made else if nu_holes(kind,0) == 1 do made else nc_value(nc_pos(made),nc_code(made),kind) end end end
        end
      end
    end end
  end
  # A key type that is a tuple, as its parts: 5, the number of fields and
  # each field, 0 for an integer or a boolean, 2 for a string or an atom, 24
  # for a float. b[] when a part cannot be a key. The map routines order and
  # compare such keys with the comparator the compiler makes for the type
  # (od_keyed).
  def nn_keys(kind: bytes): bytes do
    tag = nt_tag(kind)
    if (tag-0)*(tag-3) == 0 do b[0] else if (tag-2)*(tag-22) == 0 do b[2] else if tag == 24 do b[24] else
      if tag != 5 do b[] else if nt_count(kind) == 0 do b[] else nn_key_fields(kind,0,b[5,0]) end end
    end end end
  end
  def nn_key_fields(kind: bytes, index: integer, done: bytes): bytes do
    field = nn_keys(nt_child(kind,index))
    if index >= nt_count(kind) do done else if Enum.count(field) == 0 do b[] else nn_key_fields(kind,index+1,Enum.concat(done,field)) end end
  end
  def nn_key(kind: bytes): integer do
    if Enum.count(nn_keys(kind)) == 0 do 0 else 1 end
  end
  # A set type as a program writes it holds what can be a key, and a map type
  # has such a key (integers, floats, strings, booleans, atoms and tuples of
  # them: not a list, an option, a struct or a type variable, as the pinned
  # compiler has it); the library also writes sets of a type variable and
  # maps of any key.
  def nn_set_type(source: bytes, table: bytes, owner: integer, kind: bytes): bytes do
    if (nt_tag(kind)-25)*(nt_tag(kind)-8) != 0 do kind else if nn_key(nt_child(kind,0)) == 1 do kind else
      if nt_tag(kind)*nt_tag(nt_child(kind,0)) == 72 do kind else
        if nc_ours(source,nc_meta(table,owner,0)) == 0 do b[] else
          if nt_tag(kind) == 8 do kind else if nt_tag(nt_child(kind,0)) == 16 do kind else b[] end end
        end
      end
    end end
  end
  # 1 for a type that is not settled where it stands: it has a gap or a type
  # variable.
  def nn_open(kind: bytes): integer do
    if nu_open(kind,0)+nu_holes(kind,0) > 0 do 1 else 0 end
  end
  def nn_tried(source: bytes, pos: integer, name: integer, env: bytes, table: bytes, plan: bytes): bytes do
    exact = nn_forms(source,name,env,table,plan)
    # List.sort and List.keysort take a list and nothing else, as upstream.
    strict = nc_word(source,pos,b[76,105,115,116])*(nc_word(source,name,b[115,111,114,116])+nc_word(source,name,b[107,101,121,115,111,114,116]))
    if nc_pos(exact) >= 0 do exact else if strict == 1 do b[] else
      lazy = nn_forms(source,name,env,table,nn_mode(plan,1))
      if nc_pos(lazy) >= 0 do lazy else
        listed = if nc_word(source,pos,b[69,110,117,109]) == 0 do b[] else nn_streamed(source,name,env,table,plan) end
        built = if nc_pos(listed) >= 0 do listed else if nc_word(source,pos,b[69,110,117,109]) == 0 do b[] else nc_builtin_listed(source,nc_end(source,pos),env,table,Enum.at(plan,0,0),1) end end
        first = if nc_pos(built) >= 0 do built else nn_forms(source,name,env,table,nn_mode(plan,2)) end
        if nc_pos(first) >= 0 do first else nn_forms(source,name,env,table,nn_mode(plan,3)) end
      end
    end end
  end
  # Enum.name with a stream or a range among its arguments, for a name
  # Stream has with a stream as its result: the list of that stream.
  def nn_streamed(source: bytes, name: integer, env: bytes, table: bytes, plan: bytes): bytes do
    size = Enum.at(plan,3,0)
    base = Enum.concat(b[65,108,99,104,127,109,83,116,114,101,97,109],nc_slice(plan,14,4+size))
    made = if nn_lazy(nc_slice(plan,4+size,Enum.count(plan)),0) == 0 do b[] else nn_forms(source,name,env,table,nc_join(b[Enum.at(plan,0,0),1,5,Enum.count(base)],base,nc_slice(plan,4+size,Enum.count(plan)))) end
    kind = nt_unary(7,nt_child(nc_kind(made),0))
    if nc_tag(made) != 26 do b[] else nc_join(nc_slice(made,0,4),Enum.concat(b[Enum.count(kind)],kind),Enum.concat(nc_code(made),nn_stream_list())) end
  end
  # 1 when an argument from index on is a stream or a range.
  def nn_lazy(args: bytes, index: integer): integer do
    tag = nt_tag(nc_arg_kind(args,index))
    if index >= nc_arg_count(args) do 0 else if (tag-23)*(tag-26) == 0 do 1 else nn_lazy(args,index+1) end end
  end
  # A program with a range or a stream may need Stream.name where it writes
  # Enum.name: the text " Stream.name" for each, for the library's choice of
  # what to append. Not for into: Stream.into writes to a file.
  def nn_hints(source: bytes, first: integer, stop: integer): bytes do
    if stop-first > 64 do
      middle = first+nc_half(stop-first)
      Enum.concat(nn_hints(source,first,middle),nn_hints(source,middle,stop))
    else nn_hint_scan(source,first,stop) end
  end
  def nn_hint_scan(source: bytes, pos: integer, stop: integer): bytes do
    if pos >= stop do b[] else
      if byte_at(source,pos) != 69 do nn_hint_scan(source,pos+1,stop) else
        if nc_word_at(source,pos,b[69,110,117,109,46],0)-nc_word(source,pos+5,b[105,110,116,111]) != 1 do nn_hint_scan(source,pos+1,stop) else
          Enum.concat(Enum.concat(b[32,83,116,114,101,97,109,46],nc_slice(source,pos+5,nc_end(source,pos+5))),nn_hint_scan(source,pos+5,stop))
        end
      end
    end
  end
  def nn_hinted(source: bytes): bytes do
    size = Enum.count(source)
    if ny_has(source,0,size,b[46,46])+ny_has(source,0,size,b[83,116,114,101,97,109])+ny_has(source,0,size,b[115,116,114,101,97,109]) == 0 do b[] else nn_hints(source,0,size) end
  end
  # A range written where a stream[integer] is expected is that stream:
  # the value of an annotated binding or of a function with that result,
  # when its code ends in the making of a range, and an argument that is a
  # range.
  def nn_expected(value: bytes, kind: bytes, table: bytes): bytes do
    if nt_same(kind,b[26,0]) == 0 do value else if nn_written(value) == 0 do value else
      nc_join(nc_slice(value,0,4),b[2,26,0],nc_join(nc_code(value),zf_stepped(table),nn_range_stream()))
    end end
  end
  # 1 for a range as it is written: the code ends in the making of it. As
  # an argument it has mark 2; piped, it waits under type 27.
  def nn_written(value: bytes): integer do
    code = nc_code(value)
    size = Enum.count(nn_range_emit())
    if nc_tag(value) != 23 do 0 else nt_same(nc_slice(code,Enum.count(code)-size,Enum.count(code)),nn_range_emit()) end
  end
  def nn_waiting(value: bytes): bytes do
    if nn_written(value) == 1 do b[27] else nc_kind(value) end
  end
  # The piped value and the marks of the arguments after it.
  def nn_piped(piped: bytes, marks: bytes): bytes do
    if nc_tag(piped) != 27 do marks else Enum.concat(b[2],nc_slice(marks,1,Enum.count(marks))) end
  end
  def nn_plain(value: bytes): bytes do
    if nc_tag(value) != 27 do value else nc_join(nc_slice(value,0,4),b[1,23],nc_code(value)) end
  end
  def nn_returned(source: bytes, table: bytes, id: integer, body: bytes): bytes do
    if nc_tag(body) != 23 do body else nn_expected(body,nc_return_kind(source,table,id),table) end
  end
  def nn_ranged(source: bytes, table: bytes, id: integer, args: bytes, index: integer): bytes do
    if id < 0 do args else if index >= nc_arg_count(args) do args else
      if nt_tag(nc_arg_kind(args,index))*8+nw_arg_marked(args,index) != 186 do nn_ranged(source,table,id,args,index+1) else
        if nt_same(nt_item(nj_cells(source,table,id),index),b[26,0]) == 0 do nn_ranged(source,table,id,args,index+1) else
          nn_ranged(source,table,id,nn_replace(args,index,b[26,0],Enum.concat(zf_stepped(table),nn_range_stream())),index+1)
