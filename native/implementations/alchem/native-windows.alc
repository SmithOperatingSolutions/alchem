defmodule NativeWindows do
  # Windows x64 (spec/windows.md). nc_win() is 1 in the compiler
  # scripts/build-windows.py makes and 0 here: the x86-64 code is the same,
  # but each system call is ud2 (0F 0B), which the vectored exception
  # handler of the Windows layer (spec/windows-x86_64.s) makes with kernel32,
  # and the image is a PE file.
  def nc_win(): integer do 0 end

  # The second byte of a system call: 0F 05 syscall, or 0F 0B ud2.
  def nc_sc(): integer do if nc_win() == 1 do 11 else 5 end end

  # code, a runtime assembled from spec/*-x86_64.s, with the system call at
  # each offset in sites (four bytes each, scripts/windows_sites.py) made
  # ud2 on Windows.
  def nc_os(code: bytes, sites: bytes): bytes do
    if nc_win() == 0 do code else nw_os_at(code,sites,0,0) end
  end
  def nw_os_at(code: bytes, sites: bytes, i: integer, from: integer): bytes do
    if i >= Enum.count(sites) do nc_slice(code,from,Enum.count(code)) else
      at = nc_long(sites,i)
      nc_join(nc_slice(code,from,at+1),b[11],nw_os_at(code,sites,i+4,at+2))
    end
  end

  # The PE file of an image (its ELF header and code, loaded at 0x400000):
  # the headers and the Windows layer (native-windows-data.alc), then the
  # image in a section of its own at 0x400000, padded to 512 bytes.
  # A Windows program's stacks grow as Windows grows a thread's: through
  # guard pages, while the TEB names the stack (spec/windows.md). These set
  # it to the stack whose limit L is in RAX (the stack's first page, at
  # L - 64 KiB, keeps its limit and its top):
  #   lea rdx,[rax-65536]; mov gs:[0x1478],rdx (DeallocationStack);
  #   mov rcx,[rdx+8]; mov gs:[8],rcx (StackBase);
  #   mov rcx,[rdx]; mov gs:[16],rcx (StackLimit)
  def nw_stack_teb(): bytes do
    if nc_win() == 0 do b[] else
      b[72,141,144,0,0,255,255,101,72,137,20,37,120,20,0,0,72,139,74,8,101,72,137,12,37,8,0,0,0,72,139,10,101,72,137,12,37,16,0,0,0]
    end
  end
  # The limit the kernel has moved the running stack's to (StackLimit), kept
  # in its first page before another stack runs; L in RAX:
  #   mov rdx,gs:[16]; mov [rax-65536],rdx
  def nw_stack_keep(): bytes do
    if nc_win() == 0 do b[] else b[101,72,139,20,37,16,0,0,0,72,137,144,0,0,255,255] end
  end
  # A frame larger than the guard pages cover is touched a page at a time
  # from the top down first, as Windows' __chkstk does:
  #   mov r11,-4096; again: cmp byte [rsp+r11],0; sub r11,4096;
  #   cmp r11,-size; jge again
  def nw_probe(size: integer): bytes do
    nc_join(b[73,199,195,0,240,255,255,66,128,60,28,0,73,129,235,0,16,0,0,73,129,251],nq_rel(0-size),b[125,235])
  end
  # The executable of the image with its ELF header: a PE file on Windows.
  def nc_elf_or_pe(elf: bytes): bytes do if nc_win() == 1 do nw_pe(elf) else elf end end
  def nw_pe(image: bytes): bytes do
    size = Enum.count(image)
    padded = nc_units(size+511,512)*512
    head = nw_put(nw_put(nw_put(nw_prefix(),nw_size_of_image(),nw_image_rva()+nc_units(size+4095,4096)*4096),nw_image_vsize(),size),nw_image_raw(),padded)
    nc_join(head,image,nc_zeros(padded-size))
  end
  def nw_put(data: bytes, at: integer, value: integer): bytes do
    nc_join(nc_slice(data,0,at),nc_u32(value),nc_slice(data,at+4,Enum.count(data)))
  end

  # Native smoke test; the Windows helpers.
  def main() do System.halt(0) end
end
