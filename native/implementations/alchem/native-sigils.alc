defmodule NativeSigils do
  # Sigils: a tilde, a letter, text between delimiters and modifier letters
  # (spec/alchem-sigils.md). The whole sigil is one token. The text has no
  # escapes but a backslash before the closing delimiter; a sigil of a
  # lower-case letter holds the value of each #{expression}.
  def sg_lower(value: integer): integer do
    if (value-97)*(122-value) >= 0 do 1 else 0 end
  end
  # The delimiter that closes the one a sigil opens with, 0 for any other byte.
  def sg_closer(value: integer): integer do
    if value == 40 do 41 else if value == 91 do 93 else if value == 123 do 125 else if value == 60 do 62 else
      if (value-47)*(value-124)*(value-34)*(value-39) == 0 do value else 0 end
    end end end end
  end
  # 1 when a sigil starts at pos, its tilde.
  def sg_starts(source: bytes, pos: integer): integer do
    if byte_at(source,pos) != 126 do 0 else if is_letter(byte_at(source,pos+1)) == 0 do 0 else if sg_closer(byte_at(source,pos+2)) == 0 do 0 else 1 end end end
  end
  # The closing brace of the #{ at pos-2, -1 when its line ends first:
  # braces nest and a string is skipped. A step looks at up to left bytes;
  # one that has not found the brace gives where to go on and how deep,
  # below -1.
  def sg_hole_some(source: bytes, pos: integer, depth: integer, left: integer): integer do
    value = byte_at(source,pos)
    if pos < 0 do -1 else if pos >= Enum.count(source) do -1 else if value == 10 do -1 else if left == 0 do 0-2-pos-depth*16777216 else
      if value == 34 do sg_hole_some(source,ns_quoted_end(source,pos+1),depth,left-1) else
        if value == 123 do sg_hole_some(source,pos+1,depth+1,left-1) else
          if value != 125 do sg_hole_some(source,pos+1,depth,left-1) else if depth == 1 do pos else sg_hole_some(source,pos+1,depth-1,left-1) end end
        end
      end
    end end end end
  end
  def sg_hole_end(source: bytes, pos: integer, depth: integer): integer do
    next = sg_hole_some(source,pos,depth,64)
    deep = nc_units(0-2-next,16777216)
    if next >= -1 do next else sg_hole_end(source,0-2-next-deep*16777216,deep) end
  end
  # Where the delimiter stands that closes a one-line sigil whose text starts
  # at pos, -1 when its line ends first. A backslash keeps the byte after it
  # from closing, and so does the #{ } of a lower-case sigil. A step looks
  # at up to left bytes and gives the next position to look at, so a long
  # text nests no deeper than a sixty-fourth of its length.
  def sg_scan_some(source: bytes, pos: integer, closer: integer, lower: integer, left: integer): integer do
    value = byte_at(source,pos)
    hole = if value != 35 do 0 else if byte_at(source,pos+1) != 123 do 0 else lower end end
    if pos < 0 do -1 else if pos >= Enum.count(source) do -1 else if left == 0 do pos else if value == closer do pos else if value == 10 do -1 else
      if value == 92 do sg_scan_some(source,pos+2,closer,lower,left-1) else
        if hole == 0 do sg_scan_some(source,pos+1,closer,lower,left-1) else
          inner = sg_hole_end(source,pos+2,1)
          if inner < 0 do -1 else sg_scan_some(source,inner+1,closer,lower,left-1) end
        end
      end
    end end end end end
  end
  def sg_scan(source: bytes, pos: integer, closer: integer, lower: integer): integer do
    next = sg_scan_some(source,pos,closer,lower,64)
    if next < 0 do -1 else if byte_at(source,next) == closer do next else sg_scan(source,next,closer,lower) end end
  end
  # The modifiers after a sigil: lower-case letters and U.
  def sg_modifiers(source: bytes, pos: integer): integer do
    value = byte_at(source,pos)
    if pos < 0 do -1 else if sg_lower(value) == 1 do sg_modifiers(source,pos+1) else if value == 85 do sg_modifiers(source,pos+1) else pos end end end
  end
  # Where the token ends that starts with the tilde at pos: the sigil with
  # its modifiers, or the tilde alone when no sigil starts there. -1 for a
  # sigil that does not close. The heredoc of s and S takes no modifiers.
  def sg_token_end(source: bytes, pos: integer): integer do
    opener = byte_at(source,pos+2)
    letter = byte_at(source,pos+1)
    tall = if opener != 34 do 0 else ns_tripled(source,pos+2) end
    if sg_starts(source,pos) == 0 do pos+1 else
      if tall == 1 do if (letter-115)*(letter-83) == 0 do nc_text_end(source,pos+2) else sg_modifiers(source,nc_text_end(source,pos+2)) end else
        stop = sg_scan(source,pos+3,sg_closer(opener),sg_lower(letter))
        if stop < 0 do -1 else sg_modifiers(source,stop+1) end
      end
    end
  end
  # What the sigil at start holds: where its text starts (3 bytes); the plan
  # of its text: the closing delimiter (0 for a heredoc), the indentation of
  # a heredoc's closing line, 1 when #{ } holds a value, then where that
  # closing line starts and where the text stops (3 bytes each); and where
  # its modifiers start (3 bytes). b[] for none.
  def sg_shape(source: bytes, start: integer): bytes do
    opener = byte_at(source,start+2)
    tall = if opener != 34 do 0 else ns_tripled(source,start+2) end
    first = if tall == 1 do nz_line_end(source,start+2)+1 else start+3 end
    close = if tall == 1 do ns_heredoc_close(source,first) else 0 end
    indent = if tall == 1 do nc_blank_end(source,close)-close else 0 end
    opened = byte_at(source,nc_blank_end(source,start+5))
    stop = if tall == 1 do close else sg_scan(source,start+3,sg_closer(opener),sg_lower(byte_at(source,start+1))) end
    plan = nc_join(b[if tall == 1 do 0 else sg_closer(opener) end,if indent > 255 do 0 else indent end,sg_lower(byte_at(source,start+1))],nc_u24(if close < 0 do 0 else close end),nc_u24(if stop < 0 do 0 else stop end))
    if sg_starts(source,start) == 0 do b[] else if stop < 0 do b[] else if indent > 255 do b[] else if tall*(opened-10)*(opened-13) != 0 do b[] else
      nc_join(nc_u24(first),plan,nc_u24(if tall == 1 do nc_blank_end(source,close)+3 else stop+1 end))
    end end end end
  end
  # The first #{ from first up to stop, stop when there is none.
  def sg_hole_at(source: bytes, first: integer, stop: integer): integer do
    if stop-first > 64 do
      left = sg_hole_at(source,first,first+nc_half(stop-first))
      if left < first+nc_half(stop-first) do left else sg_hole_at(source,first+nc_half(stop-first),stop) end
    else sg_hole_run(source,first,stop) end
  end
  def sg_hole_run(source: bytes, pos: integer, stop: integer): integer do
    if pos >= stop do stop else if byte_at(source,pos)*256+byte_at(source,pos+1) == 9083 do pos else sg_hole_run(source,pos+1,stop) end end
  end
  # Where the run of blanks that holds pos starts, looking back at most
  # left bytes.
  def sg_blank_start(source: bytes, pos: integer, left: integer): integer do
    value = byte_at(source,pos-1)
    if left == 0 do pos else if pos <= 0 do pos else if (value-32)*(value-9) == 0 do sg_blank_start(source,pos-1,left-1) else pos end end end
  end
  # 1 when the byte at pos is part of the text. Of a one-line sigil a
  # backslash before the closing delimiter is not; of a heredoc the closing
  # line's indentation at the start of a line is not.
  def sg_kept(source: bytes, pos: integer, plan: bytes): integer do
    value = byte_at(source,pos)
    closer = Enum.at(plan,0,0)
    indent = Enum.at(plan,1,0)
    blank = if (value-32)*(value-9) == 0 do 1 else 0 end
    start = if closer != 0 do pos else if indent*blank == 0 do pos else sg_blank_start(source,pos,indent) end end
    if closer != 0 do
      if value != 92 do 1 else if pos+1 >= nc_cursor(plan,6) do 1 else if byte_at(source,pos+1) == closer do 0 else 1 end end end
    else
      if indent*blank == 0 do 1 else if byte_at(source,start-1) != 10 do 1 else if pos-start >= indent do 1 else 1-nc_equal(source,start,nc_cursor(plan,3),indent) end end end
    end
  end
  # The bytes of the text from first up to stop. Each byte is judged by
  # what stands around it, so the text is halved wherever it is long.
  def sg_text(source: bytes, first: integer, stop: integer, plan: bytes): bytes do
    if stop-first <= 0 do b[] else
      if stop-first > 32 do Enum.concat(sg_text(source,first,first+nc_half(stop-first),plan),sg_text(source,first+nc_half(stop-first),stop,plan)) else sg_text_run(source,first,stop,plan) end
    end
  end
  def sg_text_run(source: bytes, pos: integer, stop: integer, plan: bytes): bytes do
    if pos >= stop do b[] else Enum.concat(if sg_kept(source,pos,plan) == 1 do b[byte_at(source,pos)] else b[] end,sg_text_run(source,pos+1,stop,plan)) end
  end
  # The text from pos up to where it stops (flag 1) or up to a #{ that holds
  # a value (flag 2): position, flag, bytes.
  def sg_piece(source: bytes, pos: integer, plan: bytes): bytes do
    stop = nc_cursor(plan,6)
    hole = if Enum.at(plan,2,0) == 0 do stop else sg_hole_at(source,pos,stop) end
    nc_join(nc_u24(if hole >= stop do stop else hole end),b[if hole >= stop do 1 else 2 end],sg_text(source,pos,if hole >= stop do stop else hole end,plan))
  end
  # The string a sigil's text makes from pos on: text, then for each
  # #{expression} its value as text and what follows. plan: that of
  # sg_shape, then the nesting.
  def sg_parts(source: bytes, pos: integer, env: bytes, table: bytes, plan: bytes): bytes do
    depth = Enum.at(plan,9,0)
    stop = nc_cursor(plan,6)
    piece = sg_piece(source,pos,plan)
    hole = nc_pos(piece)
    inner = if Enum.at(piece,3,0) != 2 do b[] else if depth > 252 do b[] else nc_expression(source,hole+2,env,table,depth+1) end end
    shown = ns_shown(inner)
    after = nc_expect(source,nc_pos(inner),b[125])
    fits = if after < 0 do 0 else if after > stop do 0 else sg_same_line(source,hole,after) end end
    rest = if Enum.count(shown)*fits == 0 do b[] else sg_parts(source,after,env,table,plan) end
    if nc_pos(piece) < 0 do b[] else
      if Enum.at(piece,3,0) == 1 do nc_value(stop,nc_text_emit(nc_slice(piece,4,Enum.count(piece))),b[2]) else ns_joined(nc_text_emit(nc_slice(piece,4,Enum.count(piece))),shown,rest) end
    end
  end
  # The length of the white space character at a position of a text, 0 when
  # there is none: the characters Go's unicode.IsSpace names.
  def sg_space(text: bytes, at: integer): integer do
    one = Enum.at(text,at,0)
    pair = Enum.at(text,at+1,0)*256+Enum.at(text,at+2,0)
    if (one-9)*(13-one) >= 0 do 1 else if one == 32 do 1 else
      if one == 194 do if (Enum.at(text,at+1,0)-133)*(Enum.at(text,at+1,0)-160) == 0 do 2 else 0 end else
        if one == 225 do if pair == 39552 do 3 else 0 end else
          if one == 227 do if pair == 32896 do 3 else 0 end else
            if one != 226 do 0 else
              if (pair-32896)*(32906-pair) >= 0 do 3 else if nc_and((pair-32936)*(pair-32937),(pair-32943)*(pair-33183)) == 0 do 3 else 0 end end
            end
          end
        end
      end
    end end
  end
  # The scans over a text go in steps of 64, so a long text nests no deeper
  # than a sixty-fourth of its length.
  def sg_blank_some(text: bytes, at: integer, left: integer): integer do
    if left == 0 do at else if sg_space(text,at) == 0 do at else sg_blank_some(text,at+sg_space(text,at),left-1) end end
  end
  def sg_blank_end(text: bytes, at: integer): integer do
    next = sg_blank_some(text,at,64)
    if sg_space(text,next) == 0 do next else sg_blank_end(text,next) end
  end
  def sg_word_some(text: bytes, at: integer, left: integer): integer do
    if left == 0 do at else if at >= Enum.count(text) do at else if sg_space(text,at) > 0 do at else sg_word_some(text,at+1,left-1) end end end
  end
  def sg_word_end(text: bytes, at: integer): integer do
    next = sg_word_some(text,at,64)
    if next >= Enum.count(text) do next else if sg_space(text,next) > 0 do next else sg_word_end(text,next) end end
  end
  # The length of the white space character that ends at a position.
  def sg_space_before(text: bytes, at: integer): integer do
    if sg_space(text,at-1) == 1 do 1 else if sg_space(text,at-2) == 2 do 2 else if sg_space(text,at-3) == 3 do 3 else 0 end end end
  end
  # Where the text ends once the white space at its end is taken off.
  def sg_trim_some(text: bytes, stop: integer, left: integer): integer do
    if left == 0 do stop else if stop <= 0 do 0 else if sg_space_before(text,stop) == 0 do stop else sg_trim_some(text,stop-sg_space_before(text,stop),left-1) end end end
  end
  def sg_trim_end(text: bytes, stop: integer): integer do
    next = sg_trim_some(text,stop,64)
    if next <= 0 do 0 else if sg_space_before(text,next) == 0 do next else sg_trim_end(text,next) end end
  end
  # Where the word starts that holds a position of a text.
  def sg_word_back(text: bytes, at: integer, left: integer): integer do
    if left == 0 do at else if at <= 0 do 0 else if sg_space_before(text,at) > 0 do at else sg_word_back(text,at-1,left-1) end end end
  end
  def sg_word_start(text: bytes, at: integer): integer do
    next = sg_word_back(text,at,64)
    if next <= 0 do 0 else if sg_space_before(text,next) > 0 do next else sg_word_start(text,next) end end
  end
  # Two runs of pushed values as one: each is its count (3 bytes), then the
  # code that pushes them.
  def sg_pushed(left: bytes, right: bytes): bytes do
    nc_join(nc_u24(nc_cursor(left,0)+nc_cursor(right,0)),nc_slice(left,3,Enum.count(left)),nc_slice(right,3,Enum.count(right)))
  end
  # A position from at on that no white space character reaches across.
  def sg_whole(text: bytes, at: integer): integer do
    if sg_space(text,at-1) >= 2 do at-1 else if sg_space(text,at-2) == 3 do at-2 else at end end
  end
  # The words of a text from first up to stop, each pushed as a string: the
  # first word alone when it reaches stop, and else the words before and
  # after a place near the middle, which is the end of the word there or,
  # when that word reaches stop, its start. first and stop stand at white
  # space or at an end of the text.
  def sg_words(text: bytes, first: integer, stop: integer): bytes do
    begin = sg_blank_end(text,first)
    after = sg_word_end(text,begin)
    middle = if begin+nc_half(stop-begin) < after do after else sg_whole(text,begin+nc_half(stop-begin)) end
    split = if sg_word_end(text,middle) < stop do sg_word_end(text,middle) else sg_word_start(text,middle) end
    if begin >= stop do nc_u24(0) else
      if after >= stop do nc_join(nc_u24(1),nc_text_emit(nc_slice(text,begin,after)),b[80]) else sg_pushed(sg_words(text,first,split),sg_words(text,split,stop)) end
    end
  end
  def sg_continues(value: integer): integer do
    if (value-128)*(191-value) >= 0 do 1 else 0 end
  end
  # The character at a position of a text as Go reads one: its length, then
  # its code point (3 bytes). A byte that starts no character is U+FFFD.
  def sg_rune(text: bytes, at: integer): bytes do
    one = Enum.at(text,at,0)
    two = Enum.at(text,at+1,0)
    three = Enum.at(text,at+2,0)
    four = Enum.at(text,at+3,0)
    low = if one == 224 do 160 else if one == 240 do 144 else 128 end end
    high = if one == 237 do 159 else if one == 244 do 143 else 191 end end
    second = if (two-low)*(high-two) >= 0 do 1 else 0 end
    if one < 128 do b[1,one,0,0] else
      if (one-194)*(223-one) >= 0 do if second == 0 do b[1,253,255,0] else Enum.concat(b[2],nc_u24((one-192)*64+two-128)) end else
        if (one-224)*(239-one) >= 0 do if second*sg_continues(three) == 0 do b[1,253,255,0] else Enum.concat(b[3],nc_u24((one-224)*4096+(two-128)*64+three-128)) end else
          if (one-240)*(244-one) < 0 do b[1,253,255,0] else
            if second*sg_continues(three)*sg_continues(four) == 0 do b[1,253,255,0] else Enum.concat(b[4],nc_u24((one-240)*262144+(two-128)*4096+(three-128)*64+four-128)) end
          end
        end
      end
    end
  end
  # The code points of a text from a position up to stop, one after the
  # other, each pushed.
  def sg_points_run(text: bytes, at: integer, stop: integer): bytes do
    rune = sg_rune(text,at)
    if at >= stop do nc_u24(0) else sg_pushed(nc_join(nc_u24(1),b[104],nc_u32(nc_cursor(rune,1))),sg_points_run(text,at+Enum.at(rune,0,1),stop)) end
  end
  # A position from at on where a character starts: the first byte of three
  # that continues none, and else the fourth, since no character is longer.
  def sg_point_start(text: bytes, at: integer): integer do
    if sg_continues(Enum.at(text,at,0)) == 0 do at else if sg_continues(Enum.at(text,at+1,0)) == 0 do at+1 else if sg_continues(Enum.at(text,at+2,0)) == 0 do at+2 else at+3 end end end
  end
  # The code points of a text from first up to stop, each pushed. The text
  # is halved where a character starts.
  def sg_points(text: bytes, first: integer, stop: integer): bytes do
    if stop-first <= 8 do sg_points_run(text,first,stop) else
      sg_pushed(sg_points(text,first,sg_point_start(text,first+nc_half(stop-first))),sg_points(text,sg_point_start(text,first+nc_half(stop-first)),stop))
    end
  end
  # A list of the values pushed, of elements of type kind.
  def sg_listed(stop: integer, pushed: bytes, kind: bytes): bytes do
    nc_value(stop,nc_join(nc_slice(pushed,3,Enum.count(pushed)),Enum.concat(b[185],nc_u32(nc_cursor(pushed,0))),nl_pack_blob()),nt_unary(7,kind))
  end
  # The digit at a position of a text, -1 when it is none.
  def sg_digit(text: bytes, at: integer): integer do
    value = Enum.at(text,at,0)
    if (value-48)*(57-value) >= 0 do value-48 else -1 end
  end
  # Two digits at a position: their value, -1 when one is none.
  def sg_pair(text: bytes, at: integer): integer do
    if sg_digit(text,at) < 0 do -1 else if sg_digit(text,at+1) < 0 do -1 else sg_digit(text,at)*10+sg_digit(text,at+1) end end
  end
  def sg_multiple(value: integer, step: integer): integer do
    if nc_units(value,step)*step == value do 1 else 0 end
  end
  def sg_leap(year: integer): integer do
    if sg_multiple(year,4) == 0 do 0 else if sg_multiple(year,100) == 0 do 1 else sg_multiple(year,400) end end
  end
  def sg_days(year: integer, month: integer): integer do
    if month == 2 do 28+sg_leap(year) else if (month-4)*(month-6)*(month-9)*(month-11) == 0 do 30 else 31 end end
  end
  # The calendar sigils take what Go's time.Parse takes for the layouts
  # 2006-01-02, 15:04:05 and both with T or a space between, then Z07:00.
  #
  # year-month-day at a position: the position after it (3 bytes), the year
  # (2 bytes), month and day. b[] when there is no date.
  def sg_date(text: bytes, at: integer): bytes do
    high = sg_pair(text,at)
    low = sg_pair(text,at+2)
    month = sg_pair(text,at+5)
    day = sg_pair(text,at+8)
    dashes = if Enum.at(text,at+4,0) != 45 do 0 else if Enum.at(text,at+7,0) != 45 do 0 else 1 end end
    if high < 0 do b[] else if low < 0 do b[] else if month < 1 do b[] else if month > 12 do b[] else if day < 1 do b[] else if dashes == 0 do b[] else
      if day > sg_days(high*100+low,month) do b[] else nc_join(nc_u24(at+10),nc_u16(high*100+low),b[month,day]) end
    end end end end end end
  end
  def sg_digits_some(text: bytes, at: integer, left: integer): integer do
    if left == 0 do at else if sg_digit(text,at) < 0 do at else sg_digits_some(text,at+1,left-1) end end
  end
  def sg_digits_end(text: bytes, at: integer): integer do
    next = sg_digits_some(text,at,64)
    if sg_digit(text,next) < 0 do next else sg_digits_end(text,next) end
  end
  # The first left digits of a fraction as a number, zeros for those past stop.
  def sg_fraction(text: bytes, at: integer, stop: integer, left: integer): integer do
    if left == 0 do 0 else
      scale = if left == 6 do 100000 else if left == 5 do 10000 else if left == 4 do 1000 else if left == 3 do 100 else if left == 2 do 10 else 1 end end end end end
      digit = if at >= stop do 0 else sg_digit(text,at) end
      digit*scale+sg_fraction(text,at+1,stop,left-1)
    end
  end
  # hour:minute:second at a position, the hour in one digit or two, and a
  # fraction of any length after a point or a comma: the position after it
  # (3 bytes), hour, minute, second and the microseconds (3 bytes).
  def sg_clock(text: bytes, at: integer): bytes do
    wide = if sg_digit(text,at+1) < 0 do 0 else 1 end
    hour = if wide == 1 do sg_pair(text,at) else sg_digit(text,at) end
    next = at+1+wide
    minute = sg_pair(text,next+1)
    second = sg_pair(text,next+4)
    colons = if Enum.at(text,next,0) != 58 do 0 else if Enum.at(text,next+3,0) != 58 do 0 else 1 end end
    mark = Enum.at(text,next+6,0)
    split = if (mark-46)*(mark-44) != 0 do 0 else if sg_digit(text,next+7) < 0 do 0 else 1 end end
    stop = if split == 1 do sg_digits_end(text,next+7) else next+6 end
    if hour < 0 do b[] else if hour > 23 do b[] else if minute < 0 do b[] else if minute > 59 do b[] else if second < 0 do b[] else if second > 59 do b[] else if colons == 0 do b[] else
      nc_join(nc_u24(stop),b[hour,minute,second],nc_u24(if split == 1 do sg_fraction(text,next+7,stop,6) else 0 end))
    end end end end end end end
  end
  # Z, or a sign, two digits of hours, a colon and two of minutes: the
  # position after it (3 bytes), 1 for a minus sign and the seconds (3 bytes).
  def sg_zone(text: bytes, at: integer): bytes do
    sign = Enum.at(text,at,0)
    hours = sg_pair(text,at+1)
    minutes = sg_pair(text,at+4)
    if sign == 90 do nc_join(nc_u24(at+1),b[0],nc_u24(0)) else
      if (sign-43)*(sign-45) != 0 do b[] else if Enum.at(text,at+3,0) != 58 do b[] else if hours < 0 do b[] else if hours > 24 do b[] else if minutes < 0 do b[] else if minutes > 60 do b[] else
        nc_join(nc_u24(at+6),b[if sign == 45 do 1 else 0 end],nc_u24((hours*60+minutes)*60))
      end end end end end end
    end
  end
  # A date as the year and one (2 bytes), month and day: the day before it
  # and the day after it.
  def sg_before(date: bytes): bytes do
    year = nc_read(date,0)-1
    month = Enum.at(date,2,0)
    day = Enum.at(date,3,0)
    if day > 1 do Enum.concat(nc_slice(date,0,3),b[day-1]) else
      if month > 1 do Enum.concat(nc_slice(date,0,2),b[month-1,sg_days(year,month-1)]) else Enum.concat(nc_u16(year),b[12,31]) end
    end
  end
  def sg_after(date: bytes): bytes do
    year = nc_read(date,0)-1
    month = Enum.at(date,2,0)
    day = Enum.at(date,3,0)
