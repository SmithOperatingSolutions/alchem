    inside = if op == 0 do 0 else nn_library(source,env,table) end
    begin = if inside == 0 do -1 else nc_expect(source,nc_end(source,start),b[40]) end
    args = if begin < 0 do b[] else if op == 4 do b[] else nc_arguments(source,begin,env,table,depth) end end
    tag = nt_tag(nc_arg_kind(args,0))
    fits = if nc_arg_count(args) != 1 do 0 else if op == 1 do if (tag-2)*(tag-29) == 0 do 1 else 0 end else if tag == 1 do 1 else 0 end end end
