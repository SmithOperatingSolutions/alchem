  # The flags the modifiers of a ~r from i on give, in their order: i, m,
  # s and U. u gives none, x is kept, and any other letter gives b[0]
  # (RegexSource).
  def sg_mods(mods: bytes, i: integer): bytes do
    c = Enum.at(mods,i,0)
    rest = if i >= Enum.count(mods) do b[] else sg_mods(mods,i+1) end
    if i >= Enum.count(mods) do b[] else if Enum.at(rest,0,1) == 0 do rest else
      if c == 117 do rest else if (c-105)*(c-109)*(c-115)*(c-85)*(c-120) == 0 do Enum.concat(b[c],rest) else b[0] end end
    end end
