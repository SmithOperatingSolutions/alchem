  def sg_filled_run(source: bytes, pos: integer, stop: integer): integer do
    shape = if byte_at(source,pos)*256+byte_at(source,pos+1) != 32370 do b[] else sg_shape(source,pos) end
    if pos >= stop do 0 else
      if Enum.count(shape) == 0 do sg_filled_run(source,pos+1,stop) else if Enum.at(sg_piece(source,nc_cursor(shape,0),nc_slice(shape,3,12)),3,0) == 2 do 1 else sg_filled_run(source,pos+1,stop) end end
    end
