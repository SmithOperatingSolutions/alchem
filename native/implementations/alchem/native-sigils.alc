  # The pattern of a ~r: (?flags) when it has any, then its text.
  def sg_pattern(flags: bytes, text: bytes): bytes do
    kept = sg_drop(flags,0)
    body = if Enum.count(kept) == Enum.count(flags) do text else sg_ext(text,0,0,0) end
