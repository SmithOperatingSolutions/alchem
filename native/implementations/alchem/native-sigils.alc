  def sg_drop(flags: bytes, i: integer): bytes do
    if i >= Enum.count(flags) do b[] else Enum.concat(if Enum.at(flags,i,0) == 120 do b[] else b[Enum.at(flags,i,0)] end,sg_drop(flags,i+1)) end
  end
  # A pattern as the x modifier leaves it: without white space and
  # comments from # to the end of a line, outside classes and escapes
  # (extended). cls: 1 inside a class; com: 1 inside a comment.
  def sg_ext(text: bytes, i: integer, cls: integer, com: integer): bytes do
    c = Enum.at(text,i,0)
    if i >= Enum.count(text) do b[] else if com == 1 do sg_ext(text,i+1,cls,if c == 10 do 0 else 1 end) else
      if if c != 92 do 0 else if i+1 < Enum.count(text) do 1 else 0 end end == 1 do Enum.concat(b[92,Enum.at(text,i+1,0)],sg_ext(text,i+2,cls,0)) else
        if cls == 1 do Enum.concat(b[c],sg_ext(text,i+1,if c == 93 do 0 else 1 end,0)) else
          if c == 91 do Enum.concat(b[91],sg_ext(text,i+1,1,0)) else if c == 35 do sg_ext(text,i+1,0,1) else
