  def sg_constant_name(source: bytes, start: integer): integer do
    words = nc_word(source,start,b[116,114,117,101])+nc_word(source,start,b[102,97,108,115,101])+nc_word(source,start,b[110,111,110,101])+nc_word(source,start,b[110,111,116])+nc_word(source,start,b[97,110,100])+nc_word(source,start,b[111,114])
