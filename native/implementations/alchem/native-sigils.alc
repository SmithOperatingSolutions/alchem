  def sg_hints(source: bytes): bytes do
    size = Enum.count(source)
    dates = if sg_hint(source,0,size,68) == 1 do b[32,68,97,116,101] else b[] end
    times = if sg_hint(source,0,size,84) == 1 do b[32,84,105,109,101] else b[] end
    naive = if sg_hint(source,0,size,78) == 1 do b[32,78,97,105,118,101,68,97,116,101,84,105,109,101] else b[] end
    zoned = if sg_hint(source,0,size,85) == 1 do b[32,68,97,116,101,84,105,109,101] else b[] end
    words = if sg_hint(source,0,size,119) == 1 do b[32,83,116,114,105,110,103,46,115,112,108,105,116] else b[] end
    # A program that has a ~r or names the type holds regular expressions,
    # a ~r with values is Regex.compile!, and =~ is String.match?.
    held = if sg_hint(source,0,size,114)+ny_has(source,0,size,b[114,101,103,101,120]) > 0 do b[32,82,101,103,101,120] else b[] end
    made = if sg_filled_r(source,0,size) == 1 do b[32,82,101,103,101,120,46,99,111,109,112,105,108,101,33] else b[] end
    match = if ny_has(source,0,size,b[61,126]) == 1 do b[32,83,116,114,105,110,103,46,109,97,116,99,104,63] else b[] end
    nc_join(nc_join(dates,times,naive),nc_join(zoned,words,held),Enum.concat(made,match))
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
