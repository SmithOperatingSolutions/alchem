  def sg_constant_tokens(source: bytes, pos: integer, stop: integer, prior: integer, budget: integer): integer do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    next = nc_end(source,start)
    name = if classify_ascii(value) == 2 do 1 else 0 end
    word = if name == 0 do 0 else nc_word(source,start,b[110,111,116])+nc_word(source,start,b[97,110,100])+nc_word(source,start,b[111,114]) end
    fine = if name == 1 do sg_constant_name(source,start) else
