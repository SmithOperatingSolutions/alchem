  # structs they make, for the library text to be chosen by.
  def sg_hint(source: bytes, first: integer, stop: integer, letter: integer): integer do
    if stop-first > 64 do
      middle = first+nc_half(stop-first)
      if sg_hint(source,first,middle,letter) == 1 do 1 else sg_hint(source,middle,stop,letter) end
    else sg_hint_scan(source,first,stop,letter) end
  end
  def sg_hint_scan(source: bytes, pos: integer, stop: integer, letter: integer): integer do
    if pos >= stop do 0 else
      if byte_at(source,pos) != 126 do sg_hint_scan(source,pos+1,stop,letter) else
        if byte_at(source,pos+1) != letter do sg_hint_scan(source,pos+1,stop,letter) else if sg_starts(source,pos) == 1 do 1 else sg_hint_scan(source,pos+1,stop,letter) end end
      end
    end
