  # body gives {} for each element.
  def wf_effect(source: bytes, last: integer, env: bytes): integer do
    branch = nc_word(source,last,b[105,102])+nc_word(source,last,b[117,110,108,101,115,115])+nc_word(source,last,b[99,97,115,101])+nc_word(source,last,b[99,111,110,100])+wc_keyword(source,last,env)+wf_keyword(source,last,env)+ty_keyword(source,last,env)
    if last < 0 do 0 else if ns_output_statement(source,last)+nx_halts(source,last) > 0 do 1 else
      if nf_binds(source,last)+np_binds(source,last) > 0 do 0 else if branch > 0 do 0 else 1 end end
    end end
  end
  # The line after the code the pinned compiler makes of the statement at
  # last, which ends a block whose value is used: the next line; for an if
  # the line after its last branch and one more; for a for the line its
  # function stands at when it is over, and one more.
  def wf_after(source: bytes, found: bytes, table: bytes, depth: integer): integer do
    last = nc_pos(found)
    env = wc_first(nc_code(found))
    if last < 0 do 0 else
      if nc_word(source,last,b[105,102])+nc_word(source,last,b[117,110,108,101,115,115]) == 1 do wf_branch(source,last,env,table,depth) else
        if wf_keyword(source,last,env)+ty_keyword(source,last,env) > 0 do wf_inner(wc_second(nc_code(found)),last) else
          if nc_word(source,last,b[99,111,110,100])*nc_opens(source,nc_end(source,last)) == 1 do wf_cond(source,nc_join(nc_u32(last),nc_u32(nc_end(source,nc_end(source,last))),b[0,0,0,0,0]),env,table,depth) else last+4294967296 end
        end
      end
    end
  end
  # A cond is nested ifs to the pinned compiler: a line for each arm after
  # the last arm's body when its condition is true, else after the line that
  # follows the cond. plan: where the cond stands, where to read on, the
  # arrow of the last arm so far and how many arms came.
  def wf_cond(source: bytes, plan: bytes, env: bytes, table: bytes, depth: integer): integer do
    next = wc_scan(source,nc_long(plan,4),4)
    count = Enum.at(plan,12,0)
    arrow = nc_long(plan,8)
    if next < 0 do nc_long(plan,0)+4294967296 else if count > 250 do nc_long(plan,0)+4294967296 else
      if nc_word(source,next,b[45,62]) == 1 do wf_cond(source,nc_join(nc_slice(plan,0,4),nc_u32(next+2),Enum.concat(nc_u32(next),b[count+1])),env,table,depth) else
        if wf_true(source,nz_before(source,arrow-1)) == 0 do nc_long(plan,0)+(1+count)*4294967296 else wf_after(source,wf_last(source,arrow+2,env,table,depth),table,depth)+(count-1)*4294967296 end
      end
    end end
  end
  # 1 when the word that ends at pos is true and starts its line.
  def wf_true(source: bytes, pos: integer): integer do
    if pos < 3 do 0 else if nc_word_at(source,pos-3,b[116,114,117,101],0) == 0 do 0 else nk_line_start(source,pos-3) end end
  end
  def wf_branch(source: bytes, last: integer, env: bytes, table: bytes, depth: integer): integer do
    opener = wc_scan(source,nc_end(source,last),3)
    other = wc_scan(source,nc_end(source,opener),2)
    final = if nc_word(source,other,b[101,108,115,101]) == 1 do nc_end(source,other) else nc_end(source,opener) end
    if opener < 0 do last+4294967296 else if byte_at(source,nc_end(source,opener)) == 58 do last+8589934592 else
      wf_after(source,wf_last(source,final,env,table,depth),table,depth)+4294967296
    end end
  end
  # A for leaves the line its function then stands at in its last
  # instruction: code is that of a statement that is a for.
  def wf_inner(code: bytes, last: integer): integer do
    size = Enum.count(code)
    noted = if size < 10 do 0 else nt_same(nc_slice(code,size-10,size-4),b[199,133,120,255,255,255]) end
    halved = if size < 20 do 0 else nt_same(nc_slice(code,size-20,size-14),b[199,133,120,255,255,255])*nt_same(nc_slice(code,size-10,size-4),b[199,133,124,255,255,255]) end
    upper = nc_read(code,size-4)+nc_read(code,size-2)*65536
    if halved == 1 do nz_line(nc_read(code,size-14)+nc_read(code,size-12)*65536,upper)+4294967296 else
      if noted == 0 do last+4294967296 else nz_line(upper,0)+4294967296 end
    end
  end
  # The three parts of a for's code with what a trace needs: cursor is the
  # line after the body and pos where the frame stands as the body begins,
  # -1 when the body's statements say it.
  def wf_traced(table: bytes, state: bytes, cursor: integer, pos: integer, parts: bytes): bytes do
    rest = wc_second(parts)
    final = wf_final(state,cursor)
    after = if Enum.count(wc_second(rest)) == 0 do b[] else nz_at(table,final) end
    wc_both(Enum.concat(wf_enter(table,state,final),wc_first(parts)),wc_both(Enum.concat(wf_inside(table,state,cursor,pos),wc_first(rest)),nc_join(wf_leave(table,state,final),wc_second(rest),after)))
  end
  # The values of the body as the for's result. state has also where the
  # body starts, the depth and 1 for the one-line form.
  def wf_collect(source: bytes, table: bytes, env: bytes, state: bytes, body: bytes, found: bytes): bytes do
    line = Enum.at(state,37,0)
    plain = if Enum.at(state,7,0) == 0 do 1 else if Enum.at(state,7,0) == 4 do 1 else 0 end end
    empty = if nc_tag(body) == 12 do 1 else nh_effect(source,nc_pos(found),b[],2) end
    effect = if empty == 0 do 0 else wf_effect(source,nc_pos(found),env) end
    item = if empty == 0 do nc_kind(body) else if effect == 1 do b[5,0] else b[] end end
    cursor = if line == 1 do nc_long(state,32)+4294967296 else
      if Enum.at(state,0,0)*plain+empty > 0 do nc_pos(found)+4294967296 else wf_after(source,found,table,Enum.at(state,36,0)) end
    end
    start = if line == 1 do nc_long(state,32) else -1 end
    if Enum.at(state,0,0)*plain == 1 do
      nw_keep(nc_value(nc_pos(body),wf_traced(table,state,cursor,start,wc_both(b[],wc_both(nc_code(body),b[]))),b[12]),body,b[])
    else
      made = if Enum.count(item) == 0 do b[] else wf_listed(source,table,env,state,nc_value(nc_pos(body),nc_code(body),item)) end
      value = if nc_pos(made) < 0 do b[] else nc_value(nc_pos(body),wf_traced(table,state,cursor,start,nc_code(made)),nc_kind(made)) end
      if plain == 1 do nw_keep(value,body,b[]) else if nw_marked(body) == 1 do nw_mark(value) else value end end
    end
  end
  # The parts that make the list: body is the body's code with the type of
  # an element, {} for a body run for its effect, which the for's second slot
  # then holds.
  def wf_listed(source: bytes, table: bytes, env: bytes, state: bytes, body: bytes): bytes do
    slot = nc_cursor(state,1)
    empty = if nt_same(nc_kind(body),b[5,0]) == 1 do 1 else 0 end
    tail = wf_tail(source,table,env,state,nc_kind(body))
    keep = nc_join(nc_code(body),if empty == 1 do nc_slot(b[72,255,117],slot+1) else b[80] end,nc_slot(b[72,255,69],slot))
    unit = if empty == 0 do b[] else nc_join(nc_allocate_emit(0),b[72,199,2,0,0,0,0],nc_slot(b[72,137,85],slot+1)) end
    made = nc_join(nc_slot(b[72,139,77],slot),nl_pack_blob(),nc_code(tail))
    if nc_pos(tail) < 0 do b[] else
      nc_value(nc_pos(body),wc_both(nc_join(nc_slot(b[72,199,69],slot),b[0,0,0,0],unit),wc_both(keep,made)),nc_kind(tail))
    end
  end
  # What the option makes of the list in RAX, whose elements are of type
  # item: a packet of that code and the type of the result.
  def wf_tail(source: bytes, table: bytes, env: bytes, state: bytes, item: bytes): bytes do
    choice = Enum.at(state,7,0)
    list = nt_unary(7,item)
    compare = if choice != 2 do b[] else if nq_comparable(source,table,item,b[]) == 0 do b[] else nq_code(source,table,item,nu_vars(env,3)) end end
    if choice == 1 do wf_into(source,table,env,state,item) else
      if choice != 2 do nc_value(0,b[],list) else
        if Enum.count(compare) == 0 do b[] else
          nc_value(0,nc_join(wf_uniq_emit(),nc_u32(Enum.count(compare)+1),Enum.concat(compare,b[195])),list)
        end
      end
    end
  end
  # The list in RAX without the elements that equal an earlier one. The
  # comparison is a routine behind it, which a jump passes.
  def wf_uniq_emit(): bytes do
    Enum.concat(b[80,72,139,8,73,137,203,73,193,227,4,79,141,92,28,24,77,57,235,118,12,255,20,37,120,4,64,0,15,31,68,0,0,73,199,4,36,254,255,255,255,73,141,84,36,16,77,137,220,82,106,0,80,72,139,4,36,72,131,56,0,116,92,106,0,72,139,12,36,72,59,76,36,16,115,38,72,139,84,36,24,72,193,225,4,72,139,116],b[10,8,72,139,68,36,8,72,139,120,8,232,76,0,0,0,132,192,117,39,72,255,4,36,235,207,72,139,68,36,8,72,139,120,8,72,139,84,36,24,72,139,76,36,16,72,193,225,4,72,137,124,10,8,72,255,68,36,16,89,72,131,4,36,16,235,154,89,89,88,72,137,194,72,137,10,72,131,194,16,72,131,233,1,121,243,89,233])
  end
  # into: a list takes the elements after its own, a map the {key, value}
  # tuples as entries (a later one replaces an earlier one of its key), a
  # set the elements and a string the strings.
  def wf_into(source: bytes, table: bytes, env: bytes, state: bytes, item: bytes): bytes do
    target = nc_expression(source,nc_long(state,8),wf_outer(env,state),table,Enum.at(state,36,0))
    tag = nc_tag(target)
    pair = if nt_tag(item) != 5 do b[] else if nt_count(item) != 2 do b[] else nt_binary(8,nt_child(item,0),nt_child(item,1)) end end
    kind = if tag == 7 do nt_merge(nc_kind(target),nt_unary(7,item)) else if tag == 8 do nt_merge(nc_kind(target),pair) else if tag == 25 do nt_merge(nc_kind(target),nt_unary(25,item)) else if tag != 2 do b[] else if nt_tag(item) == 2 do b[2] else b[] end end end end end
    tagged = if (tag-8)*(tag-25) != 0 do b[] else nm_tagged(nt_child(kind,0),nu_vars(env,3)) end
    swap = Enum.concat(nc_code(target),b[89,80,81])
    if nc_pos(target) < 0 do b[] else if nt_tag(kind) < 0 do b[] else
      if tag == 7 do nc_value(0,nc_join(b[80],swap,nl_concat_emit()),kind) else
        if tag == 2 do nc_value(0,nc_join(Enum.concat(b[80,106,0],na_join_emit()),Enum.concat(b[80],swap),ns_concat_emit()),kind) else
          if Enum.count(tagged) == 0 do b[] else
            nc_value(0,nc_join(nc_join(if tag == 25 do Enum.concat(nn_pairs(),b[80]) else b[80] end,nc_code(target),Enum.concat(b[80,65,186,2,0,0,0],nm_entries_emit())),Enum.concat(b[89,80,81],nl_concat_emit()),nc_join(b[80],tagged,nm_new_emit())),kind)
          end
        end
      end
    end end
  end
  # reduce: initial with arms of accumulator -> body: the accumulator waits
  # in the for's slot, the arms are a case over it and its value is the next
  # accumulator. An initial value of open type (an empty %{} or []) takes
  # its type from what the for is bound to, or else from what the arms give;
  # the value is then marked as one that needed a type.
  def wf_reduce(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, state: bytes): bytes do
    gm_reduced(source,table,wf_reduce_in(source,start,gm_arm(source,start,env),table,depth,state))
  end
  def wf_reduce_in(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, state: bytes): bytes do
    slot = nc_cursor(state,1)
    initial = nc_expression(source,nc_long(state,8),wf_outer(env,state),table,depth)
    wanted = nw_expected(env,nc_long(state,13),3)
    given = if Enum.count(wanted) == 0 do nc_kind(initial) else nt_merge(nc_kind(initial),wanted) end
    load = nc_slot(b[72,139,69],slot)
    plain = if nc_pos(initial) < 0 do b[] else if nt_tag(given) < 0 do b[] else np_case(source,nc_value(start,load,given),env,table,depth,start) end end
    # Arms that cannot be typed over an open accumulator are tried with the
    # result type of the function the for stands in.
    guess = if nc_pos(plain) >= 0 do b[] else if nc_pos(initial) < 0 do b[] else if nu_holes(given,0) == 0 do b[] else nt_merge(given,nc_return_kind(source,table,nc_cursor(env,0))) end end end
    base = if nt_tag(guess) < 0 do given else guess end
    first = if nt_tag(guess) < 0 do plain else np_case(source,nc_value(start,load,guess),env,table,depth,start) end
    kind = nt_merge(base,nc_kind(first))
    arms = if nt_tag(kind) < 0 do b[] else if nt_same(kind,base) == 1 do first else np_case(source,nc_value(start,load,kind),env,table,depth,start) end end
    store = nc_slot(b[72,137,69],slot)
    if nc_pos(arms) < 0 do b[] else if no_compatible(kind,nc_kind(arms)) == 0 do b[] else
      # The arms are a statement where the for stands, counted each time round.
      value = nc_value(nc_pos(arms),wf_traced(table,state,nc_long(state,13)+4294967296,nc_long(state,13),wc_both(Enum.concat(nc_code(initial),store),wc_both(nc_join(zf_cover(source,table,env,start),nc_code(arms),store),load))),kind)
      if nu_holes(given,0) == 1 do nw_mark(value) else if nw_marked(arms) == 1 do nw_mark(value) else value end end
    end end
  end
  # Native smoke test; comprehensions.
  def main() do System.halt(0) end
end
