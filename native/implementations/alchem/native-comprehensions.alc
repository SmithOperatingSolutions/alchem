defmodule NativeComprehensions do
  # with and for (spec/alchem-comprehensions.md).
  #
  # A packet at another position, its marks kept.
  def wc_at(value: bytes, pos: integer): bytes do
    if nc_pos(value) < 0 do b[] else if pos < 0 do b[] else
      Enum.concat(nc_u32(pos+nc_long(value,0)-nc_pos(value)),nc_slice(value,4,Enum.count(value)))
    end end
  end
  # The program ends naming pos and a reason the trace routine has no number
  # for: the message follows the call as a string.
  def wc_fail(table: bytes, pos: integer, message: bytes): bytes do
    if nz_on(table) == 0 do nc_exit_code(70) else
      nc_join(Enum.concat(b[191],nc_u32(pos)),Enum.concat(xa_mark(8+Enum.count(message),b[72,141,53,9,0,0,0]),nc_call(nz_slot(table))),Enum.concat(nt_word(Enum.count(message)),message))
    end
  end
  # What fails is a closure in the pinned compiler: one more line of a trace,
  # at the statement pos.
  def wc_enter(table: bytes, pos: integer): bytes do
    if nz_on(table) == 0 do b[] else Enum.concat(nz_at(table,pos),b[72,139,133,120,255,255,255,80,255,181,112,255,255,255,72,137,165,112,255,255,255]) end
  end
  # The position after the pattern at pos; an atom is two tokens.
  def wc_skip(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    if byte_at(source,start) != 58 do np_skip(source,start) else if classify_ascii(byte_at(source,start+1)) != 2 do -1 else nc_end(source,start+1) end end
  end
  # 1 when the arms from pos to the end that closes them are arms by their
  # form: a pattern, perhaps a guard, an arrow and a body. Arms no value
  # reaches are not compiled, and still have to be arms.
  def wc_shapes(source: bytes, pos: integer, budget: integer): integer do
    start = nc_start(source,pos)
    next = byte_at(source,nc_start(source,nc_end(source,start)))
    call = if classify_ascii(byte_at(source,start)) != 2 do 0 else if next != 40 do 0 else if (byte_at(source,start)-65)*(90-byte_at(source,start)) >= 0 do 0 else 1-nx_constructor(source,start) end end end
    body = wc_arm_body(source,wc_skip(source,start))
    after = wc_scan(source,body,1)
    if budget == 0 do 0 else if call == 1 do 0 else if after < 0 do 0 else if nc_start(source,after) == nc_start(source,body) do 0 else
      if nc_word(source,after,b[101,110,100]) == 1 do 1 else wc_shapes(source,after,budget-1) end
    end end end end
  end
  # 1 when with stands at pos and names no binding (the library written in
  # Alchem has parameters of that name).
  def wc_keyword(source: bytes, pos: integer, env: bytes): integer do
    if nc_word(source,pos,b[119,105,116,104]) == 0 do 0 else if nc_lookup(source,nc_start(source,pos),env,3) >= 0 do 0 else 1 end end
  end
  # 1 when "<-" stands at pos.
  def wc_arrow(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    if start < 0 do 0 else if byte_at(source,start)*256+byte_at(source,start+1) == 15405 do 1 else 0 end end
  end
  # Reading on by tokens, brackets and do/fn ... end nesting: in mode 0 to the
  # end that closes the block the position stands in, in mode 1 to where the
  # next arm of that block starts or the block ends, in mode 2 to its else or
  # end, in mode 3 to the next do, in mode 4 to the next arrow or the end,
  # in mode 5 to the bar of a list and in mode 6 to the next word of a try
  # (rescue, catch, else, after) or its end. A state is nk_state's; the answer 1
  # carries the position.
  def wc_scan_step(source: bytes, pos: integer, depth: integer, mode: integer): bytes do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    opens = if (value-40)*(value-91)*(value-123) == 0 do 1 else if value == 100 do nc_opens(source,start) else if value == 102 do nf_untyped(source,start) else 0 end end end
    closes = if (value-41)*(value-93)*(value-125) == 0 do 1 else if value == 101 do nc_word(source,start,b[101,110,100]) else 0 end end
    found = if depth > 0 do 0 else if mode == 0 do nc_word(source,start,b[101,110,100]) else if mode == 1 do wc_arm_at(source,start) else
      if mode == 3 do nc_word(source,start,b[100,111]) else if mode == 5 do if byte_at(source,start+1) == 62 do 0 else nc_word(source,start,b[124]) end else nc_word(source,start,b[101,110,100])+(if mode == 2 do wc_other(source,start) else if mode == 6 do wc_other(source,start)+ty_word(source,start) else nc_word(source,start,b[45,62]) end end) end end
    end end end
    if start < 0 do nk_state(0,0,0) else if start >= Enum.count(source) do nk_state(0,0,0) else
      if found == 1 do nk_state(start,0,1) else
        if depth+opens-closes < 0 do nk_state(0,0,0) else nk_state(nc_end(source,start),depth+opens-closes,2) end
      end
    end end
  end
  # 1 for the else of a block; the else: of a one-line if ends no block.
  def wc_other(source: bytes, start: integer): integer do
    if nc_word(source,start,b[101,108,115,101]) == 0 do 0 else if byte_at(source,nc_end(source,start)) == 58 do 0 else 1 end end
  end
  # Where an arm starts: a pattern and its arrow or guard.
  def wc_arm_at(source: bytes, start: integer): integer do
    after = wc_skip(source,start)
    if nc_word(source,start,b[101,110,100])+wc_other(source,start) > 0 do 1 else
      if after < 0 do 0 else nc_word(source,after,b[45,62])+nc_word(source,after,b[119,104,101,110]) end
    end
  end
  def wc_scan_run(source: bytes, state: bytes, size: integer, mode: integer): bytes do
    half = nc_half(size)
    if Enum.at(state,6,0) != 2 do state else
      if size == 1 do wc_scan_step(source,nc_long(state,0),nc_read(state,4),mode) else
        wc_scan_run(source,wc_scan_run(source,state,half,mode),size-half,mode)
      end
    end
  end
  def wc_scan(source: bytes, pos: integer, mode: integer): integer do
    state = if pos < 0 do b[] else wc_scan_run(source,nk_state(pos,0,2),16777216,mode) end
    if Enum.at(state,6,0) == 1 do nc_long(state,0) else -1 end
  end
  # 1 when the pattern tree at offset matches every value by its form alone:
  # a name, _, or a tuple or struct of such.
  def wc_open(tree: bytes, offset: integer): integer do
    layout = np_layout(tree,offset)
    if Enum.at(tree,offset,0) < 2 do 1 else
      if (layout-0)*(layout-11) != 0 do 0 else wc_open_parts(tree,np_below(tree,offset),np_count(tree,offset)) end
    end
  end
  def wc_open_parts(tree: bytes, offset: integer, count: integer): integer do
    if count == 0 do 1 else if wc_open(tree,offset) == 0 do 0 else wc_open_parts(tree,np_size(tree,offset),count-1) end end
  end
  def wc_row(tree: bytes): bytes do Enum.concat(nc_u32(Enum.count(tree)),tree) end
  # with pattern <- expression, ... do body else pattern -> body ... end,
  # as the pinned compiler's nested cases: each clause matches its pattern
  # and goes on; a value that does not match goes to the else arms, or without
  # else is the result.
  def wc_with(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    inner = if depth > 190 do b[] else wc_clause(source,nc_end(source,start),env,table,depth+1,start) end
    after = nc_pos(inner)
    other = nc_expect(source,after,b[101,108,115,101])
    stop = if after < 0 do -1 else if other < 0 do nc_expect(source,after,b[101,110,100]) else
      if wc_shapes(source,other,100000) == 0 do -1 else nc_expect(source,wc_scan(source,other,0),b[101,110,100]) end
    end end
    wc_at(inner,stop)
  end
  # A with used as a value is a closure in the pinned compiler: a trace shows
  # it running the with.
  # A body that does not compile for want of a lambda's type waits for the
  # type the else arms give, as the first branch of an if does (nf_hinting).
  def wc_value(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    valued = nj_valued(env)
    first = wc_with(source,start,valued,table,depth)
    hinting = if nc_pos(first) >= 0 do b[] else nf_trial(source,start,valued,table) end
    trial = if Enum.count(hinting) == 0 do b[] else wc_with(source,start,hinting,table,depth) end
    settled = nf_settling(valued,trial)
    made = if nc_pos(first) >= 0 do first else if Enum.count(settled) == 0 do b[] else wc_with(source,start,settled,table,depth) end end
    zf_valued(source,table,env,nz_closure(source,table,made,start),start)
  end
  # The clause at pos and everything after it: a packet at the end of the body.
  def wc_clause(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, origin: integer): bytes do
    arrow = wc_skip(source,pos)
    value = if wc_arrow(source,arrow) == 0 do b[] else nw_settled(nc_expression(source,nc_start(source,arrow)+2,env,table,depth)) end
    slot = nc_env_count(env,3)
    mark = if arrow < 0 do 0 else arrow end
    held = Enum.concat(env,nc_env_record(mark,mark,nc_kind(value)))
    parsed = if nc_pos(value) < 0 do b[] else if nc_tag(value) == 12 do b[] else np_parse(source,pos,held,table,nc_kind(value)) end end
    # A clause's pattern made of names, tuples, structs and none is to the pinned compiler one that matches everything, and with a none it is then rejected as a case that does not.
    fits = if nc_pos(parsed) < 0 do 0 else if nc_start(source,nc_pos(parsed)) == nc_start(source,arrow) do 1-zf_bare(np_tree(parsed),0,1)*(1-wc_open(np_tree(parsed),0)) else 0 end end
    next = nc_pos(value)
    inner = if fits == 0 do b[] else
      if nc_word(source,next,b[44]) == 1 do zf_counted(source,table,env,wc_clause(source,nc_end(source,next),np_env(parsed),table,depth,origin),origin) else
        if nc_opens(source,next) == 0 do b[] else nc_branch(source,nc_end(source,next),np_env(parsed),table,depth) end
      end
    end
    if nc_pos(inner) < 0 do b[] else wc_matched(source,table,nc_join(Enum.concat(nc_u24(slot),b[depth]),nc_u32(origin),nc_u32(nc_start(source,nc_start(source,arrow)+2))),value,nc_join(wc_row(np_tree(parsed)),held,b[]),wc_both(inner,np_env(parsed))) end
  end
  # Two packets as one: the first after its length (3 bytes).
  def wc_both(first: bytes, second: bytes): bytes do nc_join(nc_u32(Enum.count(first)),first,second) end
  def wc_first(both: bytes): bytes do nc_slice(both,4,4+nc_long(both,0)) end
  def wc_second(both: bytes): bytes do nc_slice(both,4+nc_long(both,0),Enum.count(both)) end
  # plan: the slot the value waits in, the depth, where the with stands and
  # where the clause's expression does. given: the pattern's tree as a row,
  # then the environment with the value's slot. rest: what follows the clause
  # and the environment with the pattern's names.
  def wc_matched(source: bytes, table: bytes, plan: bytes, value: bytes, given: bytes, rest: bytes): bytes do
    slot = nc_cursor(plan,0)
    tree = nc_slice(given,4,4+nc_long(given,0))
    held = nc_slice(given,4+nc_long(given,0),Enum.count(given))
    inner = wc_first(rest)
    match = np_emit(source,wc_second(rest),table,tree,0)
    store = Enum.concat(nc_code(value),nc_slot(b[72,137,69],slot))
    other = nc_expect(source,nc_pos(inner),b[101,108,115,101])
    # What a value that does not match meets is a statement of its own in the pinned compiler, where the with stands.
    arms = nc_join(nc_slice(plan,0,8),b[0],nc_join(nc_u32(Enum.count(given)-Enum.count(held)),nc_slice(given,0,Enum.count(given)-Enum.count(held)),b[]))
    plain = if wc_open(tree,0) == 1 do b[] else
      if other < 0 do wc_unmatched(table,plan,nc_kind(value),inner) else wc_arms(source,other,held,table,Enum.at(plan,3,0),arms) end
    end
    # Else arms that do not compile are expected to give the body's type (nf_led).
    led = if nc_pos(plain) >= 0 do b[] else if other < 0 do b[] else if wc_open(tree,0) == 1 do b[] else nf_led(source,held,table,inner,other) end end end
    missed = if Enum.count(led) == 0 do plain else wc_arms(source,other,led,table,Enum.at(plan,3,0),arms) end
    miss = zf_counted(source,table,held,missed,nc_long(plan,4))
    if Enum.count(match) == 0 do b[] else
      if wc_open(tree,0) == 1 do nw_keep(nc_value(nc_pos(inner),nc_join(store,match,nc_code(inner)),nc_kind(inner)),inner,b[]) else
        if nc_pos(miss) < 0 do b[] else np_join(nc_join(store,match,b[132,192,15,132]),b[],inner,wc_at(miss,nc_pos(inner))) end
      end
    end
  end
  # Without else a value that does not match is the result when it has the
  # type of the body; an error passes to another result of the same reason
  # type and an option that does not match is none. A with whose value cannot
  # be the result leaves no value: it is a statement.
  def wc_unmatched(table: bytes, plan: bytes, kind: bytes, inner: bytes): bytes do
    want = nc_kind(inner)
    load = nc_slot(b[72,139,69],nc_cursor(plan,0))
    fail = Enum.concat(wc_enter(table,nc_long(plan,4)),wc_fail(table,nc_long(plan,8),b[110,111,32,119,105,116,104,32,99,108,97,117,115,101,32,109,97,116,99,104,101,100]))
    passed = nt_merge(want,Enum.concat(b[6,9],nt_child(kind,1)))
    if nt_tag(want) == 12 do nc_value(nc_pos(inner),b[],b[12]) else
      if nt_tag(nt_merge(want,kind)) >= 0 do wc_hinted(nc_value(nc_pos(inner),load,kind),inner) else
        if nt_tag(want)*nt_tag(kind) == 36 do
          if nt_tag(passed) < 0 do nc_value(nc_pos(inner),b[],b[12]) else
            wc_hinted(nc_value(nc_pos(inner),nc_join(load,b[72,131,56,0,116,Enum.count(fail)],fail),passed),inner)
          end
        else
          if nt_tag(want)*nt_tag(kind) == 16 do wc_hinted(nc_value(nc_pos(inner),b[49,192],want),inner) else nc_value(nc_pos(inner),b[],b[12]) end
        end
      end
    end
  end
  # The pinned compiler needs the type of the whole with to say what a value
  # that does not match becomes: a body of open type has to get it from
  # where the with stands.
  def wc_hinted(value: bytes, inner: bytes): bytes do
    if nw_marked(inner) == 1 do nw_mark(value) else if nu_holes(nc_kind(inner),0) == 1 do nw_mark(value) else value end end
  end
  # The else arms for one clause's value, which waits in a slot: the arms
  # whose pattern fits its type, until they and the clause's own pattern
  # match every value. state: the slot, the depth, where the with stands, how
  # many arms were taken, the rows that count toward that (after their length,
  # 2 bytes), then the rows of the arms taken that have no guard.
  def wc_arms(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, state: bytes): bytes do
    slot = nc_cursor(state,0)
    size = nc_long(state,9)
    cover = nc_slice(state,13,13+size)
    start = nc_start(source,pos)
    kind = nt_read(env,nc_env_offset(env,slot)+7)
    done = if nc_word(source,start,b[101,110,100]) == 1 do 1 else 1-np_useful(source,cover,b[0],1) end
    if start < 0 do b[] else
      if done == 1 do
        if Enum.at(state,8,0) == 0 do b[] else nc_value(start,wc_fail(table,nc_long(state,4),b[110,111,32,99,97,115,101,32,98,114,97,110,99,104,32,109,97,116,99,104,101,100]),b[9]) end
      else
        parsed = np_parse(source,start,env,table,kind)
        stop = wc_skip(source,start)
        fits = if nc_pos(parsed) < 0 do 0 else if nc_start(source,nc_pos(parsed)) == nc_start(source,stop) do 1 else 0 end end
        next = wc_scan(source,wc_arm_body(source,stop),1)
        if next < 0 do b[] else
          if fits == 0 do wc_arms(source,next,env,table,depth,state) else
            if np_useful(source,nc_slice(state,13+size,Enum.count(state)),np_tree(parsed),1) == 0 do b[] else wc_arm(source,wc_both(parsed,nc_u32(next)),env,table,depth,state) end
          end
        end
      end
    end
  end
  # The position after the arrow of the arm whose pattern ends at pos.
  def wc_arm_body(source: bytes, pos: integer): integer do
    if nc_word(source,pos,b[119,104,101,110]) == 0 do nc_expect(source,pos,b[45,62]) else wc_arm_arrow(source,nc_end(source,pos),0,16777216) end
  end
  def wc_arm_arrow(source: bytes, pos: integer, depth: integer, budget: integer): integer do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    opens = if (value-40)*(value-91)*(value-123) == 0 do 1 else if value == 100 do nc_opens(source,start) else if value == 102 do nf_untyped(source,start) else 0 end end end
    closes = if (value-41)*(value-93)*(value-125) == 0 do 1 else if value == 101 do nc_word(source,start,b[101,110,100]) else 0 end end
    if start < 0 do -1 else if budget == 0 do -1 else if start >= Enum.count(source) do -1 else
      if depth == 0 do if nc_word(source,start,b[45,62]) == 1 do nc_end(source,start) else wc_arm_arrow(source,nc_end(source,start),depth+opens-closes,budget-1) end else
        wc_arm_arrow(source,nc_end(source,start),depth+opens-closes,budget-1)
      end
    end end end
  end
  def wc_arm(source: bytes, found: bytes, env: bytes, table: bytes, depth: integer, state: bytes): bytes do
    parsed = wc_first(found)
    next = nc_long(wc_second(found),0)
    scope = np_env(parsed)
    guarded = nc_word(source,nc_pos(parsed),b[119,104,101,110])
    guard = if guarded == 0 do nc_value(nc_pos(parsed),b[],b[3]) else nc_condition(source,nc_end(source,nc_pos(parsed)),sg_conditional(scope),table,depth+1) end
    arrow = nc_expect(source,nc_pos(guard),b[45,62])
    body = if arrow < 0 do b[] else nc_branch(source,arrow,scope,table,depth+1) end
    size = nc_long(state,9)
    row = if guarded == 1 do b[] else wc_row(np_tree(parsed)) end
    grown = nc_join(nc_join(nc_slice(state,0,8),b[1],nc_u32(size+Enum.count(row))),nc_join(nc_slice(state,13,13+size),row,nc_slice(state,13+size,Enum.count(state))),row)
    rest = if nc_pos(body) < 0 do b[] else if nc_start(source,nc_pos(body)) != next do b[] else wc_arms(source,next,env,table,depth,grown) end end
    match = np_emit(source,scope,table,np_tree(parsed),0)
    check = if guarded == 0 do b[] else Enum.concat(nc_code(guard),b[72,133,192,15,132]) end
    if Enum.count(match) == 0 do b[] else np_join(nc_join(nc_slot(b[72,139,69],nc_cursor(state,0)),match,b[132,192,15,132]),check,body,rest) end
  end
  # [first, second | rest]: the listed elements before those of another
  # list. spans are the literal's elements as nc_list_collect finds them, the
  # last of which holds the bar; b[] when there is none.
  def wc_cons(source: bytes, state: bytes, env: bytes, table: bytes, depth: integer): bytes do
    spans = nc_code(state)
    count = nc_units(Enum.count(spans),8)
    first = nc_long(spans,count*8-8)
    stop = nc_long(spans,count*8-4)
    bar = wc_scan(source,first,5)
    cut = Enum.concat(nc_slice(spans,0,count*8-4),nc_u32(if bar < 0 do 0 else bar end))
    items = if bar < 0 do b[] else if bar >= stop do b[] else nl_items(source,cut,env,table,depth,nc_join(nc_u24(0),nc_u24(count),if nf_parted(source,env,table) == 1 do b[1] else b[] end)) end end
    plain = if nc_pos(items) < 0 do b[] else nc_expression(source,bar+1,env,table,depth) end
    # A tail that does not compile without its type (one that holds a fn) is given the type of the elements before the bar.
    rest = if nc_pos(items) < 0 do b[] else if nc_pos(plain) >= 0 do plain else nc_expression(source,bar+1,nw_expect(env,0,nt_unary(7,nc_kind(items))),table,depth) end end
    kind = nt_merge(nt_unary(7,nc_kind(items)),nc_kind(rest))
    made = nc_value(nc_pos(state),nc_join(nc_join(nc_code(items),nc_code(rest),b[80]),Enum.concat(b[185],nc_u32(count)),nl_cons_emit()),kind)
    if nc_pos(rest) < 0 do b[] else if nc_start(source,nc_pos(rest)) != stop do b[] else if nt_tag(kind) != 7 do b[] else
      # A tail of open type ([none], [[]]) has its type from the elements: nothing is left for the surroundings to say.
      if nu_holes(kind,0) == 0 do if nw_marked(items) == 1 do nw_keep(made,items,b[]) else made end else nw_keep(made,items,rest) end
    end end end
  end
  # for pattern <- enumerable, filter, ... do body end, and its one-line form
  # ending in ", do: expression". It is a loop in the enclosing function's
  # frame: each generator keeps its list and its index in two slots (and a
  # closure record in two more), and the body's values wait on the stack
  # until the list that holds them is made, so a for allocates its result
  # once.
  #
  # 1 when for stands at pos and names no binding.
  def wf_keyword(source: bytes, pos: integer, env: bytes): integer do
    if nc_word(source,pos,b[102,111,114]) == 0 do 0 else if nc_lookup(source,nc_start(source,pos),env,3) >= 0 do 0 else 1 end end
  end
  # The environment with one more slot that has no name.
  def wf_record(env: bytes, pos: integer, kind: bytes): bytes do
    Enum.concat(env,nc_env_record(pos,pos,kind))
  end
  # mode 0: the for is a value. mode 1: its value is dropped, so the body is
  # run for its effects and no list is made. The for has three slots of its
  # own (the count of values or the accumulator; the {} of a body run for
  # its effect; the line the frame stood on when the for began) and the
  # slots of two closure records. A state is: the mode, the first slot, the
  # length of the environment with the for's own slots (3 bytes), the option
  # (1 into, 2 uniq: true, 3 reduce, 4 uniq: false) and where its value
  # starts (3 bytes), 1 for the form in parentheses, where the for stands (3
  # bytes), how many generators came so far, the line the next item stands
  # on (past the for's own), the chain slot of the innermost record so far,
  # and the first slots of the for's record and of the body's.
  def wf_for(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, mode: integer): bytes do
    after = nc_end(source,start)
    paren = nc_word(source,after,b[40])
    first = if paren == 1 do nc_end(source,after) else after end
    slot = nc_env_count(env,3)
    whole = wf_pair(wf_record(wf_record(wf_record(env,start,b[0]),start,b[0]),start,b[0]),start)
    pair = wf_pair(whole,start)
    # A for is a closure of the pinned compiler: no return stands in it, and
    # a call in it is not the function's result (nj_valued, tl_allowed).
    held = nj_valued(pair)
