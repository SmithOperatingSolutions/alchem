  def mt_steps(work: bytes, cursor: bytes, level: integer, remaining: integer): bytes do
    if Enum.count(cursor) == 0 do cursor else if Enum.at(cursor,4,0) != 0 do cursor else if remaining == 0 do cursor else
      next = if level == 0 do mt_chunk(work,cursor,16) else mt_steps(work,cursor,level-1,16) end
      mt_steps(work,next,level,remaining-1)
    end end end
  end
  # The records so far are in two parts, ix and behind it late, those added
  # since the two were last joined: a record added to the end of all of
  # them copied them all, and a program of n functions that has a macro, a
  # template or a protocol took n times n (8,000 functions 4.5 GB, 32,000
  # the whole arena). late is joined to ix when it is a quarter of it, so
  # every record is copied a few times.
  def mt_joins(ix: bytes, late: bytes, more: bytes): integer do
    if (Enum.count(late)+Enum.count(more))*4 > 16384+Enum.count(ix) do 1 else 0 end
  end
  def mt_kept(ix: bytes, late: bytes, more: bytes): bytes do
    if mt_joins(ix,late,more) == 1 do nc_join(ix,late,more) else ix end
  end
  def mt_late(ix: bytes, late: bytes, more: bytes): bytes do
    if mt_joins(ix,late,more) == 1 do b[] else Enum.concat(late,more) end
  end
  # What one declaration adds, for mt_index to go on from: 1, whether the
  # text goes on inside a body, where it goes on, the module's number plus
  # one, a macro (behind its length) and the records. b[0] ends the index,
  # b[] is a text that is no program.
  def mt_next(pos: integer, inside: integer, cur: integer, macro: bytes, records: bytes): bytes do
    nc_join(b[1,inside],Enum.concat(nc_u24(pos),nc_u24(cur+1)),Enum.concat(mx_pack(macro),records))
  end
  # macs and ix, late: the macros and the records so far; cur: the module's
  # number. Its call to itself is its whole value, so the index is a loop:
  # each declaration was a call inside the one before, three calls deep,
  # and a program of 33,000 functions nested deeper than calls may.
  def mt_index(work: bytes, cursor: bytes, macs: bytes, ix: bytes, late: bytes, cur: integer): bytes do
    found = mt_steps(work,cursor,4,16)
    pos = nc_cursor(found,0)
    step = if Enum.count(found) == 0 do b[] else if Enum.at(found,4,0) != 1 do b[0] else
      if Enum.at(found,3,0) == 0 do mt_module(work,pos,cur) else mt_declared(work,pos,macs,cur,ix,late) end
    end end
    size = nc_cursor(step,8)
    added = nc_slice(step,11+size,Enum.count(step))
    if Enum.count(step) == 0 do b[] else if Enum.at(step,0,0) == 0 do nc_join(mx_pack(macs),ix,late) else
      mt_index(work,mt_cursor(nc_cursor(step,2),Enum.at(step,1,0),0),if size == 0 do macs else Enum.concat(macs,nc_slice(step,11,11+size)) end,mt_kept(ix,late,added),mt_late(ix,late,added),nc_cursor(step,5)-1)
    end end
  end
  def mt_module(work: bytes, pos: integer, cur: integer): bytes do
    name = nc_start(work,nc_end(work,pos))
    body = nc_expect(work,nc_end(work,name),b[100,111])
    if nc_word(work,pos,b[100,101,102,109,111,100,117,108,101]) == 0 do b[0] else
      if body < 0 do b[] else if cur >= 65000 do b[] else
        mt_next(body,1,cur+1,b[],mx_record(1,cur+1,mx_three(name,nc_end(work,name),pos),b[]))
      end end
    end
  end
  def mt_declared(work: bytes, pos: integer, macs: bytes, cur: integer, ix: bytes, late: bytes): bytes do
    name = nc_start(work,nc_end(work,pos))
    if nc_word(work,pos,b[101,110,100]) == 1 do mt_next(nc_end(work,pos),0,cur,b[],b[]) else
      if nc_word(work,pos,b[100,101,102])+nc_word(work,pos,b[100,101,102,112]) == 1 do
        if name < 0 do b[] else if nc_end(work,name) < 0 do b[] else mt_defined(work,pos,cur) end end
      else
        if nc_word(work,pos,b[100,101,102,109,97,99,114,111]) == 1 do
          made = mt_macro(work,pos,cur)
          if Enum.count(made) == 0 do b[] else if mx_macro_in(work,mx_pack(macs),cur,name,0) >= 0 do b[] else
            mt_next(nc_cursor(made,0),1,cur,nc_slice(made,3,27),mx_record(7,cur,mx_two(pos,nc_cursor(made,0)),b[]))
          end end
        else mt_other(work,pos,ix,late,cur) end
      end
    end
  end
  # def name(parameters): a record for the function, and one for its
  # parameters, which are left as they are: a default value is a constant.
  def mt_defined(work: bytes, pos: integer, cur: integer): bytes do
    name = nc_start(work,nc_end(work,pos))
    stop = nc_end(work,name)
    close = if byte_at(work,nc_blank_end(work,stop)) != 40 do stop else np_close(work,stop,0,16777216) end
    if close < 0 do b[] else
      mt_next(close,1,cur,b[],Enum.concat(mx_record(3,cur,mx_two(name,stop),b[]),mx_record(10,cur,mx_two(pos,close),b[])))
    end
  end
  def mt_other(work: bytes, pos: integer, ix: bytes, late: bytes, cur: integer): bytes do
    name = nc_start(work,nc_end(work,pos))
    if mt_typed(work,pos) == 1 do
      stop = mt_block_end(work,pos,64)
      if stop < 0 do b[] else mt_next(stop,1,cur,b[],mx_record(10,cur,mx_two(pos,stop),b[])) end
    else mt_rest(work,pos,ix,late,cur) end
  end
  def mt_rest(work: bytes, pos: integer, ix: bytes, late: bytes, cur: integer): bytes do
    name = nc_start(work,nc_end(work,pos))
    if nc_word(work,pos,b[117,115,101]) == 1 do
      stop = if mx_upper(byte_at(work,name)) == 0 do nc_end(work,pos) else mt_use_end(work,nc_end(work,name)) end
      if stop < 0 do b[] else
        mt_next(stop,1,cur,b[],if mx_upper(byte_at(work,name)) == 0 do b[] else mx_record(4,cur,mx_three(pos,stop,name),b[]) end)
      end
    else
      made = if nc_word(work,pos,b[100,101,102,105,109,112,108]) == 1 do mp_impl(work,Enum.concat(ix,late),pos,cur) else mp_protocol(work,pos,cur) end
      if Enum.count(made) < 3 do b[] else mt_next(nc_cursor(made,0),1,cur,b[],nc_slice(made,3,Enum.count(made))) end
    end
  end
  # defmacro name(parameters) do quote do ... end end at pos: where it ends,
  # then its record.
  def mt_macro(work: bytes, pos: integer, cur: integer): bytes do
    name = nc_start(work,nc_end(work,pos))
    open = nc_expect(work,nc_end(work,name),b[40])
    shape = if open < 0 do b[] else mt_params(work,open) end
    quoted = nc_expect(work,nc_expect(work,if Enum.count(shape) == 0 do -1 else nc_cursor(shape,0) end,b[100,111]),b[113,117,111,116,101])
    body = nc_expect(work,quoted,b[100,111])
    stop = if body < 0 do -1 else nc_body_end(work,body,16777216) end
    after = if stop < 0 do -1 else nc_expect(work,nc_end(work,stop),b[101,110,100]) end
    using = nc_word(work,name,b[95,95,117,115,105,110,103,95,95])
    holds = nc_word(work,body,b[100,101,102])+nc_word(work,body,b[100,101,102,112])
    if mx_name(work,name) == 0 do b[] else if after < 0 do b[] else if using*(1-holds) == 1 do b[] else
      Enum.concat(nc_u24(after),nc_join(Enum.concat(nc_u16(cur),mx_three(name,nc_end(work,name),open)),mx_two(body,mx_last(work,body,stop,body)),Enum.concat(nc_slice(shape,3,9),b[using])))
    end end end
  end
  # The parameters from pos: where they end, then the name of the block
  # parameter (zeros for none).
  def mt_params(work: bytes, pos: integer): bytes do
    start = nc_start(work,pos)
    stop = nc_end(work,start)
    block = nc_start(work,stop+1)
    if nc_word(work,start,b[41]) == 1 do Enum.concat(nc_u24(stop),b[0,0,0,0,0,0]) else
      if mx_name(work,start) == 0 do b[] else
        if nc_word(work,start,b[100,111])*(if byte_at(work,stop) == 58 do 1 else 0 end) == 1 do
          if mx_name(work,block) == 0 do b[] else if nc_expect(work,nc_end(work,block),b[41]) < 0 do b[] else Enum.concat(nc_u24(nc_expect(work,nc_end(work,block),b[41])),mx_two(block,nc_end(work,block))) end end
        else
          if nc_word(work,stop,b[44]) == 1 do mt_params(work,nc_end(work,stop)) else
            if nc_word(work,stop,b[41]) == 0 do b[] else Enum.concat(nc_u24(nc_end(work,stop)),b[0,0,0,0,0,0]) end
          end
        end
