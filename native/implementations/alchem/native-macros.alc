  end
  # The parameters of fn(name: type, ...) at start.
  def mb_typed(work: bytes, start: integer): bytes do
    paren = nc_blank_end(work,nc_end(work,start))
    spans = if nc_word(work,paren+1,b[41]) == 1 do b[] else nc_list_collect(work,paren+1,b[],0,41) end
    if nc_pos(spans) < 0 do b[] else mb_typed_names(work,mx_narrow(nc_code(spans)),0) end
  end
  def mb_typed_names(work: bytes, spans: bytes, at: integer): bytes do
    name = nc_cursor(spans,at)
    if at >= Enum.count(spans) do b[] else
      if mx_name(work,name) == 0 do mb_typed_names(work,spans,at+6) else Enum.concat(mx_two(name,nc_end(work,name)),mb_typed_names(work,spans,at+6)) end
    end
  end

  # The index. A cursor: the position, the depth of blocks (0 outside a
  # module, 1 among its declarations) and 1 at a token of interest, 2 at the
  # end of the text.
  def mt_cursor(pos: integer, depth: integer, found: integer): bytes do Enum.concat(nc_u24(pos),b[depth,found]) end
  def mt_wanted(work: bytes, pos: integer, depth: integer): integer do
    value = byte_at(work,pos)
    if depth == 0 do 1 else if depth != 1 do 0 else if (value-100)*(value-117)*(value-101)*(value-115)*(value-116) != 0 do 0 else
      words = nc_word(work,pos,b[100,101,102])+nc_word(work,pos,b[100,101,102,112])+nc_word(work,pos,b[101,110,100])+nc_word(work,pos,b[117,115,101])+mt_typed(work,pos)
      if words+nc_word(work,pos,b[100,101,102,109,97,99,114,111])+nc_word(work,pos,b[100,101,102,112,114,111,116,111,99,111,108])+nc_word(work,pos,b[100,101,102,105,109,112,108]) > 0 do 1 else 0 end
    end end end
  end
  # 1 for the words that declare a type.
  def mt_typed(work: bytes, pos: integer): integer do
    nc_word(work,pos,b[115,116,114,117,99,116])+nc_word(work,pos,b[116,121,112,101])+nc_word(work,pos,b[100,101,102,101,120,99,101,112,116,105,111,110])
  end
  # Where the block ends that the first do from pos on opens, -1 for none
  # within budget tokens.
  def mt_block_end(work: bytes, pos: integer, budget: integer): integer do
    start = nc_start(work,pos)
    after = nc_end(work,start)
    if budget == 0 do -1 else if start < 0 do -1 else if after < 0 do -1 else if start >= Enum.count(work) do -1 else
      if nc_opens(work,start) == 0 do mt_block_end(work,after,budget-1) else
        if nc_body_end(work,after,16777216) < 0 do -1 else nc_end(work,nc_body_end(work,after,16777216)) end
      end
    end end end end
  end
  def mt_chunk(work: bytes, cursor: bytes, count: integer): bytes do
    pos = nc_start(work,nc_cursor(cursor,0))
    depth = Enum.at(cursor,3,0)
    after = nc_end(work,pos)
    if pos < 0 do b[] else if pos >= Enum.count(work) do mt_cursor(pos,depth,2) else
      if mt_wanted(work,pos,depth) == 1 do mt_cursor(pos,depth,1) else
        if count == 0 do mt_cursor(pos,depth,0) else
          if after < 0 do b[] else
            next = if nc_opens(work,pos)+nf_untyped(work,pos) > 0 do depth+1 else if nc_word(work,pos,b[101,110,100]) == 1 do depth-1 else depth end end
            if next > 200 do b[] else if next < 1 do b[] else mt_chunk(work,mt_cursor(after,next,0),count-1) end end
          end
        end
      end
    end end
