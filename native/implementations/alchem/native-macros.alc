  # use Module, name: value, ...: where it ends, from the end of the name.
  def mt_use_end(work: bytes, pos: integer): integer do
    name = nc_start(work,nc_end(work,pos))
    colon = nc_end(work,name)
    if pos < 0 do -1 else if nc_word(work,pos,b[44]) == 0 do pos else
      if mx_name(work,name) == 0 do -1 else if byte_at(work,colon) != 58 do -1 else mt_use_end(work,mt_value(work,colon+1,-1,0,16777216)) end end
    end end
  end
  # Where the value that starts at pos ends: at a comma, or where its line
  # ends outside brackets and blocks. last: the end of the token before.
  def mt_value(work: bytes, pos: integer, last: integer, depth: integer, budget: integer): integer do
    start = nc_start(work,pos)
    value = byte_at(work,start)
    after = nc_end(work,start)
    over = if last < 0 do 0 else if depth > 0 do 0 else if value == 44 do 1 else if mx_operator(byte_at(work,last-1)) == 1 do 0 else mx_ends(work,last,Enum.count(work)) end end end end
    opens = if (value-40)*(value-91)*(value-123) == 0 do 1 else if nc_opens(work,start)+nf_untyped(work,start) > 0 do 1 else 0 end end
    closes = if (value-41)*(value-93)*(value-125) == 0 do 1 else nc_word(work,start,b[101,110,100]) end
    if budget == 0 do -1 else if start < 0 do last else if start >= Enum.count(work) do last else if over == 1 do last else
      if after < 0 do -1 else if closes*(if depth == 0 do 1 else 0 end) == 1 do last else mt_value(work,after,after,depth+opens-closes,budget-1) end end
    end end end end
  end

  # The edits of a program, in the order of its records. state: where the
  # text not yet written starts, the module it is in and 1 when its code is
  # walked.
  # acc and late: the pieces so far, in two parts as the records of mt_index
  # are (mt_kept), so that they are not all copied for every record.
  def mx_edits(work: bytes, ix: bytes, at: integer, state: bytes, acc: bytes, late: bytes): bytes do
    base = mx_base(ix)+at*24
    kind = Enum.at(ix,base,0)
    if base >= Enum.count(ix) do mx_joined(Enum.concat(acc,late),mx_between(work,ix,state,mx_stop(work))) else
      if (kind-3)*(kind-5)*(kind-6) == 0 do mx_edits(work,ix,at+1,state,acc,late) else
        start = if kind == 1 do nc_cursor(ix,base+9) else nc_cursor(ix,base+3) end
        before = mx_between(work,ix,state,start)
        made = if kind == 1 do b[] else mx_edit(work,ix,base,nc_read(state,3)) end
        next = if kind == 1 do nc_join(nc_u24(start),nc_slice(ix,base+1,base+3),nc_slice(state,5,6)) else Enum.concat(nc_slice(ix,base+6,base+9),nc_slice(state,3,6)) end
        if Enum.count(before) == 1 do before else if Enum.count(made) == 1 do made else
          more = Enum.concat(before,made)
          mx_edits(work,ix,at+1,next,mt_kept(acc,late,more),mt_late(acc,late,more))
        end end
      end
    end
  end
  def mx_joined(acc: bytes, pieces: bytes): bytes do
    if Enum.count(pieces) == 1 do pieces else Enum.concat(acc,pieces) end
  end
  def mx_between(work: bytes, ix: bytes, state: bytes, stop: integer): bytes do
    from = nc_cursor(state,0)
    if stop <= from do b[] else
      if nc_read(state,3) == 65535 do mx_piece(0,from,stop,0,mx_none()) else
        if Enum.at(state,5,0) == 0 do mx_piece(0,from,stop,0,mx_none()) else mx_walk(work,ix,mx_plain_context(nc_read(state,3)),from,stop,1) end
      end
    end
  end
  def mx_edit(work: bytes, ix: bytes, base: integer, scope: integer): bytes do
    kind = Enum.at(ix,base,0)
    at = nc_cursor(ix,base+3)
    if kind == 4 do mx_use(work,ix,base,scope) else
      if kind == 8 do nc_join(mx_text5(b[127],at,mx_none()),mx_piece(1,nc_cursor(ix,base+9),nc_cursor(ix,base+12),at,mx_none()),mx_text5(Enum.concat(b[127],mp_digits(nc_cursor(ix,base+15))),at,mx_none())) else
        if kind == 9 do Enum.concat(mx_text5(b[58,32],at,mx_none()),mx_piece(1,nc_cursor(ix,base+9),nc_cursor(ix,base+12),at,mx_none())) else
          if kind == 10 do mx_piece(0,at,nc_cursor(ix,base+6),0,mx_none()) else b[] end
        end
      end
    end
  end
  # The __using__ macro of module owner.
  def mx_using(ix: bytes, owner: integer, at: integer): integer do
    base = 3+at*24
    if base >= mx_base(ix) do -1 else
      if nc_read(ix,base) == owner do if Enum.at(ix,base+23,0) == 1 do base else mx_using(ix,owner,at+1) end else mx_using(ix,owner,at+1) end
    end
  end
  # use Module, name: value: the functions of Module's __using__ template,
  # with each unquote(name) the value given.
  def mx_use(work: bytes, ix: bytes, base: integer, scope: integer): bytes do
    pos = nc_cursor(ix,base+3)
    named = nc_cursor(ix,base+9)
    owner = mx_module(work,ix,named)
    macro = if owner < 0 do -1 else mx_using(ix,owner,0) end
    params = mx_params(work,nc_cursor(ix,macro+8),b[])
    given = if macro < 0 do mx_fail() else mx_options(work,ix,mx_plain_context(scope),nc_end(work,named),params) end
    ctx = nc_join(mx_context(3,if owner < 0 do 0 else owner end,scope,0,0,pos),b[0,0,0,0,0,0],Enum.concat(mx_pack(given),b[0,0,0]))
    if macro < 0 do mx_fail() else if Enum.count(given) == 1 do mx_fail() else
      if mx_option_count(work,nc_end(work,named)) != nc_units(Enum.count(params),6) do mx_fail() else if mx_use_clash(work,ix,scope,nc_cursor(ix,macro+11),64) == 1 do mx_fail() else
        mx_walk(work,ix,ctx,nc_start(work,nc_cursor(ix,macro+11)),nc_cursor(ix,macro+14),1)
      end end
    end end
  end
  # 1 when a function of the template from pos on has the name of a
  # function the module defines itself.
  def mx_use_clash(work: bytes, ix: bytes, scope: integer, pos: integer, budget: integer): integer do
    start = nc_start(work,pos)
    name = nc_start(work,nc_end(work,start))
    after = mt_block_end(work,start,64)
    if budget == 0 do 0 else if nc_word(work,start,b[100,101,102])+nc_word(work,start,b[100,101,102,112]) == 0 do 0 else
      if mx_find(work,ix,Enum.concat(b[3,0],nc_u16(scope)),name,0,mx_count(ix)) >= 0 do 1 else if after < 0 do 0 else mx_use_clash(work,ix,scope,after,budget-1) end end
    end end
  end
  def mx_option_count(work: bytes, pos: integer): integer do
    if nc_word(work,pos,b[44]) == 0 do 0 else 1+mx_option_count(work,mt_value(work,nc_end(work,nc_start(work,nc_end(work,pos)))+1,-1,0,16777216)) end
  end
  def mx_param_has(work: bytes, params: bytes, name: integer, at: integer): integer do
    if at >= Enum.count(params) do 0 else
      if mx_same(work,nc_cursor(params,at),name,nc_cursor(params,at+3)-nc_cursor(params,at)) == 1 do 1 else mx_param_has(work,params,name,at+6) end
    end
  end
  # The options from pos as the arguments of a context.
  def mx_options(work: bytes, ix: bytes, ctx: bytes, pos: integer, params: bytes): bytes do
    name = nc_start(work,nc_end(work,pos))
    first = nc_start(work,nc_end(work,name)+1)
    stop = mt_value(work,first,-1,0,16777216)
    pieces = if nc_word(work,pos,b[44]) == 0 do b[] else if stop < 0 do mx_fail() else mx_walk(work,ix,ctx,first,stop,0) end end
    rest = if nc_word(work,pos,b[44]) == 0 do b[] else if Enum.count(pieces) == 1 do mx_fail() else mx_options(work,ix,ctx,stop,params) end end
    if nc_word(work,pos,b[44]) == 0 do b[] else if Enum.count(rest) == 1 do rest else if mx_param_has(work,params,name,0) == 0 do mx_fail() else
      nc_join(Enum.concat(mx_two(name,nc_end(work,name)),b[mx_atomic(work,first,stop)]),mx_pack(pieces),rest)
    end end end
  end

  # The text of the pieces from first up to stop, and their length.
  def mx_text(work: bytes, pieces: bytes, first: integer, stop: integer): bytes do
    base = first*13
    if stop-first <= 0 do b[] else
      if stop-first == 1 do
        if (Enum.at(pieces,base,0)-2)*(Enum.at(pieces,base,0)-6) == 0 do nc_slice(pieces,base+2,base+2+Enum.at(pieces,base+1,0)) else nc_slice(work,nc_cursor(pieces,base+1),nc_cursor(pieces,base+4)) end
      else
        middle = first+nc_half(stop-first)
        Enum.concat(mx_text(work,pieces,first,middle),mx_text(work,pieces,middle,stop))
      end
    end
  end
  def mx_size(pieces: bytes, first: integer, stop: integer): integer do
    base = first*13
    if stop-first <= 0 do 0 else
      if stop-first == 1 do
        if (Enum.at(pieces,base,0)-2)*(Enum.at(pieces,base,0)-6) == 0 do Enum.at(pieces,base+1,0) else nc_cursor(pieces,base+4)-nc_cursor(pieces,base+1) end
      else
        middle = first+nc_half(stop-first)
        mx_size(pieces,first,middle)+mx_size(pieces,middle,stop)
      end
    end
  end
  # The moved records of the pieces: where each starts in the rewritten
  # text, the place it stands for (with bit 31 one place for all of it) and
  # the place whose file it is shown in (all ones for its own). A piece that
  # goes on where the one before it stopped needs none.
  def mx_moved(pieces: bytes, first: integer, stop: integer, offset: integer): bytes do
    if stop-first <= 0 do b[] else
      if stop-first == 1 do mx_moved_one(pieces,first*13,offset) else
        middle = first+nc_half(stop-first)
        Enum.concat(mx_moved(pieces,first,middle,offset),mx_moved(pieces,middle,stop,offset+mx_size(pieces,first,middle)))
      end
    end
  end
  # How a piece stands: 0 where it stood, 1 for one place, 2 anchored at a
  # place with its column counted from there, 3 anchored for one place.
  def mx_standing(flag: integer): integer do
    if flag == 0 do 0 else if flag <= 2 do 1 else if flag == 4 do 2 else 3 end end end
  end
  def mx_moved_one(pieces: bytes, base: integer, offset: integer): bytes do
    flag = Enum.at(pieces,base,0)
    kind = mx_standing(flag)
    before = if base == 0 do 9 else mx_standing(Enum.at(pieces,base-13,0)) end
    file = nc_cursor(pieces,base+10)
    place = if flag == 0 do nc_cursor(pieces,base+1) else nc_cursor(pieces,base+7) end
    last = if before == 0 do nc_cursor(pieces,base-9) else nc_cursor(pieces,base-6) end
    # An anchored piece goes on when the one before it ends where it starts,
    # in the text and in its column.
    column = if kind != 2 do file else if nc_cursor(pieces,base-9) != nc_cursor(pieces,base+1) do -1 else file-nc_cursor(pieces,base-9)+nc_cursor(pieces,base-12) end end
    alike = if before != kind do 0 else if column != nc_cursor(pieces,base-3) do 0 else if place == last do 1 else 0 end end end
    if alike == 1 do b[] else
      nc_join(nc_u32(offset),Enum.concat(nc_u24(place),b[if kind == 0 do 0 else if kind == 1 do 128 else if kind == 2 do 64 else 192 end end end]),Enum.concat(if kind >= 2 do b[255,255,255,255] else if file == mx_none() do b[255,255,255,255] else nc_u32(file) end end,nc_u32(if kind >= 2 do file else 0 end)))
    end
  end
  # 1 when the program may hold a macro, a protocol or a template; a
  # compiler entry holds none.
  def mx_wanted(given: bytes): integer do
    size = Enum.count(given)
    if ny_has(given,0,size,b[110,97,116,105,118,101,95,99,111,109,112,105,108,101]) == 1 do 0 else
      if mx_raw(given,0,size,b[100,101,102,109,97,99,114,111])+mx_raw(given,0,size,b[100,101,102,105,109,112,108])+mx_raw(given,0,size,b[100,101,102,112,114,111,116,111,99,111,108]) > 0 do 1 else
        if mx_raw(given,0,size,b[126,104])+mx_raw(given,0,size,b[126,72])+mx_raw(given,0,size,b[127]) > 0 do 1 else mx_clausal_any(given,0,size) end
      end
    end
  end
  # 1 when some fn of the text has its clauses on the lines after it.
  def mx_clausal_any(given: bytes, first: integer, stop: integer): integer do
    if stop-first > 64 do
      if mx_clausal_any(given,first,first+nc_half(stop-first)) == 1 do 1 else mx_clausal_any(given,first+nc_half(stop-first),stop) end
    else mx_clausal_run(given,first,stop) end
  end
  def mx_clausal_run(given: bytes, pos: integer, stop: integer): integer do
    if pos >= stop do 0 else if byte_at(given,pos) != 102 do mx_clausal_run(given,pos+1,stop) else if mx_clausal(given,pos) == 1 do 1 else mx_clausal_run(given,pos+1,stop) end end end
  end
  # Byte 127 continues the names the compiler makes (those of a template's
  # bindings and of the functions of a defimpl); no name of the program may
  # hold it. The next position, -1 for such a name, -2 at the end.
  def mx_tainted_chunk(work: bytes, pos: integer, count: integer): integer do
    start = nc_start(work,pos)
    stop = nc_end(work,start)
    if start < 0 do -2 else if start >= Enum.count(work) do -2 else if stop < 0 do -2 else
      if classify_ascii(byte_at(work,start)) == 2 do
        if mx_raw(work,start,stop,b[127]) == 1 do -1 else if count == 0 do stop else mx_tainted_chunk(work,stop,count-1) end end
      else if count == 0 do stop else mx_tainted_chunk(work,stop,count-1) end end
    end end end
  end
  def mx_tainted(work: bytes, pos: integer): integer do
    next = mx_tainted_chunk(work,pos,64)
    if next == -1 do 1 else if next < 0 do 0 else mx_tainted(work,next) end end
  end
  # 1 when the records hold an edit from at on.
  def mx_edited(ix: bytes, first: integer, stop: integer): integer do
    middle = first+nc_half(stop-first)
    kind = Enum.at(ix,mx_base(ix)+first*24,0)
    if stop-first <= 0 do 0 else
      if stop-first == 1 do if (kind-1)*(kind-3)*(kind-5)*(kind-6)*(kind-10) == 0 do 0 else 1 end else
        if mx_edited(ix,first,middle) == 1 do 1 else mx_edited(ix,middle,stop) end
      end
    end
  end
  # A macro may not share its name with a function of its module.
  def mx_clash(work: bytes, ix: bytes, at: integer): integer do
    base = 3+at*24
    if base >= mx_base(ix) do 0 else
      if mx_find(work,ix,Enum.concat(b[3,0],nc_slice(ix,base,base+2)),nc_cursor(ix,base+2),0,mx_count(ix)) >= 0 do 1 else mx_clash(work,ix,at+1) end
    end
  end
  # The program as it is compiled: b[0] as it is, b[] for one that cannot be
  # compiled, or 1, the length of the rewritten text, the text and its tail.
  def mx_prepare(given: bytes): bytes do
    if mx_wanted(given) == 0 do b[0] else mx_indexed(given,mt_index(given,mt_cursor(0,0,0),b[],b[],b[],-1)) end
  end
  def mx_indexed(given: bytes, ix: bytes): bytes do
    if Enum.count(ix) < 3 do b[] else mx_planned(given,ix) end
  end
  def mx_planned(given: bytes, ix: bytes): bytes do
    templated = if mx_raw(given,0,Enum.count(given),b[126,104])+mx_raw(given,0,Enum.count(given),b[126,72]) > 0 do mh_wanted() else 0 end
    walked = if mx_base(ix) > 3 do 1 else if templated > 0 do 1 else if mp_any(ix,0,mx_count(ix)) == 1 do 1 else mx_clausal_any(given,0,Enum.count(given)) end end end
    # A test file comes with names of the compiler's own (native-testing.alc),
    # which stand after its first byte 127; it was looked at before.
    tainted = if mx_raw(given,0,Enum.count(given),b[127]) == 0 do 0 else if mx_raw(given,0,Enum.count(given),b[65,108,99,104,127,109,127,84]) == 1 do 0 else mx_tainted(given,0) end end
    if tainted == 1 do b[] else
      if walked+mx_edited(ix,0,mx_count(ix)) == 0 do b[0] else
        if mx_clash(given,ix,0)+mp_wrong(given,ix) > 0 do b[] else mx_made(given,mx_edits(given,ix,0,Enum.concat(b[0,0,0,255,255],b[walked]),b[],b[])) end
      end
    end
  end
  def mx_made(given: bytes, pieces: bytes): bytes do
    count = nc_units(Enum.count(pieces),13)
    code = mx_text(given,pieces,0,count)
    moved = mx_moved(pieces,0,count,0)
    lines = nz_marks(given,0,Enum.count(given),10,10)
    files = nz_files(given)
    inside = nz_marks(given,0,Enum.count(given),128,191)
    sizes = nc_join(Enum.concat(nc_u32(Enum.count(moved)),nc_u32(Enum.count(lines))),Enum.concat(nc_u32(Enum.count(files)),nc_u32(Enum.count(inside))),b[0,77,88,0])
    if Enum.count(pieces) == 1 do b[] else if Enum.count(code) > nc_limit() do b[] else
      nc_join(Enum.concat(b[1],nc_u24(Enum.count(code))),code,nc_join(nc_join(b[10,0],moved,lines),Enum.concat(files,inside),sizes))
    end end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
