    block = if Enum.at(shape,21,0) == 0 do b[] else mx_walk(work,ix,ctx,nc_start(work,nc_cursor(shape,12)),nc_cursor(shape,15),1) end
    t = if Enum.at(ctx,0,0) == 1 do nc_cursor(ctx,5) else pos end
    head = mx_context(1,nc_read(ix,macro),nc_read(ctx,3),t,Enum.at(ctx,8,0)+1,nc_cursor(ctx,9))
    suffix = Enum.concat(mx_sec_data(ctx,0),mx_text5(Enum.concat(b[127],mx_code4(pos)),t,nc_cursor(ctx,9)))
    first = nc_start(work,nc_cursor(ix,macro+11))
    bound = mb_names(work,first,nc_cursor(ix,macro+14))
    held = if Enum.at(shape,21,0) == 0 do b[] else Enum.concat(nc_slice(ix,macro+17,macro+23),block) end
    inner = nc_join(nc_join(head,mx_pack(suffix),mx_pack(bound)),mx_pack(given),mx_pack(held))
    if Enum.count(given) == 1 do b[] else if Enum.count(block) == 1 do b[] else
      body = mx_walk(work,ix,inner,first,nc_cursor(ix,macro+14),1)
      after = nc_cursor(shape,18)
      bare = Enum.at(state,12,0)*(if Enum.count(piped) == 0 do mx_starts(work,state) else Enum.at(piped,1,0) end)*mx_ends(work,after,nc_cursor(state,6))
      if Enum.count(body) == 1 do b[] else
        mx_done(state,after,after,Enum.concat(mx_run(ctx,nc_cursor(state,9),pos),mx_wrapped(ctx,body,pos,bare)))
      end
    end end
  end

  # The names a template binds, six bytes each: what stands before = and <-,
  # the patterns before ->, and the parameters of fn. marks: where the
  # statement or arm starts, where the pattern starts, the token before
  # (3 bytes each), the depth of brackets from 100 and the depth the pattern
  # started at.
  def mb_names(work: bytes, first: integer, stop: integer): bytes do
    mb_walk(work,first,stop,mb_marks(first,first,mx_none(),100,100),b[])
  end
  def mb_marks(statement: integer, pattern: integer, prev: integer, depth: integer, level: integer): bytes do
    nc_join(nc_u24(statement),nc_u24(pattern),Enum.concat(nc_u24(prev),b[depth,level]))
  end
  def mb_walk(work: bytes, pos: integer, stop: integer, marks: bytes, acc: bytes): bytes do
    start = nc_start(work,pos)
    if start < 0 do acc else if start >= stop do acc else if nc_end(work,start) < 0 do acc else
      mb_token(work,start,stop,mb_fresh(work,start,marks),acc)
    end end end
  end
  # A token on a new line outside brackets starts a statement.
  def mb_fresh(work: bytes, start: integer, marks: bytes): bytes do
    prev = nc_cursor(marks,6)
    if prev == mx_none() do marks else
      if nz_line_end(work,nc_end(work,prev)) >= start do marks else
        if Enum.at(marks,9,0) != 100 do marks else Enum.concat(mb_marks(start,start,prev,100,100),nc_slice(marks,11,Enum.count(marks))) end
      end
    end
  end
  # 1 ->, 2 <-, 3 =, 4 a comma, 5 an opening bracket, 6 a closing one, 7 a
  # word a pattern may follow, 8 fn(, 0 anything else.
  def mb_kind(work: bytes, start: integer): integer do
    value = byte_at(work,start)
    size = nc_end(work,start)-start
    pair = value*256+byte_at(work,start+1)
    words = nc_word(work,start,b[100,111])+nc_word(work,start,b[101,108,115,101])+nc_word(work,start,b[102,111,114])+nc_word(work,start,b[119,105,116,104])
    if size == 2 do if pair == 11582 do 1 else if pair == 15405 do 2 else if nc_word(work,start,b[102,110]) == 1 do if mx_called(work,start+2) == 1 do 8 else 7 end else words*7 end end end else
      if size == 1 do
        if value == 61 do 3 else if value == 44 do 4 else if (value-40)*(value-91)*(value-123) == 0 do 5 else if (value-41)*(value-93)*(value-125) == 0 do 6 else 0 end end end end
      else words*7 end
    end
  end
  # The blocks open at a token, a byte each after the marks: 2 for the block
  # of a cond, whose arms start with conditions, not patterns.
  def mb_blocks(work: bytes, start: integer, marks: bytes): bytes do
    held = nc_slice(marks,11,Enum.count(marks))
    prev = nc_cursor(marks,6)
    if nc_opens(work,start) == 1 do Enum.concat(held,b[if prev == mx_none() do 1 else 1+nc_word(work,prev,b[99,111,110,100]) end]) else
      if nf_untyped(work,start) == 1 do Enum.concat(held,b[1]) else
        if nc_word(work,start,b[101,110,100]) == 1 do nc_slice(held,0,Enum.count(held)-1) else held end
      end
    end
  end
  def mb_token(work: bytes, start: integer, stop: integer, marks: bytes, acc: bytes): bytes do
    kind = mb_kind(work,start)
    after = nc_end(work,start)
    depth = Enum.at(marks,9,0)
    level = Enum.at(marks,10,0)
    statement = nc_cursor(marks,0)
    pattern = nc_cursor(marks,3)
    arms = if Enum.at(marks,Enum.count(marks)-1,0) == 2 do if Enum.count(marks) > 11 do 0 else 1 end else 1 end
    gained = if kind == 1 do if arms == 1 do mb_region(work,statement,start,0) else b[] end else if kind == 2 do mb_region(work,pattern,start,0) else if kind == 3 do if depth == level do mb_region(work,pattern,start,0) else b[] end else if kind == 8 do mb_typed(work,start) else b[] end end end end
    next = if (kind-1)*(kind-7)*(kind-8) == 0 do mb_marks(after,after,start,depth,depth) else
      if kind == 4 do mb_marks(statement,if depth == level do after else pattern end,start,depth,level) else
        if kind == 5 do mb_marks(statement,pattern,start,depth+1,level) else if kind == 6 do mb_marks(statement,pattern,start,depth-1,level) else mb_marks(statement,pattern,start,depth,level) end end
      end
    end
    inside = if byte_at(work,start) != 34 do b[] else mb_holes(work,start+1,after) end
    mb_walk(work,after,stop,Enum.concat(next,mb_blocks(work,start,marks)),if Enum.count(gained)+Enum.count(inside) == 0 do acc else nc_join(acc,gained,inside) end)
  end
  # The names bound in the code of the values a string holds.
  def mb_holes(work: bytes, pos: integer, stop: integer): bytes do
    hole = mx_hole_at(work,pos,stop)
    close = if hole >= stop do stop else np_close(work,hole+2,1,100000)-1 end
    if hole >= stop do b[] else if close < hole+2 do b[] else Enum.concat(mb_names(work,hole+2,close),mb_holes(work,close+1,stop)) end end
  end
  def mb_keyword(work: bytes, start: integer): integer do
    first = nc_word(work,start,b[116,114,117,101])+nc_word(work,start,b[102,97,108,115,101])+nc_word(work,start,b[110,105,108])+nc_word(work,start,b[110,111,110,101])+nc_word(work,start,b[95])
    second = nc_word(work,start,b[97,110,100])+nc_word(work,start,b[111,114])+nc_word(work,start,b[110,111,116])+nc_word(work,start,b[105,110])+nc_word(work,start,b[100,111])+nc_word(work,start,b[101,110,100])+nc_word(work,start,b[102,110])
    if first+second > 0 do 1 else 0 end
  end
  # The names of a pattern from pos up to stop; a guard is no part of it.
  def mb_region(work: bytes, pos: integer, stop: integer, depth: integer): bytes do
    start = nc_start(work,pos)
    value = byte_at(work,start)
    after = nc_end(work,start)
    before = byte_at(work,start-1)
    typed = if byte_at(work,after) != 58 do 0 else if byte_at(work,after+1) == 58 do 0 else 1 end end
    barred = if (before-46)*(before-58)*(before-94)*(before-38) == 0 do 1 else mx_called(work,after)+mx_upper(value)+mb_keyword(work,start) end
    if start < 0 do b[] else if start >= stop do b[] else if after < 0 do b[] else if nc_word(work,start,b[119,104,101,110]) == 1 do b[] else
      if (value-40)*(value-91)*(value-123) == 0 do mb_region(work,after,stop,depth+1) else if (value-41)*(value-93)*(value-125) == 0 do mb_region(work,after,stop,depth-1) else
        if classify_ascii(value) != 2 do mb_region(work,after,stop,depth) else
          if barred > 0 do mb_region(work,after,stop,depth) else
            if typed == 0 do Enum.concat(mx_two(start,after),mb_region(work,after,stop,depth)) else
              if depth == 0 do mx_two(start,after) else mb_region(work,after,stop,depth) end
