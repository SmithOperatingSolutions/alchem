defmodule NativeTail do
  # Tail calls (spec/alchem-tail-calls.md). A function's call to itself that
  # is the whole value it returns runs as a loop, as in the pinned compiler:
  # the arguments are evaluated, the frame is left and the function is
  # entered again by a jump, so the call takes no stack and is not one more
  # active call. Entering again stores the parameters and resets the frame
  # (statement position, closure records) as any entry does.
  #
  # The statement asks for it: where a block's last expression or the value
  # of a return is the function's result and is, by its text, one call (in
  # parentheses or not, or the last call of a pipeline), the statement is
  # compiled once more with the end of that call noted in the environment,
  # under a record with no name whose type is tag 45 and the position. The
  # call that ends there (nj_call, nu_call_finish) jumps when it is a call
  # of the function it stands in.
  def tl_mark(env: bytes, close: integer): bytes do nc_env_note(env,45,close) end
  # The end noted last, -1 when none is.
  def tl_noted(env: bytes, offset: integer, found: integer): integer do
    if offset >= Enum.count(env) do found else
      tl_noted(env,nc_env_next(env,offset),if nc_env_tag(env,offset) == 45 do nc_env_noted(env,offset) else found end)
    end
  end
  # 1 when the call of function target whose arguments end at close is to jump.
  def tl_at(env: bytes, close: integer, target: integer): integer do
    if target != nc_cursor(env,0) do 0 else if tl_noted(env,3,-1) == close do 1 else 0 end end
  end
  # After count pushed arguments: they take the place of the parameters (the
  # first six in their registers; with more than six all of them where the
  # caller left the ones this activation was entered with), the call is no
  # longer active (when it counted as one), the frame is left and the function
  # entered again.
  def tl_jump(count: integer, target: integer, counted: integer): bytes do
    again = nc_join(if counted == 1 do b[73,255,207,201,65,187] else b[201,65,187] end,nc_u32(4195456+target*8),b[65,255,35])
    if count > 6 do nc_join(Enum.concat(b[72,137,230,72,141,125,16,185],nc_u32(count)),b[252,243,72,165],Enum.concat(nc_load_args(count),again)) else Enum.concat(nc_pop_args(count),again) end
  end
  # The code of a call whose arguments end at close: a jump when it is noted
  # as the function's result.
  def tl_passed(source: bytes, env: bytes, table: bytes, close: integer, count: integer, target: integer): bytes do
    if tl_at(env,close,target) == 1 do Enum.concat(gm_deferred(env,count),tl_jump(count,target,1-od_library(source,table,target))) else nc_passed(count,nc_call(target)) end
  end
  # 1 when data ends in the bytes wanted.
  def tl_ends(data: bytes, wanted: bytes): integer do
    if Enum.count(data) < Enum.count(wanted) do 0 else nc_word_at(data,Enum.count(data)-Enum.count(wanted),wanted,0) end
  end
  # The arguments a call of function id passes: its parameters and the
  # comparators of its type variables.
  def tl_count(source: bytes, table: bytes, id: integer): integer do
    nc_argc(table,id)+nu_name_count(nu_signature(source,table,id),0)
  end
  # 1 when the function the environment is of may loop, where a statement's
  # value is the function's: it is not main, takes a parameter and has no
  # type variable (the library written in Alchem, which the pinned compiler
  # has in Go, may have them), and the statement stands in no fn, for, try
  # or form used as a value.
  def tl_allowed(source: bytes, env: bytes, table: bytes): integer do
    id = nc_cursor(env,0)
    if Enum.at(table,id*40+21,0) == 1 do 0 else if nc_argc(table,id) == 0 do 0 else if Enum.count(nj_context(env,3,b[])) > 0 do 0 else
      if nn_library(source,env,table) == 1 do 1 else if nu_name_count(nu_signature(source,table,id),0) > 0 do 0 else 1 end end
    end end end
  end
  # From pos, the "(" at the outer level whose ")" stands at close.
  def tl_step(source: bytes, pos: integer, close: integer): bytes do
    start = nc_start(source,pos)
    after = if byte_at(source,start) == 40 do np_close(source,start,0,16777216) else nc_end(source,start) end
    if start < 0 do nk_state(0,0,0) else if start >= close do nk_state(0,0,0) else if after <= start do nk_state(0,0,0) else
      if byte_at(source,start) != 40 do nk_state(after,0,2) else if after-1 == close do nk_state(start,0,1) else nk_state(after,0,2) end end
    end end end
  end
  def tl_run(source: bytes, state: bytes, size: integer, close: integer): bytes do
    half = nc_half(size)
    if Enum.at(state,6,0) != 2 do state else
      if size == 1 do tl_step(source,nc_long(state,0),close) else tl_run(source,tl_run(source,state,half,close),size-half,close) end
    end
  end
  def tl_open(source: bytes, start: integer, close: integer): integer do
    state = tl_run(source,nk_state(start,0,2),16777216,close)
    if Enum.at(state,6,0) == 1 do nc_long(state,0) else -1 end
  end
  # The expression from start to the ")" at close, once the parentheses
  # around the whole of it are taken off: where it then starts and its last
  # ")" (3 bytes each), when it is one call that ends there: a name and its
  # arguments, or anything piped into such a call. Nothing otherwise. A pipe
  # binds looser than every operator the expression is then read with
  # (nc_math), so the call is its value.
  def tl_target(source: bytes, start: integer, close: integer, budget: integer): bytes do
    open = tl_open(source,start,close)
    name = if open < 0 do -1 else nj_back(source,nz_before(source,open-1)+1) end
    before = nz_before(source,name-1)
    inner = nz_before(source,close-1)
    if open < 0 do b[] else if budget == 0 do b[] else
      if open == start do if byte_at(source,inner) != 41 do b[] else tl_target(source,nc_start(source,start+1),inner,budget-1) end else
        if name == start do Enum.concat(nc_u32(start),nc_u32(close)) else if byte_at(source,before)*256+byte_at(source,before-1) == 15996 do Enum.concat(nc_u32(start),nc_u32(close)) else b[] end end
      end
    end end
  end
  # 1 when value, what a statement's expression compiles to, ends in a call
  # of the function itself where that function may loop.
  def tl_wanted(source: bytes, env: bytes, table: bytes, value: bytes): integer do
    id = nc_cursor(env,0)
    last = Enum.count(value)
    wide = if Enum.at(value,last-8,0)*256+Enum.at(value,last-7,0) == 18573 do 8 else 0 end
    shape = if last-wide < 14 do 0 else if Enum.at(value,last-wide-1,0) != 19 do 0 else nc_word_at(value,last-wide-9,nc_call(id),0) end end
    if nc_pos(value) < 0 do 0 else if shape == 0 do 0 else if tl_allowed(source,env,table) == 0 do 0 else
      tl_ends(tl_unplaced(value,last-wide),nc_passed(tl_count(source,table,id),nc_call(id)))
    end end end
  end
  # A call of a library function by its module's name (Process._drop(...),
  # as the library's own modules call themselves) has the store of where it
  # stands (nh_placed: ten bytes) between its arguments and the call that
  # ends at stop. Without that store it is the call tl_wanted looks for, so
  # such a function's call to itself is a jump as well, and a loop of the
  # library takes no stack (it took 176 bytes a turn: a task that ended
  # went as deep as the list of its parent's links was long).
  def tl_unplaced(value: bytes, stop: integer): bytes do
    if stop < 23 do value else if nc_word_at(value,stop-19,b[199,133,104,255,255,255],0) == 0 do value else
      Enum.concat(nc_slice(value,0,stop-19),nc_slice(value,stop-9,Enum.count(value)))
    end end
  end
  # The value of return expression, the expression at start: with a call of
  # the function itself that is the whole expression as a jump.
  def tl_return(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, value: bytes): bytes do
    if tl_wanted(source,env,table,value) == 0 do value else tl_made(source,start,env,table,depth,value) end
  end
  # The same for the expression a block ends in, when the block's value is
  # the function's: no statement follows the forms the block stands in.
  def tl_value(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, value: bytes): bytes do
    if tl_wanted(source,env,table,value) == 0 do gm_valued(source,start,env,table,depth,value) else if wf_dropped(source,nc_pos(value),env,table) == 1 do value else tl_made(source,start,env,table,depth,value) end end
  end
  def tl_made(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, value: bytes): bytes do
    id = nc_cursor(env,0)
    last = nz_before(source,nc_pos(value)-1)
    inner = if byte_at(source,last) != 41 do b[] else tl_target(source,nc_start(source,start),last,200) end
    close = nc_long(inner,4)
    again = if Enum.count(inner) == 0 do b[] else nc_math(source,nc_long(inner,0),tl_mark(gm_handing(source,env,nc_long(inner,0),close),close+1),table,depth) end
    fits = if nc_pos(again) < 0 do 0 else if nz_before(source,nc_pos(again)-1) != close do 0 else tl_ends(again,tl_jump(tl_count(source,table,id),id,1-od_library(source,table,id))) end end
    if fits == 0 do value else Enum.concat(nc_slice(value,0,nt_after(value,4)),nc_code(again)) end
  end
  # The library written in Alchem is Go in the pinned compiler, where its
  # loops and searches are no calls of the program. Its functions and their
  # fns are therefore not active calls: they are entered and left without
  # R15 being touched, so the program's own calls nest as deep through them
  # as in the pinned runtime, and a search that goes a call down per step
  # (the regex matcher) is held to the stack's limit alone.
  # The entry of function id, and the way out of it.
  def tl_enter(source: bytes, table: bytes, id: integer): bytes do
    body = nc_start(source,nc_meta(table,id,9))
    if od_library(source,table,id) == 0 do nz_enter(table,0,nc_meta(table,id,0),body) else Enum.concat(b[72,199,133,112,255,255,255,0,0,0,0],nz_set(body)) end
  end
  def tl_leave(source: bytes, table: bytes, id: integer): bytes do
    if od_library(source,table,id) == 0 do b[73,255,207,201,195] else b[201,195] end
  end
  # The entry of a fn that starts at pos, and what its body ends in: a fn
  # is left by code that counts the call down (nf_code), which a fn of the
  # library makes up for.
  def tl_fn_enter(source: bytes, env: bytes, table: bytes, pos: integer): bytes do
    if nn_library(source,env,table) == 0 do nz_enter(table,1,pos,pos) else Enum.concat(b[72,199,133,112,255,255,255,1,0,0,0],nz_set(pos)) end
  end
  def tl_fn_leave(source: bytes, env: bytes, table: bytes): bytes do
    if nn_library(source,env,table) == 0 do b[] else b[73,255,199] end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
