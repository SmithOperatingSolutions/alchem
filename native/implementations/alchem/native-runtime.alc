  def nc_io_part3(): bytes do
    b[84,73,77,69,95,73,79,58,32,111,117,116,112,117,116,32,119,114,105,116,101,32,102,97,105,108,101,100,10]
  end
  def nc_io_suffix(): bytes do
    nc_join(nc_io_part0(),nc_io_part1(),Enum.concat(nc_io_part2(),nc_io_part3()))
  end
  # The stack of every program is its own mapping, reserved lazily: 1 GiB, or
  # the largest half of that the system grants down to 1 MiB (exit 71 below).
  # Its limit, 64 KiB above its lowest byte, is kept just below the initial
  # stack pointer in R14; R15 counts active calls and RBP starts at 0. The
  # word below the limit is the innermost handler of a try, 0 for none.
  # Its last instruction starts the collector (gm_start, native-memory.alc).
  def nc_stack_init(): bytes do
    b[65,191,0,0,0,64,184,9,0,0,0,49,255,76,137,254,186,3,0,0,0,65,186,34,64,0,0,73,199,192,255,255,255,255,69,49,201,15,5,72,61,1,240,255,255,114,24,73,209,239,73,129,255,0,0,16,0,115,203,191,71,0,0,0,184,60,0,0,0,15,5,74,141,36,56,72,5,0,0,1,0,73,137,70,248,69,49,255,49,237,73,137,110,240,255,20,37,96,4,64,0]
  end
  # Every function and lambda starts by checking the stack against its limit
  # (exit 70 past it), then makes its frame: sixteen slots, the position of
  # the statement it is running at RBP-136 and its closure records at RBP-144.
  def nc_guard(body: bytes): bytes do
    peak = nc_peak(body,0,Enum.count(body))
    size = if peak <= 160 do 160 else nc_units(peak+15,16)*16 end
    # A frame that the 64 KiB below the limit might not hold is checked whole.
    check = if size <= 16384 do b[73,59,102,248,115,12] else nc_join(Enum.concat(b[76,141,156,36],nq_rel(0-size)),b[77,59,94,248],b[115,12]) end
    nc_join(check,b[191,70,0,0,0,184,60,0,0,0,15,5,85,72,137,229,72,129,236],nc_u32(size))
  end
  # Leave the program with the status in RAX; one outside 0..255 exits 70.
  def nc_exit_status(): bytes do
    b[72,61,255,0,0,0,118,12,191,70,0,0,0,184,60,0,0,0,15,5,72,137,199,184,60,0,0,0,15,5]
  end
  # A compiler entry collects as any program does. On ARM64 its input and
  # output, with the call of native_compile, are the function at io
  # (nc_io_function), their messages marked as data, and the entry calls it.
  def nc_entry_compiler(id: integer, io: integer): bytes do
    if nc_arm() == 1 do a_entry(nc_call(io)) else nc_entry_compiler_x86(id) end
  end
  def nc_io_function(source: bytes, table: bytes): bytes do
    index = nc_native_index(source,table,0,nc_records(Enum.count(table)))
    if index < 0 do b[] else nc_join(nc_io_prefix_marked(),nc_call(index),nc_io_suffix_marked()) end
  end
  def nc_entry_compiler_x86(id: integer): bytes do
    io_code = nc_join(nc_io_prefix(),nc_call(id),nc_io_suffix())
    code = nc_join(b[73,137,230],Enum.concat(nc_arena_init(),nc_stack_init()),io_code)
    Enum.concat(code,nc_zeros(1024-Enum.count(code)))
  end
  # Native smoke test; runtime emitters are assembled with the source compiler.
  def main() do System.halt(0) end
end
