    maps = nc_join(nc_join(gm_word(address+gm_off(30)),gm_word(address+gm_off(35)),gm_word(address+gm_off(40))),nc_join(gm_word(address+gm_off(45)),gm_word(address+gm_off(50)),gm_word(address+gm_off(55))),b[])
    words = nc_join(Enum.concat(gm_word(address+gm_off(20)),gm_word(address+gm_off(start))),Enum.concat(gm_word(address+gm_off(10)),gm_word(address+gm_off(5))),gm_word(address))
