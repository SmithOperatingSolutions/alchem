  #
  # A frame's slots are roots for as long as the frame stands. In a
  # function that calls itself the frames of the calls stand one on the
  # other, and each would keep what its bindings held long after their last
  # read. Such a function is noted (52, gm_params), and behind a statement
  # of it that has no block of its own, the slot of every binding the
  # statement names and nothing behind it names again is set to 0: a
  # binding of the function, or inside a fn, a for or a form used as a
  # value one that was made there (what was made outside is read again by
  # the next turn or the next call). Only where the function's end is
  # within 1,500 bytes, so that looking for the names stays cheap.
  def gm_cleared(source: bytes, table: bytes, env: bytes, start: integer, stop: integer): bytes do
    id = nc_cursor(env,0)
    last = nc_meta(table,id,12)
    if gm_any(env,3,52) == 0 do b[] else if stop <= start do b[] else if start < nc_meta(table,id,9) do b[] else if stop > last do b[] else if last-stop > 1500 do b[] else
      if ny_has(source,start,stop,b[45,62])+gm_worded(source,start,stop,b[100,111])+gm_worded(source,start,stop,b[102,110]) > 0 do b[] else
        gm_cleared_from(source,env,gm_region(env,3,3),nc_join(nc_u32(start),nc_u32(stop),nc_u32(last)))
      end
    end end end end end
  end
  # Where the records start that were made since the last fn, for or form
  # used as a value was entered: the first record when none was.
  def gm_region(env: bytes, offset: integer, found: integer): integer do
    if offset >= Enum.count(env) do found else
      tag = nc_env_tag(env,offset)
      gm_region(env,nc_env_next(env,offset),if (tag-40)*(tag-41) == 0 do nc_env_next(env,offset) else found end)
    end
  end
  def gm_cleared_from(source: bytes, env: bytes, offset: integer, span: bytes): bytes do
    if offset >= Enum.count(env) do b[] else
      tag = nc_env_tag(env,offset)
      name = nc_long(env,offset)
      size = nc_env_stop(env,offset)-name
      held = if size <= 0 do 0 else if nc_and((tag-2)*(tag-4)*(tag-5)*(tag-6)*(tag-7),(tag-8)*(tag-13)*(tag-18)*(tag-25)) != 0 do 0 else
        if gm_occurs(source,nc_long(span,0),nc_long(span,4),name,size) == 0 do 0 else 1-gm_occurs(source,nc_long(span,4),nc_long(span,8),name,size) end
      end end
      slot = if held == 0 do -1 else nc_lookup(source,name,env,3) end
      code = if slot < 0 do b[] else if nc_env_offset(env,slot) != offset do b[] else Enum.concat(nc_slot(b[72,199,69],slot),b[0,0,0,0]) end end
      Enum.concat(code,gm_cleared_from(source,env,nc_env_next(env,offset),span))
    end
  end
  # 1 when word stands as a word of its own somewhere from first up to stop.
  def gm_worded(source: bytes, first: integer, stop: integer, word: bytes): integer do
    if stop-first > 48 do
      middle = first+nc_half(stop-first)
      if gm_worded(source,first,middle,word) == 1 do 1 else gm_worded(source,middle,stop,word) end
    else gm_worded_from(source,first,stop,word) end
  end
  def gm_worded_from(source: bytes, first: integer, stop: integer, word: bytes): integer do
    if first >= stop do 0 else
      if byte_at(source,first) != Enum.at(word,0,0) do gm_worded_from(source,first+1,stop,word) else
        if is_identifier_continue(byte_at(source,first-1))+is_identifier_continue(byte_at(source,first+Enum.count(word))) > 0 do gm_worded_from(source,first+1,stop,word) else
          if nc_word_at(source,first,word,0) == 1 do 1 else gm_worded_from(source,first+1,stop,word) end
        end
      end
    end
  end
  # 1 when the body of function id, from first up to stop, calls the
  # function by its name.
  def gm_recursive(source: bytes, table: bytes, id: integer, first: integer, stop: integer): integer do
    name = nc_meta(table,id,0)
    size = nc_meta(table,id,3)-name
    if stop-first > 48 do
      middle = first+nc_half(stop-first)
      if gm_recursive(source,table,id,first,middle) == 1 do 1 else gm_recursive(source,table,id,middle,stop) end
    else gm_recursive_from(source,first,stop,name,size) end
  end
  def gm_recursive_from(source: bytes, pos: integer, stop: integer, name: integer, size: integer): integer do
    if pos >= stop do 0 else
      if byte_at(source,pos) != byte_at(source,name) do gm_recursive_from(source,pos+1,stop,name,size) else
        if is_identifier_continue(byte_at(source,pos-1)) == 1 do gm_recursive_from(source,pos+1,stop,name,size) else
          if nc_equal(source,pos,name,size)*(if byte_at(source,pos+size) == 40 do 1 else 0 end) == 1 do 1 else gm_recursive_from(source,pos+1,stop,name,size) end
        end
      end
    end
  end
  # The entry of a function that calls itself (52) other than by a jump:
  # its sixteen slots are set to 0 before anything is stored in them, when
  # its code makes values or calls anything but itself. A frame is not cleared when it is made,
  # so the slots a function has not yet stored into hold what earlier calls
  # left on the stack there: addresses, which the collector takes for
  # values in use for as long as the frame stands. One call deep that is
  # nothing; a thousand calls deep it is what each of them left for the
  # next. code is the function's body: a body that only computes and calls
  # the function itself (fib) leaves nothing new, and is entered as it was.
  def gm_frame(env: bytes, table: bytes, code: bytes): bytes do
    size = Enum.count(code)
    if gm_any(env,3,52) == 0 do b[] else if gm_count(code,0,size,nc_call(nc_cursor(env,0))) == 0 do b[] else
      if gm_count(code,0,size,b[255,20,37])+gm_count(code,0,size,b[65,255,18])+gm_others(code,0,size,nc_join(nc_u24(nc_cursor(env,0)),nc_u24(nc_records(Enum.count(table))),b[])) == 0 do b[] else
        b[102,15,239,192,15,17,69,240,15,17,69,224,15,17,69,208,15,17,69,192,15,17,69,176,15,17,69,160,15,17,69,144,15,17,69,128]
      end
    end end
  end
  # How often word stands in data from first up to stop.
  def gm_count(data: bytes, first: integer, stop: integer, word: bytes): integer do
    if stop-first > 32 do
      middle = first+nc_half(stop-first)
      gm_count(data,first,middle,word)+gm_count(data,middle,stop,word)
    else gm_count_from(data,first,stop,word) end
  end
  def gm_count_from(data: bytes, pos: integer, stop: integer, word: bytes): integer do
    if pos >= stop do 0 else
      if Enum.at(data,pos,-1) != Enum.at(word,0,0) do gm_count_from(data,pos+1,stop,word) else nc_word_at(data,pos,word,0)+gm_count_from(data,pos+1,stop,word) end
    end
  end
  # The calls in code, from first up to stop, of the program's functions
  # other than the function itself: plan holds the function and how many
  # records the table has (the slots behind them are the shared routines,
  # which a function reaches when it fails).
  def gm_others(code: bytes, first: integer, stop: integer, plan: bytes): integer do
    if stop-first > 32 do
      middle = first+nc_half(stop-first)
      gm_others(code,first,middle,plan)+gm_others(code,middle,stop,plan)
    else gm_others_from(code,first,stop,plan) end
  end
  def gm_others_from(code: bytes, pos: integer, stop: integer, plan: bytes): integer do
    index = nt_div(nc_long(code,pos+2)-4195456,8)
    if pos >= stop do 0 else
      if Enum.at(code,pos,-1) != 65 do gm_others_from(code,pos+1,stop,plan) else if nc_word_at(code,pos,b[65,187],0)*nc_word_at(code,pos+6,b[65,255,19],0) == 0 do gm_others_from(code,pos+1,stop,plan) else
        (if index == nc_cursor(plan,0) do 0 else if index >= nc_cursor(plan,3) do 0 else 1 end end)+gm_others_from(code,pos+1,stop,plan)
      end end
    end
  end
  # for ... reduce: initial do acc -> ... end: the do stands at start. The
  # name of a first arm that is a plain name is the accumulator of a fold,
  # as the second parameter of an Enum.reduce's fn is.
  def gm_arm(source: bytes, start: integer, env: bytes): bytes do
    name = nc_start(source,nc_expect(source,start,b[100,111]))
    if name < 0 do env else if nc_identifier(source,name) == 0 do env else if nc_word(source,nc_end(source,name),b[45,62]) == 0 do env else gm_note(env,53,name) end end end
  end
  # What such a for gives is released: the fold is over.
  def gm_reduced(source: bytes, table: bytes, value: bytes): bytes do
    tag = nc_tag(value)
    if nc_pos(value) < 0 do value else if (tag-2)*(tag-8)*(tag-25)*(tag-13)*(tag-18)*(tag-5) != 0 do value else Enum.concat(value,gm_given_up(source,table,nc_kind(value))) end end
  end
  # Native smoke test; the collector's place in a program.
  def main() do System.halt(0) end
end
