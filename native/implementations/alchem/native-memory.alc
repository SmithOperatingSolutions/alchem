  end
  # 1 when the name that starts at name with size bytes stands as a word of
  # its own somewhere from first up to stop.
  def gm_occurs(source: bytes, first: integer, stop: integer, name: integer, size: integer): integer do
    if stop-first > 48 do
      middle = first+nc_half(stop-first)
      if gm_occurs(source,first,middle,name,size) == 1 do 1 else gm_occurs(source,middle,stop,name,size) end
