  # RAX, a map or a set, is the fold's own from here on.
  def gm_own_emit(): bytes do
    nc_join(b[87,72,137,199],gm_ask(1000007),b[95])
  end
  # Map.o_keep, for the library alone, with the map, the key and the value
  # pushed and R8 set: the map is changed where it is when it is a fold's
  # own, else the entry is put as plain is.
  def gm_keep_emit(plain: bytes): bytes do
    nc_join(nc_join(b[72,139,124,36,16],gm_ask(1000006),b[133,192,15,132]),nc_join(nc_u32(Enum.count(gm_put_emit())+5),gm_put_emit(),Enum.concat(b[233],nc_u32(Enum.count(plain)))),plain)
  end
  # 1 when the name at pos is the first argument of a function of the
  # library that puts into the map or set it is given and gives nothing
