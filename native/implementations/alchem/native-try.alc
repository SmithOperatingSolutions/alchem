  # One arm before the rest: the line it stands on; for a type other than
  # the message's, whether the value is of it; the pattern; the guard; then
  # under a closure record the body, after which a handler's arm leaves the
  # stack as the try found it and an else arm stands where it returned.
  def ty_joined(source: bytes, table: bytes, plan: bytes, spec: bytes, parts: bytes, rest: bytes): bytes do
    mode = Enum.at(spec,0,0)
    typed = Enum.at(spec,1,0)
    line = ty_u32(spec,4)
    parsed = wc_first(wc_first(parts))
    body = wc_second(wc_second(parts))
    slot = nc_cursor(plan,1)
    load = if mode == 2 do nc_slot(b[72,139,69],slot+1) else Enum.concat(nc_slot(b[72,139,69],slot),if typed == 1 do b[72,139,64,48] else b[72,139,64,56] end) end
    emitted = np_emit(source,np_env(parsed),table,np_tree(parsed),0)
    inner = Enum.concat(load,emitted)
    tested = if typed == 0 do inner else nc_join(ty_same(slot,wc_second(wc_first(parts))),Enum.concat(b[132,192,15,132],nc_u32(Enum.count(inner))),inner) end
    check = if Enum.at(spec,2,0) == 0 do b[] else Enum.concat(nc_code(wc_first(wc_second(parts))),b[72,133,192,15,132]) end
    done = if mode == 2 do Enum.concat(b[143,133,112,255,255,255,89],nz_at(table,ty_past(line,1+Enum.at(spec,3,0)))) else ty_leave(table,plan) end
    taken = ty_recode(body,nc_join(ty_record(ty_u32(spec,8)),nc_code(body),done))
    if Enum.count(emitted) == 0 do b[] else
      ty_lined(np_join(nc_join(nz_at(table,ty_past(line,typed)),tested,b[132,192,15,132]),check,taken,ty_unlined(rest)),ty_line(rest))
    end
  end
  # A closure record on the stack: the line shown under it, then the records
  # so far.
  # A line is a 32-bit word here (a position and up to 255 lines past it,
  # ty_past); push sign-extends, so from bit 31 on the high half is set
  # after it.
  def ty_record(line: integer): bytes do
    pushed = if line < 2147483648 do Enum.concat(b[104],nc_u32(line)) else nc_join(b[104],nc_u32(line),b[199,68,36,4,0,0,0,0]) end
    Enum.concat(pushed,b[255,181,112,255,255,255,72,137,165,112,255,255,255])
  end
  # 1 or 0 in AL: the failure in the slot carries a value of type kind.
  def ty_same(slot: integer, kind: bytes): bytes do
    test = nc_join(b[72,139,112,40,49,192,72,133,246,116,24+xa_mark_size()],xa_mark(Enum.count(ty_type(kind)),b[72,141,61,22,0,0,0]),b[72,139,15,72,59,14,117,9,72,131,193,8,243,166,15,148,192,233])
    nc_join(nc_slot(b[72,139,69],slot),Enum.concat(test,nc_u32(Enum.count(ty_type(kind)))),ty_type(kind))
  end
  # An arm of a handler is over: the stack is as it was when the try began
  # (above the handler record of an after block), the try's closure is the
  # frame's again and stands on the line the pinned compiler's code returns on.
  def ty_leave(table: bytes, plan: bytes): bytes do
    drop = if nc_cursor(plan,14) == 0 do 32 else 48 end
    nc_join(Enum.concat(nc_slot(b[72,139,77],nc_cursor(plan,1)),b[72,139,97,24,72,131,196,drop]),Enum.concat(if nc_cursor(plan,17) == 0 do b[72,137,225] else b[72,141,76,36,32] end,b[72,137,141,112,255,255,255]),nz_at(table,ty_u32(plan,27)))
  end
  # A handler record whose handler stands `distance` bytes after it.
  def ty_handler(distance: integer): bytes do
    nc_join(b[65,87,85,72,141,5],nc_u32(distance+9),b[80,65,255,118,240,73,137,102,240])
  end
  # The whole: the try's closure record; the handler record of the after
  # block and the closure record of a body with else arms; the handler record
  # of the arms; the body; the handler, which the body jumps over; the after
  # block, entered with a failure record in the first slot when a failure is
  # passing and with 0 there otherwise.
  def ty_emit(source: bytes, table: bytes, plan: bytes, pair: bytes, chain: bytes): bytes do
    slot = nc_cursor(plan,1)
    body = wc_second(pair)
    other = if nc_cursor(plan,14) == 0 do 0 else 1 end
    arms = if nc_cursor(plan,8)+nc_cursor(plan,11) == 0 do 0 else 1 end
    whole = Enum.count(nc_code(chain))
    handler = if arms == 0 do nc_slice(nc_code(chain),whole-ty_u32(plan,39),whole) else
      nc_join(Enum.concat(nc_slot(b[72,137,101],slot),b[72,141,68,36,1,72,137,133,112,255,255,255]),nc_join(b[72,131,124,36,64,9,15,132],nc_u32(whole-ty_u32(plan,35)),nc_code(chain)),b[])
    end
    left = nc_join(if arms == 0 do b[] else b[65,143,70,240,72,131,196,24] end,if other == 0 do b[] else Enum.concat(b[143,133,112,255,255,255,89],nc_slot(b[72,137,69],slot+1)) end,if arms == 0 do b[] else Enum.concat(b[233],nc_u32(Enum.count(handler)-ty_u32(plan,39))) end)
    inner = nc_join(if other == 0 do b[] else ty_record(ty_u32(plan,31)) end,if arms == 0 do b[] else ty_handler(Enum.count(nc_code(body))+Enum.count(left)) end,nc_join(nc_code(body),left,handler))
    kind = if other == 1 do nc_kind(chain) else nx_join(body,chain) end
    made = if nc_cursor(plan,17) == 0 do inner else ty_after(table,slot,inner,wc_first(pair)) end
    core = Enum.concat(zf_tried(table,nc_code(body),nc_code(chain),Enum.concat(nc_u32(whole-ty_u32(plan,35)),nc_u32(whole-ty_u32(plan,39))),wc_first(pair)),made)
    if nt_tag(kind) < 0 do b[] else
      nw_meet(ty_closed(source,table,nc_value(nc_end(source,nc_cursor(plan,20)),if nc_cursor(plan,11) == 0 do core else ty_hide(core,0,Enum.count(core)) end,kind),plan),if other == 1 do b[] else body end,chain)
    end
