  # The pattern of the arm at start and the type it matches. The first
  # rescue arm may be name in Exception and the first catch arm name: type;
  # a rescue arm otherwise matches an exception by a struct pattern or the
  # message of any failure, and a catch arm the type the body throws, or
  # that of its literal or struct pattern.
  def ty_head(source: bytes, start: integer, env: bytes, table: bytes, state: bytes): bytes do
    mode = Enum.at(state,0,0)
    next = nc_end(source,start)
    owner = nc_owner(table,nc_read(env,0))
    given = nt_read(state,9)
    named = Enum.at(state,1,0)*(nc_identifier(source,start)+nc_word(source,start,b[95]))
    if mode == 2 do wc_both(np_parse(source,start,env,table,given),given) else
      if mode == 0 do
        if named*nc_word(source,next,b[105,110]) == 1 do ty_named(source,start,env,ty_struct(source,nc_start(source,nc_end(source,next)),table,owner),nc_end(source,nc_end(source,next))) else
          kind = if byte_at(source,start) != 37 do b[2] else ty_struct(source,nc_start(source,next),table,owner) end
          wc_both(np_parse(source,start,env,table,kind),kind)
        end
