defmodule NativeTry do
  # try, throw and the raise of an exception (spec/alchem-try.md).
  #
  # A try is compiled where it stands, in the frame of its function. While
  # its body runs a handler record is on the stack and the word at R14-16
  # points at it; a failure with a handler goes to it instead of ending the
  # program (spec/trace-x86_64.s), in the frame of the try and below
  # everything that failed, with the failure record at RSP. The try keeps
  # that record in its first slot and the value of its body in its second.
  def ty_u32(data: bytes, pos: integer): integer do nc_read(data,pos)+nc_read(data,pos+2)*65536 end
  # The frame word that stands `lines` lines after the one given: the
  # position in the low 24 bits, the lines above them (tr_place).
  def ty_past(line: integer, lines: integer): integer do line+lines*16777216 end
  # The packet with other code, and with code before its own.
  def ty_recode(value: bytes, code: bytes): bytes do
    if nc_pos(value) < 0 do b[] else Enum.concat(nc_slice(value,0,nt_after(value,4)),code) end
  end
  def ty_before(code: bytes, value: bytes): bytes do ty_recode(value,Enum.concat(code,nc_code(value))) end
  # A run of arms carries, before its code, the line the pinned compiler's
  # code stands on after it.
  def ty_lined(value: bytes, line: integer): bytes do ty_before(nc_u32(line),value) end
  def ty_line(value: bytes): integer do ty_u32(nc_code(value),0) end
  def ty_unlined(value: bytes): bytes do ty_recode(value,nc_slice(nc_code(value),4,Enum.count(nc_code(value)))) end
  # 1 when rescue, catch or after stands at pos as a word of a try: neither
  # = nor a colon follows it.
  def ty_word(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    stop = nc_end(source,start)
    next = nc_start(source,stop)
    named = nc_word(source,start,b[114,101,115,99,117,101])+nc_word(source,start,b[99,97,116,99,104])+nc_word(source,start,b[97,102,116,101,114])
    if named == 0 do 0 else if byte_at(source,stop) == 58 do 0 else
      if byte_at(source,next) != 61 do 1 else if byte_at(source,next+1) == 61 do 1 else 0 end end
    end end
  end
  # Two kinds of record with no name say whether a block stands in the body
  # or an arm of a try (type 43), where those words end it, or in an after
  # block (44), where they do not. The last of them counts.
  def ty_trying(env: bytes, offset: integer, found: integer): integer do
    tag = nt_tag(nt_read(env,offset+7))
    if offset >= Enum.count(env) do found else ty_trying(env,nc_env_next(env,offset),if tag == 43 do 1 else if tag == 44 do 0 else found end end) end
  end
  # 1 when the block ends at pos (nx_ends), also at a word of the try it is in.
  def ty_ends(source: bytes, pos: integer, env: bytes): integer do
    if nx_ends(source,pos) == 1 do 1 else if ty_word(source,pos) == 0 do 0 else ty_trying(env,2,0) end end
  end
  # 1 when try do stands at pos and try names no binding.
  def ty_keyword(source: bytes, pos: integer, env: bytes): integer do
    if nc_word(source,pos,b[116,114,121]) == 0 do 0 else if nc_opens(source,nc_end(source,pos)) == 0 do 0 else
      if nc_lookup(source,nc_start(source,pos),env,2) >= 0 do 0 else 1 end
    end end
  end
  # defexception Name do field: type ... end declares a struct that has a
  # field message: string and no type parameters.
  def ty_declare(source: bytes, pos: integer, owner: integer): bytes do
    record = nd_declare(source,pos,owner,64)
    if Enum.count(record) != 27 do b[] else if nc_argc(record,0) != 0 do b[] else
      if ty_messaged(source,nc_cursor(record,9),nc_cursor(record,12),16777216) == 0 do b[] else record end
    end end
  end
  def ty_messaged(source: bytes, pos: integer, stop: integer, budget: integer): integer do
    start = nc_start(source,pos)
    colon = nc_end(source,start)
    if start < 0 do 0 else if budget == 0 do 0 else if start >= stop do 0 else
      if nc_word(source,start,b[109,101,115,115,97,103,101])*nc_word(source,colon+1,b[115,116,114,105,110,103]) == 1 do if byte_at(source,colon) == 58 do 1 else 0 end else
        ty_messaged(source,colon,stop,budget-1)
      end
    end end end
  end
  # 1 when declaration id was written with defexception.
  def ty_exception(source: bytes, table: bytes, id: integer): integer do
    stop = if id < 0 do -1 else nz_before(source,nc_meta(table,id,0)-1) end
    if stop < 11 do 0 else if Enum.at(table,id*27+16,0) != 64 do 0 else nc_word_at(source,stop-11,b[100,101,102,101,120,99,101,112,116,105,111,110],0) end end
  end
  # The index of the field message of exception id.
  def ty_message(source: bytes, table: bytes, id: integer, index: integer): integer do
    field = nd_field_at(source,table,id,index)
    if nc_pos(field) < 0 do -1 else
      if nc_word(source,nc_cursor(nc_code(field),0),b[109,101,115,115,97,103,101]) == 1 do index else ty_message(source,table,id,index+1) end
    end
  end
  # A type as a failure record holds it: a string of its bytes.
  def ty_type(kind: bytes): bytes do Enum.concat(nt_word(Enum.count(kind)),kind) end
  # The bytes that stand before the type of every throw, so that a try finds
  # what its body throws; a try with catch arms hides those inside it.
  def ty_sign(): bytes do b[244,84,104,114,111,119,35,244] end
  # throw(value) at pos leaves for the nearest catch arm of its type. Like
  # raise it stands for a value of any type.
  def ty_throw(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_expect(source,nc_end(source,pos),b[40])
    value = if begin < 0 do b[] else nw_settled(nc_expression(source,begin,env,table,depth+1)) end
    stop = if nc_pos(value) < 0 do -1 else if nc_tag(value) == 12 do -1 else nc_expect(source,nc_pos(value),b[41]) end end
    fail = nc_join(Enum.concat(b[72,137,194],xa_mark_back(8+Enum.count(ty_type(nc_kind(value))),8,b[72,141,13,27,0,0,0])),nc_join(Enum.concat(b[191],nc_u32(nc_start(source,pos))),b[190,9,0,0,0],nc_call(nz_slot(table))),Enum.concat(ty_sign(),ty_type(nc_kind(value))))
    if stop < 0 do b[] else if nz_on(table) == 0 do b[] else nc_value(stop,Enum.concat(nc_code(value),fail),b[9]) end end
  end
  # raise(message), or raise(exception) for a struct literal or a name bound
  # to an exception: the failure then carries the value and its type, and
  # its message is the value's.
  def ty_raise(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_expect(source,nc_end(source,pos),b[40])
    first = nc_start(source,begin)
    value = if begin < 0 do b[] else if byte_at(source,first) == 37 do nc_expression(source,begin,env,table,depth+1) else
      if nc_lookup(source,first,env,2) < 0 do b[] else if nc_word(source,nc_end(source,first),b[41]) == 0 do b[] else nc_expression(source,begin,env,table,depth+1) end end
    end end
    id = nd_id(table,nc_kind(value))
    index = if ty_exception(source,table,id) == 0 do -1 else ty_message(source,table,id,0) end
    stop = nc_expect(source,nc_pos(value),b[41])
    fail = nc_join(Enum.concat(b[72,137,194,76,139,128],nc_u32(8+index*8)),nc_join(xa_mark(Enum.count(ty_type(nc_kind(value))),b[72,141,13,19,0,0,0]),Enum.concat(b[191],nc_u32(nc_start(source,pos))),b[190,10,0,0,0]),Enum.concat(nc_call(nz_slot(table)),ty_type(nc_kind(value))))
    if index < 0 do nj_raise(source,pos,env,table,depth) else if stop < 0 do b[] else if nz_on(table) == 0 do b[] else
      nc_value(stop,Enum.concat(nc_code(value),fail),b[9])
    end end end
  end
  # The type the body's code throws: none (b[]), one, or more than one (255).
  def ty_thrown(code: bytes, first: integer, stop: integer): bytes do
    middle = first+nc_half(stop-first)
    if stop-first <= 0 do b[] else
      if stop-first == 1 do
        if Enum.at(code,first,0) != 244 do b[] else if nt_same(nc_slice(code,first,first+8),ty_sign()) == 0 do b[] else nc_slice(code,first+16,first+16+nc_read(code,first+8)) end end
      else ty_either(ty_thrown(code,first,middle),ty_thrown(code,middle,stop)) end
    end
  end
  def ty_either(a: bytes, b: bytes): bytes do
    if Enum.count(a) == 0 do b else if Enum.count(b) == 0 do a else if nt_same(a,b) == 1 do a else b[255] end end end
  end
  def ty_hide(code: bytes, first: integer, stop: integer): bytes do
    middle = first+nc_half(stop-first)
    if nf_holds(code,ty_sign(),first,stop) == 0 do nc_slice(code,first,stop) else
      if stop-first == 1 do b[245] else Enum.concat(ty_hide(code,first,middle),ty_hide(code,middle,stop)) end
    end
  end
  # Where the words of the try stand whose body starts at pos: rescue, catch,
  # else, after and end, three bytes each, 0 for one that is not there. They
  # come in that order.
  def ty_sections(source: bytes, pos: integer, found: bytes): bytes do
    at = wc_scan(source,pos,6)
    index = if nc_word(source,at,b[114,101,115,99,117,101]) == 1 do 0 else if nc_word(source,at,b[99,97,116,99,104]) == 1 do 1 else if nc_word(source,at,b[101,108,115,101]) == 1 do 2 else if nc_word(source,at,b[97,102,116,101,114]) == 1 do 3 else 4 end end end end
    count = nc_units(Enum.count(found),3)
    if at < 0 do b[] else if index < count do b[] else
      grown = nc_join(found,nc_zeros((index-count)*3),nc_u24(at))
      if index == 4 do grown else if index < 3 do ty_sections(source,nc_end(source,at),grown) else
        # In the after block the words of a try are names like any other.
        if wc_scan(source,nc_end(source,at),0) < 0 do b[] else Enum.concat(grown,nc_u24(wc_scan(source,nc_end(source,at),0))) end
      end end
    end end
  end
  # The first word of the try at or after section index.
  def ty_next(plan: bytes, index: integer): integer do
    if index >= 4 do nc_cursor(plan,20) else if nc_cursor(plan,8+index*3) != 0 do nc_cursor(plan,8+index*3) else ty_next(plan,index+1) end end
  end
  # 1 when a rescue arm from pos up to stop takes every failure: a name or _
  # with no guard. The pinned compiler's code is then one line longer.
  def ty_certain(source: bytes, pos: integer, stop: integer, budget: integer): integer do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    plain = if value == 95 do 1 else if (value-97)*(122-value) >= 0 do 1 else 0 end end
    after = if nc_word(source,nc_end(source,start),b[105,110]) == 1 do nc_end(source,nc_end(source,nc_end(source,start))) else wc_skip(source,start) end
    next = wc_scan(source,wc_arm_body(source,after),1)
    if start < 0 do 0 else if start >= stop do 0 else if budget == 0 do 0 else
      if plain*nc_word(source,nc_end(source,start),b[45,62]) == 1 do 1 else if next < 0 do 0 else ty_certain(source,next,stop,budget-1) end end
    end end end
  end
  # try do body rescue arms catch arms else arms after block end. mode 1: the
  # try is a statement. plan: the depth, the try's first slot, 1 when its
  # value is dropped, where it stands (3 bytes) and its words (ty_sections);
  # then the line the pinned compiler's handler starts on, the line a
  # handler's arm leaves the try's closure on and the line after the body (4
  # bytes each).
  # A body that does not compile for want of a lambda's type waits for the
  # type the arms give, as the first branch of an if does (nf_hinting).
  def ty_try(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, mode: integer): bytes do
    first = ty_try_once(source,start,env,table,depth,mode)
    hinting = if nc_pos(first) >= 0 do b[] else if ty_keyword(source,start,env) == 0 do b[] else nf_trial(source,start,env,table) end end
    trial = if Enum.count(hinting) == 0 do b[] else ty_try_once(source,start,hinting,table,depth,mode) end
    settled = nf_settling(env,trial)
    if nc_pos(first) >= 0 do first else if Enum.count(settled) == 0 do b[] else ty_try_once(source,start,settled,table,depth,mode) end end
  end
  def ty_try_once(source: bytes, start: integer, env: bytes, table: bytes, depth: integer, mode: integer): bytes do
    marks = if ty_keyword(source,start,env) == 0 do b[] else if depth > 190 do b[] else if nz_on(table) == 0 do b[] else ty_sections(source,nc_end(source,nc_end(source,start)),b[]) end end end
    stop = nc_end(source,nc_cursor(marks,12))
    dropped = if Enum.count(marks) != 15 do 0 else if mode == 0 do 0 else wf_dropped(source,stop,env,table) end end
    base = if dropped == 1 do wf_mark(env,nc_cursor(marks,12)) else env end
    slot = nc_env_count(base,2)
    held = nj_valued(wf_record(wf_record(base,start,b[0]),start,b[0]))
    if Enum.count(marks) != 15 do b[] else if nc_cursor(marks,0)+nc_cursor(marks,3)+nc_cursor(marks,9) == 0 do b[] else if slot < 0 do b[] else
      ty_build(source,table,nc_join(Enum.concat(b[depth],nc_u24(slot)),Enum.concat(b[dropped],nc_u24(start)),marks),held)
    end end end
  end
  # The after block first: the pinned compiler's code holds it before the
  # handler, whose lines follow from it.
  def ty_build(source: bytes, table: bytes, plan: bytes, env: bytes): bytes do
    after = nc_cursor(plan,17)
    depth = Enum.at(plan,0,0)
    cleanup = if after == 0 do b[] else wf_block(source,nc_end(source,after),wf_mark(nj_mark(env,b[44]),nc_cursor(plan,20)),table,depth+1) end
    done = wc_first(cleanup)
    fine = if after == 0 do 1 else if nc_pos(done) < 0 do 0 else if nc_start(source,nc_pos(done)) != nc_cursor(plan,20) do 0 else 1-nx_pure(done) end end end
    base = if after == 0 do ty_past(nc_cursor(plan,5),2) else if fine == 0 do 0 else ty_past(wf_after(source,wc_second(cleanup),table,depth+1),1) end end
    certain = if nc_cursor(plan,8) == 0 do 0 else ty_certain(source,nc_end(source,nc_cursor(plan,8)),ty_next(plan,1),16777216) end
    line = ty_past(base,certain+(if nc_cursor(plan,14) == 0 do 0 else 2 end))
    if fine == 0 do b[] else ty_body(source,table,Enum.concat(plan,nc_u32(line)),nj_mark(env,b[43]),nc_code(done)) end
  end
  def ty_body(source: bytes, table: bytes, plan: bytes, env: bytes, cleanup: bytes): bytes do
    depth = Enum.at(plan,0,0)
    block = wf_block(source,nc_end(source,nc_end(source,nc_cursor(plan,5))),env,table,depth+1)
    body = wc_first(block)
    fits = if nc_pos(body) < 0 do 0 else if nc_start(source,nc_pos(body)) == ty_next(plan,0) do 1 else 0 end end
    line = if fits == 0 do 0 else wf_after(source,wc_second(block),table,depth+1) end
    # A body that does not compile has no last statement to place.
    last = if fits == 0 do 0 else nc_pos(wc_second(block)) end
    plain = if nc_cursor(plan,14) == 0 do 1 else 0 end
    ended = if plain*Enum.at(plan,4,0) == 0 do body else ty_recode(zf_unit(source,table,env,body,last),Enum.concat(nc_code(zf_unit(source,table,env,body,last)),nz_at(table,last))) end
    stub = if nc_cursor(plan,17)*(nc_cursor(plan,8)+nc_cursor(plan,11)) == 0 do last else ty_stub(source,last,wc_first(nc_code(wc_second(block))),table,depth+1) end
    if fits == 0 do b[] else if (1-plain)*(nc_tag(body)-12) == 0 do if plain == 1 do ty_chain(source,table,nc_join(plan,nc_u32(stub),nc_u32(line)),env,wc_both(cleanup,ended)) else b[] end else
      ty_chain(source,table,nc_join(plan,nc_u32(ty_past(line,1)),nc_u32(line)),env,wc_both(cleanup,ended))
    end end
  end
  # The statement the try's closure is shown on once an arm of its handler
  # is over and the after block runs. The pinned compiler's code has one
  # place for that, which is where its Go compiler put the last block of the
  # closure: followed here for a body that ends in a plain statement (that
  # statement), an if with else (the statement its else branch ends in, or
  # its first branch's when only that one ends in raise or throw), a cond
  # (its last arm) and a case (its second arm of two, else its first).
  def ty_stub(source: bytes, last: integer, env: bytes, table: bytes, depth: integer): integer do
    opener = wc_scan(source,nc_end(source,last),3)
    other = if opener < 0 do -1 else wc_scan(source,nc_end(source,opener),2) end
    form = if nc_word(source,last,b[105,102])+nc_word(source,last,b[117,110,108,101,115,115]) == 1 do 1 else if nc_word(source,last,b[99,111,110,100]) == 1 do 2 else if nc_word(source,last,b[99,97,115,101]) == 1 do 3 else 0 end end end
    arrows = if form < 2 do b[] else if opener < 0 do b[] else ty_arrows(source,nc_end(source,opener),b[]) end end
    count = nc_units(Enum.count(arrows),3)
    if depth > 150 do last else if form == 0 do last else if nc_opens(source,opener) == 0 do last else
      if form == 1 do
        if nc_word(source,other,b[101,108,115,101]) == 0 do last else ty_branches(source,wc_both(wf_last(source,nc_end(source,opener),env,table,depth),wf_last(source,nc_end(source,other),env,table,depth)),table,nc_join(nc_u24(last),b[depth],b[])) end
      else
        if count == 0 do last else ty_ending(source,nc_cursor(arrows,(if form == 2 do count-1 else if count == 2 do 1 else 0 end end)*3)+2,env,table,depth) end
      end
    end end end
  end
  def ty_leaves(source: bytes, pos: integer): integer do nc_word(source,pos,b[114,97,105,115,101])+nc_word(source,pos,b[116,104,114,111,119]) end
  def ty_branches(source: bytes, both: bytes, table: bytes, plan: bytes): integer do
    first = nc_pos(wc_first(both))
    second = wc_second(both)
    if nc_pos(second) < 0 do nc_cursor(plan,0) else
      if ty_leaves(source,first)*(1-ty_leaves(source,nc_pos(second))) == 1 do first else ty_stub(source,nc_pos(second),wc_first(nc_code(second)),table,Enum.at(plan,3,0)+1) end
    end
  end
  # The statement the block at pos ends in, followed in the same way.
  def ty_ending(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): integer do
    found = wf_last(source,pos,env,table,depth)
    if nc_pos(found) < 0 do nc_start(source,pos) else ty_stub(source,nc_pos(found),wc_first(nc_code(found)),table,depth+1) end
  end
  # Where the arrows of the arms of the block at pos stand, three bytes each.
  def ty_arrows(source: bytes, pos: integer, found: bytes): bytes do
    at = wc_scan(source,pos,4)
    if at < 0 do found else if nc_word(source,at,b[45,62]) == 0 do found else if Enum.count(found) > 3000 do found else ty_arrows(source,at+2,Enum.concat(found,nc_u24(at))) end end end
  end
  # The arms, last section first: each run of arms ends in what follows it.
  # A state is: the section (0 rescue, 1 catch, 2 else), 1 for its first arm,
  # the line the arm stands on (4 bytes), where the section ends (3 bytes),
  # the type the arms match after its length, and what follows the section.
  # The arms, and where they did not compile the arms held to the type of
  # the body, which is the try's where it has no else (nf_led).
  def ty_chain(source: bytes, table: bytes, plan: bytes, env: bytes, pair: bytes): bytes do
    plain = ty_chained(source,table,plan,env,pair)
    body = wc_second(pair)
    led = if nc_pos(plain) >= 0 do b[] else if nc_cursor(plan,14) != 0 do b[] else if nc_pos(body) < 0 do b[] else nf_led(source,env,table,nc_value(ty_next(plan,0),b[],nc_kind(body)),ty_next(plan,0)) end end end
    if Enum.count(led) == 0 do plain else ty_chained(source,table,plan,led,pair) end
  end
  def ty_chained(source: bytes, table: bytes, plan: bytes, env: bytes, pair: bytes): bytes do
    other = nc_cursor(plan,14)
    final = nc_cursor(plan,20)
    body = wc_second(pair)
    state = nc_join(Enum.concat(b[2,1],nc_u32(ty_past(ty_u32(plan,31),3))),nc_u24(ty_next(plan,3)),nt_cell(nc_kind(body)))
    tail = if other == 0 do nc_value(final,nc_u32(0),b[9,2]) else ty_arms(source,nc_end(source,other),env,table,plan,state) end
    if nc_pos(tail) < 0 do b[] else ty_catch(source,table,plan,env,pair,tail) end
  end
  def ty_catch(source: bytes, table: bytes, plan: bytes, env: bytes, pair: bytes, tail: bytes): bytes do
    catch = nc_cursor(plan,11)
    first = ty_u32(plan,23)
    code = nc_code(wc_second(pair))
    state = nc_join(Enum.concat(b[1,1],nc_u32(ty_past(first,4))),nc_u24(ty_next(plan,2)),Enum.concat(nt_cell(ty_thrown(code,0,Enum.count(code))),ty_unlined(tail)))
    arms = if catch == 0 do ty_lined(ty_before(ty_decline(table,plan,ty_past(first,4)),ty_unlined(tail)),ty_past(first,1)) else
      ty_arms(source,nc_end(source,catch),env,table,plan,state)
    end
    whole = if catch == 0 do ty_unlined(arms) else ty_before(b[72,139,76,36,24,76,139,121,24],ty_unlined(arms)) end
    sizes = nc_join(nc_u32(Enum.count(nc_code(whole))),nc_u32(Enum.count(nc_code(tail))-4),nc_u32(ty_past(ty_line(tail),2)))
    if nc_pos(arms) < 0 do b[] else ty_rescue(source,table,nc_join(plan,sizes,nc_u32(ty_past(ty_line(arms),2))),env,pair,whole) end
  end
  # plan now also holds the length of the code from the catch arms on, that
  # of the else arms, the line the function stands on while a try with else
  # runs, and the line the rescue arms' code starts on.
  def ty_rescue(source: bytes, table: bytes, plan: bytes, env: bytes, pair: bytes, tail: bytes): bytes do
    rescue = nc_cursor(plan,8)
    first = ty_u32(plan,47)
    state = nc_join(Enum.concat(b[0,1],nc_u32(ty_past(first,3))),nc_u24(ty_next(plan,1)),Enum.concat(b[0],tail))
    arms = if rescue == 0 do ty_before(ty_decline(table,plan,first),tail) else
      ty_before(b[72,139,76,36,24,76,139,121,24],ty_unlined(ty_arms(source,nc_end(source,rescue),env,table,plan,state)))
    end
    if nc_pos(arms) < 0 do b[] else ty_emit(source,table,plan,pair,arms) end
  end
  # The failure in the try's first slot is raised again from where the
  # handler stands, on that line.
  def ty_decline(table: bytes, plan: bytes, line: integer): bytes do
    nc_join(nz_at(table,line),Enum.concat(nc_slot(b[72,139,85],nc_cursor(plan,1)),b[190,11,0,0,0]),nc_call(nz_slot(table)))
  end
  def ty_arms(source: bytes, pos: integer, env: bytes, table: bytes, plan: bytes, state: bytes): bytes do
    start = nc_start(source,pos)
    line = ty_u32(state,2)
    tail = nc_slice(state,nt_after(state,9),Enum.count(state))
    if start < 0 do b[] else
      if start == nc_cursor(state,6) do
        if Enum.at(state,1,0) == 1 do b[] else if Enum.at(state,0,0) == 2 do nc_value(start,nc_join(nc_u32(line),nz_at(table,line),wc_fail(table,nc_cursor(plan,5),b[110,111,32,101,108,115,101,32,99,108,97,117,115,101,32,111,102,32,116,104,105,115,32,116,114,121,32,109,97,116,99,104,101,100])),b[9,2]) else
