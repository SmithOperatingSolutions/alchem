  def ty_after(table: bytes, slot: integer, inner: bytes, cleanup: bytes): bytes do
    enter = nc_join(Enum.concat(b[65,143,70,240,72,131,196,24],nc_slot(b[72,137,69],slot+1)),Enum.concat(nc_slot(b[72,199,69],slot),b[0,0,0,0]),b[72,139,133,120,255,255,255,80,255,181,112,255,255,255,72,137,165,112,255,255,255,233])
    failed = Enum.concat(nc_slot(b[72,137,101],slot),b[72,141,68,36,1,72,137,133,112,255,255,255])
    leave = nc_join(Enum.concat(nc_slot(b[72,139,85],slot),b[72,133,210,116,14,190,12,0,0,0]),nc_call(nz_slot(table)),Enum.concat(b[143,133,112,255,255,255,89],nc_slot(b[72,139,69],slot+1)))
    nc_join(Enum.concat(ty_handler(Enum.count(inner)+Enum.count(enter)+4),inner),nc_join(enter,nc_u32(Enum.count(failed)),failed),Enum.concat(cleanup,leave))
  end
  # The try is a closure in the pinned compiler, whatever it stands in: while
  # it runs a record keeps the line the function stands on, where the try
  # is or, with else arms, where the pinned compiler's code of it ends, and
  # the function stands there afterwards (a call the try is an argument of,
  # or is piped into, stays where its statement stands, as in nz_closure).
  def ty_closed(source: bytes, table: bytes, value: bytes, plan: bytes): bytes do
    start = nc_cursor(plan,5)
    next = byte_at(source,nc_start(source,nc_pos(value)))
    inside = if next*256+byte_at(source,nc_start(source,nc_pos(value))+1) == 31806 do 1 else if (next-41)*(next-44)*(next-93)*(next-125) != 0 do 0 else 1-nz_grouped(source,start) end end
    line = if nc_cursor(plan,14) == 0 do start else ty_u32(plan,43) end
    enter = Enum.concat(if inside == 1 do b[72,139,133,120,255,255,255,80] else b[] end,ty_record(line))
    leave = Enum.concat(b[143,133,112,255,255,255,89],if inside == 1 do b[89,72,137,141,120,255,255,255] else nz_at(table,line) end)
    ty_recode(value,nc_join(enter,nc_code(value),leave))
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
