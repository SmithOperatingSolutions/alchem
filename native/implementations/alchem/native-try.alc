  def ty_caught(source: bytes, start: integer, env: bytes, table: bytes, given: bytes): bytes do
    kind = if Enum.count(given) > 0 do if Enum.at(given,0,0) == 255 do b[] else given end else ty_literal(source,start,table,nc_owner(table,nc_read(env,0))) end
    wc_both(np_parse(source,start,env,table,kind),kind)
  end
  # The exception named at pos, as a type; b[] for anything else.
  def ty_struct(source: bytes, pos: integer, table: bytes, owner: integer): bytes do
    id = nd_named(source,pos,table,owner)
    if ty_exception(source,table,id) == 0 do b[] else nd_plain(table,id) end
  end
  # The type of a literal or struct pattern at start.
  def ty_literal(source: bytes, start: integer, table: bytes, owner: integer): bytes do
    value = byte_at(source,start)
    digits = if value == 45 do nc_start(source,start+1) else start end
    stop = nc_end(source,digits)
    if value == 34 do b[2] else if value == 58 do b[22] else
      if is_digit(byte_at(source,digits)) == 1 do if nf_holds(source,b[46],digits,stop) == 1 do b[24] else b[0] end else
        if nc_word(source,start,b[116,114,117,101])+nc_word(source,start,b[102,97,108,115,101]) == 1 do b[3] else
          if value != 37 do b[] else if byte_at(source,nc_start(source,start+1)) == 123 do b[] else nd_plain(table,nd_named(source,nc_start(source,start+1),table,owner)) end end
        end
      end
    end end
  end
  # name or _ at start as a pattern of type kind that ends at stop.
  def ty_named(source: bytes, start: integer, env: bytes, kind: bytes, stop: integer): bytes do
    parsed = if nc_word(source,start,b[95]) == 1 do np_pack(stop,b[0],env) else np_name(source,start,env,kind) end
    if Enum.count(kind) == 0 do b[] else wc_both(wc_at(parsed,stop),kind) end
  end
  def ty_arm(source: bytes, head: bytes, env: bytes, table: bytes, plan: bytes, state: bytes): bytes do
    parsed = wc_first(head)
    scope = np_env(parsed)
    depth = Enum.at(plan,0,0)
    guarded = nc_word(source,nc_pos(parsed),b[119,104,101,110])
    guard = if guarded == 0 do nc_value(nc_pos(parsed),b[],b[3]) else nc_condition(source,nc_end(source,nc_pos(parsed)),sg_conditional(scope),table,depth+1) end
    arrow = nc_expect(source,nc_pos(guard),b[45,62])
    block = if arrow < 0 do b[] else wf_block(source,arrow,scope,table,depth+1) end
    mode = Enum.at(state,0,0)
    typed = if mode == 1 do 1 else if mode == 2 do 0 else if nt_tag(wc_second(head)) == 2 do 0 else 1 end end end
    after = if nc_pos(wc_first(block)) < 0 do 0 else wf_after(source,wc_second(block),table,depth+1) end
    next = if mode == 2 do ty_past(after,2) else ty_past(after,3+typed+(if nc_cursor(plan,14) == 0 do 0 else 1 end)) end
