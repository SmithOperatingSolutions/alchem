defmodule NativeStructures do
  def nr_unary(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    if nc_word(source,pos,b[123]) == 1 do nr_tuple(source,pos,env,table,depth) else
      if nc_word(source,pos,b[101,108,101,109])*nc_word(source,nc_end(source,pos),b[40]) == 1 do nr_elem(source,pos,env,table,depth) else if nc_word(source,pos,b[112,117,116,95,101,108,101,109])*nc_word(source,nc_end(source,pos),b[40]) == 1 do nr_put_elem(source,pos,env,table,depth) else
        # ok(...) and error(...) build results unless the module has a function of that name.
        built = (nc_word(source,pos,b[111,107])+nc_word(source,pos,b[101,114,114,111,114]))*nc_word(source,nc_end(source,pos),b[40])
        own = if built == 0 do 0 else if nc_find(source,nc_start(source,pos),table,nc_owner(table,nc_read(env,0))) < 0 do 0 else 1 end end
        if built-own == 1 do nr_constructor(source,pos,env,table,depth) else nm_unary(source,pos,env,table,depth) end
      end end
    end
  end
  def nr_tuple(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_end(source,pos)
    scope = nf_inward(source,nc_start(source,pos),env)
    items = if nc_word(source,begin,b[125]) == 1 do nc_arg_packet(nc_end(source,begin),0,b[0],b[]) else nr_items(source,begin,scope,table,depth,nf_parted(source,scope,table)) end
    count = nc_arg_count(items)
    kind = nt_tuple(nc_arg_types(items),count)
    if nc_pos(items) < 0 do b[] else if nt_tag(kind) < 0 do b[] else
      allocate = nc_join(nc_allocate_emit(count*8),Enum.concat(b[72,199,2],nc_u32(count)),nr_stores(count))
      nc_value(nc_pos(items),nc_join(nc_arg_code(items),allocate,b[72,137,208]),kind)
    end end
  end
  def nr_items(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, plan: integer): bytes do
    all = nr_grow(source,nr_step(source,nc_join(nc_u24(pos),b[0],nc_u24(0)),env,table,b[plan,depth]),env,table,b[plan,depth],0)
    run = nc_slice(all,7,Enum.count(all))
    if Enum.count(all) == 0 do b[] else nc_arg_packet(nc_cursor(all,0),nc_cursor(all,4),nc_run_kinds(run),nc_run_code(run)) end
  end
  # The part of a tuple that stands where before says, of the index it says:
  # where the next one starts (the position after the "}" with a 1), the
  # index of the next, then the part as a run (nc_run). plan: 1 when the
  # parts are expected to hold functions, and the nesting.
  def nr_step(source: bytes, before: bytes, env: bytes, table: bytes, plan: bytes): bytes do
    pos = nc_cursor(before,0)
    index = nc_cursor(before,4)
    arg = nc_expression(source,pos,if Enum.at(plan,0,0) == 0 do env else nf_expecting(source,env,pos,nf_part(source,env,table,index)) end,table,Enum.at(plan,1,0)+2)
    stop = nc_pos(arg)
    last = if stop < 0 do 0 else nc_word(source,stop,b[125]) end
    if stop < 0 do b[] else if last+nc_word(source,stop,b[44]) == 0 do b[] else
      Enum.concat(nc_join(nc_u24(nc_end(source,stop)),b[last],nc_u24(index+1)),nc_run(0,nt_cell(nc_kind(arg)),b[0],Enum.concat(nc_code(arg),b[80])))
    end end
  end
  # Up to 2^level parts after those of before; runs are joined in doubling
  # lengths, as arguments are (nc_arg_more).
  def nr_more(source: bytes, before: bytes, env: bytes, table: bytes, plan: bytes, level: integer): bytes do
    if level == 0 do nr_step(source,before,env,table,plan) else
      first = nr_more(source,before,env,table,plan,level-1)
      if Enum.count(first) == 0 do b[] else if Enum.at(first,3,0) == 1 do first else nr_joined(first,nr_more(source,first,env,table,plan,level-1)) end end
    end
  end
  def nr_joined(first: bytes, second: bytes): bytes do
    if Enum.count(first) == 0 do b[] else if Enum.count(second) == 0 do b[] else
      Enum.concat(nc_slice(second,0,7),nc_run_both(nc_slice(first,7,Enum.count(first)),nc_slice(second,7,Enum.count(second))))
    end end
  end
  def nr_grow(source: bytes, done: bytes, env: bytes, table: bytes, plan: bytes, level: integer): bytes do
    if Enum.count(done) == 0 do b[] else if Enum.at(done,3,0) == 1 do done else
      nr_grow(source,nr_joined(done,nr_more(source,done,env,table,plan,level)),env,table,plan,level+1)
    end end
  end
  def nr_stores(count: integer): bytes do
    nr_stores_run(1,count+1)
  end
  # Pop the fields first up to stop into the record at RDX, the highest first.
  # Past the fifteenth field the offset no longer fits a signed byte.
  def nr_stores_run(first: integer, stop: integer): bytes do
    if stop-first <= 0 do b[] else if stop-first == 1 do if first < 16 do b[88,72,137,66,first*8] else Enum.concat(b[88,72,137,130],nc_u32(first*8)) end else
      Enum.concat(nr_stores_run(first+nc_half(stop-first),stop),nr_stores_run(first,first+nc_half(stop-first)))
    end end
  end
  def nr_elem(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_expect(source,nc_end(source,pos),b[40])
    piped = nf_piped(source,begin,env)
    value = if begin < 0 do b[] else if nc_pos(piped) < 0 do nc_expression(source,begin,env,table,depth+1) else piped end end
    if nc_pos(value) < 0 do b[] else if nt_tag(nc_kind(value)) != 5 do b[] else
      index = nc_start(source,if nc_pos(piped) < 0 do nc_expect(source,nc_pos(value),b[44]) else begin end)
      stop = nc_end(source,index)
      if decimal_status(source,index,stop,0,7) != 0 do b[] else
        number = 0-decimal_digits(source,index,stop,0)
        after = nc_expect(source,stop,b[41])
        if number >= nt_count(nc_kind(value)) do b[] else if after < 0 do b[] else
          nd_access(source,nc_value(after,Enum.concat(nc_code(value),if number < 15 do b[72,139,64,8+number*8] else Enum.concat(b[72,139,128],nc_u32(8+number*8)) end),nt_child(nc_kind(value),number)),env,table,depth)
        end end
      end
    end end
  end
  # put_elem(tuple, index, value): a copy of the tuple with the element at
  # the index (a literal, as elem's) replaced; the element's type is the
  # value's. The copy waits on the stack while the value is made.
  def nr_put_elem(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_expect(source,nc_end(source,pos),b[40])
    piped = nf_piped(source,begin,env)
    value = if begin < 0 do b[] else if nc_pos(piped) < 0 do nc_expression(source,begin,env,table,depth+1) else piped end end
    kind = nc_kind(value)
    count = nt_count(kind)
    index = if nc_pos(value) < 0 do -1 else nc_start(source,if nc_pos(piped) < 0 do nc_expect(source,nc_pos(value),b[44]) else begin end) end
    stop = nc_end(source,index)
    number = if index < 0 do -1 else if nt_tag(kind) != 5 do -1 else if decimal_status(source,index,stop,0,7) != 0 do -1 else 0-decimal_digits(source,index,stop,0) end end end
    item = if number < 0 do b[] else if number >= count do b[] else nc_expression(source,nc_expect(source,stop,b[44]),env,table,depth+1) end end
    after = nc_expect(source,nc_pos(item),b[41])
    made = nt_tuple(nt_replace(nf_words(kind,0,count),number,nc_kind(item)),count)
    if after < 0 do b[] else if nt_tag(made) < 0 do b[] else
      copy = nc_join(Enum.concat(nc_code(value),b[80]),nc_join(nc_allocate_emit(count*8),Enum.concat(b[72,199,2],nc_u32(count)),b[72,139,12,36]),Enum.concat(nd_copies(count,0),b[72,137,20,36]))
      nd_access(source,nc_value(after,nc_join(copy,nc_code(item),Enum.concat(nd_store(number),b[88])),made),env,table,depth)
    end end
  end
  def nr_constructor(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_expect(source,nc_end(source,pos),b[40])
    args = if begin < 0 do b[] else nc_arguments(source,begin,env,table,depth) end
    if nc_pos(args) < 0 do b[] else if nc_arg_count(args) != 1 do b[] else
      success = nc_word(source,pos,b[111,107])
      kind = if success == 1 do nt_binary(6,nc_arg_kind(args,0),b[9]) else nt_binary(6,b[9],nc_arg_kind(args,0)) end
      if nt_tag(kind) < 0 do b[] else
        box = no_box_emit()
        # The checked box allocation has a one-byte immediate discriminant.
        tagged = nc_join(nc_slice(box,0,14),b[success],nc_slice(box,15,Enum.count(box)))
        nc_value(nc_pos(args),nc_join(nc_arg_code(args),b[88],tagged),kind)
      end
    end end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
