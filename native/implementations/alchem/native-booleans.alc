defmodule NativeBooleans do
  def nb_unary(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    if nc_word(source,pos,b[76,105,115,116]) == 1 do ny_or(no_list(source,pos,env,table,depth),source,pos,env,table,depth) else nb_option(source,pos,env,table,depth) end
  end
  def nb_option(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    # none and some may name bindings; a binding of that name hides the constructor.
    bound = if nc_word(source,pos,b[110,111,110,101])+nc_word(source,pos,b[115,111,109,101]) == 0 do -1 else nc_lookup(source,nc_start(source,pos),env,2) end
    if nc_word(source,pos,b[110,111,110,101])*(0-bound) == 1 do nc_value(nc_end(source,pos),b[49,192],b[4,9]) else
      if nc_word(source,pos,b[115,111,109,101])*(0-bound) == 1 do no_some(source,pos,env,table,depth) else
        if nc_word(source,pos,b[99,97,115,101]) == 1 do zf_valued(source,table,env,nz_closure(source,table,no_case(source,pos,nj_valued(env),table,depth),pos),pos) else if ty_keyword(source,pos,env) == 1 do ty_try(source,pos,env,table,depth,0) else if wc_keyword(source,pos,env) == 1 do wc_value(source,pos,env,table,depth) else if wf_keyword(source,pos,env) == 1 do wf_for(source,pos,env,table,depth,0) else
          if nc_word(source,pos,b[99,111,110,100])*nc_word(source,nc_end(source,pos),b[100,111]) == 1 do nz_closure(source,table,nk_cond(source,pos,nj_valued(env),table,depth),pos) else nr_unary(source,pos,env,table,depth) end
        end end end end
      end
    end
  end
  def nb_scalar(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    yes = nc_word(source,pos,b[116,114,117,101])
    no = nc_word(source,pos,b[102,97,108,115,101])
    if yes+no > 0 do nc_value(nc_end(source,pos),b[184,yes,0,0,0],b[3]) else
      if nc_word(source,pos,b[110,111,116])+nc_word(source,pos,b[33]) == 1 do
        value = nc_unary(source,nc_end(source,pos),env,table,depth+1)
        if nc_pos(value) < 0 do b[] else
          if nc_tag(value) != 3 do b[] else nc_value(nc_pos(value),Enum.concat(nc_code(value),b[72,131,240,1]),b[3]) end
        end
      else
        if nc_word(source,pos,b[83,116,114,105,110,103]) == 1 do ny_or(zf_wrap(nb_string(source,pos,env,table,depth),table,nc_start(source,pos)),source,pos,env,table,depth) else nc_unary_other(source,pos,env,table,depth) end
      end
    end
  end
  def nb_compare(source: bytes, left: bytes, env: bytes, table: bytes, depth: integer): bytes do
    if nc_pos(left) < 0 do b[] else
      op = nc_start(source,nc_pos(left))
      value = byte_at(source,op)
      candidate = if value == 61 do 1 else if value == 33 do 1 else if value == 60 do 1 else if value == 62 do 1 else 0 end end end end
      cc = if candidate == 0 do 0 else nb_operator(source,op) end
      if value == 105 do nb_in(source,left,env,table,depth) else if cc == 0 do if nc_word(source,op,b[61,126]) == 1 do sg_match(source,left,env,table,depth) else left end else
        right = nc_math(source,nc_end(source,op),env,table,depth)
        # The left operand takes no type from the comparison; the right takes the left's.
        if nc_pos(right) < 0 do b[] else if nw_open_operand(left) == 1 do b[] else
          # Compound values compare by structure, and only with == and !=.
          if nt_tag(nt_merge(nc_kind(left),nc_kind(right))) < 4 do nb_comparison(left,right,cc) else if nc_tag(left) == 24 do ne_compare(left,right,cc) else if nt_tag(nt_merge(nc_kind(left),nc_kind(right))) == 22 do nb_string_equal(left,right,if (cc-148)*(cc-149) == 0 do 1 else 0 end,cc) else
            if (cc-148)*(cc-149) != 0 do od_compare(source,table,left,right,Enum.concat(b[cc],env)) else nq_compare(source,table,left,right,Enum.concat(b[cc],nu_vars(env,2))) end
          end end end
        end end
      end end
    end
  end
  def nb_in(source: bytes, left: bytes, env: bytes, table: bytes, depth: integer): bytes do
    op = nc_start(source,nc_pos(left))
    if nc_word(source,op,b[105,110]) == 0 do left else
      right = nc_math(source,nc_end(source,op),env,table,depth)
      if nc_pos(right) < 0 do b[] else nk_member(source,table,left,right,nu_vars(env,2)) end
    end
  end
  def nb_operator(source: bytes, op: integer): integer do
  if nc_word(source,op,b[61,61]) == 1 do 148 else
      if nc_word(source,op,b[33,61]) == 1 do 149 else
        if nc_word(source,op,b[60]) == 1 do 156 else
          if nc_word(source,op,b[60,61]) == 1 do 158 else
            if nc_word(source,op,b[62]) == 1 do 159 else
              if nc_word(source,op,b[62,61]) == 1 do 157 else 0 end
            end
          end
        end
      end
    end
  end
  def nb_comparison(left: bytes, right: bytes, cc: integer): bytes do
    if nt_same(nc_kind(left),nc_kind(right)) == 0 do b[] else
      kind = nc_tag(left)
      equality = if cc == 148 do 1 else if cc == 149 do 1 else 0 end end
      allowed = if kind == 0 do 1 else if kind == 3 do equality else 0 end end
      if kind == 2 do nb_string_equal(left,right,equality,cc) else if allowed == 0 do b[] else
        nc_value(nc_pos(right),Enum.concat(vs_pair(nc_code(left),nc_code(right)),b[72,57,193,15,cc,192,72,15,182,192]),b[3])
      end end
    end
  end
  # String ==/!= compare bytes, like Go string equality; < <= > >= order by
  # unsigned bytes with a proper prefix first, like Go string comparison.
  def nb_string_equal(left: bytes, right: bytes, equality: integer, cc: integer): bytes do
    operands = nc_join(Enum.concat(nc_code(left),b[80]),nc_code(right),b[89])
    if equality == 0 do
      nc_value(nc_pos(right),nc_join(operands,na_str_cmp_emit(),b[72,131,248,0,15,cc,192,72,15,182,192]),b[3])
    else
      negate = if cc == 149 do b[131,240,1] else b[] end
      nc_value(nc_pos(right),nc_join(operands,na_str_eq_emit(),negate),b[3])
    end
  end
  def nb_string(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    dot = nc_expect(source,nc_end(source,pos),b[46])
    if nc_word(source,dot,b[116,111,95,97,116,111,109]) == 1 do nb_to_atom(source,dot,env,table,depth) else if nc_word(source,dot,b[116,111,95,102,108,111,97,116]) == 1 do ne_to_float(source,pos,env,table,depth) else nb_string_other(source,pos,env,table,depth) end end
  end
  # String.to_atom(text): the atom of that name, which is the same string.
  def nb_to_atom(source: bytes, dot: integer, env: bytes, table: bytes, depth: integer): bytes do
    begin = nc_expect(source,nc_end(source,dot),b[40])
    args = if begin < 0 do b[] else nc_arguments(source,begin,env,table,depth) end
    if nc_pos(args) < 0 do b[] else if nc_arg_count(args) != 1 do b[] else if nt_tag(nc_arg_kind(args,0)) != 2 do b[] else
      nc_value(nc_pos(args),Enum.concat(nc_arg_code(args),b[88]),b[22])
    end end end
  end
  def nb_string_other(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    dot = nc_expect(source,nc_end(source,pos),b[46])
    # The pinned language has both contains?/starts_with?/ends_with? and the bare names.
    op = if nc_word(source,dot,b[99,111,110,116,97,105,110,115,63])+nc_word(source,dot,b[99,111,110,116,97,105,110,115]) == 1 do 1 else
      if nc_word(source,dot,b[115,116,97,114,116,115,95,119,105,116,104,63])+nc_word(source,dot,b[115,116,97,114,116,115,95,119,105,116,104]) == 1 do 2 else
        if nc_word(source,dot,b[101,110,100,115,95,119,105,116,104,63])+nc_word(source,dot,b[101,110,100,115,95,119,105,116,104]) == 1 do 3 else 0 end
      end
    end
    if op == 0 do ng_builtin(source,pos,env,table,depth) else
      begin = nc_expect(source,nc_end(source,dot),b[40])
      args = if begin < 0 do b[] else nc_arguments(source,begin,env,table,depth) end
      if nc_pos(args) < 0 do b[] else nb_string_call(args,op) end
    end
  end
  def nb_string_call(args: bytes, op: integer): bytes do
    if nc_arg_count(args) != 2 do b[] else
      if nt_tag(nc_arg_kind(args,0)) != 2 do b[] else
        if nt_tag(nc_arg_kind(args,1)) != 2 do b[] else
          nc_value(nc_pos(args),nc_join(nc_arg_code(args),b[191,op,0,0,0],nb_string_emit()),b[3])
        end
      end
    end
  end
  def nb_string_emit(): bytes do
    b[90,94,76,139,6,76,139,10,77,57,193,119,75,72,131,198,8,72,131,194,8,77,137,194,77,41,202,69,49,219,131,255,3,117,3,77,137,211,49,201,78,141,4,30,77,133,201,116,17,65,138,4,8,58,4,10,117,15,72,255,193,76,57,201,114,239,184,1,0,0,0,235,17,131,255,1,117,10,77,57,211,115,5,73,255,195,235,206,49,192]
  end
  # && || and a prefix ! are spellings of and, or and not.
  def nb_expression(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    left = nb_and(source,pos,env,table,depth)
    nb_or_tail(source,left,env,table,depth,1024)
  end
  def nb_and(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    left = nc_comparison(source,pos,env,table,depth)
    nb_and_tail(source,left,env,table,depth,1024)
  end
  def nb_or_tail(source: bytes, left: bytes, env: bytes, table: bytes, depth: integer, budget: integer): bytes do
    if nc_pos(left) < 0 do b[] else
      pos = nc_start(source,nc_pos(left))
      is_or = if byte_at(source,pos) == 124 do nc_word(source,pos,b[124,124]) else if byte_at(source,pos) != 111 do 0 else nc_word(source,pos,b[111,114]) end end
      bits = if is_or == 1 do 0 else nk_bit_at(source,pos,b[124,94]) end
      if bits > 0 do if budget <= 0 do b[] else nb_or_tail(source,nk_bits(left,nb_and(source,pos+3,env,table,depth),bits),env,table,depth,budget-1) end else
      if is_or == 0 do left else
        if budget <= 0 do b[] else
          right = nb_and(source,nc_end(source,pos),env,table,depth)
          if nc_pos(right) < 0 do b[] else nb_or_tail(source,nb_logic(left,right,133),env,table,depth,budget-1) end
        end
      end
      end
    end
  end
  def nb_and_tail(source: bytes, left: bytes, env: bytes, table: bytes, depth: integer, budget: integer): bytes do
    if nc_pos(left) < 0 do b[] else
      pos = nc_start(source,nc_pos(left))
      is_and = if byte_at(source,pos) == 38 do nc_word(source,pos,b[38,38]) else if byte_at(source,pos) != 97 do 0 else nc_word(source,pos,b[97,110,100]) end end
      bits = if is_and == 1 do 0 else nk_bit_at(source,pos,b[38,38]) end
      if bits > 0 do if budget <= 0 do b[] else nb_and_tail(source,nk_bits(left,nc_comparison(source,pos+3,env,table,depth),bits),env,table,depth,budget-1) end else
      if is_and == 0 do left else
        if budget <= 0 do b[] else
          right = nc_comparison(source,nc_end(source,pos),env,table,depth)
          if nc_pos(right) < 0 do b[] else nb_and_tail(source,nb_logic(left,right,132),env,table,depth,budget-1) end
        end
      end
      end
    end
  end
  def nb_logic(left: bytes, right: bytes, cc: integer): bytes do
    if nc_tag(left) != 3 do b[] else
      if nc_tag(right) != 3 do b[] else
        size = Enum.count(nc_code(right))
        branch = Enum.concat(b[72,133,192,15,cc],nc_u32(size))
        nc_value(nc_pos(right),nc_join(nc_code(left),branch,nc_code(right)),b[3])
      end
    end
  end
  # Native smoke test; assembled with the compiler/runtime.
  def main() do System.halt(0) end
end
