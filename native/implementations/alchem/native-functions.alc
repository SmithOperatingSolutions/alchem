  def nf_postfix_call(source: bytes, value: bytes, env: bytes, table: bytes, depth: integer): bytes do
    next = nc_pos(value)
    kind = nc_kind(value)
    dotted = if nc_word(source,next,b[46]) == 1 do nc_end(source,next) else next end
    open = if nt_tag(kind) != 10 do -1 else if nc_word(source,dotted,b[40]) != 1 do -1 else
