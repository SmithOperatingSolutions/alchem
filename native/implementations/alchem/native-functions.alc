    held = if nc_pos(first) < 0 do 0 else if nu_has(kind,10,0,Enum.count(kind)) == 1 do 1 else if (nt_tag(kind)-9)*(nt_tag(kind)-12)*(nt_tag(kind)+1) == 0 do 0 else if stop < 0 do 0 else ny_has(source,pos,stop,b[102,110])+ny_has(source,pos,stop,b[38]) end end end end
