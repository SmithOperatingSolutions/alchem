  def nf_pipe_call(source: bytes, left: bytes, env: bytes, table: bytes, depth: integer, budget: integer): bytes do
    pos = nc_start(source,nc_pos(left))
    if nc_pos(left) < 0 do left else
      target = nc_start(source,pos+2)
      paren = nf_pipe_target(source,target)
