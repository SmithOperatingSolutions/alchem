    wanted = if Enum.count(held) > 0 do held else nc_return_kind(source,table,nc_read(env,0)) end
    usable = if paren < 0 do 0 else if (nt_tag(wanted)-9)*(nt_tag(wanted)-30)*(nt_tag(wanted)+1) == 0 do 0 else if Enum.count(nw_expected(env,paren,2)) > 0 do 0 else 1 end end end
