  # text |> IO.puts(), IO.write() or IO.warn() ends a pipeline as a statement: a
  # value of no type (12), which only a body or branch accepts, before its rest.
  def nf_pipe_output(source: bytes, target: integer, left: bytes): bytes do
    dot = if nc_word(source,target,b[73,79]) != 1 do -1 else nc_expect(source,nc_end(source,target),b[46]) end
    kind = ns_output_kind(source,dot)
    stop = nc_expect(source,nc_expect(source,nc_end(source,dot),b[40]),b[41])
    if kind == 0 do b[] else if stop < 0 do b[] else if nc_tag(left) != 2 do b[] else
      nc_value(stop,Enum.concat(nc_code(left),ns_output_emit(kind)),b[12])
    end end end
  end
  # A statement of no type, then the rest of its body.
  def nf_then(first: bytes, rest: bytes): bytes do
    if nc_pos(rest) < 0 do b[] else nc_value(nc_pos(rest),Enum.concat(nc_code(first),nc_code(rest)),nc_kind(rest)) end
  end
