  end
  # plan: the nesting, and 1 when the value at pos is held back by the
  # pipe after it.
  def nf_inferred_held(source: bytes, pos: integer, env: bytes, table: bytes, given: bytes, plan: bytes): bytes do
    depth = Enum.at(plan,0,0)
    last = nt_skip(given,0,nt_items(given,0)-1)
    words = nc_slice(given,0,last)
    if nf_general(source,pos) == 1 do nf_valued_held(source,pos,env,table,nt_function(given,nt_items(given,0)-1),plan) else
