  # says, whichever comes last. A function whose result type holds a
  # function type starts its body with such a record (nf_bodied).
  def nf_ambient(source: bytes, env: bytes, table: bytes): bytes do
    found = nf_ambient_from(env,2,b[])
    nc_slice(found,1,Enum.count(found))
  end
  def nf_bodied(source: bytes, table: bytes, id: integer, env: bytes): bytes do
    kind = nc_return_kind(source,table,id)
