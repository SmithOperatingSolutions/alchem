  # The piped value for the argument list that opens just before pos, as a
  # packet with the code that loads it; b[] when nothing is piped into it.
  def nf_piped(source: bytes, pos: integer, env: bytes): bytes do
    nn_plain(nf_piped_from(source,pos,env,2))
  end
  def nf_piped_from(source: bytes, pos: integer, env: bytes, offset: integer): bytes do
    nf_piped_at(source,pos,env,offset,0)
  end
  # slot: the slot of the record at offset.
  def nf_piped_at(source: bytes, pos: integer, env: bytes, offset: integer, slot: integer): bytes do
    start = nc_cursor(env,offset)
    if pos < 1 do b[] else if offset >= Enum.count(env) do b[] else
      if start != pos-1 do nf_piped_at(source,pos,env,nc_env_next(env,offset),slot+nc_env_weight(env,offset)) else
        if nc_cursor(env,offset+3) != start do nf_piped_at(source,pos,env,nc_env_next(env,offset),slot+nc_env_weight(env,offset)) else
