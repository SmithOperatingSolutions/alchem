  # Jump over the lambda's code, then allocate and fill its record.
  def nf_code(count: integer, captures: bytes, body: bytes): bytes do
    # The body starts with the entry code of its kind (nz_enter and others),
    # which counts the call; leaving ends it.
    inside = nc_join(nc_store_params(count,0),nf_loads(captures,count,0),Enum.concat(body,b[73,255,207,201,195]))
    lambda = Enum.concat(nc_guard(inside),inside)
    size = Enum.count(lambda)
    allocate = nc_join(Enum.concat(b[77,141,156,36],nc_u32(8+nc_units(Enum.count(captures),3)*8)),b[77,57,235,118,12],gm_hook())
    # lea rax,[rip-(size+32)]: the lambda starts size+32 bytes before the next instruction.
    address = nc_join(b[72,141,5],nc_u32(4294967296-size-32),b[73,137,4,36])
    record = nc_join(allocate,address,Enum.concat(nf_stores(captures,0),b[76,137,224,77,137,220]))
