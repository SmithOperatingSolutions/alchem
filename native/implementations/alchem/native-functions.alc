  # the record stays 0, as memory is when it is given out.
  def nf_stores(captures: bytes, index: integer): bytes do
    nf_stores_run(captures,index,nc_units(Enum.count(captures),3))
  end
  def nf_stores_run(captures: bytes, first: integer, stop: integer): bytes do
    if stop-first <= 0 do b[] else if stop-first == 1 do if nc_cursor(captures,first*3) == 16777215 do b[] else nc_join(nc_slot(b[72,139,69],nc_cursor(captures,first*3)),b[73,137,132,36],nc_u32(8+first*8)) end else
      Enum.concat(nf_stores_run(captures,first,first+nc_half(stop-first)),nf_stores_run(captures,first+nc_half(stop-first),stop))
    end end
