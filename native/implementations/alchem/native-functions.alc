  # Lambda entry: copy capture j from the record in R10 to slot count+j.
  def nf_loads(captures: bytes, count: integer, index: integer): bytes do
    nf_loads_run(count,index,nc_units(Enum.count(captures),3))
  end
  def nf_loads_run(count: integer, first: integer, stop: integer): bytes do
    if stop-first <= 0 do b[] else if stop-first == 1 do nc_join(b[73,139,130],nc_u32(8+first*8),nc_slot(b[72,137,69],count+first)) else
      Enum.concat(nf_loads_run(count,first,first+nc_half(stop-first)),nf_loads_run(count,first+nc_half(stop-first),stop))
    end end
