  # where the argument list finds it. Pipes bind looser than + and <> and
  # tighter than comparisons, and the target must be a call.
  # budget: how many more pipes the chain may hold (1024 in all, as the
  # pinned parser chains operators).
  def nf_pipes(source: bytes, left: bytes, env: bytes, table: bytes, depth: integer, budget: integer): bytes do
    pos = nc_start(source,nc_pos(left))
    shift = if nc_pos(left) < 0 do 0 else nk_bit_at(source,pos,b[60,62]) end
    # <<< and >>> bind as a pipe does; what follows is the next operand.
    if shift > 0 do if budget <= 0 do b[] else nf_pipes(source,nk_bits(left,nk_join_tail(source,nc_sum(source,pos+3,env,table,depth),env,table,depth,1024),shift),env,table,depth,budget-1) end else
    if nc_pos(left) < 0 do left else if byte_at(source,pos)*256+byte_at(source,pos+1) != 31806 do left else
      target = nc_start(source,pos+2)
      output = nf_pipe_output(source,target,left)
      if nc_pos(output) >= 0 do output else if budget <= 0 do b[] else nf_pipe_call(source,left,env,table,depth,budget) end end
