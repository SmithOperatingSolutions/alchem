        if nc_word(source,start,b[105,102])+nc_word(source,start,b[117,110,108,101,115,115])+nc_word(source,start,b[99,97,115,101])+nc_word(source,start,b[99,111,110,100]) > 0 do nc_end(source,nc_body_scan(source,start,0,16777216)) else
          if nf_untyped(source,start) == 0 do -1 else nf_deferred(source,start,env,table) end
