          if byte_at(source,start) != 40 do b[] else if nc_env_tag(env,offset) == 21 do nf_piped_at(source,pos,env,nc_env_next(env,offset),slot+nc_env_weight(env,offset)) else nc_value(pos,nc_slot(b[72,139,69],slot),nt_read(env,offset+7)) end end
        end
