  # The checked arguments of a call through a value of type kind; open is the "(".
  def nf_call_args(source: bytes, open: integer, env: bytes, table: bytes, depth: integer, kind: bytes): bytes do
    wanted = nt_count(kind)
    parsed = if nt_tag(kind) != 10 do b[] else nc_arguments_open(source,nc_end(source,open),env,table,depth) end
    args = if nf_has_pending(parsed,0) == 0 do parsed else nf_typed_all(source,env,table,depth,parsed,Enum.concat(nc_u24(nc_arg_count(parsed)-1),nf_words(kind,0,wanted))) end
