  def nf_same_line(source: bytes, pos: integer, stop: integer): integer do
    middle = pos+nc_half(stop-pos)
    if pos >= stop do 1 else if stop-pos == 1 do if byte_at(source,pos) == 10 do 0 else 1 end else
      if nf_same_line(source,pos,middle) == 0 do 0 else nf_same_line(source,middle,stop) end
    end end
  end
  def nf_check(kind: bytes, args: bytes, index: integer, count: integer): integer do
    if index == count do 1 else
      if no_compatible(nt_child(kind,index),nc_arg_kind(args,index)) == 0 do 0 else nf_check(kind,args,index+1,count) end
    end
  end
