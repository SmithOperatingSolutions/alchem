  def nf_pipe_taken(source: bytes, call: bytes, taken: integer): integer do
    next = nc_start(source,nc_pos(call))
    value = byte_at(source,next)
    operator = if (value-43)*(value-45)*(value-42)*(value-47) == 0 do 1 else if value*256+byte_at(source,next+1) == 15422 do 1 else if value*256+byte_at(source,next+1) == 11816 do 1 else 0 end end end
    if operator == 1 do 0 else taken end
