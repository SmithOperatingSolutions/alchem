      # _ is one, so that several parameters may be _ (fn key, _, _ -> ... end).
      plain = if nc_word(source,name,b[95]) == 1 do 0 else np_plain_name(source,name) end
      bound = if index >= nt_items(words,0) do b[] else if plain == 0 do np_hidden(inner,name,nt_item(words,index)) else nc_bind(source,name,inner,nt_item(words,index)) end end
      next = if plain == 0 do np_skip(source,name) else nc_end(source,name) end
