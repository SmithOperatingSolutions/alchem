  def nf_both_open(env: bytes, first: bytes, second: bytes): integer do
    if nf_open_end(env,2,0) != 3 do 0 else if nc_tag(first) == 9 do 0 else if nc_tag(second) == 9 do 0 else nu_holes(nc_kind(first),0)*nu_holes(nc_kind(second),0) end end end
