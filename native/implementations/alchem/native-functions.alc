  def nf_parted(source: bytes, env: bytes, table: bytes): integer do
    kind = nf_ambient(source,env,table)
    if (nt_tag(kind)-7)*(nt_tag(kind)-8)*(nt_tag(kind)-5) != 0 do 0 else nf_worth(kind) end
  end
