  # 1 when code holds the bytes wanted at a position from first up to stop.
  def nf_holds(code: bytes, wanted: bytes, first: integer, stop: integer): integer do
    middle = first+nc_half(stop-first)
    if stop-first <= 0 do 0 else
      if stop-first == 1 do
        if Enum.at(code,first,0) != Enum.at(wanted,0,0) do 0 else nt_same(nc_slice(code,first,first+Enum.count(wanted)),wanted) end
      else
        if nf_holds(code,wanted,first,middle) == 1 do 1 else nf_holds(code,wanted,middle,stop) end
      end
    end
