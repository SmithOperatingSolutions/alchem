defmodule NativeFunctions do
  # Function values are pointers to records whose first word is the code address,
  # followed by captured values. Callers pass the record in R10; a function-table
  # slot is such a record with no captures, so &name needs no allocation.
  # fn(x: integer, y: string): integer do body end
  def nf_lambda(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    params = nc_expect(source,nc_end(source,pos),b[40])
    shape = if params < 0 do b[] else if nc_word(source,params,b[41]) == 1 do Enum.concat(nc_u24(nc_end(source,params)),b[0,0,0]) else nc_parameters(source,params,0) end end
    if nc_pos(shape) < 0 do b[] else
      count = nc_cursor(shape,3)
      declared = nc_type(source,nc_expect(source,nc_pos(shape),b[58]))
      owner = nc_owner(table,nc_read(env,0))
      body = nc_expect(source,nc_pos(declared),b[100,111])
      inner = if body < 0 do b[] else nc_env(source,params,nc_u16(nc_read(env,0)),count,table) end
      # A result type that is none (`fn(a: integer): Zed do`) leaves no spec.
      spec = if Enum.count(inner) == 0 do b[] else nc_value(body,inner,nd_resolve(source,table,owner,nc_kind(declared))) end
      if nc_pos(spec) < 0 do b[] else
        nf_finish(source,env,table,depth,spec,nl_parameter_words(source,params,count,table,owner))
      end
    end
  end
  # spec: body position, parameter environment and declared result type. An
  # inferred lambda has declared type 9 (unknown), then a byte for its form: 0 or none for
  # fn ... end, 1 for the capture &name(...), 2 for the capture &(...), 3 for
  # the text made for a library function by arity.
  def nf_finish(source: bytes, env: bytes, table: bytes, depth: integer, spec: bytes, words: bytes): bytes do
    captures = nf_captures(env,2)
    scope = nj_scoped(nf_capture_env(source,env,nc_code(spec),captures,0),spec)
    form = if nc_tag(spec) == 9 do Enum.at(nc_kind(spec),1,0) else 0 end
    # fn p, q -> ... holds the position of its parameters: patterns among them
    # are matched before the body.
    shaped = if Enum.count(scope) == 0 do b[] else if nc_tag(spec) != 9 do np_pack(0,b[],scope) else if nc_cursor(nc_kind(spec),2) == 0 do np_pack(0,b[],scope) else np_lambda(source,nc_cursor(nc_kind(spec),2),scope,table,0) end end end
    inner = if nc_pos(shaped) < 0 do b[] else
      if form == 0 do nj_lambda_body(source,nc_pos(spec),gm_scope(source,table,if nc_tag(spec) == 9 do nc_cursor(nc_kind(spec),2) else 0 end,np_env(shaped)),table,depth+1) else nc_expression(source,nc_pos(spec),np_env(shaped),table,depth+1) end
    end
    # A body that ends in a statement gives the empty tuple.
    unit = if nc_tag(inner) == 12 do 1 else 0 end
    begin = nc_start(source,nc_pos(spec))
    enter = if form == 0 do tl_fn_enter(source,env,table,begin) else nz_enter_plain(if nc_cursor(table,21) == 0 do begin else nc_cursor(table,21) end) end
    value = if nc_pos(inner) < 0 do b[] else nc_value(nc_pos(inner),nc_join(nc_join(enter,zf_cover_fn(source,table,env,nc_join(b[form],nc_u24(begin),nc_u24(if nc_tag(spec) != 9 do 0 else nc_cursor(nc_kind(spec),2) end)),Enum.count(np_tree(shaped))),np_tree(shaped)),nc_code(inner),Enum.concat(if unit == 1 do nc_join(nc_allocate_emit(0),b[72,199,2,0,0,0,0],b[72,137,208]) else b[] end,if form == 0 do tl_fn_leave(source,env,table) else b[] end)),if unit == 1 do b[5,0] else nc_kind(inner) end) end
    gm_shed(source,env,table,if form != 0 do 0 else if nc_tag(spec) == 9 do nc_cursor(nc_kind(spec),2) else nc_pos(spec) end end,nf_seal(source,spec,if nw_marked(inner) == 1 do nw_mark(value) else value end,words,gm_held(env,2),form))
  end
  def nf_seal(source: bytes, spec: bytes, value: bytes, words: bytes, captures: bytes, form: integer): bytes do
    count = nc_env_count(nc_code(spec),2)
    stop = nc_pos(value)
    after = if form == 0 do nc_expect(source,stop,b[101,110,100]) else if form == 2 do nc_expect(source,stop,b[41]) else stop end end
    # A capture has as many parameters as its highest placeholder.
    used = if (form-0)*(form-3) == 0 do 1 else nf_uses(source,nc_pos(spec),stop,count) end
    # An inferred lambda takes its result type from its body; one whose every
    # way out raises never gives a value, and its result is the empty tuple.
    # Where a result type is expected the body is held to it, so a body that
    # is none, [] or ok(x) has its whole type.
    asked = if nc_tag(spec) == 9 do nc_slice(nc_kind(spec),5,Enum.count(nc_kind(spec))) else b[] end
    result = if nc_tag(spec) == 9 do if Enum.count(asked) > 0 do asked else if nt_same(nc_kind(value),b[9]) == 1 do b[5,0] else nc_kind(value) end end else nc_kind(spec) end
    kind = nt_function(Enum.concat(words,nt_cell(result)),count)
    # A body that needed a type from its context has none to take when no result type is expected.
    lost = if nc_tag(spec) != 9 do 0 else if Enum.count(asked) > 0 do 0 else nw_marked(value) end end
    if after < 0 do b[] else if used+(1-lost) < 2 do b[] else if stop < 0 do b[] else
      if no_compatible(result,nc_kind(value)) == 0 do b[] else nc_value(after,nf_code(count,captures,nc_code(value)),kind) end
    end end end
  end
  # fn x, y -> body end: 1 when the fn at pos is this unannotated form. fn( is the
  # annotated form and fn[ a type.
  def nf_untyped(source: bytes, pos: integer): integer do
    if nc_word(source,pos,b[102,110]) != 1 do 0 else
      next = nc_end(source,nc_start(source,pos))
      # fn[integer, integer] is the function type; fn [head | tail] -> ... is a
      # lambda whose first parameter is a list pattern: its parameters lead to
      # an arrow.
      if nc_word(source,next,b[40]) == 1 do 0 else if nc_word(source,next,b[91]) == 0 do 1 else nf_arrow_after(source,np_skip(source,next),250) end end
    end
  end
  # 1 when the parameters from pos on (each after a comma) end in an arrow.
  def nf_arrow_after(source: bytes, pos: integer, budget: integer): integer do
    if pos < 0 do 0 else if nc_word(source,pos,b[45,62]) == 1 do 1 else
      if budget == 0 do 0 else if nc_word(source,pos,b[44]) == 0 do 0 else nf_arrow_after(source,np_skip(source,nc_end(source,pos)),budget-1) end end
    end end
  end
  # An argument whose types come from its callee: fn x -> ... end or a capture.
  # 0 for any other expression, else the position after it (-1 when malformed).
  # The packet records such an argument as kind 11 with its source position and
  # no code until the callee's parameter types are known.
  def nf_deferred(source: bytes, pos: integer, env: bytes, table: bytes): integer do
    start = nc_start(source,pos)
    if nf_untyped(source,start) == 1 do
      close = nc_body_end(source,nc_end(source,start),16777216)
      if close < 0 do -1 else nc_end(source,close) end
    else
      if nf_capture_form(source,start) == 0 do if nc_word(source,start,b[38]) != 1 do 0 else nc_pos(nf_library_form(source,start,env,table))+1 end else if byte_at(source,start+1) == 40 do np_close(source,start+1,0,16777216) else nc_span(source,nc_span_state(start,0,0,0,0),16777216) end end
    end
  end
  # How many parameters the builtin function Module.name has that a
  # reference may name without its arity (Builtins): -1 for any other.
  def nf_simple(source: bytes, name: integer, last: integer): integer do
    if nf_simple_one(source,name,last) > 0 do 1 else if nf_simple_two(source,name,last) > 0 do 2 else if nf_simple_pair(source,name,last,b[83,116,114,105,110,103],b[114,101,112,108,97,99,101]) > 0 do 3 else -1 end end end
  end
  def nf_simple_pair(source: bytes, name: integer, last: integer, module: bytes, function: bytes): integer do
    if nc_word(source,name,module) == 1 do nc_word(source,last,function) else 0 end
  end
  def nf_simple_one(source: bytes, name: integer, last: integer): integer do
    nf_simple_pair(source,name,last,b[83,116,114,105,110,103],b[114,101,118,101,114,115,101])+nf_simple_pair(source,name,last,b[70,108,111,97,116],b[102,114,111,109,95,105,110,116,101,103,101,114])+nf_simple_pair(source,name,last,b[70,108,111,97,116],b[116,111,95,115,116,114,105,110,103])+nf_simple_pair(source,name,last,b[70,108,111,97,116],b[102,108,111,111,114])+nf_simple_pair(source,name,last,b[70,108,111,97,116],b[99,101,105,108])+nf_simple_pair(source,name,last,b[70,108,111,97,116],b[112,97,114,115,101])+nf_simple_pair(source,name,last,b[70,105,108,101],b[114,101,109,111,118,101])+nf_simple_pair(source,name,last,b[70,105,108,101],b[108,105,115,116])+nf_simple_pair(source,name,last,b[70,105,108,101],b[101,120,105,115,116,115])+nf_simple_pair(source,name,last,b[83,121,115,116,101,109],b[101,110,118])+nf_simple_pair(source,name,last,b[73,79],b[119,114,105,116,101])
  end
  def nf_simple_two(source: bytes, name: integer, last: integer): integer do
    nf_simple_pair(source,name,last,b[83,116,114,105,110,103],b[115,116,97,114,116,115,95,119,105,116,104])+nf_simple_pair(source,name,last,b[83,116,114,105,110,103],b[101,110,100,115,95,119,105,116,104])+nf_simple_pair(source,name,last,b[70,105,108,101],b[119,114,105,116,101])+nf_simple_pair(source,name,last,b[70,105,108,101],b[97,112,112,101,110,100])
  end
  # &name/N or &Module.name/N at pos where the program has no such function or
  # module: a library function by arity. The position after it, with the text
  # &name or &Module.name as code and N as kind; b[] for anything else.
  def nf_library_form(source: bytes, pos: integer, env: bytes, table: bytes): bytes do
    name = nc_start(source,nc_end(source,pos))
    dotted = nc_word(source,nc_end(source,name),b[46])
    # The function's name follows its module names: IO.ANSI.red.
    last = sg_referred(source,pos)
    slash = nc_end(source,last)
    given = if nc_word(source,slash,b[47]) != 1 do -1 else nf_index(source,nc_end(source,slash)) end
    known = nj_aimed(source,table,nf_target(source,name,env,table),given)
    # A generic function is such a capture too, with or without its arity: each
    # use settles its types. So is a function of several forms: the use says
    # which form.
    generic = if known < 0 do 0 else if nj_formed(source,table,known) == 1 do 1 else nu_generic(source,table,known) end end
    arity = if given < 0 do if generic == 1 do nc_argc(table,known) else if known >= 0 do -1 else if dotted == 1 do nf_simple(source,name,last) else -1 end end end else given end
    stop = if given < 0 do slash else nc_end(source,nc_end(source,slash)) end
    plain = if known < 0 do 0 else 1-generic end
    if nc_word(source,pos,b[38]) != 1 do b[] else if arity < 0 do b[] else if plain == 1 do b[] else
      if classify_ascii(byte_at(source,name))*classify_ascii(byte_at(source,last)) != 4 do b[] else if sg_unknown(source,name,dotted,known) == 1 do b[] else
        text = sg_dotted(source,name,last)
        nc_value(stop-1,Enum.concat(b[38],text),b[arity])
      end end
    end end end
  end
  # The function that name or Module.name at pos refers to, for a function of
  # the module or a public one of a module it imports directly; -1 otherwise.
  def nf_target(source: bytes, pos: integer, env: bytes, table: bytes): integer do
    owner = nc_owner(table,nc_read(env,0))
    stop = nc_end(source,pos)
    home = nc_find(source,pos,table,-1)
    name = nc_start(source,nc_end(source,stop))
    if nc_word(source,stop,b[46]) != 1 do nc_find(source,pos,table,owner) else
      target = if home < 0 do -1 else if nc_imported(source,table,owner,home) == 0 do -1 else nc_find(source,name,table,home) end end
      if target < 0 do -1 else if home == owner do target else if Enum.at(table,target*27+16,0) != 0 do -1 else target end end end
    end
  end
  # "&1,&2" for count placeholders.
  def nf_holes(count: integer, index: integer): bytes do
    if index >= count do b[] else
      Enum.concat(if index == 0 do b[38,49] else b[44,38,49+index] end,nf_holes(count,index+1))
    end
  end
  # A library function by arity is the capture &name(&1, ..., &N): compiled from
  # that text, which names nothing of the enclosing function.
  def nf_library(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, words: bytes): bytes do
    target = nf_target(source,nc_start(source,nc_end(source,pos)),env,table)
    built = if target >= 0 do b[] else nf_library_text(source,pos,env,table,depth,words) end
    # A function the compiler has no code of its own for is one written in Alchem.
    if target >= 0 do nf_generic(source,pos,env,table,words,target) else if nc_pos(built) >= 0 do built else sg_reference(source,pos,env,table,words) end end
  end
  # &name/N for a generic function of the module: a function value that calls
  # it with the types this use settles, and the comparators they need.
  def nf_generic(source: bytes, pos: integer, env: bytes, table: bytes, words: bytes, target: integer): bytes do
    form = nf_library_form(source,pos,env,table)
    count = nt_items(words,0)
    captures = nf_captures(env,2)
    scope = nf_capture_env(source,env,nf_unnamed(nc_u16(nc_read(env,0)),words,0),captures,0)
    packet = nc_arg_packet(0,count,Enum.concat(words,nt_cell(nc_zeros(count))),nf_pushes(count,0))
    # Of a function of several forms, the form these parameter types fit.
    fit = nj_form(source,table,nj_aimed(source,table,target,count),packet)
    value = if nc_pos(form) < 0 do b[] else if nc_tag(form) != count do b[] else if Enum.count(scope) == 0 do b[] else if fit < 0 do b[] else nu_call(source,scope,table,0,packet,nc_u16(fit)) end end end end
    kind = nt_function(Enum.concat(words,nt_cell(nc_kind(value))),count)
    if nc_pos(value) < 0 do b[] else nc_value(nc_pos(form)+1,nf_code(count,gm_held(env,2),Enum.concat(nz_enter_plain(nc_start(source,pos)),nc_code(value))),kind) end
  end
  # Parameters without names, one per type in words.
  def nf_unnamed(inner: bytes, words: bytes, index: integer): bytes do
    if index == nt_items(words,0) do inner else nf_unnamed(np_hidden(inner,0,nt_item(words,index)),words,index+1) end
  end
  # Push parameters index.. of count from their slots.
  def nf_pushes(count: integer, index: integer): bytes do
    if index >= count do b[] else Enum.concat(Enum.concat(nc_slot(b[72,139,69],index),b[80]),nf_pushes(count,index+1)) end
  end
  def nf_library_text(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, words: bytes): bytes do
    form = nf_library_form(source,pos,env,table)
    count = nt_items(words,0)
    text = nc_join(nc_code(form),Enum.concat(b[40],nf_holes(count,0)),b[41])
    scope = nc_u16(nc_read(env,0))
    if nc_pos(form) < 0 do b[] else if nc_tag(form) != count do b[] else if nf_nested(source,env,2) == 1 do b[] else
      # A failure in the function names the reference, as does its closure.
      value = nf_finish(text,jd_carried_scope(scope,env),zf_cover_text(source,nj_from(table,nc_start(source,pos)),env,nc_start(source,pos)),depth,nc_value(1,nf_placeholders(0,scope,words,0),b[9,3]),words)
      if nc_pos(value) != Enum.count(text) do b[] else nc_value(nc_pos(form)+1,nc_code(value),nc_kind(value)) end
    end end end
  end
  # &(...), &name(...), &Module.name(...) and &value.(...) are captures; &name,
  # &name/1 and &Module.name are references.
  def nf_capture_form(source: bytes, pos: integer): integer do
    if nc_word(source,pos,b[38]) != 1 do 0 else nf_capture_name(source,nc_end(source,pos),4) end
  end
  def nf_capture_name(source: bytes, pos: integer, budget: integer): integer do
    start = nc_start(source,pos)
    if nc_word(source,start,b[40]) == 1 do 1 else if budget == 0 do 0 else
      if classify_ascii(byte_at(source,start)) != 2 do 0 else
        next = nc_end(source,start)
        if nc_word(source,next,b[40]) == 1 do 1 else
          if nc_word(source,next,b[46]) == 1 do nf_capture_name(source,nc_end(source,next),budget-1) else 0 end
        end
      end
    end end
  end
  def nf_has_pending(args: bytes, index: integer): integer do
    if nc_pos(args) < 0 do 0 else if index >= nc_arg_count(args) do 0 else
      if nt_tag(nc_arg_kind(args,index)) == 11 do 1 else nf_has_pending(args,index+1) end
    end end
  end
  # Callees that give no types reject deferred lambdas.
  def nf_settled(args: bytes): bytes do
    if nf_has_pending(args,0) == 1 do b[] else args end
  end
  # Compile a deferred argument now that its parameter types are known, and place
  # its code where the argument stands. target: the argument index, then one
  # type word per lambda parameter.
  def nf_resolve(source: bytes, env: bytes, table: bytes, depth: integer, args: bytes, target: bytes): bytes do
    index = nc_cursor(target,0)
    pending = nc_arg_kind(args,index)
    offset = nc_cursor(pending,4)
    # After the index (3 bytes): a zero and the type wanted, or the types of a function's parameters and result.
    # A piped value (an eighth byte: its slot and 1) stands before |>, and
    # passes through its slot, which says that the call took it.
    slot = nc_cursor(pending,7)-1
    held = if slot < 0 do 0 else 1 end
    value = if Enum.at(target,3,1) == 0 do nf_valued_held(source,nc_cursor(pending,1),env,table,nc_slice(target,4,Enum.count(target)),b[depth,held]) else nf_inferred_held(source,nc_cursor(pending,1),env,table,nc_slice(target,3,Enum.count(target)),b[depth,held]) end
    after = nc_pos(value)
    code = nc_arg_code(args)
    kept = if slot < 0 do b[] else Enum.concat(nc_slot(b[72,137,69],slot),nc_slot(b[72,139,69],slot)) end
    if after < 0 do b[] else if nc_word(source,after,b[44])+nc_word(source,after,b[41])+(if slot < 0 do 0 else 1 end) == 0 do b[] else
      kinds = nt_replace(nc_arg_types(args),index,nc_kind(value))
      nc_arg_packet(nc_pos(args),nc_arg_count(args),kinds,nc_join(nc_slice(code,0,offset),nc_join(nc_code(value),kept,b[80]),nc_slice(code,offset,Enum.count(code))))
    end end
  end
  def nf_is_pending(args: bytes): integer do
    count = nc_arg_count(args)
    if nc_pos(args) < 0 do 0 else if count == 0 do 0 else if nt_tag(nc_arg_kind(args,count-1)) == 11 do 1 else 0 end end end
  end
  # Enum.map/filter callbacks take the element; Enum.reduce takes element and accumulator.
  # plan: the function's number, and from 256 on the position after the
  # call's "(": what is expected of the call (a record there) gives a list
  # that is [] its type for filter, the function its result type for map,
  # and the accumulator its type for reduce.
  def nf_enum_args(source: bytes, env: bytes, table: bytes, depth: integer, args: bytes, plan: integer): bytes do
    op = nt_mod(plan,256)
    wanted = if plan < 256 do b[] else nw_expected(env,nt_div(plan,256)-1,2) end
    if nf_is_pending(args) == 0 do nf_settled(args) else if Enum.count(wanted) == 0 do nf_enum_typed(source,env,table,depth,args,b[op,if op == 13 do 3 else 9 end]) else
      seen = if op == 12 do 1 else 0 end
      merged = if (op-12)*(op-13) != 0 do b[] else nt_merge(nc_arg_kind(args,seen),wanted) end
      given = if Enum.count(merged) == 0 do args else nc_arg_packet(nc_pos(args),nc_arg_count(args),nt_replace(nc_arg_types(args),seen,merged),nc_arg_code(args)) end
      asked = if op == 12 do wanted else if op == 11 do if nt_tag(wanted) == 7 do nt_child(wanted,0) else b[9] end else if op == 13 do b[3] else b[9] end end end
      nf_enum_typed(source,env,table,depth,given,Enum.concat(b[op],asked))
    end end
  end
  # plan: the function's number, then the result type asked of the callback (9: any).
  def nf_enum_typed(source: bytes, env: bytes, table: bytes, depth: integer, args: bytes, plan: bytes): bytes do
    op = Enum.at(plan,0,0)
    if nf_is_pending(args) == 0 do nf_settled(args) else
      items = nc_arg_kind(args,0)
      element = if op == 15 do nt_cell(nl_each_item(items)) else nt_cell(nt_child(items,0)) end
      count = nc_arg_count(args)
      wanted = if op == 12 do 3 else if (op-11)*(op-13)*(op-15) == 0 do 2 else 0 end end
      listed = if nt_tag(items) == 7 do 1 else if op == 15 do if nt_tag(items) == 8 do 1 else 0 end else 0 end end
      if listed == 0 do b[] else if count != wanted do b[] else if nw_generic_reference(source,env,table,nc_arg_kind(args,count-1)) == 1 do b[] else
        nf_settled(nf_resolve(source,env,table,depth,args,nc_join(nc_u24(count-1),if op == 12 do Enum.concat(element,nt_cell(nc_arg_kind(args,1))) else element end,nt_cell(nc_slice(plan,1,Enum.count(plan))))))
      end end end
    end
  end
  # Deferred arguments from the last down to the first, each for a parameter of
  # type fn[...]. plan: the index to look at, then one type word per parameter.
  # Later arguments go first, so earlier code offsets stay valid.
  def nf_typed_all(source: bytes, env: bytes, table: bytes, depth: integer, args: bytes, plan: bytes): bytes do
    index = nc_cursor(plan,0)
    kind = nt_item(nc_slice(plan,3,Enum.count(plan)),index)
    done = if nt_tag(nc_arg_kind(args,index)) != 11 do args else
      nf_resolve(source,env,table,depth,args,nc_join(nc_u24(index),b[0],kind))
    end
    if nc_pos(done) < 0 do b[] else if index == 0 do done else
      nf_typed_all(source,env,table,depth,done,Enum.concat(nc_u24(index-1),nc_slice(plan,3,Enum.count(plan))))
    end end
  end
  # A lambda where type kind (fn[...]) is expected.
  def nf_expected(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer, kind: bytes): bytes do
    # Type 30 says that a later branch is to give the type (nf_hinting):
    # the lambda stands for a value of unknown type until then.
    if nt_tag(kind) == 30 do nf_unknown(source,pos,env,table) else if nt_tag(kind) != 10 do b[] else nf_inferred(source,nc_start(source,pos),env,table,depth,nf_words(kind,0,nt_count(kind)+1)) end end
  end
  def nf_unknown(source: bytes, pos: integer, env: bytes, table: bytes): bytes do
    stop = nf_deferred(source,nc_start(source,pos),env,table)
    if stop <= 0 do b[] else nw_mark(nc_value(stop,b[],b[9])) end
  end
  # The first branch of an if, or an arm of a case or cond, that does not
  # compile for want of a lambda's type waits for the branches after it, as
  # the pinned compiler holds such a branch back: it is compiled with
  # lambdas standing for values of unknown type (nf_hinting), only to find
  # where it ends; the others then give the type, and it is compiled again
  # expecting that. b[] inside such a trial: one is enough.
  def nf_hinting(source: bytes, env: bytes, table: bytes): bytes do
    if nt_tag(nf_ambient(source,env,table)) == 30 do b[] else nw_expect(env,0,b[30]) end
  end
  # The same for the branch that starts at pos, and only when a lambda or
  # capture stands before the end of its form: any other failure is no
  # want of a type, and a trial at each of 250 nested forms would cost the
  # cube of their number.
  def nf_trial(source: bytes, pos: integer, env: bytes, table: bytes): bytes do
    # From a form in parentheses the scan ends at its own end.
    closing = wc_scan(source,pos,0)
    opener = if closing >= 0 do -1 else wc_scan(source,pos,3) end
    stop = if closing >= 0 do closing else if opener < 0 do -1 else wc_scan(source,nc_end(source,opener),0) end end
    if stop < 0 do b[] else if ny_has(source,pos,stop,b[102,110])+ny_has(source,pos,stop,b[38]) == 0 do b[] else nf_hinting(source,env,table) end end
  end
  # env for the branch held back, given what the others made; b[] when
  # they give no settled type.
  def nf_settling(env: bytes, others: bytes): bytes do
    kind = nc_kind(others)
