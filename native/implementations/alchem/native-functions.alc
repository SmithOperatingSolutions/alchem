      if byte_at(source,next) == 40 do next else
        if nc_word(source,next,b[46]) != 1 do -1 else
          if byte_at(source,nc_start(source,nc_end(source,next))) == 40 do nc_start(source,nc_end(source,next)) else nf_pipe_target(source,nc_start(source,nc_end(source,next))) end
        end
      end
    end
