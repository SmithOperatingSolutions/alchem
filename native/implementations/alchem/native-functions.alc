  # block: the block's value is expected to be what its function, or the
  # fn it is in, gives, and the call takes that as its own expected type.
  def nf_tail(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    paren = nw_last_call(source,start)
