      nc_join(nc_slice(env,offset,at),if nc_env_gap(env,at) > 0 do b[] else nc_env_record(nc_cursor(env,at),nc_cursor(env,at),nt_read(env,at+7)) end,nf_carried(source,env,nc_env_next(env,at)))
