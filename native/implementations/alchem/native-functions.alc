    # visible inside a nested function), as are the nameless records of piped
    # values and of case subjects. A name the function has already (a
    # parameter) may not be captured too.
    if Enum.count(inner) == 0 do b[] else if nf_clashes(source,env,inner,2) == 1 do b[] else Enum.concat(inner,nf_carried(source,env,2)) end end
