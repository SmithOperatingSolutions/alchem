  # pos follows the name; id is its table entry.
  # A name with other numbers of parameters needs its arity; with defaults it
  # is still the function of all its parameters. strict: 1 from another
  # module, which only reaches a def.
  def nf_slot(source: bytes, pos: integer, table: bytes, named: integer, strict: integer): bytes do
    slashed = nc_word(source,pos,b[47])
    given = if slashed == 1 do nf_index(source,nc_end(source,pos)) else -1 end
    id = if named < 0 do -1 else if slashed == 1 do nj_fit_from(source,table,named,given,b[0,0,0,1]) else if nj_alone(source,table,named) == 1 do named else -1 end end end
    stop = if slashed == 1 do nc_end(source,nc_end(source,pos)) else pos end
    # A generic function has no plain reference: its comparators come with each use.
    if id < 0 do b[] else if Enum.at(table,id*27+16,0) == 1 do b[] else if strict*Enum.at(table,id*27+16,0) != 0 do b[] else if nu_generic(source,table,id) == 1 do b[] else
      kind = nt_function(Enum.concat(nj_cells(source,table,id),nt_cell(nc_return_kind(source,table,id))),nc_argc(table,id))
      if nt_tag(kind) < 0 do b[] else nc_value(stop,Enum.concat(b[184],nc_u32(4195456+id*8)),kind) end
    end end end end
  end
  def nf_names(source: bytes, pos: integer, inner: bytes, words: bytes): bytes do
    index = nc_env_count(inner,2)
    if nc_word(source,pos,b[45,62]) == 1 do
      if index != nt_items(words,0) do b[] else nc_value(nc_end(source,pos),inner,b[0]) end
    else
      name = nc_start(source,pos)
