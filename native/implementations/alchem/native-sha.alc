defmodule NativeSha do
  # SHA-256 on the bitwise operators, for the compiler that makes macOS
  # programs, which signs each 4096-byte page of one. The functions of these
  # names in native-macho.alc do the same with tables of bytes, for the seed
  # frontend, which has no such operators; the builds of the macOS compiler
  # put these in their place (scripts/bootstrap-alchem-compiler.py, darwin).
  def sh_tables(): bytes do b[] end
  # The 32-bit word, high byte first, at p of data.
  def sh_at(data: bytes, p: integer): integer do
    (Enum.at(data,p,0) <<< 24) ||| (Enum.at(data,p+1,0) <<< 16) ||| (Enum.at(data,p+2,0) <<< 8) ||| Enum.at(data,p+3,0)
  end
  # x, of 32 bits, rotated right n bits; the bits above the 32nd are not
  # cleared.
  def sh_turn(x: integer, n: integer): integer do (x >>> n) ||| (x <<< (32-n)) end
  # What a later word of the schedule takes from the words a before it by 2
  # (one) and by 15 (zero).
  def sh_one(x: integer): integer do (sh_turn(x,17) ^^^ sh_turn(x,19) ^^^ (x >>> 10)) &&& 4294967295 end
  def sh_zero(x: integer): integer do (sh_turn(x,7) ^^^ sh_turn(x,18) ^^^ (x >>> 3)) &&& 4294967295 end
  # Two rounds. p0 to p7 are the sixteen words of the schedule from word n
  # on, two to a number, the first in the high half.
  def sh_two(k: bytes, n: integer, p0: integer, p1: integer, p2: integer, p3: integer, p4: integer, p5: integer, p6: integer, p7: integer, state: bytes, a: integer, b: integer, c: integer, d: integer, e: integer, f: integer, g: integer, h: integer): bytes do
    if n == 64 do sh_sum(state,a,b,c,d,e,f,g,h) else
      w0 = (p0 >>> 32) &&& 4294967295
      w1 = p0 &&& 4294967295
      t1 = h+((sh_turn(e,6) ^^^ sh_turn(e,11) ^^^ sh_turn(e,25)) &&& 4294967295)+(g ^^^ (e &&& (f ^^^ g)))+sh_at(k,n*4)+w0
      t2 = ((sh_turn(a,2) ^^^ sh_turn(a,13) ^^^ sh_turn(a,22)) &&& 4294967295)+((a &&& b) ^^^ (c &&& (a ^^^ b)))
      e1 = (d+t1) &&& 4294967295
      a1 = (t1+t2) &&& 4294967295
      u1 = g+((sh_turn(e1,6) ^^^ sh_turn(e1,11) ^^^ sh_turn(e1,25)) &&& 4294967295)+(f ^^^ (e1 &&& (e ^^^ f)))+sh_at(k,n*4+4)+w1
      u2 = ((sh_turn(a1,2) ^^^ sh_turn(a1,13) ^^^ sh_turn(a1,22)) &&& 4294967295)+((a1 &&& a) ^^^ (b &&& (a1 ^^^ a)))
      x = (sh_one((p7 >>> 32) &&& 4294967295)+(p4 &&& 4294967295)+sh_zero(w1)+w0) &&& 4294967295
      y = (sh_one(p7 &&& 4294967295)+((p5 >>> 32) &&& 4294967295)+sh_zero((p1 >>> 32) &&& 4294967295)+w1) &&& 4294967295
      sh_two(k,n+2,p1,p2,p3,p4,p5,p6,p7,(x <<< 32) ||| y,state,(u1+u2) &&& 4294967295,a1,a,b,(c+u1) &&& 4294967295,e1,e,f)
    end
  end
  def sh_four(v: integer): bytes do b[(v >>> 24) &&& 255,(v >>> 16) &&& 255,(v >>> 8) &&& 255,v &&& 255] end
  def sh_sum(state: bytes, a: integer, b: integer, c: integer, d: integer, e: integer, f: integer, g: integer, h: integer): bytes do
    nc_join(nc_join(sh_four(sh_at(state,0)+a),sh_four(sh_at(state,4)+b),sh_four(sh_at(state,8)+c)),nc_join(sh_four(sh_at(state,12)+d),sh_four(sh_at(state,16)+e),sh_four(sh_at(state,20)+f)),Enum.concat(sh_four(sh_at(state,24)+g),sh_four(sh_at(state,28)+h)))
  end
  def sh_pair(data: bytes, p: integer): integer do (sh_at(data,p) <<< 32) ||| sh_at(data,p+4) end
  def sh_blocks(t: bytes, x: bytes, data: bytes, p: integer, k: bytes): bytes do
    if p >= Enum.count(data) do x else
      sh_blocks(t,sh_two(k,0,sh_pair(data,p),sh_pair(data,p+8),sh_pair(data,p+16),sh_pair(data,p+24),sh_pair(data,p+32),sh_pair(data,p+40),sh_pair(data,p+48),sh_pair(data,p+56),x,sh_at(x,0),sh_at(x,4),sh_at(x,8),sh_at(x,12),sh_at(x,16),sh_at(x,20),sh_at(x,24),sh_at(x,28)),data,p+64,k)
    end
  end
  # Native smoke test; SHA-256.
  def main() do System.halt(0) end
end
