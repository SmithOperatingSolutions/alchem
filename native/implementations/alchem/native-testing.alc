  def tm_tag_pairs(source: bytes, pos: integer, left: integer): bytes do
    name = nc_start(source,pos)
    colon = nc_start(source,nc_end(source,name))
    value = tm_tag_value(source,nc_end(source,colon))
    after = nc_start(source,nc_cursor(value,0))
    one = nc_join(nc_join(b[44,32,34],nc_slice(source,name,nc_end(source,name)),b[58]),nc_slice(value,3,Enum.count(value)),b[34])
    more = if left == 0 do b[] else if nc_word(source,after,b[44]) == 0 do b[] else tm_tag_pairs(source,nc_end(source,after),left-1) end end
    if Enum.count(more) == 0 do Enum.concat(nc_u24(nc_cursor(value,0)),one) else nc_join(nc_slice(more,0,3),one,nc_slice(more,3,Enum.count(more))) end
  end
  # One @tag from pos (its @): where it ends, then its strings.
  def tm_tag(source: bytes, pos: integer): bytes do
    word = nc_start(source,nc_end(source,pos))
    first = nc_start(source,nc_end(source,word))
    value = tm_tag_value(source,nc_end(source,word))
    if (byte_at(source,first)-34)*(byte_at(source,first)-58) == 0 do nc_join(nc_slice(value,0,3),b[44,32,34],Enum.concat(nc_slice(value,3,Enum.count(value)),b[34])) else tm_tag_pairs(source,first,32) end
