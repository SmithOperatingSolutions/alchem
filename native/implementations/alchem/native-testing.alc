  def tm_doc_cases(source: bytes, recs: bytes, canon: bytes, i: integer): bytes do
    inside = if i*26 >= Enum.count(recs) do 0-1 else tm_module_at(source,tm_name(recs,i)) end
    held = nc_join(nc_u24(i),nc_u24(Enum.count(canon)),Enum.concat(canon,recs))
    if i*26 >= Enum.count(recs) do b[] else
      if tm_kind(recs,i) != 6 do tm_doc_cases(source,recs,canon,i+1) else if tm_module(recs,i) != 0 do tm_doc_cases(source,recs,canon,i+1) else
        Enum.concat(if inside < 0 do b[] else tm_doc_case(source,held,tm_docs(source,inside,0),0) end,tm_doc_cases(source,recs,canon,i+1))
      end end
    end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
