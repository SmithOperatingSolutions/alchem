  def tm_tag_end(source: bytes, pos: integer): integer do nc_cursor(tm_tag(source,pos),0) end
  # The tags written from pos up to stop.
  def tm_tag_run(source: bytes, pos: integer, stop: integer): bytes do
    start = if pos == 0 do 0-1 else nc_start(source,pos) end
    if start < 0 do b[] else if start >= stop do b[] else if byte_at(source,start) != 64 do b[] else
      Enum.concat(tm_tag_text(source,start),tm_tag_run(source,tm_tag_end(source,start),stop))
    end end end
  end
  def tm_module_tags(source: bytes, recs: bytes, i: integer): bytes do
    if i*26 >= Enum.count(recs) do b[] else
      if tm_kind(recs,i) != 5 do tm_module_tags(source,recs,i+1) else if tm_module(recs,i) != 0 do tm_module_tags(source,recs,i+1) else
