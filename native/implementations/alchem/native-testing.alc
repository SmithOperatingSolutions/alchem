      if kind == 5 do tm_tag_end(source,tm_at(recs,i)) else if kind == 6 do nc_end(source,tm_name(recs,i)) else if kind == 7 do nc_end(source,tm_at(recs,i)) else tm_at(recs,i) end end end
    end end end
  end
  def tm_edit(source: bytes, recs: bytes, canon: bytes, i: integer): bytes do
    kind = tm_kind(recs,i)
    next = tm_edit_start(recs,i+1)
    made = if kind <= 3 do tm_function(source,recs,canon,i) else if kind == 6 do tm_doctest(source,recs,i) else if kind == 9 do Enum.concat(tm_src(tm_at(recs,i),nc_end(source,tm_at(recs,i))),tm_body(source,recs,canon,i)) else b[] end end end
    Enum.concat(made,tm_src(tm_edit_stop(source,recs,i),if next > Enum.count(source) do Enum.count(source) else next end))
