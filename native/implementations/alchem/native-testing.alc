  end
  # file:line of pos. files holds for each file where it starts, the
  # length of its path and the path.
  def tm_file(files: bytes, pos: integer, at: integer): integer do
    next = at+6+nc_read(files,at+4)
    if next >= Enum.count(files) do at else if nc_long(files,next) > pos do at else tm_file(files,pos,next) end end
  end
  def tm_where(source: bytes, marks: bytes, pos: integer): bytes do
    files = nz_files(source)
    at = tm_file(files,pos,0)
    count = nc_units(Enum.count(marks),4)
    line = 1+tm_rank(marks,pos,0,count)-tm_rank(marks,nc_long(files,at),0,count)
