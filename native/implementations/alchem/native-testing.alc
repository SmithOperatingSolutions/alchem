  # The text a string literal's inside stands for, from pos up to stop.
  def tm_plain(source: bytes, pos: integer, stop: integer): bytes do
    value = byte_at(source,pos)
    next = byte_at(source,pos+1)
    simple = if next < 97 do 0 else Enum.at(b[7,8,0,0,0,12,0,0,0,0,0,0,0,10,0,0,0,13,0,9,0,11],next-97,0) end
    if pos >= stop do b[] else
