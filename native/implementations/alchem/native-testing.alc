      end
    end
  end
  def tm_refs(source: bytes, recs: bytes, canon: bytes, i: integer, d: integer): bytes do
    if d > Enum.at(recs,i*26+6,0) do b[] else
      Enum.concat(tm_refs_in(source,recs,canon,i*32+d+1,0,tm_setups(recs,canon)),tm_refs(source,recs,canon,i,d+1))
    end
  end
  def tm_module_name(source: bytes): bytes do
    start = nc_start(source,0)
    name = nc_start(source,nc_end(source,start))
    ac_text(source,name,tm_opening(source,name,64))
  end
  # A test of the first module as the runner takes it: its name with those
  # of the describe blocks around it, where it stands, its tags, and the
  # functions to call.
  def tm_case(source: bytes, recs: bytes, canon: bytes, marks: bytes, i: integer): bytes do
    name = tm_name(recs,i)
    tags = nc_join(tm_module_tags(source,recs,0),tm_group_tags(source,recs,canon,tm_of(recs,i)),tm_tag_run(source,tm_tags(recs,i),tm_at(recs,i)))
    first = nc_join(nc_join(b[123,34],tm_path(source,recs,tm_of(recs,i)),tm_inner(source,name+1,nc_end(source,name)-1)),b[34,44,32,34],tm_where(source,marks,tm_at(recs,i)))
