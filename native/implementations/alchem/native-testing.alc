  def tm_tag_text(source: bytes, pos: integer): bytes do
    one = tm_tag(source,pos)
    nc_slice(one,3,Enum.count(one))
  end
  # The tags of a group: those of the last describe of the group that has any.
  def tm_group_last(recs: bytes, canon: bytes, group: integer, j: integer): integer do
    if j < 0 do 0-1 else
      if tm_kind(recs,j) != 4 do tm_group_last(recs,canon,group,j-1) else if nc_read(canon,j*2) != group do tm_group_last(recs,canon,group,j-1) else
        if tm_tags(recs,j) == 0 do tm_group_last(recs,canon,group,j-1) else j end
      end end
    end
