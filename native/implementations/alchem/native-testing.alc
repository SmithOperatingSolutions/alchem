    end
  end

  # Tags. @tag "name", @tag :name, or @tag name: value, other: value; each
  # tag is written as a string of the list the runner is given, after a comma.
  def tm_tag_value(source: bytes, pos: integer): bytes do
    start = nc_start(source,pos)
    if byte_at(source,start) == 34 do Enum.concat(nc_u24(nc_end(source,start)),nc_slice(source,start+1,nc_end(source,start)-1)) else
      if byte_at(source,start) == 58 do Enum.concat(nc_u24(nc_end(source,start+1)),nc_slice(source,start+1,nc_end(source,start+1))) else
        Enum.concat(nc_u24(nc_end(source,start)),nc_slice(source,start,nc_end(source,start)))
      end
    end
