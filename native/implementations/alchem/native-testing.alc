      if value < 65536 do b[224+nc_units(value,4096),128+nc_units(value,64)-nc_units(value,4096)*64,128+value-nc_units(value,64)*64] else
        b[240+nc_units(value,262144),128+nc_units(value,4096)-nc_units(value,262144)*64,128+nc_units(value,64)-nc_units(value,4096)*64,128+value-nc_units(value,64)*64]
      end
    end end end
