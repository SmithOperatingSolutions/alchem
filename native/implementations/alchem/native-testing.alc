        if byte_at(source,pos)*256+byte_at(source,pos+1) == 9083 do Enum.concat(b[92,35],tm_inner(source,pos+1,stop)) else Enum.concat(b[byte_at(source,pos)],tm_inner(source,pos+1,stop)) end
      end
    end
  end
  def tm_path(source: bytes, recs: bytes, group: integer): bytes do
    if group == 0 do b[] else nc_join(tm_path(source,recs,tm_of(recs,group-1)),tm_inner(source,tm_name(recs,group-1)+1,nc_end(source,tm_name(recs,group-1))-1),b[32]) end
  end
  # How many of the marks stand before pos.
  def tm_rank(marks: bytes, pos: integer, first: integer, stop: integer): integer do
    middle = first+nc_half(stop-first)
