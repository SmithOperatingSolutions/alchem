  end
  def tm_number(source: bytes, pos: integer, count: integer, value: integer): integer do
    if count == 0 do value else if tm_digit(byte_at(source,pos)) < 0 do 0-1 else tm_number(source,pos+1,count-1,value*16+tm_digit(byte_at(source,pos))) end end
  end
  def tm_utf8(value: integer): bytes do
