defmodule NativeTesting do
  # Test files (spec/alchem-testing-gen.md). A module with test declarations
  # has no main: the pinned compiler makes one that hands its tests to the
  # runner. Here the program's text is rewritten before it is compiled
  # (nc_rewritten), as macros are, and with their pieces (native-macros.alc):
  # every test and setup block becomes a function of one word, the context,
  # and a module of the library's kind is added whose main calls the runner
  # (library/Testing.alc) with the tests of the first module.
  #
  # The walk. A cursor is 48 bytes: the position, where the tags waiting for
  # the next test start (0 for none), a status (0 in a module, 1 at the end
  # of the text, 2 for text that is no program, 3 between modules), the
  # describe block being read (its record's number plus one), how deep it
  # stands, 1 after def or @, the module's number, the number of records,
  # and the describe blocks around the position. A record is 26 bytes: its
  # kind (1 test, 2 setup, 3 setup_all, 4 describe, 5 @moduletag, 6 doctest,
  # 7 the end of a describe, 8 tags nothing follows), where it starts, its
  # describe block and depth, its name, its tags, its parameter, its do, the
  # end of its body, and its module.
  def tm_cursor(pos: integer, pending: integer, status: integer, rest: bytes): bytes do
    # A record's number is two bytes: a file of tests with 65,535 records
    # is no program (tm_counted stops there), where it ended the compiler.
    full = if Enum.count(rest) < 7 do 0 else if nc_read(rest,5) >= 65535 do 1 else 0 end end
    nc_join(nc_u24(pos),Enum.concat(nc_u24(pending),b[if full == 1 do 2 else status end]),rest)
  end
  def tm_rest(cur: bytes): bytes do nc_slice(cur,7,48) end
  def tm_depth(cur: bytes): integer do Enum.at(cur,9,0) end
  def tm_count(cur: bytes): integer do nc_read(cur,12) end
  # The rest of a cursor with its guard set, or one record more.
  def tm_guarded(cur: bytes, guard: integer): bytes do
    nc_join(nc_slice(cur,7,10),b[guard],nc_slice(cur,11,48))
  end
  def tm_counted(cur: bytes): bytes do
    nc_join(nc_slice(cur,7,10),b[0,Enum.at(cur,11,0)],Enum.concat(nc_u16(if tm_count(cur) >= 65535 do 65535 else tm_count(cur)+1 end),nc_slice(cur,14,48)))
  end
  def tm_record(kind: integer, at: integer, cur: bytes, name: integer, fields: bytes): bytes do
    nc_join(Enum.concat(b[kind],nc_u24(at)),Enum.concat(nc_slice(cur,7,10),nc_u24(name)),nc_join(nc_slice(cur,3,6),fields,b[0,0,Enum.at(cur,11,0),0]))
  end
  def tm_kind(recs: bytes, i: integer): integer do Enum.at(recs,i*26,0) end
  def tm_at(recs: bytes, i: integer): integer do nc_cursor(recs,i*26+1) end
  def tm_of(recs: bytes, i: integer): integer do nc_read(recs,i*26+4) end
  def tm_deep(recs: bytes, i: integer): integer do if tm_kind(recs,i) == 3 do 0-1 else Enum.at(recs,i*26+6,0) end end
  def tm_name(recs: bytes, i: integer): integer do nc_cursor(recs,i*26+7) end
  def tm_tags(recs: bytes, i: integer): integer do nc_cursor(recs,i*26+10) end
  def tm_param(recs: bytes, i: integer): integer do nc_cursor(recs,i*26+13) end
  def tm_do(recs: bytes, i: integer): integer do nc_cursor(recs,i*26+16) end
  def tm_stop(recs: bytes, i: integer): integer do nc_cursor(recs,i*26+19) end
  def tm_module(recs: bytes, i: integer): integer do Enum.at(recs,i*26+24,0) end
  # Where the do that opens a block stands, from pos; -1 when none does
  # within 256 tokens.
  def tm_opening(source: bytes, pos: integer, left: integer): integer do
    start = nc_start(source,pos)
    if start < 0 do 0-1 else if left == 0 do 0-1 else if start >= Enum.count(source) do 0-1 else
      if nc_opens(source,start) == 1 do start else tm_opening(source,nc_end(source,start),left-1) end
    end end end
  end
  def tm_fail(cur: bytes): bytes do tm_cursor(0,0,2,tm_rest(cur)) end
  # A test, a setup block or a setup_all: its record, and the cursor after it.
  def tm_declared(source: bytes, cur: bytes, start: integer, kind: integer): bytes do
    name = nc_start(source,nc_end(source,start))
    after = if kind == 1 do nc_end(source,name) else nc_end(source,start) end
    next = nc_start(source,after)
    param = if kind == 1 do if nc_word(source,next,b[44]) == 1 do nc_start(source,nc_end(source,next)) else 0 end else if kind == 3 do 0 else if nc_opens(source,next) == 1 do 0 else next end end end
    opening = if param == 0 do if nc_opens(source,next) == 1 do next else 0-1 end else tm_opening(source,param,256) end
    stop = if opening < 0 do 0-1 else nc_body_end(source,nc_end(source,opening),16777216) end
    bad = if kind == 3 do tm_depth(cur) else 0 end
    empty = if kind != 1 do 0 else if nc_end(source,name)-name <= 2 do 1 else 0 end end
    if stop < 0 do tm_fail(cur) else if bad+empty > 0 do tm_fail(cur) else
      Enum.concat(tm_cursor(nc_end(source,stop),0,0,tm_counted(cur)),tm_record(kind,start,cur,name,nc_join(nc_u24(param),nc_u24(opening),nc_u24(stop))))
    end end
  end
  # describe "name" do: its record, and the cursor inside it.
  def tm_described(source: bytes, cur: bytes, start: integer): bytes do
    name = nc_start(source,nc_end(source,start))
    opening = nc_start(source,nc_end(source,name))
    depth = tm_depth(cur)
    inside = nc_join(Enum.concat(nc_u16(tm_count(cur)+1),b[depth+1,0,Enum.at(cur,11,0)]),Enum.concat(nc_u16(tm_count(cur)+1),nc_slice(cur,14,16+depth*2)),Enum.concat(nc_u16(tm_count(cur)+1),nc_slice(cur,18+depth*2,48)))
    if nc_opens(source,opening) == 0 do tm_fail(cur) else if depth >= 16 do tm_fail(cur) else if nc_end(source,name)-name <= 2 do tm_fail(cur) else
      Enum.concat(tm_cursor(nc_end(source,opening),0,0,inside),tm_record(4,start,cur,name,nc_join(b[0,0,0],nc_u24(opening),b[0,0,0])))
    end end end
  end
  # end: of a describe block, or of the module.
  def tm_ended(source: bytes, cur: bytes, start: integer): bytes do
    depth = tm_depth(cur)
    pending = nc_cursor(cur,3)
    outer = nc_join(Enum.concat(nc_slice(cur,12+depth*2,14+depth*2),b[if depth == 0 do 0 else depth-1 end,0,Enum.at(cur,11,0)]),nc_u16(tm_count(cur)+1),nc_slice(cur,14,48))
    left = nc_join(b[0,0,0,0,Enum.at(cur,11,0)+1],nc_u16(tm_count(cur)+if pending == 0 do 0 else 1 end),nc_zeros(34))
    if depth > 0 do Enum.concat(tm_cursor(nc_end(source,start),0,0,outer),tm_record(7,start,cur,0,nc_zeros(9))) else
      Enum.concat(tm_cursor(nc_end(source,start),0,3,left),if pending == 0 do b[] else tm_record(8,start,cur,0,nc_zeros(9)) end)
    end
  end
  # @: a tag waits for the test or describe that follows; @moduletag is the
  # module's; any other is a constant or a document.
  def tm_attribute(source: bytes, cur: bytes, start: integer): bytes do
    word = nc_start(source,nc_end(source,start))
    pending = nc_cursor(cur,3)
    value = nc_start(source,nc_end(source,word))
    tagged = nc_word(source,word,b[116,97,103])+nc_word(source,word,b[100,101,115,99,114,105,98,101,116,97,103])+nc_word(source,word,b[109,111,100,117,108,101,116,97,103])
    # A tag is a name without spaces or commas.
    wrong = if tagged == 0 do 0 else if byte_at(source,value) != 34 do 0 else if nc_end(source,value)-value <= 2 do 1 else mx_raw(source,value,nc_end(source,value),b[32])+mx_raw(source,value,nc_end(source,value),b[44]) end end end
    if wrong > 0 do tm_fail(cur) else tm_tagged(source,cur,start,word) end
  end
  def tm_tagged(source: bytes, cur: bytes, start: integer, word: integer): bytes do
    pending = nc_cursor(cur,3)
    if nc_word(source,word,b[116,97,103])+nc_word(source,word,b[100,101,115,99,114,105,98,101,116,97,103]) > 0 do tm_cursor(tm_tag_end(source,start),if pending == 0 do start else pending end,0,tm_rest(cur)) else
      if nc_word(source,word,b[109,111,100,117,108,101,116,97,103]) == 1 do Enum.concat(tm_cursor(tm_tag_end(source,start),pending,0,tm_counted(cur)),tm_record(5,start,cur,0,nc_zeros(9))) else
        tm_cursor(nc_end(source,start),pending,0,tm_guarded(cur,1))
      end
    end
  end
  # Whatever else stands in a module: a block is passed whole.
  def tm_passed(source: bytes, cur: bytes, start: integer, guard: integer): bytes do
    stop = if nc_opens(source,start)+nf_untyped(source,start) == 0 do start else nc_body_end(source,nc_end(source,start),16777216) end
    # The token at stop does not end when it is a string without its closing quote.
    if stop < 0 do tm_fail(cur) else if nc_end(source,stop) < 0 do tm_fail(cur) else tm_cursor(nc_end(source,stop),nc_cursor(cur,3),0,tm_guarded(cur,guard)) end end
  end
  # Between modules: the next defmodule, or the end of the text.
  def tm_between(source: bytes, cur: bytes, start: integer): bytes do
    opening = tm_opening(source,start,64)
    if start < 0 do tm_cursor(0,0,1,tm_rest(cur)) else if start >= Enum.count(source) do tm_cursor(0,0,1,tm_rest(cur)) else
      if nc_word(source,start,b[100,101,102,109,111,100,117,108,101]) == 0 do tm_fail(cur) else if opening < 0 do tm_fail(cur) else tm_cursor(nc_end(source,opening),0,0,tm_rest(cur)) end end
    end end
  end
  def tm_step(source: bytes, cur: bytes): bytes do
    start = nc_start(source,nc_cursor(cur,0))
    next = nc_start(source,nc_end(source,start))
    guard = Enum.at(cur,10,0)
    if Enum.at(cur,6,0) == 3 do tm_between(source,cur,start) else
      if start < 0 do tm_fail(cur) else if start >= Enum.count(source) do tm_fail(cur) else
        if guard >= 1 do tm_signed(source,cur,start,guard) else
          if nc_word(source,start,b[101,110,100]) == 1 do tm_ended(source,cur,start) else
            if byte_at(source,start) == 64 do tm_attribute(source,cur,start) else tm_worded(source,cur,start,next) end
          end
        end
      end end
    end
  end
  def tm_worded(source: bytes, cur: bytes, start: integer, next: integer): bytes do
    text = if byte_at(source,next) == 34 do 1 else 0 end
    defs = nc_word(source,start,b[100,101,102])+nc_word(source,start,b[100,101,102,112])+nc_word(source,start,b[100,101,102,109,97,99,114,111])+nc_word(source,start,b[100,101,102,109,97,99,114,111,112])
    if nc_word(source,start,b[116,101,115,116])*text == 1 do tm_declared(source,cur,start,1) else
      if nc_word(source,start,b[100,101,115,99,114,105,98,101])*text == 1 do tm_described(source,cur,start) else
        if nc_word(source,start,b[115,101,116,117,112]) == 1 do tm_declared(source,cur,start,2) else
          if nc_word(source,start,b[115,101,116,117,112,95,97,108,108]) == 1 do tm_declared(source,cur,start,3) else
            if tm_depth(cur) > 0 do tm_fail(cur) else if nc_word(source,start,b[100,111,99,116,101,115,116])*tm_capital(source,next) == 1 do Enum.concat(tm_cursor(nc_end(source,next),nc_cursor(cur,3),0,tm_counted(cur)),tm_record(6,start,cur,next,nc_zeros(9))) else
              tm_passed(source,cur,start,if nc_word(source,start,b[100,101,102])+nc_word(source,start,b[100,101,102,112]) > 0 do 2 else if defs > 0 do 1 else if nc_word(source,start,b[100,101,102,105,109,112,108]) == 1 do 3 else 0 end end end)
            end end
          end
        end
      end
    end
  end
  # After def or defp (guard 2) the name is passed, then the signature token
  # by token (guard 3) up to the do of the body, which gets a record of
  # kind 9: the assertions in it are rewritten as a test's are. A function
  # without a body (in a protocol) ends at the next def or end, and one
  # written with do: on its line stays as it is. After defmacro (guard 1)
  # only the name is passed. A defimpl block is such a body as a whole
  # (guard 3 from its first word): the functions in it are.
  def tm_signed(source: bytes, cur: bytes, start: integer, guard: integer): bytes do
    opens = nc_opens(source,start)
    stop = if opens == 0 do 0-1 else nc_body_end(source,nc_end(source,start),16777216) end
    over = nc_word(source,start,b[101,110,100])+nc_word(source,start,b[100,101,102])+nc_word(source,start,b[100,101,102,112])+nc_word(source,start,b[100,101,102,109,97,99,114,111])+nc_word(source,start,b[100,101,102,109,97,99,114,111,112])+nc_word(source,start,b[100,111])*(1-opens)
    if guard == 1 do tm_passed(source,cur,start,0) else if guard == 2 do tm_passed(source,cur,start,3) else
      if over > 0 do tm_step(source,tm_cursor(nc_cursor(cur,0),nc_cursor(cur,3),0,tm_guarded(cur,0))) else
        if opens == 0 do tm_passed(source,cur,start,3) else
          if stop < 0 do tm_fail(cur) else if nc_cursor(cur,3) != 0 do tm_cursor(nc_end(source,stop),nc_cursor(cur,3),0,tm_guarded(cur,0)) else
            Enum.concat(tm_cursor(nc_end(source,stop),0,0,tm_counted(cur)),tm_record(9,start,cur,0,nc_join(b[0,0,0],nc_u24(start),nc_u24(stop))))
          end end
        end
      end
    end end
  end
  def tm_capital(source: bytes, pos: integer): integer do
    if (byte_at(source,pos)-65)*(90-byte_at(source,pos)) >= 0 do 1 else 0 end
  end
  def tm_chunk(source: bytes, cur: bytes, count: integer): bytes do
    if count == 0 do cur else if (Enum.at(cur,6,0)-1)*(Enum.at(cur,6,0)-2) == 0 do cur else tm_chunked(source,tm_step(source,cur),count) end end
  end
  def tm_chunked(source: bytes, made: bytes, count: integer): bytes do
    next = tm_chunk(source,nc_slice(made,0,48),count-1)
    nc_join(nc_slice(next,0,48),nc_slice(made,48,Enum.count(made)),nc_slice(next,48,Enum.count(next)))
  end
  def tm_walk(source: bytes, cur: bytes): bytes do
    part = tm_chunk(source,cur,64)
    rest = if (Enum.at(part,6,0)-1)*(Enum.at(part,6,0)-2) == 0 do b[] else tm_walk(source,nc_slice(part,0,48)) end
    if Enum.count(rest) == 0 do part else nc_join(nc_slice(rest,0,48),nc_slice(part,48,Enum.count(part)),nc_slice(rest,48,Enum.count(rest))) end
  end
  # 1 when some record from first up to stop is a test.
  def tm_any(recs: bytes, first: integer, stop: integer, kind: integer): integer do
    if first >= stop do 0 else if tm_kind(recs,first) == kind do 1 else tm_any(recs,first+1,stop,kind) end end
  end

  # Describe blocks of one name in one block are one group (the pinned
  # compiler names a group by its names): two bytes per record, for a
  # describe the number plus one of the first record of its group.
  def tm_canon(canon: bytes, group: integer): integer do
    if group == 0 do 0 else nc_read(canon,group*2-2) end
  end
  def tm_alike(source: bytes, a: integer, b: integer): integer do
    size = nc_end(source,a)-a
    if nc_end(source,b)-b != size do 0 else nc_equal(source,a,b,size) end
  end
  def tm_first(source: bytes, recs: bytes, canon: bytes, i: integer, j: integer): integer do
    if j >= i do i+1 else
      if tm_kind(recs,j) != 4 do tm_first(source,recs,canon,i,j+1) else if tm_module(recs,j) != tm_module(recs,i) do tm_first(source,recs,canon,i,j+1) else
        if tm_canon(canon,tm_of(recs,j)) != tm_canon(canon,tm_of(recs,i)) do tm_first(source,recs,canon,i,j+1) else
          if tm_alike(source,tm_name(recs,j),tm_name(recs,i)) == 1 do nc_read(canon,j*2) else tm_first(source,recs,canon,i,j+1) end
        end
      end end
    end
  end
  def tm_canons(source: bytes, recs: bytes, i: integer, canon: bytes): bytes do
    if i*26 >= Enum.count(recs) do canon else
      tm_canons(source,recs,i+1,Enum.concat(canon,nc_u16(if tm_kind(recs,i) != 4 do 0 else tm_first(source,recs,canon,i,0) end)))
    end
  end
  # The describe block around group, levels blocks out.
  def tm_up(recs: bytes, group: integer, levels: integer): integer do
    if levels <= 0 do group else if group == 0 do 0 else tm_up(recs,tm_of(recs,group-1),levels-1) end end
  end

  # Text of the compiler's own, standing for the place t.
  def tm_lit(text: bytes, t: integer): bytes do
    size = Enum.count(text)
    cut = nc_half(nc_units(size+4,5))*5
    if size == 0 do b[] else if size <= 5 do mx_text5(text,t,mx_none()) else
      Enum.concat(tm_lit(nc_slice(text,0,cut),t),tm_lit(nc_slice(text,cut,size),t))
    end end
  end
  def tm_src(first: integer, stop: integer): bytes do
    if stop <= first do b[] else mx_piece(0,first,stop,0,mx_none()) end
  end
  # The setup blocks that give function i its context, as the pinned
  # compiler orders them: setup_all, then the blocks of every describe around
  # it from the outermost in, each in the order written. Before a setup
  # block stand only those written above it.
  def tm_applies(recs: bytes, canon: bytes, i: integer, j: integer, d: integer): integer do
    kind = tm_kind(recs,j)
    mine = tm_up(recs,tm_of(recs,i),Enum.at(recs,i*26+6,0)-d)
    earlier = if (tm_kind(recs,i)-1)*(tm_kind(recs,i)-6) == 0 do 1 else if tm_deep(recs,j) < tm_deep(recs,i) do 1 else if tm_deep(recs,j) != tm_deep(recs,i) do 0 else if j < i do 1 else 0 end end end end
    if (kind-2)*(kind-3) != 0 do 0 else if tm_deep(recs,j) != d do 0 else if tm_module(recs,j) != tm_module(recs,i) do 0 else if j == i do 0 else
      if earlier == 0 do 0 else if kind == 3 do 1 else if tm_canon(canon,tm_of(recs,j)) == tm_canon(canon,mine) do 1 else 0 end end end
    end end end end
  end
  # The context after the setup blocks before function i, as an expression
  # that is typed and never run: T.__next(T.__next({}, fn _ -> first block
  # end), fn context -> second block end). A block that takes the context is
  # under T.__with. key is i*32+d+1.
  def tm_close(source: bytes, recs: bytes, canon: bytes, j: integer, t: integer): bytes do
    taken = if tm_param(recs,j) == 0 do tm_lit(b[44,32,102,110,32,95,32,45,62,10],t) else nc_join(tm_lit(b[44,32,102,110,32],t),tm_src(tm_param(recs,j),tm_do(recs,j)),tm_lit(b[45,62,10],t)) end
    nc_join(taken,tm_body(source,recs,canon,j),tm_lit(b[10,101,110,100,41],t))
  end
  def tm_closes(source: bytes, recs: bytes, canon: bytes, key: integer, first: integer, stop: integer): bytes do
    i = nc_units(key,32)
    if stop-first <= 0 do b[] else
      if stop-first == 1 do if tm_applies(recs,canon,i,tm_setup(recs,canon,first),key-i*32-1) == 0 do b[] else tm_close(source,recs,canon,tm_setup(recs,canon,first),tm_at(recs,i)) end else
        middle = first+nc_half(stop-first)
        Enum.concat(tm_closes(source,recs,canon,key,first,middle),tm_closes(source,recs,canon,key,middle,stop))
      end
    end
  end
  def tm_opens(recs: bytes, canon: bytes, key: integer, first: integer, stop: integer): bytes do
    i = nc_units(key,32)
    if stop-first <= 0 do b[] else
      if stop-first == 1 do if tm_applies(recs,canon,i,tm_setup(recs,canon,first),key-i*32-1) == 0 do b[] else if tm_param(recs,tm_setup(recs,canon,first)) == 0 do b[84,127,46,95,95,110,101,120,116,40] else b[84,127,46,95,95,119,105,116,104,40] end end else
        middle = first+nc_half(stop-first)
        Enum.concat(tm_opens(recs,canon,key,middle,stop),tm_opens(recs,canon,key,first,middle))
      end
    end
  end
  def tm_chain_opens(recs: bytes, canon: bytes, i: integer, d: integer): bytes do
    if d > Enum.at(recs,i*26+6,0) do b[] else
      Enum.concat(tm_chain_opens(recs,canon,i,d+1),tm_opens(recs,canon,i*32+d+1,0,tm_setups(recs,canon)))
    end
  end
  def tm_chain(source: bytes, recs: bytes, canon: bytes, i: integer, d: integer): bytes do
    if d > Enum.at(recs,i*26+6,0) do b[] else
      Enum.concat(tm_closes(source,recs,canon,i*32+d+1,0,tm_setups(recs,canon)),tm_chain(source,recs,canon,i,d+1))
    end
  end
  def tm_digits(value: integer): bytes do
    if value < 10 do b[48+value] else Enum.concat(tm_digits(nt_div(value,10)),b[48+nt_mod(value,10)]) end
  end
  def tm_body(source: bytes, recs: bytes, canon: bytes, i: integer): bytes do
    tm_rewrite(source,Enum.concat(nc_u24(nc_end(source,tm_do(recs,i))),b[Enum.at(canon,nc_units(Enum.count(recs),26)*2,0)]),nc_end(source,tm_do(recs,i)),tm_stop(recs,i))
  end
  # After the groups of the records, canon holds what the whole program
  # tells: 1 when it has a macro, and the numbers of its setup blocks.
  def tm_setups(recs: bytes, canon: bytes): integer do
    nc_read(canon,nc_units(Enum.count(recs),26)*2+1)
  end
  def tm_setup(recs: bytes, canon: bytes, k: integer): integer do
    nc_read(canon,nc_units(Enum.count(recs),26)*2+3+k*2)
  end
  def tm_setup_list(recs: bytes, i: integer): bytes do
    if i*26 >= Enum.count(recs) do b[] else if (tm_kind(recs,i)-2)*(tm_kind(recs,i)-3) == 0 do Enum.concat(nc_u16(i),tm_setup_list(recs,i+1)) else tm_setup_list(recs,i+1) end end
  end
  def tm_facts(given: bytes, recs: bytes): bytes do
    list = tm_setup_list(recs,0)
    nc_join(b[mx_raw(given,0,Enum.count(given),b[100,101,102,109,97,99,114,111,32])],nc_u16(nc_units(Enum.count(list),2)),list)
  end
  # A test or setup block as a function of the context's word. A block
  # that takes the context binds its pattern to the word, typed as the
  # blocks before it leave the context: they are written again in a
  # function that is never called.
  def tm_function(source: bytes, recs: bytes, canon: bytes, i: integer): bytes do
    t = tm_at(recs,i)
    kind = tm_kind(recs,i)
    shown = if kind != 1 do b[] else tm_hex(tm_plain(source,tm_name(recs,i)+1,nc_end(source,tm_name(recs,i))-1),0) end
    head = nc_join(if kind == 1 do b[100,101,102,32,116,101,115,116,127] else b[100,101,102,32,115,101,116,117,112,127] end,tm_digits(i),nc_join(b[40,99,127,58,32,105,110,116,101,103,101,114,41,58,32,105,110,116,101,103,101,114,32,100,111,32,35],shown,b[10]))
    taken = if tm_param(recs,i) == 0 do b[] else
      nc_join(Enum.concat(tm_src(tm_param(recs,i),tm_do(recs,i)),tm_lit(nc_join(b[32,61,32,84,127,46,95,95,108,105,107,101,40,99,127,44,32],tm_chain_opens(recs,canon,i,0-1),b[123,125]),t)),tm_chain(source,recs,canon,i,0-1),tm_lit(b[41,10],t))
    end
    nc_join(tm_lit(head,t),taken,tm_body(source,recs,canon,i))
