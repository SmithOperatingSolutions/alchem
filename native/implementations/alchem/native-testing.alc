  def tm_group_tags(source: bytes, recs: bytes, canon: bytes, group: integer): bytes do
    if group == 0 do b[] else Enum.concat(tm_group_tags(source,recs,canon,tm_of(recs,group-1)),tm_group_own(source,recs,tm_group_last(recs,canon,tm_canon(canon,group),nc_units(Enum.count(recs),26)-1))) end
  end
  def tm_group_own(source: bytes, recs: bytes, last: integer): bytes do
    if last < 0 do b[] else tm_tag_run(source,tm_tags(recs,last),tm_at(recs,last)) end
  end
  # The inside of a string literal, as the inside of one of the compiler's.
  def tm_inner(source: bytes, pos: integer, stop: integer): bytes do
