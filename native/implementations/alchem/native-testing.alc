    if tm_kind(recs,i) != 1 do b[] else if tm_module(recs,i) != 0 do b[] else Enum.concat(first,second) end end
  end
  def tm_cases(source: bytes, recs: bytes, canon: bytes, marks: bytes, first: integer, stop: integer): bytes do
    if stop-first <= 0 do b[] else
      if stop-first == 1 do tm_case(source,recs,canon,marks,first) else
        middle = first+nc_half(stop-first)
        Enum.concat(tm_cases(source,recs,canon,marks,first,middle),tm_cases(source,recs,canon,marks,middle,stop))
      end
    end
  end
  def tm_alls(source: bytes, recs: bytes, i: integer): bytes do
    if i*26 >= Enum.count(recs) do b[] else
      if tm_kind(recs,i) != 3 do tm_alls(source,recs,i+1) else if tm_module(recs,i) != 0 do tm_alls(source,recs,i+1) else
        Enum.concat(nc_join(nc_join(b[38],tm_module_name(source),b[46,115,101,116,117,112,127]),tm_digits(i),b[47,49,44,32]),tm_alls(source,recs,i+1))
      end end
    end
  end
  # The module whose main runs the tests: a module of the library's kind, so
  # that a trace shows nothing of it.
  def tm_main(source: bytes, recs: bytes, canon: bytes): bytes do
    count = nc_units(Enum.count(recs),26)
    marks = nz_marks(source,0,Enum.count(source),10,10)
    cases = Enum.concat(tm_cases(source,recs,canon,marks,0,count),tm_doc_cases(source,recs,canon,0))
    nc_join(nc_join(b[10,100,101,102,109,111,100,117,108,101,32,65,108,99,104,127,109,127,84,80,114,111,99,101,115,115,32,100,111,32,105,109,112,111,114,116,32,34,109,111,100,117,108,101,58],tm_module_name(source),b[34,10,100,101,102,32,109,97,105,110,40,41,32,100,111,10,108,127,32,61,32,91,10]),cases,nc_join(nc_join(b[123,34,34,44,32,34,34,44,32,91,34,34,93,44,32,91,102,110,40,99,127,58,32,105,110,116,101,103,101,114,41,58,32,105,110,116,101,103,101,114,32,100,111,32,99,127,32,101,110,100,93,125,93,10,97,127,32,61,32,91],tm_alls(source,recs,0),b[102,110,40,99,127,58,32,105,110,116,101,103,101,114,41,58,32,105,110,116,101,103,101,114,32,100,111,32,99,127,32,101,110,100,93,10,84,101,115,116,105,110,103,46,95,114,117,110,40,34]),tm_module_name(source),b[34,44,32,108,127,44,32,97,127,41,10,101,110,100,10,101,110,100,10]))
  end
  # The program as it is compiled: b[0] as it is (it has no test), b[] for
  # one that cannot be compiled, or 1, the length of the rewritten text, the
  # text and its tail (mx_made).
  def tm_prepare(given: bytes): bytes do
    size = Enum.count(given)
    # A test file is under 16 MiB (its rewriting keeps a place in three
    # bytes): a longer text is compiled as it is.
    if size > 16777215 do b[0] else if mx_raw(given,0,size,b[116,101,115,116]) == 0 do b[0] else
      if tm_entry(given,0) == 1 do b[0] else tm_found(given,tm_walk(given,tm_cursor(0,0,3,nc_zeros(41)))) end
    end end
  end
  # 1 when the program defines native_compile, a compiler entry, which has
  # no tests: the word elsewhere (a comment, a string) makes no entry.
  def tm_entry(given: bytes, from: integer): integer do
    hit = ac_seek(given,from,Enum.count(given),b[100,101,102,32,110,97,116,105,118,101,95,99,111,109,112,105,108,101,40])
    if hit < 0 do 0 else if ac_leading(given,hit) == 1 do 1 else tm_entry(given,hit+1) end end
  end
  def tm_found(given: bytes, walked: bytes): bytes do
    recs = nc_slice(walked,48,Enum.count(walked))
    count = nc_units(Enum.count(recs),26)
    tainted = if mx_raw(given,0,Enum.count(given),b[127]) == 0 do 0 else mx_tainted(given,0) end
    if Enum.at(walked,6,0) != 1 do b[0] else if tm_any(recs,0,count,1)+tm_any(recs,0,count,6) == 0 do b[0] else
      if tainted+tm_mained(given,nc_start(given,0),0) > 0 do b[] else if count > 60000 do b[] else tm_made(given,recs,Enum.concat(tm_canons(given,recs,0,b[]),tm_facts(given,recs))) end end
    end end
  end
  # 1 when a function of the program is named main: a module with tests
  # cannot define it.
  def tm_mained(given: bytes, pos: integer, from: integer): integer do
    hit = ac_seek(given,from,Enum.count(given),b[100,101,102,32,109,97,105,110,40])
    if hit < 0 do 0 else if ac_leading(given,hit) == 1 do 1 else tm_mained(given,pos,hit+1) end end
  end
  def tm_made(given: bytes, recs: bytes, canon: bytes): bytes do
    count = nc_units(Enum.count(recs),26)
    first = tm_edit_start(recs,0)
    pieces = nc_join(tm_src(0,first),tm_edits(given,recs,canon,0,count),tm_lit(tm_main(given,recs,canon),tm_at(recs,0)))
    mx_made(given,pieces)
  end

  # The rewritten text is rewritten as any program is, and compiled.
  def tm_then(tested: bytes, explain: integer): bytes do
    size = nc_long(tested,1)
    code = nc_slice(tested,5,5+size)
    tm_after(code,nc_slice(tested,5+size,Enum.count(tested)),mx_prepare(code),explain)
  end
  def tm_after(code: bytes, tail: bytes, made: bytes, explain: integer): bytes do
    after = nc_slice(made,5,5+nc_long(made,1))
    if Enum.count(made) == 0 do b[] else
      if Enum.count(made) == 1 do nc_compile_with(code,ny_prelude(code),tail,explain) else nc_compile_with(after,ny_prelude(after),tm_composed(nc_slice(made,5+nc_long(made,1),Enum.count(made)),tail,Enum.count(after)),explain) end
    end
  end
  # The tail of a text rewritten twice: the tables of the program as
  # written, which the first tail holds, and moved records that turn a
  # place of the second text back through the first to the program. A
  # run of the second text that stood where it stood in the first is cut
  # where the first's runs end.
  def tm_composed(second: bytes, first: bytes, size: integer): bytes do
    a = Enum.count(first)
    b = Enum.count(second)
    m1 = nc_slice(first,2,2+nc_long(first,a-20))
    m2 = nc_slice(second,2,2+nc_long(second,b-20))
    moved = tm_joined(m2,m1,size,0,nc_units(Enum.count(m2),16))
    nc_join(nc_join(b[10,0],moved,nc_slice(first,2+Enum.count(m1),a-20)),nc_u32(Enum.count(moved)),nc_slice(first,a-16,a))
  end
  # The last record of moved that starts at or before pos.
  def tm_seat(moved: bytes, pos: integer, first: integer, stop: integer): integer do
    middle = first+nc_half(stop-first)
    if stop-first <= 1 do first else if nc_long(moved,middle*16) <= pos do tm_seat(moved,pos,middle,stop) else tm_seat(moved,pos,first,middle) end end
  end
  # Where the place q of the first text stands in the program.
  def tm_point(m1: bytes, q: integer): integer do
    k = tm_seat(m1,q,0,nc_units(Enum.count(m1),16))
    if Enum.at(m1,k*16+7,0) == 0 do nc_cursor(m1,k*16+4)+q-nc_long(m1,k*16) else nc_cursor(m1,k*16+4) end
  end
  def tm_moved(start: integer, place: integer, flag: integer, rest: bytes): bytes do
    nc_join(nc_u32(start),Enum.concat(nc_u24(place),b[flag]),rest)
  end
  # A run of left bytes of the second text from s that stood from p on in
  # the first, whose record k holds p.
  def tm_span(m1: bytes, s: integer, p: integer, left: integer, k: integer): bytes do
    flag = Enum.at(m1,k*16+7,0)
