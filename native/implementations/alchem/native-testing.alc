  def tm_nibble(value: integer): integer do if value < 10 do 48+value else 87+value end end
  def tm_hex(text: bytes, at: integer): bytes do
    value = Enum.at(text,at,0)
    if at >= Enum.count(text) do b[] else if at >= 240 do b[] else Enum.concat(b[tm_nibble(nc_units(value,16)),tm_nibble(value-nc_units(value,16)*16)],tm_hex(text,at+1)) end end
  end
  def tm_unhex(source: bytes, pos: integer): bytes do
    high = tm_digit(byte_at(source,pos))
    low = tm_digit(byte_at(source,pos+1))
    if high < 0 do b[] else if low < 0 do b[] else Enum.concat(b[high*16+low],tm_unhex(source,pos+2)) end end
  end
  def tm_digit(value: integer): integer do
