  # The position after the pattern at pos, by its brackets alone; -1 if there
  # is none within 200 tokens.
  def np_skip(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    after = nc_start(source,nc_end(source,start))
    if start < 0 do -1 else
      if value == 37 do if byte_at(source,after) == 123 do np_close(source,after,0,16777216) else np_close(source,nc_start(source,nd_name_end(source,after)),0,16777216) end else
        if (value-123)*(value-91) == 0 do np_close(source,start,0,16777216) else
          if (value-94)*(value-45) == 0 do nc_end(source,after) else if value == 58 do nc_end(source,start+1) else
            if classify_ascii(value) == 2 do np_skip_name(source,start,64) else nc_end(source,start) end
          end end
        end
      end
