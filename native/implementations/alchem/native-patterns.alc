  # it and binds the pattern's names, and the environment with them.
  def np_statement(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    equals = np_skip(source,start)
    plain = nc_expression(source,nc_end(source,equals),env,table,depth)
    # A tuple accumulator is taken apart: its strings go on as the names.
    apart = if nc_tag(plain) != 5 do 0 else gm_apart(source,start,nc_end(source,equals),nc_pos(plain),env,table) end
    value = if apart == 0 do plain else nc_expression(source,nc_end(source,equals),gm_note(env,49,nc_start(source,nc_end(source,equals))),table,depth) end
    parsed = if nc_pos(value) < 0 do b[] else if nc_tag(value) == 12 do b[] else np_parse(source,start,env,table,nc_kind(value)) end end
    match = if nc_pos(parsed) < 0 do b[] else if nc_start(source,nc_pos(parsed)) != nc_start(source,equals) do b[] else np_emit(source,np_env(parsed),table,np_tree(parsed),0) end end
    if Enum.count(match) == 0 do b[] else np_pack(nc_pos(value),nc_join(nc_code(value),match,nz_must(table,start)),if apart == 0 do np_env(parsed) else gm_taken(np_env(parsed),np_env(parsed),2,start,equals) end) end
