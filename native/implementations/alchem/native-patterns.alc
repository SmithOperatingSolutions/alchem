    taken = Enum.concat(nc_code(body),Enum.concat(b[233],nc_u32(Enum.count(nc_code(rest)))))
    guarded = if Enum.count(check) == 0 do b[] else Enum.concat(check,nc_u32(Enum.count(taken))) end
