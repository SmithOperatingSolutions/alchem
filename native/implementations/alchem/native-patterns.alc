    parts = if count == 0 do b[176,1] else if Enum.count(inner) == 0 do b[] else nc_join(b[80],inner,b[89]) end end
    test = if layout == 1 do b[72,61,0,0,64,0,15,134] else if layout == 2 do zf_none(source,table,env) else
      if layout == 3 do if first < 128 do b[72,131,56,first,15,133] else nc_join(b[72,129,56],nc_u32(first),b[15,133]) end else if layout == 4 do if first < 128 do b[72,131,248,first,15,133] else nc_join(b[72,129,248],nc_u32(first),b[15,133]) end else
        if layout == 5 do if first < 128 do b[72,131,120,8,first,15,133] else nc_join(b[72,129,120,8],nc_u32(first),b[15,133]) end else if layout == 6 do b[72,131,56,0,15,133] else if layout == 7 do b[72,131,56,0,15,132] else b[] end end end
