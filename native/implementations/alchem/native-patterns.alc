  def np_arm(source: bytes, parsed: bytes, env: bytes, table: bytes, depth: integer, state: bytes): bytes do
    scope = np_env(parsed)
    guarded = nc_word(source,nc_pos(parsed),b[119,104,101,110])
    guard = if guarded == 0 do nc_value(nc_pos(parsed),b[],b[3]) else nc_condition(source,nc_end(source,nc_pos(parsed)),sg_conditional(scope),table,depth+1) end
    arrow = nc_expect(source,nc_pos(guard),b[45,62])
    row = if guarded == 1 do b[] else Enum.concat(nc_u32(Enum.count(np_tree(parsed))),np_tree(parsed)) end
    first = if arrow < 0 do b[] else nc_branch(source,arrow,scope,table,depth+1) end
    # An arm that waits for the type of the arms after it (nf_hinting).
    hinting = if arrow < 0 do b[] else if nc_pos(first) >= 0 do b[] else nf_trial(source,arrow,scope,table) end end
    trial = if Enum.count(hinting) == 0 do b[] else nc_branch(source,arrow,hinting,table,depth+1) end
    later = if nc_pos(trial) < 0 do b[] else np_arms(source,nc_pos(trial),env,table,depth,Enum.concat(state,row)) end
    settled = nf_settling(scope,later)
    body = if nc_pos(first) >= 0 do first else if Enum.count(settled) == 0 do b[] else nc_branch(source,arrow,settled,table,depth+1) end end
    plain = if nc_pos(body) < 0 do b[] else if nc_pos(later) >= 0 do later else np_arms(source,nc_pos(body),env,table,depth,Enum.concat(state,row)) end end
    # Later arms are expected to give the type of the first.
