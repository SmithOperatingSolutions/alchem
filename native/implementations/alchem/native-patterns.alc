      if byte_at(source,nc_start(source,next)) == 40 do np_close(source,nc_start(source,next),0,16777216) else next end
    end
  end
  # The position after the bracket that closes the one at pos (depth 0), or
  # the one pos is already inside (depth 1), within budget tokens; -1 when
  # there is none. The tokens are walked by halves, so that a call of ten
  # thousand tokens costs no depth of calls.
  def np_close(source: bytes, pos: integer, depth: integer, budget: integer): integer do
    state = np_close_run(source,nk_state(pos,depth,2),budget)
    if Enum.at(state,5,0) == 1 do nc_cursor(state,0) else -1 end
  end
  def np_close_run(source: bytes, state: bytes, size: integer): bytes do
    half = nc_half(size)
    if Enum.at(state,5,0) != 2 do state else if size <= 0 do nk_state(0,0,0) else
      if size == 1 do np_close_step(source,nc_cursor(state,0),nc_read(state,3)) else
        np_close_run(source,np_close_run(source,state,half),size-half)
      end
    end end
  end
  def np_close_step(source: bytes, pos: integer, depth: integer): bytes do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    if start < 0 do nk_state(0,0,0) else if start >= Enum.count(source) do nk_state(0,0,0) else if nc_end(source,start) < 0 do nk_state(0,0,0) else
      if (value-40)*(value-91)*(value-123) == 0 do nk_state(nc_end(source,start),depth+1,2) else
        if (value-41)*(value-93)*(value-125) != 0 do nk_state(nc_end(source,start),depth,2) else
