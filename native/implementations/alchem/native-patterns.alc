  # 1 when the pattern matches every value of its type, as a parameter of a
  # named function must; a pattern of fn p -> ... may fail when it is called.
  def np_total_match(source: bytes, tree: bytes): integer do
    1-np_useful(source,Enum.concat(nc_u32(Enum.count(tree)),tree),b[0],1)
  end
  # 1 when the parameter at pos is a plain name: type.
  def np_plain(source: bytes, pos: integer): integer do
    nc_identifier(source,pos)*nc_word(source,nc_end(source,pos),b[58])*(1-nc_word(source,pos,b[95]))
  end
  # A parameter that is a pattern takes its slot under a record with no name.
  def np_hidden(env: bytes, pos: integer, kind: bytes): bytes do
    if Enum.count(kind) == 0 do b[] else Enum.concat(env,nc_env_record(pos,pos,kind)) end
  end
  # The parameters of a function that are patterns, matched at its entry:
  # plan holds the parameter index and how many are left. The result has the
  # code and the environment with the patterns' names.
  def np_params(source: bytes, pos: integer, env: bytes, table: bytes, plan: bytes): bytes do
    index = nc_cursor(plan,0)
    start = nc_start(source,pos)
    annotation = nc_parameter_type(source,pos)
    next = nj_after(source,nc_pos(annotation))
    if nc_cursor(plan,3) == 0 do np_pack(pos,b[],env) else
      if np_plain(source,start) == 1 do np_params(source,next,env,table,Enum.concat(nc_u24(index+1),nc_u24(nc_cursor(plan,3)-1))) else
        parsed = np_parse(source,start,env,table,nt_read(env,nc_env_offset(env,index)+7))
        match = if nc_pos(parsed) < 0 do b[] else if np_total_match(source,np_tree(parsed)) == 0 do b[] else np_emit(source,np_env(parsed),table,np_tree(parsed),0) end end
        rest = if Enum.count(match) == 0 do b[] else np_params(source,next,np_env(parsed),table,Enum.concat(nc_u24(index+1),nc_u24(nc_cursor(plan,3)-1))) end
        if nc_pos(rest) < 0 do b[] else np_pack(pos,nc_join(nc_join(nc_slot(b[72,139,69],index),match,nz_must(table,start)),np_tree(rest),b[]),np_env(rest)) end
      end
    end
  end
  # 1 when the tree at offset holds a struct (layout 11) or sum variant (5) pattern.
  def np_named(tree: bytes, offset: integer): integer do
    layout = np_layout(tree,offset)
    if Enum.at(tree,offset,0) < 2 do 0 else
      if (layout-5)*(layout-11) == 0 do 1 else np_named_parts(tree,np_below(tree,offset),np_count(tree,offset)) end
    end
  end
  def np_named_parts(tree: bytes, offset: integer, count: integer): integer do
    if count == 0 do 0 else if np_named(tree,offset) == 1 do 1 else np_named_parts(tree,np_size(tree,offset),count-1) end end
  end
  # 1 when the lambda parameter at start is a plain name: one followed by a
  # comma or the arrow.
  def np_plain_name(source: bytes, start: integer): integer do
    next = nc_end(source,start)
    nc_identifier(source,start)*(nc_word(source,next,b[44])+nc_word(source,next,b[45,62]))
  end
  # The same for fn p, q -> ...: pos is at a parameter or at the arrow.
  def np_lambda(source: bytes, pos: integer, env: bytes, table: bytes, index: integer): bytes do
    start = nc_start(source,pos)
    stop = if np_plain_name(source,start) == 1 do nc_end(source,start) else np_skip(source,start) end
    next = if nc_word(source,stop,b[44]) == 1 do nc_end(source,stop) else stop end
    if nc_word(source,start,b[45,62]) == 1 do np_pack(pos,b[],env) else if stop < 0 do b[] else
      if np_plain_name(source,start) == 1 do np_lambda(source,next,env,table,index+1) else
        parsed = np_parse(source,start,env,table,nt_read(env,nc_env_offset(env,index)+7))
        # A struct or sum variant is not a pattern for a lambda's parameter, as in the pinned language.
        match = if nc_pos(parsed) < 0 do b[] else if np_named(np_tree(parsed),0) == 1 do b[] else np_emit(source,np_env(parsed),table,np_tree(parsed),0) end end
        rest = if Enum.count(match) == 0 do b[] else np_lambda(source,next,np_env(parsed),table,index+1) end
        if nc_pos(rest) < 0 do b[] else np_pack(pos,nc_join(nc_join(nc_slot(b[72,139,69],index),match,nz_must(table,start)),np_tree(rest),b[]),np_env(rest)) end
      end
    end end
  end
  # Native smoke test; patterns.
  def main() do System.halt(0) end
end
