  def np_case(source: bytes, value: bytes, env: bytes, table: bytes, depth: integer, at: integer): bytes do
    slot = nc_env_count(env,2)
    begin = nc_expect(source,nc_pos(value),b[100,111])
    held = Enum.concat(env,nc_env_record(at,at,nc_kind(value)))
