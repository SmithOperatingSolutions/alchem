defmodule NativePatterns do
  # Patterns in case arms, bindings and parameters. A pattern is parsed against
  # the type it matches into a tree:
  #   0                          _ : matches anything
  #   1, slot                    a name: matches anything and binds it
  #   2, n, total, layout, idlen, id..., children...
  #                              a constructor with n sub-patterns; total is
  #                              the number of constructors its type has (0
  #                              when there is no end to them, as for integers)
  # layout says how a value is tested and its parts found: 0 a tuple or struct,
  # 1 some, 2 none, 3 ok or error, 4 a boolean, 5 a sum variant, 6 an empty
  # list, 7 a list's head and tail, 8 a literal, 9 a pinned binding.
  #
  # A parse result is a packet: the position after the pattern, with the tree's
  # length (2 bytes), the tree and the environment with its names as code.
  def np_pack(pos: integer, tree: bytes, env: bytes): bytes do
    nc_value(pos,nc_join(nc_u32(Enum.count(tree)),tree,env),b[0])
  end
  def np_tree(parsed: bytes): bytes do
    nc_slice(nc_code(parsed),4,4+nc_long(nc_code(parsed),0))
  end
  def np_env(parsed: bytes): bytes do
    nc_slice(nc_code(parsed),4+nc_long(nc_code(parsed),0),Enum.count(nc_code(parsed)))
  end
  def np_node(count: integer, total: integer, layout: integer, id: bytes): bytes do
    nc_join(Enum.concat(b[2],nc_u24(count)),Enum.concat(nc_u24(total),b[layout]),Enum.concat(nc_u24(Enum.count(id)),id))
  end
  # The offset after the tree at offset, and after count trees.
  def np_size(tree: bytes, offset: integer): integer do
    tag = Enum.at(tree,offset,0)
    if tag == 0 do offset+1 else if tag == 1 do offset+4 else
      np_sizes(tree,np_below(tree,offset),np_count(tree,offset))
    end end
  end
  def np_sizes(tree: bytes, offset: integer, count: integer): integer do
    if count == 0 do offset else np_sizes(tree,np_size(tree,offset),count-1) end
  end
  # A constructor's fields: the number of its sub-patterns, the total of its
  # type, its layout, its id, the first three bytes of the id as a number (a
  # variant's index; one byte for the others) and where its sub-patterns start.
  def np_count(tree: bytes, offset: integer): integer do nc_cursor(tree,offset+1) end
  def np_all(tree: bytes, offset: integer): integer do nc_cursor(tree,offset+4) end
  def np_layout(tree: bytes, offset: integer): integer do Enum.at(tree,offset+7,0) end
  def np_below(tree: bytes, offset: integer): integer do offset+11+nc_cursor(tree,offset+8) end
  def np_id(tree: bytes, offset: integer): bytes do nc_slice(tree,offset+11,np_below(tree,offset)) end
  def np_first(tree: bytes, offset: integer): integer do
    if nc_cursor(tree,offset+8) >= 3 do nc_cursor(tree,offset+11) else Enum.at(tree,offset+11,0) end
  end
  def np_parse(source: bytes, pos: integer, env: bytes, table: bytes, kind: bytes): bytes do
    start = nc_start(source,pos)
    value = byte_at(source,start)
    tag = nt_tag(kind)
    if tag < 0 do b[] else if tag == 9 do b[] else
      if nc_word(source,start,b[95]) == 1 do np_pack(nc_end(source,start),b[0],env) else
        if value == 94 do np_pin(source,nc_end(source,start),env,table,kind) else
          if value == 123 do np_tuple(source,start,env,table,kind) else
            if value == 91 do np_list(source,nc_end(source,start),env,table,kind) else
              if value == 37 do
                if byte_at(source,nc_start(source,nc_end(source,start))) == 123 do np_map(source,nc_end(source,nc_end(source,start)),env,table,kind) else np_struct(source,start,env,table,kind) end
              else np_word(source,start,env,table,kind) end
            end
          end
        end
      end
    end end
  end
  def np_word(source: bytes, start: integer, env: bytes, table: bytes, kind: bytes): bytes do
    value = byte_at(source,start)
    open = nc_word(source,nc_end(source,start),b[40])
    tag = nt_tag(kind)
    if (value-34)*(value-45)*(value-58) == 0 do np_literal(source,start,env,kind) else if is_digit(value) == 1 do np_literal(source,start,env,kind) else
      if nc_word(source,start,b[116,114,117,101])+nc_word(source,start,b[102,97,108,115,101]) == 1 do
        if tag != 3 do b[] else np_pack(nc_end(source,start),np_node(0,2,4,b[nc_word(source,start,b[116,114,117,101])]),env) end
      else
        # none is the constructor for an option and a name for any other type.
        if nc_word(source,start,b[110,111,110,101]) == 1 do if tag != 4 do np_name(source,start,env,kind) else np_pack(nc_end(source,start),np_node(0,2,2,b[0]),env) end else
          if nc_word(source,start,b[115,111,109,101])*open == 1 do np_wrapped(source,start,env,table,kind) else
            if (nc_word(source,start,b[111,107])+nc_word(source,start,b[101,114,114,111,114]))*open == 1 do np_wrapped(source,start,env,table,kind) else
              if (value-65)*(90-value) >= 0 do np_variant(source,start,env,table,kind) else if open*np_step(source,table,kind) == 1 do np_variant(source,start,env,table,kind) else np_name(source,start,env,kind) end end
            end
          end
        end
      end
    end end
  end
  # 1 for step[a], the sum type whose variants are written without its name:
  # cont(p) and halt(p).
  def np_step(source: bytes, table: bytes, kind: bytes): integer do
    if nt_tag(kind) != 19 do 0 else nc_word(source,nc_meta(table,nd_id(table,kind),0),b[115,116,101,112]) end
  end
  def np_name(source: bytes, start: integer, env: bytes, kind: bytes): bytes do
    bound = if nc_identifier(source,start) == 0 do b[] else nc_bind(source,start,env,kind) end
    if Enum.count(bound) == 0 do b[] else np_pack(nc_end(source,start),Enum.concat(b[1],nc_u24(nc_env_count(env,2))),bound) end
  end
  # An integer, float, string or atom literal: its id is where it stands and its type.
  def np_literal(source: bytes, start: integer, env: bytes, kind: bytes): bytes do
    negative = if byte_at(source,start) == 45 do 1 else 0 end
    token = if negative == 1 do nc_start(source,nc_end(source,start)) else start end
    atom = if byte_at(source,token) == 58 do 1 else 0 end
    stop = if atom == 1 do nc_end(source,token+1) else nc_end(source,token) end
    text = if byte_at(source,token) == 34 do 2 else if atom == 1 do 2 else 0 end end
    # A string with a value in it is no pattern.
    plain = if byte_at(source,token) != 34 do 1 else if ns_tripled(source,token) == 1 do 1 else if nc_pos(ns_decode(source,token+1,0)) < 0 do 0 else 1 end end end
    valid = if plain == 0 do 0 else if text == 2 do 1-negative else is_digit(byte_at(source,token)) end end
    float = if text == 2 do 0 else if valid == 0 do 0 else ne_is(source,token,stop) end end
    if valid == 0 do b[] else if nt_tag(kind) != text+atom*20+float*24 do b[] else if stop < 0 do b[] else
      np_pack(stop,np_node(0,0,8,nc_join(nc_u24(start),nc_u24(stop),b[text+float*3])),env)
    end end end
  end
  # ^name matches the value of an existing binding.
  def np_pin(source: bytes, pos: integer, env: bytes, table: bytes, kind: bytes): bytes do
    name = nc_start(source,pos)
    slot = if nc_identifier(source,name) == 0 do -1 else nc_lookup(source,name,env,2) end
    held = if slot < 0 do b[] else nt_read(env,nc_env_offset(env,slot)+7) end
    if no_compatible(kind,held) == 0 do b[] else if nq_comparable(source,table,held,b[]) == 0 do b[] else
      np_pack(nc_end(source,name),np_node(0,0,9,Enum.concat(nc_u24(slot),held)),env)
    end end
  end
  # some(p), ok(p) and error(p).
  def np_wrapped(source: bytes, start: integer, env: bytes, table: bytes, kind: bytes): bytes do
    some = nc_word(source,start,b[115,111,109,101])
    good = nc_word(source,start,b[111,107])
    tag = nt_tag(kind)
    inner = if some == 1 do nt_child(kind,0) else nt_child(kind,1-good) end
    fits = if some == 1 do if tag == 4 do 1 else 0 end else if tag == 6 do 1 else 0 end end
    child = if fits == 0 do b[] else np_parse(source,nc_end(source,nc_end(source,start)),env,table,inner) end
    stop = nc_expect(source,nc_pos(child),b[41])
    node = if some == 1 do np_node(1,2,1,b[1]) else np_node(1,2,3,b[good]) end
    if stop < 0 do b[] else np_pack(stop,Enum.concat(node,np_tree(child)),np_env(child)) end
  end
  # Patterns for the types in cells, separated by commas and closed by the
  # byte closer; plan holds 0, the count and the closer. Each is parsed in
  # the environment the first one has, behind one record for the slots of
  # the names bound before it (nc_env_left), and the parts are joined in
  # runs of doubling length: the names of ten thousand parts were bound one
  # into the environment of the last, each with a copy of it. That no name
  # is bound twice is seen at the end, by sorting them (ev_pick).
  #
  # A run: where the next part starts, its index, the offset of its type in
  # cells, the slots bound so far, 1 after the last part, the length of the
  # trees; then the trees and the records bound.
  def np_children(source: bytes, pos: integer, env: bytes, table: bytes, cells: bytes, plan: bytes): bytes do
    all = np_parts_grow(source,env,table,cells,nc_join(nc_slice(plan,0,7),b[0],b[]),np_part(source,env,table,cells,plan,nc_join(nc_u24(pos),nc_zeros(15),b[])))
    size = nc_long(all,14)
    bound = nc_slice(all,18+size,Enum.count(all))
    entries = ev_scan(bound,nc_zeros(8),ev_count(bound,0,0),0)
    count = nc_units(Enum.count(entries)-8,13)
    if Enum.count(all) == 0 do b[] else if nc_cursor(plan,3) == 0 do b[] else
      if Enum.count(ev_pick(source,entries,8,count,1))+Enum.count(ev_pick(source,entries,8,count,0)) != count*13 do b[] else np_pack(nc_cursor(all,0),nc_slice(all,18,18+size),Enum.concat(env,bound)) end
    end end
  end
  def np_part(source: bytes, env: bytes, table: bytes, cells: bytes, plan: bytes, state: bytes): bytes do
    index = nc_cursor(state,3)
    cell = nc_long(state,6)
    scope = Enum.concat(env,nc_env_left(nc_cursor(state,10)))
    child = np_parse(source,nc_cursor(state,0),scope,table,nt_read(cells,cell))
    last = if index+1 == nc_cursor(plan,3) do 1 else 0 end
    after = if last == 1 do nc_expect(source,nc_pos(child),b[Enum.at(plan,6,0)]) else nc_expect(source,nc_pos(child),b[44]) end
    bound = nc_slice(np_env(child),Enum.count(scope),Enum.count(np_env(child)))
    if after < 0 do b[] else
      nc_join(nc_join(nc_u24(after),nc_u24(index+1),nc_u32(nt_after(cells,cell))),nc_join(nc_u24(nc_cursor(state,10)+nc_env_counted(bound,0,0)),b[last],nc_u32(Enum.count(np_tree(child)))),Enum.concat(np_tree(child),bound))
    end
  end
  def np_parts_joined(first: bytes, second: bytes): bytes do
    size = nc_long(first,14)
    more = nc_long(second,14)
    if Enum.count(first) == 0 do b[] else if Enum.count(second) == 0 do b[] else
      nc_join(Enum.concat(nc_slice(second,0,14),nc_u32(size+more)),Enum.concat(nc_slice(first,18,18+size),nc_slice(second,18,18+more)),Enum.concat(nc_slice(first,18+size,Enum.count(first)),nc_slice(second,18+more,Enum.count(second))))
    end end
  end
  # plan: as np_children has it, then the level.
  def np_parts_more(source: bytes, env: bytes, table: bytes, cells: bytes, plan: bytes, before: bytes): bytes do
    level = Enum.at(plan,7,0)
    first = if level == 0 do b[] else np_parts_more(source,env,table,cells,nc_join(nc_slice(plan,0,7),b[level-1],b[]),before) end
    if level == 0 do np_part(source,env,table,cells,plan,before) else
      if Enum.count(first) == 0 do b[] else if Enum.at(first,13,0) == 1 do first else np_parts_joined(first,np_parts_more(source,env,table,cells,nc_join(nc_slice(plan,0,7),b[level-1],b[]),first)) end end
    end
  end
  def np_parts_grow(source: bytes, env: bytes, table: bytes, cells: bytes, plan: bytes, done: bytes): bytes do
    if Enum.count(done) == 0 do b[] else if Enum.at(done,13,0) == 1 do done else
      np_parts_grow(source,env,table,cells,nc_join(nc_slice(plan,0,7),b[Enum.at(plan,7,0)+1],b[]),np_parts_joined(done,np_parts_more(source,env,table,cells,plan,done)))
    end end
  end
  # The types of count parts of kind from offset on as cells, behind the
  # offset after them: by halves, where each part was looked for from the
  # first (nq_tuple_cells).
  def np_cells(kind: bytes, offset: integer, count: integer): bytes do
    half = nc_half(count)
    left = if count < 2 do b[] else np_cells(kind,offset,half) end
    right = if count < 2 do b[] else np_cells(kind,nc_long(left,0),count-half) end
    stop = nt_end(kind,offset)
    if count == 0 do nc_u32(offset) else if count == 1 do Enum.concat(nc_u32(stop),nt_cell(nc_slice(kind,offset,stop))) else
      nc_join(nc_slice(right,0,4),nc_slice(left,4,Enum.count(left)),nc_slice(right,4,Enum.count(right)))
    end end
  end
  def np_tuple(source: bytes, start: integer, env: bytes, table: bytes, kind: bytes): bytes do
    count = nt_count(kind)
    open = nc_end(source,start)
    if nt_tag(kind) != 5 do b[] else
      if count == 0 do if nc_word(source,open,b[125]) != 1 do b[] else np_pack(nc_end(source,open),np_node(0,1,0,b[0]),env) end else
        parts = np_children(source,open,env,table,nc_slice(np_cells(kind,nt_first(kind),count),4,4194304*64),nc_join(nc_u24(0),nc_u24(count),b[125]))
        if nc_pos(parts) < 0 do b[] else np_pack(nc_pos(parts),Enum.concat(np_node(count,1,0,b[0]),np_tree(parts)),np_env(parts)) end
      end
    end
  end
  # Name.variant or Name.variant(p, ...) of the sum type kind.
  def np_variant(source: bytes, start: integer, env: bytes, table: bytes, kind: bytes): bytes do
    id = nd_id(table,kind)
    typed = if np_step(source,table,kind)*nc_word(source,nc_end(source,start),b[40]) == 1 do nc_value(start,nc_u16(id),b[0]) else nv_typed(source,start,table,nc_owner(table,nc_read(env,0))) end
    name = nc_pos(typed)
    index = if nc_pos(typed) < 0 do -1 else if nc_read(nc_code(typed),0) != id do -1 else nv_search(source,table,id,name,0) end end
    variant = nc_code(nv_at(source,table,id,index))
    count = nv_fields_of(variant)
    node = np_node(count,if id < 0 do 0 else nv_many(source,nc_meta(table,id,9),0) end,5,nc_u24(if index < 0 do 0 else index end))
    open = nc_end(source,name)
    if (nt_tag(kind)-14)*(nt_tag(kind)-19) != 0 do b[] else if index < 0 do b[] else
      if count == 0 do np_pack(open,node,env) else
        parts = if nc_word(source,open,b[40]) != 1 do b[] else np_children(source,nc_end(source,open),env,table,nu_apply_cells(nq_variant_cells(source,table,id,index),nd_subst(source,table,kind),0),nc_join(nc_u24(0),nc_u24(count),b[41])) end
        if nc_pos(parts) < 0 do b[] else np_pack(nc_pos(parts),Enum.concat(node,np_tree(parts)),np_env(parts)) end
      end
    end end
  end
  # %Name{field: p, ...}: fields not listed match anything. given holds, per
  # listed field, its index, its tree's length (2 bytes) and its tree.
  def np_struct(source: bytes, start: integer, env: bytes, table: bytes, kind: bytes): bytes do
    name = nc_start(source,nc_end(source,start))
    id = nd_id(table,kind)
    named = nd_named(source,name,table,nc_owner(table,nc_read(env,0)))
    open = nc_expect(source,nd_name_end(source,name),b[123])
    count = if id < 0 do -1 else nd_fields(source,table,id,0) end
    if (nt_tag(kind)-13)*(nt_tag(kind)-18) != 0 do b[] else if named != id do b[] else if open < 0 do b[] else if count < 0 do b[] else
      listed = np_listed(source,open,env,table,nc_join(nc_u16(id),nt_cell(kind),b[]))
      if nc_pos(listed) < 0 do b[] else
        np_pack(nc_pos(listed),Enum.concat(np_node(count,1,11,b[0]),np_ordered(np_tree(listed),0,count)),np_env(listed))
      end
    end end end end
  end
  def np_listed(source: bytes, pos: integer, env: bytes, table: bytes, spec: bytes): bytes do
    id = nc_read(spec,0)
    name = nc_start(source,pos)
    index = nd_search(source,table,id,name,0)
    # spec: the struct's id, the matched type as a cell, then the entries
    # listed so far: for each its field's index (3 bytes), its tree's length
    # (4 bytes) and its tree.
    listed = nc_slice(spec,nt_after(spec,2),Enum.count(spec))
    if nc_word(source,pos,b[125]) == 1 do np_pack(nc_end(source,pos),b[],env) else
      colon = nc_expect(source,nc_end(source,name),b[58])
      child = if index < 0 do b[] else if colon < 0 do b[] else if np_given(listed,index,0) >= 0 do b[] else np_parse(source,colon,env,table,nd_field_kind(source,table,nt_read(spec,2),index)) end end end
      next = nc_pos(child)
      after = if nc_word(source,next,b[44]) == 1 do nc_end(source,next) else next end
      entry = nc_join(nc_u24(if index < 0 do 0 else index end),nc_u32(Enum.count(np_tree(child))),np_tree(child))
      if next < 0 do b[] else if nc_word(source,next,b[44])+nc_word(source,next,b[125]) == 0 do b[] else
        rest = np_listed(source,after,np_env(child),table,Enum.concat(spec,entry))
        if nc_pos(rest) < 0 do b[] else np_pack(nc_pos(rest),Enum.concat(entry,np_tree(rest)),np_env(rest)) end
      end end
    end
  end
  # The offset in given of the entry for field index, -1 if it is not listed.
  def np_given(given: bytes, index: integer, offset: integer): integer do
    if offset >= Enum.count(given) do -1 else
      if nc_cursor(given,offset) == index do offset else np_given(given,index,offset+7+nc_long(given,offset+3)) end
    end
  end
  def np_ordered(given: bytes, index: integer, count: integer): bytes do
    offset = np_given(given,index,0)
    if index == count do b[] else
      Enum.concat(if offset < 0 do b[0] else nc_slice(given,offset+7,offset+7+nc_long(given,offset+3)) end,np_ordered(given,index+1,count))
    end
  end
  # %{key => p, ...} matches a map that holds every key with a value matching
  # its pattern; %{} matches any map. pos follows the "{". The node's id is the
  # key type's tag, then where each key expression starts and ends.
  def np_map(source: bytes, pos: integer, env: bytes, table: bytes, kind: bytes): bytes do
    if nt_tag(kind) != 8 do b[] else
      if nc_word(source,pos,b[125]) == 1 do np_pack(nc_end(source,pos),b[0],env) else
        entries = np_entries(source,pos,env,table,kind)
        count = nc_units(Enum.count(nc_kind(entries))-1,6)
        if nc_pos(entries) < 0 do b[] else np_pack(nc_pos(entries),Enum.concat(np_node(count,0,10,nc_kind(entries)),np_tree(entries)),np_env(entries)) end
      end
    end
  end
  # The entries from pos on: a packet whose type field is the node id so far.
  def np_entries(source: bytes, pos: integer, env: bytes, table: bytes, kind: bytes): bytes do
    key = nc_expression(source,pos,env,table,0)
    arrow = nc_expect(source,nc_pos(key),b[61,62])
    child = if arrow < 0 do b[] else if no_compatible(nt_child(kind,0),nc_kind(key)) == 0 do b[] else np_parse(source,arrow,env,table,nt_child(kind,1)) end end
    next = nc_pos(child)
    span = Enum.concat(nc_u24(nc_start(source,pos)),nc_u24(nc_pos(key)))
    if next < 0 do b[] else
      if nc_word(source,next,b[125]) == 1 do nc_value(nc_end(source,next),nc_code(np_pack(0,np_tree(child),np_env(child))),Enum.concat(b[nt_tag(nt_child(kind,0))],span)) else
        rest = if nc_word(source,next,b[44]) != 1 do b[] else np_entries(source,nc_end(source,next),np_env(child),table,kind) end
        if nc_pos(rest) < 0 do b[] else
          nc_value(nc_pos(rest),nc_code(np_pack(0,Enum.concat(np_tree(child),np_tree(rest)),np_env(rest))),nc_join(b[nt_tag(nt_child(kind,0))],span,nc_slice(nc_kind(rest),1,Enum.count(nc_kind(rest)))))
        end
      end
    end
  end
  # The value in RAX is the map: find each key and match its value. plan: the
  # entry index and count, then the offset of its sub-pattern (2 bytes).
  def np_emit_map(source: bytes, env: bytes, table: bytes, tree: bytes, offset: integer): bytes do
    inner = np_emit_entries(source,env,table,tree,nc_join(nc_u32(offset),Enum.concat(nc_u24(0),nc_u24(np_count(tree,offset))),nc_u32(np_below(tree,offset))))
    # A map of many entries is a tree (spec/alchem-memory.md, "Maps"): the
    # keys are looked for in its one leaf, which the collector's routine at
    # 0x400450 gives (the map itself when it has up to 32 entries).
    if Enum.count(inner) == 0 do b[] else nc_join(b[87,72,137,199,255,20,37,80,4,64,0,95,80],inner,b[89]) end
  end
  def np_emit_entries(source: bytes, env: bytes, table: bytes, tree: bytes, plan: bytes): bytes do
    node = nc_long(plan,0)
    index = nc_cursor(plan,4)
    count = nc_cursor(plan,7)
    at = nc_long(plan,10)
    key = nc_expression(source,nc_cursor(tree,node+12+index*6),env,table,0)
    same = if (Enum.at(tree,node+11,0)-2)*(Enum.at(tree,node+11,0)-22) == 0 do nq_code(source,table,b[2],b[]) else b[72,57,247,15,148,192] end
    child = np_emit(source,env,table,tree,at)
    size = Enum.count(same)+Enum.count(child)
    search = nc_join(nc_join(b[72,133,210,15,132],nc_u32(size+47),b[82,65,80,73,139,56,72,139,116,36,16]),same,nc_join(b[65,88,90,132,192,15,133,12,0,0,0,73,131,192,16,72,255,202,233],nq_rel(0-Enum.count(same)-43),b[]))
    found = nc_join(b[73,139,64,8,72,131,196,8],child,b[233,6,0,0,0,72,131,196,8,49,192])
    entry = nc_join(nc_join(nc_code(key),b[80,72,139,68,36,8,72,139,16,76,141,64,8],search),found,b[])
    rest = if index+1 == count do b[] else np_emit_entries(source,env,table,tree,nc_join(nc_u32(node),Enum.concat(nc_u24(index+1),nc_u24(count)),nc_u32(np_size(tree,at)))) end
    if nc_pos(key) < 0 do b[] else if Enum.count(child) == 0 do b[] else if index+1 == count do entry else
