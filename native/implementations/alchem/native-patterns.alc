  # 1 when a statement starts with a pattern that is bound: pattern = value.
  # A plain name = value is an ordinary binding.
  def np_binds(source: bytes, start: integer): integer do
    value = byte_at(source,start)
    next = byte_at(source,nc_start(source,nc_end(source,start)))
    shaped = if (value-123)*(value-91)*(value-37) == 0 do 1 else if classify_ascii(value) != 2 do 0 else if (next-40)*(next-46) == 0 do 1 else 0 end end end
    # A literal or a pinned binding is a pattern too: 1 = x, :ok = f(), true = g(), ^x = y.
    literal = if (value-58)*(value-34)*(value-45)*(value-94) == 0 do 1 else if is_digit(value) == 1 do 1 else nc_word(source,start,b[116,114,117,101])+nc_word(source,start,b[102,97,108,115,101]) end end
    if shaped+literal == 0 do 0 else nc_word(source,np_skip(source,start),b[61]) end
