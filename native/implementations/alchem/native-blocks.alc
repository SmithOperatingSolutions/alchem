defmodule NativeBlocks do
  # Blocks: the statements of a function body, a branch, a case arm or a
  # lambda, and the value the block ends in when it ends in one.
  #
  # A step is one statement, or several joined: the position after it, flags
  # (1 the block ends after it, 2 its value is not a call, 4 its value is
  # marked), the length of its code, the code, the type of its value (12 when
  # it leaves none) and the environment after it.
  def nx_pack(pos: integer, flags: integer, code: bytes, tail: bytes): bytes do
    nc_join(Enum.concat(nc_u24(pos),b[flags]),nc_u32(Enum.count(code)),Enum.concat(code,tail))
  end
  def nx_tail(kind: bytes, env: bytes): bytes do Enum.concat(nt_cell(kind),env) end
  def nx_flags(step: bytes): integer do Enum.at(step,3,0) end
  def nx_size(step: bytes): integer do nc_read(step,4)+nc_read(step,6)*65536 end
  def nx_code(step: bytes): bytes do nc_slice(step,8,8+nx_size(step)) end
  def nx_kind(step: bytes): bytes do nt_read(step,8+nx_size(step)) end
  # A value packet keeps "not a call" in bit 6 of its flags, beside the mark
  # in bit 7: an if or case whose value is dropped must end every branch in a
  # call.
  def nx_pure(value: bytes): integer do
    high = Enum.at(value,3,0)
    low = if high >= 128 do high-128 else high end
    if Enum.count(value) < 4 do 0 else if low >= 64 do 1 else 0 end end
  end
  def nx_impure(value: bytes): bytes do
    if Enum.count(value) < 4 do value else if nx_pure(value) == 1 do value else
      Enum.concat(nc_slice(value,0,3),Enum.concat(b[Enum.at(value,3,0)+64],nc_slice(value,4,Enum.count(value))))
    end end
  end
  # The type two branches join in: a branch that leaves no value leaves the
  # whole without one, and so do two calls of different types, which can only
  # be statements.
  def nx_join(first: bytes, second: bytes): bytes do
    merged = nt_merge(nc_kind(first),nc_kind(second))
    if (nc_tag(first)-12)*(nc_tag(second)-12) == 0 do b[12] else if nj_ended(second) == 1 do nc_kind(first) else
      if (nc_tag(first)-9)*(nc_tag(first)-9)+(nc_tag(second)-9)*(nc_tag(second)-9) == 0 do nj_both_left(first,second) else
        if nt_tag(merged) >= 0 do merged else if nx_pure(first)+nx_pure(second) > 0 do b[] else b[12] end end
      end
    end end
  end
  # 1 when the block ends at pos: end, else, the pattern of the next arm of a
  # case or the condition of the next arm of a cond.
  def nx_ends(source: bytes, pos: integer): integer do
    start = nc_start(source,pos)
    after = if start < 0 do -1 else np_skip(source,start) end
    if nc_word(source,start,b[101,110,100])+nc_word(source,start,b[101,108,115,101]) > 0 do 1 else
      # fn -> value end is a function without parameters, not an arm.
      if after < 0 do nk_arm_starts(source,start) else if nc_word(source,after,b[45,62])*(1-nc_word(source,start,b[102,110]))+nc_word(source,after,b[119,104,101,110]) > 0 do 1 else nk_arm_starts(source,start) end end
    end
  end
  # The position after a dotted name and every (...) that follows it.
  def nx_chain(source: bytes, start: integer): integer do
    nx_calls(source,np_skip_name(source,start,64),1024)
  end
  def nx_calls(source: bytes, pos: integer, budget: integer): integer do
    if pos < 0 do -1 else if budget == 0 do pos else
      # A ( on a later line starts a statement of its own.
      if byte_at(source,nc_start(source,pos)) == 40 do if nf_same_line(source,pos,nc_start(source,pos)) == 0 do pos else nx_calls(source,np_close(source,nc_start(source,pos),0,16777216),budget-1) end else pos end
    end end
  end
  def nx_piped(source: bytes, pos: integer, budget: integer): integer do
    start = nc_start(source,pos)
    if pos < 0 do -1 else if budget == 0 do pos else
      if byte_at(source,start)*256+byte_at(source,start+1) != 31806 do pos else nx_piped(source,nx_chain(source,nc_start(source,start+2)),budget-1) end
    end end
  end
  # 1 for the words that start a form with blocks.
  def nx_form(source: bytes, start: integer): integer do
    if nc_word(source,start,b[105,102])+nc_word(source,start,b[117,110,108,101,115,115])+nc_word(source,start,b[99,97,115,101])+nc_word(source,start,b[99,111,110,100])+nc_word(source,start,b[119,105,116,104])+nc_word(source,start,b[102,111,114])+nc_word(source,start,b[116,114,121]) > 0 do 1 else 0 end
  end
  # ( IO.puts(text) ) as a statement is the statement in it.
  def nx_wrapped(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    step = nx_output(source,nc_start(source,start+1),env,table,depth)
    close = nc_expect(source,nc_pos(step),b[41])
    if close < 0 do b[] else nx_done(source,close,nx_code(step),env) end
  end
  # 1 when the expression from start to stop is what a statement may be: a
  # call, any expression piped into one, or on a block's last line a variant
  # by name.
  def nx_callish(source: bytes, start: integer, stop: integer): integer do
    first = byte_at(source,start)
    last = if classify_ascii(first) != 2 do -1 else nx_piped(source,nx_chain(source,start),16777216) end
    # ( call ) is the call.
    close = if first != 40 do -1 else np_close(source,start,0,16777216) end
    if close > 0 do if nc_start(source,close) == nc_start(source,stop) do nx_callish(source,nc_start(source,start+1),close-1)*(1-nx_form(source,nc_start(source,start+1))) else nk_piped(source,start,stop) end else
    if last < 0 do nk_piped(source,start,stop) else if nc_start(source,last) != nc_start(source,stop) do nk_piped(source,start,stop) else
      if byte_at(source,last-1) == 41 do 1 else if nc_word(source,start,b[110,111,110,101]) == 1 do 1 else if (first-65)*(90-first) >= 0 do 1 else 0 end end end
    end end end
  end
  # 1 for ok(, error( and some(: values, which only end a block.
  def nx_constructor(source: bytes, start: integer): integer do
    nc_word(source,start,b[111,107])+nc_word(source,start,b[101,114,114,111,114])+nc_word(source,start,b[115,111,109,101])+nc_word(source,start,b[110,111,110,101])
  end
  def nx_done(source: bytes, pos: integer, code: bytes, env: bytes): bytes do
    nx_pack(pos,ty_ends(source,pos,env),code,nx_tail(b[12],env))
  end
  def nx_output(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    dot = nc_expect(source,nc_end(source,start),b[46])
    kind = ns_output_kind(source,dot)
    begin = nc_expect(source,nc_end(source,dot),b[40])
    value = if begin < 0 do b[] else nc_expression(source,begin,env,table,depth) end
    stop = if nc_pos(value) < 0 do -1 else if nc_tag(value) != 2 do -1 else nc_expect(source,nc_pos(value),b[41]) end end
    if stop < 0 do b[] else nx_done(source,stop,Enum.concat(nc_code(value),ns_output_emit(kind)),env) end
  end
  def nx_binding(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    value = nf_bound(source,start,env,table,depth)
    slot = nc_env_count(env,2)
    bound = if nc_pos(value) < 0 do b[] else if nc_tag(value) == 12 do b[] else nc_bind(source,start,env,nc_kind(value)) end end
    if Enum.count(bound) == 0 do b[] else
      # On ARM64 a product bound to a name keeps its factors in the two slots
      # after it (ne_factor_slots), which a read of the name makes a product
      # of again: Go's compiler fuses through a variable.
      kept = if nc_arm() == 1 do (if ne_is_product(value) == 1 do 1 else 0 end) else 0 end
      # A name bound to a constant is one in Go's SSA: a hidden record of
      # kind 24, 197 after it says so (ne_constant_slot).
      constant = if nc_arm() == 1 do (if nc_tag(value) == 24 do ne_go_constant(value) else 0 end) else 0 end
      factors = if kept == 0 do b[] else nc_join(nc_slot(b[72,137,77],slot+1),b[102,72,15,126,200],nc_slot(b[72,137,69],slot+2)) end
      held = if kept == 1 do np_hidden(np_hidden(bound,start,nc_kind(value)),start,nc_kind(value)) else if constant == 1 do np_hidden(bound,start,b[24,197]) else bound end end
      nx_done(source,nc_pos(value),nc_join(nc_code(value),nc_slot(b[72,137,69],slot),factors),held)
    end
  end
  def nx_pattern(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    bound = np_statement(source,start,env,table,depth)
    if nc_pos(bound) < 0 do b[] else nx_done(source,nc_pos(bound),np_tree(bound),np_env(bound)) end
  end
  # System.halt(status) and System.stop(status) end the program where they stand.
  def nx_halts(source: bytes, start: integer): integer do
    dot = nc_expect(source,nc_end(source,start),b[46])
    if nc_word(source,start,b[83,121,115,116,101,109]) != 1 do 0 else
      if dot < 0 do 0 else nc_word(source,dot,b[104,97,108,116])+nc_word(source,dot,b[115,116,111,112]) end
    end
  end
  def nx_halt(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    dot = nc_expect(source,nc_end(source,start),b[46])
    args = nc_expect(source,nc_end(source,dot),b[40])
    result = if args < 0 do b[] else nc_expression(source,args,env,table,depth) end
    after = if nc_pos(result) < 0 do -1 else if nc_tag(result) != 0 do -1 else nc_expect(source,nc_pos(result),b[41]) end end
    if after < 0 do b[] else nx_done(source,after,Enum.concat(nc_code(result),ac_exit(source,table,start,dot)),env) end
  end
  # An expression: the block's value when the block ends after it, otherwise a
  # statement, which must be a call.
  # An if or case that is the whole statement, not part of an expression: 0
  # when an operator, a pipe or a field follows its end.
  def nx_whole(source: bytes, pos: integer): integer do
    value = byte_at(source,nc_start(source,pos))
    if pos < 0 do 0 else
      if nc_and((value-43)*(value-45)*(value-42)*(value-47)*(value-60),(value-62)*(value-61)*(value-33)*(value-124)*(value-46)) == 0 do 0 else
        1-nc_word(source,pos,b[97,110,100])-nc_word(source,pos,b[111,114])
      end
    end
  end
  # Only an if or case inside an expression is a closure (nz_closure); one
  # that is the statement itself is compiled as it stands.
  def nx_expression(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    chained = wc_keyword(source,start,env)
    form = nc_word(source,start,b[105,102])+nc_word(source,start,b[117,110,108,101,115,115])+nc_word(source,start,b[99,97,115,101])+nc_word(source,start,b[99,111,110,100])+chained
    # A form whose value is dropped drops what its blocks end in (wf_inherit).
    scope = if form == 0 do env else wf_inherit(source,start,env,table) end
    direct = if nc_word(source,start,b[105,102]) == 1 do nc_if(source,nc_end(source,start),scope,table,depth+1) else
      if nc_word(source,start,b[117,110,108,101,115,115]) == 1 do nc_unless(source,nc_end(source,start),scope,table,depth+1) else
      if nc_word(source,start,b[99,97,115,101]) == 1 do no_case(source,start,scope,table,depth) else if nc_word(source,start,b[99,111,110,100]) == 1 do nk_cond(source,start,scope,table,depth) else if chained == 1 do wc_with(source,start,scope,table,depth) else if wf_keyword(source,start,env) == 1 do wf_auto(source,start,env,table,depth) else if ty_keyword(source,start,env) == 1 do ty_try(source,start,env,table,depth,1) else b[] end end end end end
    end end
    # A form that did not compile as the statement it is may compile as a
    # value (an if that ends in throw; a case whose arms end in an if
    # without else). Tried at every level of nesting that doubles the work
    # at each (an error twenty forms deep took the machine's memory), so the
    # try is marked in the environment (a record of type 45) and none
    # stands inside another.
    if nx_whole(source,nc_pos(direct)) == 1 do direct else if (form-chained)*(0-nc_pos(direct)) > 0 do nx_again(source,start,env,table,depth) else nc_expression(source,start,env,table,depth) end end
  end
  def nx_again(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    marked = nj_mark(env,b[45])
    # Not past 32 levels of nesting either: a failure at the bottom of 250
    # nested forms would be tried again at every one of them.
    if depth > 32 do b[] else if nx_tries(env,2,0) >= 1 do b[] else if Enum.count(marked) == Enum.count(env) do b[] else nc_expression(source,start,marked,table,depth) end end end
  end
  def nx_tries(env: bytes, offset: integer, found: integer): integer do
    if offset >= Enum.count(env) do found else nx_tries(env,nc_env_next(env,offset),if nt_tag(nt_read(env,offset+7)) == 45 do found+1 else found end) end
  end
  def nx_value(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    plain = nx_expression(source,start,env,table,depth)
    value = if nc_pos(plain) >= 0 do plain else nf_tail(source,start,env,table,depth) end
    stop = nc_pos(value)
    ends = if stop < 0 do 0 else ty_ends(source,stop,env) end
    branching = nc_word(source,start,b[105,102])+nc_word(source,start,b[99,97,115,101])+nc_word(source,start,b[117,110,108,101,115,115])+nc_word(source,start,b[99,111,110,100])+wc_keyword(source,start,env)+wf_keyword(source,start,env)+ty_keyword(source,start,env)
    formed = if stop < 0 do 0 else if branching == 1 do 0 else zf_formed(source,table,env,value,start) end end
    pure = if stop < 0 do 0 else if nc_tag(value) == 12 do 0 else if branching == 1 do nx_pure(value) else if formed == 1 do 1 else 1-nx_callish(source,start,stop) end end end end
    if stop < 0 do b[] else
      if (nc_tag(value)-12)*(1-nh_effect(source,start,env,ends)) == 0 do if branching*nx_pure(value) == 1 do b[] else nx_done(source,stop,nc_code(value),env) end else
        # Nothing may follow an if or case that returns on every path.
        if ends == 0 do if pure+nx_constructor(source,start)+branching*nj_left(value)+formed > 0 do b[] else nx_pack(stop,0,nc_code(value),nx_tail(b[12],env)) end else
          nx_pack(stop,1+pure*2+nw_marked(value)*4,nc_code(tl_value(source,start,env,table,depth,value)),nx_tail(nc_kind(value),env))
        end
      end
    end
  end
  # One statement, behind the code that notes where it is.
  def nx_step(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    start = nc_start(source,pos)
    step = if start < 0 do b[] else nx_one(source,start,env,table,depth) end
    if nc_pos(step) < 0 do b[] else nx_pack(nc_pos(step),nx_flags(step),nc_join(Enum.concat(nz_at(table,start),zf_cover_step(source,table,env,start)),ac_statement(source,table,env),Enum.concat(nx_code(step),gm_cleared(source,table,env,start,nc_pos(step)))),nc_slice(step,8+nx_size(step),Enum.count(step))) end
  end
  def nx_one(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    if start < 0 do b[] else if nc_word(source,start,b[114,101,116,117,114,110]) == 1 do nj_return(source,start,env,table,depth) else
      if ns_output_statement(source,start) == 1 do nx_output(source,start,env,table,depth) else
        if byte_at(source,start) == 40 do if ns_output_statement(source,nc_start(source,start+1)) == 1 do nx_wrapped(source,start,env,table,depth) else nx_plain(source,start,env,table,depth) end else nx_plain(source,start,env,table,depth) end
      end
    end end
  end
  def nx_plain(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    # none = value matches an option against none; of another type it binds the name.
    matched = if nc_word(source,start,b[110,111,110,101])*nc_word(source,nc_end(source,start),b[61]) == 0 do b[] else nx_pattern(source,start,env,table,depth) end
    if Enum.count(matched) > 0 do matched else if nf_binds(source,start) == 1 do nx_binding(source,start,env,table,depth) else
      if np_binds(source,start) == 1 do nx_pattern(source,start,env,table,depth) else
        if nx_halts(source,start) == 1 do nx_halt(source,start,env,table,depth) else nx_value(source,start,env,table,depth) end
      end
    end end
  end
  # The block at pos: the position after it, its code and the type of the
  # value it ends in, 12 when it ends in a statement.
  def nx_block(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    done = ev_block(source,pos,env,table,b[depth,0])
    flags = ev_flags(done)
    marked = if flags >= 4 do 1 else 0 end
    value = if ev_pos(done) < 0 do b[] else nc_value(ev_pos(done),ev_code(done),ev_kind(done)) end
    plain = if marked == 1 do nw_mark(value) else value end
    if flags-marked*4 >= 2 do nx_impure(plain) else plain end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
