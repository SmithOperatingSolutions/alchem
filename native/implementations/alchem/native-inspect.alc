defmodule NativeInspect do
  # inspect(value) and IO.inspect(value): any value as text in source form.
  # Values carry no type at run time, so the compiler writes a description of
  # the value's type behind the call and the routine in the Integer.parse
  # runtime (spec/integer-parse-x86_64.s) walks the value by it. A
  # description is a node: its length, a tag and what the tag needs.
  def ni_node(tag: integer, payload: bytes): bytes do if Enum.count(payload) > 65532 do b[] else nc_join(nc_u16(Enum.count(payload)+3),b[tag],payload) end end
  # A count, and a name behind its length: one byte, or from 255 on the byte
  # 255 and 32 bits (ins_count of spec/integer-parse-x86_64.s).
  def ni_count(count: integer): bytes do
    if count < 255 do b[count] else Enum.concat(b[255],nc_u32(count)) end
  end
  # 1 when the description is for the JSON library (seen starts with a type
  # of the one byte 254 or 255), which reads a count and the length of a
  # name as one byte: a type that needs more has no description there.
  def ni_narrow(seen: bytes): integer do if Enum.at(seen,1,0) >= 254 do 1 else 0 end end
  def ni_held(seen: bytes, count: integer): bytes do
    if count*ni_narrow(seen) >= 255 do b[] else ni_count(count) end
  end
  def ni_text(name: bytes): bytes do Enum.concat(ni_count(Enum.count(name)),name) end
  # A count that a byte holds, for the descriptions that have no other; b[] past it.
  def ni_small(count: integer): bytes do if count > 250 do b[] else b[count] end end
  # Where the node of a named type being described starts, -1 when it is not
  # among them. seen: per type its length, the type and the offset.
  def ni_seen(seen: bytes, kind: bytes, offset: integer): integer do
    size = Enum.at(seen,offset,0)
    if offset >= Enum.count(seen) do -1 else
      if nt_same(nc_slice(seen,offset+1,offset+1+size),kind) == 1 do nc_read(seen,offset+1+size) else ni_seen(seen,kind,offset+3+size) end
    end
  end
  # The node of a type, which starts base bytes after the first node. b[] for
  # a type that cannot be described: bytes, or a type variable whose twin
  # is not among seen (native-described.alc).
  def ni_describe(source: bytes, table: bytes, kind: bytes, base: integer, seen: bytes): bytes do
    tag = nt_tag(kind)
    if tag == 26 do ni_node(10,b[]) else if (tag-0)*(tag-2)*(tag-3)*(tag-10)*(tag-22)*(tag-23)*(tag-29) == 0 do ni_node(tag,b[]) else if tag == 24 do ni_node(24,nc_u32(4195456+ne_slot(table)*8)) else if tag == 9 do ni_node(0,b[]) else
      if (tag-4)*(tag-7)*(tag-25) == 0 do ni_wrap(tag,ni_describe(source,table,nt_child(kind,0),base+3,seen),b[1]) else
        if (tag-6)*(tag-8) == 0 do
          first = ni_describe(source,table,nt_child(kind,0),base+3,seen)
          ni_wrap(tag,first,if Enum.count(first) == 0 do b[] else ni_behind(ni_describe(source,table,nt_child(kind,1),base+3+Enum.count(first),seen)) end)
        else
          if tag == 5 do ni_wrap(5,ni_held(seen,nt_count(kind)),ni_items(source,table,nq_tuple_cells(kind,0),Enum.concat(nc_u24(0),nc_u24(base+3+Enum.count(ni_count(nt_count(kind))))),seen)) else if tag == 16 do jd_hole(seen,kind) else ni_named(source,table,kind,base,seen) end end
        end
      end
    end end end end
  end
  # node behind a 1, unless it failed.
  def ni_behind(node: bytes): bytes do
    if Enum.count(node) == 0 do b[] else Enum.concat(b[1],node) end
  end
  # A node of head and the rest, which follows a 1 unless it failed.
  def ni_wrap(tag: integer, head: bytes, rest: bytes): bytes do
    if Enum.count(head) == 0 do b[] else if Enum.count(rest) == 0 do b[] else ni_node(tag,Enum.concat(head,nc_slice(rest,1,Enum.count(rest)))) end end
  end
  # The nodes of the types in cells, behind a 1. place: the offset in cells
  # and where the next node starts, 24 bits each.
  def ni_items(source: bytes, table: bytes, cells: bytes, place: bytes, seen: bytes): bytes do
    offset = nc_cursor(place,0)
    kind = nt_read(cells,offset)
    node = if offset >= Enum.count(cells) do b[] else ni_describe(source,table,kind,nc_cursor(place,3),seen) end
    rest = if Enum.count(node) == 0 do b[] else ni_items(source,table,cells,Enum.concat(nc_u24(nt_after(cells,offset)),nc_u24(nc_cursor(place,3)+Enum.count(node))),seen) end
    if offset >= Enum.count(cells) do b[1] else if Enum.count(rest) == 0 do b[] else nc_join(b[1],node,nc_slice(rest,1,Enum.count(rest))) end end
  end
  def ni_named(source: bytes, table: bytes, kind: bytes, base: integer, seen: bytes): bytes do
    id = nd_id(table,kind)
    back = ni_seen(seen,kind,0)
    name = if id < 0 do b[] else ni_text(nc_slice(source,nc_meta(table,id,0),nc_meta(table,id,3))) end
    inner = if Enum.count(kind) > 255 do b[] else nc_join(seen,Enum.concat(b[Enum.count(kind)],kind),nc_u16(base)) end
    # A handle of the library is written as a name between # and <>: the process types (ac_shown) and a generator.
    fixed = if nt_same(name,b[9,103,101,110,101,114,97,116,111,114]) == 1 do b[12,35,103,101,110,101,114,97,116,111,114,60,62,0] else ac_shown(nc_slice(name,1,Enum.count(name))) end
    # A date or time of the library is written as its sigil.
    sigil = sg_calendar(source,table,id)
    count = if id < 0 do b[] else if Enum.count(name)*ni_narrow(seen) > 255 do b[] else if Enum.at(table,id*27+16,0) == 64 do ni_held(seen,ni_field_count(source,table,id,0)) else ni_held(seen,ni_variant_count(source,table,id,0)) end end end
    start = base+3+Enum.count(name)+Enum.count(count)
    if id < 0 do b[] else if sigil > 0 do ni_node(sigil,b[]) else if Enum.count(fixed) > 0 do ni_node(13,fixed) else if back >= 0 do ni_node(20,nc_u16(back)) else if start > 60000 do b[] else if Enum.count(kind) > 255 do b[] else if Enum.count(count) == 0 do b[] else
      if Enum.at(table,id*27+16,0) == 64 do
        ni_wrap(13,Enum.concat(name,count),ni_fields(source,table,kind,nc_join(nc_u24(0),nc_u24(start),nc_u24(nc_meta(table,id,9))),inner))
      else
        ni_wrap(14,Enum.concat(name,count),ni_variants(source,table,kind,nc_join(nc_u24(0),nc_u24(start),nc_u24(nc_meta(table,id,9))),inner))
      end
    end end end end end end end
  end
  def ni_field_count(source: bytes, table: bytes, id: integer, index: integer): integer do
    ni_shown_from(source,table,id,nc_meta(table,id,9),0)
  end
  # The fields from the one at pos on that are part of the struct's value.
  def ni_shown_from(source: bytes, table: bytes, id: integer, pos: integer, index: integer): integer do
    field = if nc_word(source,pos,b[101,110,100]) == 1 do b[] else nd_field(source,table,id,pos) end
    if ni_shown(source,field) == 0 do index else ni_shown_from(source,table,id,nc_pos(field),index+1) end
  end
  # 1 for a field that is part of its struct's value. One whose name ends in
  # byte 127, which only the library can write, is not: inspect and == pass
  # over it and those after it (Markup keeps there how it was made).
  def ni_shown(source: bytes, field: bytes): integer do
    if nc_pos(field) < 0 do 0 else if byte_at(source,nc_end(source,nc_cursor(nc_code(field),0))-1) == 127 do 0 else 1 end end
  end
  def ni_variant_count(source: bytes, table: bytes, id: integer, index: integer): integer do
    nv_count(source,table,id,0)
  end
  # Per field of a struct the length of its name, the name and its node,
  # behind a 1. place: the field's index and where its record starts.
  def ni_fields(source: bytes, table: bytes, kind: bytes, place: bytes, seen: bytes): bytes do
    index = nc_cursor(place,0)
    base = nc_cursor(place,3)
    field = nd_field_here(source,table,nd_id(table,kind),nc_cursor(place,6))
    shown = ni_shown(source,field)
    name = if shown == 0 do b[] else ni_text(nc_slice(source,nc_cursor(nc_code(field),0),nc_end(source,nc_cursor(nc_code(field),0)))) end
    plain = if shown == 0 do b[] else if Enum.count(name)*ni_narrow(seen) > 255 do b[] else ni_describe(source,table,nu_apply(nc_kind(field),nd_subst(source,table,kind)),base+Enum.count(name),seen) end end
    # For JSON.decode_as (seen starts with a type of the one byte 255) an
    # option that a type variable stands for is tag 34: such a field may
    # not be left out, as one declared an option may.
    node = if Enum.at(seen,1,0) != 255 do plain else if nt_tag(nc_kind(field)) != 16 do plain else if Enum.at(plain,2,0) != 4 do plain else nc_join(nc_slice(plain,0,2),b[34],nc_slice(plain,3,Enum.count(plain))) end end end
    rest = if Enum.count(node) == 0 do b[] else ni_fields(source,table,kind,nc_join(nc_u24(index+1),nc_u24(base+Enum.count(name)+Enum.count(node)),nc_u24(nc_pos(field))),seen) end
    if shown == 0 do b[1] else if Enum.count(rest) == 0 do b[] else
      nc_join(b[1],Enum.concat(name,node),nc_slice(rest,1,Enum.count(rest)))
    end end
  end
  # Per variant of a sum type its length, the length of its name, the name,
  # the field count and a node per field, behind a 1.
  def ni_variants(source: bytes, table: bytes, kind: bytes, place: bytes, seen: bytes): bytes do
    index = nc_cursor(place,0)
    base = nc_cursor(place,3)
    id = nd_id(table,kind)
    variant = nv_here(source,nc_cursor(place,6))
    name = if nc_pos(variant) < 0 do b[] else ni_text(nc_slice(source,nc_cursor(nc_code(variant),0),nc_end(source,nc_cursor(nc_code(variant),0)))) end
    count = if Enum.count(name)*ni_narrow(seen) > 255 do b[] else ni_held(seen,nv_fields_of(nc_code(variant))) end
    cells = if nc_pos(variant) < 0 do b[] else nu_apply_cells(nq_cells_of(source,table,id,nc_code(variant)),nd_subst(source,table,kind),0) end
    items = if nc_pos(variant) < 0 do b[] else if Enum.count(count) == 0 do b[] else ni_items(source,table,cells,Enum.concat(nc_u24(0),nc_u24(base+2+Enum.count(name)+Enum.count(count))),seen) end end
    record = nc_join(name,count,nc_slice(items,1,Enum.count(items)))
    rest = if Enum.count(items) == 0 do b[] else if Enum.count(record) > 65000 do b[] else ni_variants(source,table,kind,nc_join(nc_u24(index+1),nc_u24(base+2+Enum.count(record)),nc_u24(nc_pos(variant))),seen) end end
    if nc_pos(variant) < 0 do b[1] else if Enum.count(rest) == 0 do b[] else
      nc_join(b[1],Enum.concat(nc_u16(Enum.count(record)+2),record),nc_slice(rest,1,Enum.count(rest)))
    end end
  end
  # The text of the value in RDI, a string in RAX. b[] when its type cannot
  # be described.
  def ni_code(source: bytes, table: bytes, kind: bytes): bytes do
    node = ni_describe(source,table,kind,0,b[])
    if Enum.count(node) == 0 do b[] else
      nc_join(nc_join(xa_mark(Enum.count(node),b[72,141,53,19,0,0,0]),b[186,4,0,0,0],nc_call(nc_records(Enum.count(table)))),Enum.concat(b[233],nc_u32(Enum.count(node))),node)
    end
  end
  # The same where the type may mention the type variables of the function
  # the environment is of.
  def ni_shown_code(source: bytes, table: bytes, kind: bytes, env: bytes): bytes do
    if nu_open(kind,0) == 0 do ni_code(source,table,kind) else jd_show(source,table,kind,nu_vars(env,2)) end
  end
  # inspect(value): its text.
  def ni_call(source: bytes, table: bytes, args: bytes, env: bytes): bytes do
    code = if nc_arg_count(args) != 1 do b[] else ni_shown_code(source,table,nc_arg_kind(args,0),env) end
    if Enum.count(code) == 0 do b[] else nc_value(nc_pos(args),nc_join(nc_arg_code(args),b[95],code),b[2]) end
  end
  # IO.inspect(value) writes the text and a line break and gives the value.
  def ni_io(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    dot = nc_expect(source,nc_end(source,pos),b[46])
    begin = if nc_word(source,dot,b[105,110,115,112,101,99,116]) == 0 do -1 else nc_expect(source,nc_end(source,dot),b[40]) end
    args = if begin < 0 do b[] else nc_arguments(source,begin,env,table,depth) end
    code = if nc_pos(args) < 0 do b[] else if nc_arg_count(args) != 1 do b[] else ni_shown_code(source,table,nc_arg_kind(args,0),env) end end
    # IO.ANSI.name() is a library module of its own, written in Alchem as ANSI.
    if nc_word(source,dot,b[65,78,83,73]) == 1 do ny_call(source,nc_start(source,dot),env,table,depth) else if begin < 0 do ny_or(na_input_limit(source,table,pos,zf_wrap(na_io(source,pos),table,nc_start(source,pos))),source,pos,env,table,depth) else if Enum.count(code) == 0 do b[] else
      nw_library(nc_value(nc_pos(args),nc_join(nc_arg_code(args),Enum.concat(b[72,139,60,36],code),Enum.concat(ns_output_emit(2),b[88])),nc_arg_kind(args,0)),args,2)
    end end end
  end
  # Whether the source mentions inspect, which needs the routine.
  def ni_mentions(source: bytes, first: integer, stop: integer): integer do
    if stop-first > 64 do
      middle = first+nc_half(stop-first)
      if ni_mentions(source,first,middle) == 1 do 1 else ni_mentions(source,middle,stop) end
    else ni_scan(source,first,stop) end
  end
  def ni_scan(source: bytes, pos: integer, stop: integer): integer do
    if pos >= stop do 0 else
      if byte_at(source,pos) != 105 do ni_scan(source,pos+1,stop) else
        if nc_word(source,pos,b[105,110,115,112,101,99,116]) == 1 do 1 else ni_scan(source,pos+1,stop) end
      end
    end
  end
  # Native smoke test; assembled with the compiler.
  def main() do System.halt(0) end
end
