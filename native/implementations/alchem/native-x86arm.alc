  # adc (2), sbb (3): x86-64's carry brought into ARM's C as each reads it.
  def xa_carry_op(sub: integer, w: integer, pol: integer): bytes do
    if sub == 2 do Enum.concat(if pol == 0 do Enum.concat(a_cset(21,3),a_cmp_value(21,1)) else b[] end,a_alu(3120562176,19,19,20,w)) else
      Enum.concat(if pol == 1 do Enum.concat(a_cset(21,3),a_cmp_value(21,1)) else b[] end,a_alu(4194304000,19,19,20,w))
    end
  end
  # The flags' origin after rec (0 subtraction, 1 addition, 2 floating
  # point), from pol before it.
  def xa_pol(rec: bytes, pol: integer): integer do xa_polq(xf(rec,1),xf(rec,10),xf(rec,13),pol) end
  def xa_polq(op: integer, sub: integer, last: integer, pol: integer): integer do
    if (op-10)*(op-11)*(op-12)*(op-13) == 0 do (if (sub-3)*(sub-5)*(sub-7) == 0 do 0 else 1 end) else
      if (op-20)*(op-21) == 0 do 1 else
        if op == 22 do (if sub == 3 do 0 else if sub == 0 do 1 else if (sub-4)*(sub-5) == 0 do 1 else pol end end end) else
          if op == 28 do (if sub < 2 do (if pol == 2 do 1 else pol end) else pol end) else
            if nc_and(nc_and((op-30)*(op-31)*(op-32)*(op-33)*(op-34),(op-66)*(op-67)*(op-68)),op-69) == 0 do (if op >= 68 do 0 else 1 end) else
              if (op-64)*(op-85) == 0 do 0 else if (op-83)*(op-84) == 0 do 1 else if op == 70 do (if (last-46)*(last-47) == 0 do 2 else pol end) else pol end end end
            end
          end
        end
      end
    end
  end
  def xa_flagsq(op: integer, sub: integer, last: integer): integer do
    # loopne, loope read Z; loop and jrcxz read nothing but go on to code
    # that may: all four are counted as reading every flag.
    if op == 86 do 2 else
    if (op-38)*(op-39)*(op-47) == 0 do (if xa_carry_cc(sub) == 1 do 3 else 2 end) else
      if (op-10)*(op-11)*(op-12)*(op-13) == 0 do (if (sub-2)*(sub-3) == 0 do 3 else 1 end) else
        if nc_and((op-45)*(op-46)*(op-48)*(op-49),(op-50)*(op-56)) == 0 do 4 else
          if op == 22 do (if sub == 2 do 0 else 1 end) else if op == 28 do (if sub < 2 do 1 else if (sub-2)*(sub-4) == 0 do 4 else 0 end end) else
            if xa_polq(op,sub,last,9) != 9 do 1 else 0 end
          end end
        end
      end
    end end
  end
  def xa_carry_cc(cc: integer): integer do if (cc-2)*(cc-3) == 0 do 1 else 0 end end
  # V and C set exactly when X21 is 1 (an overflow of mul or imul).
  def xa_overflow(): bytes do Enum.concat(a_lsl_n(22,21,63,8),a_add(31,22,22,1)) end
  def xa_w(size: integer): integer do if size == 8 do 8 else 4 end end
  # Group 3 (22: 0 test imm, 2 not, 3 neg, 4 mul, 5 imul, 6 div, 7 idiv),
  # group 4/5 (28: 0 inc, 1 dec, 2 call, 4 jmp, 6 push), shifts (30 by an
  # immediate, 31 by 1, 32 by CL), imul (33, 34), movzx (35), movsx (36),
  # movsxd (37), setcc (38), cmovcc (39).
  def xa_unary(rec: bytes, mp: bytes, here: integer, st: bytes): bytes do
    op = xf(rec,1)
    size = xf(rec,2)
    pre = xa_addr(rec,mp,here)
    if op == 22 do Enum.concat(pre,xa_group3(rec,st)) else if op == 28 do Enum.concat(pre,xa_group5(rec,st)) else
      if op < 33 do Enum.concat(pre,xa_shift(rec,st)) else if op < 35 do Enum.concat(pre,xa_imul(rec,st)) else
        if op < 38 do Enum.concat(pre,xa_extend(rec)) else
          c = xa_cc(xf(rec,10),Enum.at(st,0,0))
          if c < 0 do xa_udf(rec) else
            if op == 38 do nc_join(pre,xa_cset(c),xa_wr(rec,19,1)) else
              if size == 2 do xa_udf(rec) else nc_join(pre,xa_rd(rec,20,size,0),xa_cmov(c,xr(xf(rec,3)),xa_w(size))) end
            end
          end
        end
      end end
    end end
  end
  def xa_group3(rec: bytes, st: bytes): bytes do
    sub = xf(rec,10)
    size = xf(rec,2)
    need = Enum.at(st,1,0)
    w = xa_w(size)
    if sub == 0 do nc_join(xa_rd(rec,19,size,0),a_mov_imm(20,xf(rec,9)),xa_compute(8,size,need,0)) else
      if sub == 2 do nc_join(xa_rd(rec,19,size,0),a_alu(2854223872,19,31,19,w),xa_wr(rec,19,size)) else
        if sub == 3 do nc_join(Enum.concat(xa_rd(rec,20,size,0),a_mov_imm(19,0)),xa_compute(5,size,need,0),xa_wr(rec,19,size)) else
          if sub == 4 do Enum.concat(xa_rd(rec,20,size,0),xa_mul(size,need,0)) else
            if sub == 5 do Enum.concat(xa_rd(rec,20,size,1),xa_mul(size,need,1)) else Enum.concat(xa_rd(rec,20,size,if sub == 7 do 1 else 0 end),xa_div(size,sub)) end
