  # RDX:RAX = RAX * X20, unsigned or signed.
  def xa_mul(size: integer, need: integer, sign: integer): bytes do
    if size == 8 do
      high = if sign == 1 do a_smulh(21,0,20) else a_umulh(21,0,20) end
      flag = if need == 0 do b[] else if sign == 1 do nc_join(a_asr_n(22,0,63,8),a_cmp(21,22),Enum.concat(a_cset(21,1),xa_overflow())) else nc_join(a_cmp_value(2,0),a_cset(21,1),xa_overflow()) end end
      nc_join(high,a_mul(0,0,20),Enum.concat(a_mov(2,21),flag))
    else
      if size != 4 do a_udf() else
        product = if sign == 1 do a_smull(19,0,20) else Enum.concat(a_movw(19,0),a_mul(19,19,20)) end
        flag = if need == 0 do b[] else if sign == 1 do nc_join(a_sxt(22,19,4),a_cmp(19,22),Enum.concat(a_cset(21,1),xa_overflow())) else nc_join(a_lsr_n(22,19,32,8),a_cmp_value(22,0),Enum.concat(a_cset(21,1),xa_overflow())) end end
        nc_join(product,Enum.concat(a_movw(0,19),a_lsr_n(2,19,32,8)),flag)
      end
    end
  end
  # div (6) and idiv (7) of RDX:RAX by X20.
  def xa_div(size: integer, sub: integer): bytes do
    if size == 8 do (if sub == 7 do nc_join(a_sdiv(19,0,20),a_msub(2,19,20,0,8),a_mov(0,19)) else xa_udiv() end) else
      if size != 4 do a_udf() else
        dividend = nc_join(a_lsl_n(21,2,32,8),a_movw(22,0),a_orr(21,21,22))
        if sub == 7 do nc_join(dividend,a_sxt(20,20,4),nc_join(a_sdiv(19,21,20),a_msub(2,19,20,21,8),Enum.concat(a_movw(0,19),a_movw(2,2)))) else
          nc_join(dividend,a_udiv(19,21,20,8),nc_join(a_msub(2,19,20,21,8),a_movw(0,19),a_movw(2,2)))
        end
      end
    end
  end
  # Unsigned RDX:RAX / X20 with RDX below X20: one udiv when RDX is 0, else
  # by bits, the remainder reduced at once when it passes 64 bits.
  def xa_udiv(): bytes do
    quick = nc_join(a_udiv(19,0,20,8),a_msub(2,19,20,0,8),Enum.concat(a_mov(0,19),a_b(56)))
    step = nc_join(nc_join(a_lsr_n(22,0,63,8),a_add(2,2,2,1),a_cset(23,2)),nc_join(a_orr(2,2,22),a_lsl_n(0,0,1,8),a_cbnz(23,12,8)),Enum.concat(a_cmp(2,20),a_bcond(3,12)))
    take = Enum.concat(a_sub(2,2,20,0),a_orr_one(0))
    nc_join(Enum.concat(a_cbnz(2,20,8),quick),Enum.concat(a_mov_imm(21,64),step),nc_join(take,a_sub_imm(21,21,1,1),a_bcond(1,-44)))
