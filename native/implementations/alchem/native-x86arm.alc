      if v == 88 do Enum.concat(src,a_farith(2,reg,reg,fr)) else if v == 92 do Enum.concat(src,a_farith(3,reg,reg,fr)) else
        if v == 89 do Enum.concat(src,a_farith(0,reg,reg,fr)) else if v == 94 do Enum.concat(src,a_farith(1,reg,reg,fr)) else
          if v == 81 do Enum.concat(src,a_fsqrt(reg,fr)) else
