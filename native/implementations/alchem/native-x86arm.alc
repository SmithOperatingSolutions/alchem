  # bsf (68), bsr (69): the index of the lowest or highest set bit; ZF when
  # the source is 0, when the destination keeps its value.
  def xa_bscan(rec: bytes): bytes do
    size = xf(rec,2)
    w = xa_w(size)
    scan = if xf(rec,1) == 69 do Enum.concat(a_clz(19,20,w),Enum.concat(a_mov_imm(21,size*8-1),a_sub(19,21,19,0))) else Enum.concat(a_rbit(19,20,w),a_clz(19,19,w)) end
    store = xa_wrr(xf(rec,3),19,size)
    nc_join(Enum.concat(xa_rd(rec,20,size,0),scan),Enum.concat(a_cbz(20,4+Enum.count(store),w),store),a_cmp_value(20,0))
  end
  # SSE on doubles (word 13 the opcode, word 12 the prefixes): the XMM
  # registers are D0..D15.
  def xa_sse(rec: bytes, mp: bytes, here: integer): bytes do
    v = xf(rec,13)
    pre = xf(rec,12)
    reg = xf(rec,3)
    mem = if xf(rec,4) == 2 do 1 else 0 end
    rm = xf(rec,5)
    src = if mem == 1 do Enum.concat(xa_addr(rec,mp,here),a_ldr_d(31,xa_mb(rec),xa_md(rec))) else b[] end
    fr = if mem == 1 do 31 else rm end
    load = if v == 16 do 1 else if v == 126 do (if pre-256*a_div(pre,256) == 243 do 1 else 0 end) else 0 end end
    if load == 1 do (if pre == 0 do xa_udf(rec) else nc_join(src,a_fmov_dd(reg,fr),b[]) end) else
      if v == 17 do (if mem == 1 do Enum.concat(xa_addr(rec,mp,here),a_str_d(reg,xa_mb(rec),xa_md(rec))) else a_fmov_dd(rm,reg) end) else
        if v == 214 do (if mem == 1 do Enum.concat(xa_addr(rec,mp,here),a_str_d(reg,xa_mb(rec),xa_md(rec))) else a_fmov_dd(rm,reg) end) else
          if v == 110 do (if mem == 1 do Enum.concat(xa_addr(rec,mp,here),a_ldr_d(reg,xa_mb(rec),xa_md(rec))) else a_fmov_dx(reg,xr(rm)) end) else
            if v == 126 do (if mem == 1 do Enum.concat(xa_addr(rec,mp,here),a_str_d(reg,xa_mb(rec),xa_md(rec))) else a_fmov_xd(xr(rm),reg) end) else xa_sse2(rec,src,fr) end
          end
