      nc_join(a_lsl_n(20,20,32-8*size,4),a_lsl_n(19,19,32-8*size,4),a_alu(3942645760,31,20,19,4))
    end
  end
  def xa_repe_cmpsb(): bytes do
    nc_join(nc_join(a_cbz(1,28,8),a_ldr_post(19,4,1,1),a_ldr_post(20,5,1,1)),nc_join(a_sub_imm(1,1,1,0),a_alu(3942645760,31,19,20,4),a_bcond(1,8)),a_cbnz(1,-20,8))
  end
  # bt, bts, btr, btc (66 by a register, sub 0..3; 67 by an immediate, sub
  # 4..7): C = the bit, as an addition leaves it (xa_pol says 1).
  def xa_bt(rec: bytes): bytes do
    size = xf(rec,2)
    kind = if xf(rec,1) == 67 do xf(rec,10)-4 else xf(rec,10) end
    index = if xf(rec,1) == 67 do a_mov_imm(20,xf(rec,9)) else xa_rdr(xf(rec,3),20,8,0) end
    change = if kind == 1 do 2852126720 else if kind == 2 do 2317352960 else 3388997632 end end
    if xf(rec,4) == 1 do
      r = xr(xf(rec,5))
      mask = nc_join(index,a_bfm(3539992576,20,20,0,size*8-1-(if size == 8 do 58 else 27 end),8),Enum.concat(a_mov_imm(21,1),a_lsl(21,21,20)))
      nc_join(mask,Enum.concat(a_tst(r,21),a_cset(22,1)),Enum.concat(if kind == 0 do b[] else a_alu(change,r,r,21,8) end,a_cmp_value(22,1)))
    else
      word = if xf(rec,1) == 67 do Enum.concat(a_add_value(23,xa_mb(rec),xa_md(rec)+8*a_div(xf(rec,9),64),0),a_mov_imm(20,xf(rec,9)-64*a_div(xf(rec,9),64))) else
        nc_join(Enum.concat(a_add_value(23,xa_mb(rec),xa_md(rec),0),index),Enum.concat(a_asr_n(22,20,6,8),a_add_shift(23,23,22,3)),a_bfm(3539992576,20,20,0,5,8))
      end
      nc_join(Enum.concat(word,a_ldur(24,23,0,8,0)),Enum.concat(a_mov_imm(21,1),a_lsl(21,21,20)),nc_join(Enum.concat(a_tst(24,21),a_cset(22,1)),if kind == 0 do b[] else Enum.concat(a_alu(change,24,24,21,8),a_stur(24,23,0,8)) end,a_cmp_value(22,1)))
    end
