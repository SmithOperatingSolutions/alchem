  # ---- a function ----
  # The ARM64 code of a function's x86-64 code; empty when a translation
  # does not come out at the size it was measured at (a fault of this file).
  # Pass 1 (xa_scan) walks the instructions in order, noting for each its
  # translation's size and what it needs to know of the instructions before
  # it; pass 2 (xa_emit) translates them with every target known.
  def xa_function(code: bytes): bytes do xa_placed(code,a_block_end(65541)) end
  # last: where the program's table ends (a_block_end), which is what tells
  # an address of the entry's words and the table from a number.
  def xa_placed(code: bytes, last: integer): bytes do
    big = if Enum.count(code) >= 262144 do 1 else 0 end
    head = Enum.concat(b[0,0,big],nc_u32(last))
    first = xa_scan(code,0,Enum.count(code),Enum.count(code),head)
    # Targets where the carry is live, found as their jumps were met: once
    # more with all of them known (a loop's head is met before its jump).
    marks = xa_marks(xa_scan_state(first),7)
    scanned = if Enum.count(marks) == 0 do first else xa_scan(code,0,Enum.count(code),Enum.count(code),Enum.concat(head,marks)) end
    list = xa_scan_list(scanned)
    mp = nc_slice(xa_offsets(list,0,a_div(Enum.count(list),16),0),4,4+Enum.count(list))
    made = xa_emit(code,mp,0,a_div(Enum.count(mp),16),big,last)
    if Enum.count(made)-4*a_div(Enum.count(made),4) != 0 do b[] else made end
  end
  # A scan: u32 where it stopped, u16 the length of the state, the state
  # (pol, direction, big, then u32 start and u32 length of each data region
  # a marked operand named ahead), then 16 bytes an instruction: u32 x86-64
  # offset, u32 ARM64 size (an offset after xa_offsets), pol, need,
  # direction, kind (0 an instruction, 1 data, 2 one byte not decoded),
  # u32 length.
  def xa_scan_list(scan: bytes): bytes do nc_slice(scan,6+nc_read(scan,4),Enum.count(scan)) end
  def xa_scan_state(scan: bytes): bytes do nc_slice(scan,6,6+nc_read(scan,4)) end
  def xa_pack(p: integer, st: bytes, list: bytes): bytes do nc_join(nc_u32(p),nc_u16(Enum.count(st)),Enum.concat(st,list)) end
  def xa_scan(code: bytes, p: integer, limit: integer, stop: integer, st: bytes): bytes do
    if limit-p > 256 do
      left = xa_scan(code,p,p+nc_half(limit-p),stop,st)
      right = xa_scan(code,nc_long(left,0),limit,stop,xa_scan_state(left))
      xa_pack(nc_long(right,0),xa_scan_state(right),Enum.concat(xa_scan_list(left),xa_scan_list(right)))
    else xa_seq(code,p,limit,stop,st,b[]) end
  end
  def xa_entry(p: integer, size: integer, flags: bytes, span: integer): bytes do nc_join(nc_u32(p),nc_u32(size),Enum.concat(flags,nc_u32(span))) end
  def xa_seq(code: bytes, p: integer, limit: integer, stop: integer, st: bytes, acc: bytes): bytes do
    if p >= limit do xa_pack(p,st,acc) else if p >= stop do xa_pack(p,st,acc) else
      data = xa_pending_at(st,p,7)
      if data >= 0 do xa_seq(code,p+data,limit,stop,xa_unpend(st,p),Enum.concat(acc,xa_entry(p,data+xa_pad(data),b[0,0,0,1],data))) else
        rec = xd(code,p)
        n = xf(rec,0)
        if n == 0 do xa_seq(code,p+1,limit,stop,st,Enum.concat(acc,xa_entry(p,4,b[0,0,0,2],1))) else
          op = xf(rec,1)
          if op == 81 do xa_seq(code,p+n,limit,stop,st,Enum.concat(acc,xa_entry(p,xf(rec,9)+xa_pad(xf(rec,9)),b[0,0,0,3],n))) else
            step = xa_step(code,p,stop,st,rec)
            xa_seq(code,p+n,limit,stop,nc_slice(step,2,2+nc_read(step,0)),Enum.concat(acc,nc_slice(step,2+nc_read(step,0),Enum.count(step))))
          end
        end
      end
    end end
  end
  # One instruction of pass 1: u16 the length of the state after it, that
  # state, its entry. A label (a jump's target) where the carry is read
  # before it is set again is one where every path brings the carry in one
  # sense, a subtraction's: such targets are kept in the state as regions
  # of length 0xFFFFFFFF (xa_carried); a jump to one, or the instruction
  # before one, that leaves it as an addition's turns ARM's C over (kind 4
  # before the instruction, 8 after it), and the target starts with pol 0.
  def xa_step(code: bytes, p: integer, stop: integer, st: bytes, rec: bytes): bytes do
    n = xf(rec,0)
    op = xf(rec,1)
    pol = if Enum.at(st,0,0) == 1 do (if xa_carried(st,p) == 1 do 0 else 1 end) else Enum.at(st,0,0) end
    target = if (op-46)*(op-47)*(op-86) == 0 do p+n+xf(rec,9) else -1 end
    before = if target >= 0 do (if pol == 1 do xa_carried(st,target) else 0 end) else 0 end
    inpol = if before == 1 do 0 else pol end
    need = xa_need(code,p+n,stop,16)
    size = Enum.count(xa_insn(rec,b[],0,Enum.concat(b[inpol,need,Enum.at(st,1,0),Enum.at(st,2,0)],nc_slice(st,3,7))))
    found = if target >= 0 do (if xa_carried(st,target) == 0 do xa_live_carry(code,target,stop,16) else 0 end) else 0 end
    st2 = nc_join(b[xa_pol(rec,inpol),if op == 58 do 0 else if op == 59 do 1 else Enum.at(st,1,0) end end],nc_slice(st,2,Enum.count(st)),Enum.concat(if op == 80 do xa_region(code,p+n,xf(rec,9),nc_long(code,p+7)) else b[] end,if found == 1 do Enum.concat(nc_u32(target),nc_u32(4294967295)) else b[] end))
    after = if Enum.at(st2,0,0) == 1 do xa_carried(st2,p+n) else 0 end
    st3 = if after == 1 do Enum.concat(b[0],nc_slice(st2,1,Enum.count(st2))) else st2 end
    nc_join(nc_u16(Enum.count(st3)),st3,xa_entry(p,size+12*(before+after),b[inpol,need,Enum.at(st,1,0),4*before+8*after],n))
  end
  def xa_carried(st: bytes, p: integer): integer do xa_carried_at(st,p,7) end
  def xa_carried_at(st: bytes, p: integer, at: integer): integer do
    if at+8 > Enum.count(st) do 0 else if nc_long(st,at) == p do (if nc_long(st,at+4) == 4294967295 do 1 else xa_carried_at(st,p,at+8) end) else xa_carried_at(st,p,at+8) end end
  end
  # The carried targets of a state, as they stand in it.
  def xa_marks(st: bytes, at: integer): bytes do
    if at+8 > Enum.count(st) do b[] else Enum.concat(if nc_long(st,at+4) == 4294967295 do nc_slice(st,at,at+8) else b[] end,xa_marks(st,at+8)) end
  end
  # mrs x22, nzcv; eor x22, x22, #0x20000000; msr nzcv, x22: C turned over.
  def xa_flip(): bytes do nc_join(a4(3577430550),a4(3529704150),a4(3575333398)) end
  # 1 when the first instruction from p that reads the flags reads the
  # carry (adc, sbb, jb, ja and the like; past an inc or dec, which keep
  # it), else 0, also when budget steps touch no flag: the compiler's code
  # keeps no carry that long (jumps over data, one literal after another,
  # would otherwise make every such label one, and pass 1 quadratic).
  def xa_live_carry(code: bytes, p: integer, stop: integer, budget: integer): integer do
    if budget == 0 do 0 else if p >= stop do 0 else
      q = xq(code,p)
      if xq_len(q) == 0 do 1 else
        f = xa_flagsq(xq_op(q),xq_sub(q),xq_last(q))
        if f == 3 do 1 else
          if f == 2 do xa_reads_carry(q) else
            if f == 1 do (if xa_keepsq(q) == 1 do a_div(xa_need_carry(code,p+xq_len(q),stop,budget-1),2) else 0 end) else
              if f == 4 do (if xq_op(q) == 46 do xa_live_carry(code,xa_jumped(code,p),stop,budget-1) else 0 end) else xa_live_carry(code,p+xq_len(q),stop,budget-1) end
            end
          end
        end
      end
    end end
  end
  # 1 when a reader of the flags (setcc, cmovcc, jcc) reads the carry with
  # them: ja and jbe.
  def xa_reads_carry(q: integer): integer do
    op = xq_op(q)
    if op == 86 do 1 else if nc_and((op-38)*(op-39)*(op-47),(xq_sub(q)-6)*(xq_sub(q)-7)) == 0 do 1 else 0 end end
  end
  # The data region the RIP-relative operand of the instruction at p names,
  # starting back bytes before what it points at: u32 its start, u32 length.
  def xa_region(code: bytes, p: integer, span: integer, back: integer): bytes do
    rec = xd(code,p)
    Enum.concat(nc_u32(p+xf(rec,0)+xf(rec,8)-back),nc_u32(span))
  end
  # The length of the data region that starts at p, -1 for none; the state
  # without it. offset: where the regions start in st (7).
  def xa_pending_at(st: bytes, p: integer, at: integer): integer do
    if at+8 > Enum.count(st) do -1 else if nc_long(st,at) == p do (if nc_long(st,at+4) == 4294967295 do xa_pending_at(st,p,at+8) else nc_long(st,at+4) end) else xa_pending_at(st,p,at+8) end end
  end
  def xa_unpend(st: bytes, p: integer): bytes do Enum.concat(nc_slice(st,0,7),xa_unpend_at(st,p,7)) end
  def xa_unpend_at(st: bytes, p: integer, at: integer): bytes do
    if at+8 > Enum.count(st) do b[] else if nc_long(st,at) == p do xa_unpend_at(st,p,at+8) else Enum.concat(nc_slice(st,at,at+8),xa_unpend_at(st,p,at+8)) end end
  end
  # Whether the flags an instruction leaves are read before others are set:
  # 0 no, 1 yes, 2 the carry; 1 when it cannot be known in budget steps.
  # What follows is read by the lean decoding (xq).
  def xa_need(code: bytes, p: integer, stop: integer, budget: integer): integer do
    if budget == 0 do 1 else if p >= stop do 0 else
      q = xq(code,p)
      if xq_len(q) == 0 do 1 else
        f = xa_flagsq(xq_op(q),xq_sub(q),xq_last(q))
        if f == 2 do 1 else if f == 3 do 2 else if f == 1 do (if xa_keepsq(q) == 1 do xa_need_carry(code,p+xq_len(q),stop,budget-1) else 0 end) else if f == 4 do (if xq_op(q) == 46 do xa_need(code,xa_jumped(code,p),stop,budget-1) else 0 end) else xa_need(code,p+xq_len(q),stop,budget-1) end end end end
      end
    end end
  end
  # Past an inc or dec, which keep the carry, only a reader of the carry
  # (ja and jbe with it) reads what came before: 2 then, else 0.
  def xa_need_carry(code: bytes, p: integer, stop: integer, budget: integer): integer do
    if budget == 0 do 2 else if p >= stop do 0 else
      q = xq(code,p)
      if xq_len(q) == 0 do 2 else
        f = xa_flagsq(xq_op(q),xq_sub(q),xq_last(q))
        if f == 3 do 2 else
          if f == 2 do 2*xa_reads_carry(q) else
            if f == 1 do (if xa_keepsq(q) == 1 do xa_need_carry(code,p+xq_len(q),stop,budget-1) else 0 end) else
              if f == 4 do (if xq_op(q) == 46 do xa_need_carry(code,xa_jumped(code,p),stop,budget-1) else 0 end) else xa_need_carry(code,p+xq_len(q),stop,budget-1) end
            end
          end
        end
      end
    end end
  end
  # Where the jump (jmp rel8 or rel32) at p goes: the flags it carries are
  # read there.
  def xa_jumped(code: bytes, p: integer): integer do
    rec = xd(code,p)
    p+xf(rec,0)+xf(rec,9)
  end
  def xa_keepsq(q: integer): integer do if xq_op(q) == 28 do (if xq_sub(q) < 2 do 1 else 0 end) else 0 end end
  # The list with each size made the offset where the instruction starts:
  # u32 the total, then the list.
  def xa_offsets(list: bytes, first: integer, stop: integer, base: integer): bytes do
    if stop-first == 1 do Enum.concat(nc_u32(nc_long(list,first*16+4)),nc_join(nc_slice(list,first*16,first*16+4),nc_u32(base),nc_slice(list,first*16+8,first*16+16))) else
      if stop <= first do nc_u32(0) else
        middle = first+a_div(stop-first,2)
        left = xa_offsets(list,first,middle,base)
        right = xa_offsets(list,middle,stop,base+nc_long(left,0))
        Enum.concat(nc_u32(nc_long(left,0)+nc_long(right,0)),Enum.concat(nc_slice(left,4,Enum.count(left)),nc_slice(right,4,Enum.count(right))))
      end
    end
  end
  def xa_emit(code: bytes, mp: bytes, first: integer, stop: integer, big: integer, last: integer): bytes do
    if stop-first == 1 do xa_emit_one(code,mp,first*16,big,last) else
      if stop <= first do b[] else
        middle = first+a_div(stop-first,2)
        Enum.concat(xa_emit(code,mp,first,middle,big,last),xa_emit(code,mp,middle,stop,big,last))
      end
    end
  end
  def xa_emit_one(code: bytes, mp: bytes, at: integer, big: integer, last: integer): bytes do
    p = nc_long(mp,at)
    here = nc_long(mp,at+4)
    kind = Enum.at(mp,at+11,0)
    span = nc_long(mp,at+12)
    next = if at+16 < Enum.count(mp) do nc_long(mp,at+20) else -1 end
    made = if kind == 1 do Enum.concat(nc_slice(code,p,p+span),nc_zeros(xa_pad(span))) else if kind == 2 do a4(Enum.at(code,p,0)+256*Enum.at(code,p+1,0)) else if kind == 3 do Enum.concat(nc_slice(code,p+7,p+span),nc_zeros(xa_pad(span-7))) else
      xa_emit_insn(code,mp,at,here,kind,big,last)
    end end end
    # Each translation must come out at the size pass 1 measured; one that
    # does not leaves a byte that no instruction is, which xa_function sees.
    if next >= 0 do (if here+Enum.count(made) != next do b[1] else made end) else made end
  end
  # An instruction, C turned over before it (kind 4) and after it (8).
  def xa_emit_insn(code: bytes, mp: bytes, at: integer, here: integer, kind: integer, big: integer, last: integer): bytes do
    before = if kind-8*a_div(kind,8) == 4 do xa_flip() else b[] end
    made = xa_insn(xd(code,nc_long(mp,at)),mp,here+Enum.count(before),Enum.concat(b[Enum.at(mp,at+8,0),Enum.at(mp,at+9,0),Enum.at(mp,at+10,0),big],nc_u32(last)))
    nc_join(before,made,if kind >= 8 do xa_flip() else b[] end)
  end
  def xa_pad(span: integer): integer do 4*a_div(span+3,4)-span end
  # An instruction with a RIP-relative operand that names length bytes of
  # data in the code: in the ARM64 compiler it follows the marker 0F 0B 'D',
  # the length and how far before what the operand points at the data
  # starts, so that the translation copies those bytes (xa_region).
  def xa_mark(span: integer, instruction: bytes): bytes do xa_mark_back(span,0,instruction) end
  # The bytes a marker adds: what a jump over a marked instruction adds to
  # its distance.
  def xa_mark_size(): integer do if nc_a64() == 1 do 11 else 0 end end
  def xa_mark_back(span: integer, back: integer, instruction: bytes): bytes do
    if nc_arm() == 0 do instruction else nc_join(b[15,11,68],Enum.concat(nc_u32(span),nc_u32(back)),instruction) end
  end
  # ARM64 code among x86-64 code: in the ARM64 compiler, behind the marker
  # 0F 0B 'A' and its length, which the translation copies (kind 3).
  def xa_raw(arm: bytes): bytes do nc_join(b[15,11,65],nc_u32(Enum.count(arm)),arm) end
  # A runtime of its own table entry: its ARM64 version in the ARM64
  # compiler when there is one (native-runtimes-arm64.alc).
  def xa_runtime(x86: bytes, arm: bytes): bytes do
    if nc_arm() == 0 do x86 else if Enum.count(arm) == 0 do x86 else if Enum.count(x86) == 0 do x86 else xa_raw(arm) end end end
  end
  # The functions first..stop of a bundle (32-bit lengths, then the code
  # from offset), translated: u32 the length of the lengths, the lengths,
  # the code. A function that does not translate fails the program.
  def xa_bundle(lengths: bytes, code: bytes, first: integer, stop: integer, offset: integer, last: integer): bytes do
    if stop-first == 1 do
      made = xa_placed(nc_slice(code,offset,offset+nc_long(lengths,first*4)),last)
      if Enum.count(made) == 0 do (if nc_long(lengths,first*4) == 0 do Enum.concat(nc_u32(4),nc_u32(0)) else b[] end) else nc_join(nc_u32(4),nc_u32(Enum.count(made)),made) end
    else
      if stop <= first do nc_u32(0) else
        middle = first+a_div(stop-first,2)
        left = xa_bundle(lengths,code,first,middle,offset,last)
        right = xa_bundle(lengths,code,middle,stop,offset+nc_length_sum(lengths,first,middle),last)
        if Enum.count(left)*Enum.count(right) == 0 do b[] else
          nc_join(nc_u32(nc_long(left,0)+nc_long(right,0)),Enum.concat(nc_slice(left,4,4+nc_long(left,0)),nc_slice(right,4,4+nc_long(right,0))),Enum.concat(nc_slice(left,4+nc_long(left,0),Enum.count(left)),nc_slice(right,4+nc_long(right,0),Enum.count(right))))
        end
      end
    end
  end
  # Native smoke test; the x86-64 decoder.
  def main() do System.halt(0) end
end
