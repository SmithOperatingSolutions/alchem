defmodule NativeX86Arm do
  # The ARM64 compiler translates each function's x86-64 code to ARM64
  # (spec/arm64.md): the emitters, and the passes that read their code, stay
  # those of x86-64. This file decodes x86-64 (xd_) and emits ARM64 (xa_)
  # with the machine model of scripts/x86-to-arm64.py.

  # ---- words ----
  # 8 bytes, two's complement, of any integer.
  # Most words are small (a length, an op, a register, -1 for none): those
  # are made at once, the rest by divisions, which are recursions here.
  def xw(v: integer): bytes do
    if v >= 0 do (if v < 256 do b[v,0,0,0,0,0,0,0] else if v < 65536 do Enum.concat(nc_u16(v),b[0,0,0,0,0,0]) else xw_wide(v) end end) else
      if v == -1 do b[255,255,255,255,255,255,255,255] else xw_wide(v) end
    end
  end
  def xw_wide(v: integer): bytes do
    if v >= 0 do Enum.concat(nc_u32(v-a_div(v,4294967296)*4294967296),nc_u32(a_div(v,4294967296))) else
      # -(v+1): 0-v overflows for the least integer, where arithmetic is
      # checked (the compiler as a module of alchem).
      w = 0-(v+1)
      Enum.concat(nc_u32(4294967295-(w-a_div(w,4294967296)*4294967296)),nc_u32(4294967295-a_div(w,4294967296)))
    end
  end
  def xg(d: bytes, p: integer): integer do
    high = nc_long(d,p+4)
    if high >= 2147483648 do nc_long(d,p)+(high-4294967296)*4294967296 else nc_long(d,p)+high*4294967296 end
  end
  def xs8(v: integer): integer do if v >= 128 do v-256 else v end end
  def xs32(d: bytes, p: integer): integer do
    u = nc_long(d,p)
    if u >= 2147483648 do u-4294967296 else u end
  end
  def xbit(v: integer, bit: integer): integer do a_div(v,a_pow(bit))-2*a_div(v,a_pow(bit+1)) end

  # ---- decoding ----
  # A decoded instruction: twelve words.
  #  0 length, 1 op, 2 size (1, 2, 4, 8), 3 reg (ModRM.reg or the register
  #  of the opcode, x86-64 numbering), 4 mode (0 none, 1 register, 2
  #  memory), 5 the register or base (16 for RIP, -1 none), 6 index (-1
  #  none), 7 scale, 8 displacement, 9 immediate, 10 sub-operation,
  #  condition or source size, 11 REX (0 none, else 16 plus its bits: a byte
  #  register 4..7 without it is AH..BH), 12 prefixes (256 for 0x66, plus
  #  0xF2 or 0xF3), 13 the opcode's last byte.
  # Length 0: not an instruction the translator knows.
  def xf(rec: bytes, i: integer): integer do xg(rec,i*8) end
  # Word 14: the offset the instruction starts at.
  def xd(code: bytes, p: integer): bytes do Enum.concat(xd_pre(code,p,p,0,0),xw(p)) end
  # o16: 1 after 0x66; rep: 0, 0xF2 or 0xF3.
  def xd_pre(code: bytes, start: integer, q: integer, o16: integer, rep: integer): bytes do
    v = Enum.at(code,q,0)
    if v == 102 do xd_pre(code,start,q+1,1,rep) else
      if (v-242)*(v-243) == 0 do xd_pre(code,start,q+1,o16,v) else
        if v == 240 do xd_pre(code,start,q+1,o16,rep) else
          rex = if v >= 64 do if v <= 79 do v-64 else -1 end else -1 end
          if rex >= 0 do xd_op(code,start,q+1,o16*256+rep,rex+16) else xd_op(code,start,q,o16*256+rep,0) end
        end
      end
    end
  end
  # rex: 0 without a REX prefix, else 16 plus its four bits.
  def xd_op(code: bytes, start: integer, q: integer, pre: integer, rex: integer): bytes do
    v = Enum.at(code,q,0)
    if v == 15 do xd_two(code,start,q+2,pre,rex,Enum.at(code,q+1,0)) else xd_one(code,start,q+1,pre,rex,v) end
  end
  # The spec of an opcode: op, size code (0 the operand size, 1 a byte, 8
  # 64 bits), ModRM (1 yes), immediate (0 none, 1 imm8, 2 imm16, 4 immz,
  # 9 imm32 or imm64 with REX.W, 6 rel8, 7 rel32), sub, register in the
  # opcode (1 yes).
  # The spec of a one-byte opcode (xd_t1) or of 0F xx (xd_t2), 6 bytes
  # each: op (0 none), size code (0 the operand size, 1 a byte, 8 64 bits),
  # ModRM (1 yes), immediate (0 none, 1 imm8, 2 imm16, 4 immz, 9 imm32 or
  # imm64 with REX.W, 6 rel8, 7 rel32), sub (255: ModRM.reg), register in
  # the opcode (1 yes). Generated with the table of spec/arm64.md.
  def xd_t1(v: integer): bytes do
    # The 6 bytes of opcode v, from the part of 64 that holds it: a table
    # joined whole for each would be copied for each instruction decoded.
    at = (v-64*a_div(v,64))*6
    if v < 128 do (if v < 64 do nc_slice(b"",at,at+6) else nc_slice(b"",at,at+6) end) else
      if v < 192 do nc_slice(b"",at,at+6) else nc_slice(b"",at,at+6) end
    end
  end
  def xd_t2(v: integer): bytes do
    # The 6 bytes of opcode v, from the part of 64 that holds it: a table
    # joined whole for each would be copied for each instruction decoded.
    at = (v-64*a_div(v,64))*6
    if v < 128 do (if v < 64 do nc_slice(b"",at,at+6) else nc_slice(b"",at,at+6) end) else
      if v < 192 do nc_slice(b"",at,at+6) else nc_slice(b"",at,at+6) end
    end
  end
  def xd_one(code: bytes, start: integer, q: integer, pre: integer, rex: integer, v: integer): bytes do
    # 0x90 is nop, but with REX.B xchg rax, r8 (the form of 0x91 to 0x97).
    spec = if v == 144 do (if rex >= 16 do (if xbit(rex-16,0) == 1 do xd_t1(145) else xd_t1(144) end) else xd_t1(144) end) else xd_t1(v) end
    if Enum.at(spec,0,0) == 0 do xd_none() else xd_build(code,start,q,pre,rex,Enum.concat(spec,b[v])) end
  end
  # Two-byte opcodes 0x0F xx; 0F 0B 'D' is the marker of data (xa_mark).
  def xd_two(code: bytes, start: integer, q: integer, pre: integer, rex: integer, v: integer): bytes do
    spec = if v == 11 do (if Enum.at(code,q,0) == 68 do b[80,0,0,0,0,0] else if Enum.at(code,q,0) == 65 do b[81,0,0,0,0,0] else b[57,0,0,0,0,0] end end) else xd_t2(v) end
    if Enum.at(spec,0,0) == 0 do xd_none() else xd_build(code,start,q,pre,rex,Enum.concat(spec,b[v])) end
  end
  def xd_none(): bytes do Enum.concat(xw(0),nc_zeros(104)) end
  # spec: op, size code, ModRM, immediate, sub, register in opcode, opcode.
  def xd_build(code: bytes, start: integer, q: integer, pre: integer, rex: integer, spec: bytes): bytes do
    w = if rex == 0 do 0 else xbit(rex-16,3) end
    code_size = Enum.at(spec,1,0)
    o16 = a_div(pre,256)
    size = if code_size == 1 do 1 else if code_size == 8 do 8 else if w == 1 do 8 else if o16 == 1 do 2 else 4 end end end end
    m = if Enum.at(spec,2,0) == 1 do xd_modrm(code,q,rex) else nc_join(nc_join(xw(0),xw(0),xw(0)),nc_join(xw(-1),xw(-1),xw(1)),xw(0)) end
    after = q+xf(m,0)
    # test r/m, imm (F6 /0, F7 /0) is the one form of group 3 with an immediate.
    kind = if Enum.at(spec,0,0) == 22 do (if xf(m,1)-8*a_div(xf(m,1),8) == 0 do (if size == 1 do 1 else 4 end) else 0 end) else Enum.at(spec,3,0) end
    imm = xd_imm(code,after,kind,size,w)
    reg = if Enum.at(spec,5,0) == 1 do (Enum.at(spec,6,0)-8*a_div(Enum.at(spec,6,0),8))+8*(if rex == 0 do 0 else xbit(rex-16,0) end) else xf(m,1) end
    sub = if Enum.at(spec,4,0) == 255 do xf(m,1)-8*a_div(xf(m,1),8) else Enum.at(spec,4,0) end
    marker = if Enum.at(spec,0,0) == 80 do 1 else if Enum.at(spec,0,0) == 81 do 1 else 0 end end
    # A marker of ARM64 code covers that code too.
    raw = if Enum.at(spec,0,0) == 81 do nc_long(code,after+1) else 0 end
    data = if Enum.at(spec,0,0) == 80 do 4 else 0 end
    span = if marker == 1 do after+5+data+raw-start else after+xf(imm,0)-start end
    value = if marker == 1 do nc_long(code,after+1) else xf(imm,1) end
    nc_join(nc_join(xw(span),xw(Enum.at(spec,0,0)),xw(size)),nc_join(xw(reg),nc_slice(m,16,56),xw(value)),nc_join(Enum.concat(xw(sub),xw(rex)),xw(pre),xw(Enum.at(spec,6,0))))
  end
  # The immediate: {its length, its value}.
  def xd_imm(code: bytes, p: integer, kind: integer, size: integer, w: integer): bytes do
    if kind == 0 do Enum.concat(xw(0),xw(0)) else if kind == 1 do Enum.concat(xw(1),xw(xs8(Enum.at(code,p,0)))) else if kind == 6 do Enum.concat(xw(1),xw(xs8(Enum.at(code,p,0)))) else
      if kind == 2 do Enum.concat(xw(2),xw(nc_read(code,p))) else
        if kind == 4 do (if size == 2 do Enum.concat(xw(2),xw(nc_read(code,p)-(if nc_read(code,p) >= 32768 do 65536 else 0 end))) else Enum.concat(xw(4),xw(xs32(code,p))) end) else
          if kind == 7 do Enum.concat(xw(4),xw(xs32(code,p))) else
            if w == 1 do Enum.concat(xw(8),xw(xg(code,p))) else Enum.concat(xw(4),xw(nc_long(code,p))) end
          end
        end
      end
    end end end
  end
  # ModRM (and SIB and displacement) at q: {length, reg, mode, register or
  # base, index, scale, displacement} as words.
  def xd_modrm(code: bytes, q: integer, rex: integer): bytes do
    m = Enum.at(code,q,0)
    mod = a_div(m,64)
    r = if rex == 0 do 0 else xbit(rex-16,2) end
    x = if rex == 0 do 0 else xbit(rex-16,1) end
    bb = if rex == 0 do 0 else xbit(rex-16,0) end
    reg = a_div(m,8)-8*mod+8*r
    rm = m-8*a_div(m,8)
    if mod == 3 do nc_join(nc_join(xw(1),xw(reg),xw(1)),nc_join(xw(rm+8*bb),xw(-1),xw(1)),xw(0)) else
      if rm == 4 do xd_sib(code,q,reg,mod,x*2+bb) else
        if mod == 0 do (if rm == 5 do nc_join(nc_join(xw(5),xw(reg),xw(2)),nc_join(xw(16),xw(-1),xw(1)),xw(xs32(code,q+1))) else nc_join(nc_join(xw(1),xw(reg),xw(2)),nc_join(xw(rm+8*bb),xw(-1),xw(1)),xw(0)) end) else
          if mod == 1 do nc_join(nc_join(xw(2),xw(reg),xw(2)),nc_join(xw(rm+8*bb),xw(-1),xw(1)),xw(xs8(Enum.at(code,q+1,0)))) else
            nc_join(nc_join(xw(5),xw(reg),xw(2)),nc_join(xw(rm+8*bb),xw(-1),xw(1)),xw(xs32(code,q+1)))
          end
        end
      end
    end
  end
  def xd_sib(code: bytes, q: integer, reg: integer, mod: integer, xb: integer): bytes do
    s = Enum.at(code,q+1,0)
    scale = a_pow(a_div(s,64))
    index = a_div(s,8)-8*a_div(s,64)+8*a_div(xb,2)
    base = s-8*a_div(s,8)
    noindex = if index == 4 do -1 else index end
    if mod == 0 do (if base == 5 do nc_join(nc_join(xw(6),xw(reg),xw(2)),nc_join(xw(-1),xw(noindex),xw(scale)),xw(xs32(code,q+2))) else nc_join(nc_join(xw(2),xw(reg),xw(2)),nc_join(xw(base+8*(xb-2*a_div(xb,2))),xw(noindex),xw(scale)),xw(0)) end) else
      if mod == 1 do nc_join(nc_join(xw(3),xw(reg),xw(2)),nc_join(xw(base+8*(xb-2*a_div(xb,2))),xw(noindex),xw(scale)),xw(xs8(Enum.at(code,q+2,0)))) else
        nc_join(nc_join(xw(6),xw(reg),xw(2)),nc_join(xw(base+8*(xb-2*a_div(xb,2))),xw(noindex),xw(scale)),xw(xs32(code,q+2)))
      end
    end
  end
  # The lean decoding: of the instruction at p only its length, op, sub and
  # last opcode byte (xd's words 0, 1, 10, 13), as one integer
  # op + 256 sub + 65536 last + 16777216 length (0: not known), made with no
  # record; what reads ahead for the flags reads this.
  def xq(code: bytes, p: integer): integer do xq_pre(code,p,p,0) end
  def xq_len(q: integer): integer do a_div(q,16777216) end
  def xq_op(q: integer): integer do q-256*a_div(q,256) end
  def xq_sub(q: integer): integer do a_div(q,256)-256*a_div(q,65536) end
  def xq_last(q: integer): integer do a_div(q,65536)-256*a_div(q,16777216) end
  def xq_pre(code: bytes, start: integer, q: integer, o16: integer): integer do
    v = Enum.at(code,q,0)
    if v == 102 do xq_pre(code,start,q+1,1) else
      if (v-240)*(v-242)*(v-243) == 0 do xq_pre(code,start,q+1,o16) else
        if v >= 64 do (if v <= 79 do xq_one(code,start,q+1,o16*256+v-48) else xq_one(code,start,q,o16*256) end) else xq_one(code,start,q,o16*256) end
      end
    end
  end
  # mode: 256 after 0x66, plus the REX byte less 48 (16 plus its bits), or 0.
  def xq_one(code: bytes, start: integer, q: integer, mode: integer): integer do
    v = Enum.at(code,q,0)
    if v == 15 do
      w = Enum.at(code,q+1,0)
      spec = if w == 11 do (if Enum.at(code,q+2,0) == 68 do b[80,0,0,0,0,0] else if Enum.at(code,q+2,0) == 65 do b[81,0,0,0,0,0] else b[57,0,0,0,0,0] end end) else xd_t2(w) end
      xq_build(code,start,q+2,mode,spec,w)
    else xq_build(code,start,q+1,mode,xd_t1(if v == 144 do (if xbit(mode,4) == 1 do (if xbit(mode,0) == 1 do 145 else 144 end) else 144 end) else v end),v) end
  end
  def xq_build(code: bytes, start: integer, q: integer, mode: integer, spec: bytes, last: integer): integer do
    op = Enum.at(spec,0,0)
    if op == 0 do 0 else
      rex = mode-256*a_div(mode,256)
      w = if rex == 0 do 0 else xbit(rex-16,3) end
      size = if Enum.at(spec,1,0) == 1 do 1 else if Enum.at(spec,1,0) == 8 do 8 else if w == 1 do 8 else if mode >= 256 do 2 else 4 end end end end
      modrm = if Enum.at(spec,2,0) == 1 do Enum.at(code,q,0) else 0 end
      after = if Enum.at(spec,2,0) == 1 do q+xq_modrm(code,q) else q end
      reg = a_div(modrm,8)-8*a_div(modrm,64)
      kind = if op == 22 do (if reg == 0 do (if size == 1 do 1 else 4 end) else 0 end) else Enum.at(spec,3,0) end
      sub = if Enum.at(spec,4,0) == 255 do reg else Enum.at(spec,4,0) end
      span = if op == 80 do after+9-start else if op == 81 do after+5+nc_long(code,after+1)-start else after+xq_imm(kind,size,w)-start end end
      op+256*sub+65536*last+16777216*span
    end
  end
  # The length of ModRM, SIB and displacement at q.
  def xq_modrm(code: bytes, q: integer): integer do
    m = Enum.at(code,q,0)
    mod = a_div(m,64)
    rm = m-8*a_div(m,8)
    if mod == 3 do 1 else
      if rm == 4 do (if mod == 0 do (if Enum.at(code,q+1,0)-8*a_div(Enum.at(code,q+1,0),8) == 5 do 6 else 2 end) else if mod == 1 do 3 else 6 end end) else
        if mod == 0 do (if rm == 5 do 5 else 1 end) else if mod == 1 do 2 else 5 end end
      end
    end
  end
  def xq_imm(kind: integer, size: integer, w: integer): integer do
    if kind == 0 do 0 else if (kind-1)*(kind-6) == 0 do 1 else if kind == 2 do 2 else
      if kind == 4 do (if size == 2 do 2 else 4 end) else if kind == 7 do 4 else (if w == 1 do 8 else 4 end) end end
    end end end
  end
  # ---- operands ----
  # The ARM64 register of x86-64 register r.
  def xr(r: integer): integer do ar(r) end
  # 1 when a memory operand is a base register and a displacement ldur
  # reaches: no address is computed for it.
  def xa_simple(rec: bytes): integer do
    if xf(rec,6) >= 0 do 0 else if xf(rec,5) < 0 do 0 else if xf(rec,5) > 15 do 0 else a_near(xf(rec,8)) end end end
  end
  # The code that puts the address of a memory operand in X16 (none for a
  # simple one); a RIP-relative one is the instruction's target in the
  # translated function (xa_target), here being where this code starts.
  def xa_addr(rec: bytes, mp: bytes, here: integer): bytes do
    if xf(rec,4) != 2 do b[] else if xa_simple(rec) == 1 do b[] else
      base = xf(rec,5)
      if base == 16 do a_adr(16,xa_target(mp,xf(rec,14)+xf(rec,0)+xf(rec,8))-here) else
        scaled = if xf(rec,6) < 0 do (if base < 0 do b[] else a_mov(16,xr(base)) end) else
          if base < 0 do a_lsl_n(16,xr(xf(rec,6)),xa_log(xf(rec,7)),8) else a_add_shift(16,xr(base),xr(xf(rec,6)),xa_log(xf(rec,7))) end
        end
        disp = xf(rec,8)
        if base < 0 do (if xf(rec,6) < 0 do xa_image(rec,16,disp) else Enum.concat(scaled,xa_add_image(rec,disp)) end) else
          if disp == 0 do scaled else Enum.concat(scaled,xa_add16(disp)) end
        end
      end
    end end
  end
  # Whether a number in an instruction is an address of the entry's words or
  # the table, which a position-independent program reads from the copy:
  # one from 0x400420 to where this program's table ends (word 15, which
  # xa_insn adds to what was decoded).
  def xa_block(rec: bytes, address: integer): integer do
    if nc_pic() == 0 do 0 else if address < 4195360 do 0 else if address >= xf(rec,15) do 0 else 1 end end end
  end
  def xa_image(rec: bytes, rd: integer, address: integer): bytes do
    if xa_block(rec,address) == 1 do a_block_addr(rd,address) else a_mov_imm(rd,address) end
  end
  # X16 += disp, an address in the image (the copy, where the program is
  # position-independent) or any other number.
  def xa_add_image(rec: bytes, disp: integer): bytes do
    if xa_block(rec,disp) == 1 do Enum.concat(a_add_value(16,16,disp-4195360,0),a_add(16,16,26,0)) else a_add_value(16,16,disp,0) end
  end
  # X16 += disp (through X17 past twelve bits).
  def xa_add16(disp: integer): bytes do
    if disp > -4096 do (if disp < 4096 do a_add_value(16,16,disp,0) else Enum.concat(a_mov_imm(17,disp),a_add(16,16,17,0)) end) else Enum.concat(a_mov_imm(17,disp),a_add(16,16,17,0)) end
  end
  def xa_log(scale: integer): integer do if scale == 8 do 3 else if scale == 4 do 2 else if scale == 2 do 1 else 0 end end end end
  def xa_mb(rec: bytes): integer do if xa_simple(rec) == 1 do xr(xf(rec,5)) else 16 end end
  def xa_md(rec: bytes): integer do if xa_simple(rec) == 1 do xf(rec,8) else 0 end end
  # A register r of size bytes read into dst (zero- or sign-extended).
  def xa_rdr(r: integer, dst: integer, size: integer, sign: integer): bytes do
    if size == 8 do (if xr(r) == dst do b[] else a_mov(dst,xr(r)) end) else
      if sign == 1 do a_sxt(dst,xr(r),size) else a_uxt(dst,xr(r),size) end
    end
  end
  # dst written to register r as x86-64 writes size bytes of it: 8 and 4
  # set it (4 zeroes the upper half), 2 and 1 keep the rest.
  def xa_wrr(r: integer, src: integer, size: integer): bytes do
    if size == 8 do (if xr(r) == src do b[] else a_mov(xr(r),src) end) else
      if size == 4 do a_movw(xr(r),src) else a_bfxil(xr(r),src,size*8) end
    end
  end
  # The r/m operand read into dst, written from src.
  def xa_rd(rec: bytes, dst: integer, size: integer, sign: integer): bytes do
    if xf(rec,4) == 1 do xa_rdr(xf(rec,5),dst,size,sign) else a_ldur(dst,xa_mb(rec),xa_md(rec),size,sign) end
  end
  def xa_wr(rec: bytes, src: integer, size: integer): bytes do
    if xf(rec,4) == 1 do xa_wrr(xf(rec,5),src,size) else a_stur(src,xa_mb(rec),xa_md(rec),size) end
  end
  # 1 when a byte operand names AH, CH, DH or BH (no REX, register 4..7),
  # which the translation does not take.
  def xa_high(rec: bytes): integer do
    op = xf(rec,1)
    # The reg field names a register only in these forms; in the groups it
    # says which operation.
    named = if nc_and(nc_and((op-1)*(op-2)*(op-10)*(op-11),(op-20)*(op-54)),op-4) == 0 do 1 else 0 end
    if xf(rec,2) != 1 do 0 else if xf(rec,11) != 0 do 0 else
      if named*(if xf(rec,3) >= 4 do (if xf(rec,3) < 8 do 1 else 0 end) else 0 end) == 1 do 1 else xa_high_rm(rec) end
    end end
  end
  def xa_high_rm(rec: bytes): integer do if xf(rec,4) != 1 do 0 else if xf(rec,5) >= 4 do (if xf(rec,5) < 8 do 1 else 0 end) else 0 end end end

  # An instruction the translation does not take: udf with 0xFF00 plus its
  # op in the immediate, so that a program that reaches it says which (an
  # x86-64 byte it could not decode is udf with that byte and the next).
  def xa_udf(rec: bytes): bytes do a4(65280+xf(rec,1)) end

  # ---- conditions ----
  # x86-64 condition cc (0 o, 1 no, 2 b, 3 ae, 4 e, 5 ne, 6 be, 7 a, 8 s,
  # 9 ns, 10 p, 11 np, 12 l, 13 ge, 14 le, 15 g) after flags from pol (0 a
  # subtraction, 1 an addition or logic, 2 a floating-point comparison):
  # kind*256 + second*16 + first, kind 0 one ARM condition, 1 either of
  # two, 2 both; -1 none.
  def xa_cc(cc: integer, pol: integer): integer do
    at = (pol*16+cc)*2
    if Enum.at(xa_conds(),at,0) == 255 do -1 else nc_read(xa_conds(),at) end
  end
  def xa_conds(): bytes do b"BgAHAAMAAgAAAAEACQAIAAQABQD/////CwAKAA0ADAAGAAcAAgADAAAAAQACARMCBAAFAP////8LAAoADQAMAP////8LAAoAYAFxAg0ADAD/////BgAHAP//////////" end
  # dst = X20 when the condition holds (cmovcc), by csel alone: the flags
  # stay for what reads them after. Either of two: csel twice; both: csel
  # twice the other way round.
  def xa_cmov(c: integer, dst: integer, w: integer): bytes do
    kind = a_div(c,256)
    first = c-16*a_div(c,16)
    second = a_div(c,16)-16*kind
    if kind == 0 do a_csel_s(dst,20,dst,first,w) else
      if kind == 1 do Enum.concat(a_csel_s(24,20,dst,second,w),a_csel_s(dst,20,24,first,w)) else
        Enum.concat(a_csel_s(24,20,dst,second,w),a_csel_s(dst,24,dst,first,w))
      end
    end
  end
  # X19 = 1 when the condition holds, else 0.
  def xa_cset(c: integer): bytes do
    kind = a_div(c,256)
    first = c-16*a_div(c,16)
    second = a_div(c,16)-16*kind
    if kind == 0 do a_cset(19,first) else
      nc_join(a_cset(19,first),a_cset(21,second),if kind == 1 do a_orr(19,19,21) else a_and(19,19,21,0) end)
    end
  end

  # ---- instructions ----
  # The translation of rec (at x86-64 offset p of code) where it starts at
  # here in the translated function. st: the flags' origin before it (pol),
  # whether flags are read after it (need: 0 no, 1 yes, 2 its carry), the
  # direction (0 forward, 1 back) and 1 for a function past 256 KiB.
  def xa_insn(decoded: bytes, mp: bytes, here: integer, st: bytes): bytes do
    rec = Enum.concat(decoded,xw(nc_long(st,4)))
    op = xf(rec,1)
    if xa_high(rec) == 1 do xa_udf(rec) else
      if op < 10 do xa_move(rec,mp,here) else if op < 22 do xa_alu(rec,mp,here,st) else if op < 40 do xa_unary(rec,mp,here,st) else
        if op < 52 do xa_flow(rec,mp,here,st) else xa_other(rec,mp,here,st) end
      end end end
    end
  end
  # mov (1 r/m <- reg, 2 reg <- r/m, 3 r/m <- imm, 4 reg <- imm), lea (5).
  def xa_move(rec: bytes, mp: bytes, here: integer): bytes do
    op = xf(rec,1)
    size = xf(rec,2)
    pre = xa_addr(rec,mp,here)
    if op == 1 do (if xf(rec,4) == 1 do xa_wrr(xf(rec,5),xr(xf(rec,3)),size) else Enum.concat(pre,a_stur(xr(xf(rec,3)),xa_mb(rec),xa_md(rec),size)) end) else
      if op == 2 do (if xf(rec,4) == 1 do (if size == 8 do xa_wrr(xf(rec,3),xr(xf(rec,5)),8) else Enum.concat(xa_rdr(xf(rec,5),19,size,0),xa_wrr(xf(rec,3),19,size)) end) else nc_join(pre,a_ldur(19,xa_mb(rec),xa_md(rec),size,0),xa_wrr(xf(rec,3),19,size)) end) else
        if op == 3 do nc_join(pre,xa_imm_value(rec,xf(rec,9),size),xa_wr(rec,19,size)) else
          if op == 4 do Enum.concat(xa_imm_value(rec,if size == 4 do xa_u32(xf(rec,9)) else xf(rec,9) end,size),xa_wrr(xf(rec,3),19,if size == 4 do (if xa_block(rec,xa_u32(xf(rec,9))) == 1 do 8 else 4 end) else size end)) else
            if op == 5 do Enum.concat(xa_lea(rec,mp,here),xa_wrr(xf(rec,3),16,size)) else xa_udf(rec) end
          end
        end
      end
    end
  end
  def xa_u32(v: integer): integer do if v < 0 do v+4294967296 else v end end
  # X19 = a moved immediate. A 32-bit one among the addresses of the entry's
  # words and the table is such an address (a slot a call or a function
  # value names), which a position-independent program reads from the copy.
  def xa_imm_value(rec: bytes, v: integer, size: integer): bytes do
    if size == 4 do xa_image(rec,19,v) else a_mov_imm(19,v) end
  end
  # X16 = the address of the memory operand.
  def xa_lea(rec: bytes, mp: bytes, here: integer): bytes do
    if xa_simple(rec) == 1 do a_add_value(16,xr(xf(rec,5)),xf(rec,8),0) else xa_addr(rec,mp,here) end
  end
  # The ALU (10 r/m op= reg, 11 reg op= r/m, 12 r/m op= imm, 13 accumulator
  # op= imm; sub 0 add, 1 or, 2 adc, 3 sbb, 4 and, 5 sub, 6 xor, 7 cmp) and
  # test (20 r/m & reg, 21 accumulator & imm).
  def xa_alu(rec: bytes, mp: bytes, here: integer, st: bytes): bytes do
    op = xf(rec,1)
    size = xf(rec,2)
    pre = xa_addr(rec,mp,here)
    acc = if (op-13)*(op-21) == 0 do 1 else 0 end
    a = if op == 11 do xa_rdr(xf(rec,3),19,size,0) else if acc == 1 do xa_rdr(0,19,size,0) else xa_rd(rec,19,size,0) end end
    bv = if op == 10 do xa_rdr(xf(rec,3),20,size,0) else if op == 20 do xa_rdr(xf(rec,3),20,size,0) else if op == 11 do xa_rd(rec,20,size,0) else a_mov_imm(20,xf(rec,9)) end end end
    sub = if op >= 20 do 8 else xf(rec,10) end
    result = xa_compute(sub,size,Enum.at(st,1,0),Enum.at(st,0,0))
    back = if sub >= 7 do b[] else if op == 11 do xa_wrr(xf(rec,3),19,size) else if acc == 1 do xa_wrr(0,19,size) else xa_wr(rec,19,size) end end end
    nc_join(nc_join(pre,a,bv),result,back)
  end
  # X19 = X19 op X20 on size bytes, with x86-64's flags when need is not 0
  # (sub 8: test, which only sets flags). A byte or a word is worked on in
  # the top of a W register so that the flags are those of its size.
  def xa_compute(sub: integer, size: integer, need: integer, pol: integer): bytes do
    narrow = if size < 4 do (if need > 0 do 1 else 0 end) else 0 end
    w = if size == 8 do 8 else 4 end
    up = if narrow == 1 do Enum.concat(a_lsl_n(19,19,32-8*size,4),a_lsl_n(20,20,32-8*size,4)) else b[] end
    down = if narrow == 1 do (if sub >= 7 do b[] else a_lsr_n(19,19,32-8*size,4) end) else b[] end
    s = if need > 0 do 1 else 0 end
    body = if sub == 0 do a_alu(2332033024+s*536870912,19,19,20,w) else if sub == 5 do a_alu(3405774848+s*536870912,19,19,20,w) else
      if sub == 7 do a_alu(3942645760,31,19,20,w) else if sub == 4 do a_alu(2315255808+s*1610612736,19,19,20,w) else if sub == 8 do a_alu(3925868544,31,19,20,w) else
        if sub == 1 do Enum.concat(a_alu(2852126720,19,19,20,w),if s == 1 do a_alu(3925868544,31,19,19,w) else b[] end) else
          if sub == 6 do Enum.concat(a_alu(3388997632,19,19,20,w),if s == 1 do a_alu(3925868544,31,19,19,w) else b[] end) else
