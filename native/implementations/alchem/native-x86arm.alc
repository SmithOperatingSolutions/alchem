  # X19 = D(d) as an integer of w bytes, truncated (kind 0, cvttsd2si) or
  # to nearest even (1, cvtsd2si); NaN and values out of range give the
  # lowest integer, as x86-64 gives where ARM64 saturates.
  def xa_fconv(kind: integer, d: integer, w: integer): bytes do
    lowest = if w == 8 do -9223372036854775807-1 else 2147483648 end
    convert = if kind == 0 do a_fcvtzs(19,d,w) else a4(509607936+a_sf(w)+d*32+19) end
    m1 = a_mov_imm(20,if w == 8 do 9223372036854775807 else 2147483647 end)
    m2 = a_mov_imm(20,lowest)
    m3 = a_mov_imm(19,lowest)
    # NaN, then the two saturated values, go to m3 (the lowest integer).
    first = nc_join(Enum.concat(convert,a_fcmp(d,d)),a_bcond(6,Enum.count(m1)+Enum.count(m2)+20),Enum.concat(m1,a_alu(3942645760,31,19,20,w)))
    nc_join(first,Enum.concat(a_bcond(0,Enum.count(m2)+12),m2),nc_join(a_alu(3942645760,31,19,20,w),a_bcond(1,4+Enum.count(m3)),m3))
  end
  # andpd, orpd, xorpd, pxor on the low 64 bits (the scalar double): xor of
  # a register with itself is 0.
  def xa_flogic(v: integer, reg: integer, fr: integer, src: bytes): bytes do
    if fr == reg do (if (v-87)*(v-239) == 0 do a_fmov_dx(reg,31) else b[] end) else
      base = if v == 84 do 2315255808 else if v == 86 do 2852126720 else 3388997632 end end
      nc_join(Enum.concat(src,a_fmov_xd(16,reg)),Enum.concat(a_fmov_xd(17,fr),a_alu(base,16,16,17,8)),a_fmov_dx(reg,16))
