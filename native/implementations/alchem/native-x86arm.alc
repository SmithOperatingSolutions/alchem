  # rd |= 1.
  def a_orr_one(rd: integer): bytes do a4(2990538752+rd*32+rd) end
  # inc and dec keep x86-64's carry: ARM's C (mrs x22, nzcv) is put back
  # into the flags they set (mrs x23, nzcv; bfi x23, x22 >> 29, #29, #1; msr
  # nzcv, x23) and keeps its sense, so that a path that skips one reads it
  # the same. After a floating-point comparison it is taken as x86-64's CF
  # (cset x22, lt) and made an addition's.
  def xa_keep_carry(code: bytes, need: integer, pol: integer): bytes do
    if need == 0 do code else
      before = if pol == 2 do a_cset(22,11) else a4(3577430550) end
      after = if pol == 2 do b[] else a_lsr_n(22,22,29,8) end
      nc_join(Enum.concat(before,code),Enum.concat(after,a4(3577430551)),Enum.concat(a_bfm(3003121664,23,22,35,0,8),a4(3575333399)))
    end
  end
  def xa_group5(rec: bytes, st: bytes): bytes do
    sub = xf(rec,10)
    size = xf(rec,2)
    need = Enum.at(st,1,0)
    if sub < 2 do nc_join(Enum.concat(xa_rd(rec,19,size,0),a_mov_imm(20,1)),xa_keep_carry(xa_compute(if sub == 0 do 0 else 5 end,size,need,0),need,Enum.at(st,0,0)),xa_wr(rec,19,size)) else
      if sub == 2 do nc_join(xa_rd(rec,17,8,0),Enum.concat(a_adr(30,12),a_push(30)),a_br(17)) else
        if sub == 4 do Enum.concat(xa_rd(rec,17,8,0),a_br(17)) else if sub == 6 do Enum.concat(xa_rd(rec,19,8,0),a_push(19)) else xa_udf(rec) end end
      end
    end
  end
  # Shifts and rotates: sub 0 rol, 1 ror, 4 shl, 5 shr, 7 sar.
  def xa_shift(rec: bytes, st: bytes): bytes do
    sub = xf(rec,10)
    size = xf(rec,2)
    need = Enum.at(st,1,0)
    w = xa_w(size)
    bits = size*8
    load = xa_rd(rec,19,size,if sub == 7 do 1 else 0 end)
    if xf(rec,1) == 32 do nc_join(load,xa_shift_cl(sub,size,need),xa_wr(rec,19,size)) else
      n = (if xf(rec,1) == 31 do 1 else xf(rec,9) end)-(if size == 8 do 64 else 32 end)*a_div(if xf(rec,1) == 31 do 1 else xf(rec,9) end,if size == 8 do 64 else 32 end)
      if n == 0 do b[] else
        carry = if need == 2 do (if sub == 4 do a_bfm(3539992576,21,19,bits-n,bits-n,8) else a_bfm(3539992576,21,19,n-1,n-1,8) end) else b[] end
        work = if size < 4 do 8 else w end
        body = if sub == 4 do a_lsl_n(19,19,n,work) else if sub == 5 do a_lsr_n(19,19,n,work) else if sub == 7 do a_asr_n(19,19,n,work) else
          if size < 4 do xa_udf(rec) else if sub == 1 do a_ror_n(19,19,n,w) else a_ror_n(19,19,bits-n,w) end end
        end end end
        nc_join(nc_join(load,carry,body),xa_shift_flags(size,need),xa_wr(rec,19,size))
      end
    end
  end
  def xa_shift_cl(sub: integer, size: integer, need: integer): bytes do
    w = if size == 8 do 8 else if size == 4 do 4 else 8 end end
    kind = if sub == 4 do 0 else if sub == 5 do 1 else if sub == 7 do 2 else 3 end end end
    count = if sub == 0 do Enum.concat(a_sub(20,31,1,0),b[]) else b[] end
    body = if sub == 0 do a_shiftv(3,19,19,20,w) else a_shiftv(kind,19,19,1,w) end
    nc_join(count,body,xa_shift_flags(size,if need == 2 do 1 else need end))
  end
  # After a shift: the carry (X21, need 2) or Z and N of the result.
  def xa_shift_flags(size: integer, need: integer): bytes do
    if need == 2 do a_cmp_value(21,1) else if need == 0 do b[] else
      if size < 4 do Enum.concat(a_lsl_n(22,19,32-8*size,4),a_alu(3925868544,31,22,22,4)) else a_alu(3925868544,31,19,19,xa_w(size)) end
    end end
  end
  def xa_imul(rec: bytes, st: bytes): bytes do
    size = xf(rec,2)
    need = Enum.at(st,1,0)
    a = if xf(rec,1) == 33 do xa_rdr(xf(rec,3),19,size,1) else xa_rd(rec,19,size,1) end
    bv = if xf(rec,1) == 33 do xa_rd(rec,20,size,1) else a_mov_imm(20,xf(rec,9)) end
    if size == 8 do
      flag = if need == 0 do b[] else nc_join(a_smulh(21,19,20),Enum.concat(a_mul(19,19,20),a_asr_n(22,19,63,8)),nc_join(a_cmp(21,22),a_cset(21,1),xa_overflow())) end
      nc_join(Enum.concat(a,bv),if need == 0 do a_mul(19,19,20) else flag end,xa_wrr(xf(rec,3),19,8))
    else
      if size != 4 do xa_udf(rec) else
        flag = if need == 0 do b[] else nc_join(a_sxt(22,19,4),a_cmp(19,22),Enum.concat(a_cset(21,1),xa_overflow())) end
        nc_join(Enum.concat(a,bv),Enum.concat(a_smull(19,19,20),flag),xa_wrr(xf(rec,3),19,4))
