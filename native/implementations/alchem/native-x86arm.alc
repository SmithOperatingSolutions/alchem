  # movzx, movsx (source size in sub), movsxd.
  def xa_extend(rec: bytes): bytes do
    op = xf(rec,1)
    from_size = if op == 37 do 4 else xf(rec,10) end
    high = if from_size == 1 do (if xf(rec,11) == 0 do (if xf(rec,4) == 1 do (if xf(rec,5) >= 4 do (if xf(rec,5) < 8 do 1 else 0 end) else 0 end) else 0 end) else 0 end) else 0 end
    if high == 1 do xa_udf(rec) else Enum.concat(xa_rd(rec,19,from_size,if op == 35 do 0 else 1 end),xa_wrr(xf(rec,3),19,xf(rec,2))) end
  end

  # ---- control ----
  # The offset in the translated function of x86-64 offset target, by a
  # search of the map (16-byte entries, the x86-64 offset first): 0 with
  # no map (while sizes are measured).
  def xa_target(mp: bytes, target: integer): integer do
    if Enum.count(mp) == 0 do 0 else xa_find(mp,target,0,a_div(Enum.count(mp),16)) end
  end
  def xa_find(mp: bytes, target: integer, first: integer, stop: integer): integer do
    # Inside data (an operand may point into it) the distance from its start
    # carries over; an instruction is only ever named at its start.
    if stop-first <= 1 do nc_long(mp,first*16+4)+target-nc_long(mp,first*16) else
      middle = first+a_div(stop-first,2)
      if nc_long(mp,middle*16) <= target do xa_find(mp,target,middle,stop) else xa_find(mp,target,first,middle) end
    end
  end
  def xa_flow(rec: bytes, mp: bytes, here: integer, st: bytes): bytes do
    op = xf(rec,1)
    target = xa_target(mp,xf(rec,14)+xf(rec,0)+xf(rec,9))
    if op == 40 do a_push(xr(xf(rec,3))) else if op == 41 do a_pop(xr(xf(rec,3))) else if op == 42 do Enum.concat(a_mov_imm(19,xf(rec,9)),a_push(19)) else
      if op == 44 do nc_join(xa_addr(rec,mp,here),a_pop(19),xa_wr(rec,19,8)) else
        if op == 45 do nc_join(a_adr(30,12),a_push(30),a_b(target-here-8)) else
          if op == 46 do a_b(target-here) else if op == 47 do xa_jcc(rec,target-here,st) else
            if op == 50 do nc_join(a_pop(30),if xf(rec,9) == 0 do b[] else a_add_imm(28,28,xf(rec,9),0) end,a_br(30)) else
              if op == 51 do Enum.concat(a_mov(28,29),a_pop(29)) else xa_udf(rec) end
            end
          end end
        end
      end
    end end end
  end
  # A conditional jump distance bytes away: b.cond reaches 1 MiB, which a
  # function past 256 KiB of x86-64 code may pass, so there it skips a b.
  def xa_jcc(rec: bytes, distance: integer, st: bytes): bytes do
    c = xa_cc(xf(rec,10),Enum.at(st,0,0))
    big = Enum.at(st,3,0)
    kind = a_div(c,256)
    first = c-16*a_div(c,16)
    second = a_div(c,16)-16*kind
    if c < 0 do xa_udf(rec) else
      if kind == 0 do (if big == 0 do a_bcond(first,distance) else Enum.concat(a_bcond(a_invert(first),8),a_b(distance-4)) end) else
        if kind == 1 do (if big == 0 do Enum.concat(a_bcond(first,distance),a_bcond(second,distance-4)) else nc_join(Enum.concat(a_bcond(a_invert(first),8),a_b(distance-4)),a_bcond(a_invert(second),8),a_b(distance-12)) end) else
          if big == 0 do Enum.concat(a_bcond(a_invert(first),8),a_bcond(second,distance-4)) else nc_join(a_bcond(a_invert(first),12),a_bcond(a_invert(second),8),a_b(distance-8)) end
        end
      end
    end
  end

  # ---- the rest ----
  def xa_other(rec: bytes, mp: bytes, here: integer, st: bytes): bytes do
    op = xf(rec,1)
    size = xf(rec,2)
    if op == 52 do (if size == 8 do a_asr_n(2,0,63,8) else a_asr_n(2,0,31,4) end) else
      if op == 53 do (if size == 8 do a_sxt(0,0,4) else Enum.concat(a_sxt(19,0,2),a_movw(0,19)) end) else
        if op == 54 do nc_join(Enum.concat(xa_addr(rec,mp,here),xa_rd(rec,19,size,0)),xa_rdr(xf(rec,3),20,size,0),Enum.concat(xa_wr(rec,20,size),xa_wrr(xf(rec,3),19,size))) else
          if op == 86 do xa_loop(rec,mp,here) else
          if op == 85 do xa_scas(rec,st) else
          if op == 83 do a_add(31,31,31,1) else if op == 84 do a_sub(31,31,31,1) else
          if op == 82 do (if size == 8 do nc_join(a_mov(19,0),a_mov(0,xr(xf(rec,3))),a_mov(xr(xf(rec,3)),19)) else nc_join(a_movw(19,0),a_movw(0,xr(xf(rec,3))),a_movw(xr(xf(rec,3)),19)) end) else
          if (op-55)*(op-58)*(op-59)*(op-80) == 0 do b[] else
            if op == 56 do nc_join(Enum.concat(a_adr(30,12+Enum.count(a_image(16,4195360))),a_image(16,4195360)),Enum.concat(a_ldr(16,16,0),a_br(16)),b[]) else
              if op == 57 do (if xf(rec,10) == 1 do a4(3558866944) else xa_udf(rec) end) else
                if op < 66 do xa_string(rec,st) else
                  if op < 68 do Enum.concat(xa_addr(rec,mp,here),xa_bt(rec)) else if op < 70 do Enum.concat(xa_addr(rec,mp,here),xa_bscan(rec)) else xa_sse(rec,mp,here) end end
                end
              end end
              end end end end
            end
          end
        end
      end
    end
  end
  # movs (60), stos (62), cmps (64), with or without rep (prefix 0xF3),
  # forward or back (st byte 2, set by std).
  def xa_string(rec: bytes, st: bytes): bytes do
    op = xf(rec,1)
    size = xf(rec,2)
    rep = xf(rec,12)-256*a_div(xf(rec,12),256)
    d = if Enum.at(st,2,0) == 1 do 0-size else size end
    body = if op == 60 do Enum.concat(a_ldr_post(19,4,d,size),a_str_post(19,5,d,size)) else
      if op == 62 do a_str_post(0,5,d,size) else b[] end
    end
    if op == 64 do (if rep == 243 do xa_repe_cmpsb() else xa_udf(rec) end) else
      if rep == 0 do body else
        # RCX counted down without the flags, which rep movs and stos keep.
        n = Enum.count(body)
        nc_join(a_cbz(1,n+12,8),body,Enum.concat(a_sub_imm(1,1,1,0),a_cbnz(1,0-n-4,8)))
      end
    end
  end
  # loopne, loope, loop, jrcxz (86, sub 0..3), to a rel8 target: RCX
  # counted down without the flags, then a jump while it is not zero (and
  # Z is clear, set), or jrcxz's when it is zero.
  def xa_loop(rec: bytes, mp: bytes, here: integer): bytes do
    sub = xf(rec,10)
    target = xa_target(mp,xf(rec,14)+xf(rec,0)+xf(rec,9))
    if sub == 3 do a_cbz(1,target-here,8) else
      if sub == 2 do Enum.concat(a_sub_imm(1,1,1,0),a_cbnz(1,target-here-4,8)) else
        nc_join(a_sub_imm(1,1,1,0),a_cbz(1,8,8),a_bcond(if sub == 1 do 0 else 1 end,target-here-8))
      end
    end
  end
  # scas (85): the accumulator compared with [RDI], RDI stepped; with repne
  # (0xF2) until they are equal, with repe (0xF3) until they differ, RCX
  # counting down to 0. The flags are those of the last comparison.
  def xa_scas(rec: bytes, st: bytes): bytes do
    size = xf(rec,2)
    w = xa_w(size)
    rep = xf(rec,12)-256*a_div(xf(rec,12),256)
    d = if Enum.at(st,2,0) == 1 do 0-size else size end
    one = nc_join(a_ldr_post(19,5,d,size),xa_rdr(0,20,size,0),xa_narrow_cmp(size))
    if rep == 0 do one else
      stop = if rep == 242 do 0 else 1 end
      body = nc_join(one,a_sub_imm(1,1,1,0),b[])
      n = Enum.count(body)
      # cbz x1 (done) | body | b.stop done | cbnz x1 top | done
      nc_join(a_cbz(1,n+12,8),body,Enum.concat(a_bcond(stop,8),a_cbnz(1,0-n-4,8)))
    end
