defmodule NativeGenerics do
  # A lowercase type name is a type variable: tag 16, its length, its name. A
  # function is generic in the variables of its signature and each call picks
  # their types. Values are one word whatever their type, so one body serves
  # every choice.
  #
  # A substitution lists variables with their types: for each, the name's
  # length, the name, then the type after its length byte.
  def nu_variable(source: bytes, pos: integer): bytes do
    stop = nc_end(source,pos)
    Enum.concat(b[16,stop-pos],nc_slice(source,pos,stop))
  end
  # How many types a type holds directly: an element, two for results and maps,
  # fields, parameters and a result, or type arguments.
  def nu_parts(kind: bytes): integer do
    tag = nt_tag(kind)
    if (tag-4)*(tag-7)*(tag-25)*(tag-26) == 0 do 1 else if (tag-6)*(tag-8) == 0 do 2 else
      if tag == 10 do nt_count(kind)+1 else nt_count(kind) end
    end end
  end
  # 1 when the byte value occurs in kind between first and stop: a quick test
  # before a walk, since most types mention no variable.
  def nu_has(kind: bytes, value: integer, first: integer, stop: integer): integer do
    middle = first+nc_half(stop-first)
    if stop-first <= 0 do 0 else if stop-first == 1 do if Enum.at(kind,first,0) == value do 1 else 0 end else
      if nu_has(kind,value,first,middle) == 1 do 1 else nu_has(kind,value,middle,stop) end
    end end
  end
  # 1 when the type mentions a type variable. The walks go part by part, so
  # their depth follows the type's nesting, not its length.
  def nu_open(kind: bytes, offset: integer): integer do
    if nu_has(kind,16,0,Enum.count(kind)) == 0 do 0 else nu_open_in(kind,0) end
  end
  def nu_open_in(kind: bytes, index: integer): integer do
    if nt_tag(kind) == 16 do 1 else
      if index >= nu_parts(kind) do 0 else
        if nu_open(nt_child(kind,index),0) == 1 do 1 else nu_open_in(kind,index+1) end
      end
    end
  end
  # The offset in subst of the entry for the variable whose name is name, -1 if
  # it has none.
  def nu_bound(subst: bytes, name: bytes, offset: integer): integer do
    size = Enum.at(subst,offset,0)
    after = offset+1+size
    if offset >= Enum.count(subst) do -1 else
      if nt_same(nc_slice(subst,offset+1,after),name) == 1 do offset else nu_bound(subst,name,nt_after(subst,after)) end
    end
  end
  def nu_value(subst: bytes, offset: integer): bytes do
    nt_read(subst,offset+1+Enum.at(subst,offset,0))
  end
  def nu_bind(subst: bytes, name: bytes, kind: bytes): bytes do
    nc_join(subst,Enum.concat(b[Enum.count(name)],name),nt_cell(kind))
  end
  # subst with the entry at offset holding kind.
  def nu_rebind(subst: bytes, offset: integer, kind: bytes): bytes do
    start = offset+1+Enum.at(subst,offset,0)
    nc_join(nc_slice(subst,0,start),nt_cell(kind),nc_slice(subst,nt_after(subst,start),Enum.count(subst)))
  end
  # Match the declared type wanted, which may mention variables, against the
  # type given: the substitution with the variables it settles, behind a 1; b[]
  # when they cannot agree.
  def nu_unify(wanted: bytes, given: bytes, subst: bytes): bytes do
    tag = nt_tag(wanted)
    if tag < 0 do b[] else if nt_tag(given) < 0 do b[] else
      if tag == 16 do nu_settle(nc_slice(wanted,2,Enum.count(wanted)),given,subst) else
        if nt_tag(given) == 9 do Enum.concat(b[1],subst) else
          if tag != nt_tag(given) do b[] else
            if (tag-4)*(tag-7)*(tag-25)*(tag-26) == 0 do nu_unify(nt_child(wanted,0),nt_child(given,0),subst) else
              if (tag-6)*(tag-8) == 0 do nu_both(wanted,given,subst) else
                if (tag-5)*(tag-10) == 0 do nu_items(wanted,given,subst,0) else
                  if (tag-18)*(tag-19) == 0 do if nt_same(nc_slice(wanted,0,nt_first(wanted)),nc_slice(given,0,nt_first(given))) == 0 do b[] else nu_instance(wanted,given,subst,0) end else
                    if nt_same(wanted,given) == 1 do Enum.concat(b[1],subst) else b[] end
                  end
                end
              end
            end
          end
        end
      end
    end end
  end
  def nu_settle(name: bytes, given: bytes, subst: bytes): bytes do
    offset = nu_bound(subst,name,0)
    merged = if offset < 0 do given else nt_merge(nu_value(subst,offset),given) end
    if Enum.count(merged) == 0 do b[] else
      Enum.concat(b[1],if offset < 0 do nu_bind(subst,name,given) else nu_rebind(subst,offset,merged) end)
    end
  end
  def nu_both(wanted: bytes, given: bytes, subst: bytes): bytes do
    first = nu_unify(nt_child(wanted,0),nt_child(given,0),subst)
    if Enum.count(first) == 0 do b[] else nu_unify(nt_child(wanted,1),nt_child(given,1),nc_slice(first,1,Enum.count(first))) end
  end
  def nu_instance(wanted: bytes, given: bytes, subst: bytes, index: integer): bytes do
    if index == nt_count(wanted) do Enum.concat(b[1],subst) else
      next = nu_unify(nt_child(wanted,index),nt_child(given,index),subst)
      if Enum.count(next) == 0 do b[] else nu_instance(wanted,given,nc_slice(next,1,Enum.count(next)),index+1) end
    end
  end
  def nu_items(wanted: bytes, given: bytes, subst: bytes, index: integer): bytes do
    total = if nt_tag(wanted) == 10 do nt_count(wanted)+1 else nt_count(wanted) end
    if nt_count(wanted) != nt_count(given) do b[] else
      if index == total do Enum.concat(b[1],subst) else
        next = nu_unify(nt_child(wanted,index),nt_child(given,index),subst)
        if Enum.count(next) == 0 do b[] else nu_items(wanted,given,nc_slice(next,1,Enum.count(next)),index+1) end
      end
    end
  end
  # The type with its variables replaced by what subst gives them. A variable
  # it does not settle becomes unknown, to be settled where the value is used.
  def nu_apply(kind: bytes, subst: bytes): bytes do
    tag = nt_tag(kind)
    offset = if tag == 16 do nu_bound(subst,nc_slice(kind,2,Enum.count(kind)),0) else -1 end
    if tag == 16 do if offset < 0 do b[9] else nu_value(subst,offset) end else
      if nu_open(kind,0) == 0 do kind else
        if (tag-4)*(tag-7)*(tag-25)*(tag-26) == 0 do nt_unary(tag,nu_apply(nt_child(kind,0),subst)) else
          if (tag-6)*(tag-8) == 0 do nt_binary(tag,nu_apply(nt_child(kind,0),subst),nu_apply(nt_child(kind,1),subst)) else
            if (tag-5)*(tag-10) == 0 do nu_apply_items(kind,subst,0,b[]) else
              if (tag-18)*(tag-19) == 0 do nu_apply_arguments(kind,subst,0,nc_slice(kind,0,nt_first(kind))) else kind end
            end
          end
        end
      end
    end
  end
  def nu_apply_arguments(kind: bytes, subst: bytes, index: integer, result: bytes): bytes do
    if index == nt_count(kind) do nt_sized(result) else
      nu_apply_arguments(kind,subst,index+1,Enum.concat(result,nu_apply(nt_child(kind,index),subst)))
    end
  end
  def nu_apply_items(kind: bytes, subst: bytes, index: integer, types: bytes): bytes do
    count = nt_count(kind)
    total = if nt_tag(kind) == 10 do count+1 else count end
    if index == total do if nt_tag(kind) == 10 do nt_function(types,count) else nt_tuple(types,count) end else
      nu_apply_items(kind,subst,index+1,Enum.concat(types,nt_cell(nu_apply(nt_child(kind,index),subst))))
    end
  end
  # The cells of a type list with subst applied.
  def nu_apply_cells(cells: bytes, subst: bytes, offset: integer): bytes do
    kind = nt_read(cells,offset)
    if offset >= Enum.count(cells) do b[] else
      Enum.concat(nt_cell(nu_apply(kind,subst)),nu_apply_cells(cells,subst,nt_after(cells,offset)))
    end
  end
  # Unify the parameter types in cells with the arguments from index on,
  # skipping arguments that are still deferred lambdas: the substitution behind
  # a 1, or b[].
  def nu_arguments(cells: bytes, args: bytes, subst: bytes, index: integer): bytes do
    given = nc_arg_kind(args,index)
    if index == nc_arg_count(args) do Enum.concat(b[1],subst) else
      if nt_tag(given) == 11 do nu_arguments(cells,args,subst,index+1) else
        next = nu_unify(nt_item(cells,index),given,subst)
        if Enum.count(next) == 0 do b[] else nu_arguments(cells,args,nc_slice(next,1,Enum.count(next)),index+1) end
      end
    end
  end
  def nu_open_cells(cells: bytes, offset: integer): integer do
    kind = nt_read(cells,offset)
    if offset >= Enum.count(cells) do 0 else
      if nu_open(kind,0) == 1 do 1 else nu_open_cells(cells,nt_after(cells,offset)) end
    end
  end
  # 1 when the type has a part that is still unknown.
  def nu_holes(kind: bytes, offset: integer): integer do
    if nu_has(kind,9,0,Enum.count(kind)) == 0 do 0 else nu_holes_in(kind,0) end
  end
  def nu_holes_in(kind: bytes, index: integer): integer do
    if nt_tag(kind) == 9 do 1 else
      if index >= nu_parts(kind) do 0 else
        if nu_holes(nt_child(kind,index),0) == 1 do 1 else nu_holes_in(kind,index+1) end
      end
    end
  end
  # 1 when one of a function type's parameters is still unknown.
  def nu_open_parameter(kind: bytes, index: integer): integer do
    if index >= nt_count(kind) do 0 else if nu_holes(nt_child(kind,index),0) == 1 do 1 else nu_open_parameter(kind,index+1) end end
  end
  # 1 when a deferred lambda among the arguments would get a parameter whose
  # type the other arguments did not settle.
  def nu_unsettled(cells: bytes, args: bytes, index: integer): integer do
    wanted = nt_item(cells,index)
    if index == nc_arg_count(args) do 0 else
      if nt_tag(nc_arg_kind(args,index)) != 11 do nu_unsettled(cells,args,index+1) else
        if nu_open_parameter(wanted,0) == 1 do 1 else nu_unsettled(cells,args,index+1) end
      end
    end
  end
  # 1 when a lambda or capture among the arguments stands where the
  # parameter is declared as a bare type variable: whatever the variable
  # is given, no function is expected there.
  def nu_unshaped(source: bytes, cells: bytes, args: bytes, index: integer): integer do
    given = nc_arg_kind(args,index)
    if index == nc_arg_count(args) do 0 else
      if nt_tag(given) != 11 do nu_unshaped(source,cells,args,index+1) else
        if nf_general(source,nu_bare(source,nc_cursor(given,1),64)) == 1 do nu_unshaped(source,cells,args,index+1) else
          if nt_tag(nt_item(cells,index)) != 10 do 1 else nu_unshaped(source,cells,args,index+1) end
        end
      end
    end
  end
  # The position past the parentheses that open at pos: (fn x -> x end) is
  # the lambda.
  def nu_bare(source: bytes, pos: integer, budget: integer): integer do
    start = nc_start(source,pos)
    if budget == 0 do start else if byte_at(source,start) != 40 do start else nu_bare(source,start+1,budget-1) end end
  end
  # A call of the generic function target with the arguments parsed: its
  # deferred lambdas take the types the other arguments settle, then every
  # argument is matched and the result type follows from the substitution.
  # plan: the function's table index (2 bytes), then what the call's own
  # expected type settles of its variables, as a substitution.
  def nu_call(source: bytes, env: bytes, table: bytes, depth: integer, parsed: bytes, plan: bytes): bytes do
    # A lambda's result may settle the parameter types of a later one.
    if nf_has_pending(parsed,0) == 0 do nu_call_typed(source,env,table,depth,parsed,plan) else
      nu_call_typed(source,env,table,depth,sg_ordered(source,env,table,Enum.concat(b[depth,sg_strict_target(source,table,nc_read(plan,0))],nj_cells(source,table,nc_read(plan,0))),parsed,Enum.concat(b[0,0,0],nc_slice(plan,2,Enum.count(plan)))),plan)
    end
  end
  def nu_call_typed(source: bytes, env: bytes, table: bytes, depth: integer, parsed: bytes, plan: bytes): bytes do
    target = nc_read(plan,0)
    seed = nc_slice(plan,2,Enum.count(plan))
    count = nc_arg_count(parsed)
    cells = nj_cells(source,table,target)
    first = if count != nc_argc(table,target) do b[] else nu_arguments(cells,parsed,seed,0) end
    early = nu_apply_cells(cells,nc_slice(first,1,Enum.count(first)),0)
    typed = if Enum.count(first) == 0 do b[] else
      if nf_has_pending(parsed,0) == 0 do parsed else if nu_unsettled(early,parsed,0)+nu_unshaped(source,cells,parsed,0) > 0 do b[] else nf_typed_all(source,env,table,depth,parsed,Enum.concat(nc_u24(count-1),early)) end end
    end
    full = if nc_pos(typed) < 0 do b[] else nu_arguments(cells,typed,seed,0) end
    results = nu_names(nc_return_kind(source,table,target),0,b[])
    order = nw_order_from(source,env,table,cells,parsed,nc_join(b[0,0,0,0],nc_u16(Enum.count(results)+sg_strict_target(source,table,target)*32768),Enum.concat(results,seed)))
    # prepend, concat, map, filter and reduce without a module type an
    # empty list from the argument after it (the pinned compiler types the
    # function, or the second list, first).
    if Enum.count(full) == 0 do b[] else ac_settled(source,table,target,nu_call_finish(source,env,table,typed,nc_slice(full,1,Enum.count(full)),target),if nu_legacy(source,table,target) == 1 do 0 else order end) end
  end
  # The call itself: arguments, then the comparator of each type variable.
  def nu_call_finish(source: bytes, env: bytes, table: bytes, typed: bytes, subst: bytes, target: integer): bytes do
    count = nc_arg_count(typed)
    names = nu_signature(source,table,target)
    extra = nu_name_count(names,0)
    # A library function's ordered variables take types that have an order.
    ordered = od_library(source,table,target)*(1+od_library(source,table,nc_read(env,0)))
    barred = qn_barred(env,2,b[])
    given = nu_comparators(source,table,names,Enum.concat(b[ordered],subst),nu_vars(env,2),qn_name(barred))
    missing = if extra == 0 do 0 else if Enum.count(given) == 0 do 1 else nu_refused(names,subst,nu_equal(source,table,target),b[0,0,0,0,0,0,0],qn_name(barred))+qn_refused(source,table,Enum.concat(nc_u16(target),barred),subst,0)+jd_refused(source,table,target,subst) end end
    # The library's own helpers (o_ and a name) are not the program's to call.
    hidden = if od_library(source,table,target) == 0 do 0 else if od_library(source,table,nc_read(env,0)) == 1 do 0 else nc_word_at(source,nc_meta(table,target,0),b[111,95],0) end end
    pushed = Enum.concat(nc_arg_code(typed),given)
    # Comparators past the sixth value stay on the stack for the callee.
    if missing+hidden > 0 do b[] else if count < 0 do b[] else
      code = Enum.concat(pushed,tl_passed(source,env,table,nc_pos(typed),count+extra,target))
      nc_value(nc_pos(typed),code,nu_apply(nc_return_kind(source,table,target),subst))
    end end
  end
  # The type variables a list of types mentions, in order of first appearance:
  # each as its name's length and its name.
  def nu_names(kind: bytes, offset: integer, names: bytes): bytes do
    name = nc_slice(kind,2,Enum.count(kind))
    if nu_has(kind,16,0,Enum.count(kind)) == 0 do names else
      if nt_tag(kind) == 16 do if nu_named(names,name,0) == 1 do names else nc_join(names,b[Enum.count(name)],name) end else nu_names_in(kind,0,names) end
    end
  end
  def nu_names_in(kind: bytes, index: integer, names: bytes): bytes do
    if index >= nu_parts(kind) do names else nu_names_in(kind,index+1,nu_names(nt_child(kind,index),0,names)) end
  end
  def nu_named(names: bytes, name: bytes, offset: integer): integer do
    size = Enum.at(names,offset,0)
    if offset >= Enum.count(names) do 0 else
      if nt_same(nc_slice(names,offset+1,offset+1+size),name) == 1 do 1 else nu_named(names,name,offset+1+size) end
    end
  end
  def nu_cell_names(cells: bytes, offset: integer, names: bytes): bytes do
    kind = nt_read(cells,offset)
    if offset >= Enum.count(cells) do names else nu_cell_names(cells,nt_after(cells,offset),nu_names(kind,0,names)) end
  end
  # The type variables of function target's signature.
  def nu_signature(source: bytes, table: bytes, target: integer): bytes do
    cells = nj_cells(source,table,target)
    jd_names(table,target,nu_names(nc_return_kind(source,table,target),0,nu_cell_names(cells,0,b[])))
  end
  def nu_name_count(names: bytes, offset: integer): integer do
    if offset >= Enum.count(names) do 0 else 1+nu_name_count(names,offset+1+Enum.at(names,offset,0)) end
  end
  # A generic function takes one comparator per type variable after its
  # parameters; each has a slot under a record with no name whose type is tag
  # 17 and the variable's name.
  def nu_hidden(env: bytes, names: bytes, offset: integer): bytes do
    size = Enum.at(names,offset,0)
    if offset >= Enum.count(names) do env else
      nu_hidden(Enum.concat(env,nc_env_record(0,0,Enum.concat(b[17],nc_slice(names,offset,offset+1+size)))),names,offset+1+size)
    end
  end
  # env with the records extra after it: b[] stays b[].
  def nu_barring(env: bytes, extra: bytes): bytes do
    if Enum.count(env) == 0 do b[] else Enum.concat(env,extra) end
  end
  # The type variables whose comparators the environment holds, as vars for
  # the equality code: name length, name, slot.
  def nu_vars(env: bytes, offset: integer): bytes do
    nu_vars_from(env,offset,0,qn_name(qn_barred(env,2,b[])))
  end
  def nu_vars_from(env: bytes, offset: integer, slot: integer, barred: bytes): bytes do
    kind = if nc_env_tag(env,offset) == 17 do nt_read(env,offset+7) else b[] end
    if offset >= Enum.count(env) do b[] else
      # The variable a function is compiled without the equality of (qn_needs) has no comparator in reach.
      if Enum.count(kind) == 0 do nu_vars_from(env,nc_env_next(env,offset),slot+nc_env_weight(env,offset),barred) else if nt_same(nc_slice(kind,2,Enum.count(kind)),barred) == 1 do nu_vars_from(env,nc_env_next(env,offset),slot+1,barred) else
        nc_join(nc_slice(kind,1,Enum.count(kind)),Enum.concat(b[0],nc_u24(slot)),nu_vars_from(env,nc_env_next(env,offset),slot+1,barred))
      end end
    end
  end
  # Push the comparator of each of the callee's type variables, as subst gives
  # it after a byte: 0, or for a callee of the library 1, or 2 when the caller
  # is of the library too and its own ordered variables have an order.
  def nu_comparators(source: bytes, table: bytes, names: bytes, plan: bytes, vars: bytes, barred: bytes): bytes do
    size = Enum.at(names,0,0)
    ordered = Enum.at(plan,0,0)
    # A name that ends in byte 127 is the twin of a type variable: the
    # description of its type (native-described.alc).
    twin = if Enum.at(names,size,0) == 127 do 1 else 0 end
    kind = nu_apply(Enum.concat(b[16,size-twin],nc_slice(names,1,1+size-twin)),nc_slice(plan,1,Enum.count(plan)))
    wants = if ordered == 0 do 0 else od_marked(nc_slice(names,1,1+size)) end
    found = if twin == 1 do jd_twin(source,table,kind,vars) else if wants == 0 do nq_comparator(source,table,kind,vars) else if od_orderable(kind,ordered-1) == 0 do b[] else od_comparator(source,table,kind,vars) end end end
    # A type without equality (it holds a function, a stream or a regex): its values
    # pass through a function that does not compare them, with the
    # comparator of words. So does a type that mentions the variable a
    # function is compiled without the equality of (qn_needs).
    one = if Enum.count(found) > 0 do found else if wants+twin > 0 do b[] else if nu_functional(kind,0)+nu_has(kind,26,0,Enum.count(kind))+nu_has(kind,29,0,Enum.count(kind))+qn_mentions(kind,barred) == 0 do b[] else b[49,192] end end end
    rest = if 1+size >= Enum.count(names) do b[] else nu_comparators(source,table,nc_slice(names,1+size,Enum.count(names)),plan,vars,barred) end
    if Enum.count(names) == 0 do b[] else if Enum.count(one) == 0 do b[] else
      if 1+size >= Enum.count(names) do Enum.concat(one,b[80]) else if Enum.count(rest) == 0 do b[] else nc_join(one,b[80],rest) end end
    end end
  end
  # 1 when the type holds a function type.
  def nu_functional(kind: bytes, offset: integer): integer do
    if nu_has(kind,10,0,Enum.count(kind)) == 0 do 0 else nu_functional_in(kind,0) end
  end
  def nu_functional_in(kind: bytes, index: integer): integer do
    if nt_tag(kind) == 10 do 1 else
      if index >= nu_parts(kind) do 0 else
        if nu_functional(nt_child(kind,index),0) == 1 do 1 else nu_functional_in(kind,index+1) end
      end
    end
  end
  # Which type variables of a library function need equality, as the
  # pinned library declares it (eq: in its table): 0 none, 1 every one, 2
  # the first, 3 the second, 4 the last.
  def nu_equal(source: bytes, table: bytes, target: integer): integer do
    home = nc_meta(table,nc_owner(table,target),0)
    name = nc_meta(table,target,0)
    listed = nc_word_at(source,home,b[65,108,99,104,127,109,69,110,117,109],0)+nc_word_at(source,home,b[65,108,99,104,127,109,83,116,114,101,97,109],0)
    lists = nc_word_at(source,home,b[65,108,99,104,127,109,76,105,115,116],0)
    maps = nc_word_at(source,home,b[65,108,99,104,127,109,77,97,112],0)*is_digit(byte_at(source,home+9))
    if od_library(source,table,target) == 0 do 0 else
      if listed > 0 do if nc_word(source,name,b[99,104,117,110,107,95,98,121])+nc_word(source,name,b[100,101,100,117,112,95,98,121])+nc_word(source,name,b[117,110,105,113,95,98,121]) > 0 do 4 else if nc_word(source,name,b[100,101,100,117,112])+nc_word(source,name,b[109,101,109,98,101,114,63])+nc_word(source,name,b[117,110,105,113]) > 0 do 1 else 0 end end else
        if lists == 1 do if nc_word(source,name,b[109,121,101,114,115,95,100,105,102,102,101,114,101,110,99,101])+nc_word(source,name,b[100,101,108,101,116,101])+nc_word(source,name,b[115,116,97,114,116,115,95,119,105,116,104,63])+nc_word(source,name,b[101,110,100,115,95,119,105,116,104,63]) > 0 do 1 else if nc_word(source,name,b[107,101,121,102,105,110,100])+nc_word(source,name,b[107,101,121,109,101,109,98,101,114,63])+nc_word(source,name,b[107,101,121,100,101,108,101,116,101])+nc_word(source,name,b[107,101,121,114,101,112,108,97,99,101])+nc_word(source,name,b[107,101,121,115,116,111,114,101])+nc_word(source,name,b[107,101,121,116,97,107,101]) > 0 do 2 else 0 end end else
          if maps == 1 do if nc_word(source,name,b[101,113,117,97,108,63]) > 0 do 3 else 0 end else 0 end
        end
      end
    end
  end
  # 1 when a variable that needs equality is given a type that holds a
  # function. names: the callee's variables from offset on, index the number
  # of the one there.
  def nu_refused(names: bytes, subst: bytes, rule: integer, state: bytes, barred: bytes): integer do
    offset = nc_long(state,0)
    index = nc_cursor(state,4)
    size = Enum.at(names,offset,0)
    last = if offset+1+size >= Enum.count(names) do 1 else 0 end
    wants = if rule == 1 do 1 else if rule == 2 do if index == 0 do 1 else 0 end else if rule == 3 do if index == 1 do 1 else 0 end else last end end end
    kind = if rule == 0 do b[] else nu_apply(Enum.concat(b[16],nc_slice(names,offset,offset+1+size)),subst) end
    if rule == 0 do 0 else if offset >= Enum.count(names) do 0 else
      if wants*(nu_functional(kind,0)+nu_has(kind,26,0,Enum.count(kind))+nu_has(kind,29,0,Enum.count(kind))+qn_mentions(kind,barred)) > 0 do 1 else nu_refused(names,subst,rule,Enum.concat(nc_u32(offset+1+size),nc_u24(index+1)),barred) end
    end end
  end
  # 1 when the result type of a function of the program names a type
  # variable that none of its parameters has: no call could settle it. The
  # library's own functions may (MapSet.new(): set[a]).
  def nu_stray(source: bytes, table: bytes, id: integer): integer do
    names = nu_names(nc_return_kind(source,table,id),0,b[])
    if Enum.count(names) == 0 do 0 else if od_library(source,table,id) == 1 do 0 else 1-nw_within(names,nu_cell_names(nj_cells(source,table,id),0,b[]),0) end end
  end
  # 1 for the list functions the pinned language keeps without a module.
  def nu_legacy(source: bytes, table: bytes, target: integer): integer do
    name = nc_meta(table,target,0)
    if nc_word_at(source,nc_meta(table,nc_owner(table,target),0),b[65,108,99,104,127,109,75,101,114,110,101,108],0) == 0 do 0 else nc_word(source,name,b[112,114,101,112,101,110,100])+nc_word(source,name,b[99,111,110,99,97,116])+nc_word(source,name,b[109,97,112])+nc_word(source,name,b[102,105,108,116,101,114])+nc_word(source,name,b[114,101,100,117,99,101]) end
  end
  # 1 when the function target has type variables in its signature.
  def nu_generic(source: bytes, table: bytes, target: integer): integer do
    cells = nj_cells(source,table,target)
    if nu_open_cells(cells,0) == 1 do 1 else nu_open(nc_return_kind(source,table,target),0) end
  end
  # The pinned language types an expression against the type its context
  # expects. A value whose own type is open, or that needed such a type to be
  # typed at all, is marked; a context that gives a type (an annotated binding,
  # a parameter of settled type, a result) accepts it, and one that gives none
  # (a binding without annotation, an operand) rejects it.
  def nw_mark(value: bytes): bytes do
    if nc_pos(value) < 0 do b[] else if nw_marked(value) == 1 do value else Enum.concat(nc_slice(value,0,3),Enum.concat(b[Enum.at(value,3,0)+128],nc_slice(value,4,Enum.count(value)))) end end
  end
  def nw_marked(value: bytes): integer do
    if Enum.count(value) < 4 do 0 else if Enum.at(value,3,0) >= 128 do 1 else 0 end end
  end
  # 1 when part leaves its mark on a value made of it. A part of no type of
  # its own (hd([])) that met one in the value, as the other branch of an if
  # or another arm of a case gives it, leaves none.
  def nw_held(value: bytes, part: bytes): integer do
    if nw_marked(part) == 0 do 0 else if nc_tag(part) != 9 do 1 else if nc_tag(value) == 9 do 1 else 0 end end end
  end
  # value, marked when a or b is.
  def nw_keep(value: bytes, a: bytes, b: bytes): bytes do
    kept = if nw_held(value,a)+nw_held(value,b) > 0 do nw_mark(value) else value end
    if nx_pure(a)+nx_pure(b) > 0 do nx_impure(kept) else kept end
  end
  def nw_when(value: bytes, order: integer): bytes do
    if order == 1 do nw_mark(value) else value end
  end
  # value, marked when its type is open or origin was marked.
  def nw_open(value: bytes, origin: bytes): bytes do
    if nw_marked(origin) == 1 do nw_mark(value) else if nu_holes(nc_kind(value),0) == 1 do nw_mark(value) else value end end
  end
  # A binding without annotation gives no type: its value's must be settled.
  def nw_settled(value: bytes): bytes do
    if nw_marked(value) == 1 do b[] else if nu_holes(nc_kind(value),0) == 1 do b[] else value end end
  end
  # 1 when a left operand of a comparison is marked or of an open type; an
  # empty list or map there takes the other side's type.
  def nw_open_operand(value: bytes): integer do
    tag = nc_tag(value)
    if nw_marked(value) == 1 do 1 else if (tag-7)*(tag-8) == 0 do 0 else nu_holes(nc_kind(value),0) end end
  end
  # A library call whose first argument is marked or of open type: shares 0
  # takes any, 1 has a result of the same element type and so needs its own
  # type from its context, 2 has no way to learn it.
  def nw_library(value: bytes, args: bytes, shares: integer): bytes do
    open = if nc_arg_count(args) == 0 do 0 else if nw_arg_marked(args,0) == 1 do 1 else nu_holes(nc_arg_kind(args,0),0) end end
    if open == 0 do value else if shares == 0 do value else if shares == 1 do nw_mark(value) else b[] end end end
  end
  # The type a context expects of the call whose "(" is at paren stands in the
  # environment as a record with no name there, its type behind tag 21.
  def nw_expect(env: bytes, paren: integer, kind: bytes): bytes do
    Enum.concat(env,nc_env_record(paren,paren,Enum.concat(b[21],kind)))
  end
  def nw_expected(env: bytes, paren: integer, offset: integer): bytes do
    kind = nt_read(env,offset+7)
    if offset >= Enum.count(env) do b[] else
      if nc_cursor(env,offset) != paren do nw_expected(env,paren,nc_env_next(env,offset)) else
        if nt_tag(kind) != 21 do nw_expected(env,paren,nc_env_next(env,offset)) else nc_slice(kind,1,Enum.count(kind)) end
      end
    end
  end
  # What the expected type settles of the variables of function target.
  def nw_seed(source: bytes, paren: integer, env: bytes, table: bytes, target: integer): bytes do
    wanted = nw_expected(env,paren,2)
    settled = if Enum.count(wanted) == 0 do b[] else nu_unify(nc_return_kind(source,table,target),wanted,b[]) end
    if Enum.count(settled) == 0 do b[] else nc_slice(settled,1,Enum.count(settled)) end
  end
  # 1 when the value at pos is one call, name(...) or Module.name(...), with no
  # operator after it: the "(" then gets the expected type.
  def nw_whole_call(source: bytes, pos: integer): integer do
    paren = nf_pipe_target(source,nc_start(source,pos))
    close = if paren < 0 do -1 else np_close(source,paren,0,16777216) end
    next = nc_start(source,close)
    value = byte_at(source,next)
    operator = if nc_and((value-43)*(value-45)*(value-42)*(value-47)*(value-60)*(value-62)*(value-61),(value-33)*(value-124)*(value-46)*(value-40)*(value-38)*(value-94)) == 0 do 1 else nc_word(source,next,b[97,110,100])+nc_word(source,next,b[111,114]) end
    if close < 0 do 0 else if operator > 0 do 0 else 1 end end
  end
  # The marks of an argument packet: bit i for argument i.
  def nw_marks(args: bytes): bytes do
    nt_item(nc_arg_types(args),nc_arg_count(args))
  end
  def nw_arg_marked(args: bytes, index: integer): integer do
    Enum.at(nw_marks(args),index,0)
  end
  # 1 when a deferred argument is a reference to a generic function, which
  # needs a function type no parameter with type variables can give.
  def nw_generic_reference(source: bytes, env: bytes, table: bytes, pending: bytes): integer do
    start = nc_cursor(pending,1)
    if nt_tag(pending) != 11 do 0 else if byte_at(source,start) != 38 do 0 else
      # A function of several forms is no such reference: the element type says which form.
      if nf_capture_form(source,start) == 1 do 0 else if nf_target(source,nc_start(source,nc_end(source,start)),env,table) < 0 do 0 else 1-nj_formed(source,table,nf_target(source,nc_start(source,nc_end(source,start)),env,table)) end end
    end end
  end
  # 1 when every name in names (length, name each) is in among.
  def nw_within(names: bytes, among: bytes, offset: integer): integer do
    size = Enum.at(names,offset,0)
    if offset >= Enum.count(names) do 1 else
      if nu_named(among,nc_slice(names,offset+1,offset+1+size),0) == 0 do 0 else nw_within(names,among,offset+1+size) end
    end
  end
  # The names in names that subst does not settle.
  def nw_unsettled(names: bytes, subst: bytes, offset: integer): bytes do
    size = Enum.at(names,offset,0)
    name = nc_slice(names,offset+1,offset+1+size)
    if offset >= Enum.count(names) do b[] else
      Enum.concat(if nu_bound(subst,name,0) >= 0 do b[] else nc_slice(names,offset,offset+1+size) end,nw_unsettled(names,subst,offset+1+size))
    end
  end
  # The variables of a function type's parameters.
  def nw_parameter_names(kind: bytes, index: integer, names: bytes): bytes do
    if nt_tag(kind) != 10 do names else if index >= nt_count(kind) do names else nw_parameter_names(kind,index+1,nu_names(nt_child(kind,index),0,names)) end end
  end
  # Arguments are typed in order, each against its parameter as the earlier
  # ones settled it. 0: every argument had its type. 1: one needed a variable
  # only the call's own expected type can settle (results holds the variables
  # of the result type), so the call is marked. 2: nothing can settle it.
  def nw_order(source: bytes, env: bytes, table: bytes, cells: bytes, args: bytes, results: bytes): integer do
    nw_order_from(source,nc_join(env,b[],b[]),table,cells,args,nc_join(b[0,0,0,0],nc_u16(Enum.count(results)),results))
  end
  # state: the argument index (3 bytes), the verdict so far, the length of results (2
  # bytes), results, then the substitution.
  def nw_order_from(source: bytes, env: bytes, table: bytes, cells: bytes, args: bytes, state: bytes): integer do
    index = nc_cursor(state,0)
    size = sg_plain_size(state)
    subst = nc_slice(state,6+size,Enum.count(state))
    wanted = nt_item(cells,index)
    given = nc_arg_kind(args,index)
    deferred = if nt_tag(given) == 11 do 1 else 0 end
    open = nw_unsettled(if deferred == 1 do sg_lambda_names(source,env,table,given,wanted,sg_strict(state)) else nu_names(wanted,0,b[]) end,subst,0)
    step = if Enum.count(open) == 0 do 0 else if nw_needy(args,index) == 0 do 0 else if nw_within(open,nc_slice(state,6,6+size),0) == 1 do 1 else 2 end end end
    next = if deferred == 1 do Enum.concat(b[1],subst) else nu_unify(wanted,given,subst) end
    if index >= nc_arg_count(args) do Enum.at(state,3,0) else
      if step == 2 do 2 else if deferred*nw_generic_reference(source,env,table,given) == 1 do 2 else if Enum.count(next) == 0 do 2 else
        nw_order_from(source,env,table,cells,args,nc_join(Enum.concat(nc_u24(index+1),b[if step == 1 do 1 else Enum.at(state,3,0) end]),nc_slice(state,4,6+size),nc_slice(next,1,Enum.count(next))))
      end end end
    end
  end
  # 1 when argument index needs a type from its parameter: a lambda, a marked
  # value or one of open type.
  def nw_needy(args: bytes, index: integer): integer do
    given = nc_arg_kind(args,index)
    if nt_tag(given) == 11 do 1 else if nw_arg_marked(args,index) == 1 do 1 else nu_holes(given,0) end end
  end
  # Native smoke test; generics.
  def main() do System.halt(0) end
end
