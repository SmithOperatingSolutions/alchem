defmodule NativeSystem do
  # Sys.name(...): the operating system primitives the library is written on
  # (spec/alchem-system.md). Only the appended library modules, whose names
  # start with Alchem, may call them; elsewhere Sys is an ordinary name.
  def nh_inside(source: bytes, start: integer, env: bytes, table: bytes): integer do
    owner = nc_owner(table,nc_read(env,0))
    if nc_word(source,start,b[83,121,115]) == 0 do 0 else if owner < 0 do 0 else
      nc_ours(source,nc_meta(table,owner,0))
    end end
  end
  def nh_name(source: bytes, start: integer, env: bytes, table: bytes, depth: integer): bytes do
    if nh_inside(source,start,env,table) == 1 do ny_or(nh_sys(source,start,env,table,depth),source,start,env,table,depth) else nc_name(source,start,env,table,depth) end
  end
  # 1 call, 2 addr, 3 peek, 4 poke, 5 stack, 6 text, 7 len, 8 copy, 9 find, 10 byte, 11 errno, 12 same,
  # 13 top and 14 limit (where the arena's free part starts and ends), 15 hash, 16 tls,
  # 17 cover (where the coverage of a test program stands, 0 for none: zf_cover_at),
  # 18 panic (the program fails as a panic of the pinned runtime, with that text: zf_panic_call),
  # 19 windows (1 in a program for Windows, else 0: a constant, spec/windows.md).
  def nh_op(source: bytes, dot: integer): integer do
    if nc_word(source,dot,b[99,111,118,101,114]) == 1 do 17 else if nc_word(source,dot,b[112,97,110,105,99]) == 1 do 18 else if nc_word(source,dot,b[119,105,110,100,111,119,115]) == 1 do 19 else nh_op_known(source,dot) end end end
  end
  def nh_op_known(source: bytes, dot: integer): integer do
    if nc_word(source,dot,b[99,97,108,108]) == 1 do 1 else if nc_word(source,dot,b[97,100,100,114]) == 1 do 2 else
      if nc_word(source,dot,b[112,101,101,107]) == 1 do 3 else if nc_word(source,dot,b[112,111,107,101]) == 1 do 4 else
        if nc_word(source,dot,b[115,116,97,99,107]) == 1 do 5 else if nc_word(source,dot,b[116,101,120,116]) == 1 do 6 else
          if nc_word(source,dot,b[108,101,110]) == 1 do 7 else if nc_word(source,dot,b[99,111,112,121]) == 1 do 8 else
            if nc_word(source,dot,b[102,105,110,100]) == 1 do 9 else if nc_word(source,dot,b[98,121,116,101]) == 1 do 10 else if nc_word(source,dot,b[101,114,114,110,111]) == 1 do 11 else if nc_word(source,dot,b[115,97,109,101]) == 1 do 12 else if nc_word(source,dot,b[116,111,112]) == 1 do 13 else if nc_word(source,dot,b[108,105,109,105,116]) == 1 do 14 else if nc_word(source,dot,b[104,97,115,104]) == 1 do 15 else if nc_word(source,dot,b[116,108,115]) == 1 do 16 else 0 end end end end end end end end
          end end
        end end
      end end
    end end
  end
  # Every argument is an integer, but the string of Sys.addr.
  def nh_integers(args: bytes, index: integer, count: integer): integer do
    if index >= count do 1 else if nt_tag(nc_arg_kind(args,index)) != 0 do 0 else nh_integers(args,index+1,count) end end
  end
  def nh_sys(source: bytes, pos: integer, env: bytes, table: bytes, depth: integer): bytes do
    dot = nc_expect(source,nc_end(source,pos),b[46])
    op = nh_op(source,dot)
    functions = nc_records(Enum.count(table))
    begin = if op == 0 do -1 else nc_expect(source,nc_end(source,dot),b[40]) end
    args = if begin < 0 do b[] else nc_arguments(source,begin,env,table,depth) end
    count = nc_arg_count(args)
    wanted = if op == 1 do if count == 0 do 1 else count end else Enum.at(b[0,0,1,1,2,0,2,1,3,3,1,1,3,0,0,1,1],op,0) end
    valid = if nc_pos(args) < 0 do 0 else if count != wanted do 0 else if count > 7 do 0 else
      if op == 2 do if nt_tag(nc_arg_kind(args,0)) == 2 do 1 else 0 end else nh_integers(args,0,count) end
    end end end
    # Sys.errno(number): Go's text for it, from the file runtime in slot functions+1.
    # Sys.hash(block): the crypto runtime in slot functions+6 (spec/crypto-x86_64.s).
    # Sys.tls(block): the TLS runtime in slot functions+7 (spec/tls-x86_64.s).
    if op == 18 do zf_panic_call(table,args) else if op == 19 do (if nc_pos(args) < 0 do b[] else if nc_arg_count(args) != 0 do b[] else nc_value(nc_pos(args),b[184,nc_win(),0,0,0],b[0]) end end) else if valid == 0 do b[] else if op == 17 do nc_value(nc_pos(args),zf_cover_at(table),b[0]) else if op > 14 do nc_value(nc_pos(args),nc_join(nc_arg_code(args),b[95],nc_call(functions+op-9)),b[0]) else if op == 11 do if functions+1 >= nc_slot_limit() do b[] else nc_value(nc_pos(args),nc_join(nc_arg_code(args),b[95,190,4,0,0,0],nc_call(functions+1)),b[2]) end else
      nc_value(nc_pos(args),Enum.concat(nc_arg_code(args),nh_emit(op,count)),if op == 6 do b[2] else b[0] end)
    end end end end end end
  end
  # The arguments are on the stack, the last on top; the result is in RAX.
  def nh_emit(op: integer, count: integer): bytes do
    if op == 1 do
      # RAX number, then RDI RSI RDX R10 R8 R9; the kernel's result as it is.
      pops = b[65,89,65,88,65,90,90,94,95,88]
      Enum.concat(nc_slice(pops,nh_skip(count),10),gm_syscall())
    else if op == 2 do b[88,72,131,192,8] else if op == 3 do b[88,72,139,0] else if op == 4 do b[88,95,72,137,7] else
      if op == 5 do b[76,137,240] else if op == 13 do b[76,137,224] else if op == 14 do b[76,137,232] else if op == 7 do b[95,49,192,128,60,7,0,116,5,72,255,192,235,245] else if op == 8 do b[89,94,95,252,243,164,72,137,248] else
        if op == 10 do b[88,15,182,0] else if op == 12 do b[89,94,95,49,192,252,243,166,15,148,192] else if op == 9 do b[88,89,95,72,137,250,72,133,201,116,14,252,242,174,117,9,72,141,71,255,72,41,208,235,7,72,199,192,255,255,255,255] else
          # text(address,count): a fresh string of count bytes, from the arena.
          b[89,94,76,141,89,15,73,131,227,248,77,1,227,77,57,235,118,7,255,20,37,120,4,64,0,76,137,224,77,137,220,72,137,8,72,141,120,8,252,243,164]
        end end end
      end end end end end
    end end end end
  end
  # How many bytes of the seven pops a call of count arguments leaves out.
  def nh_skip(count: integer): integer do
    if count == 7 do 0 else if count == 6 do 2 else if count == 5 do 4 else if count == 4 do 6 else 10-count end end end end
  end
  # 0x, 0o and 0b integers: the shift per digit, 0 for a decimal number.
  def nh_radix(source: bytes, pos: integer, stop: integer): integer do
    mark = if stop-pos < 3 do 0 else if byte_at(source,pos) != 48 do 0 else byte_at(source,pos+1) end end
    if mark == 120 do 4 else if mark == 111 do 3 else if mark == 98 do 1 else 0 end end end
  end
  def nh_digit(value: integer): integer do
    if is_digit(value) == 1 do value-48 else if (value-97)*(102-value) >= 0 do value-87 else if (value-65)*(70-value) >= 0 do value-55 else 99 end end end
  end
  # state: 1 once a digit that is not zero was seen, the bits so far, 1 when a later digit was not zero.
  def nh_digits(source: bytes, pos: integer, stop: integer, shift: integer, state: bytes): bytes do
    if pos >= stop do Enum.concat(b[0],state) else
      digit = nh_digit(byte_at(source,pos))
      limit = if shift == 4 do 16 else if shift == 3 do 8 else 2 end end
      started = Enum.at(state,0,0)
      width = if digit > 7 do 4 else if digit > 3 do 3 else if digit > 1 do 2 else digit end end end
      bits = if started == 1 do Enum.at(state,1,0)+shift else width end
      later = if started == 0 do 0 else if digit > 0 do 1 else Enum.at(state,2,0) end end
      if digit >= limit do b[] else if bits > 64 do b[] else
        rest = nh_digits(source,pos+1,stop,shift,b[if bits > 0 do 1 else 0 end,bits,later])
        if Enum.count(rest) == 0 do b[] else nc_join(b[Enum.at(rest,0,0),Enum.at(rest,1,0),Enum.at(rest,2,0),Enum.at(rest,3,0)],nc_slice(rest,4,Enum.count(rest)),b[72,193,224,shift,72,131,200,digit]) end
      end end
    end
  end
  def nh_number(source: bytes, pos: integer, stop: integer, negative: integer): bytes do
    found = nh_digits(source,pos+2,stop,nh_radix(source,pos,stop),b[0,0,0])
    bits = Enum.at(found,2,0)
    # 64 bits only for the lowest integer: one set bit under a minus sign.
    fits = if bits < 64 do 1 else if negative == 0 do 0 else 1-Enum.at(found,3,0) end end
    if Enum.count(found) == 0 do b[] else if fits == 0 do b[] else
      nc_result(stop,nc_join(b[49,192],nh_reversed(nc_slice(found,4,Enum.count(found))),if negative == 1 do b[72,247,216] else b[] end))
    end end
  end
  # The digit steps were joined last first, eight bytes each.
  def nh_reversed(code: bytes): bytes do
    size = Enum.count(code)
    if size <= 8 do code else
      middle = nc_half(nc_half(nc_half(nc_half(size))))*8
      Enum.concat(nh_reversed(nc_slice(code,middle,size)),nh_reversed(nc_slice(code,0,middle)))
    end
  end
  # Where a number that starts at start ends: 0x1F is one token.
  def nh_end(source: bytes, start: integer): integer do
    mark = if byte_at(source,start) != 48 do 0 else byte_at(source,start+1) end
    radix = if mark == 120 do 1 else if mark == 111 do 1 else if mark == 98 do 1 else 0 end end end
    stop = if radix == 0 do start else nh_scan(source,start+2,16777216) end
    if stop <= start+2 do ne_end(source,start) else stop end
  end
  def nh_scan(source: bytes, pos: integer, left: integer): integer do
    value = byte_at(source,pos)
    more = if nh_digit(if value == 95 do byte_at(source,pos+1) else value end) < 16 do 1 else 0 end
    if left == 0 do pos else if more == 0 do pos else nh_scan(source,pos+1,left-1) end end
  end
  # 1 unless more than one argument stands in the parentheses at pos: IO.puts(text)
  # is a statement, and IO.puts(device, text) a call of the library.
  def nh_single(source: bytes, pos: integer): integer do
    paren = nc_expect(source,pos,b[40])
    spans = if paren < 0 do b[] else if nc_word(source,paren,b[41]) == 1 do b[] else nc_list_collect(source,paren,b[],0,41) end end
    if nc_pos(spans) < 0 do 1 else if nc_units(Enum.count(nc_code(spans)),6) > 1 do 0 else 1 end end
  end
  # A struct a library file declares may be named with its module, File.Stat, or
  # in lowercase, file: the pinned library's own names. Only AlchemTypes holds such.
  def nh_declare(source: bytes, table: bytes, declared: bytes, owner: integer): bytes do
    name = nc_cursor(declared,0)
    plain = if nc_cursor(declared,3) != nc_end(source,name) do 0 else if byte_at(source,name) > 90 do 0 else 1 end end
    if Enum.count(declared) != 27 do declared else if plain == 1 do declared else
      if nt_same(nc_slice(source,nc_meta(table,owner,0),nc_meta(table,owner,3)),b[65,108,99,104,127,109,84,121,112,101,115]) == 1 do declared else b[] end
    end end
  end
  # Module.Name at pos where the program has no such module: the library's type of that name.
  def nh_dotted(source: bytes, pos: integer, table: bytes): integer do
    home = ny_module(source,table,b[65,108,99,104,127,109,84,121,112,101,115],Enum.concat(nc_u24(0),nc_u24(nc_records(Enum.count(table)))))
    if home < 0 do -1 else nh_find(source,pos,table,0,nc_records(Enum.count(table)),home) end
  end
  def nh_find(source: bytes, pos: integer, table: bytes, first: integer, stop: integer, owner: integer): integer do
    nh_within(source,pos,nd_name_end(source,pos)-pos,table,owner+1,owner)
  end
  # A module's records follow its header: those of owner from record at on.
  def nh_within(source: bytes, pos: integer, size: integer, table: bytes, at: integer, owner: integer): integer do
    flags = if at*27+16 >= Enum.count(table) do 32 else Enum.at(table,at*27+16,0) end
    start = if flags < 64 do 0 else nc_meta(table,at,0) end
    if at >= nc_records(Enum.count(table)) do -1 else if flags == 32 do -1 else
      match = if flags < 64 do 0 else if nc_meta(table,at,3)-start != size do 0 else nc_equal(source,pos,start,size) end end
      if match == 1 do at else nh_within(source,pos,size,table,at+1,owner) end
    end end
  end
  # Whether the source may call Module.name with count arguments, a piped
  # value among them; a reference to it without arguments counts. For the
  # library functions that share a name with the compiler's own of another
  # count: a false positive only appends them.
  # (nh_given: Module.name starts at start and its name ends at pos. The
  # one reading of a program that chooses its library asks it, ny_counted.)
  def nh_given(source: bytes, start: integer, pos: integer, count: integer): integer do
    paren = nc_expect(source,pos,b[40])
    spans = if paren < 0 do b[] else if nc_word(source,paren,b[41]) == 1 do b[] else nc_list_collect(source,paren,b[],0,41) end end
    given = if nc_pos(spans) < 0 do 0 else nc_units(Enum.count(nc_code(spans)),6) end
    before = nz_before(source,start-1)
    piped = if before < 1 do 0 else if byte_at(source,before)*256+byte_at(source,before-1) == 15996 do 1 else 0 end end
    if paren < 0 do 1 else if given+piped == count do 1 else 0 end end
  end
  # 1 for IO.puts(file, text) or IO.write(file, text) as the statement that
  # ends the body of a fn (ends 1) or of a for (ends 2): run for its effect, as upstream has every call of
  # a name that also has a form without a value, and the fn gives {}.
  def nh_effect(source: bytes, start: integer, env: bytes, ends: integer): integer do
    kind = if nc_word(source,start,b[73,79]) == 0 do 0 else ns_output_kind(source,nc_expect(source,nc_end(source,start),b[46])) end
    if ends == 0 do 0 else if kind == 0 do 0 else if kind == 3 do 0 else if ends == 2 do 1 else if nt_tag(nj_context(env,2,b[])) == 41 do 1 else 0 end end end end end
  end
  # A call of a library function written in Alchem notes where it stands
  # (RBP-152) before it calls, for a failure inside the library to name it.
  def nh_placed(table: bytes, value: bytes, pos: integer): bytes do
    code = nc_code(value)
    split = Enum.count(code)-9
    last = if split < 0 do 0 else if Enum.at(code,split,0)*65536+Enum.at(code,split+1,0)*256+Enum.at(code,split+8,0) == 4307731 do 1 else 0 end end
    store = Enum.concat(b[199,133,104,255,255,255],nc_u32(pos))
    placed = if last == 1 do nc_join(nc_slice(code,0,split),store,nc_slice(code,split,split+9)) else Enum.concat(store,code) end
    if nc_pos(value) < 0 do value else if nz_on(table) == 0 do value else nw_keep(nc_value(nc_pos(value),placed,nc_kind(value)),value,b[]) end end
  end
  # 1 for the word TLS in a module of the library: the pinned library has no
  # such module, so a program may have one, which the library never means.
  def nh_library(source: bytes, pos: integer, env: bytes, table: bytes): integer do
    owner = nc_owner(table,nc_read(env,0))
    if nc_word(source,pos,b[84,76,83]) == 0 do 0 else if owner < 0 do 0 else
      nc_ours(source,nc_meta(table,owner,0))
    end end
  end
  # The shared runtimes with the crypto runtime in the slot after the float
  # runtime's and the TLS runtime in the one after that.
  def nh_shared(shared: bytes, source: bytes, functions: integer): bytes do
    blob = if functions+6 > nc_slot_limit()+1 do b[] else if na_mentions(source,0,Enum.count(source),b[83,121,115],b[104,97,115,104]) == 0 do b[] else xa_runtime(kr_blob(),kr_blob_arm()) end end
    more = if functions+7 > nc_slot_limit()+1 do b[] else if na_mentions(source,0,Enum.count(source),b[83,121,115],b[116,108,115]) == 0 do b[] else xa_runtime(tq_blob(),tq_blob_arm()) end end
    nh_slot(nh_slot(shared,blob,24),more,28)
  end
  def nh_slot(shared: bytes, blob: bytes, before: integer): bytes do
    meta = nc_bundle_meta(shared)
    if Enum.count(blob) == 0 do shared else
      nc_join(nc_u16(before+4),nc_join(meta,nc_zeros(before-Enum.count(meta)),nc_u32(Enum.count(blob))),Enum.concat(nc_bundle_code(shared),blob))
    end
  end
  # Native smoke test; operating system primitives.
  def main() do System.halt(0) end
end
