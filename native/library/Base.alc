#: octets/1 needs octets_codes/1 octets_mark/1
  defp octets(text: string): list[integer] do
    places = octets_span(String.length(text))
    wide = Enum.map(octets_span((length(places) + 4095) / 4096), fn part -> String.slice(text, part * 4096, 4096) end)
    parts = Enum.map(octets_span((length(places) + 63) / 64), fn part -> String.slice(octets_part(wide, part / 64), rem(part, 64) * 64, 64) end)
    letters = Enum.map(places, fn place -> String.slice(octets_part(parts, place / 64), rem(place, 64), 1) end)
    found = if length(places) < 128 do Enum.map(letters, fn letter -> octets_one(letter) end) else octets_many(letters, octets_codes()) end
    if -1 in found do
      names = String.split(Enum.join(Enum.map(letters, fn letter -> octets_units(letter) end), ""), ",")
      Enum.map(Enum.take(names, length(names) - 1), fn name -> String.to_integer(name) end)
    else found end
  end
  defp octets_many(letters: list[string], codes: map[string, integer]): list[integer] do
    Enum.map(letters, fn letter -> Map.get(codes, letter, -1) end)
  end
  defp octets_one(letter: string): integer do
    if byte_size(letter) == 1 do octets_find(letter, 0, 255) else -1 end
  end
  defp octets_units(text: string): string do
    if byte_size(text) == 0 do "" else
      first = octets_find(text, 0, 255)
      if byte_size(text) == 1 do Integer.to_string(first) <> "," else
        Enum.join(Enum.map(String.split(text, octets_mark(first)), fn part -> octets_units(part) end), Integer.to_string(first) <> ",")
      end
    end
  end
  defp octets_find(text: string, low: integer, high: integer): integer do
    if low >= high do low else
      middle = (low + high + 1) / 2
      if octets_mark(middle) <= text do octets_find(text, middle, high) else octets_find(text, low, middle - 1) end
    end
  end
  defp octets_part(parts: list[string], index: integer): string do
    case Enum.at(parts, index) do
      some(part) -> part
      none -> ""
    end
  end
  defp octets_span(count: integer): list[integer] do
    if count < 2 do
      if count == 1 do [0] else
        start: list[integer] = []
        start
      end
    else
      half = count / 2
      low = octets_span(half)
      both = low ++ Enum.map(low, fn place -> place + half end)
      if count % 2 == 1 do both ++ [count - 1] else both end
    end
  end
  defp octets_at(items: list[integer], index: integer): integer do
    case Enum.at(items, index) do
      some(item) -> item
      none -> 0
    end
  end
  defp octets_text(items: list[integer]): string do
    Enum.join(Enum.map(items, fn item -> octets_mark(item) end), "")
  end
  defp octets_lines(items: list[integer]): list[integer] do
    Enum.filter(items, fn item -> item != 10 and item != 13 end)
  end
  defp octets_letters(letters: string): list[string] do
    Enum.map(octets_span(String.length(letters)), fn place -> String.slice(letters, place, 1) end)
  end
#: to16/1 needs octets/1
  defp to16(text: string): string do
    Enum.join(Enum.map(octets(text), fn item -> to16_pair(item) end), "")
  end
  defp to16_pair(item: integer): string do
    if item < 16 do "0" <> Integer.to_string(item, 16) else Integer.to_string(item, 16) end
  end
#: from16/1 needs octets/1
  defp from16(text: string): option[string] do
    items = octets(text)
    found = Enum.map(octets_span(length(items) / 2), fn pair -> from16_pair(from16_digit(octets_at(items, pair * 2)), from16_digit(octets_at(items, pair * 2 + 1))) end)
    if length(items) % 2 == 1 or -1 in found do none else some(octets_text(found)) end
  end
  defp from16_pair(high: integer, low: integer): integer do
    if high < 0 or low < 0 do -1 else high * 16 + low end
  end
  defp from16_digit(item: integer): integer do
    cond do
      item >= 48 and item <= 57 -> item - 48
      item >= 65 and item <= 70 -> item - 55
      item >= 97 and item <= 102 -> item - 87
      true -> -1
    end
  end
#: to32/1 needs octets/1
  defp to32(text: string, letters: string): string do
    items = octets(text)
    marks = octets_letters(letters)
    Enum.join(Enum.map(octets_span((length(items) + 4) / 5), fn group -> to32_group(items, length(items) - group * 5, group * 5, marks) end), "")
  end
  defp to32_group(items: list[integer], left: integer, index: integer, marks: list[string]): string do
    value = (((octets_at(items, index) * 256 + octets_at(items, index + 1)) * 256 + octets_at(items, index + 2)) * 256 + octets_at(items, index + 3)) * 256 + octets_at(items, index + 4)
    kept = cond do
      left == 1 -> 2
      left == 2 -> 4
      left == 3 -> 5
      left == 4 -> 7
      true -> 8
    end
    Enum.join([to32_letter(value, 0, kept, marks), to32_letter(value, 1, kept, marks), to32_letter(value, 2, kept, marks), to32_letter(value, 3, kept, marks), to32_letter(value, 4, kept, marks), to32_letter(value, 5, kept, marks), to32_letter(value, 6, kept, marks), to32_letter(value, 7, kept, marks)], "")
  end
  defp to32_letter(value: integer, index: integer, kept: integer, marks: list[string]): string do
    if index < kept do octets_part(marks, (value / 32 ** (7 - index)) % 32) else "=" end
  end
#: from32/1 needs octets/1
  defp from32(text: string, extended: boolean): option[string] do
    items = octets_lines(octets(text))
    groups = (length(items) + 7) / 8
    reads = Enum.map(octets_span(groups), fn group -> from32_group(items, length(items), group * 8, 0, 0, extended) end)
    kept = if groups >= 2 and from32_ended(octets_at(reads, groups - 2)) do Enum.take(reads, groups - 1) else reads end
    if -1 in kept do none else
      size = from32_bytes(octets_at(kept, length(kept) - 1) / 1099511627776)
      count = if length(kept) == 0 do 0 else length(kept) * 5 - 5 + size end
      some(octets_text(Enum.map(octets_span(count), fn place -> (octets_at(kept, place / 5) % 1099511627776 / 256 ** (4 - place % 5)) % 256 end)))
    end
  end
  defp from32_ended(read: integer): boolean do
    read >= 0 and read / 1099511627776 < 8
  end
  defp from32_bytes(size: integer): integer do
    cond do
      size == 2 -> 1
      size == 4 -> 2
      size == 5 -> 3
      size == 7 -> 4
      true -> 5
    end
  end
  defp from32_group(items: list[integer], count: integer, index: integer, place: integer, value: integer, extended: boolean): integer do
    at = index + place
    if place == 8 do 8 * 1099511627776 + value else
      if at >= count do -1 else
        item = octets_at(items, at)
        if item == 61 and place >= 2 and count - at <= 8 do
          if count - at - 1 + place < 7 or place == 3 or place == 6 or not from32_padded(items, at + 1, 7 - place) do -1 else
            place * 1099511627776 + value * 32 ** (8 - place)
          end
        else
          digit = from32_digit(item, extended)
          if digit < 0 do -1 else from32_group(items, count, index, place + 1, value * 32 + digit, extended) end
        end
      end
    end
  end
  defp from32_padded(items: list[integer], at: integer, left: integer): boolean do
    if left == 0 do true else
      if octets_at(items, at) != 61 do false else from32_padded(items, at + 1, left - 1) end
    end
  end
  defp from32_digit(item: integer, extended: boolean): integer do
    if extended do
      cond do
        item >= 48 and item <= 57 -> item - 48
        item >= 65 and item <= 86 -> item - 55
        true -> -1
      end
    else
      cond do
        item >= 65 and item <= 90 -> item - 65
        item >= 50 and item <= 55 -> item - 24
        true -> -1
      end
    end
  end
#: to64/1 needs octets/1
  defp to64(text: string, letters: string): string do
    items = octets(text)
    marks = octets_letters(letters)
    Enum.join(Enum.map(octets_span((length(items) + 2) / 3), fn group -> to64_group(items, length(items) - group * 3, group * 3, marks) end), "")
  end
  defp to64_group(items: list[integer], left: integer, index: integer, marks: list[string]): string do
    value = (octets_at(items, index) * 256 + octets_at(items, index + 1)) * 256 + octets_at(items, index + 2)
    third = if left >= 2 do octets_part(marks, (value / 64) % 64) else "=" end
    fourth = if left >= 3 do octets_part(marks, value % 64) else "=" end
    octets_part(marks, value / 262144) <> octets_part(marks, (value / 4096) % 64) <> third <> fourth
  end
#: from64/1 needs octets/1
  defp from64(text: string, safe: boolean): option[string] do
    items = octets_lines(octets(text))
    count = length(items)
    short = if count > 0 and count % 4 == 0 and octets_at(items, count - 1) == 61 do (if octets_at(items, count - 2) == 61 do 2 else 1 end) else 0 end
    found = Enum.map(Enum.take(items, count - short), fn item -> from64_digit(item, safe) end)
    if count % 4 != 0 or -1 in found do none else
      some(octets_text(Enum.map(octets_span(count / 4 * 3 - short), fn place -> from64_byte(found, place / 3 * 4, place % 3) end)))
    end
  end
  defp from64_byte(found: list[integer], index: integer, place: integer): integer do
    cond do
      place == 0 -> octets_at(found, index) * 4 + octets_at(found, index + 1) / 16
      place == 1 -> octets_at(found, index + 1) % 16 * 16 + octets_at(found, index + 2) / 4
      true -> octets_at(found, index + 2) % 4 * 64 + octets_at(found, index + 3)
    end
  end
  defp from64_digit(item: integer, safe: boolean): integer do
    cond do
      item >= 65 and item <= 90 -> item - 65
      item >= 97 and item <= 122 -> item - 71
      item >= 48 and item <= 57 -> item + 4
      item == 43 and not safe -> 62
      item == 47 and not safe -> 63
      item == 45 and safe -> 62
      item == 95 and safe -> 63
      true -> -1
    end
  end
#: encode16/1 needs to16/1
  def encode16(text: string): string do
    to16(text)
  end
#: decode16/1 needs from16/1
  def decode16(text: string): option[string] do
    from16(text)
  end
#: decode16!/1 needs from16/1
  def decode16!(text: string): string do
    case from16(text) do
      some(value) -> value
      none -> raise("the encoded text is not valid")
    end
  end
#: encode32/1 needs to32/1
  def encode32(text: string): string do
    to32(text, "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567")
  end
#: decode32/1 needs from32/1
  def decode32(text: string): option[string] do
    from32(text, false)
  end
#: decode32!/1 needs from32/1
  def decode32!(text: string): string do
    case from32(text, false) do
      some(value) -> value
      none -> raise("the encoded text is not valid")
    end
  end
#: hex_encode32/1 needs to32/1
  def hex_encode32(text: string): string do
    to32(text, "0123456789ABCDEFGHIJKLMNOPQRSTUV")
  end
#: hex_decode32/1 needs from32/1
  def hex_decode32(text: string): option[string] do
    from32(text, true)
  end
#: encode64/1 needs to64/1
  def encode64(text: string): string do
    to64(text, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
  end
#: decode64/1 needs from64/1
  def decode64(text: string): option[string] do
    from64(text, false)
  end
#: decode64!/1 needs from64/1
  def decode64!(text: string): string do
    case from64(text, false) do
      some(value) -> value
      none -> raise("the encoded text is not valid")
    end
  end
#: url_encode64/1 needs to64/1
  def url_encode64(text: string): string do
    to64(text, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")
  end
#: url_decode64/1 needs from64/1
  def url_decode64(text: string): option[string] do
    from64(text, true)
  end
#: url_decode64!/1 needs from64/1
  def url_decode64!(text: string): string do
    case from64(text, true) do
      some(value) -> value
      none -> raise("the encoded text is not valid")
    end
  end
# The forms with options: case: :upper, :lower or :mixed and padding: true or
# false, as atoms or booleans. They work on the text the forms above give or take.
#: opt/2
  defp opt(o: list[tuple[atom, atom]]): tuple[atom, boolean] do
    Enum.reduce(o, {:upper, true}, fn p, s ->
      k = elem(p, 0)
      v = elem(p, 1)
      if not ((k == :case and v in [:upper, :lower, :mixed]) or (k == :padding and v in [:true, :false])) do raise("Base takes case: :upper, :lower or :mixed and padding: true or false") end
      if k == :case do {v, elem(s, 1)} else {elem(s, 0), v == :true} end
    end)
  end
#: enc/2 needs opt/2
  defp enc(r: string, o: list[tuple[atom, atom]], low: boolean): string do
    s = opt(o)
    t = if elem(s, 1) do r else String.replace(r, "=", "") end
    if low and elem(s, 0) == :lower do String.downcase(t) else t end
  end
#: dec/2 needs opt/2 Kernel.binary_part/3
  defp dec(t: string, o: list[tuple[atom, atom]], f: fn[string, option[string]]): option[string] do
    s = opt(o)
    u = if elem(s, 0) == :upper do t else String.upcase(t) end
    c = String.replace(String.replace(u, "\n", ""), "\r", "")
    n = rem(String.length(c), 8)
    if elem(s, 1) do f(u) else
      if String.contains?(c, "=") do none else
        if n == 1 or n == 3 or n == 6 do
          case f(c <> String.duplicate("A", 8 - n)) do
            some(x) -> some(binary_part(x, 0, byte_size(x) - 5))
            none -> none
          end
        else f(c <> String.duplicate("=", rem(8 - n, 8))) end
      end
    end
  end
#: encode16/2 needs enc/2 encode16/1
  def encode16(t: string, o: list[tuple[atom, atom]]): string do
    enc(Base.encode16(t), o, true)
  end
#: decode16/2 needs opt/2 decode16/1
  def decode16(t: string, o: list[tuple[atom, atom]]): option[string] do
    l = elem(opt(o), 0)
    if (l == :upper and String.upcase(t) != t) or (l == :lower and String.downcase(t) != t) do none else Base.decode16(t) end
  end
#: encode32/2 needs enc/2 encode32/1
  def encode32(t: string, o: list[tuple[atom, atom]]): string do
    enc(Base.encode32(t), o, true)
  end
#: hex_encode32/2 needs enc/2 hex_encode32/1
  def hex_encode32(t: string, o: list[tuple[atom, atom]]): string do
    enc(Base.hex_encode32(t), o, true)
  end
#: encode64/2 needs enc/2 encode64/1
  def encode64(t: string, o: list[tuple[atom, atom]]): string do
    enc(Base.encode64(t), o, false)
  end
#: url_encode64/2 needs enc/2 url_encode64/1
  def url_encode64(t: string, o: list[tuple[atom, atom]]): string do
    enc(Base.url_encode64(t), o, false)
  end
#: decode32/2 needs dec/2 decode32/1
  def decode32(t: string, o: list[tuple[atom, atom]]): option[string] do
    dec(t, o, fn x -> Base.decode32(x) end)
  end
#: hex_decode32/2 needs dec/2 hex_decode32/1
  def hex_decode32(t: string, o: list[tuple[atom, atom]]): option[string] do
    dec(t, o, fn x -> Base.hex_decode32(x) end)
  end
#: decode64/2 needs opt/2 decode64/1
  def decode64(t: string, o: list[tuple[atom, atom]]): option[string] do
    c = String.replace(String.replace(t, "\n", ""), "\r", "")
    n = rem(String.length(c), 4)
    if elem(opt(o), 1) do Base.decode64(t) else
      if n == 1 or String.contains?(c, "=") do none else Base.decode64(c <> String.duplicate("=", rem(4 - n, 4))) end
    end
  end
#: encode32/2 form 2 needs encode32/2
  def encode32(t: string, o: list[tuple[atom, boolean]]): string do
    Base.encode32(t, Enum.map(o, fn p -> {elem(p, 0), if elem(p, 1) do :true else :false end} end))
  end
