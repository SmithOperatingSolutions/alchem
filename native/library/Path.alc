# Path: the functions written in Alchem.
#: join/2 needs _wjoin/1 _wslash/1
  def join(left: string, right: string): string do
    if Sys.windows() == 1 do
      Path._wslash(Path._wjoin([left, right]))
    else
      whole = if left == "" do right else if right == "" do left else left <> "/" <> right end end
      if whole == "" do "" else
        kept = Enum.o_turn(join_clean(String.split(whole, "/"), String.starts_with?(whole, "/"), []))
        text = if String.starts_with?(whole, "/") do "/" <> Enum.join(kept, "/") else Enum.join(kept, "/") end
        if text == "" do "." else text end
      end
    end
