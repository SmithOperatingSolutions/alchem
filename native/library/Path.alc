# filepath.Base of a path that is not "".
#: _wbase/1 needs _wat/2 _wsep/1 _wsub/3 _wvlen/1 _wlast/3 _wstrip/1
  def _wbase(p: string): string do
    q = Path._wstrip(p)
    v = Path._wvlen(q)
    r = Path._wsub(q, v, byte_size(q) - v)
    i = Path._wlast(r, byte_size(r) - 1, 0)
    b = Path._wsub(r, i + 1, byte_size(r) - i - 1)
    if b == "" do "\\" else b end
  end
#: _wstrip/1 needs _wat/2 _wsep/1 _wsub/3
  def _wstrip(p: string): string do
    if p != "" and Path._wsep(Path._wat(p, byte_size(p) - 1)) do Path._wstrip(Path._wsub(p, 0, byte_size(p) - 1)) else p end
  end
# filepath.Dir.
#: _wdir/1 needs _wsub/3 _wvlen/1 _wlast/3 _wclean/1
  def _wdir(p: string): string do
    v = Path._wvlen(p)
    vol = Path._wsub(p, 0, v)
    i = Path._wlast(p, byte_size(p) - 1, v)
    d = Path._wclean(Path._wsub(p, v, i + 1 - v))
    if d == "." and v > 2 do vol else vol <> d end
  end
# filepath.Ext.
#: _wext/1 needs _wat/2 _wsep/1 _wsub/3 _wext_at/2
  def _wext(p: string): string do
    Path._wext_at(p, byte_size(p) - 1)
  end
#: _wext_at/2 needs _wat/2 _wsep/1 _wsub/3
  def _wext_at(p: string, i: integer): string do
    if i < 0 or Path._wsep(Path._wat(p, i)) do "" else
      if Path._wat(p, i) == 46 do Path._wsub(p, i, byte_size(p) - i) else Path._wext_at(p, i - 1) end
    end
  end
# filepath.Rel: the relative path, or "" with false when there is none.
# Parts compare without regard to case (strings.EqualFold).
#: _wrel/2 needs _wclean/1 _wvlen/1 _wsub/3 _wat/2 _wsame/2 _wrel_parts/2 Enum.filter/2 String.split/2
  def _wrel(base_path: string, target_path: string): tuple[boolean, string] do
    base_vol = Path._wsub(base_path, 0, Path._wvlen(base_path))
    target_vol = Path._wsub(target_path, 0, Path._wvlen(target_path))
    base0 = Path._wclean(base_path)
    target0 = Path._wclean(target_path)
    if Path._wsame(target0, base0) do {true, "."} else
      base1 = Path._wsub(base0, byte_size(base_vol), byte_size(base0) - byte_size(base_vol))
      target = Path._wsub(target0, byte_size(target_vol), byte_size(target0) - byte_size(target_vol))
      base = if base1 == "." do "" else if base1 == "" and Path._wvlen(base_vol) > 2 do "\\" else base1 end end
      base_slashed = Path._wat(base, 0) == 92 and base != ""
      target_slashed = Path._wat(target, 0) == 92 and target != ""
      if base_slashed != target_slashed or not Path._wsame(base_vol, target_vol) do {false, ""} else
        left = Enum.filter(String.split(base, "\\"), fn part -> part != "" end)
        right = Enum.filter(String.split(target, "\\"), fn part -> part != "" end)
        Path._wrel_parts(left, right)
      end
    end
  end
#: _wrel_parts/2 needs _wsame/2 _wups/2 Enum.join/2
  def _wrel_parts(left: list[string], right: list[string]): tuple[boolean, string] do
    if left != [] and right != [] and Path._wsame(hd(left), hd(right)) do Path._wrel_parts(tl(left), tl(right)) else
      if left != [] and hd(left) == ".." do {false, ""} else
        {true, Enum.join(Path._wups(length(left), []) ++ right, "\\")}
      end
    end
  end
#: _wups/2
  def _wups(n: integer, done: list[string]): list[string] do
    if n <= 0 do done else Path._wups(n - 1, [".." | done]) end
  end
#: _wsame/2
  def _wsame(a: string, b: string): boolean do
    a == b or String.downcase(a) == String.downcase(b)
  end
# pathType on Windows.
#: _wtype/1 needs _wabs/1 _wvlen/1 String.starts_with?/2
  def _wtype(p: string): atom do
    if Path._wabs(p) do :absolute else
      if Path._wvlen(p) > 0 or String.starts_with?(p, "\\") or String.starts_with?(p, "/") do :volumerelative else :relative end
    end
  end
# filepath.Abs: GetFullPathNameW (pseudo call 1000102 of the Windows layer),
# cleaned; the path as it is when Windows cannot make it whole.
#: _wfull/1 needs _wclean/1
  def _wfull(p: string): string do
    q = if p == "" do "." else p end
    r = Sys.call(1000102, Sys.addr(q <> "\x00"))
    if r <= 0 do q else Path._wclean(Sys.text(r, Sys.len(r))) end
  end
# os.UserHomeDir on Windows: USERPROFILE.
#: _whome/0
  def _whome(): string do
    System.get_env("USERPROFILE", "")
  end
# pathSafeRelative on Windows.
#: _wsafe/1 needs _wtype/1 _wclean/1 _wslash/1 String.starts_with?/2
  def _wsafe(path: string): option[string] do
    if Path._wtype(path) != :relative do none else
      clean = Path._wslash(Path._wclean(path))
      if clean == ".." or String.starts_with?(clean, "../") do none else
        if clean == "." do some("") else some(clean) end
      end
    end
  end
