    kept = Enum.filter(parts, fn part -> part != "" end)
    if parts == [] do raise("cannot join an empty list of paths") end
    if Sys.windows() == 1 do Path._wslash(Path._wjoin(parts)) else
      if kept == [] do "" else Path.join(Enum.join(kept, "/"), "") end
    end
