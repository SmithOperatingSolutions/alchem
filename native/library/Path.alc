  # done holds the parts kept so far, the last one first.
  defp join_clean(parts: list[string], rooted: boolean, done: list[string]): list[string] do
    if parts == [] do done else
      part = hd(parts)
      if part == "" or part == "." do join_clean(tl(parts), rooted, done) else
        if part == ".." do
          if done == [] do
            if rooted do join_clean(tl(parts), rooted, done) else join_clean(tl(parts), rooted, [part | done]) end
          else
            if hd(done) == ".." do join_clean(tl(parts), rooted, [part | done]) else join_clean(tl(parts), rooted, tl(done)) end
          end
        else
          join_clean(tl(parts), rooted, [part | done])
        end
      end
    end
  end
