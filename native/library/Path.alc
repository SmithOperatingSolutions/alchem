#: basename/1 needs _wbase/1
  def basename(path: string): string do
    if Sys.windows() == 1 do
      if path == "" do "" else Path._wbase(path) end
    else
      kept = Enum.filter(String.split(path, "/"), fn part -> part != "" end)
      if path == "" do "" else
        if kept == [] do "/" else hd(Enum.reverse(kept)) end
      end
    end
  end
#: basename/2 needs basename/1 rootname/2
  def basename(path: string, extension: string): string do
