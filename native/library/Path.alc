#: dirname/1 needs join/2 _wdir/1 _wslash/1
  def dirname(path: string): string do
    if Sys.windows() == 1 do
      Path._wslash(Path._wdir(path))
    else
      parts = String.split(path, "/")
      if length(parts) < 2 do "." else
        Path.join(Enum.join(Enum.take(parts, length(parts) - 1), "/") <> "/", "")
      end
    end
