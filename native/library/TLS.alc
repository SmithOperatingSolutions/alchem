        sent = if sig == "" do "tls: failed to sign handshake" else TLS._out(g, t, TLS._seal(t, 22, sh <> cert <> ske <> done), d) end
        cke = if sent != "" do TLS._bad(t, sent) else TLS._want(g, t, 16, d) end
