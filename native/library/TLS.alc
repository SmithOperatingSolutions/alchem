    suite = TLS._pick(TLS._hex(prefs), ch, so, co, 2)
    groups = TLS._xb(ch, e, stop, 10)
    algs = TLS._xb(ch, e, stop, 13)
    curve = TLS._pick(TLS._hex("001d001700180019"), groups, 2, byte_size(groups), 2)
    scheme = TLS._scheme(algs, 2, byte_size(algs), id, false)
