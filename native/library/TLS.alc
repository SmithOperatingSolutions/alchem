# The number in the c bytes from i on.
#: _num/3
  def _num(s: string, i: integer, c: integer): integer do
    if c == 0 do 0 else TLS._num(s, i, c - 1) * 256 + Sys.byte(Sys.addr(s) + i + c - 1) end
  end
