    doy = doe - (365 * yoe + div(yoe, 4) - div(yoe, 100))
    mp = div(5 * doy + 2, 153)
    month = if mp < 10 do mp + 3 else mp - 9 end
    year = yoe + era * 400 + (if month <= 2 do 1 else 0 end)
