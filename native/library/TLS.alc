                  last = TLS._out(g, t, r1 <> r2, d)
                  if last != "" do TLS._bad(t, last) <> TLS._why(t) else "" end
                end
              end
            end
          end
        end
      end
    end
  end
# A connection that was accepted starts to speak TLS (HTTP.serve_tls):
# what is kept for it and "", or 0 and what went wrong.
#: _accept/5 needs _attach/2 _new/2 _server/3
  def _accept(g: integer, b: integer, d: integer, id: tuple[list[string], integer, integer, list[string]], flags: integer): tuple[integer, string] do
    t = TLS._new(g, b)
    Sys.poke(t + 232, flags)
    Sys.poke(t + 248, Process.__word(id))
    why = TLS._server(g, t, d)
    if why != "" do {t, why} else
      TLS._attach(t, b)
      {t, ""}
    end
  end
# Exactly k bytes of what the other end sent, or "" when they did not come.
#: _get/4 needs _from/2 _read/3 _sub/3
  def _get(g: integer, t: integer, k: integer, d: integer): string do
    held: string = if Sys.peek(t + 120) == 0 do "" else Process.__any(Sys.peek(t + 120)) end
    if byte_size(held) >= k do
      Sys.poke(t + 120, Process.__word(TLS._from(held, k)))
      TLS._sub(held, 0, k)
    else
      more = TLS._read(g, t, d)
      if more == "" do "" else
        Sys.poke(t + 120, Process.__word(held <> more))
        TLS._get(g, t, k, d)
      end
    end
  end
# ---- What Go says of a private key it cannot read ----
# The tag and length at i as encoding/asn1 reads them (parseTagAndLength):
# what is wrong, the class, the tag, 1 for a constructed element, the
# length and where the content starts.
#: _tl/2 needs _b/2 _tl1/4
  def _tl(s: string, i: integer): tuple[string, list[integer]] do
    n = byte_size(s)
    b = TLS._b(s, i)
    class = Process.__shr(b, 6)
    compound = Process.__and(Process.__shr(b, 5), 1)
    tag = Process.__and(b, 31)
    j = i + 1
    if tag == 31 do {"asn1: structure error: base 128 integer too large", [0, 0, 0, 0, 0]} else
      if j >= n do {"asn1: syntax error: truncated tag or length", [0, 0, 0, 0, 0]} else
        l = TLS._b(s, j)
        if l < 128 do {"", [class, tag, compound, l, j + 1]} else
          if l == 128 do {"asn1: syntax error: indefinite length found (not DER)", [0, 0, 0, 0, 0]} else
            {why, len} = TLS._tl1(s, j + 1, l - 128, 0)
            if why != "" do {why, [0, 0, 0, 0, 0]} else
              if len < 128 do {"asn1: structure error: non-minimal length", [0, 0, 0, 0, 0]} else {"", [class, tag, compound, len, j + 1 + l - 128]} end
            end
          end
        end
      end
    end
  end
#: _tl1/4 needs _b/2
  def _tl1(s: string, i: integer, left: integer, len: integer): tuple[string, integer] do
    if left == 0 do {"", len} else
      if i >= byte_size(s) do {"asn1: syntax error: truncated tag or length", 0} else
        if len >= 8388608 do {"asn1: structure error: length too large", 0} else
          v = len * 256 + TLS._b(s, i)
          if v == 0 do {"asn1: structure error: superfluous leading zeros in length", 0} else TLS._tl1(s, i + 1, left - 1, v) end
        end
      end
    end
