#: _edverify/3 needs Crypto.run/6 _edid/1 _edlow/2 _edneg/2 _edout/1 _gm/4 _modl/2 _padd/3 _pmul/3 _spread/2 _w/0 _words/2 _zero/2
  def _edverify(pk: string, m: string, sig: string): boolean do
