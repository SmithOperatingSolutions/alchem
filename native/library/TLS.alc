    TLS._t(3, f, alpha, p, t)
    TLS._t(2, f, alpha, alpha, u)
    TLS._t(3, f, u, alpha, alpha)
    TLS._t(3, f, alpha, u, alpha)
    TLS._t(3, f, u, y, z)
    TLS._t(2, f, u, u, u)
    TLS._t(4, f, u, u, gamma)
    TLS._t(4, f, z, u, t)
    TLS._t(3, f, beta, beta, beta)
    TLS._t(3, f, beta, beta, beta)
    TLS._t(3, f, u, beta, beta)
    TLS._t(2, f, p, alpha, alpha)
    TLS._t(4, f, p, p, u)
    TLS._t(4, f, u, beta, p)
    TLS._t(2, f, u, alpha, u)
    TLS._t(2, f, gamma, gamma, gamma)
    TLS._t(3, f, gamma, gamma, gamma)
    TLS._t(3, f, gamma, gamma, gamma)
    TLS._t(3, f, gamma, gamma, gamma)
    TLS._t(4, f, y, u, gamma)
