                sh = TLS._msg(t, 2, TLS._bs([3, 3]) <> sr <> sid <> TLS._n2(suite) <> TLS._bs([0]) <> TLS._v2(TLS._x(43, TLS._hex("0304")) <> TLS._x(51, TLS._n2(group) <> TLS._v2(pub))))
