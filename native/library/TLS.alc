# What encoding/asn1 says of the element at i when a field of a type
# wants the tag (compound: 1 for a SEQUENCE): "" when it is one, and
# where its content starts and its length.
#: _field/5 needs _tl/2
  def _field(s: string, i: integer, tag: integer, compound: integer, name: string): tuple[string, integer, integer] do
    if i >= byte_size(s) do {"asn1: syntax error: sequence truncated", 0, 0} else
      {why, f} = TLS._tl(s, i)
      [c, t, cp, len, off] = f
      if why != "" do {why, 0, 0} else
        if c != 0 or t != tag or cp != compound do {"asn1: structure error: tags don't match (#{tag} vs {class:#{c} tag:#{t} length:#{len} isCompound:#{cp == 1}}) {optional:false explicit:false application:false private:false defaultValue:<nil> tag:<nil> stringType:0 timeType:0 set:false omitEmpty:false} " <> name <> " @#{off}", 0, 0} else
          if off + len > byte_size(s) do {"asn1: syntax error: data truncated", 0, 0} else {"", off, len} end
        end
      end
    end
  end
# An object identifier's content with dots, as Go writes it.
#: _dotted/3 needs _b/2 _first?/2
  def _dotted(oid: string, i: integer, acc: integer): string do
    if i >= byte_size(oid) do "" else
      b = TLS._b(oid, i)
      v = acc * 128 + Process.__and(b, 127)
      if b >= 128 and v < 72057594037927936 do TLS._dotted(oid, i + 1, v) else
        (if i == 0 or TLS._first?(oid, i) do (if v < 80 do "#{div(v, 40)}.#{rem(v, 40)}" else "2.#{v - 80}" end) else ".#{v}" end) <> TLS._dotted(oid, i + 1, 0)
      end
    end
  end
# 1 when every byte before i continues a number.
#: _first?/2 needs _b/2
  def _first?(oid: string, i: integer): boolean do
    if i == 0 do true else TLS._b(oid, i - 1) >= 128 and TLS._first?(oid, i - 1) end
  end
# What x509.ParsePKCS8PrivateKey says of bytes that are no key this
# library reads, as far as its words are followed here.
#: _p8why/1 needs _dotted/3 _field/5 _hex/1 _sub/3
  def _p8why(der: string): string do
    {e0, a0, l0} = TLS._field(der, 0, 16, 1, "pkcs8")
    inner = TLS._sub(der, a0, l0)
    {e1, a1, l1} = if e0 != "" do {e0, 0, 0} else TLS._field(inner, 0, 2, 0, "int") end
    {e2, a2, l2} = if e1 != "" do {e1, 0, 0} else TLS._field(inner, a1 + l1, 16, 1, "AlgorithmIdentifier") end
    alg = TLS._sub(inner, a2, l2)
    {e3, a3, l3} = if e2 != "" do {e2, 0, 0} else TLS._field(alg, 0, 6, 0, "ObjectIdentifier") end
    {e4, a4, l4} = if e3 != "" do {e3, 0, 0} else TLS._field(inner, a2 + l2, 4, 0, "") end
    oid = TLS._sub(alg, a3, l3)
    if e4 != "" do e4 else
      if oid == TLS._hex("2a864886f70d010101") do "x509: failed to parse RSA private key embedded in PKCS#8" else
        if oid == TLS._hex("2a8648ce3d0201") do "x509: failed to parse EC private key embedded in PKCS#8" else
          if oid == TLS._hex("2b6570") do "x509: invalid Ed25519 private key" else "x509: PKCS#8 wrapping contained private key with unknown algorithm: " <> TLS._dotted(oid, 0, 0) end
        end
      end
    end
  end
