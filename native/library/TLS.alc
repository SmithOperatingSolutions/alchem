      if so < 0 do TLS._alert(g, t, 50, "") <> TLS._why(t) else
        TLS._seen(t, ch)
        Sys.poke(t + 376, Process.__word(TLS._sub(ch, 6, 32)))
        Sys.poke(t + 384, Process.__word(Crypto.strong_rand_bytes(32)))
        vs = TLS._xb(ch, e, stop, 43)
