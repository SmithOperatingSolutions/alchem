# The first suite of TLS 1.3 a client names.
#: _first13/3 needs _u2/2
  def _first13(ch: string, i: integer, stop: integer): integer do
    v = TLS._u2(ch, i)
    if i + 2 > stop do 0 else if v >= 0x1301 and v <= 0x1303 do v else TLS._first13(ch, i + 2, stop) end end
  end
# The first group of prefs that a client supports and sent a key for.
#: _withkey/3 needs _among/5 _keyof/4 _u2/2
  def _withkey(prefs: string, groups: string, shares: string): integer do
    if prefs == "" do 0 else
