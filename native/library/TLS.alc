    group = if keyed != 0 do keyed else TLS._pick(TLS._hex("001d001700180019"), groups, 2, byte_size(groups), 2) end
    scheme = TLS._scheme(algs, 2, byte_size(algs), id, true)
    sid = TLS._sub(ch, 38, 1 + TLS._b(ch, 38))
