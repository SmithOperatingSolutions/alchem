# content's length and where the next element starts; the tag is -1 when
# no well-formed element stands there.
#: _el/2 needs _num/3
  def _el(s: string, i: integer): tuple[integer, integer, integer, integer] do
    n = byte_size(s)
    a = Sys.addr(s)
