      tag = Sys.byte(a + i)
      l0 = Sys.byte(a + i + 1)
      if Process.__and(tag, 31) == 31 do {-1, 0, 0, 0} else
        if l0 < 128 do if i + 2 + l0 > n do {-1, 0, 0, 0} else {tag, i + 2, l0, i + 2 + l0} end else
