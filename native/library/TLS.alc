    ders = Enum.map(Enum.filter(blocks, fn x -> elem(x, 0) == "CERTIFICATE" end), fn x -> elem(x, 1) end)
    other = Enum.map(Enum.filter(blocks, fn x -> elem(x, 0) != "CERTIFICATE" end), fn x -> elem(x, 0) end)
    kb = TLS._pem(keys, 0)
    found = Enum.filter(kb, fn x -> elem(x, 0) == "PRIVATE KEY" or String.ends_with?(elem(x, 0), " PRIVATE KEY") end)
    skipped = TLS._before(kb, none)
    bad = {{none, 0, 0, none}, ""}
    if ders == [] do
      {elem(bad, 0), if other == [] do "tls: failed to find any PEM data in certificate input" else if length(other) == 1 and String.ends_with?(hd(other), "PRIVATE KEY") do "tls: failed to find certificate PEM data in certificate input, but did find a private key; PEM inputs may have been switched" else "tls: failed to find \"CERTIFICATE\" PEM block in certificate input after skipping PEM blocks of the following types: [" <> Enum.join(other, " ") <> "]" end end}
    else
      if found == [] do
        {elem(bad, 0), if skipped == [] do "tls: failed to find any PEM data in key input" else if skipped == ["CERTIFICATE"] do "tls: found a certificate rather than a key in the PEM for the private key" else "tls: failed to find PEM block with type ending in \"PRIVATE KEY\" in key input after skipping PEM blocks of the following types: [" <> Enum.join(skipped, " ") <> "]" end end}
      else
        {texts, nums, dns, ips} = TLS._cert(hd(ders))
        {kind, curve, key} = TLS._privkey(elem(hd(found), 1))
        alg = Enum.at(nums, 2, 0)
        pk = Enum.at(texts, 5, "")
        if texts == [] do {elem(bad, 0), "x509: malformed certificate"} else
          if kind == 0 do {elem(bad, 0), "tls: failed to parse private key: " <> TLS._p8why(elem(hd(found), 1))} else
            if alg == 0 do {elem(bad, 0), "tls: unknown public key algorithm"} else
              if alg != kind do {elem(bad, 0), "tls: private key type does not match public key type"} else
                same = if kind == 1 do Enum.at(key, 0, "") == pk and Enum.at(key, 1, "") == Enum.at(texts, 6, "") else if kind == 3 do Enum.at(key, 1, "") == pk else curve == Enum.at(nums, 3, 0) and TLS._ecpub(TLS._curve(curve), hd(key)) == pk end end
                if not same do {elem(bad, 0), "tls: private key does not match public key"} else {{ders, kind, curve, key}, ""} end
              end
            end
          end
        end
      end
    end
  end
# The kinds of the blocks before the first that holds a private key.
#: _before/2 needs String.ends_with?/2
  def _before(blocks: list[tuple[string, string, integer]], got: list[string]): list[string] do
    case blocks do
      [] -> got
      [x | rest] -> if elem(x, 0) == "PRIVATE KEY" or String.ends_with?(elem(x, 0), " PRIVATE KEY") do got else TLS._before(rest, got ++ [elem(x, 0)]) end
    end
  end
# The certificates and the key of two files (crypto/tls: LoadX509KeyPair).
#: _keypair/2 needs Sys.open/3 TCP._file/1 _pair/2
  def _keypair(certfile: string, keyfile: string): tuple[tuple[list[string], integer, integer, list[string]], string] do
    none: list[string] = []
    a = Sys.open(certfile, 0, 0)
    if a >= 0 do Sys.call(3, a) end
    b = if a < 0 do 0 else Sys.open(keyfile, 0, 0) end
    if b > 0 do Sys.call(3, b) end
    if a < 0 do {{none, 0, 0, none}, "open " <> certfile <> ": " <> Sys.errno(0 - a)} else
      if b < 0 do {{none, 0, 0, none}, "open " <> keyfile <> ": " <> Sys.errno(0 - b)} else TLS._pair(TCP._file(certfile), TCP._file(keyfile)) end
    end
  end
# ---- The accepting end (crypto/tls: handshake_server.go) ----
# The two-byte numbers from i up to stop as Go's %x writes a list of them.
#: _hexes/3 needs _u2/2
  def _hexes(s: string, i: integer, stop: integer): string do
    if i + 2 > stop do "" else String.downcase(Integer.to_string(TLS._u2(s, i), 16)) <> (if i + 4 > stop do "" else " " end) <> TLS._hexes(s, i + 2, stop) end
  end
# The first of the numbers in prefs (two bytes each) that is among those
# of s from i up to stop, step bytes apart; 0 for none.
#: _pick/5 needs _among/5 _u2/2
  def _pick(prefs: string, s: string, i: integer, stop: integer, step: integer): integer do
    if prefs == "" do 0 else
      v = TLS._u2(prefs, 0)
      if TLS._among(s, i, stop, v, step) == 1 do v else TLS._pick(Sys.text(Sys.addr(prefs) + 2, byte_size(prefs) - 2), s, i, stop, step) end
    end
  end
# The key a client sends for a group among its key shares from i up to
# stop; "" for none.
#: _keyof/4 needs _sub/3 _u2/2
  def _keyof(s: string, i: integer, stop: integer, group: integer): string do
    k = TLS._u2(s, i + 2)
    if i + 4 > stop or i + 4 + k > stop do "" else if TLS._u2(s, i) == group do TLS._sub(s, i + 4, k) else TLS._keyof(s, i + 4 + k, stop, group) end end
  end
# Where the parts of a ClientHello stand: its suites, their end, its
# extensions and their end; the first is -1 for a malformed one.
#: _chparts/1 needs _b/2 _u2/2
  def _chparts(ch: string): list[integer] do
    n = byte_size(ch)
    k = TLS._b(ch, 38)
    so = 39 + k
    co = so + 2 + TLS._u2(ch, so)
    e = co + 1 + TLS._b(ch, co)
    stop = if e == n do e else e + 2 + TLS._u2(ch, e) end
    if n < 43 or stop != n or TLS._b(ch, 0) != 1 or Process.__and(TLS._u2(ch, so), 1) == 1 do [-1, 0, 0, 0] else [so + 2, co, if e == n do e else e + 2 end, stop] end
  end
# The handshake of the accepting end over the socket of t before the
# time d, with the certificates and key at word 248: "" when it is over,
# else what went wrong.
#: _server/3 needs Crypto.strong_rand_bytes/1 _alert/4 _among/5 _chparts/1 _hexes/3 _s12/4 _s13/4 _seen/2 _sub/3 _u2/2 _want/4 _why/1 _xb/4 _xf/4
