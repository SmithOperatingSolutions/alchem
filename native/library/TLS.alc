      if TLS._among(groups, 2, byte_size(groups), v, 2) == 1 and TLS._keyof(shares, 2, byte_size(shares), v) != "" do v else TLS._withkey(Sys.text(Sys.addr(prefs) + 2, byte_size(prefs) - 2), groups, shares) end
    end
  end
# TLS 1.2 from the ClientHello on (handshake_server.go).
#: _s12/4 needs Enum.at/3 _aes/0 _alert/4 _among/5 _b/2 _bad/2 _bs/1 _certs/2 _chparts/1 _fin12/2 _hex/1 _hexes/3 _keys12/3 _msg/3 _n2/1 _out/4 _pick/5 _scheme/5 _seal/3 _seen/2 _share/1 _shared/3 _sign/3 _sub/3 _suite/1 _turn/1 _v1/1 _v2/1 _want/4 _why/1 _x/2 _xb/4 _xf/4
  def _s12(g: integer, t: integer, d: integer, ch: string): string do
