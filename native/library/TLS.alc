# The certificates of a server as a Certificate message holds them.
#: _certs/2 needs Enum.join/2 Enum.map/2 _v3/1
  def _certs(ders: list[string], v13: boolean): string do
    TLS._v3(Enum.join(Enum.map(ders, fn x -> TLS._v3(x) <> (if v13 do "\x00\x00" else "" end) end), ""))
  end
# TLS 1.3 from the ClientHello on (handshake_server_tls13.go).
#: _s13/4 needs Enum.at/3 TCP._opt/4 _aes/0 _alert/4 _apkeys/2 _b/2 _bad/2 _bs/1 _certs/2 _chparts/1 _fin/2 _first13/3 _h/2 _hex/1 _hexes/3 _hskeys/3 _keyof/4 _keys/3 _msg/3 _n2/1 _out/4 _pick/5 _scheme/5 _seal/3 _seen/2 _share/1 _shared/3 _sign/3 _sub/3 _suite/1 _th/1 _v1/1 _v2/1 _want/4 _why/1 _withkey/3 _x/2 _xb/4
  def _s13(g: integer, t: integer, d: integer, ch: string): string do
