    TLS._t(2, f, s1, s1, z2z2)
    TLS._t(2, f, s2, q + 80, p + 160)
    TLS._t(2, f, s2, s2, t)
    TLS._t(4, f, h, u2, u1)
    TLS._t(3, f, i, h, h)
    TLS._t(2, f, i, i, i)
    TLS._t(2, f, j, h, i)
    TLS._t(4, f, w, s2, s1)
    TLS._t(3, f, w, w, w)
    TLS._t(2, f, v, u1, i)
