    if suite == 0 or curve == 0 do TLS._alert(g, t, 40, "tls: no cipher suite supported by both client and server; client offered: [" <> TLS._hexes(ch, so, co) <> "]") <> TLS._why(t) else
      if scheme == 0 do TLS._alert(g, t, 40, "tls: peer doesn't support any of the certificate's signature algorithms") <> TLS._why(t) else
