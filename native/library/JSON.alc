# discriminant is -1: zf_zero) is null. A value is written by the description of its type, the one
# inspect walks (spec/integer-parse-x86_64.s): w is the word the value is
# held in and k where the node of its type stands. Each function gives 0,
# or the bytes of the message about a value JSON has no form for. Lists and
# maps are halved, so that a long one costs few levels of calls.
#: err/1
  def err(m: string): integer do Sys.addr(m) end
#: enc/3 needs dec/2 enc/3 encs/3 encv/3 fnum/3 items/4 outcome/3 pairs/3 putw/3 quote/3 record/3 tuple/3 variant/3 Sys.flat/1
