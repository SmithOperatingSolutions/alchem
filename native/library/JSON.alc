# JSON: the JSON type, JSON.decode and decode!, and what the compiler makes
# of JSON.encode, encode! and decode_as (native-json.alc): those go by the
# type of a value, which the compiler passes as a description. The text
# read and written, the errors and their wording are those of the pinned
# runtime, which uses Go 1.27's encoding/json (the version built on
# jsontext). spec/alchem-json.md says what is here.
#: struct JSON
  type JSON do
    null
    boolean(value: boolean)
    integer(value: integer)
    float(value: float)
    string(value: string)
    list(items: list[JSON])
    object(fields: map[string, JSON])
  end
# The record a parse or a write works on, 144 bytes: 0 the text and 8 its
# length, 16 the place in it, 24 what went wrong (the bytes of a message; 0:
# nothing), 40 a stack of words, 48 how many it holds and 56 its room, 64
# the open array or object (where its first word is on the stack; -1: none),
# 72 how many are open, 80 what comes next (0 a value, 1 what follows one,
# 2 a member's name, 3 nothing), 88 the finished value, 96 a buffer of
# bytes, 104 how many it holds and 112 its room, 120 1 to write over
# several lines, 128 how deep the writing is, 136 the first description,
# 144, 152 and 160 the values null, true and false once one was read.
#: open/1
  def open(t: string): integer do
    s = Sys.addr(String.duplicate("\x00", 168))
    Sys.poke(s, Sys.addr(t))
    Sys.poke(s + 8, byte_size(t))
    Sys.poke(s + 64, -1)
    s
  end
#: shut/1
  def shut(s: integer): integer do
    if Sys.peek(s + 56) > 0 do Sys.call(11, Sys.peek(s + 40), Sys.peek(s + 56) * 8) end
    if Sys.peek(s + 112) > 0 do Sys.call(11, Sys.peek(s + 96), Sys.peek(s + 112)) end
    0
  end
# Mapped memory of c bytes at m, now twice that (65536 bytes when there was none).
#: more/2
  def more(m: integer, c: integer): integer do
    r = if c == 0 do Sys.call(9, 0, 65536, 3, 34, -1, 0) else Sys.call(25, m, c, c * 2, 1) end
    if r < 0 and r > -4096 do System.halt(71) end
    r
  end
#: push/2 needs more/2
  def push(s: integer, w: integer): integer do
    t = Sys.peek(s + 48)
    c = Sys.peek(s + 56)
    if t == c do
      Sys.poke(s + 40, JSON.more(Sys.peek(s + 40), c * 8))
      Sys.poke(s + 56, if c == 0 do 8192 else c * 2 end)
    end
    Sys.poke(Sys.peek(s + 40) + t * 8, w)
    Sys.poke(s + 48, t + 1)
    0
  end
# Where k more bytes of the buffer go, with eight to spare.
#: room/2 needs more/2 room/2
  def room(s: integer, k: integer): integer do
    l = Sys.peek(s + 104)
    c = Sys.peek(s + 112)
    if l + k + 8 <= c do Sys.peek(s + 96) + l else
      Sys.poke(s + 96, JSON.more(Sys.peek(s + 96), c))
      Sys.poke(s + 112, if c == 0 do 65536 else c * 2 end)
      JSON.room(s, k)
    end
  end
#: put/3 needs room/2
  def put(s: integer, a: integer, k: integer): integer do
    Sys.copy(JSON.room(s, k), a, k)
    Sys.poke(s + 104, Sys.peek(s + 104) + k)
    0
  end
#: puts/2 needs put/3
  def puts(s: integer, t: string): integer do
    JSON.put(s, Sys.addr(t), byte_size(t))
  end
#: putc/2 needs room/2
  def putc(s: integer, c: integer): integer do
    Sys.poke(JSON.room(s, 1), c)
    Sys.poke(s + 104, Sys.peek(s + 104) + 1)
    0
  end
# The low k bytes (up to 8) of v: a short text without a string to hold it,
# since a string written in the program is made anew each time it is met.
#: putw/3 needs room/2
  def putw(s: integer, v: integer, k: integer): integer do
    Sys.poke(JSON.room(s, k), v)
    Sys.poke(s + 104, Sys.peek(s + 104) + k)
    0
  end
#: fail/2
  def fail(s: integer, m: string): integer do
    if Sys.peek(s + 24) == 0 do Sys.poke(s + 24, Sys.addr(m)) end
    0
  end
# The character at a of n bytes as Go's jsonwire.QuoteRune writes it.
#: qr/2 needs Kernel.binary_part/3 Sys.rune/2
  def qr(a: integer, n: integer): string do
    v = Sys.rune(a, n)
    c = Sys.byte(a)
    h = "0123456789abcdef"
    if v == 0 or v == 2162685 do "'\\x" <> binary_part(h, div(c, 16), 1) <> binary_part(h, rem(c, 16), 1) <> "'" else
      if c == 39 do "'\\''" else if c == 34 do "'\"'" else
        q = inspect(Sys.text(a, div(v, 2097152)))
        "'" <> binary_part(q, 1, byte_size(q) - 2) <> "'"
      end end
    end
  end
# Go's decoder reads its text in pieces of 64 bytes, then 128, 256 and so
# on, and what it says of a character or an escape that a piece ends in
# goes by the bytes read so far: where the piece that holds byte j ends.
#: lim/3 needs lim/3
  def lim(j: integer, n: integer, b: integer): integer do
    if b > j do if b < n do b else n end else JSON.lim(j, n, b * 2) end
  end
#: bad/3 needs fail/2 lim/3 qr/2
  def bad(s: integer, i: integer, w: string): integer do
    JSON.fail(s, "invalid character " <> JSON.qr(Sys.peek(s) + i, JSON.lim(i, Sys.peek(s + 8), 64) - i) <> " " <> w)
  end
# Past spaces, tabs and line breaks: the byte that stands there, -1 at the end.
#: ws/1 needs ws/1 wsk/4
  def ws(s: integer): integer do
    j = JSON.wsk(Sys.peek(s), Sys.peek(s + 8), Sys.peek(s + 16), 1000)
    Sys.poke(s + 16, if j < 0 do 0 - j - 1 else j end)
    if j < 0 do JSON.ws(s) else if j < Sys.peek(s + 8) do Sys.byte(Sys.peek(s) + j) else -1 end end
  end
#: wsk/4 needs wsk/4
  def wsk(a: integer, n: integer, i: integer, k: integer): integer do
    c = if i < n do Sys.byte(a + i) else -1 end
    if c == 32 or c == 9 or c == 13 or c == 10 do if k == 0 do 0 - i - 1 else JSON.wsk(a, n, i + 1, k - 1) end else i end
  end
# The parser is jsontext's consumeValue (Go 1.27) with its stack written
# out, a thousand steps to a level of calls, so that neither depth nor
# length costs calls.
#: go/1 needs go/1 run/2
  def go(s: integer): integer do
    JSON.run(s, 1000)
    if Sys.peek(s + 80) == 3 or Sys.peek(s + 24) != 0 do 0 else JSON.go(s) end
  end
#: run/2 needs run/2 step/1
  def run(s: integer, k: integer): integer do
    if k == 0 or Sys.peek(s + 80) == 3 or Sys.peek(s + 24) != 0 do 0 else
      JSON.step(s)
      JSON.run(s, k - 1)
    end
  end
#: step/1 needs after/3 fail/2 first/3 key/3 ws/1
  def step(s: integer): integer do
    st = Sys.peek(s + 80)
    c = JSON.ws(s)
    i = Sys.peek(s + 16)
    if c < 0 do JSON.fail(s, "unexpected EOF") else
      if st == 0 do JSON.first(s, c, i) else if st == 1 do JSON.after(s, c, i) else JSON.key(s, c, i) end end
    end
  end
#: first/3 needs bad/3 enter/3 lit/4 num/2 str/1
  def first(s: integer, c: integer, i: integer): integer do
    if c == 91 or c == 123 do JSON.enter(s, c, i) else if c == 34 do JSON.str(s) else if c == 45 or (c >= 48 and c <= 57) do JSON.num(s, i) else
      if c == 116 do JSON.lit(s, 1702195828, 4, 152) else if c == 102 do JSON.lit(s, 435728179558, 5, 160) else
        if c == 110 do JSON.lit(s, 1819047278, 4, 144) else JSON.bad(s, i, "looking for beginning of value") end
      end end
    end end end
  end
#: str/1 needs got/2 text/1
  def str(s: integer): integer do
    t = JSON.text(s)
    if Sys.peek(s + 24) == 0 do JSON.got(s, JSON.__word(JSON.string(t))) else 0 end
  end
#: got/2 needs push/2
  def got(s: integer, w: integer): integer do
    if Sys.peek(s + 64) < 0 do
      Sys.poke(s + 88, w)
      Sys.poke(s + 80, 3)
    else
      JSON.push(s, w)
      Sys.poke(s + 80, 1)
    end
    0
  end
#: enter/3 needs fail/2 got/2 push/2 ws/1
  def enter(s: integer, c: integer, i: integer): integer do
    Sys.poke(s + 16, i + 1)
    e = if Sys.peek(s + 72) == 10000 do 0 else JSON.ws(s) end
    j = Sys.peek(s + 16)
    if Sys.peek(s + 72) == 10000 do JSON.fail(s, "exceeded max depth") else if e < 0 do JSON.fail(s, "unexpected EOF") else
      if e == c + 2 do
        el: list[JSON] = []
        em: map[string, JSON] = %{}
        Sys.poke(s + 16, j + 1)
        JSON.got(s, if c == 91 do JSON.__word(JSON.list(el)) else JSON.__word(JSON.object(em)) end)
      else
        h = Sys.peek(s + 48)
        JSON.push(s, (Sys.peek(s + 64) + 1) * 2 + (if c == 91 do 0 else 1 end))
        Sys.poke(s + 64, h)
        Sys.poke(s + 72, Sys.peek(s + 72) + 1)
        Sys.poke(s + 80, if c == 91 do 0 else 2 end)
        0
      end
    end end
  end
#: after/3 needs bad/3 close/3
  def after(s: integer, c: integer, i: integer): integer do
    h = Sys.peek(s + 64)
    o = rem(Sys.peek(Sys.peek(s + 40) + h * 8), 2)
    if c == 44 do
      Sys.poke(s + 16, i + 1)
      Sys.poke(s + 80, if o == 1 do 2 else 0 end)
      0
    else
      if c == 93 + 32 * o do
        Sys.poke(s + 16, i + 1)
        JSON.close(s, h, o)
      else JSON.bad(s, i, if o == 1 do "after object key:value pair" else "after array element" end) end
    end
  end
# A member is three words on the stack, 2, the name and the value: a tuple.
#: key/3 needs bad/3 fail/2 push/2 text/1 ws/1
  def key(s: integer, c: integer, i: integer): integer do
    t = if c != 34 do "" else JSON.text(s) end
    e = if c != 34 or Sys.peek(s + 24) != 0 do 0 else JSON.ws(s) end
    j = Sys.peek(s + 16)
    if c != 34 do JSON.bad(s, i, "looking for beginning of object key string") else if Sys.peek(s + 24) != 0 do 0 else
      if e < 0 do JSON.fail(s, "unexpected EOF") else if e != 58 do JSON.bad(s, j, "after object key") else
        JSON.push(s, 2)
        JSON.push(s, JSON.__word(t))
        Sys.poke(s + 16, j + 1)
        Sys.poke(s + 80, 0)
        0
      end end
    end end
  end
# The array or object whose first word is at h on the stack is complete:
# its words become a list, or its members a map. Up to 64 members are put
# in order where they stand, the later of two with one name staying; more
# go through the list of tuples a map is made of.
#: close/3 needs Map.new/1 aslist/1 fill/3 got/2 pack/3 sortm/4
  def close(s: integer, h: integer, o: integer): integer do
    b = Sys.peek(s + 40) + h * 8
    t = Sys.peek(s + 48)
    n = div(t - h - 1, 3)
    Sys.poke(s + 64, div(Sys.peek(b), 2) - 1)
    Sys.poke(s + 72, Sys.peek(s + 72) - 1)
    Sys.poke(s + 48, h)
    if o == 0 do
      Sys.poke(b, t - h - 1)
      l: list[JSON] = JSON.__cast(JSON.aslist(b))
      JSON.got(s, JSON.__word(JSON.list(l)))
    else
      if n <= 64 do
        m = JSON.sortm(b + 8, 0, n, 0)
        JSON.pack(b + 8, 0, m)
        Sys.poke(b, m)
        f: map[string, JSON] = JSON.__cast(Sys.addr(Sys.text(b, m * 16 + 8)))
        JSON.got(s, JSON.__word(JSON.object(f)))
      else
        x = Sys.addr(Sys.text(b + 8, n * 24))
        Sys.poke(b, n)
        JSON.fill(b + 8, x, n)
        q: list[tuple[string, JSON]] = JSON.__cast(JSON.aslist(b))
        JSON.got(s, JSON.__word(JSON.object(Map.new(q))))
      end
    end
  end
# The members from i on of the n at p (three words each: 2, name, value)
# go among the m in order before them; how many there are in the end.
#: sortm/4 needs below/3 lift/3 same/3 sortm/4
  def sortm(p: integer, i: integer, n: integer, m: integer): integer do
    at = p + (if i < n do i else 0 end) * 24
    k: string = JSON.__cast(Sys.peek(at + 8))
    v = Sys.peek(at + 16)
    j = if i < n do JSON.below(p, m, k) else 0 end
    if i >= n do m else
      if j > 0 and JSON.same(p, j - 1, k) do
        Sys.poke(p + (j - 1) * 24 + 16, v)
        JSON.sortm(p, i + 1, n, m)
      else
        JSON.lift(p, m, j)
        Sys.poke(p + j * 24 + 8, JSON.__word(k))
        Sys.poke(p + j * 24 + 16, v)
        JSON.sortm(p, i + 1, n, m + 1)
      end
    end
  end
# How many of the m names in order do not come after k.
#: below/3 needs below/3
  def below(p: integer, m: integer, k: string): integer do
    x: string = JSON.__cast(Sys.peek(p + (if m > 0 do m - 1 else 0 end) * 24 + 8))
    if m == 0 do 0 else if x > k do JSON.below(p, m - 1, k) else m end end
  end
#: same/3
  def same(p: integer, j: integer, k: string): boolean do
    x: string = JSON.__cast(Sys.peek(p + j * 24 + 8))
    x == k
  end
#: lift/3 needs lift/3
  def lift(p: integer, m: integer, j: integer): integer do
    if m <= j do 0 else
      Sys.poke(p + m * 24 + 8, Sys.peek(p + m * 24 - 16))
      Sys.poke(p + m * 24 + 16, Sys.peek(p + m * 24 - 8))
      JSON.lift(p, m - 1, j)
    end
  end
# Name and value of each member side by side, as a map holds them.
#: pack/3 needs pack/3
  def pack(p: integer, t: integer, m: integer): integer do
    if t >= m do 0 else
      Sys.poke(p + t * 16, Sys.peek(p + t * 24 + 8))
      Sys.poke(p + t * 16 + 8, Sys.peek(p + t * 24 + 16))
      JSON.pack(p, t + 1, m)
    end
  end
#: fill/3 needs fill/3 fillk/3
  def fill(p: integer, x: integer, n: integer): integer do
    k = if n > 1000 do 1000 else n end
    JSON.fillk(p, x, k)
    if n > k do JSON.fill(p + 8 * k, x + 24 * k, n - k) else 0 end
  end
#: fillk/3 needs fillk/3
  def fillk(p: integer, x: integer, k: integer): integer do
    if k == 0 do 0 else
      Sys.poke(p, x)
      JSON.fillk(p + 8, x + 24, k - 1)
    end
  end
# jsonwire.ConsumeNumber: the integer part, the fraction, the exponent.
#: num/2 needs bad/3 digs/3 fail/2 frac/3
  def num(s: integer, i: integer): integer do
    a = Sys.peek(s)
    n = Sys.peek(s + 8)
    p = if Sys.byte(a + i) == 45 do i + 1 else i end
    c = if p < n do Sys.byte(a + p) else -1 end
    q = if c == 48 do p + 1 else if c >= 49 and c <= 57 do JSON.digs(a, n, p + 1) else -1 end end
    if c < 0 do JSON.fail(s, "unexpected EOF") else if q < 0 do JSON.bad(s, p, "in numeric literal") else JSON.frac(s, i, q) end end
  end
#: frac/3 needs bad/3 digs/3 expo/4 fail/2
  def frac(s: integer, i: integer, q: integer): integer do
    a = Sys.peek(s)
    n = Sys.peek(s + 8)
    d = if q < n and Sys.byte(a + q) == 46 do 1 else 0 end
    c = if q + 1 < n do Sys.byte(a + q + 1) else -1 end
    if d == 0 do JSON.expo(s, i, q, 0) else
      if c < 0 do JSON.fail(s, "unexpected EOF") else if c < 48 or c > 57 do JSON.bad(s, q + 1, "in numeric literal") else JSON.expo(s, i, JSON.digs(a, n, q + 2), 1) end end
    end
  end
#: expo/4 needs bad/3 digs/3 fail/2 numv/4
  def expo(s: integer, i: integer, q: integer, f: integer): integer do
    a = Sys.peek(s)
    n = Sys.peek(s + 8)
    e = if q < n and (Sys.byte(a + q) == 101 or Sys.byte(a + q) == 69) do 1 else 0 end
    g = if e == 1 and q + 1 < n and (Sys.byte(a + q + 1) == 43 or Sys.byte(a + q + 1) == 45) do q + 2 else q + 1 end
    c = if g < n do Sys.byte(a + g) else -1 end
    if e == 0 do JSON.numv(s, i, q, f) else
      if c < 0 do JSON.fail(s, "unexpected EOF") else if c < 48 or c > 57 do JSON.bad(s, g, "in numeric literal") else JSON.numv(s, i, JSON.digs(a, n, g + 1), 1) end end
    end
  end
#: digs/3 needs digk/4 digs/3
  def digs(a: integer, n: integer, p: integer): integer do
    r = JSON.digk(a, n, p, 1000)
    if r < 0 do JSON.digs(a, n, 0 - r - 1) else r end
  end
#: digk/4 needs digk/4
  def digk(a: integer, n: integer, p: integer, k: integer): integer do
    if p < n and Sys.byte(a + p) >= 48 and Sys.byte(a + p) <= 57 do if k == 0 do 0 - p - 1 else JSON.digk(a, n, p + 1, k - 1) end else p end
  end
# A number without fraction or exponent that fits an integer is one; any
# other is the nearest float, an infinity when it is too large for one.
#: numv/4 needs digits/3 flt/1 got/2
  def numv(s: integer, i: integer, q: integer, f: integer): integer do
    a = Sys.peek(s) + i
    Sys.poke(s + 16, q)
    if f == 0 and q - i <= 18 do
      JSON.got(s, JSON.__word(JSON.integer(if Sys.byte(a) == 45 do 0 - JSON.digits(a + 1, q - i - 1, 0) else JSON.digits(a, q - i, 0) end)))
    else
      t = Sys.text(a, q - i)
      w = if f == 1 do JSON.flt(t) else
        case Integer.parse(t) do
          ok(v) -> JSON.__word(JSON.integer(v))
          error(_) -> JSON.flt(t)
        end
      end
      JSON.got(s, w)
    end
  end
#: digits/3 needs digits/3
  def digits(a: integer, n: integer, v: integer): integer do
    if n == 0 do v else JSON.digits(a + 1, n - 1, v * 10 + Sys.byte(a) - 48) end
  end
#: flt/1 needs String.starts_with?/2
  def flt(t: string): integer do
    far: float = JSON.__cast(if String.starts_with?(t, "-") do -4503599627370496 else 9218868437227405312 end)
    case Float.parse(t) do
      ok(x) -> JSON.__word(JSON.float(x))
      error(_) -> JSON.__word(JSON.float(far))
    end
  end
# true, false or null: w holds the m letters, v is where the record keeps the value.
#: lit/4 needs Kernel.binary_part/3 bad/3 fail/2 got/2 litk/4
  def lit(s: integer, w: integer, m: integer, v: integer): integer do
    i = Sys.peek(s + 16)
    j = JSON.litk(Sys.peek(s) + i, Sys.peek(s + 8) - i, w, m)
    name = if j < 0 or j == m do "" else if v == 152 do "true" else if v == 160 do "false" else "null" end end end
    if j < 0 do JSON.fail(s, "unexpected EOF") else if j < m do JSON.bad(s, i + j, "in literal " <> name <> " (expecting '" <> binary_part(name, j, 1) <> "')") else
      if Sys.peek(s + v) == 0 do Sys.poke(s + v, if v == 144 do JSON.__word(JSON.null) else JSON.__word(JSON.boolean(v == 152)) end) end
      Sys.poke(s + 16, i + j)
      JSON.got(s, Sys.peek(s + v))
    end end
  end
# How many of the m letters in w the n bytes at a start with: m, the place
# of the first that differs, or -1 when the text ends before either.
#: litk/4 needs litk/4
  def litk(a: integer, n: integer, w: integer, m: integer): integer do
    if m == 0 do 0 else if n == 0 do -1 else if Sys.byte(a) != rem(w, 256) do 0 else
      r = JSON.litk(a + 1, n - 1, div(w, 256), m - 1)
      if r < 0 do r else r + 1 end
    end end end
  end
# The string that opens at the place: its bytes as they stand when it has
# no escape and only ASCII, else unquoted into the buffer.
#: text/1 needs plain/3 unq/2
  def text(s: integer): string do
    a = Sys.peek(s)
    n = Sys.peek(s + 8)
    i = Sys.peek(s + 16) + 1
    j = JSON.plain(a, n, i)
    Sys.poke(s + 104, 0)
    r = if j < n and Sys.byte(a + j) == 34 do j + 1 else JSON.unq(s, i) end
    if r < 0 do "" else
      Sys.poke(s + 16, r)
      if Sys.peek(s + 104) == 0 and r == j + 1 do Sys.text(a + i, j - i) else Sys.text(Sys.peek(s + 96), Sys.peek(s + 104)) end
    end
  end
# The first byte from i on that a string does not hold as it is.
#: plain/3 needs plain/3 plaink/4
  def plain(a: integer, n: integer, i: integer): integer do
    r = JSON.plaink(a, n, i, 1000)
    if r < 0 do JSON.plain(a, n, 0 - r - 1) else r end
  end
#: plaink/4 needs plaink/4
  def plaink(a: integer, n: integer, i: integer, k: integer): integer do
    c = if i < n do Sys.byte(a + i) else 0 end
    if c >= 32 and c < 128 and c != 34 and c != 92 do if k == 0 do 0 - i - 1 else JSON.plaink(a, n, i + 1, k - 1) end else i end
  end
# jsonwire.ConsumeString and AppendUnquote in one pass from p: the place
# after the closing quote, or -1.
#: unq/2 needs unq/2 unqk/3
  def unq(s: integer, p: integer): integer do
    r = JSON.unqk(s, p, 300)
    if r < -1 do JSON.unq(s, 0 - r - 2) else r end
  end
#: unqk/3 needs bad/3 esc/3 fail/2 plain/3 put/3 wide/3
  def unqk(s: integer, p: integer, k: integer): integer do
    a = Sys.peek(s)
    n = Sys.peek(s + 8)
    j = JSON.plain(a, n, p)
    c = if j < n do Sys.byte(a + j) else -1 end
    JSON.put(s, a + p, j - p)
    if c < 0 do JSON.fail(s, "unexpected EOF") - 1 else if c == 34 do j + 1 else if k == 0 do 0 - j - 2 else
      if c == 92 do JSON.esc(s, j, k) else if c < 32 do JSON.bad(s, j, "in string") - 1 else JSON.wide(s, j, k) end end
    end end end
  end
# Bytes that are no character become U+FFFD one by one.
#: wide/3 needs Sys.rune/2 put/3 putw/3 unqk/3
  def wide(s: integer, j: integer, k: integer): integer do
    a = Sys.peek(s)
    v = Sys.rune(a + j, Sys.peek(s + 8) - j)
    w = if v == 0 or v == 2162685 do 1 else div(v, 2097152) end
    if w == 1 do JSON.putw(s, 12435439, 3) else JSON.put(s, a + j, w) end
    JSON.unqk(s, j + w, k - 1)
  end
