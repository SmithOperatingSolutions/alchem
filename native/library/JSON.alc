    e = Sys.find(a, n, 101)
    me = if e < 0 do n else e end
    d = Sys.find(a, me, 46)
    pd = if d < 0 do me else d end
    r = JSON.room(s, 64) + 32
    l = pd - g + (if d < 0 do 0 else me - pd - 1 end)
    Sys.copy(r, a + g, pd - g)
    if d >= 0 do Sys.copy(r + pd - g, a + pd + 1, me - pd - 1) end
    z = JSON.zeros(r, l, 0, 1)
    nd = l - z - (if z == l do 0 else JSON.zeros(r, l, 0, -1) end)
    x = pd - g + (if e < 0 do 0 else if Sys.byte(a + e + 1) == 45 do 0 - JSON.digits(a + e + 2, n - e - 2, 0) else JSON.digits(a + e + 1, n - e - 1, 0) end end) - z - 1
