    items = Sys.peek(w + 16)
    r = if i < 0 or Sys.peek(items) != c do 0 else JSON.rec(c + 1) end
    if i < 0 do JSON.wrong(e, "expected one of " <> JSON.names(k, t) <> ", found " <> name) else
      if Sys.peek(items) != c do
        JSON.wrong(e, "expected " <> Integer.to_string(c) <> " fields, found " <> Integer.to_string(Sys.peek(items)))
        JSON.under(e, "." <> name)
      else
        Sys.poke(r + 8, i)
        JSON.tupled(e, items, r + 8, 0, q)
        if Sys.peek(e) != 0 do JSON.under(e, "." <> name) else
          if t == 6 do
            Sys.poke(r, 1 - i)
            Sys.poke(r + 8, Sys.peek(r + 16))
          end
          r
        end
      end
    end
  end
#: find/4 needs find/4
  def find(v: integer, c: integer, name: string, i: integer): integer do
    if c == 0 do -1 else if Sys.byte(v + 2) == byte_size(name) and Sys.same(v + 3, Sys.addr(name), byte_size(name)) == 1 do i else JSON.find(v + (Sys.byte(v) + 256 * Sys.byte(v + 1)), c - 1, name, i + 1) end end
  end
# The structs of the library that a description names by a number only:
# a range and the four of the calendar.
#: fixed/3 needs rec/1 under/2 unfit/3 whole/5 wrong/2
  def fixed(e: integer, v: JSON, t: integer): integer do
    names = if t == 23 do ["first", "last", "step"] else if t == 30 do ["year", "month", "day"] else if t == 31 do ["hour", "minute", "second", "microsecond"] else ["year", "month", "day", "hour", "minute", "second", "microsecond"] end end end
    case v do
      JSON.object(m) ->
        r = JSON.rec(if t == 33 do 9 else length(names) end)
        JSON.whole(e, m, names, r + 8, 0)
        if t == 23 do Sys.poke(r, 0) end
        if t == 33 and Sys.peek(e) == 0 do
          case Map.get(m, "time_zone") do
            some(JSON.string(z)) -> Sys.poke(r + 64, JSON.__word(z))
            some(other) ->
              JSON.unfit(e, "a string", other)
              JSON.under(e, ".time_zone")
            none ->
              JSON.wrong(e, "missing")
              JSON.under(e, ".time_zone")
          end
          if Sys.peek(e) == 0 do JSON.whole(e, m, ["utc_offset"], r + 72, 0) end
        end
        r
      _ -> JSON.unfit(e, "an object for " <> (if t == 23 do "Range" else if t == 30 do "Date" else if t == 31 do "Time" else if t == 32 do "NaiveDateTime" else "DateTime" end end end end), v)
    end
  end
#: whole/5 needs Enum.at/3 under/2 unfit/3 whole/5 wrong/2
  def whole(e: integer, m: map[string, JSON], names: list[string], p: integer, i: integer): integer do
    name = Enum.at(names, i, "")
    if i >= length(names) do 0 else
      case Map.get(m, name) do
        some(JSON.integer(n)) -> Sys.poke(p + 8 * i, n)
        some(other) -> JSON.unfit(e, "an integer", other)
        none -> JSON.wrong(e, "missing")
      end
      if Sys.peek(e) != 0 do JSON.under(e, "." <> name) else JSON.whole(e, m, names, p, i + 1) end
    end
  end
# The word of result[a, string]: ok of the value, or error of what did not
# fit with the path before it.
#: read/2 needs failed/1 fit/3 told/1
  def read(v: JSON, k: integer): integer do
    e = Sys.addr(String.duplicate("\x00", 24))
    Sys.poke(e + 16, k)
    good: result[integer, string] = ok(JSON.fit(e, v, k))
    if Sys.peek(e) == 0 do JSON.__word(good) else JSON.failed(JSON.told(e)) end
  end
#: told/1 needs Kernel.binary_part/3 String.starts_with?/2
  def told(e: integer): string do
    m = Sys.peek(e)
    p = Sys.peek(e + 8)
    path = Sys.text(p, Sys.peek(p - 8))
    shown = if String.starts_with?(path, ".") do binary_part(path, 1, byte_size(path) - 1) else path end
    (if shown == "" do "" else shown <> ": " end) <> Sys.text(m, Sys.peek(m - 8))
  end
#: failed/1
  def failed(m: string): integer do
    bad: result[integer, string] = error(m)
    JSON.__word(bad)
  end
# JSON.decode_as(text) and JSON.decode_as(value) as the compiler passes
# them: k is the description of the type the context expects.
#: decode_as/2 needs failed/1 open/1 parse/1 read/2
  def decode_as(t: string, k: integer): integer do
    s = JSON.open(t)
    e = JSON.parse(s)
    v: JSON = JSON.__cast(if e != 0 do JSON.__word(JSON.null) else Sys.peek(s + 88) end)
    if e != 0 do JSON.failed("invalid JSON: " <> Sys.text(e, Sys.peek(e - 8))) else JSON.read(v, k) end
  end
#: decode_as/2 form 2 needs read/2
  def decode_as(v: JSON, k: integer): integer do
    JSON.read(v, k)
  end

