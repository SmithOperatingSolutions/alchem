# A float as Go's strconv writes it with 'g' and the fewest digits that
# give it back: with an exponent below -4 or from 6 up in the form d.ddde+XX.
# An infinity or NaN has no JSON (strict 1), but in a JSON value is written
# as Go names it, as the pinned runtime does (88 of the record notes it).
#: fnum/3 needs err/1 gnum/2 puts/2
  def fnum(s: integer, w: integer, strict: integer): integer do
    m = if w < 0 do w + 9223372036854775807 + 1 else w end
