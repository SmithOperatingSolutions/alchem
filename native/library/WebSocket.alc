        WebSocket._options(rest, {tls, if k == :origin do v else origin end, if k == :compress do v == "true" else compress end})
    end
  end
#: connect/4 needs Enum.at/3 HTTP._hostport/1 HTTP._url/1 Process._check/1 Process._due/2 Process._g/0 TCP._block/3 TCP._close/2 TCP._dial/3 _extra/2 _handshake/6 _options/2
  def connect(a: string, ms: integer, o: list[tuple[atom, string]], h: list[tuple[string, string]]): result[websocket, string] do
