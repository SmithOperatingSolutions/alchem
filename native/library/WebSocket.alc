# The server may use only what was offered: compression, once, with each
# of its messages compressed on its own.
#: _chosen/3 needs Enum.member?/2
  def _chosen(e: list[list[string]], compress: boolean, deflate: boolean): tuple[string, boolean] do
    case e do
      [] -> {"", deflate}
      [x | rest] ->
        if hd(x) != "permessage-deflate" or not compress or deflate or not Enum.member?(tl(x), "server_no_context_takeover") do {hd(x), false} else WebSocket._chosen(rest, compress, true) end
    end
  end
