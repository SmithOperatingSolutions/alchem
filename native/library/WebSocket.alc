      [] -> []
      [{k, v} | rest] ->
        here = if TCP._lower(k) != "sec-websocket-extensions" do [] else
          Enum.filter(Enum.map(HTTP._parts(v, 44), fn offer ->
            Enum.map(HTTP._parts(offer, 59), fn part ->
              t = HTTP._trim(part)
              i = Sys.find(Sys.addr(t), byte_size(t), 61)
              if i < 0 do TCP._lower(t) else TCP._lower(HTTP._trim(TCP._sub(t, 0, i))) <> "=" <> String.trim(HTTP._trim(TCP._sub(t, i + 1, byte_size(t) - i - 1)), "\"") end
            end)
