#: _options/2 needs Atom.to_string/1 TCP._sub/3
  def _options(o: list[tuple[atom, string]], acc: tuple[string, string, boolean]): tuple[string, string, boolean] do
    {ca, origin, compress} = acc
    case o do
      [] -> acc
      [{k, v} | rest] ->
        if k != :ca_file and k != :insecure and k != :origin and k != :compress do raise("WebSocket.connect: unknown option :" <> Atom.to_string(k) <> "; the options are ca_file:, insecure:, origin: and compress:") end
