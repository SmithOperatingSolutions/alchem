# Whether a client offered compression in a form this end can give.
#: _offered/1 needs Enum.all?/2 Enum.any?/2 String.split/2 _extensions/1
  def _offered(h: list[tuple[string, string]]): boolean do
    Enum.any?(WebSocket._extensions(h), fn e ->
      hd(e) == "permessage-deflate" and Enum.all?(tl(e), fn s ->
        name = hd(String.split(s, "="))
        s == "server_max_window_bits=15" or name == "client_max_window_bits" or name == "server_no_context_takeover" or name == "client_no_context_takeover"
      end)
    end)
  end
#: _upgrade/3 needs Base.decode64/1 HTTP._get/2 HTTP._holds/3 Process._due/2 Process._g/0 Process._has/2 Process._ready/2 TCP._close/2 TCP._write/5 _accept/1 _new/5 _offered/1
  def _upgrade(limit: integer, compress: boolean, where: integer): result[websocket, string] do
