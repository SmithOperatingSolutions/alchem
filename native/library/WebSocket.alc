  end
#: peer/1
  def peer(ws: websocket): string do
    Process.__any(Sys.peek(Sys.peek(ws.at) + 112))
  end
#: compressed?/1
  def compressed?(ws: websocket): boolean do
    Sys.peek(ws.at + 24) == 1
  end
# The extensions a Sec-WebSocket-Extensions header names, each as its name
# and then its settings, name=value.
#: _extensions/1 needs Enum.filter/2 Enum.map/2 HTTP._parts/2 HTTP._trim/1 String.trim/2 TCP._lower/1 TCP._sub/3
  def _extensions(h: list[tuple[string, string]]): list[list[string]] do
