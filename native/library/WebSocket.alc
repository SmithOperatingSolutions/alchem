        if not HTTP._holds(r.headers, "connection", "upgrade") or not HTTP._holds(r.headers, "upgrade", "websocket") do error("not a WebSocket request: no upgrade to websocket") else
          if HTTP._get(r.headers, "sec-websocket-version") != "13" do error("not a WebSocket request: the version must be 13") else
