  def _handshake(g: integer, cb: integer, u: list[string], d: integer, opts: tuple[string, string, boolean], extra: string): result[websocket, string] do
    {ca, origin, compress} = opts
    [scheme, user, has, host, path, query, force, frag, opaque, omit] = u
    empty: list[tuple[string, string]] = []
    file = TCP._sub(ca, 1, byte_size(ca) - 1)
    secure = if scheme != "wss" do "" else
      {roots, wrong} = if file == "" do {empty, ""} else TLS._cafile(file) end
      if wrong != "" do wrong else
        said = elem(TLS._dial(g, cb, d, HTTP._barehost(u), {if TCP._sub(ca, 0, 1) == "1" do 1 else 0 end, roots}), 1)
        if said == "EOF" do "closed" else said end
      end
    end
    if secure != "" do error(secure) else
      s = TCP._s() + 512
      Sys.call(318, s, 16, 0)
      key = Base.encode64(Sys.text(s, 16))
      target = (if path == "" do "/" else path end) <> (if force != "" or query != "" do "?" <> query else "" end)
      out = "GET " <> target <> " HTTP/1.1\r\nHost: " <> host <> "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " <> key <> "\r\nSec-WebSocket-Version: 13\r\n" <> (if origin == "" do "" else "Origin: " <> origin <> "\r\n" end) <> (if compress do "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover\r\n" else "" end) <> extra <> "\r\n"
      sent = TCP._write(g, cb, Sys.addr(out), byte_size(out), d)
