#: upgrade/1 needs _upgrade/3
  def upgrade(r: HTTP.Request): result[websocket, string] do
    WebSocket._upgrade(16777216, false, 0)
  end
#: upgrade/2 needs Atom.to_string/1 _upgrade/3
  def upgrade(r: HTTP.Request, o: list[tuple[atom, boolean]]): result[websocket, string] do
    compress = Enum.reduce(o, false, fn {k, v}, acc ->
      if k != :compress do raise("WebSocket.upgrade: unknown option :" <> Atom.to_string(k) <> "; the options are max_message_bytes: and compress:") end
      v
    end)
    WebSocket._upgrade(16777216, compress, 0)
  end
#: upgrade/2 form 2 needs Atom.to_string/1 _upgrade/3
  def upgrade(r: HTTP.Request, o: list[tuple[atom, integer]]): result[websocket, string] do
    {limit, compress} = Enum.reduce(o, {16777216, false}, fn {k, v}, acc ->
      if k == :max_message_bytes and v <= 0 do raise("WebSocket.upgrade: max_message_bytes: must be positive") end
      if k != :max_message_bytes and k != :compress do raise("WebSocket.upgrade: unknown option :" <> Atom.to_string(k) <> "; the options are max_message_bytes: and compress:") end
      if k == :compress do {elem(acc, 0), v != 0} else {v, elem(acc, 1)} end
    end)
    WebSocket._upgrade(limit, compress, 0)
  end
#: connect/2 needs connect/4
  def connect(a: string, ms: integer): result[websocket, string] do
    o: list[tuple[atom, string]] = []
    h: list[tuple[string, string]] = []
    WebSocket.connect(a, ms, o, h)
  end
#: connect/3 needs connect/4
  def connect(a: string, ms: integer, o: list[tuple[atom, string]]): result[websocket, string] do
    h: list[tuple[string, string]] = []
    WebSocket.connect(a, ms, o, h)
  end
# The headers a caller adds to the handshake: what is wrong with them
# ("": nothing) and their lines.
#: _extra/2 needs Enum.member?/2 TCP._lower/1
  def _extra(h: list[tuple[string, string]], acc: string): tuple[string, string] do
    case h do
      [] -> {"", acc}
      [{name, value} | rest] ->
        p = Sys.addr(name)
        n = byte_size(name)
        q = Sys.addr(value)
        m = byte_size(value)
        if n == 0 or Sys.find(p, n, 32) >= 0 or Sys.find(p, n, 9) >= 0 or Sys.find(p, n, 13) >= 0 or Sys.find(p, n, 10) >= 0 or Sys.find(p, n, 58) >= 0 or Sys.find(q, m, 13) >= 0 or Sys.find(q, m, 10) >= 0 do {"invalid header " <> inspect(name), ""} else
          if Enum.member?(["host", "upgrade", "connection", "sec-websocket-key", "sec-websocket-version", "sec-websocket-extensions"], TCP._lower(name)) do {"the header " <> name <> " is set by the WebSocket handshake", ""} else WebSocket._extra(rest, acc <> name <> ": " <> value <> "\r\n") end
        end
    end
