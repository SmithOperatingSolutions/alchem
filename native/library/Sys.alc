# "Maps": bit 62 of a node's first word says it is a branch, with the
# count of its children at +8 and a key and a child every 16 bytes from
# +16); what reads a map's words (JSON, Node) reads this.
#: flat/1 needs flat_walk/2
  def flat(w: integer): integer do
    n = Sys.peek(w)
