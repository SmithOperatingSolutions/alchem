# the descriptor has something (library/Process.alc keeps the function that
# waits at g + 1032): the descriptor. 1 for such a program.
#: busy/0 needs state/0
  def busy(): integer do
    g = Sys.peek(Sys.state() + 96)
    if g == 0 do 0 else if Sys.peek(g + 1032) == 0 do 0 else 1 end end
  end
