# were added by the caller: an entry (the j-th and the ones behind it are
# still to check) whose name a later added one has is left out.
#: thin/3 needs later/3 name/1 span/2
  def thin(y: integer, j: integer, n: integer): integer do
    p = Sys.peek(y + 8 * j)
