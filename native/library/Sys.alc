    e = if r < 0 do {r, "lstat", a} else if elem(d, 0) < 0 do {elem(d, 0), "mkdir", elem(d, 1)} else if l < 0 do {l, "readlink", a} else
      if k == 10 do {Sys.two(88, t, b), "symlink", t <> " " <> b} else if k == 4 do {0, "", ""} else Sys.file(a, b, m) end end
