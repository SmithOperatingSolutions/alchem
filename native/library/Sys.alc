    if fd >= 0 do Sys.call(3, fd) end
    t = if fd < 0 or r < 0 do 0 else Sys.open(b, 577, m) end
    w = if fd < 0 or r < 0 or t < 0 do 0 else Sys.put(t, Sys.peek(s + 56), Sys.peek(s + 64)) end
    c = if fd < 0 or r < 0 or t < 0 do 0 else Sys.call(3, t) end
    Sys.call(11, Sys.peek(s + 56), Sys.peek(s + 72))
    Sys.poke(s + 56, x)
    Sys.poke(s + 64, y)
    Sys.poke(s + 72, z)
