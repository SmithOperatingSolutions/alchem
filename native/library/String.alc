# String: the functions written in Alchem.
#: at/2
  def at(text: string, index: integer): option[string] do
    place = if index < 0 do String.length(text) + index else index end
    if place < 0 or place >= String.length(text) do none else some(String.slice(text, place, 1)) end
  end
#: contains?/2
  def contains?(text: string, parts: list[string]): boolean do
    Enum.reduce(parts, false, fn part, found -> found or String.contains?(text, part) end)
  end
#: starts_with?/2
  def starts_with?(text: string, parts: list[string]): boolean do
    Enum.reduce(parts, false, fn part, found -> found or String.starts_with?(text, part) end)
  end
#: ends_with?/2
  def ends_with?(text: string, parts: list[string]): boolean do
    Enum.reduce(parts, false, fn part, found -> found or String.ends_with?(text, part) end)
  end
#: join/2
  def join(parts: list[string], separator: string): string do
    Enum.join(parts, separator)
  end
#: graphemes/1
# The text is walked once: a grapheme is the first of the bytes it starts
# (String.slice of a window of them), and it ends where it does in the whole
# text once four more bytes, room for the character that decides it, lie in
# the window, or the text ends there; a window too short is doubled.
  def graphemes(text: string): list[string] do
    start: list[string] = Enum.o_room(byte_size(text))
    Enum.o_turn(letters(Sys.addr(text), byte_size(text), 16, start))
  end
  defp letters(a: integer, n: integer, w: integer, done: list[string]): list[string] do
    if n == 0 do done else
      k = if w < n do w else n end
      g = String.slice(Sys.text(a, k), 0, 1)
      s = byte_size(g)
      if k < n and k - s < 4 do letters(a, n, w * 2, done) else letters(a + s, n - s, 16, [g | done]) end
    end
  end
#: next_codepoint/1
  def next_codepoint(text: string): option[tuple[string, string]] do
    if text == "" do none else some(point(text)) end
  end
  defp table(): list[string] do
    ["\x00", "\x01", "\x02", "\x03", "\x04", "\x05", "\x06", "\x07", "\x08", "\x09", "\x0A", "\x0B", "\x0C", "\x0D", "\x0E", "\x0F", "\x10", "\x11", "\x12", "\x13", "\x14", "\x15", "\x16", "\x17", "\x18", "\x19", "\x1A", "\x1B", "\x1C", "\x1D", "\x1E", "\x1F", "\x20", "\x21", "\x22", "\x23", "\x24", "\x25", "\x26", "\x27", "\x28", "\x29", "\x2A", "\x2B", "\x2C", "\x2D", "\x2E", "\x2F", "\x30", "\x31", "\x32", "\x33", "\x34", "\x35", "\x36", "\x37", "\x38", "\x39", "\x3A", "\x3B", "\x3C", "\x3D", "\x3E", "\x3F", "\x40", "\x41", "\x42", "\x43", "\x44", "\x45", "\x46", "\x47", "\x48", "\x49", "\x4A", "\x4B", "\x4C", "\x4D", "\x4E", "\x4F", "\x50", "\x51", "\x52", "\x53", "\x54", "\x55", "\x56", "\x57", "\x58", "\x59", "\x5A", "\x5B", "\x5C", "\x5D", "\x5E", "\x5F", "\x60", "\x61", "\x62", "\x63", "\x64", "\x65", "\x66", "\x67", "\x68", "\x69", "\x6A", "\x6B", "\x6C", "\x6D", "\x6E", "\x6F", "\x70", "\x71", "\x72", "\x73", "\x74", "\x75", "\x76", "\x77", "\x78", "\x79", "\x7A", "\x7B", "\x7C", "\x7D", "\x7E", "\x7F", "\x80", "\x81", "\x82", "\x83", "\x84", "\x85", "\x86", "\x87", "\x88", "\x89", "\x8A", "\x8B", "\x8C", "\x8D", "\x8E", "\x8F", "\x90", "\x91", "\x92", "\x93", "\x94", "\x95", "\x96", "\x97", "\x98", "\x99", "\x9A", "\x9B", "\x9C", "\x9D", "\x9E", "\x9F", "\xA0", "\xA1", "\xA2", "\xA3", "\xA4", "\xA5", "\xA6", "\xA7", "\xA8", "\xA9", "\xAA", "\xAB", "\xAC", "\xAD", "\xAE", "\xAF", "\xB0", "\xB1", "\xB2", "\xB3", "\xB4", "\xB5", "\xB6", "\xB7", "\xB8", "\xB9", "\xBA", "\xBB", "\xBC", "\xBD", "\xBE", "\xBF", "\xC0", "\xC1", "\xC2", "\xC3", "\xC4", "\xC5", "\xC6", "\xC7", "\xC8", "\xC9", "\xCA", "\xCB", "\xCC", "\xCD", "\xCE", "\xCF", "\xD0", "\xD1", "\xD2", "\xD3", "\xD4", "\xD5", "\xD6", "\xD7", "\xD8", "\xD9", "\xDA", "\xDB", "\xDC", "\xDD", "\xDE", "\xDF", "\xE0", "\xE1", "\xE2", "\xE3", "\xE4", "\xE5", "\xE6", "\xE7", "\xE8", "\xE9", "\xEA", "\xEB", "\xEC", "\xED", "\xEE", "\xEF", "\xF0", "\xF1", "\xF2", "\xF3", "\xF4", "\xF5", "\xF6", "\xF7", "\xF8", "\xF9", "\xFA", "\xFB", "\xFC", "\xFD", "\xFE", "\xFF"]
  end
  defp lead(text: string, table: list[string], low: integer, high: integer): integer do
    if low >= high do low else
      mid = (low + high + 1) / 2
      if Enum.at(table, mid, "") <= text do lead(text, table, mid, high) else lead(text, table, low, mid - 1) end
    end
  end
  defp after(text: string, part: string): string do
    Enum.join(tl(String.split(text, part)), part)
  end
  defp point(text: string): tuple[string, string] do
    table = table()
    v = lead(text, table, 0, 255)
    b = Enum.at(table, v, "")
    rest = after(text, b)
    need = if v >= 194 and v <= 223 do 1 else if v >= 224 and v <= 239 do 2 else if v >= 240 and v <= 244 do 3 else 0 end end end
    low = if v == 224 do 160 else if v == 240 do 144 else 128 end end
    high = if v == 237 do 159 else if v == 244 do 143 else 191 end end
    if need == 0 do {b, rest} else
      case more(rest, table, need, {low, high}, b) do
        some(found) -> found
        none -> {b, rest}
      end
    end
  end
  defp more(text: string, table: list[string], need: integer, bounds: tuple[integer, integer], done: string): option[tuple[string, string]] do
    if need == 0 do some({done, text}) else
      if text == "" do none else
        v = lead(text, table, 0, 255)
        if v < elem(bounds, 0) or v > elem(bounds, 1) do none else
          b = Enum.at(table, v, "")
          more(after(text, b), table, need - 1, {128, 191}, done <> b)
        end
      end
    end
  end
#: codepoints/1 needs Sys.rune/2
# The characters as Go decodes them, a byte that starts none as U+FFFD.
  def codepoints(text: string): list[string] do
    start: list[string] = Enum.o_room(byte_size(text))
    Enum.o_turn(pieces(Sys.addr(text), byte_size(text), start))
  end
  defp pieces(a: integer, n: integer, done: list[string]): list[string] do
    if n == 0 do done else
      v = Sys.rune(a, n)
      w = if v == 0 do 1 else div(v, 2097152) end
      pieces(a + w, n - w, [if v == 0 or v == 2162685 do "\uFFFD" else Sys.text(a, w) end | done])
    end
  end
#: split_at/2 needs codepoints/1
  def split_at(text: string, index: integer): tuple[string, string] do
    points = String.codepoints(text)
    count = length(points)
    place = if index < 0 do max(count + index, 0) else min(index, count) end
    {Enum.join(Enum.take(points, place), ""), Enum.join(Enum.drop(points, place), "")}
  end
#: next_grapheme/1
  def next_grapheme(text: string): option[tuple[string, string]] do
    if text == "" do none else
      first = String.slice(text, 0, 1)
      some({first, Enum.join(tl(String.split(text, first)), first)})
    end
  end
#: trim_leading/2
  def trim_leading(text: string, part: string): string do
    if part == "" do text else
      pieces = String.split(text, part)
      Enum.join(Enum.drop(pieces, min(blanks(pieces, 0), length(pieces) - 1)), part)
    end
  end
  defp blanks(pieces: list[string], index: integer): integer do
    if Enum.at(pieces, index, "x") == "" do blanks(pieces, index + 1) else index end
  end
#: trim_trailing/2
  def trim_trailing(text: string, part: string): string do
    if part == "" do text else ended(text, part) end
  end
  defp ended(text: string, part: string): string do
    if String.ends_with?(text, part) do ended(chopt(text, part), part) else text end
  end
  defp tablet(): list[string] do
    ["\x00", "\x01", "\x02", "\x03", "\x04", "\x05", "\x06", "\x07", "\x08", "\x09", "\x0A", "\x0B", "\x0C", "\x0D", "\x0E", "\x0F", "\x10", "\x11", "\x12", "\x13", "\x14", "\x15", "\x16", "\x17", "\x18", "\x19", "\x1A", "\x1B", "\x1C", "\x1D", "\x1E", "\x1F", "\x20", "\x21", "\x22", "\x23", "\x24", "\x25", "\x26", "\x27", "\x28", "\x29", "\x2A", "\x2B", "\x2C", "\x2D", "\x2E", "\x2F", "\x30", "\x31", "\x32", "\x33", "\x34", "\x35", "\x36", "\x37", "\x38", "\x39", "\x3A", "\x3B", "\x3C", "\x3D", "\x3E", "\x3F", "\x40", "\x41", "\x42", "\x43", "\x44", "\x45", "\x46", "\x47", "\x48", "\x49", "\x4A", "\x4B", "\x4C", "\x4D", "\x4E", "\x4F", "\x50", "\x51", "\x52", "\x53", "\x54", "\x55", "\x56", "\x57", "\x58", "\x59", "\x5A", "\x5B", "\x5C", "\x5D", "\x5E", "\x5F", "\x60", "\x61", "\x62", "\x63", "\x64", "\x65", "\x66", "\x67", "\x68", "\x69", "\x6A", "\x6B", "\x6C", "\x6D", "\x6E", "\x6F", "\x70", "\x71", "\x72", "\x73", "\x74", "\x75", "\x76", "\x77", "\x78", "\x79", "\x7A", "\x7B", "\x7C", "\x7D", "\x7E", "\x7F", "\x80", "\x81", "\x82", "\x83", "\x84", "\x85", "\x86", "\x87", "\x88", "\x89", "\x8A", "\x8B", "\x8C", "\x8D", "\x8E", "\x8F", "\x90", "\x91", "\x92", "\x93", "\x94", "\x95", "\x96", "\x97", "\x98", "\x99", "\x9A", "\x9B", "\x9C", "\x9D", "\x9E", "\x9F", "\xA0", "\xA1", "\xA2", "\xA3", "\xA4", "\xA5", "\xA6", "\xA7", "\xA8", "\xA9", "\xAA", "\xAB", "\xAC", "\xAD", "\xAE", "\xAF", "\xB0", "\xB1", "\xB2", "\xB3", "\xB4", "\xB5", "\xB6", "\xB7", "\xB8", "\xB9", "\xBA", "\xBB", "\xBC", "\xBD", "\xBE", "\xBF", "\xC0", "\xC1", "\xC2", "\xC3", "\xC4", "\xC5", "\xC6", "\xC7", "\xC8", "\xC9", "\xCA", "\xCB", "\xCC", "\xCD", "\xCE", "\xCF", "\xD0", "\xD1", "\xD2", "\xD3", "\xD4", "\xD5", "\xD6", "\xD7", "\xD8", "\xD9", "\xDA", "\xDB", "\xDC", "\xDD", "\xDE", "\xDF", "\xE0", "\xE1", "\xE2", "\xE3", "\xE4", "\xE5", "\xE6", "\xE7", "\xE8", "\xE9", "\xEA", "\xEB", "\xEC", "\xED", "\xEE", "\xEF", "\xF0", "\xF1", "\xF2", "\xF3", "\xF4", "\xF5", "\xF6", "\xF7", "\xF8", "\xF9", "\xFA", "\xFB", "\xFC", "\xFD", "\xFE", "\xFF"]
  end
  defp leadt(text: string, table: list[string], low: integer, high: integer): integer do
    if low >= high do low else
      mid = (low + high + 1) / 2
      if Enum.at(table, mid, "") <= text do leadt(text, table, mid, high) else leadt(text, table, low, mid - 1) end
    end
  end
  defp aftert(text: string, part: string): string do
    Enum.join(tl(String.split(text, part)), part)
  end
  defp frontt(text: string, count: integer, table: list[string], done: string): tuple[string, string] do
    if count <= 0 do {done, text} else
      b = Enum.at(table, leadt(text, table, 0, 255), "")
      frontt(aftert(text, b), count - 1, table, done <> b)
    end
  end
  defp cutt(text: string, count: integer): tuple[string, string] do
    head = String.slice(text, 0, count)
    if count <= 0 do {"", text} else if byte_size(head) == count do {head, aftert(text, head)} else frontt(text, count, tablet(), "") end end
  end
  defp chopt(text: string, part: string): string do
    head = String.slice(text, 0, String.length(text) - String.length(part))
    if head <> part == text do head else elem(cutt(text, byte_size(text) - byte_size(part)), 0) end
  end
#: trim/2 needs trim_leading/2 trim_trailing/2
  def trim(text: string, part: string): string do
    String.trim_trailing(String.trim_leading(text, part), part)
  end
#: replace_prefix/3
  def replace_prefix(text: string, prefix: string, by0: string): string do
    if prefix == "" do by0 <> text else
      if String.starts_with?(text, prefix) do by0 <> Enum.join(tl(String.split(text, prefix)), prefix) else text end
    end
  end
#: replace_suffix/3
  def replace_suffix(text: string, suffix: string, by0: string): string do
    if suffix != "" and String.ends_with?(text, suffix) do chops(text, suffix) <> by0 else if suffix == "" do text <> by0 else text end end
  end
  defp tables(): list[string] do
    ["\x00", "\x01", "\x02", "\x03", "\x04", "\x05", "\x06", "\x07", "\x08", "\x09", "\x0A", "\x0B", "\x0C", "\x0D", "\x0E", "\x0F", "\x10", "\x11", "\x12", "\x13", "\x14", "\x15", "\x16", "\x17", "\x18", "\x19", "\x1A", "\x1B", "\x1C", "\x1D", "\x1E", "\x1F", "\x20", "\x21", "\x22", "\x23", "\x24", "\x25", "\x26", "\x27", "\x28", "\x29", "\x2A", "\x2B", "\x2C", "\x2D", "\x2E", "\x2F", "\x30", "\x31", "\x32", "\x33", "\x34", "\x35", "\x36", "\x37", "\x38", "\x39", "\x3A", "\x3B", "\x3C", "\x3D", "\x3E", "\x3F", "\x40", "\x41", "\x42", "\x43", "\x44", "\x45", "\x46", "\x47", "\x48", "\x49", "\x4A", "\x4B", "\x4C", "\x4D", "\x4E", "\x4F", "\x50", "\x51", "\x52", "\x53", "\x54", "\x55", "\x56", "\x57", "\x58", "\x59", "\x5A", "\x5B", "\x5C", "\x5D", "\x5E", "\x5F", "\x60", "\x61", "\x62", "\x63", "\x64", "\x65", "\x66", "\x67", "\x68", "\x69", "\x6A", "\x6B", "\x6C", "\x6D", "\x6E", "\x6F", "\x70", "\x71", "\x72", "\x73", "\x74", "\x75", "\x76", "\x77", "\x78", "\x79", "\x7A", "\x7B", "\x7C", "\x7D", "\x7E", "\x7F", "\x80", "\x81", "\x82", "\x83", "\x84", "\x85", "\x86", "\x87", "\x88", "\x89", "\x8A", "\x8B", "\x8C", "\x8D", "\x8E", "\x8F", "\x90", "\x91", "\x92", "\x93", "\x94", "\x95", "\x96", "\x97", "\x98", "\x99", "\x9A", "\x9B", "\x9C", "\x9D", "\x9E", "\x9F", "\xA0", "\xA1", "\xA2", "\xA3", "\xA4", "\xA5", "\xA6", "\xA7", "\xA8", "\xA9", "\xAA", "\xAB", "\xAC", "\xAD", "\xAE", "\xAF", "\xB0", "\xB1", "\xB2", "\xB3", "\xB4", "\xB5", "\xB6", "\xB7", "\xB8", "\xB9", "\xBA", "\xBB", "\xBC", "\xBD", "\xBE", "\xBF", "\xC0", "\xC1", "\xC2", "\xC3", "\xC4", "\xC5", "\xC6", "\xC7", "\xC8", "\xC9", "\xCA", "\xCB", "\xCC", "\xCD", "\xCE", "\xCF", "\xD0", "\xD1", "\xD2", "\xD3", "\xD4", "\xD5", "\xD6", "\xD7", "\xD8", "\xD9", "\xDA", "\xDB", "\xDC", "\xDD", "\xDE", "\xDF", "\xE0", "\xE1", "\xE2", "\xE3", "\xE4", "\xE5", "\xE6", "\xE7", "\xE8", "\xE9", "\xEA", "\xEB", "\xEC", "\xED", "\xEE", "\xEF", "\xF0", "\xF1", "\xF2", "\xF3", "\xF4", "\xF5", "\xF6", "\xF7", "\xF8", "\xF9", "\xFA", "\xFB", "\xFC", "\xFD", "\xFE", "\xFF"]
  end
  defp leads(text: string, table: list[string], low: integer, high: integer): integer do
    if low >= high do low else
      mid = (low + high + 1) / 2
      if Enum.at(table, mid, "") <= text do leads(text, table, mid, high) else leads(text, table, low, mid - 1) end
    end
  end
  defp afters(text: string, part: string): string do
    Enum.join(tl(String.split(text, part)), part)
  end
  defp fronts(text: string, count: integer, table: list[string], done: string): tuple[string, string] do
    if count <= 0 do {done, text} else
      b = Enum.at(table, leads(text, table, 0, 255), "")
      fronts(afters(text, b), count - 1, table, done <> b)
    end
  end
  defp cuts(text: string, count: integer): tuple[string, string] do
    head = String.slice(text, 0, count)
    if count <= 0 do {"", text} else if byte_size(head) == count do {head, afters(text, head)} else fronts(text, count, tables(), "") end end
  end
  defp chops(text: string, part: string): string do
    head = String.slice(text, 0, String.length(text) - String.length(part))
    if head <> part == text do head else elem(cuts(text, byte_size(text) - byte_size(part)), 0) end
  end
#: replace_leading/3 needs trim_leading/2
  def replace_leading(text: string, part: string, by0: string): string do
    if part == "" do text else
      rest = String.trim_leading(text, part)
      String.duplicate(by0, (byte_size(text) - byte_size(rest)) / byte_size(part)) <> rest
    end
  end
#: replace_trailing/3 needs trim_trailing/2
  def replace_trailing(text: string, part: string, by0: string): string do
    if part == "" do text else
      rest = String.trim_trailing(text, part)
      rest <> String.duplicate(by0, (byte_size(text) - byte_size(rest)) / byte_size(part))
    end
  end
#: split/1
# The pieces between runs of white space, as Go's strings.Fields: the text
# is walked once, a byte at a time. o is where the piece being read starts,
# -1 between pieces.
  def split(text: string): list[string] do
    fields(Sys.addr(text), byte_size(text), 0, -1, [])
  end
  defp fields(a: integer, n: integer, i: integer, o: integer, done: list[string]): list[string] do
    if i >= n do Enum.o_turn(if o < 0 do done else [Sys.text(a + o, n - o) | done] end) else
      c = Sys.byte(a + i)
      w = if c < 128 do (if c == 32 or (c > 8 and c < 14) do 1 else 0 end) else space(c, a + i) end
      if w == 0 do fields(a, n, i + 1, (if o < 0 do i else o end), done) else
        fields(a, n, i + w, -1, if o < 0 do done else [Sys.text(a + o, i - o) | done] end)
      end
    end
  end
# The bytes of the white space character at address p, whose first byte is
# c; 0 for any other: U+0085, U+00A0, U+1680, U+2000 to U+200A, U+2028,
# U+2029, U+202F, U+205F and U+3000.
  defp space(c: integer, p: integer): integer do
    cond do
      c == 194 -> if Sys.byte(p + 1) == 133 or Sys.byte(p + 1) == 160 do 2 else 0 end
      c == 225 -> if Sys.byte(p + 1) == 154 and Sys.byte(p + 2) == 128 do 3 else 0 end
      c == 226 -> space2(Sys.byte(p + 1), Sys.byte(p + 2))
      c == 227 -> if Sys.byte(p + 1) == 128 and Sys.byte(p + 2) == 128 do 3 else 0 end
      true -> 0
    end
  end
  defp space2(d: integer, e: integer): integer do
    if (d == 128 and ((e > 127 and e < 139) or e == 168 or e == 169 or e == 175)) or (d == 129 and e == 159) do 3 else 0 end
  end
#: printable?/1
  def printable?(text: string): boolean do
    plain = String.replace(String.replace(String.replace(text, "\n", ""), "\t", ""), "\r", "")
    case Integer.parse(plain) do
      ok(number) -> true
      error(message) -> message == "\"" <> String.replace(String.replace(plain, "\\", "\\\\"), "\"", "\\\"") <> "\" is not an integer"
    end
  end
#: splitter/2 needs Stream.__of/1
  def splitter(text: string, patterns: list[string]): stream[string] do
    if "" in patterns do raise("String.splitter needs patterns that are not empty") end
    Stream.__of(pieced(text, patterns, []))
  end
  defp pieced(text: string, patterns: list[string], done: list[string]): list[string] do
    best = Enum.reduce(patterns, {-1, ""}, fn pattern, acc ->
      if String.contains?(text, pattern) do
        at = byte_size(hd(String.split(text, pattern)))
        if elem(acc, 0) < 0 or at < elem(acc, 0) do {at, pattern} else acc end
      else acc end
    end)
    if elem(best, 0) < 0 do Enum.o_turn([text | done]) else
      pieces = String.split(text, elem(best, 1))
      pieced(Enum.join(tl(pieces), elem(best, 1)), patterns, [hd(pieces) | done])
    end
  end
#: splitter/2 form 2 needs Stream.__of/1
  def splitter(text: string, pattern: string): stream[string] do
    Stream.__of(String.split(text, pattern))
  end
#: slice/2 needs graphemes/1 Enum.slice/2
  def slice(text: string, r: Range): string do
    Enum.join(Enum.slice(String.graphemes(text), r))
  end
#: myers_difference/2 needs graphemes/1 List.myers_difference/2
  def myers_difference(l: string, r: string): list[tuple[atom, string]] do
    Enum.map(List.myers_difference(String.graphemes(l), String.graphemes(r)), fn x -> {elem(x, 0), Enum.join(elem(x, 1))} end)
  end
#: split/3
  def split(t: string, sep: string, o: list[tuple[atom, integer]]): list[string] do
    if sep == "" do raise("separator must not be empty") end
    n = Enum.reduce(o, -1, fn p, z ->
      if elem(p, 0) != :parts do raise("String.split: unknown option :#{elem(p, 0)}; it takes parts: n or trim: true") end
      if elem(p, 1) < 1 do raise("String.split: parts: must be at least 1") end
      elem(p, 1)
    end)
    a = String.split(t, sep)
    if n < 0 or length(a) <= n do a else Enum.take(a, n - 1) ++ [Enum.join(Enum.drop(a, n - 1), sep)] end
  end
#: split/3 form 2
  def split(t: string, sep: string, o: list[tuple[atom, boolean]]): list[string] do
    if sep == "" do raise("separator must not be empty") end
    trim = Enum.reduce(o, false, fn p, z ->
      if elem(p, 0) != :trim do raise("String.split: unknown option :#{elem(p, 0)}; it takes parts: n or trim: true") end
      elem(p, 1)
    end)
    a = String.split(t, sep)
    if trim do Enum.filter(a, fn x -> x != "" end) else a end
  end
#: slice/2 form 2 needs graphemes/1 Enum.take_every/2
  def slice(t: string, r: Range): string do
    n = String.length(t)
    f = if r.first < 0 do r.first + n else r.first end
    l = if r.last < 0 do r.last + n else r.last end
    s = if r.step == -1 do 1 else r.step end
    if s < 0 or f < 0 or f >= n or l < f do "" else
      p = String.slice(t, f, min(l, n - 1) - f + 1)
      if s == 1 do p else Enum.join(Enum.take_every(String.graphemes(p), s), "") end
    end
  end
#: myers_difference/2 form 2 needs graphemes/1 List.myers_difference/2
  def myers_difference(a: string, b: string): list[tuple[atom, string]] do
    Enum.map(List.myers_difference(String.graphemes(a), String.graphemes(b)), fn p -> {elem(p, 0), Enum.join(elem(p, 1), "")} end)
  end
# The case functions with a mode: :default, :ascii (a to z alone), :turkic
# (dotted and dotless i) or :greek (the final sigma, told by the letters that
# have two cases).
#: cased/2 needs graphemes/1
  defp cased(s: string, m: atom, up: boolean): string do
    if not (m in [:default, :ascii, :greek, :turkic]) do raise("the case mode is :default, :ascii, :greek or :turkic, not :#{m}") end
    k = m
    cond do
      k == :ascii -> Enum.reduce(String.graphemes("abcdefghijklmnopqrstuvwxyz"), s, fn c, t -> if up do String.replace(t, c, String.upcase(c)) else String.replace(t, String.upcase(c), c) end end)
      k == :turkic -> if up do String.upcase(String.replace(s, "i", "İ")) else String.downcase(String.replace(String.replace(s, "I", "ı"), "İ", "i")) end
      up -> String.upcase(s)
      k == :greek -> sigma(String.split(String.downcase(s), "σ"))
      true -> String.downcase(s)
    end
  end
  defp sigma(p: list[string]): string do
    elem(Enum.reduce(tl(p), {hd(p), hd(p), 1}, fn q, a ->
      l = elem(a, 1)
      b = if l == "" do (if elem(a, 2) > 1 do "σ" else "" end) else String.slice(l, String.length(l) - 1, 1) end
      c = if q == "" and elem(a, 2) < length(p) - 1 do "σ" else String.slice(q, 0, 1) end
      {elem(a, 0) <> (if String.upcase(b) != String.downcase(b) and String.upcase(c) == String.downcase(c) do "ς" else "σ" end) <> q, q, elem(a, 2) + 1}
    end), 0)
  end
#: upcase/2 needs cased/2
  def upcase(s: string, m: atom): string do
    cased(s, m, true)
  end
#: downcase/2 needs cased/2
  def downcase(s: string, m: atom): string do
    cased(s, m, false)
  end
#: capitalize/2 needs cased/2
  def capitalize(s: string, m: atom): string do
    f = String.slice(s, 0, 1)
    r = cased(String.slice(s, 1, String.length(s)), if s == "" do :ascii else m end, false)
    if m == :default or m == :greek do String.capitalize(f) <> r else cased(f, if s == "" do :ascii else m end, true) <> r end
  end
#: jaro_distance/2 needs graphemes/1 Enum.o_sort/2 Enum.zip/2
  def jaro_distance(a: string, b: string): float do
    x = String.graphemes(a)
    y = String.graphemes(b)
    n = length(x)
    m = length(y)
    w = max(div(max(n, m), 2) - 1, 0)
    e: list[integer] = []
    if n == 0 or m == 0 do if n == m do 1.0 else 0.0 end else
      s = Enum.reduce(x, {0, e, e}, fn g, s ->
        i = elem(s, 0)
        j = jf(g, y, elem(s, 2), max(0, i - w), min(m, i + w + 1))
        if j < 0 do {i + 1, elem(s, 1), elem(s, 2)} else {i + 1, [i | elem(s, 1)], [j | elem(s, 2)]} end
      end)
      c = Float.from_integer(length(elem(s, 1)))
      t = Enum.sum(Enum.map(Enum.zip(Enum.o_turn(elem(s, 1)), Enum.o_sort(elem(s, 2), fn p, q -> p < q end)), fn p -> if Enum.at(x, elem(p, 0), "") != Enum.at(y, elem(p, 1), "") do 1 else 0 end end))
      if c == 0.0 do 0.0 else (c / Float.from_integer(n) + c / Float.from_integer(m) + (c - Float.from_integer(div(t, 2))) / c) / 3.0 end
    end
  end
  defp jf(g: string, y: list[string], u: list[integer], j: integer, e: integer): integer do
    if j >= e do -1 else if not (j in u) and Enum.at(y, j, "") == g do j else jf(g, y, u, j + 1, e) end end
  end
# The forms that take a regular expression (library/Regex.alc); text =~
# pattern is match?.
#: match?/2 form 16 needs Regex.match?/2
  def match?(text: string, pattern: regex): boolean do
    Regex.match?(pattern, text)
  end
#: replace/3 form 14 needs Regex.replace/3
  def replace(text: string, pattern: regex, replacement: string): string do
    Regex.replace(pattern, text, replacement)
  end
#: replace/3 form 15 needs Regex.replace/3
  def replace(text: string, pattern: regex, f: fn[string, string]): string do
    Regex.replace(pattern, text, f)
  end
#: replace/3 form 16 needs Regex.replace/3
  def replace(text: string, pattern: regex, f: fn[list[string], string]): string do
    Regex.replace(pattern, text, f)
  end
#: split/2 form 16 needs Regex.split/2
  def split(text: string, pattern: regex): list[string] do
    Regex.split(pattern, text)
  end
#: split/3 form 15 needs Regex.rx_split/2
  def split(t: string, pattern: regex, o: list[tuple[atom, integer]]): list[string] do
    n = Enum.reduce(o, -1, fn p, z ->
      if elem(p, 0) != :parts do raise("String.split: unknown option :#{elem(p, 0)}; it takes parts: n or trim: true") end
      if elem(p, 1) < 1 do raise("String.split: parts: must be at least 1") end
      elem(p, 1)
    end)
    Regex.rx_split(rx_ab(pattern), {rx_ab(t), n})
  end
#: split/3 form 16 needs Regex.split/2
  def split(t: string, pattern: regex, o: list[tuple[atom, boolean]]): list[string] do
    trim = Enum.reduce(o, false, fn p, z ->
      if elem(p, 0) != :trim do raise("String.split: unknown option :#{elem(p, 0)}; it takes parts: n or trim: true") end
      elem(p, 1)
    end)
    a = Regex.split(pattern, t)
    if trim do Enum.filter(a, fn x -> x != "" end) else a end
  end
# String.normalize: generated by scripts/generate-normalization.py from the pinned runtime's tables (Unicode 17.0.0); do not edit below.
#: normalize/2 needs Sys.rune/2 Sys.pad/0 Sys.push/2 Sys.got/0 Enum.sort_by/2 Enum.reverse/1
  def normalize(text: string, form: atom): string do
    mode = if form == :nfd do 0 else if form == :nfc do 1 else if form == :nfkd do 2 else if form == :nfkc do 3 else raise("String.normalize takes :nfc, :nfd, :nfkc or :nfkd") end end end end
    if nm_simple(Sys.addr(text), byte_size(text)) do text else
      none: list[integer] = []
      runes = nm_ordered(nm_runes(Sys.addr(text), byte_size(text), mode / 2, none))
      made = if mode % 2 == 1 do nm_composed(runes) else runes end
      s = Sys.pad()
      nm_text(made)
    end
  end
  # true for text that is ASCII with no carriage return, which is returned as it is.
  defp nm_simple(a: integer, n: integer): boolean do
    if n == 0 do true else
      b = Sys.byte(a)
      if b >= 128 or b == 13 do false else nm_simple(a + 1, n - 1) end
    end
  end
  # The value of n digits of six bits at a.
  defp nm_hex(a: integer, n: integer, v: integer): integer do
    if n == 0 do v else
