# System: the functions written in Alchem on the Sys primitives
# (spec/alchem-system.md). argv, get_env, halt, stop, pid and system_time
# and os_time without a unit are the compiler's own.
#: cwd!/0 needs File.cwd!/0
  def cwd!(): string do
    File.cwd!()
  end
#: env/1
  def env(n: string): option[string] do
    System.get_env(n)
  end
# os.UserHomeDir: HOME, or USERPROFILE on Windows.
#: user_home/0 needs Path._whome/0 Path._wslash/1
  def user_home(): option[string] do
    h = if Sys.windows() == 1 do Path._wslash(Path._whome()) else System.get_env("HOME", "") end
    if h == "" do none else some(h) end
  end
#: tmp_dir/0 needs tmp_dir!/0 _wtmp/0
  def tmp_dir(): option[string] do
    if Sys.windows() == 1 do
      d = System._wtmp()
      if d == "" do none else some(d) end
    else
      some(System.tmp_dir!())
    end
  end
#: tmp_dir!/0 needs _wtmp/0
  def tmp_dir!(): string do
    if Sys.windows() == 1 do
      d = System._wtmp()
      if d == "" do raise("no directory for temporary files") else d end
    else
      d = System.get_env("TMPDIR", "")
      if d == "" do "/tmp" else d end
    end
  end
# os.TempDir on Windows (GetTempPathW: pseudo call 1000103 of the Windows
# layer, spec/windows.md), with / for \.
#: _wtmp/0 needs Path._wslash/1
  def _wtmp(): string do
    r = Sys.call(1000103)
    if r <= 0 do "" else Path._wslash(Sys.text(r, Sys.len(r))) end
  end
#: find_executable/1 needs Sys.exe/1 Sys.which/1
  def find_executable(f: string): option[string] do
    w = if String.contains?(f, "/") do {if Sys.exe(f) do 0 else 2 end, f} else Sys.which(f) end
    if elem(w, 0) == 0 do some(elem(w, 1)) else none end
  end
# os.Setenv.
#: put_env/2 needs Sys.env/0 Sys.held/4 Sys.z/1
  def put_env(k: string, v: string): tuple[] do
    t = k <> "=" <> v
    if k == "" or String.contains?(k, "=") or Sys.z(t) == 0 do raise("could not set " <> k <> ": setenv: invalid argument") end
    s = Sys.env()
    n = Sys.peek(s + 8)
    i = Sys.held(Sys.peek(s), n, Sys.addr(t), byte_size(k) + 1)
    if i < 0 and n + 2 > Sys.peek(s + 16) do
      Sys.poke(s, Sys.call(25, Sys.peek(s), Sys.peek(s + 16) * 8, Sys.peek(s + 16) * 16, 1))
      Sys.poke(s + 16, Sys.peek(s + 16) * 2)
    end
    if i < 0 do Sys.poke(s + 8, n + 1) end
    Sys.poke(Sys.peek(s) + 8 * (if i < 0 do n + 1 else n end), 0)
    Sys.poke(Sys.peek(s) + 8 * (if i < 0 do n else i end), Sys.z(t))
    {}
  end
# Nanoseconds since the program started, as the pinned runtime counts them.
# The start is worked out at the first call (_since) and kept.
#: monotonic_time/0 needs Sys.state/0 _since/0
  def monotonic_time(): integer do
    s = Sys.state()
    Sys.call(228, 1, s + 512)
    t = Sys.peek(s + 512) * 1000000000 + Sys.peek(s + 520)
    if Sys.peek(s + 24) == 0 do Sys.poke(s + 24, t - System._since()) end
    t - Sys.peek(s + 24)
  end
# How long the program has run, in nanoseconds: the time since the system
# started less the time the process started at, which /proc/self/stat has
# in hundredths of a second (its 22nd field); never less than the processor
# time the program has used, which stands in where /proc cannot be read.
#: _since/0 needs Sys.state/0
  def _since(): integer do
    s = Sys.state()
    Sys.call(228, 7, s + 512)
    up = Sys.peek(s + 512) * 1000000000 + Sys.peek(s + 520)
    Sys.call(228, 2, s + 512)
    used = Sys.peek(s + 512) * 1000000000 + Sys.peek(s + 520)
    ticks = case File.read("/proc/self/stat") do
      ok(text) ->
        fields = String.split(List.last(String.split(text, ") "), ""), " ")
        case Integer.parse(Enum.at(fields, 19, "")) do
          ok(n) -> n
          error(e) -> -1
        end
      error(e) -> -1
    end
    since = if ticks < 0 do used else up - ticks * 10000000 end
    max(max(since, used), 1000)
  end
#: monotonic_time/1 needs monotonic_time/0 unit/2
  def monotonic_time(u: atom): integer do
    System.unit(System.monotonic_time(), u)
  end
#: system_time/1 exact needs unit/2
  def system_time(u: atom): integer do
    System.unit(System.system_time(), u)
  end
#: os_time/1 exact needs unit/2
  def os_time(u: atom): integer do
    System.unit(System.system_time(), u)
  end
#: unit/2
  def unit(t: integer, u: atom): integer do
    if u == :second do div(t, 1000000000) else if u == :millisecond do div(t, 1000000) else if u == :microsecond do div(t, 1000) else
      if u == :nanosecond or u == :native do t else raise("the time unit is :second, :millisecond, :microsecond, :nanosecond or :native, not :#{u}") end
    end end end
  end
#: convert_time_unit/3
  def convert_time_unit(n: integer, a: atom, b: atom): integer do
    x = convert_per(a)
    y = convert_per(b)
    if x >= y do n * div(x, y) else div(n, div(y, x)) end
  end
  defp convert_per(u: atom): integer do
    if u == :second do 1000000000 else if u == :millisecond do 1000000 else if u == :microsecond do 1000 else
      if u == :nanosecond or u == :native do 1 else raise("the time units are :second, :millisecond, :microsecond, :nanosecond or :native") end
    end end end
  end
# The program's memory, from the collector's words below the initial stack
# pointer (alchem-memory.md, spec/memory-x86_64.s): the arena every value
# comes from is reserved, not held. held is the arena up to the highest
# address in use, in pages, with the library's block of 16384 bytes and a
# page; idle is what of that lies in free ranges; in_use is the rest (the
# stacks are not counted); collections counts the collections that ran,
# and in a program that cannot collect the calls of collect_garbage.
#: memory/0 needs Sys.state/0
  def memory(): map[atom, integer] do
    g = Sys.stack() - 1536
    on = Sys.peek(g + 176)
    t = if on == 0 do Sys.top() - (Sys.limit() - Sys.peek(Sys.limit())) else
      if Sys.peek(g) != 0 and Sys.peek(g + 48) == 1 do Sys.top() - Sys.peek(g + 16) else Sys.peek(g + 32) - Sys.peek(g + 16) end
    end
    f = if on == 0 do 0 else Sys.peek(g + 208) end
    h = (t + 4095) / 4096 * 4096 + 20480
    Map.new([{:in_use, t - f + 16384}, {:held, h}, {:idle, h - t + f - 16384}, {:stacks, 0}, {:collections, Sys.peek(Sys.state() + 32) + (if on == 0 do 0 else Sys.peek(g + 168) end)}])
  end
# A collection, now (the collector answers a system call of this number).
#: collect_garbage/0 needs Sys.state/0
  def collect_garbage(): tuple[] do
    if Sys.peek(Sys.stack() - 1360) == 0 do Sys.poke(Sys.state() + 32, Sys.peek(Sys.state() + 32) + 1) else Sys.call(1000001) end
    {}
  end
#: cmd/2 needs cmd/3
  def cmd(c: string, a: list[string]): tuple[string, integer] do
    System.cmd(c, a, [])
  end
# exec.Command(c, a...) with its output collected, as upstream runs it.
#: cmd/3 needs Enum.any?/2 Sys.abs/1 Sys.env/0 Sys.fail/3 Sys.got/0 Sys.keep/2 Sys.load/1 Sys.pad/0 Sys.push/2 Sys.spawn/5 Sys.stat/2 Sys.thin/3 Sys.wait/4 Sys.which/1 Sys.z/1
  def cmd(c: string, a: list[string], o: list[tuple[atom, string]]): tuple[string, integer] do
    none: list[string] = []
    v = Enum.reduce(o, {"", none, 0, 0}, fn x, v ->
      if elem(x, 0) == :cd do {elem(x, 1), elem(v, 1), elem(v, 2), elem(v, 3)} else
        if elem(x, 0) == :env do
          if String.contains?(elem(x, 1), "=") do {elem(v, 0), elem(v, 1) ++ [elem(x, 1)], 1, elem(v, 3)} else raise("System.cmd: env: is \"NAME=value\"") end
        else
          if elem(x, 0) == :stderr_to_stdout do {elem(v, 0), elem(v, 1), elem(v, 2), if elem(x, 1) == "true" do 1 else elem(v, 3) end} else
            raise("System.cmd: unknown option :#{elem(x, 0)}; the options are cd:, env: and stderr_to_stdout:")
          end
        end
      end
    end)
    d = elem(v, 0)
    w = if c == "" or String.contains?(c, "/") do {0, c} else Sys.which(c) end
    if c == "" do raise("could not run : exec: no command") end
    if elem(w, 0) == 2 do raise("could not run " <> c <> ": exec: " <> inspect(c) <> ": executable file not found in $PATH") end
    if elem(w, 0) == 1 do raise("could not run " <> c <> ": exec: " <> inspect(c) <> ": cannot run executable found relative to current directory") end
    p = if d == "" or elem(v, 2) == 1 do "" else
      case Sys.abs(d) do
        ok(t) -> t
        error(e) -> raise("could not run " <> c <> ": " <> e)
      end
    end
    e = if elem(v, 2) == 1 do elem(v, 1) else if d == "" do none else ["PWD=" <> p] end end
    if Enum.any?(e, fn x -> Sys.z(x) == 0 end) do raise("could not run " <> c <> ": exec: environment variable contains NUL") end
    r = if d == "" do 0 else Sys.stat(d, 1) end
    if r < 0 do raise("could not run " <> c <> ": " <> Sys.fail("chdir", d, r)) end
    g = [c] ++ a
    s = Sys.pad()
    Enum.reduce(g, 0, fn x, i -> Sys.push(Sys.z(x), 8) end)
    Sys.push(0, 8)
    n = Sys.peek(Sys.env() + 8)
    Sys.keep(Sys.peek(s), n * 8)
    Enum.reduce(e, 0, fn x, i -> Sys.push(Sys.addr(x <> "\x00"), 8) end)
    Sys.push(0, 8)
    y = Sys.peek(s + 56) + 8 * length(g) + 8
    if length(e) > 0 do Sys.thin(y, 0, n) end
    z = Sys.z(elem(w, 1))
    f = if z == 0 or Enum.any?(g, fn x -> Sys.z(x) == 0 end) do {-22, 0} else Sys.spawn(z, Sys.peek(s + 56), y, if d == "" do 0 else Sys.z(d) end, elem(v, 3)) end
    if elem(f, 0) < 0 do raise("could not run " <> c <> ": " <> Sys.fail("fork/exec", elem(w, 1), elem(f, 0))) end
    Sys.pad()
    Sys.load(elem(f, 1))
    Sys.call(3, elem(f, 1))
    Sys.wait(61, elem(f, 0), s + 512, 0)
    t = rem(Sys.peek(s + 512), 65536)
    {Sys.got(), if rem(t, 128) == 0 do div(t, 256) else -1 end}
  end
