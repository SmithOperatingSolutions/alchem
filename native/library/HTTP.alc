      j = if i < 29 and Sys.peek(k + 77312 + 8 * (i + 1)) <= d do i + 1 else i end
      if d <= 256 do Sys.poke(k + 97280 + 8 * (d - 1), j) end
      if d > 256 and rem(d - 1, 128) == 0 do Sys.poke(k + 99584 + 8 * div(d - 1, 128), j) end
      HTTP._kdist(k, d + 1, j)
    end
  end
# n bits v are written, the lowest first. w: 0 where the next byte goes, 8
# the bits in hand, 16 how many.
#: _put/3 needs _putout/3
  def _put(w: integer, v: integer, n: integer): integer do
    have = Sys.peek(w + 16)
    HTTP._putout(w, Sys.peek(w + 8) + v * Sys.peek(w - 640 + 8 * have), have + n)
  end
#: _putout/3
  def _putout(w: integer, b: integer, c: integer): integer do
    if c < 8 do
      Sys.poke(w + 8, b)
      Sys.poke(w + 16, c)
    else
      o = Sys.peek(w)
      Sys.poke(o, rem(b, 256))
      Sys.poke(w, o + 1)
      HTTP._putout(w, div(b, 256), c - 8)
    end
  end
# How many bytes at a and b are the same, up to most.
#: _mlen/4
  def _mlen(a: integer, b: integer, l: integer, most: integer): integer do
    if l == most or Sys.byte(a + l) != Sys.byte(b + l) do l else HTTP._mlen(a, b, l + 1, most) end
  end
# The longest run before position i that the bytes at i repeat, looked for
# at the last places the three bytes there were seen: its length times
# 65536 and how far back it is.
#: _best/7 needs _mlen/4
  def _best(k: integer, p: integer, i: integer, n: integer, cand: integer, depth: integer, best: integer): integer do
    if cand < 0 or depth == 0 or i - cand >= 32768 do best else
      most = if n - i > 258 do 258 else n - i end
      l = HTTP._mlen(p + cand, p + i, 0, most)
      better = if l > div(best, 65536) do l * 65536 + i - cand else best end
      next = Sys.peek(k + 393216 + 8 * rem(cand, 32768)) - 1
      if l == most or next >= cand do better else HTTP._best(k, p, i, n, next, depth - 1, better) end
    end
  end
# Position i is entered where its three bytes are looked up: the position
# they were seen at before, or -1.
#: _seen/3
  def _seen(k: integer, p: integer, i: integer): integer do
    h = k + 131072 + 8 * rem(Sys.byte(p + i) * 7919 + Sys.byte(p + i + 1) * 263 + Sys.byte(p + i + 2), 32768)
    was = Sys.peek(h)
    Sys.poke(k + 393216 + 8 * rem(i, 32768), was)
    Sys.poke(h, i + 1)
    was - 1
  end
#: _seens/4 needs _seen/3
  def _seens(k: integer, p: integer, i: integer, e: integer): integer do
    if i >= e do 0 else
      HTTP._seen(k, p, i)
      HTTP._seens(k, p, i + 1, e)
    end
  end
# The n bytes at p from position i on, as literals and repeats in the
# fixed codes.
#: _lz/5 needs _best/7 _put/3 _seen/3 _seens/4
  def _lz(k: integer, w: integer, p: integer, i: integer, n: integer): integer do
    if i >= n do 0 else
      found = if i + 3 > n do 0 else HTTP._best(k, p, i, n, HTTP._seen(k, p, i), 24, 0) end
      len = div(found, 65536)
      if len < 3 do
        c = Sys.byte(p + i)
        HTTP._put(w, Sys.peek(k + 90112 + 8 * c), Sys.peek(k + 92416 + 8 * c))
        HTTP._lz(k, w, p, i + 1, n)
      else
        dist = rem(found, 65536)
        sym = Sys.peek(k + 95232 + 8 * (len - 3))
        HTTP._put(w, Sys.peek(k + 90112 + 8 * sym), Sys.peek(k + 92416 + 8 * sym))
        HTTP._put(w, len - Sys.peek(k + 76800 + 8 * (sym - 257)), Sys.peek(k + 77056 + 8 * (sym - 257)))
        d = if dist <= 256 do Sys.peek(k + 97280 + 8 * (dist - 1)) else Sys.peek(k + 99584 + 8 * div(dist - 1, 128)) end
        HTTP._put(w, Sys.peek(k + 94720 + 8 * d), 5)
        HTTP._put(w, dist - Sys.peek(k + 77312 + 8 * d), Sys.peek(k + 77568 + 8 * d))
        e = if i + len + 3 > n do n - 2 else i + len end
        HTTP._seens(k, p, i + 1, e)
        HTTP._lz(k, w, p, i + len, n)
      end
    end
  end
# RFC 1951: the text as one block of deflate's fixed codes. last 1: it is
# the last block of a stream. last 0: an empty block follows it, up to the
# four bytes 00 00 FF FF that end a message of permessage-deflate and are
# left off.
#: _deflate/2 needs _k/0 _lz/5 _put/3
  def _deflate(text: string, last: integer): string do
    k = HTTP._k()
    w = k + 68224
    n = byte_size(text)
    room = n + div(n, 8) + 64
    m = Sys.call(9, 0, room, 3, 34, -1, 0)
    if m < 0 do System.halt(71) end
    Sys.poke(k + 131072, 0)
    Sys.copy(k + 131080, k + 131072, 262136)
    Sys.poke(w, m)
    Sys.poke(w + 8, 0)
    Sys.poke(w + 16, 0)
    HTTP._put(w, last + 2, 3)
    HTTP._lz(k, w, Sys.addr(text), 0, n)
    HTTP._put(w, 0, 7)
    if last == 0 do HTTP._put(w, 0, 3) end
    HTTP._put(w, 0, 7)
    out = Sys.text(m, Sys.peek(w) - m)
    Sys.call(11, m, room)
    out
  end
# Four bytes of a number, the lowest first.
#: _le32/1 needs TCP._s/0
  def _le32(v: integer): string do
    s = TCP._s() + 256
    Sys.poke(s, v)
    Sys.text(s, 4)
  end
# The text as blocks of deflate that hold it as it is.
#: _stored/2 needs TCP._sub/3 _le32/1
  def _stored(text: string, at: integer): string do
    n = byte_size(text) - at
    k = if n > 65535 do 65535 else n end
    head = (if k == n do "\x01" else "\x00" end) <> TCP._sub(HTTP._le32(k + (65535 - k) * 65536), 0, 4) <> TCP._sub(text, at, k)
    if k == n do head else head <> HTTP._stored(text, at + k) end
  end
# RFC 1952: the text as a gzip file.
#: _gzip/1 needs _deflate/2 _k/0 _le32/1 _stored/2 Sys.crc/3
  def _gzip(text: string): string do
    n = byte_size(text)
    packed = HTTP._deflate(text, 1)
    body = if byte_size(packed) > n + 5 * (div(n, 65535) + 1) do HTTP._stored(text, 0) else packed end
    "\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff" <> body <> HTTP._le32(Sys.crc(Sys.addr(text), n, 0)) <> HTTP._le32(rem(n, 4294967296))
  end
# HTTP.serve_tls: the files named, in their order (httpServeTLSWith).
#: _tlsfiles/2 needs Atom.to_string/1 String.contains?/2 Sys.open/3 TCP._file/1
  def _tlsfiles(files: list[tuple[atom, string]], got: tuple[string, string]): tuple[string, string] do
    case files do
      [{k, v} | rest] ->
        if k != :certfile and k != :keyfile do raise("HTTP.serve_tls: unknown option :" <> Atom.to_string(k) <> "; it takes certfile: and keyfile:") end
        HTTP._tlsfiles(rest, if k == :certfile do {v, elem(got, 1)} else {elem(got, 0), v} end)
      [] -> got
    end
  end
# A connection of a server that speaks TLS makes its handshake, within
# the least of the times the server sets for reading and writing: 1, or 0
# when it failed. A client that speaks plain HTTP is told so, as Go's
# server tells it.
#: _tlsconn/3 needs Enum.member?/2 Process._due/2 Process._g/0 TCP._rawwrite/5 TLS._accept/5
  def _tlsconn(hs: integer, cb: integer, id: tuple[list[string], integer, integer, list[string]]): integer do
    g = Process._g()
    ms = Enum.reduce([Sys.peek(hs + 56), Sys.peek(hs + 32), Sys.peek(hs + 40)], 0, fn v, acc -> if v > 0 and (acc == 0 or v < acc) do v else acc end end)
    {t, why} = TLS._accept(g, cb, if ms == 0 do 0 else Process._due(g, ms) end, id, 0)
    if why == "" do 1 else
      first: string = if Sys.peek(t + 360) == 0 do "" else Process.__any(Sys.peek(t + 360)) end
      if Enum.member?(["GET /", "HEAD ", "POST ", "PUT /", "OPTIO"], first) do
        said = "HTTP/1.0 400 Bad Request\r\n\r\nClient sent an HTTP request to an HTTPS server.\n"
        TCP._rawwrite(g, cb, Sys.addr(said), byte_size(said), Process._due(g, 5000))
      end
      0
    end
  end
#: serve_tls/4 needs Process._g/0 Process._take/2 TLS._keypair/2 _listen/4 _serveopts/2 _tlsconn/3 _tlsfiles/2
  def serve_tls(a: string, f: fn[HTTP.Request, HTTP.Response], files: list[tuple[atom, string]], o: list[tuple[atom, integer]]): result[http_server, string] do
    {cert, key} = HTTP._tlsfiles(files, {"", ""})
    {id, why} = TLS._keypair(cert, key)
    if why != "" do error(why) else
      speak: fn[integer, integer, integer] = fn(hs: integer, cb: integer): integer do HTTP._tlsconn(hs, cb, id) end
      HTTP._listen(a, f, o, Process.__word(speak))
    end
  end
#: serve_tls/3 needs _tlsfiles/2 serve_tls/4
  def serve_tls(a: string, f: fn[HTTP.Request, HTTP.Response], files: list[tuple[atom, string]]): result[http_server, string] do
    empty: list[tuple[atom, integer]] = []
    HTTP.serve_tls(a, f, files, empty)
  end
# ---- Proxies ----
# The proxy a request to an address goes through, as Go's
# http.ProxyFromEnvironment chooses it: where to connect ("" for the
# address itself, a zero byte when the proxy cannot be used, with why) and
# what the request then carries (a byte 1, then a header for the proxy).
# HTTP_PROXY and NO_PROXY are read at the first request and kept.
#: _proxy/2 needs Base.encode64/1 Enum.at/3 TCP._literal/1 TCP._lower/1 _hostname/1 _hostport/1 _parts/2 _spared/3 _url/1
  def _proxy(g: integer, u: list[string]): tuple[string, string] do
    if Sys.peek(g + 400) == 0 do
      env = fn(a: string, b: string): string do
        case System.get_env(a) do
          some(v) -> v
          none ->
            case System.get_env(b) do
              some(w) -> w
              none -> ""
            end
        end
      end
      cgi = System.get_env("REQUEST_METHOD") != none
      Sys.poke(g + 392, Process.__word([if cgi do "" else env("HTTP_PROXY", "http_proxy") end, env("NO_PROXY", "no_proxy"), env("HTTPS_PROXY", "https_proxy")]))
      Sys.poke(g + 400, 1)
    end
    kept: list[string] = Process.__any(Sys.peek(g + 392))
    [plain, spare, secure] = kept
    tunnel = Enum.at(u, 0, "") == "https"
    proxy = if tunnel do secure else plain end
    host = HTTP._hostname(u)
    there = TCP._literal(host)
    loop = there != "" and (Sys.byte(Sys.addr(there)) == 2 and Sys.byte(Sys.addr(there) + 4) == 127 or Sys.byte(Sys.addr(there)) == 10 and TCP._lower(host) == "::1")
    if proxy == "" or Enum.at(u, 0, "") != "http" and not tunnel or host == "localhost" or loop or HTTP._spared(HTTP._parts(TCP._lower(spare), 44), host, HTTP._hostport(u)) do {"", ""} else
      {bad, first} = HTTP._url(proxy)
      {worse, p} = if bad != "" or Enum.at(first, 0, "") == "" or Enum.at(first, 3, "") == "" do HTTP._url("http://" <> proxy) else {bad, first} end
      if worse != "" do {"", ""} else
        if Enum.at(p, 0, "") != "http" do {"\x00", "proxy: the scheme " <> Enum.at(p, 0, "") <> " is not built (spec/alchem-network.md)"} else
          user = Enum.at(p, 1, "")
          {HTTP._hostport(p), (if tunnel do "\x02" else "\x01" end) <> (if Enum.at(p, 2, "") == "" do "" else "Proxy-Authorization: Basic " <> Base.encode64(if Sys.find(Sys.addr(user), byte_size(user), 58) < 0 do user <> ":" else user end) <> "\r\n" end)}
        end
      end
    end
  end
# Whether NO_PROXY, as its entries in lower case, spares a host.
#: _spared/3 needs TCP._last/3 TCP._literal/1 TCP._pnum/3 TCP._sub/3 _prefix/3 _trim/1
  def _spared(entries: list[string], host: string, hostport: string): boolean do
    case entries do
      [] -> false
      [raw | rest] ->
        e = HTTP._trim(raw)
        n = byte_size(e)
        p = Sys.addr(e)
        slash = Sys.find(p, n, 47)
        colon = TCP._last(p, n, 58)
        ported = colon > 0 and Sys.find(p, colon, 58) < 0 and TCP._pnum(p + colon + 1, n - colon - 1, 0) >= 0 and n - colon - 1 > 0
        name0 = if ported do TCP._sub(e, 0, colon) else e end
        name1 = if byte_size(name0) > 1 and Sys.byte(Sys.addr(name0)) == 42 and Sys.byte(Sys.addr(name0) + 1) == 46 do TCP._sub(name0, 1, byte_size(name0) - 1) else name0 end
        dotted = if byte_size(name1) > 0 and Sys.byte(Sys.addr(name1)) == 46 do name1 else "." <> name1 end
        k = byte_size(host) - byte_size(dotted)
        port_fits = not ported or TCP._sub(e, colon, n - colon) == TCP._sub(hostport, byte_size(hostport) - (n - colon), n - colon)
        here = TCP._literal(host)
        hit = if n == 0 do false else
          if e == "*" do true else
            if slash > 0 do
              net = TCP._literal(TCP._sub(e, 0, slash))
              bits = TCP._pnum(p + slash + 1, n - slash - 1, 0)
              here != "" and net != "" and byte_size(here) == 16 and byte_size(net) == 16 and bits >= 0 and bits <= 32 and HTTP._prefix(Sys.addr(here) + 4, Sys.addr(net) + 4, bits)
            else
              if TCP._literal(name0) != "" do here != "" and TCP._sub(TCP._literal(name0), 4, byte_size(here) - 4) == TCP._sub(here, 4, byte_size(here) - 4) and port_fits else
                (k >= 0 and TCP._sub(host, if k < 0 do 0 else k end, byte_size(dotted)) == dotted or name1 == name0 and dotted == "." <> host and Sys.byte(Sys.addr(name0)) != 46) and port_fits
              end
            end
          end
        end
        if hit do true else HTTP._spared(rest, host, hostport) end
    end
  end
# Whether two IPv4 addresses (four bytes at a and b) share their first
# bits.
#: _prefix/3 needs Enum.at/3
  def _prefix(a: integer, b: integer, bits: integer): boolean do
    if bits <= 0 do true else
      if bits >= 8 do Sys.byte(a) == Sys.byte(b) and HTTP._prefix(a + 1, b + 1, bits - 8) else
        div(Sys.byte(a), Enum.at([256, 128, 64, 32, 16, 8, 4, 2], bits, 1)) == div(Sys.byte(b), Enum.at([256, 128, 64, 32, 16, 8, 4, 2], bits, 1))
      end
    end
  end
