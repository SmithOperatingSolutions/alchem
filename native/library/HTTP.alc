        rest1 = if colon < 0 do rest0 else TCP._sub(rest0, colon + 1, byte_size(rest0) - colon - 1) end
        q = Sys.find(Sys.addr(rest1), byte_size(rest1), 63)
        query = if q < 0 do "" else TCP._sub(rest1, q + 1, byte_size(rest1) - q - 1) end
        force = if q >= 0 and query == "" do "1" else "" end
        rest = if q < 0 do rest1 else TCP._sub(rest1, 0, q) end
        m = byte_size(rest)
        r = Sys.addr(rest)
        slash = m > 0 and Sys.byte(r) == 47
        if not slash and scheme != "" do {"", [scheme, "", "", "", "", query, force, frag, rest, ""]} else
