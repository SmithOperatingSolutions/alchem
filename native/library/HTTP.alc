    HTTP._listen(a, f, empty, 0)
  end
#: serve/3 needs _listen/4
  def serve(a: string, f: fn[HTTP.Request, HTTP.Response], o: list[tuple[atom, integer]]): result[http_server, string] do
    HTTP._listen(a, f, o, 0)
  end
