# HTTP: a client and a server for HTTP/1.1 over TCP, written to answer and
# ask as Go's net/http does for the pinned runtime (compiler/library.go.txt,
# "---- HTTP ----"; spec/alchem-network.md says what is not built).
#
# A server is a block: 0 its listening socket, 8 the process that stands
# for it (stopping it stops the server), 16 its address, 24 the handler, 32
# read_timeout, 40 write_timeout, 48 idle_timeout, 56 header_timeout, 64
# max_header_bytes, 72 max_body_bytes, 80 keep_alive, 88 compress, 96 set
# once it has stopped, 104 its connections (each cell: the socket, the
# process that serves it).
#
# An exchange is a request being answered: 0 the server, 8 the connection,
# 16 the process that runs the handler, 24 the answer (0: none yet), 32
# where it stands (0 the handler runs, 1 it answered, 2 it is writing a
# body in pieces, 3 it has written one, 4 the connection was taken over),
# 40 the process that serves the connection, 48 the request was HEAD, 56 it
# was HTTP/1.0, 64 the connection closes after the answer, 72 the request
# takes gzip, 80 the request, 88 the head of a body in pieces was written,
# 96 when a write must be done by (0: no limit), 104 its body goes out in
# chunks. g + 312 holds a cell for each handler that runs: its process and
# its exchange.
#: struct http_server also HTTP WebSocket TCP
  struct http_server do
    at: integer
    k: option[fn[integer, integer]]
  end
  struct HTTP.Request do
    method: string
    path: string
    query: string
    headers: list[tuple[string, string]]
    body: string
  end
  struct HTTP.Response do
    status: integer
    headers: list[tuple[string, string]]
    body: string
    chunks: option[stream[string]] = none
  end
#: text/2
  def text(status: integer, body: string): HTTP.Response do
    %HTTP.Response{status: status, headers: [{"content-type", "text/plain; charset=utf-8"}], body: body, chunks: none}
  end
# The body is the value as JSON.encode writes it (library/JSON.alc).
#: json/2 needs JSON.encode!/2
  def json(status: integer, body: JSON): HTTP.Response do
    %HTTP.Response{status: status, headers: [{"content-type", "application/json"}], body: JSON.encode!(JSON.__word(body), JSON.__kind(body)), chunks: none}
  end
#: chunked/3
  def chunked(status: integer, headers: list[tuple[string, string]], chunks: stream[string]): HTTP.Response do
    %HTTP.Response{status: status, headers: headers, body: "", chunks: some(chunks)}
  end
#: read/1 needs Enum.join/2
  def read(r: HTTP.Response): string do
    case r.chunks do
      none -> r.body
      some(s) -> r.body <> Enum.join(Stream.__list(s), "")
    end
  end
#: header/2 needs TCP._lower/1
  def header(h: list[tuple[string, string]], name: string): option[string] do
    w = TCP._lower(name)
    case h do
      [] -> none
      [{k, v} | rest] -> if TCP._lower(k) == w do some(v) else HTTP.header(rest, name) end
    end
  end
# Whether a name is the word w, which is in lower case, in any case.
#: _is/2 needs _is1/3
  def _is(k: string, w: string): boolean do
    n = byte_size(k)
    if n != byte_size(w) do false else HTTP._is1(Sys.addr(k), Sys.addr(w), n) == 1 end
  end
#: _is1/3
  def _is1(p: integer, q: integer, n: integer): integer do
    if n == 0 do 1 else
      c = Sys.byte(p)
      if (if c >= 65 and c <= 90 do c + 32 else c end) != Sys.byte(q) do 0 else HTTP._is1(p + 1, q + 1, n - 1) end
    end
  end
# The first value of the header whose name in lower case is w, "" for none.
#: _get/2 needs _is/2
  def _get(h: list[tuple[string, string]], w: string): string do
    case h do
      [] -> ""
      [{k, v} | rest] -> if HTTP._is(k, w) do v else HTTP._get(rest, w) end
    end
  end
#: _has/2 needs _is/2
  def _has(h: list[tuple[string, string]], w: string): boolean do
    case h do
      [] -> false
      [{k, v} | rest] -> if HTTP._is(k, w) do true else HTTP._has(rest, w) end
    end
  end
# The text without the blanks at its ends.
#: _trim/1 needs _blanks/3
  def _trim(t: string): string do
    n = byte_size(t)
    p = Sys.addr(t)
    a = HTTP._blanks(p, n, 1)
    b = if a == n do 0 else HTTP._blanks(p + n - 1, n - a, -1) end
    if a + b == 0 do t else Sys.text(p + a, n - a - b) end
  end
#: _blanks/3
  def _blanks(p: integer, n: integer, step: integer): integer do
    if n == 0 do 0 else
      c = Sys.byte(p)
      if c == 32 or c == 9 or c == 13 or c == 10 do 1 + HTTP._blanks(p + step, n - 1, step) else 0 end
    end
  end
# The parts of a text around each byte c.
#: _parts/2 needs TCP._sub/3
  def _parts(t: string, c: integer): list[string] do
    n = byte_size(t)
    i = Sys.find(Sys.addr(t), n, c)
    if i < 0 do [t] else [TCP._sub(t, 0, i)] ++ HTTP._parts(TCP._sub(t, i + 1, n - i - 1), c) end
  end
# 1 for a byte a header's name or a method may hold.
#: _token/1
  def _token(c: integer): integer do
    if c >= 48 and c <= 57 or c >= 65 and c <= 90 or c >= 97 and c <= 122 do 1 else
      if c == 33 or c >= 35 and c <= 39 or c == 42 or c == 43 or c == 45 or c == 46 or c == 94 or c == 95 or c == 96 or c == 124 or c == 126 do 1 else 0 end
    end
  end
#: _tokens/2 needs _token/1
  def _tokens(p: integer, n: integer): integer do
    if n == 0 do 1 else if HTTP._token(Sys.byte(p)) == 0 do 0 else HTTP._tokens(p + 1, n - 1) end end
  end
# A header's name as Go writes it: Content-Type. A name that is no token
# stays as it is.
#: _canon/1 needs TCP._s/0 _canon1/4 _tokens/2
  def _canon(k: string): string do
    n = byte_size(k)
    if n == 0 or n > 4096 or HTTP._tokens(Sys.addr(k), n) == 0 do k else
      s = TCP._s() + 4096
      HTTP._canon1(Sys.addr(k), s, n, 1)
      Sys.text(s, n)
    end
  end
#: _canon1/4
  def _canon1(p: integer, q: integer, n: integer, up: integer): integer do
    if n == 0 do 0 else
      c = Sys.byte(p)
      d = if up == 1 and c >= 97 and c <= 122 do c - 32 else if up == 0 and c >= 65 and c <= 90 do c + 32 else c end end
      Sys.poke(q, d)
      HTTP._canon1(p + 1, q + 1, n - 1, if c == 45 do 1 else 0 end)
    end
  end
# Headers in the order of their names, those of one name as they came.
#: _sorted/1 needs _into/2
  def _sorted(h: list[tuple[string, string]]): list[tuple[string, string]] do
    start: list[tuple[string, string]] = []
    Enum.reduce(h, start, fn x, acc -> HTTP._into(acc, x) end)
  end
#: _into/2
  def _into(l: list[tuple[string, string]], x: tuple[string, string]): list[tuple[string, string]] do
    case l do
      [] -> [x]
      [y | rest] -> if elem(x, 0) < elem(y, 0) do [x] ++ l else [y] ++ HTTP._into(rest, x) end
    end
  end
# A number in decimal digits alone: -1 for anything else.
#: _num/1 needs TCP._digits/2 TCP._pnum/3
  def _num(t: string): integer do
    n = byte_size(t)
    if n == 0 or n > 18 or TCP._digits(Sys.addr(t), n) != n do -1 else TCP._pnum(Sys.addr(t), n, 0) end
  end
# What Go's http.StatusText gives.
#: _reason/1 needs Process._g/0 _reason1/3 _reasons/0
  def _reason(c: integer): string do
    g = Process._g()
    if Sys.peek(g + 360) == 0 do Sys.poke(g + 360, Process.__word(HTTP._reasons())) end
    known: string = Process.__any(Sys.peek(g + 360))
    HTTP._reason1(Sys.addr(known), byte_size(known), c)
  end
# The table is made once: a text that is written in a program is made anew
# each time it is come to.
#: _reasons/0
  def _reasons(): string do
    "100Continue;101Switching Protocols;102Processing;103Early Hints;200OK;201Created;202Accepted;203Non-Authoritative Information;204No Content;205Reset Content;206Partial Content;207Multi-Status;208Already Reported;226IM Used;300Multiple Choices;301Moved Permanently;302Found;303See Other;304Not Modified;305Use Proxy;307Temporary Redirect;308Permanent Redirect;400Bad Request;401Unauthorized;402Payment Required;403Forbidden;404Not Found;405Method Not Allowed;406Not Acceptable;407Proxy Authentication Required;408Request Timeout;409Conflict;410Gone;411Length Required;412Precondition Failed;413Request Entity Too Large;414Request URI Too Long;415Unsupported Media Type;416Requested Range Not Satisfiable;417Expectation Failed;418I'm a teapot;421Misdirected Request;422Unprocessable Entity;423Locked;424Failed Dependency;425Too Early;426Upgrade Required;428Precondition Required;429Too Many Requests;431Request Header Fields Too Large;451Unavailable For Legal Reasons;500Internal Server Error;501Not Implemented;502Bad Gateway;503Service Unavailable;504Gateway Timeout;505HTTP Version Not Supported;506Variant Also Negotiates;507Insufficient Storage;508Loop Detected;510Not Extended;511Network Authentication Required;"
  end
#: _reason1/3
  def _reason1(p: integer, n: integer, c: integer): string do
    if n < 4 do "" else
      e = Sys.find(p, n, 59)
      if (Sys.byte(p) - 48) * 100 + (Sys.byte(p + 1) - 48) * 10 + Sys.byte(p + 2) - 48 == c do Sys.text(p + 3, e - 3) else HTTP._reason1(p + e + 1, n - e - 1, c) end
    end
  end
# The time now as a Date header has it: Mon, 02 Jan 2006 15:04:05 GMT.
#: _date/1 needs _date1/1
  def _date(g: integer): string do
    Sys.call(228, 0, g + 200)
    t = Sys.peek(g + 200)
    if t == Sys.peek(g + 344) do Process.__any(Sys.peek(g + 352)) else
      Sys.poke(g + 344, t)
      made = HTTP._date1(t)
      Sys.poke(g + 352, Process.__word(made))
      made
    end
  end
#: _date1/1
  def _date1(t: integer): string do
    days = div(t, 86400)
    left = rem(t, 86400)
    z = days + 719468
    era = div(z, 146097)
    doe = z - era * 146097
    yoe = div(doe - div(doe, 1460) + div(doe, 36524) - div(doe, 146096), 365)
    doy = doe - (365 * yoe + div(yoe, 4) - div(yoe, 100))
    mp = div(5 * doy + 2, 153)
    d = doy - div(153 * mp + 2, 5) + 1
    m = if mp < 10 do mp + 3 else mp - 9 end
    y = yoe + era * 400 + (if m <= 2 do 1 else 0 end)
    two = fn(v: integer): string do if v < 10 do "0#{v}" else "#{v}" end end
    Sys.text(Sys.addr("ThuFriSatSunMonTueWed") + 3 * rem(days, 7), 3) <> ", " <> two(d) <> " " <> Sys.text(Sys.addr("JanFebMarAprMayJunJulAugSepOctNovDec") + 3 * (m - 1), 3) <> " #{y} " <> two(div(left, 3600)) <> ":" <> two(rem(div(left, 60), 60)) <> ":" <> two(rem(left, 60)) <> " GMT"
  end
# net/url's unescape of a path: "" with 0 when an escape is malformed.
#: _unescape/1 needs TCP._atonv/4 TCP._s/0 TCP._sub/3
  def _unescape(t: string): tuple[string, integer] do
    n = byte_size(t)
    i = Sys.find(Sys.addr(t), n, 37)
    if i < 0 do {t, 1} else
      {d, v} = if i + 2 < n + 0 and i + 3 <= n do TCP._atonv(Sys.addr(t) + i + 1, 2, 16, {0, 0}) else {0, 0} end
      if d != 2 do {"", 0} else
        {rest, fine} = HTTP._unescape(TCP._sub(t, i + 3, n - i - 3))
        s = TCP._s() + 256
        Sys.poke(s, v)
        {TCP._sub(t, 0, i) <> Sys.text(s, 1) <> rest, fine}
      end
    end
  end
# HTTP.match and HTTP.route: the parameters a path gives a pattern.
#: _path/2 needs _parts/2 _segments/5 _slashless/1
  def _path(pattern: string, path: string): tuple[map[string, string], boolean] do
    want = HTTP._parts(HTTP._slashless(pattern), 47)
    got = HTTP._parts(HTTP._slashless(path), 47)
    start: map[string, string] = %{}
    HTTP._segments(want, got, 0, start, length(want) == length(got))
  end
#: _slashless/1 needs _slashes/3
  def _slashless(t: string): string do
    n = byte_size(t)
    p = Sys.addr(t)
    a = HTTP._slashes(p, n, 1)
    b = if a == n do 0 else HTTP._slashes(p + n - 1, n - a, -1) end
    Sys.text(p + a, n - a - b)
  end
#: _slashes/3
  def _slashes(p: integer, n: integer, step: integer): integer do
    if n == 0 do 0 else if Sys.byte(p) == 47 do 1 + HTTP._slashes(p + step, n - 1, step) else 0 end end
  end
#: _segments/5 needs Enum.at/3 Enum.drop/2 Enum.join/2 TCP._sub/3 _unescape/1
  def _segments(want: list[string], got: list[string], i: integer, params: map[string, string], same: boolean): tuple[map[string, string], boolean] do
    case want do
      [] -> {params, same}
      [w | rest] ->
        n = byte_size(w)
        c = if n == 0 do 0 else Sys.byte(Sys.addr(w)) end
        if c == 42 do {Map.put(params, TCP._sub(w, 1, n - 1), Enum.join(Enum.drop(got, if i < length(got) do i else length(got) end), "/")), true} else
          if i >= length(got) do {params, false} else
            here = Enum.at(got, i, "")
            if c == 58 do
              {text, fine} = HTTP._unescape(here)
              if fine == 0 do {params, false} else HTTP._segments(rest, got, i + 1, Map.put(params, TCP._sub(w, 1, n - 1), text), same) end
            else
              if w != here do {params, false} else HTTP._segments(rest, got, i + 1, params, same) end
            end
          end
        end
    end
  end
#: match/3 needs TCP._lower/1 _path/2
  def match(r: HTTP.Request, method: string, pattern: string): option[map[string, string]] do
    if method != "*" and TCP._lower(method) != TCP._lower(r.method) do none else
      {params, fits} = HTTP._path(pattern, r.path)
      if fits do some(params) else none end
    end
  end
#: route/2 needs _routes/3
  def route(r: HTTP.Request, routes: list[tuple[string, string, fn[HTTP.Request, map[string, string], HTTP.Response]]]): HTTP.Response do
    HTTP._routes(r, routes, [])
  end
#: _routes/3 needs Enum.join/2 TCP._lower/1 _path/2 text/2
  def _routes(r: HTTP.Request, routes: list[tuple[string, string, fn[HTTP.Request, map[string, string], HTTP.Response]]], allowed: list[string]): HTTP.Response do
    case routes do
      [] ->
        if allowed == [] do HTTP.text(404, "not found") else
          %HTTP.Response{status: 405, headers: [{"content-type", "text/plain; charset=utf-8"}, {"allow", Enum.join(allowed, ", ")}], body: "method not allowed", chunks: none}
        end
      [{method, pattern, handler} | rest] ->
        {params, fits} = HTTP._path(pattern, r.path)
        if not fits do HTTP._routes(r, rest, allowed) else
          if method == "*" or TCP._lower(method) == TCP._lower(r.method) do handler(r, params) else HTTP._routes(r, rest, allowed ++ [String.upcase(method)]) end
        end
    end
  end
# ---- The server ----
# A line of a message's head without its end, its bytes counted against
# the room left at cb + 128's limit: "" with the reason at cb + 120 when it
# did not come ("long": the head is larger than limit bytes).
#: _hline/4 needs TCP._at/1 TCP._fill/4 TCP._move/2 TCP._taken/1 TCP._why/2
  def _hline(g: integer, cb: integer, d: integer, limit: integer): string do
    have = TCP._fill(g, cb, d, 4096)
    if have == 0 do "" else
      i = Sys.find(TCP._at(cb), have, 10)
      if i >= 0 do
        TCP._move(cb, i + 1)
        t = TCP._taken(cb)
        n = byte_size(t)
        if n > limit do TCP._why(cb, "long") else Sys.text(Sys.addr(t), if n >= 2 and Sys.byte(Sys.addr(t) + n - 2) == 13 do n - 2 else n - 1 end) end
      else
        TCP._move(cb, have)
        if Sys.peek(cb + 128) > limit do
          TCP._taken(cb)
          TCP._why(cb, "long")
        else HTTP._hline(g, cb, d, limit) end
      end
    end
  end
# The lines of a head up to its empty line; [] with the reason at cb + 120.
#: _hlines/5 needs _hline/4
  def _hlines(g: integer, cb: integer, d: integer, limit: integer, got: list[string]): list[string] do
    Sys.poke(cb + 120, 0)
    line = HTTP._hline(g, cb, d, limit)
    if Sys.peek(cb + 120) != 0 do [] else
      if line == "" and got != [] do got else
        if line == "" do [""] else HTTP._hlines(g, cb, d, limit - byte_size(line) - 2, got ++ [line]) end
      end
    end
  end
# The header lines of a head as names and values, a line that begins with
# a blank going on the one before: the status (0 fine, 400 malformed) and
# the headers with their names as Go writes them.
#: _fields/2 needs Enum.take/2 List.last/2 TCP._sub/3 _canon/1 _keyok/2 _trim/1 _valbytes/2
  def _fields(lines: list[string], got: list[tuple[string, string]]): tuple[integer, list[tuple[string, string]]] do
    case lines do
      [] -> {0, got}
      [line | rest] ->
        n = byte_size(line)
        p = Sys.addr(line)
        c = if n == 0 do 0 else Sys.byte(p) end
        if c == 32 or c == 9 do
          if got == [] do {400, []} else
            {k, v} = List.last(got, {"", ""})
            more = HTTP._trim(line)
            HTTP._fields(rest, Enum.take(got, length(got) - 1) ++ [{k, if v == "" do more else if more == "" do v else v <> " " <> more end end}])
          end
        else
          i = Sys.find(p, n, 58)
          if i <= 0 do {400, []} else
            k = TCP._sub(line, 0, i)
            if HTTP._keyok(p, i) == 0 or HTTP._valbytes(p + i + 1, n - i - 1) == 0 do {400, []} else HTTP._fields(rest, got ++ [{HTTP._canon(k), HTTP._trim(TCP._sub(line, i + 1, n - i - 1))}]) end
          end
        end
    end
  end
# A header's name may hold the bytes of a token, and blanks (which make it
# an invalid name later, not a malformed line).
#: _keyok/2 needs _token/1
  def _keyok(p: integer, n: integer): integer do
    if n == 0 do 1 else
      c = Sys.byte(p)
      if c != 32 and HTTP._token(c) == 0 do 0 else HTTP._keyok(p + 1, n - 1) end
    end
  end
# 1 when a header's line holds no byte below a blank but a tab, which
# makes the line malformed.
#: _valbytes/2
  def _valbytes(p: integer, n: integer): integer do
    if n == 0 do 1 else
      c = Sys.byte(p)
      if c < 32 and c != 9 do 0 else HTTP._valbytes(p + 1, n - 1) end
    end
  end
# 1 when the value of a header holds no control byte but a tab.
#: _valok/2
  def _valok(p: integer, n: integer): integer do
    if n == 0 do 1 else
      c = Sys.byte(p)
      if c < 32 and c != 9 or c == 127 do 0 else HTTP._valok(p + 1, n - 1) end
    end
  end
# 1 when a comma-separated header holds the word w (in lower case).
#: _holds/3 needs Enum.any?/2 _is/2 _parts/2 _trim/1
  def _holds(h: list[tuple[string, string]], name: string, w: string): boolean do
    case h do
      [] -> false
      [{k, v} | rest] ->
        if HTTP._is(k, name) and Enum.any?(HTTP._parts(v, 44), fn x -> HTTP._is(HTTP._trim(x), w) end) do true else HTTP._holds(rest, name, w) end
    end
  end
# The first line of a request: 0 and the method, the target and the minor
# version, or the status that refuses it and what is said with it.
#: _reqline/1 needs TCP._sub/3 _tokens/2
  def _reqline(line: string): tuple[integer, string, string, integer] do
    n = byte_size(line)
    p = Sys.addr(line)
    a = Sys.find(p, n, 32)
    b = if a < 0 do -1 else Sys.find(p + a + 1, n - a - 1, 32) end
    if a <= 0 or b < 0 do {400, "", "", 0} else
      method = TCP._sub(line, 0, a)
      target = TCP._sub(line, a + 1, b)
      proto = TCP._sub(line, a + b + 2, n - a - b - 2)
      q = Sys.addr(proto)
      shaped = byte_size(proto) == 8 and TCP._sub(proto, 0, 5) == "HTTP/" and Sys.byte(q + 6) == 46 and Sys.byte(q + 5) >= 48 and Sys.byte(q + 5) <= 57 and Sys.byte(q + 7) >= 48 and Sys.byte(q + 7) <= 57
      if not shaped or HTTP._tokens(Sys.addr(method), a) == 0 do {400, "", "", 0} else
        if Sys.byte(q + 5) != 49 do {505, ": unsupported protocol version", "", 0} else {0, method, target, Sys.byte(q + 7) - 48} end
      end
    end
  end
# The target of a request as net/url reads it: whether it is one, its
# path, its query and the host it names ("" for none).
#: _target/2 needs TCP._sub/3 _unescape/1 _valok/2
  def _target(method: string, t: string): tuple[boolean, string, string, string] do
    n = byte_size(t)
    p = Sys.addr(t)
    c = if n == 0 do 0 else Sys.byte(p) end
    if n == 0 or HTTP._valok(p, n) == 0 or Sys.find(p, n, 9) >= 0 do {false, "", "", ""} else
      if t == "*" do {true, "*", "", ""} else
        if c == 47 do
          q = Sys.find(p, n, 63)
          {path, fine} = HTTP._unescape(if q < 0 do t else TCP._sub(t, 0, q) end)
          {fine == 1, path, if q < 0 do "" else TCP._sub(t, q + 1, n - q - 1) end, ""}
        else
          i = Sys.find(p, n, 58)
          if i <= 0 or i + 2 >= n or Sys.byte(p + i + 1) != 47 or Sys.byte(p + i + 2) != 47 do
            if method == "CONNECT" do {true, "", "", t} else {false, "", "", ""} end
          else
            rest = TCP._sub(t, i + 3, n - i - 3)
            m = byte_size(rest)
            s = Sys.find(Sys.addr(rest), m, 47)
            q = Sys.find(Sys.addr(rest), m, 63)
            e = if s < 0 or q >= 0 and q < s do if q < 0 do m else q end else s end
            {ok, path, query, _} = if e == m do {true, "", "", ""} else HTTP._target(method, if Sys.byte(Sys.addr(rest) + e) == 63 do "/" <> TCP._sub(rest, e, m - e) else TCP._sub(rest, e, m - e) end) end
            {ok, if e < m and Sys.byte(Sys.addr(rest) + e) == 63 do "" else path end, query, TCP._sub(rest, 0, e)}
          end
        end
      end
    end
  end
# A refusal Go's server writes by itself, with nothing of the handler's.
#: _refuse/5 needs TCP._write/5 _reason/1
  def _refuse(g: integer, cb: integer, code: integer, more: string, body: string): integer do
    said = "#{code} " <> HTTP._reason(code) <> more
    out = "HTTP/1.1 " <> said <> "\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\n" <> (if body == "" do said else body end)
    TCP._write(g, cb, Sys.addr(out), byte_size(out), 0)
    0
  end
# The body of a request sent in chunks, up to limit bytes: its pieces, or
# the reason at cb + 120 ("bad": it is malformed; "large": it is longer).
#: _chunks/6 needs TCP._atonv/4 TCP._exact/5 TCP._why/2 _hline/4 _trailers/3 _trim/1
  def _chunks(g: integer, cb: integer, d: integer, limit: integer, got: list[string], size: integer): list[string] do
    Sys.poke(cb + 120, 0)
    line = HTTP._hline(g, cb, d, 4096)
    if Sys.peek(cb + 120) != 0 do [] else
      semi = Sys.find(Sys.addr(line), byte_size(line), 59)
      digits = if semi < 0 do byte_size(HTTP._trim(line)) else semi end
      {used, n} = TCP._atonv(Sys.addr(line), digits, 16, {0, 0})
      if used == 0 or used != digits or n < 0 do
        TCP._why(cb, "bad")
        []
