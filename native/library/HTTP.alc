    [scheme, user, has, host, path, query, force, frag, opaque, omit] = ref
    if scheme != "" do [scheme, user, has, host, HTTP._dots(path), query, force, frag, opaque, omit] else
      if host != "" or has != "" do [bs, user, has, host, HTTP._dots(path), query, force, frag, "", ""] else
