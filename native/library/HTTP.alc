    p = Sys.addr(t)
    at = TCP._last(p, n, 64)
    user = if at < 0 do "" else TCP._sub(t, 0, at) end
    host = if at < 0 do t else TCP._sub(t, at + 1, n - at - 1) end
    m = byte_size(host)
    h = Sys.addr(host)
    if m > 0 and Sys.byte(h) == 91 do
