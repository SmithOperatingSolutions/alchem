# IO.ANSI: the functions written in Alchem (the compiler looks IO.ANSI.name
# up as ANSI.name).
#: reset/0
  def reset(): string do
    "\e[0m"
  end
#: bright/0
  def bright(): string do
    "\e[1m"
  end
#: faint/0
  def faint(): string do
    "\e[2m"
  end
