#: cursor_up/1
  def cursor_up(n: integer): string do
    "\e[" <> Integer.to_string(n) <> "A"
  end
#: cursor_down/1
  def cursor_down(n: integer): string do
    "\e[" <> Integer.to_string(n) <> "B"
  end
#: cursor_right/1
  def cursor_right(n: integer): string do
    "\e[" <> Integer.to_string(n) <> "C"
  end
#: cursor_left/1
  def cursor_left(n: integer): string do
    "\e[" <> Integer.to_string(n) <> "D"
  end
#: color/1
  def color(n: integer): string do
    "\e[38;5;" <> Integer.to_string(n) <> "m"
  end
#: color_background/1
  def color_background(n: integer): string do
    "\e[48;5;" <> Integer.to_string(n) <> "m"
  end
#: cursor/2
  def cursor(line: integer, column: integer): string do
    "\e[" <> Integer.to_string(line) <> ";" <> Integer.to_string(column) <> "H"
  end
#: format/2
  def format(parts: list[tuple[atom, string]], on: boolean): string do
    out = Enum.reduce(parts, "", fn p, acc ->
      if elem(p, 0) == :text do acc <> elem(p, 1) else
        if on do acc <> code(elem(p, 0)) else acc end
      end
    end)
    if on do out <> "\e[0m" else out end
  end
  defp code(name: atom): string do
    Enum.reduce([reset: "0", bright: "1", faint: "2", italic: "3", underline: "4", blink_slow: "5", blink_rapid: "6", reverse: "7", conceal: "8", crossed_out: "9", normal: "22", no_underline: "24", not_italic: "23", black: "30", red: "31", green: "32", yellow: "33", blue: "34", magenta: "35", cyan: "36", white: "37", default_color: "39", black_background: "40", red_background: "41", green_background: "42", yellow_background: "43", blue_background: "44", magenta_background: "45", cyan_background: "46", white_background: "47", default_background: "49", light_black: "90", light_red: "91", light_green: "92", light_yellow: "93", light_blue: "94", light_magenta: "95", light_cyan: "96", light_white: "97", light_black_background: "100", light_red_background: "101", light_green_background: "102", light_yellow_background: "103", light_blue_background: "104", light_magenta_background: "105", light_cyan_background: "106", light_white_background: "107"], "", fn c, acc ->
      if elem(c, 0) == name do "\e[" <> elem(c, 1) <> "m" else acc end
    end)
  end
#: enabled?/0
  def enabled?(): boolean do
    System.get_env("TERM") != some("dumb") and (System.get_env("NO_COLOR") == none or System.get_env("NO_COLOR") == some("")) and device(File.read("/proc/self/fdinfo/1"), File.read("/proc/self/mountinfo"))
  end
  defp device(fd: result[string, string], mounts: result[string, string]): boolean do
    case fd do
      ok(info) ->
        case mounts do
          ok(table) ->
            id = hd(String.split(hd(tl(String.split(info <> "mnt_id:\t\n", "mnt_id:\t"))), "\n"))
            line = hd(String.split(hd(tl(String.split("\n" <> table <> "\n" <> id <> " \n", "\n" <> id <> " "))), "\n"))
            String.contains?(line, " - devpts ") or String.contains?(line, " - devtmpfs ")
          error(e) -> false
        end
      error(e) -> false
    end
  end
