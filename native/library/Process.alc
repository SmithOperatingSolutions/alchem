    x = Process._lookup(g, Process.__any(Process.__word(n)))
    if x == 0 do none else
      if Sys.peek(x + 8) != 0 do none else
        kind: string = if Sys.peek(x) == 0 do "" else Process.__any(Sys.peek(Sys.peek(x))) end
