# Process: processes as the pinned runtime has them (compiler/actor/process.go),
# run as coroutines of the one thread a native program has
# (spec/alchem-processes.md). Sys.state() + 96 holds the address of the
# block g that everything here hangs from; the names are short because the
# text is held in the compiler's source.
#
# g:   0 the running process, 8 and 16 the first and last of those ready
#      to run, 24 the last number given out, 32 how many processes live, 40
#      the newest of them, 48 the first of those that wait for a time, 56 the
#      earliest such time (0: none), 64 and 72 the free part of the block
#      records come from, 80 the free stacks, 88 the free cells, 112 set when
#      the program is ending, 120 the status System.stop asked for (-1: none),
#      128 the main process, 136 the names, 144 the supervisors that wait
#      for a change, 152 the stack of a process that has just ended, 160 up
#      function values kept for Process.__until (and 272), 184 a message
#      or an answer passed on, 200 a time, 216 two descriptors, 224 and 232
#      where a walk stands, 240 the size of a stack, 248 the timers, 264
#      the functions of children that say when they have started, 2048 to
#      4096 zeros.
# process: 0 to 32 what Process.__switch keeps, 40 its number, 48 its state
#      (0 ready, 1 running, 2 waiting, 3 over), 56 asked to stop, 64 the
#      next ready one, 72 and 80 newer and older live ones, 88 the time it
#      waits for, 96 and 104 the ones before and after it among those, 112
#      and 120 first and last message, 128 how many, 136 the mailbox's
#      capacity (0: no mailbox yet), 144 its type, 152 who waits to send to
#      it, 160 the exit reason, 168 the failure's text, 176 and 184 those a
#      stop gave, 192 and 200 first and last event, 208 who monitors it, 216
#      whom it monitors, 224 its links, 232 what it owns, 240 its owner, 248
#      who waits for its end, 256 the top of its stack, 264 the message it
#      failed with, 272 its server, 280 and 288 requests continued, 296
#      functions to run once it is over, 304 what
#      a task's function returned, 312
#      traps exits, 320 not a process of the program (a timer or the like),
#      328 no message type yet, 336 ending, 344 its wait ran out, 352 its
#      function returned, 360 left by a stop, 368 among those that wait for
#      a time, 376 over.
# A cell is four words: the next cell, then three of whatever the list holds.
#: struct pid also Process Agent Task Server Supervisor Registry Port _receive TCP UDP HTTP WebSocket DiskStore Node Stream.publish TLS
  struct pid[t] do
    at: integer
    k: option[fn[t, t]]
  end
#: struct Process.Exit also Process Agent Task Server Supervisor Registry Port _receive TCP UDP HTTP WebSocket DiskStore Node Stream.publish TLS
  struct Process.Exit do
    r: integer
  end
#: _g/0 needs Sys.state/0 _boot/0
  def _g(): integer do
    g = Sys.peek(Sys.state() + 96)
    if g != 0 do g else Process._boot() end
  end
#: _boot/0 needs Sys.state/0 _close/1 _fdwait/4 _fire1/1 _g/0 _fire2/1 _halted/1 _loop1/1 _new/2 _pick/1 _shut1/1 _stopped/0
  def _boot(): integer do
    g = Sys.call(9, 0, 65536, 3, 34, -1, 0)
    # Never so: a program with processes holds Process._close, which its
    # entry calls, Process._stopped, which main calls, and
    # Process._halted, which System.stop calls.
    if g == 0 do Process._close(Process._stopped() + Process._halted(0)) end
    if g < 0 do System.halt(71) end
    Sys.poke(Sys.state() + 96, g)
    Sys.poke(g + 120, -1)
    Sys.poke(g + 64, g + 4096)
    Sys.poke(g + 72, g + 65536)
    Sys.poke(g + 240, 268435456)
    r = Process._new(g, 0)
    Sys.poke(r + 48, 1)
    Sys.poke(g, r)
    Sys.poke(g + 128, r)
    a: fn[integer, integer] = fn(x: integer): integer do Process._pick(x) end
    Sys.poke(g + 160, Process.__word(a))
    b: fn[integer, integer] = fn(x: integer): integer do Process._fire1(x) end
    Sys.poke(g + 168, Process.__word(b))
    c: fn[integer, integer] = fn(x: integer): integer do Process._loop1(x) end
    Sys.poke(g + 176, Process.__word(c))
    d: fn[integer, integer] = fn(x: integer): integer do Process._shut1(x) end
    Sys.poke(g + 192, Process.__word(d))
    e: fn[integer, integer] = fn(x: integer): integer do Process._fire2(x) end
    Sys.poke(g + 272, Process.__word(e))
    h: fn[integer, integer] = fn(x: integer): integer do Process._fdwait(Process._g(), x, 1, 0) end
    Sys.poke(g + 1032, Process.__word(h))
    g
  end
# Every process waits and none for a time: the pinned runtime ends so.
#: _stuck/0 needs Sys.put/3
  def _stuck(): integer do
    m = "fatal error: all goroutines are asleep - deadlock!\n"
    Sys.put(2, Sys.addr(m), byte_size(m))
    Sys.call(60, 2)
  end
# What a process ends in, on every way out of its function. A failure is
# first written down by a copy of the program, which returns from here.
#: _ended/0 needs _exit/4 _g/0 _trace/1
  def _ended(): integer do
    g = Process._g()
    p = Sys.peek(g)
    if Sys.peek(p + 352) == 1 do Process._exit(g, p, Sys.peek(p + 160), 0) else
      if Sys.peek(p + 360) == 1 do Process._exit(g, p, Sys.peek(p + 176), Sys.peek(p + 184)) else
        t = Process._trace(g)
        if t == 0 do 0 else
          m: string = if Sys.peek(p + 264) == 0 do "uncaught throw" else Process.__any(Sys.peek(p + 264)) end
          r = if m == "normal" or m == "shutdown" do "error: " <> m else m end
          Process._exit(g, p, Process.__word(r), t)
        end
      end
    end
  end
# The main process looks, before each of its statements, whether it was
# asked to stop (the compiler calls this when the word at R14-56 is set; a
# function value made in main has the call too, and is not held up by it).
#: _stopped/0 needs _check/1 _g/0
  def _stopped(): integer do
    g = Process._g()
    if Sys.peek(g) == Sys.peek(g + 128) do Process._check(g) else 0 end
  end
# n bytes for a record, all zero: a value like any other (a string of n
# zero bytes, of which this is the address of the first), so that a record
# nothing refers to any more is given back (alchem-memory.md). Records are
# referred to by their address, held as an integer in handles, in other
# records and in the block g.
#: _take/2
  def _take(g: integer, n: integer): integer do
    Sys.addr(String.duplicate("\x00", n))
  end
#: _free/2
  def _free(g: integer, x: integer): integer do
    Sys.poke(x, Sys.peek(g + 88))
    Sys.poke(g + 88, x)
  end
# The first cell of the list at h that holds a first; 0 for none.
#: _has/2
  def _has(h: integer, a: integer): integer do
    x = Sys.peek(h)
    if x == 0 do 0 else if Sys.peek(x + 8) == a do x else Process._has(x, a) end end
  end
# Every cell of the list at h is freed.
#: _clear/2 needs _free/2
  def _clear(g: integer, h: integer): integer do
    x = Sys.peek(h)
    if x == 0 do 0 else
      Sys.poke(h, Sys.peek(x))
      Process._free(g, x)
      Process._clear(g, h)
    end
  end
#: _new/2 needs _take/2
  def _new(g: integer, h: integer): integer do
    p = Process._take(g, 384)
    if h == 0 do
      n = Sys.peek(g + 24) + 1
      Sys.poke(g + 24, n)
      Sys.poke(p + 40, n)
      o = Sys.peek(g + 40)
      Sys.poke(p + 80, o)
      if o != 0 do Sys.poke(o + 72, p) end
      Sys.poke(g + 40, p)
      Sys.poke(g + 32, Sys.peek(g + 32) + 1)
    else Sys.poke(p + 320, 1) end
    p
  end
# When a wait of ms milliseconds is over; 0 for one without end.
#: _due/2 needs _now/1
  def _due(g: integer, ms: integer): integer do
    if ms < 0 do 0 else Process._now(g) + (if ms > 9000000000000 do 9000000000000 else ms end) * 1000000 end
  end
#: _queue/2
  def _queue(g: integer, p: integer): integer do
    Sys.poke(p + 64, 0)
    t = Sys.peek(g + 16)
    if t == 0 do Sys.poke(g + 8, p) else Sys.poke(t + 64, p) end
    Sys.poke(g + 16, p)
  end
# A process that waits is ready to run again.
#: _ready/2 needs _queue/2 _untime/2
  def _ready(g: integer, p: integer): integer do
    if Sys.peek(p + 48) != 2 do 0 else
      Process._untime(g, p)
      Sys.poke(p + 48, 0)
      Process._queue(g, p)
    end
  end
#: _untime/2
  def _untime(g: integer, p: integer): integer do
    if Sys.peek(p + 368) == 0 do 0 else
      a = Sys.peek(p + 96)
      b = Sys.peek(p + 104)
      if a == 0 do Sys.poke(g + 48, b) else Sys.poke(a + 104, b) end
      if b != 0 do Sys.poke(b + 96, a) end
      Sys.poke(p + 368, 0)
    end
  end
# The stack a process that ended ran on is free once another runs.
#: _reap/2
  def _reap(g: integer, p: integer): integer do
    s = Sys.peek(g + 152)
    if s == 0 or s == Sys.peek(p + 256) do 0 else
      Sys.poke(s - 8, Sys.peek(g + 80))
      Sys.poke(g + 80, s)
      Sys.poke(g + 152, 0)
    end
  end
# The running process p, whose state is set, gives way to the next.
#: _sched/2 needs _reap/2
  def _sched(g: integer, p: integer): integer do
    Process._reap(g, p)
    n = Process.__until(Process.__any(Sys.peek(g + 160)), g)
    Sys.poke(n + 48, 1)
    if n == p do 0 else
      Sys.poke(g, n)
      Process.__switch(p, n)
    end
  end
# The running process waits until another makes it ready or the time d
# comes (0: none): 1 when the time came.
#: _wait/2 needs _sched/2 _time/3
  def _wait(g: integer, d: integer): integer do
    p = Sys.peek(g)
    Sys.poke(p + 344, 0)
    Sys.poke(p + 48, 2)
    if d > 0 do Process._time(g, p, d) end
    Process._sched(g, p)
    Sys.peek(p + 344)
  end
# Whoever waits to send to p looks again.
#: _release/2 needs _free/2 _ready/2
  def _release(g: integer, p: integer): integer do
    x = Sys.peek(p + 152)
    if x == 0 do 0 else
      Sys.poke(p + 152, Sys.peek(x))
      Process._ready(g, Sys.peek(x + 8))
      Process._free(g, x)
      Process._release(g, p)
    end
  end
# Every cell of the list at h names a process that is made ready.
#: _wake/2 needs _free/2 _ready/2
  def _wake(g: integer, h: integer): integer do
    x = Sys.peek(h)
    if x == 0 do 0 else
      Sys.poke(h, Sys.peek(x))
      Process._ready(g, Sys.peek(x + 8))
      Process._free(g, x)
      Process._wake(g, h)
    end
  end
# Supervisors that wait for a change look again.
#: _stir/2 needs _ready/2
  def _stir(g: integer, x: integer): integer do
    if x == 0 do 0 else
      Process._ready(g, Sys.peek(x + 8))
      Process._stir(g, Sys.peek(x))
    end
  end
# The processes of the list at x are asked to stop.
#: _stopall/2 needs _cancel/4
  def _stopall(g: integer, x: integer): integer do
    if x == 0 do 0 else
      n = Sys.peek(x)
      Process._cancel(g, Sys.peek(x + 8), Process.__word("shutdown"), 0)
      Process._stopall(g, n)
    end
  end
# The running process p waits until nothing it owns is left.
#: _orphan/2 needs _await/3 _drop/3
  def _orphan(g: integer, p: integer): integer do
    x = Sys.peek(p + 232)
    if x == 0 do 0 else
      Process._await(g, p, Sys.peek(x + 8))
      Process._drop(g, p + 232, Sys.peek(x + 8))
      Process._orphan(g, p)
    end
  end
# Whom p monitors is no longer monitored by it.
#: _fm/2 needs _drop/3 _free/2
  def _fm(g: integer, p: integer): integer do
    x = Sys.peek(p + 216)
    if x == 0 do 0 else
      Sys.poke(p + 216, Sys.peek(x))
      Process._drop(g, Sys.peek(x + 16) + 208, Sys.peek(x + 8))
      Process._free(g, x)
      Process._fm(g, p)
    end
  end
# The body of a process: its function, and what it ends in.
#: _run/2 needs _check/1 _done/1 _ended/0 _g/0 _note/1
  def _run(f: fn[pid[t], integer], h: pid[t]): integer do
    try do
      Process._check(Process._g())
      Process.__depth(1)
      Process._done(f(h))
    rescue
      m when Process._note(m) -> 0
    after
      Process._ended()
    end
  end
# A new process of the program with a mailbox of capacity c, not yet
# started.
#: _fresh/2 needs _capacity/1 _check/1 _new/2
  def _fresh(g: integer, c: integer): integer do
    Process._check(g)
    Process._capacity(c)
    if Sys.peek(g + 112) == 1 do raise("runtime shutting down") end
    p = Process._new(g, 0)
    Sys.poke(p + 136, c)
    p
  end
#: _pop/2 needs _free/2 _get/1 _release/2
  def _pop(g: integer, p: integer): integer do
    x = Process._get(p + 112)
    Sys.poke(g + 184, Sys.peek(x + 8))
    Process._free(g, x)
    Sys.poke(p + 128, Sys.peek(p + 128) - 1)
    Process._release(g, p)
    1
  end
#: _sleep/2 needs _wait/2
  def _sleep(g: integer, d: integer): integer do
    if Process._wait(g, d) == 1 do 0 else
      if Sys.peek(Sys.peek(g) + 56) == 1 do 0 else Process._sleep(g, d) end
    end
  end
# The main process waits until it is the only one left.
#: _last/2 needs _await/3
  def _last(g: integer, r: integer): integer do
    p = Sys.peek(g + 40)
    q = if p == r do Sys.peek(p + 80) else p end
    if q == 0 do 0 else
      Process._await(g, r, q)
      Process._last(g, r)
    end
  end
# 1 when two types, each the word of its string, are one; 0 stands for a
# type that is not known and fits any.
#: _same/2
  def _same(a: integer, b: integer): integer do
    if a == 0 or b == 0 do 1 else
      x: string = Process.__any(a)
      y: string = Process.__any(b)
      if x == y do 1 else 0 end
    end
  end
#: _tends/2 needs _tend/1
  def _tends(a: integer, n: integer): integer do
    if n == 0 do a else Process._tends(Process._tend(a), n - 1) end
  end
# The value of the type at a that the pinned runtime leaves where there is
# none (Go's zero value): 0, false, 0.0, an empty string, atom, list, map
# or set, a tuple of such; for an option and a result the nil that is
# neither of its constructors (0x400000, discriminant -1). The words
# from g + 2048 to g + 4096 stay zero.
#: _zero/2 needs _tend/1 _zeros/4 _tcount/1 _tfirst/1
  def _zero(g: integer, a: integer): integer do
    k = Sys.byte(a)
    if k == 2 or k == 22 do Process.__word("") else
      if k == 7 or k == 8 or k == 25 do
        Process.__word([])
      else
        if k == 5 do
          n = Process._tcount(a + 1)
          w = Process.__word(Sys.text(g + 2048, 8 * n))
          Sys.poke(w, n)
          Process._zeros(g, Process._tfirst(a + 1), w + 8, n)
          w
        else
          if k == 6 do
            w = Process.__word(Sys.text(g + 2048, 8))
            Sys.poke(w, -1)
            w
          else if k == 4 do 4194304 else 0 end end
        end
      end
    end
  end
# A name of the program: the cell that holds it (the name, the process, and
# a cell of the kind: 0 a process, 1 a server, 2 an agent; the type; the
# handle), or 0.
#: _named/2
  def _named(x: integer, n: string): integer do
    if x == 0 do 0 else
      s: string = Process.__any(Sys.peek(x + 8))
      if s == n do x else Process._named(Sys.peek(x), n) end
    end
  end
#: _unname/2 needs _drop/3 _free/2 _named/2
  def _unname(g: integer, n: string): integer do
    x = Process._named(Sys.peek(g + 136), n)
    if x == 0 do 0 else
      Process._free(g, Sys.peek(x + 24))
      Process._drop(g, g + 136, Sys.peek(x + 8))
    end
  end
# The cell of the kind of the living process named n, or 0.
#: _lookup/2 needs _named/2
  def _lookup(g: integer, n: string): integer do
    x = Process._named(Sys.peek(g + 136), n)
    if x == 0 do 0 else if Sys.peek(Sys.peek(x + 16) + 376) == 1 do 0 else Sys.peek(x + 24) end end
  end
# A process that is none of the program's own runs the function value w and
# is over: what the pinned runtime starts a goroutine for.
#: _go/2 needs _gone/1 _new/2 _start/3
  def _go(g: integer, w: integer): integer do
    p = Process._new(g, 1)
    v: fn[integer] = fn(): integer do Process._gone(w) end
    Process._start(g, p, Process.__word(v))
    p
  end
# What waits in the mailbox of p, each message as the function shows it,
# the last ten of a long one.
#: _waiting/2 needs Enum.join/2 _shown/3
  def _waiting(p: integer, show: fn[integer, string]): string do
    n = Sys.peek(p + 128)
    if n == 0 do "empty" else
      (if n > 10 do "(last 10 of #{n}) " else "" end) <> Enum.join(Process._shown(Sys.peek(p + 112), if n > 10 do n - 10 else 0 end, show), ", ")
    end
  end
#: _details/2 needs Enum.join/2 Enum.map/2
  def _details(pattern: string, pinned: list[string]): string do
    "\n     pattern: " <> pattern <> Enum.join(Enum.map(pinned, fn pin -> "\n     pinned:  " <> pin end), "")
  end

#: _cell/4 needs _take/2
  def _cell(g: integer, a: integer, b: integer, c: integer): integer do
    f = Sys.peek(g + 88)
    x = if f != 0 do f else Process._take(g, 32) end
    if f != 0 do Sys.poke(g + 88, Sys.peek(f)) end
    Sys.poke(x, 0)
    Sys.poke(x + 8, a)
    Sys.poke(x + 16, b)
    Sys.poke(x + 24, c)
    x
  end
# Process p is asked to stop, with the reason r and the failure text f.
#: _cancel/4 needs _ready/2 _release/2 _stir/2
  def _cancel(g: integer, p: integer, r: integer, f: integer): integer do
    if Sys.peek(p + 56) + Sys.peek(p + 376) > 0 do 0 else
      Sys.poke(p + 56, 1)
      if p == Sys.peek(g + 128) do Sys.poke(Sys.stack() - 56, 1) end
      Sys.poke(p + 176, r)
      Sys.poke(p + 184, f)
      Process._ready(g, p)
      Process._release(g, p)
      Process._stir(g, Sys.peek(g + 144))
    end
  end
# The links of p: one that traps exits gets an event, another is stopped
# when p did not end well.
#: _fl/4 needs _abnormal/1 _cancel/4 _event/5 _lcut/2
  def _fl(g: integer, p: integer, r: integer, f: integer): integer do
    x = Sys.peek(p + 224)
    if x == 0 do 0 else
      o = Sys.peek(x + 8)
      Process._lcut(g, Sys.peek(x + 16))
      Process._lcut(g, x)
      if Sys.peek(o + 376) == 0 do
        if Sys.peek(o + 312) == 1 do Process._event(g, o, 0, Sys.peek(p + 40), r) else
          if Process._abnormal(r) == 1 do
            s: string = Process.__any(r)
            Process._cancel(g, o, Process.__word("linked: " <> s), f)
          end
        end
      end
      Process._fl(g, p, r, f)
    end
  end
# Process p is over, with the reason r and the failure text f (0: none).
#: _finish/4 needs _cancel/4 _clear/2 _drop/3 _fd/3 _fl/4 _fm/2 _fw/3 _orphan/2 _release/2 _stir/2 _stopall/2 _wake/2
  def _finish(g: integer, p: integer, r0: integer, f0: integer): integer do
    if Sys.peek(p + 376) + Sys.peek(p + 336) > 0 do 0 else
      Sys.poke(p + 336, 1)
      n: string = Process.__any(r0)
      s = if Sys.peek(p + 56) == 1 and n == "normal" do 1 else 0 end
      r = if s == 1 do Sys.peek(p + 176) else r0 end
      f = if s == 1 do Sys.peek(p + 184) else f0 end
      Process._cancel(g, p, r, f)
      Process._stopall(g, Sys.peek(p + 232))
      Process._orphan(g, p)
      Sys.poke(p + 376, 1)
      Sys.poke(p + 56, 1)
      Sys.poke(p + 160, r)
      Sys.poke(p + 168, f)
      if Sys.peek(p + 320) == 0 do
        a = Sys.peek(p + 72)
        b = Sys.peek(p + 80)
        if a == 0 do Sys.poke(g + 40, b) else Sys.poke(a + 80, b) end
        if b != 0 do Sys.poke(b + 72, a) end
        Sys.poke(g + 32, Sys.peek(g + 32) - 1)
      end
      Process._fw(g, p, r)
      Process._fm(g, p)
      Process._clear(g, p + 192)
      Sys.poke(p + 200, 0)
      Process._clear(g, p + 112)
      Sys.poke(p + 120, 0)
      Sys.poke(p + 128, 0)
      Process._release(g, p)
      Process._fl(g, p, r, f)
      Process._fd(g, p, r)
      o = Sys.peek(p + 240)
      if o != 0 do Process._drop(g, o + 232, p) end
      Sys.poke(p + 240, 0)
      Process._wake(g, p + 248)
      Process._stir(g, Sys.peek(g + 144))
    end
  end
# The running process p is over and another runs.
#: _exit/4 needs _finish/4 _reap/2 _sched/2
  def _exit(g: integer, p: integer, r: integer, f: integer): integer do
    Process._finish(g, p, r, f)
    Process._reap(g, p)
    Sys.poke(g + 152, Sys.peek(p + 256))
    Sys.poke(p + 48, 3)
    Process._sched(g, p)
  end
# The word w for process q, waiting up to ms milliseconds for room: 1 or 0.
#: _send/4 needs _deliver/3 _due/2 _far/3 _sendw/4
  def _send(g: integer, q: integer, w: integer, ms: integer): integer do
    if Sys.peek(q + 320) == 2 do Process._far(1, q, w) else if Sys.peek(q + 56) == 1 do 0 else
      if Sys.peek(q + 128) < Sys.peek(q + 136) do Process._deliver(g, q, w) else
        if ms == 0 do 0 else Process._sendw(g, q, w, Process._due(g, ms)) end
      end
    end end
  end
#: _sendw/4 needs _check/1 _deliver/3 _drop/3 _has/2 _push/5 _wait/2
  def _sendw(g: integer, q: integer, w: integer, d: integer): integer do
    c = Sys.peek(g)
    if Process._has(q + 152, c) == 0 do Process._push(g, q + 152, c, 0, 0) end
    x = Process._wait(g, d)
    Process._drop(g, q + 152, c)
    if x == 1 or Sys.peek(c + 56) == 1 do Process._check(g) else
      if Sys.peek(q + 56) == 1 do 0 else
        if Sys.peek(q + 128) < Sys.peek(q + 136) do Process._deliver(g, q, w) else Process._sendw(g, q, w, d) end
      end
    end
  end
# The running process c waits up to the time d for q to be over: 1 or 0.
#: _join/4 needs _check/1 _drop/3 _has/2 _push/5 _wait/2
  def _join(g: integer, c: integer, q: integer, d: integer): integer do
    if Sys.peek(q + 376) == 1 do 1 else
