#: count/0 needs _g/0
  def count(): integer do
    Sys.peek(Process._g() + 32)
  end
#: send/3 needs _check/1 _g/0 _send/4
  def send(h: pid[t], v: t, ms: integer): boolean do
    if Process.__word(h) == 0 or h.at == 0 do raise("invalid or foreign PID") end
    g = Process._g()
    Process._check(g)
    Process._send(g, h.at, Process.__word(v), ms) == 1
  end
#: receive/2 needs _check/1 _g/0 _home/1 _recv/3 _zero/2
  def receive(h: pid[t], ms: integer): tuple[boolean, t] do
