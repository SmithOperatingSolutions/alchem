# Waiting for descriptors (the network modules, spec/alchem-network.md).
# g + 280 holds the cells of the processes that wait for one: the process,
# the descriptor with what is waited for above it (as poll takes them: 1 to
# read, 4 to write, shifted 32 bits), and what poll found. g + 288 and 296
# are the array poll is given and its room, g + 336 counts the turns since
# the descriptors were last looked at. g + 304 to 400 belong to the network
# modules (library/TCP.alc lists them).
# One poll of every descriptor waited for, for up to w nanoseconds (-1:
# until one is ready); the processes whose descriptor is ready are made
# ready.
#: _poll/2 needs _pcount/2 _pfill/2 _pmark/3
  def _poll(g: integer, w: integer): integer do
    n = Process._pcount(Sys.peek(g + 280), 0)
    if n > Sys.peek(g + 296) do
      m = Sys.call(9, 0, n * 16, 3, 34, -1, 0)
      if m < 0 do System.halt(71) end
      if Sys.peek(g + 288) != 0 do Sys.call(11, Sys.peek(g + 288), Sys.peek(g + 296) * 8) end
      Sys.poke(g + 288, m)
      Sys.poke(g + 296, n * 2)
    end
    b = Sys.peek(g + 288)
    Process._pfill(Sys.peek(g + 280), b)
    if w >= 0 do
      Sys.poke(g + 200, div(w, 1000000000))
      Sys.poke(g + 208, rem(w, 1000000000))
    end
    r = Sys.call(271, b, n, if w < 0 do 0 else g + 200 end, 0, 8)
    if r > 0 do Process._pmark(g, Sys.peek(g + 280), b) else 0 end
  end
#: _pcount/2
  def _pcount(x: integer, n: integer): integer do
    if x == 0 do n else Process._pcount(Sys.peek(x), n + 1) end
  end
#: _pfill/2
  def _pfill(x: integer, b: integer): integer do
    if x == 0 do 0 else
      Sys.poke(b, Sys.peek(x + 16))
      Process._pfill(Sys.peek(x), b + 8)
    end
  end
