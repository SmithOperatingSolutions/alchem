  def send_after(h: pid[t], v: t, ms: integer): integer do
    if Process.__word(h) == 0 or h.at == 0 do raise("invalid PID") end
    g = Process._g()
    Process._check(g)
    q = h.at
    w = Process.__word(v)
    f: fn[integer] = fn(): integer do Process._send(Process._g(), q, w, 1000) end
    Process._later(g, ms, if Sys.peek(q + 320) == 2 do 0 else q end, Process.__word(f))
  end
#: send_after/3 form 2 needs _check/1 _g/0 _later/4 _tell/3
  def send_after(n: atom, v: t, ms: integer): integer do
    t = Sys.peek(Sys.stack() - 48)
    g = Process._g()
    Process._check(g)
    s: string = Process.__any(Process.__word(n))
    w = Process.__word(v)
    f: fn[integer] = fn(): integer do Process._tell(s, t, w) end
    Process._later(g, ms, 0, Process.__word(f))
  end# The first message of the running process p that the function value w# The statements assert_receive(pid, pattern) and refute_receive(pid,
# pattern) are these calls, the pattern as a function (the compiler writes
# them: native-processes.alc). by is how far right of the statement the
# call stands (as
# Process.assert_receive); a failure is named where the statement starts.
#: assert_receive/8 needs _check/1 _details/2 _g/0 _match/4 _waiting/2 Testing._setting/2
  def assert_receive(h: pid[a], wait: integer, f: fn[a, boolean], show: fn[a, string], pattern: string, pinned: list[string], custom: string, by: integer): a do
    place = Stream.__where() - by
    ms = if wait >= 0 do wait else Testing._setting("ALCHEM_TEST_RECEIVE_TIMEOUT", 100) end
    g = Process._g()
    Process._check(g)
    p = Sys.peek(g)
    if Sys.peek(h.at + 320) == 2 do Stream.__fail(place, "this needs a process of this node; a process of another node can only be sent to") end
    if h.at != p do Stream.__fail(place, "only the mailbox owner may receive") end
    if Process._match(g, p, ms, Process.__word(f)) == 0 do
      problem = if custom != "" do custom else if ms == 0 do "no message matching the pattern has arrived" else "no message matching the pattern arrived within #{ms}ms" end end
      Stream.__fail(place, problem <> Process._details(pattern, pinned) <> "\n     mailbox: " <> Process._waiting(p, Process.__any(Process.__word(show))))
    end
    Process.__any(Sys.peek(g + 184))
  end
#: refute_receive/8 needs _check/1 _details/2 _g/0 _match/4 Testing._setting/2
  def refute_receive(h: pid[a], wait: integer, f: fn[a, boolean], show: fn[a, string], pattern: string, pinned: list[string], custom: string, by: integer): integer do
    place = Stream.__where() - by
    ms = if wait >= 0 do wait else Testing._setting("ALCHEM_TEST_RECEIVE_TIMEOUT", 100) end
    g = Process._g()
    Process._check(g)
    p = Sys.peek(g)
    if Sys.peek(h.at + 320) == 2 do Stream.__fail(place, "this needs a process of this node; a process of another node can only be sent to") end
    if h.at != p do Stream.__fail(place, "only the mailbox owner may receive") end
    if Process._match(g, p, ms, Process.__word(f)) == 1 do
      v: a = Process.__any(Sys.peek(g + 184))
      problem = if custom != "" do custom else "a message matching the pattern arrived, but none was expected" end
      Stream.__fail(place, problem <> Process._details(pattern, pinned) <> "\n     received: " <> show(v))
    end
