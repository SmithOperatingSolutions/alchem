    Process._home(h.at)
    Process._halt(h.at)
  end
#: crash/1
  def crash(r: string): integer do
    raise(r)
  end
#: monitor/1 needs _check/1 _event/5 _far/3 _g/0 _push/5 _ref/1
  def monitor(h: pid[t]): integer do
