# at again (a descriptor of -1 is passed over by poll).
#: _pmark/3 needs _ready/2
  def _pmark(g: integer, x: integer, b: integer): integer do
    if x == 0 do 0 else
      v = div(Sys.peek(b), 281474976710656)
      if v != 0 do
        Sys.poke(x + 24, v)
        Sys.poke(x + 16, 4294967295)
        Process._ready(g, Sys.peek(x + 8))
      end
      Process._pmark(g, Sys.peek(x), b + 8)
    end
  end
# The running process waits until descriptor fd can be read (e 1) or
# written (e 4), another process makes it ready, or the time d comes (0:
# none): what poll found, 0 when the wait ended otherwise.
#: _fdwait/4 needs _drop/3 _push/5 _wait/2
  def _fdwait(g: integer, fd: integer, e: integer, d: integer): integer do
    c = Sys.peek(g)
    Process._push(g, g + 280, c, fd + e * 4294967296, 0)
    x = Sys.peek(g + 280)
    Process._wait(g, d)
    r = Sys.peek(x + 24)
    Process._drop(g, g + 280, c)
    r
  end
# Whoever waits for descriptor fd, which is being closed, looks again.
#: _fdshut/3 needs _ready/2
  def _fdshut(g: integer, x: integer, fd: integer): integer do
    if x == 0 do 0 else
      if rem(Sys.peek(x + 16), 4294967296) == fd do
        Sys.poke(x + 24, 32)
        Sys.poke(x + 16, 4294967295)
        Process._ready(g, Sys.peek(x + 8))
      end
      Process._fdshut(g, Sys.peek(x), fd)
    end
  end
# Processes of other nodes (library/Node.alc, spec/alchem-nodes.md). The
# handle of one is a block like a process's with 2 at 320, its number at 40
# and at 24 the function that reaches it: 1 sends the word a, 2 says
# whether its node is connected, 3 has process a monitor it, 4 ends the
# monitor a, 5 links process a to it, 6 ends that link.
#: _far/3
  def _far(op: integer, q: integer, a: integer): integer do
    f: fn[integer, integer, integer, integer] = Process.__any(Sys.peek(q + 24))
    f(op, q, a)
  end
# What only a process of this node can be asked.
#: _home/1
  def _home(q: integer): integer do
    if Sys.peek(q + 320) == 2 do raise("this needs a process of this node; a process of another node can only be sent to") else 0 end
  end
# What another node needs to reach a registered process: the text of its
# messages' type, the node of that type and the first node, from the form
# at f (native-nodes.alc).
#: _reach/2 needs _take/2
  def _reach(g: integer, f: integer): integer do
    k = Sys.byte(f) + 256 * Sys.byte(f + 1)
    r = Process._take(g, 24)
    Sys.poke(r, Process.__word(Sys.text(f + 2, k)))
    Sys.poke(r + 8, f + 2 + k)
    Sys.poke(r + 16, f + 2 + k)
    r
  end
# The number of parts of a tuple, a function type or an instance in the
# compiler's type bytes, at a: one byte, or the byte 255 and three bytes
# (nt_counter of native-types.alc); _tfirst is where the parts start.
#: _tcount/1
  def _tcount(a: integer): integer do
    if Sys.byte(a) == 255 do Sys.byte(a + 1) + Sys.byte(a + 2) * 256 + Sys.byte(a + 3) * 65536 else Sys.byte(a) end
  end
#: _tfirst/1
  def _tfirst(a: integer): integer do
    if Sys.byte(a) == 255 do a + 4 else a + 1 end
  end
# The links of a process (the list at 224 of its record) are cells that
# know their place: 8 the other process, 16 the cell that process has for
# this one, 24 the word that points at the cell (the list's first, or the
# cell before). So a link is taken out without walking the list, and a
# process with ten thousand linked tasks ends each of them in one step.
# _pair: c and q are linked. _lcut: a cell is taken out of its list.
# _lhas: the cell of either list (x of the one that looks for a, y of the
# one that looks for b) that holds the link, 0 when the shorter list ends
# without it.
#: _pair/3 needs _cell/4
  def _pair(g: integer, c: integer, q: integer): integer do
    x = Process._cell(g, q, 0, c + 224)
    y = Process._cell(g, c, x, q + 224)
    Sys.poke(x + 16, y)
    Sys.poke(x, Sys.peek(c + 224))
    if Sys.peek(x) != 0 do Sys.poke(Sys.peek(x) + 24, x) end
    Sys.poke(c + 224, x)
    Sys.poke(y, Sys.peek(q + 224))
    if Sys.peek(y) != 0 do Sys.poke(Sys.peek(y) + 24, y) end
    Sys.poke(q + 224, y)
  end
#: _lcut/2 needs _free/2
  def _lcut(g: integer, x: integer): integer do
    n = Sys.peek(x)
    Sys.poke(Sys.peek(x + 24), n)
    if n != 0 do Sys.poke(n + 24, Sys.peek(x + 24)) end
    Process._free(g, x)
  end
#: _lhas/4
  def _lhas(x: integer, a: integer, y: integer, b: integer): integer do
    if x == 0 or y == 0 do 0 else
      if Sys.peek(x + 8) == a do x else
        if Sys.peek(y + 8) == b do y else Process._lhas(Sys.peek(x), a, Sys.peek(y), b) end
      end
    end
  end
