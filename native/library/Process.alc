# next message to look at is kept, the function, and when the wait ends.
#: _match1/1 needs _check/1 _free/2 _g/0 _release/2 _wait/2
  def _match1(x: integer): integer do
    g = Process._g()
    p = Sys.peek(g)
    y = Sys.peek(x)
    link = Sys.peek(x + 8)
    m = Sys.peek(link)
