#: r_fold/5
  def r_fold(i: integer, s: integer, n: integer, acc: b, f: fn[integer, b, b]): b do
    if n <= 0 do acc else
      if n == 1 do f(i, acc) else Enum.r_fold(i + s, s, n - 1, f(i, acc), f) end
    end
  end
