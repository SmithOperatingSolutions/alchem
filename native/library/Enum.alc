  def chunk_every(items: list[a], count: integer, step: integer, pad: list[a]): list[list[a]] do
    c = Enum.chunk_every(items, count, step)
    n = length(c) - 1
    if n < 0 do c else
      l = hd(Enum.drop(c, n))
      Enum.take(c, n) ++ [l ++ Enum.take(pad, count - length(l))]
    end
  end
#: chunk_every/4 form 2 needs chunk_every/3
  def chunk_every(items: list[a], count: integer, step: integer, pad: atom): list[list[a]] do
    if pad != :discard do raise("Enum.chunk_every takes a list to pad the last chunk with, or :discard") end
    c = Enum.chunk_every(items, count, step)
    n = length(c) - 1
    if n < 0 do c else
      if length(hd(Enum.drop(c, n))) < count do Enum.take(c, n) else c end
    end
  end
