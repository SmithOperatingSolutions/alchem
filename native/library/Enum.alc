  def min(i: list[a], f: fn[a, a, boolean]): a do Enum.o_first(i, fn x, y -> f(x, y) and not f(y, x) end) end
#: max/2 form 4 needs max/2
  def max(i: list[ord], e: fn[ord]): ord do if length(i) == 0 do e() else Enum.o_first(i, fn x, y -> y < x end) end end
