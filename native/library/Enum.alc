# Ordered functions. A type variable whose name starts with "ord" has an
# order: the compiler makes it for the type each call gives, as it makes
# equality (spec/alchem-ordering.md), and rejects a call whose type the
# pinned language does not order. On values of such a variable < <= > >= are
# the pinned less(x, y) both ways round: a NaN is neither less nor more.
# Each function works on a strict order l(x, y), "x is before y", and sorts
# with o_sort, as the pinned runtime does. o_least is the first least
# element of a stream, read as the pinned runtime reads it: one element,
# then one comparison (o_first fails when there is none). o_dir turns the
# order for :desc, o_keys sorts by keys, o_by is the least by a key, asking
# the key function for both elements at every comparison as the pinned
# runtime does, and o_pdq is List.sort. A name that starts with o_ is the
# library's own: a program cannot call it. A form that takes a list is given
# a map, a set, a range or a stream as the list of its elements, which is
# when the pinned function too reads everything before it compares; the
# forms over a stream are the functions that compare while they read.
#: o_keys/3 needs o_sort/2
  def o_keys(i: list[a], k: list[b], l: fn[b, b, boolean]): list[a] do
    n = length(i)
    g: fn[integer, integer, boolean] = fn x, y -> l(Enum.at(k, x, hd(k)), Enum.at(k, y, hd(k))) end
    if n < 2 do i else Enum.map(Enum.o_sort(Enum.map(0..n - 1, fn x -> x end), g), fn x -> Enum.at(i, x, hd(i)) end) end
  end
  def o_by(i: stream[a], f: fn[a, b], l: fn[b, b, boolean]): a do
    Enum.o_first(i, fn x, y -> l(f(x), f(y)) end)
  end
#: o_pdq/1
  def o_pdq(i: list[ord]): list[ord] do
    g: fn[ord, ord, boolean] = fn x, y -> y < x end
    Enum.reverse(Enum.o_unstable(Enum.reverse(i), g))
  end
#: sort/1
# Integers and strings that are equal are the same, so the order the
# stable sort would leave them in is the one any sort leaves: they go
# through the unstable one, which asks less often.
  def sort(i: list[integer]): list[integer] do
    g: fn[integer, integer, boolean] = fn x, y -> x < y end
    Enum.o_unstable(i, g)
  end
#: sort/1 form 2
  def sort(i: list[string]): list[string] do
    g: fn[string, string, boolean] = fn x, y -> x < y end
    Enum.o_unstable(i, g)
  end
#: sort/1 form 3 needs o_sort/2
  def sort(i: list[ord]): list[ord] do Enum.o_sort(i, fn x, y -> x < y end) end
#: max/1 needs o_sort/2
  def max(i: stream[ord]): ord do Enum.o_first(i, fn x, y -> y < x end) end
#: min/1 needs o_sort/2
  def min(i: stream[ord]): ord do Enum.o_first(i, fn x, y -> x < y end) end
#: min_max/1 needs o_sort/2
  def min_max(i: list[ord]): tuple[ord, ord] do {Enum.o_first(i, fn x, y -> x < y end), Enum.o_first(i, fn x, y -> y < x end)} end
#: sort/2 form 2 needs o_sort/2
  def sort(i: list[ord], o: atom): list[ord] do
    l: fn[ord, ord, boolean] = Enum.o_dir(o, fn x, y -> x < y end)
    Enum.o_sort(i, l)
  end
#: max/2 needs o_sort/2
  def max(i: stream[a], f: fn[a, a, boolean]): a do Enum.o_first(i, fn x, y -> f(x, y) and not f(y, x) end) end
#: min/2 needs o_sort/2
  def min(i: stream[a], f: fn[a, a, boolean]): a do Enum.o_first(i, fn x, y -> f(x, y) and not f(y, x) end) end
#: max/2 form 2 needs o_sort/2
  def max(i: stream[ord], e: fn[ord]): ord do
    case Enum.o_least(i, fn x, y -> y < x end) do
      some(x) -> x
      none -> e()
    end
  end
#: min/2 form 2 needs o_sort/2
  def min(i: stream[ord], e: fn[ord]): ord do
    case Enum.o_least(i, fn x, y -> x < y end) do
      some(x) -> x
      none -> e()
    end
  end
#: sort_by/2 needs o_keys/3
  def sort_by(i: list[a], f: fn[a, ord]): list[a] do Enum.o_keys(i, Enum.map(i, f), fn x, y -> x < y end) end
#: max_by/2 needs o_keys/3
  def max_by(i: stream[a], f: fn[a, ord]): a do Enum.o_by(i, f, fn x, y -> y < x end) end
#: min_by/2 needs o_keys/3
  def min_by(i: stream[a], f: fn[a, ord]): a do Enum.o_by(i, f, fn x, y -> x < y end) end
#: min_max_by/2 needs o_keys/3
  def min_max_by(i: list[a], f: fn[a, ord]): tuple[a, a] do {Enum.o_by(i, f, fn x, y -> x < y end), Enum.o_by(i, f, fn x, y -> y < x end)} end
#: sort_by/3 needs sort/2
  def sort_by(i: list[a], f: fn[a, b], o: fn[b, b, boolean]): list[a] do
    Enum.map(Enum.sort(Enum.map(i, fn x -> {f(x), x} end), fn x, y -> o(elem(x, 0), elem(y, 0)) end), fn x -> elem(x, 1) end)
  end
#: sort_by/3 form 2 needs o_keys/3
  def sort_by(i: list[a], f: fn[a, ord], o: atom): list[a] do
    l: fn[ord, ord, boolean] = Enum.o_dir(o, fn x, y -> x < y end)
    Enum.o_keys(i, Enum.map(i, f), l)
  end
#: max_by/3 needs o_sort/2
  def max_by(i: stream[a], f: fn[a, b], s: fn[b, b, boolean]): a do
    Enum.o_first(i, fn x, y ->
      p = f(x)
      q = f(y)
      s(p, q) and not s(q, p)
    end)
  end
#: min_by/3 needs max_by/3
  def min_by(i: stream[a], f: fn[a, b], s: fn[b, b, boolean]): a do Enum.max_by(i, f, s) end
# The same over a list as it is, for a reference such as &Enum.max/1, whose
# argument is not made a stream.
#: max/1 form 2 needs max/1
  def max(i: list[ord]): ord do Enum.o_first(i, fn x, y -> y < x end) end
#: min/1 form 2 needs min/1
  def min(i: list[ord]): ord do Enum.o_first(i, fn x, y -> x < y end) end
