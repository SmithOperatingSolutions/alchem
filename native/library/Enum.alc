# Sets and streams (spec/alchem-sets-streams.md).
#: into/2 form 5 needs Map.merge/2
  def into(items: list[a], target: set[a]): set[a] do
    MapSet.__set(Map.merge(MapSet.__map(target), Map.new(Enum.map(items, fn x -> {x, true} end))))
  end
#: into/3 form 5 needs Map.merge/2
  def into(items: list[x], target: set[a], f: fn[x, a]): set[a] do
    MapSet.__set(Map.merge(MapSet.__map(target), Map.new(Enum.map(items, fn x -> {f(x), true} end))))
  end
#: to_list/1 form 4
  def to_list(s: stream[a]): list[a] do
    Stream.__list(s)
  end
#: each/2 form 2
  def each(s: stream[a], f: fn[a, b]): tuple[] do
    w = Stream.__run(s, fn it -> Stream.__until(it, fn x -> Stream.__then(f(x), false) end) end)
    {}
  end
#: reduce/3 form 2
  def reduce(s: stream[a], start: b, f: fn[a, b, b]): b do
    acc = some(start)
    w = Stream.__run(s, fn it -> Stream.__until(it, fn x -> Stream.__then(Stream.__put(acc, f(x, Stream.__get(acc))), false) end) end)
    Stream.__get(acc)
  end
#: reduce/2 form 3 needs reduce/3
  def reduce(s: stream[a], f: fn[a, a, a]): a do
    first: option[a] = none
    acc = Enum.reduce(s, first, fn x, held ->
      case held do
        some(y) -> some(f(x, y))
        none -> some(x)
      end
    end)
    case acc do
      some(value) -> value
      none -> raise("empty error")
    end
  end
#: find/2 form 3
  def find(s: stream[a], f: fn[a, boolean]): option[a] do
    Stream.__run(s, fn it -> Stream.__until(it, f) end)
  end
#: find/3 form 3 needs find/2
  def find(s: stream[a], default: a, f: fn[a, boolean]): a do
    case Enum.find(s, f) do
      some(x) -> x
      none -> default
    end
  end
#: find_index/2 form 3
  def find_index(s: stream[a], f: fn[a, boolean]): option[integer] do
    at = some(0)
    case Stream.__run(s, fn it -> Stream.__until(it, fn x -> if f(x) do true else Stream.__then(Stream.__put(at, Stream.__get(at) + 1), false) end end) end) do
      some(_) -> at
      none -> none
    end
  end
#: find_value/2 form 3
  def find_value(s: stream[a], f: fn[a, option[b]]): option[b] do
    start: option[b] = none
    out = some(start)
    w = Stream.__run(s, fn it -> Stream.__until(it, fn x -> Stream.__get(Stream.__put(out, f(x))) != none end) end)
    case Stream.__get(out) do
      some(x) -> some(x)
      none -> start
    end
  end
#: find_value/3 form 3 needs find_value/2
  def find_value(s: stream[a], default: b, f: fn[a, option[b]]): b do
    case Enum.find_value(s, f) do
      some(x) -> x
      none -> default
    end
  end
#: any?/2 form 3
  def any?(s: stream[a], f: fn[a, boolean]): boolean do
    case Stream.__run(s, fn it -> Stream.__until(it, f) end) do
      some(_) -> true
      none -> false
    end
  end
#: any?/1 form 2 needs any?/2
  def any?(s: stream[boolean]): boolean do
    Enum.any?(s, fn x -> x end)
  end
#: all?/2 form 3
  def all?(s: stream[a], f: fn[a, boolean]): boolean do
    case Stream.__run(s, fn it -> Stream.__until(it, fn x -> not f(x) end) end) do
      some(_) -> false
      none -> true
    end
  end
#: all?/1 form 2 needs all?/2
  def all?(s: stream[boolean]): boolean do
    Enum.all?(s, fn x -> x end)
  end
#: member?/2 form 3 needs any?/2
  def member?(s: stream[a], value: a): boolean do
    Enum.any?(s, fn x -> x == value end)
  end
# A position from the end is known once the stream ends.
#: at/2 form 2
  def at(s: stream[a], index: integer): option[a] do
    left = some(index)
    if index < 0 do Enum.at(Stream.__list(s), index) else
      Stream.__run(s, fn it -> Stream.__until(it, fn x -> Stream.__get(left) == 0 or Stream.__then(Stream.__put(left, Stream.__get(left) - 1), false) end) end)
    end
  end
#: at/3 form 2 needs at/2
  def at(s: stream[a], index: integer, default: a): a do
    case Enum.at(s, index) do
      some(x) -> x
      none -> default
    end
  end
#: fetch/2 form 2 needs at/2
  def fetch(s: stream[a], index: integer): option[a] do
    Enum.at(s, index)
  end
#: fetch!/2 form 3 needs at/2
  def fetch!(s: stream[a], index: integer): a do
    case Enum.at(s, index) do
      some(x) -> x
      none -> raise("out of bounds error")
    end
  end
#: empty?/1
  def empty?(s: stream[a]): boolean do
    case Stream.__run(s, fn it -> it() end) do
      some(_) -> false
      none -> true
    end
  end
#: count_until/3 form 3
  def count_until(s: stream[a], f: fn[a, boolean], limit: integer): integer do
    if limit < 1 do raise("count_until needs a positive limit") end
    n = some(0)
    w = Stream.__run(s, fn it -> Stream.__until(it, fn x -> Stream.__get(if f(x) do Stream.__put(n, Stream.__get(n) + 1) else n end) >= limit end) end)
    Stream.__get(n)
  end
#: count_until/2 form 3 needs count_until/3
  def count_until(s: stream[a], limit: integer): integer do
    Enum.count_until(s, fn x -> true end, limit)
  end
#: reduce_while/3 form 3
  def reduce_while(s: stream[a], start: b, f: fn[a, b, tuple[boolean, b]]): b do
    acc = some({false, start})
    w = Stream.__run(s, fn it -> Stream.__until(it, fn x -> elem(Stream.__get(Stream.__put(acc, f(x, elem(Stream.__get(acc), 1)))), 0) end) end)
    elem(Stream.__get(acc), 1)
  end
#: count/1 needs reduce/3
  def count(s: stream[a]): integer do
    Enum.reduce(s, 0, fn x, n -> n + 1 end)
  end
#: count/2 form 3 needs reduce/3
  def count(s: stream[a], f: fn[a, boolean]): integer do
    Enum.reduce(s, 0, fn x, n -> if f(x) do n + 1 else n end end)
  end
#: sum/1 needs reduce/3
  def sum(s: stream[integer]): integer do
    Enum.reduce(s, 0, fn x, total -> total + x end)
  end
#: slice/3 form 2 needs Stream.take/2 Stream.drop/2
  def slice(s: stream[a], start: integer, count: integer): list[a] do
    if count < 0 do raise("slice needs a nonnegative amount") end
    if start < 0 do Enum.slice(Stream.__list(s), start, count) else Stream.__list(Stream.take(Stream.drop(s, start), count)) end
  end
#: zip_reduce/4 form 3 needs reduce/3 Stream.zip/2
  def zip_reduce(left: stream[a], right: stream[b], acc: c, f: fn[a, b, c, c]): c do
    Enum.reduce(Stream.zip(left, right), acc, fn pair, state -> f(elem(pair, 0), elem(pair, 1), state) end)
  end
#: concat/2 form 4
  def concat(left: list[a], right: list[a]): list[a] do
    left ++ right
  end
# A function is called for an element as the stream gives it.
#: sum_by/2 form 5 needs reduce/3
  def sum_by(s: stream[a], f: fn[a, integer]): integer do
    Enum.reduce(s, 0, fn x, total -> total + f(x) end)
  end
#: product_by/2 form 5 needs reduce/3
  def product_by(s: stream[a], f: fn[a, integer]): integer do
    Enum.reduce(s, 1, fn x, total -> total * f(x) end)
  end
#: frequencies_by/2 form 3 needs frequencies/1 Stream.map/2
  def frequencies_by(s: stream[a], f: fn[a, k]): map[k, integer] do
    Enum.frequencies(Stream.__list(Stream.map(s, f)))
  end
#: group_by/3 form 3 needs group_by/3 Stream.map/2
  def group_by(s: stream[a], key: fn[a, k], value: fn[a, v]): map[k, list[v]] do
    Enum.group_by(Stream.__list(Stream.map(s, fn x -> {key(x), value(x)} end)), fn pair -> elem(pair, 0) end, fn pair -> elem(pair, 1) end)
  end
#: group_by/2 form 3 needs group_by/3
  def group_by(s: stream[a], key: fn[a, k]): map[k, list[a]] do
    Enum.group_by(s, key, fn x -> x end)
  end
#: split_with/2 form 3 needs Stream.map/2
  def split_with(s: stream[a], f: fn[a, boolean]): tuple[list[a], list[a]] do
    pairs = Stream.__list(Stream.map(s, fn x -> {x, f(x)} end))
    {Enum.map(Enum.filter(pairs, fn pair -> elem(pair, 1) end), fn pair -> elem(pair, 0) end), Enum.map(Enum.filter(pairs, fn pair -> not elem(pair, 1) end), fn pair -> elem(pair, 0) end)}
  end
#: map_reduce/3 form 3 needs Stream.map/2
  def map_reduce(s: stream[a], acc: c, f: fn[a, c, tuple[b, c]]): tuple[list[b], c] do
    state = some(acc)
    out = Stream.__list(Stream.map(s, fn x ->
      step = f(x, Stream.__get(state))
      Stream.__then(Stream.__put(state, elem(step, 1)), elem(step, 0))
    end))
    {out, Stream.__get(state)}
  end
#: flat_map_reduce/3 form 3 needs map_reduce/3 List.flatten/1
  def flat_map_reduce(s: stream[a], acc: c, f: fn[a, c, tuple[list[b], c]]): tuple[list[b], c] do
    done = Enum.map_reduce(s, acc, f)
    {List.flatten(elem(done, 0)), elem(done, 1)}
  end
#: with_index/2 form 5 needs Stream.map/2 Stream.with_index/1
  def with_index(s: stream[a], f: fn[a, integer, b]): list[b] do
    Stream.__list(Stream.map(Stream.with_index(s), fn pair -> f(elem(pair, 0), elem(pair, 1)) end))
  end
#: map_intersperse/3 form 3 needs Stream.map/2 intersperse/2
  def map_intersperse(s: stream[a], separator: b, f: fn[a, b]): list[b] do
    Enum.intersperse(Stream.__list(Stream.map(s, f)), separator)
  end
#: into/3 form 6 needs Stream.map/2
  def into(s: stream[x], target: list[a], f: fn[x, a]): list[a] do
    target ++ Stream.__list(Stream.map(s, f))
  end
#: into/3 form 7 needs Stream.map/2 into/2
  def into(s: stream[x], target: map[k, v], f: fn[x, tuple[k, v]]): map[k, v] do
    Enum.into(Stream.__list(Stream.map(s, f)), target)
  end
#: into/3 form 8 needs Stream.map/2 into/2
  def into(s: stream[x], target: set[a], f: fn[x, a]): set[a] do
    Enum.into(Stream.__list(Stream.map(s, f)), target)
  end
#: into/3 form 9 needs Stream.map/2
  def into(s: stream[x], target: string, f: fn[x, string]): string do
    target <> Enum.join(Stream.__list(Stream.map(s, f)), "")
  end
#: map_join/3 form 10 needs Stream.map/2
  def map_join(s: stream[a], separator: string, f: fn[a, string]): string do
    Enum.join(Stream.__list(Stream.map(s, f)), separator)
  end
#: map_join/3 form 11 needs Stream.map/2
  def map_join(s: stream[a], separator: string, f: fn[a, integer]): string do
    Enum.join(Stream.__list(Stream.map(s, fn x -> Integer.to_string(f(x)) end)), separator)
  end
#: map_join/2 form 10 needs map_join/3
  def map_join(s: stream[a], f: fn[a, string]): string do
    Enum.map_join(s, "", f)
  end
#: map_join/2 form 11 needs map_join/3
  def map_join(s: stream[a], f: fn[a, integer]): string do
    Enum.map_join(s, "", f)
  end
# ---- tables ----
# A table for counting, grouping and telling apart: mapped memory of slots
# of two words, a key and what is kept for it (never 0, which is a free
# slot), twice as many as there can be keys, found by a number made of the
# key and tried one after the other from there. Word 0 is the number of
# slots less one. A string key is its address and is compared by its
# bytes. No function of the program runs while a table stands, so it is
# always given back (h_free); without memory for one (h_new gives 0) the
# way through a map is taken.
#: h_new/1 needs h_cap/2
  def h_new(n: integer): integer do
    c = Enum.h_cap(16, n * 2)
    m = Sys.call(9, 0, c * 16 + 16, 3, 34, -1, 0)
    if m < 0 do 0 else
      Sys.poke(m, c - 1)
      m
    end
  end
#: h_cap/2
  def h_cap(c: integer, n: integer): integer do
    if c >= n do c else Enum.h_cap(c * 2, n) end
  end
#: h_free/1
  def h_free(t: integer): integer do
    Sys.call(11, t, (Sys.peek(t) + 1) * 16 + 16)
  end
# h_mix: a number of h and the word v, their bits well stirred: two
# products of 31 bits each, which fit.
#: h_mix/2
  def h_mix(h: integer, v: integer): integer do
    x = h ^^^ v
    a = (x &&& 2147483647) * 2654435761
    b = ((x >>> 31) &&& 2147483647) * 2246822519
    a ^^^ (b <<< 7) ^^^ (b >>> 23) ^^^ (x >>> 62) ^^^ (a >>> 29)
  end
# h_int: the slot of the integer k: its own, or the free one it takes.
#: h_int/2 needs h_mix/2 h_at/3
  def h_int(t: integer, k: integer): integer do
    Enum.h_at(t, k, Enum.h_mix(0, k) &&& Sys.peek(t))
  end
#: h_at/3
  def h_at(t: integer, k: integer, i: integer): integer do
    s = t + 16 + i * 16
    if Sys.peek(s + 8) == 0 or Sys.peek(s) == k do s else Enum.h_at(t, k, (i + 1) &&& Sys.peek(t)) end
  end
# h_str: the slot of the string k. h_hash: the number of n bytes at a,
# eight at a time.
#: h_str/2 needs h_hash/3 h_sat/3
  def h_str(t: integer, k: string): integer do
    Enum.h_sat(t, k, Enum.h_hash(Sys.addr(k), byte_size(k), byte_size(k)) &&& Sys.peek(t))
  end
#: h_hash/3 needs h_mix/2
  def h_hash(a: integer, n: integer, h: integer): integer do
    if n >= 8 do Enum.h_hash(a + 8, n - 8, Enum.h_mix(h, Sys.peek(a))) else
      if n == 0 do h else Enum.h_mix(h, Sys.peek(a) &&& ((1 <<< (n * 8)) - 1)) end
    end
  end
#: h_sat/3
  def h_sat(t: integer, k: string, i: integer): integer do
    s = t + 16 + i * 16
    if Sys.peek(s + 8) == 0 do s else
      o: string = Process.__any(Sys.peek(s))
      if o == k do s else Enum.h_sat(t, k, (i + 1) &&& Sys.peek(t)) end
    end
  end
# h_count: every integer counted; the different ones, in no order.
# h_counts: the same for strings. h_uniq and h_uniqs: those met for the
# first time before done, the last first. h_group: every item put before
# the group of its key; the different keys.
#: h_count/3 needs h_int/2
  def h_count(items: list[integer], t: integer, ks: list[integer]): list[integer] do
    case items do
      [] -> ks
      [x | rest] ->
        s = Enum.h_int(t, x)
        n = Sys.peek(s + 8)
        Sys.poke(s, x)
        Sys.poke(s + 8, n + 1)
        Enum.h_count(rest, t, if n == 0 do [x | ks] else ks end)
    end
  end
#: h_counts/3 needs h_str/2
  def h_counts(items: list[string], t: integer, ks: list[string]): list[string] do
    case items do
      [] -> ks
      [x | rest] ->
        s = Enum.h_str(t, x)
        n = Sys.peek(s + 8)
        if n == 0 do Sys.poke(s, Process.__word(x)) end
        Sys.poke(s + 8, n + 1)
        Enum.h_counts(rest, t, if n == 0 do [x | ks] else ks end)
    end
  end
#: h_uniq/3 needs h_int/2
  def h_uniq(items: list[integer], t: integer, done: list[integer]): list[integer] do
    case items do
      [] -> done
      [x | rest] ->
        s = Enum.h_int(t, x)
        n = Sys.peek(s + 8)
        Sys.poke(s, x)
        Sys.poke(s + 8, 1)
        Enum.h_uniq(rest, t, if n == 0 do [x | done] else done end)
    end
  end
#: h_uniqs/3 needs h_str/2
  def h_uniqs(items: list[string], t: integer, done: list[string]): list[string] do
    case items do
      [] -> done
      [x | rest] ->
        s = Enum.h_str(t, x)
        n = Sys.peek(s + 8)
        if n == 0 do Sys.poke(s, Process.__word(x)) end
        Sys.poke(s + 8, 1)
        Enum.h_uniqs(rest, t, if n == 0 do [x | done] else done end)
    end
  end
#: h_group/4 needs h_int/2
  def h_group(items: list[a], ks: list[integer], t: integer, ds: list[integer]): list[integer] do
    case items do
      [] -> ds
      [x | rest] ->
        k = hd(ks)
        s = Enum.h_int(t, k)
        v = Sys.peek(s + 8)
        old: list[a] = if v == 0 do [] else Process.__any(v) end
        Sys.poke(s, k)
        Sys.poke(s + 8, Process.__word([x | old]))
        Enum.h_group(rest, tl(ks), t, if v == 0 do [k | ds] else ds end)
    end
  end
