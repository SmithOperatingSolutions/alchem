# o_sort sorts by g, "x is less than y", with the pinned runtime's stable
# sort (Go's slices.SortStableFunc: insertion sort over blocks of 20, then
# SymMerge), which the compiler has as machine code that sorts a copy in
# place (Enum.o_stable): g is called with the same pairs in the same order,
# so a g that is no order (a sorter that is not one, floats with NaN) gives
# the same list. For sort/2 one element is less than another when the other
# may not come before it, and the sorter is asked as the pinned comparison
# asks it.
#: sort/2 needs o_sort/2
  def sort(items: list[a], f: fn[a, a, boolean]): list[a] do
    Enum.o_sort(items, fn x, y -> if f(y, x) do f(x, y) and false else true end end)
  end
#: o_sort/2 needs reduce/3
  def o_sort(items: list[a], g: fn[a, a, boolean]): list[a] do Enum.o_stable(items, g) end
  def o_least(s: stream[a], l: fn[a, a, boolean]): option[a] do
    start: option[a] = none
    Enum.reduce(s, start, fn x, b ->
      case b do
        some(y) -> if l(x, y) do some(x) else b end
        none -> some(x)
      end
    end)
  end
  def o_first(s: stream[a], l: fn[a, a, boolean]): a do
    case Enum.o_least(s, l) do
      some(x) -> x
      none -> raise("empty error")
    end
  end
  def o_dir(o: atom, l: fn[a, a, boolean]): fn[a, a, boolean] do
    if o != :asc and o != :desc do raise("the sort order is :asc or :desc, not :#{o}") end
    if o == :asc do l else fn x, y -> l(y, x) end end
  end
#: chunk_while/4
  def chunk_while(items: list[a], first: s, step: fn[a, s, tuple[option[c], s]], last: fn[s, option[c]]): list[c] do
    start: tuple[list[c], s] = {[], first}
    done = Enum.reduce(items, start, fn x, acc ->
      moved = step(x, elem(acc, 1))
      case elem(moved, 0) do
        some(chunk) -> {[chunk | elem(acc, 0)], elem(moved, 1)}
        none -> {elem(acc, 0), elem(moved, 1)}
      end
    end)
    case last(elem(done, 1)) do
      some(chunk) -> Enum.o_turn([chunk | elem(done, 0)])
      none -> Enum.o_turn(elem(done, 0))
    end
  end
