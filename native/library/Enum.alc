  def into(items: map[k, v], target: map[j, w], f: fn[tuple[k, v], tuple[j, w]]): map[j, w] do
    Enum.into(Map.to_list(items), target, f)
  end
#: max/3 needs o_sort/2
  def max(items: stream[a], f: fn[a, a, boolean], empty: fn[a]): a do
    case Enum.o_least(items, fn x, y -> f(x, y) and not f(y, x) end) do
      some(x) -> x
      none -> empty()
    end
  end
#: min/3 needs max/3
  def min(items: stream[a], f: fn[a, a, boolean], empty: fn[a]): a do Enum.max(items, f, empty) end
#: zip/1 needs List.zip/1
  def zip(lists: list[list[a]]): list[list[a]] do
    List.zip(lists)
  end
#: zip_with/2 needs List.zip/1
  def zip_with(lists: list[list[a]], f: fn[list[a], b]): list[b] do
    Enum.map(List.zip(lists), f)
