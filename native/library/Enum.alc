#: reduce_while/3
  def reduce_while(items: list[a], start: b, f: fn[a, b, tuple[boolean, b]]): b do
    stepped(items, start, f)
  end
  defp stepped(items: list[a], acc: b, f: fn[a, b, tuple[boolean, b]]): b do
    case items do
      [] -> acc
      [x | rest] ->
        step = f(x, acc)
        if elem(step, 0) do elem(step, 1) else stepped(rest, elem(step, 1), f) end
    end
  end
#: random/1
  def random(items: list[a]): a do
    if items == [] do raise("empty error") end
    hd(Enum.drop(items, rem(rem(System.system_time(), 2147483647) * 48271, 2147483647) % length(items)))
  end
#: shuffle/1
# Each element gets the next number of a sequence that starts at the clock,
# and the elements are put in the order of their numbers.
  def shuffle(items: list[a]): list[a] do
    start: tuple[integer, list[tuple[integer, a]]] = {rem(System.system_time(), 2147483647), Enum.o_room(length(items))}
    keyed = elem(Enum.reduce(items, start, fn x, acc ->
      next = rem(elem(acc, 0) * 48271 + 11, 2147483647)
      {next, [{next, x} | elem(acc, 1)]}
    end), 1)
    less: fn[tuple[integer, a], tuple[integer, a], boolean] = fn p, q -> elem(p, 0) < elem(q, 0) end
    Enum.map(Enum.o_stable(keyed, less), fn p -> elem(p, 1) end)
  end
