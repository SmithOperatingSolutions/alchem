# Enum: the functions written in Alchem, over lists. The compiler appends the
# ones a program mentions (scripts/generate-prelude.py). Those that build a
# list element by element put each element before the ones they have, which
# costs no copy (spec/alchem-lists.md), and turn the list round where it
# lies at the end (Enum.o_turn: nobody else has the list yet); one that
# knows how long its list gets takes the room for it at once (Enum.o_room).
#: all?/1
  def all?(items: list[boolean]): boolean do
    Enum.reduce(items, true, fn x, acc -> acc and x end)
  end
#: all?/2
  def all?(items: list[a], f: fn[a, boolean]): boolean do
    Enum.reduce(items, true, fn x, acc -> if acc do f(x) else false end end)
  end
#: any?/1
  def any?(items: list[boolean]): boolean do
    Enum.reduce(items, false, fn x, acc -> acc or x end)
  end
#: any?/2
  def any?(items: list[a], f: fn[a, boolean]): boolean do
    Enum.reduce(items, false, fn x, acc -> if acc do true else f(x) end end)
  end
#: count/2 needs c_if/3
  def count(items: list[a], f: fn[a, boolean]): integer do
    Enum.c_if(items, f, 0)
  end
# c_if: n and the elements f holds for, counted without a list of them.
#: c_if/3
  def c_if(items: list[a], f: fn[a, boolean], n: integer): integer do
    case items do
      [] -> n
      [x | rest] -> Enum.c_if(rest, f, if f(x) do n + 1 else n end)
    end
  end
#: reject/2
  def reject(items: list[a], f: fn[a, boolean]): list[a] do
    Enum.filter(items, fn x -> not f(x) end)
  end
#: find/2
  def find(items: list[a], f: fn[a, boolean]): option[a] do
    start: option[a] = none
    Enum.reduce(items, start, fn x, acc ->
      case acc do
        some(_) -> acc
        none -> if f(x) do some(x) else none end
      end
    end)
  end
#: find/3 needs find/2
  def find(items: list[a], default: a, f: fn[a, boolean]): a do
    case Enum.find(items, f) do
      some(x) -> x
      none -> default
    end
  end
#: find_index/2
  def find_index(items: list[a], f: fn[a, boolean]): option[integer] do
    start: tuple[integer, option[integer]] = {0, none}
    elem(Enum.reduce(items, start, fn x, acc ->
      case elem(acc, 1) do
        some(_) -> acc
        none -> if f(x) do {elem(acc, 0), some(elem(acc, 0))} else {elem(acc, 0) + 1, none} end
      end
    end), 1)
  end
#: find_value/2
  def find_value(items: list[a], f: fn[a, option[b]]): option[b] do
    start: option[b] = none
    Enum.reduce(items, start, fn x, acc ->
      case acc do
        some(_) -> acc
        none ->
          found = f(x)
          case found do
            some(_) -> found
            none -> start
          end
      end
    end)
  end
#: find_value/3 needs find_value/2
  def find_value(items: list[a], default: b, f: fn[a, option[b]]): b do
    case Enum.find_value(items, f) do
      some(x) -> x
      none -> default
    end
  end
#: member?/2
  def member?(items: list[a], value: a): boolean do
    value in items
  end
#: flat_map/2 needs concat/1
  def flat_map(items: list[a], f: fn[a, list[b]]): list[b] do
    Enum.concat(Enum.map(items, f))
  end
#: concat/1
  def concat(lists: list[list[a]]): list[a] do
    start: list[a] = Enum.o_room(Enum.reduce(lists, 0, fn x, n -> n + length(x) end))
    before: fn[a, list[a], list[a]] = fn y, all -> [y | all] end
    Enum.o_turn(Enum.reduce(lists, start, fn x, acc -> Enum.reduce(x, acc, before) end))
  end
#: intersperse/2
  def intersperse(items: list[a], separator: a): list[a] do
    start: list[a] = Enum.o_room(2 * length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc -> if length(acc) == 0 do [x | acc] else [x, separator | acc] end end))
  end
#: map_intersperse/3
  def map_intersperse(items: list[a], separator: b, f: fn[a, b]): list[b] do
    start: list[b] = Enum.o_room(2 * length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc -> if length(acc) == 0 do [f(x) | acc] else [f(x), separator | acc] end end))
  end
#: dedup/1
  def dedup(items: list[a]): list[a] do
    start: list[a] = Enum.o_room(length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc -> if length(acc) > 0 and hd(acc) == x do acc else [x | acc] end end))
  end
#: dedup_by/2
  def dedup_by(items: list[a], f: fn[a, b]): list[a] do
    start: list[a] = Enum.o_room(length(items))
    case items do
      [] -> start
      [x | rest] -> Enum.o_turn(by_dedup(rest, f, f(x), [x | start]))
    end
  end
  # done holds the elements kept, the last one first; k is the key of the
  # element before.
  defp by_dedup(items: list[a], f: fn[a, b], k: b, done: list[a]): list[a] do
    case items do
      [] -> done
      [x | rest] ->
        next = f(x)
        by_dedup(rest, f, next, if next == k do done else [x | done] end)
    end
  end
# The elements seen are kept as the keys of a map when their type has an
# order (integers and strings then cost a search by halves each, where the
# list of those kept was gone through for every element); other types take
# the next form but one, which goes through that list.
#: uniq/1 needs h_new/1 h_free/1 h_uniq/3 uniq_fold/3
# Integers and strings are told apart through a table (h_new, at the end
# of this file) instead of a map that is copied for each new one.
  def uniq(items: list[integer]): list[integer] do
    t = Enum.h_new(length(items))
    start: list[integer] = Enum.o_room(length(items))
    seen: map[integer, boolean] = %{}
    if t == 0 do Enum.o_turn(Enum.uniq_fold(items, start, seen)) else
      r = Enum.o_turn(Enum.h_uniq(items, t, start))
      Enum.h_free(t)
      r
    end
  end
#: uniq/1 form 3 needs h_new/1 h_free/1 h_uniqs/3 uniq_fold/3
  def uniq(items: list[string]): list[string] do
    t = Enum.h_new(length(items))
    start: list[string] = Enum.o_room(length(items))
    seen: map[string, boolean] = %{}
    if t == 0 do Enum.o_turn(Enum.uniq_fold(items, start, seen)) else
      r = Enum.o_turn(Enum.h_uniqs(items, t, start))
      Enum.h_free(t)
      r
    end
  end
#: uniq/1 form 4 needs uniq_fold/3
  def uniq(items: list[ordk]): list[ordk] do
    start: list[ordk] = Enum.o_room(length(items))
    seen: map[ordk, boolean] = %{}
    Enum.o_turn(Enum.uniq_fold(items, start, seen))
  end
#: uniq_fold/3
  def uniq_fold(items: list[ordk], done: list[ordk], seen: map[ordk, boolean]): list[ordk] do
    case items do
      [] -> done
      [x | rest] -> if Map.has_key?(seen, x) do Enum.uniq_fold(rest, done, seen) else Enum.uniq_fold(rest, [x | done], Map.o_put(seen, x, true)) end
    end
  end
#: uniq/1 form 5
  def uniq(items: list[a]): list[a] do
    start: list[a] = Enum.o_room(length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc -> if x in acc do acc else [x | acc] end end))
  end
#: uniq_by/2
  def uniq_by(items: list[a], f: fn[a, b]): list[a] do
    start: tuple[list[a], list[b]] = {Enum.o_room(length(items)), Enum.o_room(length(items))}
    Enum.o_turn(elem(Enum.reduce(items, start, fn x, acc ->
      k = f(x)
      if k in elem(acc, 1) do acc else {[x | elem(acc, 0)], [k | elem(acc, 1)]} end
    end), 0))
  end
#: with_index/1
  def with_index(items: list[a]): list[tuple[a, integer]] do
    start: list[tuple[a, integer]] = Enum.o_room(length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc -> [{x, length(acc)} | acc] end))
  end
#: with_index/2
# The index wraps around in 64 bits, as the pinned runtime's does.
  def with_index(items: list[a], offset: integer): list[tuple[a, integer]] do
    start: list[tuple[a, integer]] = Enum.o_room(length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc ->
      i = length(acc)
      [{x, if offset > 9223372036854775807 - i do (i - 9223372036854775807 - 1) + (offset - 9223372036854775807 - 1) else i + offset end} | acc]
    end))
  end
#: zip/2
  def zip(left: list[a], right: list[b]): list[tuple[a, b]] do
    start: list[tuple[a, b]] = Enum.o_room(if length(left) < length(right) do length(left) else length(right) end)
    Enum.o_turn(Enum.reduce(left, start, fn x, acc ->
      if length(acc) < length(right) do [{x, hd(Enum.drop(right, length(acc)))} | acc] else acc end
    end))
  end
#: unzip/1
  def unzip(pairs: list[tuple[a, b]]): tuple[list[a], list[b]] do
    {Enum.map(pairs, fn p -> elem(p, 0) end), Enum.map(pairs, fn p -> elem(p, 1) end)}
  end
#: zip_with/3
  def zip_with(left: list[a], right: list[b], f: fn[a, b, c]): list[c] do
    start: list[c] = Enum.o_room(if length(left) < length(right) do length(left) else length(right) end)
    Enum.o_turn(with_zip(left, right, f, start))
  end
  defp with_zip(left: list[a], right: list[b], f: fn[a, b, c], done: list[c]): list[c] do
    case left do
      [] -> done
      [x | more] ->
        case right do
          [] -> done
          [y | others] -> with_zip(more, others, f, [f(x, y) | done])
        end
    end
  end
#: zip_reduce/4 needs zip/2
  def zip_reduce(left: list[a], right: list[b], start: c, f: fn[a, b, c, c]): c do
    Enum.reduce(Enum.zip(left, right), start, fn p, acc -> f(elem(p, 0), elem(p, 1), acc) end)
  end
#: take_while/2
  def take_while(items: list[a], f: fn[a, boolean]): list[a] do
    Enum.take(items, taken(items, f, 0))
  end
  defp taken(items: list[a], f: fn[a, boolean], index: integer): integer do
    case Enum.at(items, index) do
      some(x) -> if index < length(items) do if f(x) do taken(items, f, index + 1) else index end else index end
      none -> index
    end
  end
#: drop_while/2
  def drop_while(items: list[a], f: fn[a, boolean]): list[a] do
    Enum.drop(items, dropped(items, f, 0))
  end
  defp dropped(items: list[a], f: fn[a, boolean], index: integer): integer do
    case Enum.at(items, index) do
      some(x) -> if index < length(items) do if f(x) do dropped(items, f, index + 1) else index end else index end
      none -> index
    end
  end
#: split_while/2
  def split_while(items: list[a], f: fn[a, boolean]): tuple[list[a], list[a]] do
    count = split_point(items, f, 0)
    {Enum.take(items, count), Enum.drop(items, count)}
  end
  defp split_point(items: list[a], f: fn[a, boolean], index: integer): integer do
    case Enum.at(items, index) do
      some(x) -> if index < length(items) do if f(x) do split_point(items, f, index + 1) else index end else index end
      none -> index
    end
  end
#: split/2
  def split(items: list[a], count: integer): tuple[list[a], list[a]] do
    # Not max(...): beside Enum.max/2 in a program that name is the library's.
    at = if count < 0 do if length(items) + count < 0 do 0 else length(items) + count end else count end
    {Enum.take(items, at), Enum.drop(items, at)}
  end
#: split_with/2
  def split_with(items: list[a], f: fn[a, boolean]): tuple[list[a], list[a]] do
    yes: list[a] = Enum.o_room(length(items))
    no: list[a] = Enum.o_room(length(items))
    with_split(items, f, yes, no)
  end
  defp with_split(items: list[a], f: fn[a, boolean], yes: list[a], no: list[a]): tuple[list[a], list[a]] do
    case items do
      [] -> {Enum.o_turn(yes), Enum.o_turn(no)}
      [x | rest] -> if f(x) do with_split(rest, f, [x | yes], no) else with_split(rest, f, yes, [x | no]) end
    end
  end
#: chunk_every/2 needs chunk_every/3
  def chunk_every(items: list[a], count: integer): list[list[a]] do
    Enum.chunk_every(items, count, count)
  end
#: chunk_every/3
  def chunk_every(items: list[a], count: integer, step: integer): list[list[a]] do
    if count < 1 or step < 1 do raise("chunk_every needs a positive count and step") end
    start: list[list[a]] = Enum.o_room(div(length(items), step) + 1)
    chunks(items, count, step, 0, start)
  end
  defp chunks(items: list[a], count: integer, step: integer, from: integer, done: list[list[a]]): list[list[a]] do
    w = length(items) - from
    if w >= count do chunks(items, count, step, from + step, [Enum.slice(items, from, count) | done]) else
      if w > 0 and (step >= count or w > count - step) do Enum.o_turn([Enum.drop(items, from) | done]) else Enum.o_turn(done) end
    end
  end
#: chunk_by/2
  def chunk_by(items: list[a], f: fn[a, b]): list[list[a]] do
    done: list[list[a]] = []
    case items do
      [] -> done
      [x | rest] -> by_chunks(rest, f, f(x), [x], done)
    end
  end
  # The chunk being filled for key k, its last element first, and the chunks
  # done, the last one first.
  defp by_chunks(items: list[a], f: fn[a, b], k: b, chunk: list[a], done: list[list[a]]): list[list[a]] do
    case items do
      [] -> Enum.o_turn([Enum.o_turn(chunk) | done])
      [x | rest] ->
        next = f(x)
        if next == k do by_chunks(rest, f, k, [x | chunk], done) else by_chunks(rest, f, next, [x], [Enum.o_turn(chunk) | done]) end
    end
  end
#: scan/2
  def scan(items: list[a], f: fn[a, a, a]): list[a] do
    start: list[a] = Enum.o_room(length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc ->
      if length(acc) == 0 do [x | acc] else [f(x, hd(acc)) | acc] end
    end))
  end
#: scan/3
  def scan(items: list[a], first: b, f: fn[a, b, b]): list[b] do
    start: list[b] = Enum.o_room(length(items))
    Enum.o_turn(scanned(items, first, f, start))
  end
  defp scanned(items: list[a], last: b, f: fn[a, b, b], done: list[b]): list[b] do
    case items do
      [] -> done
      [x | rest] ->
        v = f(x, last)
        scanned(rest, v, f, [v | done])
    end
  end
#: map_reduce/3
  def map_reduce(items: list[a], first: c, f: fn[a, c, tuple[b, c]]): tuple[list[b], c] do
    start: list[b] = Enum.o_room(length(items))
    reduced_map(items, first, f, start)
  end
  defp reduced_map(items: list[a], acc: c, f: fn[a, c, tuple[b, c]], done: list[b]): tuple[list[b], c] do
    case items do
      [] -> {Enum.o_turn(done), acc}
      [x | rest] ->
        step = f(x, acc)
        reduced_map(rest, elem(step, 1), f, [elem(step, 0) | done])
    end
  end
#: flat_map_reduce/3
  def flat_map_reduce(items: list[a], first: c, f: fn[a, c, tuple[list[b], c]]): tuple[list[b], c] do
    start: tuple[list[b], c] = {[], first}
    before: fn[b, list[b], list[b]] = fn y, done -> [y | done] end
    all = Enum.reduce(items, start, fn x, acc ->
      step = f(x, elem(acc, 1))
      {Enum.reduce(elem(step, 0), elem(acc, 0), before), elem(step, 1)}
    end)
    {Enum.o_turn(elem(all, 0)), elem(all, 1)}
  end
#: map_every/3
  def map_every(items: list[a], nth: integer, f: fn[a, a]): list[a] do
    if nth < 0 do raise("nth must be a nonnegative integer") end
    start: list[a] = Enum.o_room(length(items))
    Enum.o_turn(Enum.reduce(items, start, fn x, acc -> if nth > 0 and rem(length(acc), nth) == 0 do [f(x) | acc] else [x | acc] end end))
  end
#: take_every/2
  def take_every(items: list[a], nth: integer): list[a] do
    if nth < 0 do raise("nth must be a nonnegative integer") end
    start: list[a] = Enum.o_room(if nth == 0 do 0 else if nth >= length(items) do 1 else div(length(items) + nth - 1, nth) end end)
    Enum.o_turn(nth_taken(items, nth, 0, start))
  end
  defp nth_taken(items: list[a], nth: integer, i: integer, done: list[a]): list[a] do
    case items do
      [] -> done
      [x | rest] -> nth_taken(rest, nth, i + 1, if nth > 0 and rem(i, nth) == 0 do [x | done] else done end)
    end
  end
#: drop_every/2
  def drop_every(items: list[a], nth: integer): list[a] do
    if nth < 0 do raise("nth must be a nonnegative integer") end
    start: list[a] = Enum.o_room(if nth == 0 do length(items) else if nth >= length(items) do length(items) else length(items) - div(length(items) + nth - 1, nth) end end)
    Enum.o_turn(nth_dropped(items, nth, 0, start))
  end
  defp nth_dropped(items: list[a], nth: integer, i: integer, done: list[a]): list[a] do
    case items do
      [] -> done
      [x | rest] -> nth_dropped(rest, nth, i + 1, if nth > 0 and rem(i, nth) == 0 do done else [x | done] end)
    end
  end
#: reverse/2
  def reverse(items: list[a], tail: list[a]): list[a] do
    Enum.reverse(items) ++ tail
  end
#: reverse_slice/3
# A start and count whose sum leaves 64 bits is a panic of the pinned runtime.
  def reverse_slice(items: list[a], from: integer, count: integer): list[a] do
    if from < 0 or count < 0 do raise("reverse_slice needs a nonnegative start and count") end
    if from >= length(items) do items else
      if count > 9223372036854775807 - from do Sys.panic("panic: runtime error: slice bounds out of range [:#{(from - 9223372036854775807 - 1) + (count - 9223372036854775807 - 1)}]") end
      Enum.take(items, from) ++ Enum.reverse(Enum.slice(items, from, count)) ++ Enum.drop(items, from + count)
    end
  end
#: slide/3
  def slide(items: list[a], from: integer, to: integer): list[a] do
    n = length(items)
    i = if from < 0 do from + n else from end
    j = if to < 0 do to + n else to end
    if i < 0 or i >= n do items else
      if j < 0 or j >= n do raise("Enum.slide: insertion index out of range") end
      rest = Enum.take(items, i) ++ Enum.drop(items, i + 1)
      Enum.take(rest, j) ++ Enum.slice(items, i, 1) ++ Enum.drop(rest, j)
    end
  end
#: into/2
  def into(items: list[a], target: list[a]): list[a] do
    target ++ items
  end
#: to_list/1
  def to_list(items: list[a]): list[a] do
    items
  end
#: count_until/2
  def count_until(items: list[a], limit: integer): integer do
    if limit < 1 do raise("count_until needs a positive limit") end
    if length(items) < limit do length(items) else limit end
  end
#: count_until/3
  def count_until(items: list[a], f: fn[a, boolean], limit: integer): integer do
    if limit < 1 do raise("count_until needs a positive limit") end
    Enum.reduce(items, 0, fn x, n -> if n < limit and f(x) do n + 1 else n end end)
  end
#: reduce/2
  def reduce(items: list[a], f: fn[a, a, a]): a do
    if items == [] do raise("empty error") end
    Enum.reduce(tl(items), hd(items), f)
  end
#: frequencies/1 needs h_new/1 h_free/1 h_int/2 h_count/3 sort/1
  def frequencies(items: list[integer]): map[integer, integer] do
    t = Enum.h_new(length(items))
    if t == 0 do Enum.reduce(items, %{}, fn x, acc -> Map.put(acc, x, Map.get(acc, x, 0) + 1) end) else
      r = Map.new(Enum.map(Enum.sort(Enum.h_count(items, t, [])), fn k -> {k, Sys.peek(Enum.h_int(t, k) + 8)} end))
      Enum.h_free(t)
      r
    end
  end
#: frequencies/1 form 3 needs h_new/1 h_free/1 h_str/2 h_counts/3 sort/1
  def frequencies(items: list[string]): map[string, integer] do
    t = Enum.h_new(length(items))
    if t == 0 do Enum.reduce(items, %{}, fn x, acc -> Map.put(acc, x, Map.get(acc, x, 0) + 1) end) else
      r = Map.new(Enum.map(Enum.sort(Enum.h_counts(items, t, [])), fn k -> {k, Sys.peek(Enum.h_str(t, k) + 8)} end))
      Enum.h_free(t)
      r
    end
  end
#: frequencies/1 form 4
  def frequencies(items: list[a]): map[a, integer] do
    Enum.reduce(items, %{}, fn x, acc -> Map.put(acc, x, Map.get(acc, x, 0) + 1) end)
  end
#: frequencies_by/2
  def frequencies_by(items: list[a], f: fn[a, k]): map[k, integer] do
    Enum.reduce(items, %{}, fn x, acc ->
      key = f(x)
      Map.put(acc, key, Map.get(acc, key, 0) + 1)
    end)
  end
#: group_by/2 needs h_new/1 h_free/1 h_int/2 h_group/4 sort/1
# With integers for keys the groups grow in a table: the keys are worked
# out first, so nothing of the program runs while the table stands.
  def group_by(items: list[a], f: fn[a, integer]): map[integer, list[a]] do
    ks = Enum.map(items, f)
    t = Enum.h_new(length(items))
    if t == 0 do
      start: map[integer, list[a]] = %{}
      groups = Enum.reduce(items, start, fn x, acc ->
        key = f(x)
        Map.put(acc, key, [x | Map.get(acc, key, [])])
      end)
      Enum.reduce(Map.to_list(groups), groups, fn p, acc -> Map.put(acc, elem(p, 0), Enum.o_turn(elem(p, 1))) end)
    else
      r = Map.new(Enum.map(Enum.sort(Enum.h_group(items, ks, t, [])), fn k ->
        g: list[a] = Process.__any(Sys.peek(Enum.h_int(t, k) + 8))
        {k, Enum.o_turn(g)}
      end))
      Enum.h_free(t)
      r
    end
  end
#: group_by/2 form 4
  def group_by(items: list[a], f: fn[a, k]): map[k, list[a]] do
    start: map[k, list[a]] = %{}
    groups = Enum.reduce(items, start, fn x, acc ->
      key = f(x)
      Map.put(acc, key, [x | Map.get(acc, key, [])])
    end)
    Enum.reduce(Map.to_list(groups), groups, fn p, acc -> Map.put(acc, elem(p, 0), Enum.o_turn(elem(p, 1))) end)
  end
#: group_by/3
  def group_by(items: list[a], f: fn[a, k], g: fn[a, v]): map[k, list[v]] do
    start: map[k, list[v]] = %{}
    groups = Enum.reduce(items, start, fn x, acc ->
      key = f(x)
      Map.put(acc, key, [g(x) | Map.get(acc, key, [])])
    end)
    Enum.reduce(Map.to_list(groups), groups, fn p, acc -> Map.put(acc, elem(p, 0), Enum.o_turn(elem(p, 1))) end)
  end
