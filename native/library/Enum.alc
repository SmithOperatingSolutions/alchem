#: slice/2 needs take_every/2
  def slice(items: list[a], r: Range): list[a] do
    n = length(items)
    f = if r.first < 0 do r.first + n else r.first end
    l = if r.last < 0 do r.last + n else r.last end
    s = if r.step == -1 do 1 else r.step end
    if s < 0 or f < 0 or f >= n or l < f do Enum.take(items, 0) else
      Enum.take_every(Enum.slice(items, f, (if l < n - 1 do l else n - 1 end) - f + 1), s)
    end
  end
