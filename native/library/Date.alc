# Date: calendar dates, and what the date and time modules share, after
# Go's time package as the pinned runtime uses it.
#
# Every byte of a library function costs the compiler's source, which has a
# size limit, more than two, and a name that is not a common word costs a
# byte per letter. So the code of these six files is written short: the
# private functions and the variables have one or two letters, and a
# comment says what each is. Division and remainder are / and %, which
# truncate as div and rem do.
#
# The four date and time structs are one entry, under the name Time: a
# struct entry is appended to a program that mentions its file's module or
# the entry's name, a word counts where a longer one ends in it, and the
# functions of each of the four modules and those of Calendar name the
# structs of the others. So all four are there for a program that mentions
# Date, Time, NaiveDateTime or DateTime.
#: struct Time also ~D[ ~T[ ~N[ ~U[
  struct Date do
    year: integer
    month: integer
    day: integer
  end
  struct Time do
    hour: integer
    minute: integer
    second: integer
    microsecond: integer
  end
  struct NaiveDateTime do
    year: integer
    month: integer
    day: integer
    hour: integer
    minute: integer
    second: integer
    microsecond: integer
  end
  struct DateTime do
    year: integer
    month: integer
    day: integer
    hour: integer
    minute: integer
    second: integer
    microsecond: integer
    time_zone: string
    utc_offset: integer
  end
# The shared part is one entry, cm/2. Its public functions all take two
# arguments, so that they live in one appended module, and are public only
# so that the other library files can call them (a private function is
# visible in one module of one parameter count); their names are two
# letters, c or d and one more. It is one entry, and uses nothing of the
# other library files, because an entry is tested against a program once
# for every function that needs it, and nearly every date and time function
# needs these. What reads ISO 8601 text is a second entry, cr/2, in the
# same module, for the few functions that need it.
#
# A moment is what Go's time.Time holds, so that fields out of their ranges
# normalize as time.Date normalizes them, and a moment out of the 584
# thousand million years a Time has comes out as it does there: the
# seconds since 1 March of the year -292277022400, a uint64 that is kept in
# an int64, and the microseconds of the second. Day numbers count from that
# day too. Fields travel as lists: [year, month, day], [hour, minute,
# second, microsecond] or the seven.
#
# Time zones are read from the system's zone files by the entry dz/2 at
# the end of this file. Without a file the zones known are UTC and those
# of one offset for all time: Etc/GMT+12 to Etc/GMT-14 and the names of GMT
# and UTC (dv). In any other zone a DateTime keeps the offset it was given,
# and what moves it gives UTC, as the pinned runtime does for a name its
# database lacks.
#: cm/2
# cm: the seven fields b microseconds later, in range.
  def cm(f: list[integer], b: integer): list[integer] do
    zm(f, 0, 0, b)
  end
# zm: the seven fields n months, p days and b microseconds later: time.Date,
# which counts from any month and day, and Time.Add, which stops at the
# ends of an int64 of seconds since the year 1.
  defp zm(f: list[integer], n: integer, p: integer, b: integer): list[integer] do
    if yf(f) and ys(n, 0, 0) and yb(p, b) do
      r = l(f)+b
      w(yj(o(f, 0), o(f, 1)+n, o(f, 2)+p)+yo(r), yg(r)/1000000, g(r, 1000000))
    else ym(f, n, p, b) end
  end
# The fields of this library's own range are moved in plain arithmetic.
# ys: whether three numbers are within 2**31 of zero. yf: whether seven
# fields are. yb: whether days are within 2**40 and microseconds within
# 2**60. yj: the day number za gives for such a year, month and day.
# yh: the microseconds of a time of day. yd: the Date of a day number. yn:
# the NaiveDateTime, yt: the DateTime of a day number and r microseconds.
# yc: e days and r microseconds within what a Go Duration holds.
  defp ys(a: integer, b: integer, c: integer): boolean do
    a> -2147483648 and a<2147483648 and b> -2147483648 and b<2147483648 and c> -2147483648 and c<2147483648
  end
  defp yf(f: list[integer]): boolean do
    case f do
      [y, m, d, h, i, s, c] -> ys(y, m, d) and ys(h, i, s) and ys(c, 0, 0)
      _ -> false
    end
  end
  defp yb(p: integer, b: integer): boolean do
    p> -1099511627776 and p<1099511627776 and b> -1152921504606846976 and b<1152921504606846976
  end
  defp yj(y: integer, m: integer, d: integer): integer do
    a = if m>0 and m<13 do 0 else (m-1)/12-(if (m-1)%12<0 do 1 else 0 end) end
    n = m-a*12
    e = if n<3 do 1 else 0 end
    t = y+a-e+292277022400
    t/100*146097/4+1461*(t%100)/4+(153*(n+12*e)-457)/5+d-1
  end
# yo: r microseconds in whole days, rounded down. yg: what is left of r.
  defp yo(r: integer): integer do
    r/86400000000-(if r%86400000000<0 do 1 else 0 end)
  end
  defp yg(r: integer): integer do
    r-yo(r)*86400000000
  end
  defp yh(h: integer, i: integer, s: integer, u: integer): integer do
    ((h*60+i)*60+s)*1000000+u
  end
  defp yd(n: integer): Date do
    a = n%146097
    y = (a-a/1460+a/36524-a/146096)/365
    i = a-(365*y+y/4-y/100)
    p = (5*i+2)/153
    m = if p<10 do p+3 else p-9 end
    %Date{year: y+n/146097*400-292277022400+(if m<3 do 1 else 0 end), month: m, day: i-(153*p+2)/5+1}
  end
  defp yn(n: integer, r: integer): NaiveDateTime do
    d = yd(n)
    c = r/1000000
    %NaiveDateTime{year: d.year, month: d.month, day: d.day, hour: c/3600, minute: c/60%60, second: c%60, microsecond: r%1000000}
  end
  defp yt(n: integer, r: integer): DateTime do
    d = yd(n)
    c = r/1000000
    %DateTime{year: d.year, month: d.month, day: d.day, hour: c/3600, minute: c/60%60, second: c%60, microsecond: r%1000000, time_zone: "Etc/UTC", utc_offset: 0}
  end
  defp yc(e: integer, r: integer): integer do
    cond do
      e>200000 -> 9223372036854775
      e< -200000 -> -9223372036854775
      true -> max(min(e*86400000000+r, 9223372036854775), -9223372036854775)
    end
  end
  defp ym(f: list[integer], n: integer, p: integer, b: integer): list[integer] do
    u = g(l(f), 1000000)+b
    e = x(zs(f, n, p), -9223371966606163200)
    s = x(e, v(u, 1000000))
    zy(x((if (s>e) == (u>999999) do s else if u>0 do 9223372036854775807 else -9223372036854775807 end end), 9223371966606163200), g(u, 1000000))
  end
# o: a field. A list is not taken apart by a pattern where that happens
# often: a pattern copies what follows each element.
  defp o(f: list[integer], i: integer): integer do
    Enum.at(f, i, 0)
  end
# l: the microseconds of the day of seven fields.
  defp l(f: list[integer]): integer do
    o(f, 6)+((o(f, 3)*60+o(f, 4))*60+o(f, 5))*1000000
  end
# v: a / b rounded down. g: what is left of a then.
  defp v(a: integer, b: integer): integer do
    if a%b<0 do a/b-1 else a/b end
  end
  defp g(a: integer, b: integer): integer do
    a-v(a, b)*b
  end
# x: a sum as Go's int64 gives it, modulo 2**64. k: such a product a * n
# for a positive n.
  defp x(a: integer, b: integer): integer do
    m = -9223372036854775807-1
    cond do
      a>0 and b>0 and a>9223372036854775807-b -> a+m+(b+m)
      a<0 and b<0 and a<m-b -> a-m+(b-m)
      true -> a+b
    end
  end
  defp k(a: integer, n: integer): integer do
    if n == 0 do 0 else
      h = k(x(a, a), n/2)
      if n%2 == 1 do x(h, a) else h end
    end
  end
# za: the day number of a year, any month and any day, as Go's
# dateToAbsDays counts it: in centuries and years of a year t that starts
# in March, which for a year before the first is 2**64 more, and 2**64 is
# 184467440737095516 hundreds and 16; the days of the centuries are a
# fourth of a product modulo 2**64.
  defp za(y: integer, m: integer, d: integer): integer do
    n = g(m-1, 12)+1
    e = if n<3 do 1 else 0 end
    t = y+v(m-1, 12)-e+292277022400
    h = if t<0 do t+16 else t end
    p = k(v(h, 100)+(if t<0 do 184467440737095516 else 0 end), 146097)
    x((if p<0 do v(p, 4)+4611686018427387904 else p/4 end), 1461*g(h, 100)/4+(153*(n+12*e)-457)/5+d-1)
  end
# zs: the seconds of seven fields n months and p days on. ze: those of
# fields since the year 1, which is how moments are ordered.
  defp zs(f: list[integer], n: integer, p: integer): integer do
    if yf(f) and ys(n, 0, 0) and yb(p, 0) do x(ye(f, n, p), 9223371966606163200) else yw(f, n, p) end
  end
# ye: the seconds since the year 1 of such fields.
  defp ye(f: list[integer], n: integer, p: integer): integer do
    (yj(o(f, 0), o(f, 1)+n, o(f, 2)+p)+yo(l(f))-106751990354238)*86400+yg(l(f))/1000000
  end
  defp yw(f: list[integer], n: integer, p: integer): integer do
    x(k(za(o(f, 0), o(f, 1)+n, o(f, 2)+p+v(l(f), 86400000000)), 86400), g(v(l(f), 1000000), 86400))
  end
  defp ze(f: list[integer]): integer do
    if yf(f) do ye(f, 0, 0) else x(zs(f, 0, 0), -9223371966606163200) end
  end
# zn: the day number of seconds s, which are 2**64 more if below 0, and
# 2**64 is 213503982334601 days and 25216 seconds.
  defp zn(s: integer): integer do
    if s<0 do 213503982334601+v(s+25216, 86400) else s/86400 end
  end
# zy: the seven fields of seconds s and u microseconds.
  defp zy(s: integer, u: integer): list[integer] do
    w(zn(s), (if s<0 do g(s+25216, 86400) else s%86400 end), u)
  end
# w: the seven fields of a day number, c seconds and u microseconds.
  defp w(n: integer, c: integer, u: integer): list[integer] do
    d = yd(n)
    [d.year, d.month, d.day, c/3600, c/60%60, c%60, u]
  end
# cy: the fields p days later, as Time.AddDate moves them. cv: the day
# number of fields and p more. zq: the fields of a Date. cn: its day number
# and p more. cd: the Date p days later.
  def cy(f: list[integer], p: integer): list[integer] do
    zm(f, 0, p, 0)
  end
  def cv(f: list[integer], p: integer): integer do
    if yf(f) do yj(o(f, 0), o(f, 1), o(f, 2))+yo(l(f))+p else zn(zs(f, 0, 0))+p end
  end
  defp zq(d: Date): list[integer] do
    [d.year, d.month, d.day, 0, 0, 0, 0]
  end
  def cn(d: Date, p: integer): integer do
    if ys(d.year, d.month, d.day) do yj(d.year, d.month, d.day)+p else cv(zq(d), p) end
  end
  def cd(d: Date, p: integer): Date do
    if ys(d.year, d.month, d.day) and yb(p, 0) do yd(yj(d.year, d.month, d.day)+p) else
      f = zm(zq(d), 0, p, 0)
      %Date{year: o(f, 0), month: o(f, 1), day: o(f, 2)}
    end
  end
# cj: the day of the year of day number n + p, from 1.
  def cj(n: integer, p: integer): integer do
    q = n+p
    if q>=0 and q<281474976710656 do q-yj(yd(q).year, 1, 0) else q-za(o(w(q, 0, 0), 0), 1, 0) end
  end
# zl: the day of the month of the day before the same day of the next
# month. cl: the days of a month, which is that of its first day.
  defp zl(f: list[integer]): integer do
    o(zm(f, 1, -1, 0), 2)
  end
  def cl(y: integer, m: integer): integer do
    if m>0 and m<13 and ys(y, 0, 0) do (if m == 2 do (if y%4 == 0 and (y%100 != 0 or y%400 == 0) do 29 else 28 end) else 30+(m+m/8)%2 end) else zl([y, m, 1, 0, 0, 0, 0]) end
  end
# cb: whether a date and a time of day do not exist. zx: whether field i
# is not from a to b.
  def cb(d: list[integer], t: list[integer]): boolean do
    zx(d, 0, -9999, 9999) or zx(d, 1, 1, 12) or zx(d, 2, 1, cl(o(d, 0), o(d, 1))) or zx(t, 0, 0, 23) or zx(t, 1, 0, 59) or zx(t, 2, 0, 59) or zx(t, 3, 0, 999999)
  end
  defp zx(f: list[integer], i: integer, a: integer, b: integer): boolean do
    o(f, i)<a or o(f, i)>b
  end
# cf: the microseconds from b to a, kept within what a Go Duration holds.
  def cf(a: list[integer], b: list[integer]): integer do
    p = ze(a)
    c = ze(b)
    e = v(p, 86400)-v(c, 86400)
    cond do
      e>200000 -> 9223372036854775
      e< -200000 -> -9223372036854775
      true -> max(min(e*86400000000+(g(p, 86400)-g(c, 86400))*1000000+g(l(a), 1000000)-g(l(b), 1000000), 9223372036854775), -9223372036854775)
    end
  end
# dy: the DateTime in UTC of s seconds since 1970, for seconds of the years
# -9999 to 9999, and u microseconds.
  def dy(s: integer, u: integer): DateTime do
    c = s%86400
    e = if c<0 do 1 else 0 end
    yt(106751991073400+s/86400-e, (c+e*86400)*1000000+u)
  end
# ci: the microseconds from Date b to Date a, as cf.
  def ci(a: Date, b: Date): integer do
    if ys(a.year, a.month, a.day) and ys(b.year, b.month, b.day) do yc(yj(a.year, a.month, a.day)-yj(b.year, b.month, b.day), 0) else cf(zq(a), zq(b)) end
  end
# co: the order of two numbers.
  def co(a: integer, b: integer): atom do
    cond do
      a<b -> :lt
      a>b -> :gt
      true -> :eq
    end
  end
# cp: n microseconds in a unit of time.
  def cp(n: integer, u: atom): integer do
    p = case u do
      :day -> 86400000000
      :hour -> 3600000000
      :minute -> 60000000
      :second -> 1000000
      :millisecond -> 1000
      :microsecond -> 1
      _ -> raise("the unit is :day, :hour, :minute, :second, :millisecond or :microsecond, not "<>inspect(u))
    end
    n/p
  end
# cc: the microseconds kept at a precision.
  def cc(u: integer, p: atom): integer do
    case p do
      :second -> 0
      :millisecond -> u/1000*1000
      :microsecond -> u
      _ -> raise("truncate takes :second, :millisecond or :microsecond")
    end
  end
# cs: the microseconds n of a unit move a moment by; the pinned runtime
# multiplies microseconds by 1000 in a 64-bit Duration. ce: those of n
# units of p nanoseconds each.
  def cs(n: integer, u: atom): integer do
    p = 86400000000/cp(86400000000, u)
    if n>4611686018427387904/p or n< -4611686018427387904/p do raise("the amount to add is out of range") end
    v(k(n*p, 1000), 1000)
  end
  def ce(n: integer, p: integer): integer do
    if n>1099511627776 or n< -1099511627776 do raise("the amount to add is out of range") end
    if p == 1000000000 and n> -9000000000 and n<9000000000 do n*1000000 else v(k(n, p), 1000) end
  end
# ch: a wall clock moved by the eight amounts of a duration, as the pinned
# runtime moves it: to the first p of the month n months on, then to the
# day of the month it had or the last day that month has, then by the
# weeks and days, then by the time units. zf: whether one of the amounts
# is out of range.
  def ch(f: list[integer], b: list[integer]): list[integer] do
    if zf(b, 0) do raise("the duration is out of range") end
    t = cm(f, 0)
    n = o(b, 0)*12+o(b, 1)
    p = zm(t, n, 1-o(t, 2), 0)
    cm(cy((if n == 0 do t else cy(p, min(o(t, 2), zl(p))-1) end), o(b, 2)*7+o(b, 3)), v(x(x(k(o(b, 4), 3600000000000), k(o(b, 5), 60000000000)), x(k(o(b, 6), 1000000000), k(o(b, 7), 1000))), 1000))
  end
  defp zf(b: list[integer], i: integer): boolean do
    i<8 and (o(b, i)>1099511627776 or o(b, i)< -1099511627776 or zf(b, i+1))
  end
# cz: Go's %0pd.
  def cz(n: integer, p: integer): string do
    if n<0 do "-"<>String.pad_leading(Integer.to_string(-n), p-1, "0") else String.pad_leading(Integer.to_string(n), p, "0") end
  end
# ct: three fields as YYYY-MM-DD, four as HH:MM:SS and the fraction that is
# not zero, seven as both with p between. zu: the date. zt: the time of
# the fields from i on. zr: the digits of a fraction.
  def ct(f: list[integer], p: string): string do
    case f do
      [y, m, d] -> if yq(y, m, d) do yx(10, yy(y, m), yp(d), 0) else zu(f) end
      [h, i, s, u] -> if ya(h, i, s) do yr(yx(8, yp(h)+3801088+yp(i)*16777216+63771674411008+yp(s)*281474976710656, 0, 0), u) else zt(f, 0) end
      [y, m, d, h, i, s, u] -> if yq(y, m, d) and ya(h, i, s) and byte_size(p) == 1 do yr(yx(19, yy(y, m), yp(d)+Sys.byte(Sys.addr(p))*65536+yp(h)*16777216+63771674411008+yp(i)*281474976710656, 58+yp(s)*256), u) else zu(f)<>p<>zt(f, 3) end
      _ -> zu(f)<>p<>zt(f, 3)
    end
  end
# Fields that take the digits they usually take are written into the bytes
# of a fresh string, eight at a time. yp: two digits as two bytes. ya:
# whether three numbers are from 0 to 99. yq: whether a year is from 0 to
# 9999 and two more are that. yy: YYYY-MM- as eight bytes. yx: a string of
# n bytes that are the words a, b and c. yr: a time and its fraction.
  defp yp(v: integer): integer do
    12336+v/10+v%10*256
  end
  defp ya(a: integer, b: integer, c: integer): boolean do
    a>=0 and a<100 and b>=0 and b<100 and c>=0 and c<100
  end
  defp yq(y: integer, m: integer, d: integer): boolean do
    y>=0 and y<10000 and ya(m, d, 0)
  end
  defp yy(y: integer, m: integer): integer do
    yp(y/100)+yp(y%100)*65536+193273528320+yp(m)*1099511627776+3242591731706757120
  end
  defp yx(n: integer, a: integer, b: integer, c: integer): string do
    t = Sys.text(Sys.addr("0000000000000000000"), n)
    q = Sys.addr(t)
    Sys.poke(q, a)
    if n>8 do Sys.poke(q+8, b) end
    if n>16 do Sys.poke(q+16, c) end
    t
  end
  defp yr(t: string, u: integer): string do
    if u == 0 do t else t<>"."<>zr(u, 6) end
  end
  defp zu(f: list[integer]): string do
    cz(o(f, 0), 4)<>"-"<>cz(o(f, 1), 2)<>"-"<>cz(o(f, 2), 2)
  end
  defp zt(f: list[integer], i: integer): string do
    cz(o(f, i), 2)<>":"<>cz(o(f, i+1), 2)<>":"<>cz(o(f, i+2), 2)<>(if o(f, i+3) == 0 do "" else "."<>zr(o(f, i+3), 6) end)
  end
  defp zr(u: integer, p: integer): string do
    if u%10 == 0 do zr(u/10, p-1) else cz(u, p) end
  end
# ck: a time of day b microseconds later, around midnight. cg: the
# microseconds from one time of day to another.
  def ck(t: Time, b: integer): Time do
    if ys(t.hour, t.minute, t.second) and ys(t.microsecond, 0, 0) and yb(0, b) do
      r = g(yh(t.hour, t.minute, t.second, t.microsecond)+b, 86400000000)
      c = r/1000000
      %Time{hour: c/3600, minute: c/60%60, second: c%60, microsecond: r%1000000}
    else
      f = cm([1970, 1, 1, t.hour, t.minute, t.second, t.microsecond], b)
      %Time{hour: o(f, 3), minute: o(f, 4), second: o(f, 5), microsecond: o(f, 6)}
    end
  end
  def cg(a: Time, b: Time): integer do
    (((a.hour-b.hour)*60+a.minute-b.minute)*60+a.second-b.second)*1000000+a.microsecond-b.microsecond
  end
# r: the seven fields of a NaiveDateTime, as they are. cw: they b
# microseconds later. ca: the NaiveDateTime of seven fields b microseconds
# later. cq: the microseconds from b to a. cx: one as text.
  defp r(n: NaiveDateTime): list[integer] do
    [n.year, n.month, n.day, n.hour, n.minute, n.second, n.microsecond]
  end
  def cw(n: NaiveDateTime, b: integer): list[integer] do
    cm(r(n), b)
  end
  def ca(f: list[integer], b: integer): NaiveDateTime do
    t = cm(f, b)
    %NaiveDateTime{year: o(t, 0), month: o(t, 1), day: o(t, 2), hour: o(t, 3), minute: o(t, 4), second: o(t, 5), microsecond: o(t, 6)}
  end
  def cq(a: NaiveDateTime, b: NaiveDateTime): integer do
    if yv(a) and yv(b) do
      p = yh(a.hour, a.minute, a.second, a.microsecond)
      c = yh(b.hour, b.minute, b.second, b.microsecond)
      yc(yj(a.year, a.month, a.day)+yo(p)-yj(b.year, b.month, b.day)-yo(c), yg(p)-yg(c))
    else cf(r(a), r(b)) end
  end
# yv: whether the fields of a NaiveDateTime are within 2**31 of zero. cu:
# one b microseconds later.
  defp yv(n: NaiveDateTime): boolean do
    ys(n.year, n.month, n.day) and ys(n.hour, n.minute, n.second) and ys(n.microsecond, 0, 0)
  end
  def cu(n: NaiveDateTime, b: integer): NaiveDateTime do
    if yv(n) and yb(0, b) do
      p = yh(n.hour, n.minute, n.second, n.microsecond)+b
      yn(yj(n.year, n.month, n.day)+yo(p), yg(p))
    else ca(cm(r(n), 0), b) end
  end
  def cx(n: NaiveDateTime, p: string): string do
    ct(r(n), p)
  end
# dv: the abbreviation of a zone after the text b, "" for a zone that is
# not known. An offset of whole hours is its own abbreviation.
  def dv(n: string, b: string): string do
    cond do
