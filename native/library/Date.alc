        none -> "/etc/localtime"
      end
      r = if t == "" or t == "UTC" or byte_size(t)>255 or String.contains?(t, "\x00") do 0 else tzn("\x01"<>t, t, if String.starts_with?(t, "/") do [""] else ["/usr/share/zoneinfo/", "/usr/share/lib/zoneinfo/", "/usr/lib/locale/TZ/", "/etc/zoneinfo/"] end) end
      if r == 0 do [1, 0, tzi(0), tzi(1), Sys.addr("UTC"), 3] else tzl(r, s+u) end
    end
  end
# The record kept under the name k, or else that of the file n in the
# first of the directories that has it as a zone file.
  defp tzn(k: string, n: string, dirs: list[string]): integer do
    r = tzc(Sys.peek(Sys.state()+80), k)
    if r != 0 do r else tzg(k, n, dirs, 0) end
  end
  defp tzc(r: integer, n: string): integer do
    if r == 0 do 0 else if Sys.peek(r+96) == byte_size(n) and Sys.same(r+104, Sys.addr(n), byte_size(n)) == 1 do r else tzc(Sys.peek(r), n) end end
  end
# The file of n in the i-th of the directories: mapped behind 512 bytes
# and read whole. One of more than 10 MB is none to Go either.
  defp tzg(k: string, n: string, dirs: list[string], i: integer): integer do
    s = Sys.state()
    fd = if i >= length(dirs) do -1 else Sys.call(257, -100, Sys.addr(Enum.at(dirs, i, "")<>n<>"\x00"), 524288, 0) end
    size = if fd<0 do -1 else if Sys.call(5, fd, s+1024) != 0 do -1 else Sys.peek(s+1072) end end
    r = if size<0 or size>10485760 do 0 else Sys.call(9, 0, 512+size+16, 3, 34, -1, 0) end
    got = if r <= 0 do -1 else tzd(fd, r+512, size, 0) end
    if fd >= 0 do Sys.call(3, fd) end
    cond do
      i >= length(dirs) -> tzbuilt(k, n)
      r>0 and got >= 0 and tzp(r, got) ->
        Sys.poke(r+96, byte_size(k))
        Sys.copy(r+104, Sys.addr(k), byte_size(k))
        Sys.poke(r, Sys.peek(s+80))
        Sys.poke(s+80, r)
        r
      true ->
        if r>0 do Sys.call(11, r, 512+size+16) end
        tzg(k, n, dirs, i+1)
    end
  end
# The zone n in the database built in (Go's time/tzdata, which the pinned
# program carries for a system that has no zone files, as Windows has
# none): read as a file of it is, under the name k; 0 when it has none.
  defp tzbuilt(k: string, n: string): integer do
    b = tzdb()
    w = if b == 0 do -1 else tzfind(b + 16, Sys.peek(b + 8), n, b + 16 + tzindex(b + 16, Sys.peek(b + 8))) end
    if w < 0 do 0 else
      s = Sys.state()
      size = Sys.peek(w + 8)
      r = Sys.call(9, 0, 512+size+16, 3, 34, -1, 0)
      if r <= 0 do 0 else
        Sys.copy(r+512, Sys.peek(w), size)
        if tzp(r, size) do
          Sys.poke(r+96, byte_size(k))
          Sys.copy(r+104, Sys.addr(k), byte_size(k))
          Sys.poke(r, Sys.peek(s+80))
          Sys.poke(s+80, r)
          r
        else
          Sys.call(11, r, 512+size+16)
          0
        end
      end
    end
  end
# The database inflated, once, into mapped memory that word 112 of the
# library's state block points at: its length and the count of zones (a
# word each), then from 16 the index and the files
# (scripts/generate-tzdata.py); 0 when it cannot be made.
  defp tzdb(): integer do
    s = Sys.state()
    if Sys.peek(s + 112) != 0 do Sys.peek(s + 112) else
      z = Base.decode64!(tzdata())
      k = Sys.call(9, 0, 1048576, 3, 34, -1, 0)
      if k < 0 do System.halt(71) end
      HTTP._kinit(k)
      {t, bad} = HTTP._inflate_at(k, Sys.addr(z), byte_size(z), 16777216)
      Sys.call(11, k, 1048576)
      if bad != 0 or byte_size(t) < 4 do 0 else
        n = byte_size(t)
        m = Sys.call(9, 0, n + 16, 3, 34, -1, 0)
        if m <= 0 do 0 else
          Sys.poke(m, n)
          Sys.copy(m + 16, Sys.addr(t), n)
          Sys.poke(m + 8, tb4(m + 16))
          Sys.poke(s + 112, m)
          m
        end
      end
    end
  end
# How long the index is, from its first entry at a with c entries.
  defp tzindex(a: integer, c: integer): integer do
    tzskip(a + 4, c, 4)
  end
  defp tzskip(a: integer, c: integer, n: integer): integer do
    if c == 0 do n else tzskip(a + Sys.byte(a) + 9, c - 1, n + Sys.byte(a) + 9) end
  end
# The entry of zone n in the index at a (its count, then c entries), the
# files starting at d: the address of a record of two words, where the file
# is and its length; -1 for none.
  defp tzfind(a: integer, c: integer, n: string, d: integer): integer do
    tzfindat(a + 4, c, n, d)
  end
  defp tzfindat(a: integer, c: integer, n: string, d: integer): integer do
    if c == 0 do -1 else
      l = Sys.byte(a)
      if l == byte_size(n) and Sys.same(a + 1, Sys.addr(n), l) == 1 do
        r = Sys.state() + 520
        Sys.poke(r, d + tb4(a + 1 + l))
        Sys.poke(r + 8, tb4(a + 5 + l))
        r
      else tzfindat(a + l + 9, c - 1, n, d) end
    end
  end
# BEGIN generated by scripts/generate-tzdata.py
  defp tzdata(): string do
    ""
  end
# END generated by scripts/generate-tzdata.py
  defp tzd(fd: integer, a: integer, n: integer, got: integer): integer do
    r = if got >= n do 0 else Sys.call(0, fd, a+got, n-got) end
    if r == -4 do tzd(fd, a, n, got) else if r<0 do -1 else if r == 0 do got else tzd(fd, a, n, got+r) end end end
  end
# Four bytes at a, high byte first, as a number from 0; ts4 with a sign;
# tb8 eight bytes.
  defp tb4(a: integer): integer do
    Sys.byte(a)*16777216+Sys.byte(a+1)*65536+Sys.byte(a+2)*256+Sys.byte(a+3)
  end
  defp ts4(a: integer): integer do
    if tb4(a) >= 2147483648 do tb4(a)-4294967296 else tb4(a) end
  end
  defp tb8(a: integer): integer do
    ts4(a)*4294967296+tb4(a+4)
  end
# Whether the l bytes at r+512 are a zone file, as LoadLocationFromTZData
# asks; the record gets where its parts stand.
  defp tzp(r: integer, l: integer): boolean do
    d = r+512
    v = if l<44 do 1 else Sys.byte(d+4) end
    one = if l<44 do 0 else tb4(d+32)*5+tb4(d+36)*6+tb4(d+40)+tb4(d+28)*8+tb4(d+24)+tb4(d+20) end
    h = if v == 0 do d+20 else d+44+one+20 end
    wide = if v == 0 do 4 else 8 end
    fits = l >= 44 and tb4(d) == 1415211366 and (v == 0 or v == 50 or v == 51) and h+24 <= d+l
    nt = if fits do tb4(h+12) else 0 end
    nz = if fits do tb4(h+16) else 0 end
    nc = if fits do tb4(h+20) else 0 end
    tail = if fits do h+24+nt*wide+nt+nz*6+nc+tb4(h+8)*(wide+4)+tb4(h+4)+tb4(h) else 0 end
    rest = d+l-tail
    if not fits or tail>d+l or nz == 0 do false else
      Sys.poke(r+16, nt)
      Sys.poke(r+24, nz)
      Sys.poke(r+32, nc)
      Sys.poke(r+40, h+24)
      Sys.poke(r+48, wide)
      Sys.poke(r+56, h+24+nt*wide)
      Sys.poke(r+64, h+24+nt*wide+nt)
      Sys.poke(r+72, h+24+nt*wide+nt+nz*6)
      Sys.poke(r+80, tail+1)
      Sys.poke(r+88, if rest>2 and Sys.byte(tail) == 10 and Sys.byte(d+l-1) == 10 do rest-2 else 0 end)
      tzv(r, 0, nz, nc) and tzx(Sys.peek(r+56), nt, nz)
    end
  end
# Every zone type's abbreviation starts among the abbreviations, and every
# transition has a zone type there is.
  defp tzv(r: integer, i: integer, nz: integer, nc: integer): boolean do
    i >= nz or (Sys.byte(Sys.peek(r+64)+i*6+5)<nc and tzv(r, i+1, nz, nc))
  end
  defp tzx(a: integer, nt: integer, nz: integer): boolean do
    k = if nt>1000 do 1000 else nt end
    tzxk(a, k, nz) and (nt == k or tzx(a+k, nt-k, nz))
  end
  defp tzxk(a: integer, k: integer, nz: integer): boolean do
    k == 0 or (Sys.byte(a)<nz and tzxk(a+1, k-1, nz))
  end
# When transition i of the record happens.
  defp tzw(r: integer, i: integer): integer do
    if Sys.peek(r+48) == 4 do ts4(Sys.peek(r+40)+i*4) else tb8(Sys.peek(r+40)+i*8) end
  end
# Zone type z between two moments.
  defp tzz(r: integer, z: integer, from: integer, to: integer): list[integer] do
    t = Sys.peek(r+64)+z*6
    a = Sys.peek(r+72)+Sys.byte(t+5)
    [1, ts4(t), from, to, a, min(Sys.len(a), Sys.peek(r+32)-Sys.byte(t+5))]
  end
# lookup: before the first transition the first zone type that is standard
# time (lookupFirstZone); else the type of the last transition not after s,
# found by halving; after the last one what the rule says, when it can be
# read.
  defp tzl(r: integer, s: integer): list[integer] do
    nt = Sys.peek(r+16)
    lo = if nt == 0 do 0 else if s<tzw(r, 0) do -1 else tzb(r, s, 0, nt) end end
    from = if nt == 0 do tzi(0) else if lo<0 do tzi(0) else tzw(r, lo) end end
    late = if lo == nt-1 or nt == 0 do if Sys.peek(r+88)>0 do tze(r, from, s) else [] end else [] end
    cond do
      lo<0 -> tzz(r, tzh(r, nt), tzi(0), tzw(r, 0))
      late != [] -> late
      nt == 0 -> tzz(r, 0, tzi(0), tzi(1))
      true -> tzz(r, Sys.byte(Sys.peek(r+56)+lo), from, if lo+1<nt do tzw(r, lo+1) else tzi(1) end)
    end
  end
  defp tzb(r: integer, s: integer, lo: integer, hi: integer): integer do
    m = lo+(hi-lo)/2
    if hi-lo <= 1 do lo else if s<tzw(r, m) do tzb(r, s, lo, m) else tzb(r, s, m, hi) end end
  end
  defp tzh(r: integer, nt: integer): integer do
    first = Sys.byte(Sys.peek(r+56))
    cond do
      Sys.find(Sys.peek(r+56), nt, 0)<0 -> 0
      Sys.byte(Sys.peek(r+64)+first*6+4) != 0 and tzj(r, first-1, -1)>= 0 -> tzj(r, first-1, -1)
      true -> max(tzj(r, 0, 1), 0)
    end
  end
# The first zone type from i on, going up or down, that is no summer time; -1: none.
  defp tzj(r: integer, i: integer, step: integer): integer do
    if i<0 or i >= Sys.peek(r+24) do -1 else if Sys.byte(Sys.peek(r+64)+i*6+4) == 0 do i else tzj(r, i+step, step) end end
  end
# tzset: what the rule (a POSIX TZ text such as CET-1CEST,M3.5.0,M10.5.0/3)
# gives at s, after a last transition at last; [] when Go cannot read it.
# The place in the text is at 448 of the record and its end at 456; what
# reads a part moves the place past it.
  defp tze(r: integer, last: integer, s: integer): list[integer] do
    Sys.poke(r+448, Sys.peek(r+80))
    Sys.poke(r+456, Sys.peek(r+80)+Sys.peek(r+88))
    sn = tzq(r)
    sl = Sys.peek(r+464)
    so = if sn<0 do 999999999 else tzo(r) end
    c = if so == 999999999 do -1 else tzt(r) end
    dn = if c<0 or c == 44 do -1 else tzq(r) end
    dl = Sys.peek(r+464)
    e = if dn<0 do -1 else tzt(r) end
    dd = if dn<0 do 999999999 else if e<0 or e == 44 do so-3600 else tzo(r) end end
    cond do
      so == 999999999 -> []
      c<0 or c == 44 -> [1, -so, last, tzi(1), sn, sl]
      dd == 999999999 -> []
      true -> tzr(r, [sn, sl, -so, dn, dl, -dd], s)
    end
  end
# The byte at the place, -1 at the end of the rule.
  defp tzt(r: integer): integer do
    if Sys.peek(r+448) >= Sys.peek(r+456) do -1 else Sys.byte(Sys.peek(r+448)) end
  end
  defp tzmove(r: integer, k: integer): integer do
    Sys.poke(r+448, Sys.peek(r+448)+k)
  end
# A zone's name: letters (three at least, up to a digit, a comma or a sign)
# or anything between < and >. Where it starts, -1 for none; 464 of the
# record gets its length.
  defp tzq(r: integer): integer do
    p = Sys.peek(r+448)
    e = Sys.peek(r+456)
    i = if p >= e do 0 else if Sys.byte(p) == 60 do Sys.find(p, e-p, 62) else tzqk(p, e, 0) end end
    if p >= e do -1 else if Sys.byte(p) == 60 do
      if i<0 do -1 else
        Sys.poke(r+464, i-1)
        Sys.poke(r+448, p+i+1)
        p+1
      end
    else
      if i<3 do -1 else
        Sys.poke(r+464, i)
        Sys.poke(r+448, p+i)
        p
      end
    end end
  end
  defp tzqk(p: integer, e: integer, i: integer): integer do
    c = if p+i >= e do 44 else Sys.byte(p+i) end
    if (c >= 48 and c <= 57) or c == 44 or c == 45 or c == 43 do i else tzqk(p, e, i+1) end
  end
# A number from lo to hi at the place; -1 when there is none.
  defp tznum(r: integer, lo: integer, hi: integer): integer do
    p = Sys.peek(r+448)
    n = tznk(p, Sys.peek(r+456), 0, hi)
    j = tznj(p, Sys.peek(r+456), 0)
    if j == 0 or n<lo do -1 else
      Sys.poke(r+448, p+j)
      n
    end
  end
  defp tznj(p: integer, e: integer, j: integer): integer do
    if p+j<e and Sys.byte(p+j) >= 48 and Sys.byte(p+j) <= 57 do tznj(p, e, j+1) else j end
  end
  defp tznk(p: integer, e: integer, n: integer, hi: integer): integer do
    if p<e and Sys.byte(p) >= 48 and Sys.byte(p) <= 57 do if n*10+Sys.byte(p)-48>hi do -1 else tznk(p+1, e, n*10+Sys.byte(p)-48, hi) end else n end
  end
# An offset [+-]hh[:mm[:ss]] in seconds; 999999999 when there is none.
# tzpart: the :mm or :ss after it, -2 when no colon stands there.
  defp tzo(r: integer): integer do
    c = tzt(r)
    if c == 43 or c == 45 do tzmove(r, 1) end
    h = if c<0 do -1 else tznum(r, 0, 168) end
    m = if h<0 do -1 else tzpart(r) end
    s = if m<0 do m else tzpart(r) end
    if h<0 or m == -1 or s == -1 do 999999999 else (if c == 45 do -1 else 1 end)*(h*3600+max(m, 0)*60+max(s, 0)) end
  end
  defp tzpart(r: integer): integer do
    if tzt(r) != 58 do -2 else
      tzmove(r, 1)
      tznum(r, 0, 59)
    end
  end
# When a change happens: [0, n] the n-th day of the year not counting 29
# February (Jn), [1, n] the day n of the year from 0, [2, month, week, day]
# the weekday of that week of the month (Mm.w.d); then the time of day, 2
# o'clock unless /time follows. [] when it cannot be read.
  defp tzu(r: integer): list[integer] do
    c = tzt(r)
    if c == 74 or c == 77 do tzmove(r, 1) end
    a = if c<0 do -1 else if c == 74 do tznum(r, 1, 365) else if c == 77 do tznum(r, 1, 12) else tznum(r, 0, 365) end end end
    b = if c != 77 or a<0 do 0 else if tzt(r) != 46 do -1 else tzdot(r, 1, 5) end end
    d = if c != 77 or b<0 do 0 else if tzt(r) != 46 do -1 else tzdot(r, 0, 6) end end
    t = if a<0 or b<0 or d<0 do 999999999 else if tzt(r) != 47 do 7200 else tzslash(r) end end
    if t == 999999999 do [] else [(if c == 74 do 0 else if c == 77 do 2 else 1 end end), a, b, d, t] end
  end
  defp tzdot(r: integer, lo: integer, hi: integer): integer do
    tzmove(r, 1)
    tznum(r, lo, hi)
  end
  defp tzslash(r: integer): integer do
    tzmove(r, 1)
    tzo(r)
  end
# tzruleTime: the seconds into the year y at which the change u happens,
# in UTC for a zone whose offset is c then.
  defp tzy(y: integer, u: list[integer], c: integer): integer do
    leap = if y%4 == 0 and (y%100 != 0 or y%400 == 0) do 1 else 0 end
    mon = tzat(u, 1)
    yy = if mon <= 2 do y-1 else y end
    dow = ((26*((mon+9)%12+1)-2)/10+1+yy%100+yy%100/4+yy/100/4-2*(yy/100))%7
    first = tzat(u, 3)-(if dow<0 do dow+7 else dow end)
    d = tzweek((if first<0 do first+7 else first end), tzat(u, 2), Enum.at([31, 28+leap, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31], mon-1, 31))
    cond do
      tzat(u, 0) == 0 -> (tzat(u, 1)-1+(if leap == 1 and tzat(u, 1) >= 60 do 1 else 0 end))*86400+tzat(u, 4)-c
      tzat(u, 0) == 1 -> tzat(u, 1)*86400+tzat(u, 4)-c
      true -> (d+Enum.at([0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334], mon-1, 0)+(if leap == 1 and mon>2 do 1 else 0 end))*86400+tzat(u, 4)-c
    end
  end
# The day (from 0) of the week-th such weekday of a month of n days, the
# last one when the month has no week-th.
  defp tzweek(d: integer, week: integer, n: integer): integer do
    if week <= 1 or d+7 >= n do d else tzweek(d+7, week-1, n) end
  end
# The two changes of the year and which of the two zones holds at s. z: the
# standard name, its length and offset, then the summer ones. In the south
# summer time starts later in the year than it ends, and Go then swaps the
# two; the span it gives ends 365 days into the year.
  defp tzr(r: integer, z: list[integer], s: integer): list[integer] do
    c = tzt(r)
    if c >= 0 do tzmove(r, 1) end
    a = if c<0 do [2, 3, 2, 0, 7200] else if c != 44 and c != 59 do [] else tzu(r) end end
    m = tzt(r)
    if c >= 0 and m == 44 do tzmove(r, 1) end
    b = if c<0 do [2, 11, 1, 0, 7200] else if a == [] or m != 44 do [] else tzu(r) end end
    day = if s<0 do (s-86399)/86400 else s/86400 end
    y = tzyear(day)
    ysec = (day-((y-1)*365+(y-1)/4-(y-1)/100+(y-1)/400-719162))*86400+s%86400
    base = s-ysec
    start = if a == [] or b == [] do 0 else tzy(y, a, tzat(z, 2)) end
    stop = if a == [] or b == [] do 0 else tzy(y, b, tzat(z, 5)) end
    cond do
      a == [] or b == [] or (c >= 0 and tzt(r) >= 0) -> []
      stop<start and ysec<stop -> [1, tzat(z, 5), base, stop+base, tzat(z, 3), tzat(z, 4)]
      stop<start and ysec >= start -> [1, tzat(z, 5), start+base, base+31536000, tzat(z, 3), tzat(z, 4)]
      stop<start -> [1, tzat(z, 2), stop+base, start+base, tzat(z, 0), tzat(z, 1)]
      ysec<start -> [1, tzat(z, 2), base, start+base, tzat(z, 0), tzat(z, 1)]
      ysec >= stop -> [1, tzat(z, 2), stop+base, base+31536000, tzat(z, 0), tzat(z, 1)]
      true -> [1, tzat(z, 5), start+base, stop+base, tzat(z, 3), tzat(z, 4)]
    end
  end
  defp tzat(f: list[integer], i: integer): integer do
    Enum.at(f, i, 0)
  end
# The year of a day counted from 1970.
  defp tzyear(day: integer): integer do
    z = day+719468
    c = if z<0 do (z-146096)/146097 else z/146097 end
    e = z-c*146097
    y = (e-e/1460+e/36524-e/146096)/365
    i = e-(365*y+y/4-y/100)
    y+c*400+(if (5*i+2)/153<10 do 0 else 1 end)
  end
