        Node._es(n, "alchem node 4")
        Node._es(n, me)
        Node._es(n, Node._proof(cookie, binding, if dialling == 1 do "dialling" else "accepting" end, me))
        w = Node._wf(g, n, b, tls, Node._et(n), d)
        {came, hello} = if w != 0 do {0, ""} else Node._rf(g, n, b, tls, d) end
        if came == 0 do {"", 0, "the other node closed the connection; the nodes may not share a cookie"} else
