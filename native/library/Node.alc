        if Sys.peek(x + 24) != 0 do Sys.peek(x + 24) else
          Process._halt(reply)
          e: result[integer, string] = error("timeout")
          Process.__word(e)
        end
      end
    end
  end
#: _answer/3 needs Process._g/0 Process._ready/2 Process._recv/3
  def _answer(p: integer, ms: integer, x: integer): integer do
    g = Process._g()
    if Process._recv(g, p, ms) == 1 do
      Sys.poke(x + 24, Sys.peek(g + 184))
      Process._ready(g, Sys.peek(x + 16))
    end
    0
  end
#: call/4 needs Atom.to_string/1 _call/6 _form/1
  def call(other: string, name: atom, v: a, ms: integer): result[b, string] do
    Process.__any(Node._call(other, Atom.to_string(name), Process.__word(v), ms, Node._form(0), Node._form(1)))
  end
#: call/3 needs Atom.to_string/1 _call/6 _form/1
  def call(other: string, name: atom, v: a): result[b, string] do
    Process.__any(Node._call(other, Atom.to_string(name), Process.__word(v), 5000, Node._form(0), Node._form(1)))
  end
#: cast/3 needs Atom.to_string/1 Process._check/1 Process._g/0 Process._send/4 Process._spawn/4 _casting/4 _form/1 _kind/1 _lwhere/2 _n/0 _name/1
  def cast(other: string, name: atom, v: a): boolean do
    f = Node._form(0)
    g = Process._g()
    s = Atom.to_string(name)
    w = Process.__word(v)
    Process._check(g)
    if other == Node._name(Node._n()) do
      q = Node._lwhere("cast:" <> s, Node._kind(f))
      q != 0 and Process._send(g, q, w, 0) == 1
    else
      later: fn[pid[integer], integer] = fn(h: pid[integer]): integer do Node._casting(other, s, w, f) end
      Process._spawn(g, Process.__word(later), 1, 0)
      true
    end
  end
#: _casting/4 needs _far/3 _fcodec/1 _kind/1 _n/0 _rwhere/6
  def _casting(other: string, s: string, w: integer, f: integer): integer do
    r = Node._rwhere(Node._n(), other, "cast:" <> s, 30000, Node._kind(f), Node._fcodec(f))
    if r != 0 do Node._far(1, r, w) end
    0
  end

# Stream.publish (node.go: PublishStream). A publication: 0 the text of
# its elements' type, 8 and 16 the pulls that wait (cells: the peer, the
# request or the least integer for a reader that has finished, the
# subscription), 24 the process that serves it, 32 the streams being read
# (cells: the peer, the subscription, a cell of the iterator and its
# context), 40 the elements' codec.
#: _publish/3 needs Process._check/1 Process._g/0 Process._push/5 Process._spawn/4 Process._take/2 _fcodec/1 _kind/1 _n/0 _pub/2 _pubsrv/4
  def _publish(s: string, build: integer, f: integer): boolean do
    g = Process._g()
    n = Node._n()
    Process._check(g)
    if s == "" or Node._pub(n, s) != 0 do false else
      pub = Process._take(g, 48)
      Sys.poke(pub, Process.__word(Node._kind(f)))
      Sys.poke(pub + 40, Node._fcodec(f))
      Process._push(g, n + 80, Process.__word(s), pub, 0)
      serves: fn[pid[integer], integer] = fn(h: pid[integer]): integer do Node._pubsrv(n, pub, build, s) end
      Sys.poke(pub + 24, Process._spawn(g, Process.__word(serves), 1, 0))
      true
    end
  end
#: _pubsrv/4 needs Process._drop/3 Process._g/0 _publoop/3 _pubstop/3
  def _pubsrv(n: integer, pub: integer, build: integer, s: string): integer do
    try do
      Node._publoop(n, pub, build)
    after
      Process._drop(Process._g(), n + 80, Process.__word(s))
      Node._pubstop(Process._g(), pub + 32, 0)
    end
  end
# The streams being read are read no further: all of them, or with k 1
# those whose reader's node is gone.
#: _pubstop/3 needs Process._free/2 _stop/1
  def _pubstop(g: integer, h: integer, k: integer): integer do
    x = Sys.peek(h)
    if x == 0 do 0 else
      if k == 1 and Sys.peek(Sys.peek(x + 8) + 16) == 0 do Node._pubstop(g, x, k) else
        Sys.poke(h, Sys.peek(x))
        Node._stop(Sys.peek(x + 24))
        Process._free(g, x)
        Node._pubstop(g, h, k)
      end
    end
  end
# The stream of that cell is read no further.
#: _stop/1 needs Process._free/2 Process._g/0
  def _stop(cur: integer): integer do
    c: option[fn[integer]] = Process.__any(Sys.peek(cur + 16))
    Process._free(Process._g(), cur)
    over = Stream.__get(c)
    over()
  end
#: _open/3
  def _open(x: integer, p: integer, sub: integer): integer do
    if x == 0 do 0 else if Sys.peek(x + 8) == p and Sys.peek(x + 16) == sub do x else Node._open(Sys.peek(x), p, sub) end end
  end
#: _publoop/3 needs Enum.reverse/1 Process._cell/4 Process._check/1 Process._free/2 Process._g/0 Process._get/1 Process._push/5 Process._wait/2 _chunk/6 _ers/2 _et/1 _ev/2 _open/3 _pubstop/3 _reply/3 _send/3 _stop/1 _unlink/2
  def _publoop(n: integer, pub: integer, build: integer): integer do
    g = Process._g()
    x = Process._get(pub + 8)
    if x == 0 do
      Process._wait(g, 0)
      Process._check(g)
    else
      p = Sys.peek(x + 8)
      r = Sys.peek(x + 16)
      sub = Sys.peek(x + 24)
      Process._free(g, x)
      Node._pubstop(g, pub + 32, 1)
      o = Node._open(Sys.peek(pub + 32), p, sub)
      if r == -9223372036854775807 - 1 do
        if o != 0 do
          Node._unlink(pub + 32, o)
          Node._stop(Sys.peek(o + 24))
          Process._free(g, o)
        end
      else
        cur = if o != 0 do Sys.peek(o + 24) else
          f: fn[stream[integer]] = Process.__any(build)
          nothing: fn[integer] = fn -> 0 end
          c: option[fn[integer]] = some(nothing)
          it = Stream.__start(f(), c)
          made = Process._cell(g, Process.__word(it), Process.__word(c), 0)
          Process._push(g, pub + 32, p, sub, made)
          made
        end
        next: fn[option[integer]] = Process.__any(Sys.peek(cur + 8))
        empty: list[string] = []
        {count, done, pieces} = Node._chunk(n, Sys.peek(pub + 40), next, 0, 0, empty)
        if done == 1 do
          now = Node._open(Sys.peek(pub + 32), p, sub)
          Node._unlink(pub + 32, now)
          Node._stop(cur)
          Process._free(g, now)
        end
        Node._reply(n, r, done)
        Node._ev(n, count)
        Node._ers(n, Enum.reverse(pieces))
        Node._send(n, p, Node._et(n))
      end
    end
    Node._publoop(n, pub, build)
  end
#: _ers/2 needs _er/2
  def _ers(n: integer, pieces: list[string]): integer do
    case pieces do
      [] -> 0
      [one | rest] ->
        Node._er(n, one)
        Node._ers(n, rest)
    end
  end
# Up to 256 elements or 64 KiB of them, each encoded: how many, 1 when
# the stream ended, and the pieces, the last first.
#: _chunk/6 needs _e/4 _e0/1 _et/1
  def _chunk(n: integer, c: integer, next: fn[option[integer]], count: integer, size: integer, pieces: list[string]): tuple[integer, integer, list[string]] do
    if count >= 256 or size >= 65536 do {count, 0, pieces} else
      got = next()
      case got do
        none -> {count, 1, pieces}
        some(v) ->
          Node._e0(n)
          Node._e(n, Sys.peek(c), Sys.peek(c + 8), v)
          piece = Node._et(n)
          Node._chunk(n, c, next, count + 1, size + byte_size(piece), [piece | pieces])
      end
    end
  end
# Node.stream (node.go: RemoteStream). What a reader keeps: 0 the elements
# it has, 8 set when no more will come, 16 set when the other node need
# not be told that it stops, 24 its subscription, 32 the peer, 40 the
# stream's name, 48 the codec, 56 where the stream was asked for.
#: stream/2 needs Atom.to_string/1 Process._check/1 Process._g/0 _ask/5 _e0/1 _es/2 _et/1 _fcodec/1 _form/1 _kind/1 _n/0 _peer/2 _reading/3
  def stream(other: string, name: atom): result[stream[a], string] do
    place = Stream.__where()
    f = Node._form(0)
    g = Process._g()
    n = Node._n()
    Process._check(g)
    s = Atom.to_string(name)
    p = if Sys.peek(n + 16) == 0 do 0 else Node._peer(n, other) end
    if Sys.peek(n + 16) == 0 do error("start this node first, with Node.start") else if p == 0 do error("not connected to node " <> other) else
      kind = Node._kind(f)
      Node._e0(n)
      Node._es(n, s)
      Node._es(n, kind)
      {got, body} = Node._ask(n, p, 6, 5000, Node._et(n))
      if got == 0 do error("node " <> other <> " did not answer") else
        if byte_size(body) < 1 or Sys.byte(Sys.addr(body)) == 0 do error("node " <> other <> " publishes no stream " <> s <> " of " <> kind) else
          c = Node._fcodec(f)
          made: stream[integer] = Stream.__make(fn ctx -> Node._reading(n, [p, Process.__word(s), c, place], ctx) end)
          r: stream[a] = Process.__any(Process.__word(made))
          ok(r)
        end
      end
    end end
  end
#: _reading/3 needs Process._g/0 Process._take/2 _pull/2 _unread/2
  def _reading(n: integer, of: list[integer], ctx: option[fn[integer]]): fn[option[integer]] do
    [p, s, c, place] = of
    st = Process._take(Process._g(), 64)
    Sys.poke(st + 24, Sys.poke(p + 32, Sys.peek(p + 32) + 1))
    Sys.poke(st + 32, p)
    Sys.poke(st + 40, s)
    Sys.poke(st + 48, c)
    Sys.poke(st + 56, place)
    old = Stream.__get(ctx)
    close: fn[integer] = fn -> Node._unread(n, st) + old() end
    v = Stream.__put(ctx, close)
    fn -> Node._pull(n, st) end
  end
#: _unread/2 needs _e0/1 _eb/2 _es/2 _et/1 _ev/2 _send/3
  def _unread(n: integer, st: integer): integer do
    if Sys.peek(st + 8) + Sys.peek(st + 16) > 0 do 0 else
      Sys.poke(st + 16, 1)
      Node._e0(n)
      Node._eb(n, 7)
      Node._ev(n, 0)
      Node._es(n, Process.__any(Sys.peek(st + 40)))
      Node._ev(n, Sys.peek(st + 24))
      Node._eb(n, 1)
      Node._send(n, Sys.peek(st + 32), Node._et(n))
    end
  end
#: _pull/2 needs _ask/5 _d0/4 _db/1 _dl/5 _dv/1 _e0/1 _eb/2 _es/2 _et/1 _ev/2
  def _pull(n: integer, st: integer): option[integer] do
    held: list[integer] = if Sys.peek(st) == 0 do [] else Process.__any(Sys.peek(st)) end
    case held do
      [v | rest] ->
        Sys.poke(st, Process.__word(rest))
        some(v)
      [] ->
        if Sys.peek(st + 8) == 1 do none else
          c = Sys.peek(st + 48)
          Node._e0(n)
          Node._es(n, Process.__any(Sys.peek(st + 40)))
          Node._ev(n, Sys.peek(st + 24))
          Node._eb(n, 0)
          {got, body} = Node._ask(n, Sys.peek(st + 32), 7, 30000, Node._et(n))
          if got == 0 do
            Sys.poke(st + 8, 1)
            Sys.poke(st + 16, 1)
            Stream.__fail(Sys.peek(st + 56), "the node holding the stream stopped answering")
          else
            Node._d0(n, body, 0, Sys.peek(st + 32))
            done = Node._db(n)
            count = Node._dv(n)
            empty: list[integer] = []
            Sys.poke(st, Node._dl(n, Sys.peek(c), Sys.peek(c + 8), if count > 65536 do 65536 else if count < 0 do 0 else count end end, empty))
            if done == 1 or Sys.peek(n + 128) == 1 do Sys.poke(st + 8, 1) end
            Node._pull(n, st)
          end
        end
    end
  end

# TLS 1.3 for a node's connection (node.go: secure; library/TLS.alc): the
# dialling end verifies nothing, as upstream sets InsecureSkipVerify, and
# the accepting end shows the node's own certificate. What TLS keeps for
# the connection, or 0 and why not.
#: _tls/5 needs Process._take/2 TLS._accept/5 TLS._dial/5
  def _tls(g: integer, n: integer, b: integer, dialling: integer, d: integer): tuple[integer, string] do
    empty: list[tuple[string, string]] = []
    none: list[string] = []
    key: tuple[string, string, string] = Process.__any(Sys.peek(n + 176))
    cert: string = Process.__any(Sys.peek(n + 184))
    {t, why} = if dialling == 1 do TLS._dial(g, b, d, "", {3, empty}) else TLS._accept(g, b, d, {[cert], 3, 0, [elem(key, 0), elem(key, 1), elem(key, 2)]}, 2) end
    if why == "" do
      Sys.poke(t + 416, 1)
      {t, ""}
    else {0, "could not set up an encrypted connection: " <> why} end
  end
# What the proof of the cookie is tied to.
#: _texp/2 needs TLS._export/3
  def _texp(n: integer, tls: integer): string do
    TLS._export(tls, "alchem node cookie proof", 32)
  end
# A message goes out sealed: 0, or -1.
#: _tput/6 needs TLS._write/5 _put/5
  def _tput(g: integer, n: integer, b: integer, t: integer, m: string, d: integer): integer do
    if TLS._write(g, t, Sys.addr(m), byte_size(m), d) == "" do 0 else -1 end
  end
# k bytes of what the other end sent, or "" when they did not come.
#: _tget/6 needs TLS._get/4
  def _tget(g: integer, n: integer, b: integer, t: integer, k: integer, d: integer): string do
    TLS._get(g, t, k, d)
  end
# The key a node shows and the certificate that holds it (node.go:
# identity): X.509 as DER, for the name, valid from an hour ago for twenty
# years, signed by its own key.
#: _identity/2 needs Crypto.strong_rand_bytes/1 TLS._bs/1 TLS._der/2 TLS._edkey/1 TLS._edsign/2 TLS._now/0 _stamp/1
  def _identity(n: integer, name: string): integer do
    key = TLS._edkey(Crypto.strong_rand_bytes(32))
    now = TLS._now()
    serial = Crypto.strong_rand_bytes(15)
    Sys.poke(Sys.addr(serial), Process.__or(Process.__and(Sys.peek(Sys.addr(serial)), -129), 1))
    alg = TLS._der(0x30, TLS._bs([6, 3, 0x2b, 0x65, 0x70]))
    who = TLS._der(0x30, TLS._der(0x31, TLS._der(0x30, TLS._bs([6, 3, 0x55, 4, 3]) <> TLS._der(0x0c, name))))
    uses = TLS._der(0x30, TLS._bs([6, 3, 0x55, 0x1d, 0x0f, 1, 1, 0xff, 4, 4, 3, 2, 7, 0x80])) <> TLS._der(0x30, TLS._bs([6, 3, 0x55, 0x1d, 0x25, 4, 12, 0x30, 10, 6, 8, 0x2b, 6, 1, 5, 5, 7, 3, 1]))
    tbs = TLS._der(0x30, TLS._bs([0xa0, 3, 2, 1, 2]) <> TLS._der(2, serial) <> alg <> who <> TLS._der(0x30, TLS._der(0x17, Node._stamp(now - 3600)) <> TLS._der(0x17, Node._stamp(now + 631152000))) <> who <> TLS._der(0x30, alg <> TLS._der(3, TLS._bs([0]) <> elem(key, 1))) <> TLS._der(0xa3, TLS._der(0x30, uses)))
    Sys.poke(n + 176, Process.__word(key))
    Sys.poke(n + 184, Process.__word(TLS._der(0x30, tbs <> alg <> TLS._der(3, TLS._bs([0]) <> TLS._edsign(key, tbs)))))
  end
# A time, seconds since 1970, as X.509 writes it before 2050: YYMMDDHHMMSSZ.
#: _stamp/1 needs _two/1
  def _stamp(s: integer): string do
    z = div(s, 86400) + 719468
    era = div(z, 146097)
    doe = z - era * 146097
    yoe = div(doe - div(doe, 1460) + div(doe, 36524) - div(doe, 146096), 365)
    doy = doe - (365 * yoe + div(yoe, 4) - div(yoe, 100))
    mp = div(5 * doy + 2, 153)
    month = if mp < 10 do mp + 3 else mp - 9 end
    year = yoe + era * 400 + (if month <= 2 do 1 else 0 end)
    t = rem(s, 86400)
    Node._two(rem(year, 100)) <> Node._two(month) <> Node._two(doy - div(153 * mp + 2, 5) + 1) <> Node._two(div(t, 3600)) <> Node._two(rem(div(t, 60), 60)) <> Node._two(rem(t, 60)) <> "Z"
  end
#: _two/1 needs TLS._bs/1
  def _two(v: integer): string do
    TLS._bs([48 + div(v, 10), 48 + rem(v, 10)])
  end
