# Node: programs as nodes whose processes exchange messages, as the pinned
# runtime has them (compiler/actor/node/node.go and the "---- Node ----"
# functions of compiler/library.go.txt), on the sockets of library/TCP.alc
# and the processes of library/Process.alc (spec/alchem-nodes.md).
#
# g + 1024 holds the node's block n: 0 its name ("" before Node.start), 8
# the cookie, 16 the listening socket (0: not a node), 24 set when
# connections are encrypted, 32 the peers, 40 the processes other nodes
# may reach (cells: the number, the process, its codec), 48 who watches a
# node (the name, the process, the reference), 56 the connections kept
# (the name, the keeper's process, a cell that is 1 when it is woken), 64
# who hears of every connection (the process, the reference), 80 the
# streams published (the name, the publication), 88 the bytes being
# encoded, 96 how many and 104 their room, 112 where the bytes being
# decoded stand, 120 their end, 128 set when they did not fit their type
# and 136 the peer they came from, 144 the function a handle of another
# node's process calls, 152 the links to such processes (the process, the
# handle, a cell that is 1 while the link holds), 160 working memory for
# the hashes and ciphers, 168 the codecs made for Node.serve and Node.call
# (the two forms, the block), 176 the node's key for TLS and 184 its
# certificate, 192 the handles given back.
# A peer: 0 its socket, 8 its name, 16 closed, 24 those that wait for an
# answer (cells: the request, the process, the answer: 0 none yet, -1 the
# connection closed), 32 the last request, 40 the monitors of its
# processes (the reference, the process that monitors, the number
# watched), 48 the process that writes and 56 those that wait to, 64 what
# TLS keeps for the connection (0: none).
# A codec is two words: the node of a type (native-nodes.alc) and the
# first node, which a node of tag 20 counts from. A form is what the
# compiler leaves at R14-72 for a type: two bytes of length, the type's
# text, the node.
# The handle of another node's process is a block like a process's: 0 the
# node's name, 8 the codec of its messages (it stands at 96), 16 the peer (0: none), 24 the
# function of n + 144, 40 its number there, 320 the number 2.
#: _n/0 needs Process._g/0 Process._take/2 _far/3
  def _n(): integer do
    g = Process._g()
    n = Sys.peek(g + 1024)
    if n != 0 do n else
      m = Process._take(g, 512)
      Sys.poke(g + 1024, m)
      Sys.poke(m, Process.__word(""))
      Sys.poke(m + 8, Process.__word(""))
      f: fn[integer, integer, integer, integer] = fn(op: integer, r: integer, a: integer): integer do Node._far(op, r, a) end
      Sys.poke(m + 144, Process.__word(f))
      m
    end
  end
#: _name/1
  def _name(n: integer): string do
    Process.__any(Sys.peek(n))
  end
#: _u16/1
  def _u16(a: integer): integer do
    Sys.byte(a) + 256 * Sys.byte(a + 1)
  end
# The i-th form the compiler left for the call that is running; 0 for none.
#: _form/1 needs _forms/2
  def _form(i: integer): integer do
    a = Sys.peek(Sys.stack() - 72)
    if a == 0 do 0 else Node._forms(a + 1, i) end
  end
#: _forms/2 needs _u16/1
  def _forms(a: integer, i: integer): integer do
    if i == 0 do a + 2 else Node._forms(a + 2 + Node._u16(a), i - 1) end
  end
# The text of a form's type and its codec.
#: _kind/1 needs _u16/1
  def _kind(f: integer): string do
    Sys.text(f + 2, Node._u16(f))
  end
#: _codec/2 needs Process._g/0 Process._take/2
  def _codec(node: integer, root: integer): integer do
    c = Process._take(Process._g(), 16)
    Sys.poke(c, node)
    Sys.poke(c + 8, root)
    c
  end
#: _fcodec/1 needs _codec/2 _u16/1
  def _fcodec(f: integer): integer do
    Node._codec(f + 2 + Node._u16(f), f + 2 + Node._u16(f))
  end

#: _hash/1 needs Crypto.run/6
  def _hash(m: string): string do
    Crypto.run(0, 3, "", m, 0, 0)
  end
#: _hmac/2 needs Crypto.run/6
  def _hmac(key: string, m: string): string do
    Crypto.run(1, 3, key, m, 0, 0)
  end

# The bytes being encoded (node.go: Encoder). Room for k more, with eight
# to spare: a byte is stored as a word.
#: _room/2
  def _room(n: integer, k: integer): integer do
    c = Sys.peek(n + 104)
    l = Sys.peek(n + 96)
    if l + k + 8 <= c do Sys.peek(n + 88) + l else
      m = if c == 0 do Sys.call(9, 0, 65536, 3, 34, -1, 0) else Sys.call(25, Sys.peek(n + 88), c, c * 2, 1) end
      if m < 0 do System.halt(71) end
      Sys.poke(n + 88, m)
      Sys.poke(n + 104, if c == 0 do 65536 else c * 2 end)
      Node._room(n, k)
    end
  end
#: _e0/1
  def _e0(n: integer): integer do
    Sys.poke(n + 96, 0)
  end
#: _et/1
  def _et(n: integer): string do
    Sys.text(Sys.peek(n + 88), Sys.peek(n + 96))
  end
#: _eb/2 needs _room/2
  def _eb(n: integer, v: integer): integer do
    Sys.poke(Node._room(n, 1), v)
    Sys.poke(n + 96, Sys.peek(n + 96) + 1)
  end
# An integer as Go's binary.AppendVarint writes it.
#: _ev/2 needs _eu/2
  def _ev(n: integer, v: integer): integer do
    Node._eu(n, Process.__xor(Process.__shl(v, 1), if v < 0 do -1 else 0 end))
  end
#: _eu/2 needs _eb/2
  def _eu(n: integer, u: integer): integer do
    if u >= 0 and u < 128 do Node._eb(n, u) else
      Node._eb(n, Process.__and(u, 127) + 128)
      Node._eu(n, Process.__shr(u, 7))
    end
  end
#: _es/2 needs _ev/2 _room/2
  def _es(n: integer, s: string): integer do
    k = byte_size(s)
    Node._ev(n, k)
    Sys.copy(Node._room(n, k), Sys.addr(s), k)
    Sys.poke(n + 96, Sys.peek(n + 96) + k)
  end
# The bytes as they are.
#: _er/2 needs _room/2
  def _er(n: integer, s: string): integer do
    k = byte_size(s)
    Sys.copy(Node._room(n, k), Sys.addr(s), k)
    Sys.poke(n + 96, Sys.peek(n + 96) + k)
  end
# The eight bytes of a word, the first the highest.
#: _e8/3 needs _eb/2
  def _e8(n: integer, w: integer, i: integer): integer do
    if i < 0 do 0 else
      Node._eb(n, Process.__and(Process.__shr(w, i), 255))
      Node._e8(n, w, i - 8)
    end
  end

# The bytes being decoded (node.go: Decoder): those of s from the byte at
# from, which came from peer p.
#: _d0/4
  def _d0(n: integer, s: string, from: integer, p: integer): integer do
    Sys.poke(n + 112, Sys.addr(s) + from)
    Sys.poke(n + 120, Sys.addr(s) + byte_size(s))
    Sys.poke(n + 128, 0)
    Sys.poke(n + 136, p)
  end
#: _dfail/1
  def _dfail(n: integer): integer do
    Sys.poke(n + 128, 1)
    Sys.poke(n + 112, Sys.peek(n + 120))
    0
  end
# A boolean: a missing byte fails and leaves the rest.
#: _db/1
  def _db(n: integer): integer do
    a = Sys.peek(n + 112)
    if a >= Sys.peek(n + 120) do Sys.poke(n + 128, 1) * 0 else
      Sys.poke(n + 112, a + 1)
      if Sys.byte(a) == 0 do 0 else 1 end
    end
  end
#: _dv/1 needs _du/4
  def _dv(n: integer): integer do
    u = Node._du(n, 0, 0, 0)
    Process.__xor(Process.__shr(u, 1), 0 - Process.__and(u, 1))
  end
#: _du/4 needs _dfail/1
  def _du(n: integer, u: integer, shift: integer, i: integer): integer do
    a = Sys.peek(n + 112)
    if a >= Sys.peek(n + 120) or i == 10 do Node._dfail(n) else
      b = Sys.byte(a)
      Sys.poke(n + 112, a + 1)
      if i == 9 and b > 1 do Node._dfail(n) else
        v = Process.__or(u, Process.__shl(Process.__and(b, 127), shift))
        if b < 128 do v else Node._du(n, v, shift + 7, i + 1) end
      end
    end
  end
# The length of something the rest of the bytes could hold.
#: _dn/1 needs _dfail/1 _dv/1
  def _dn(n: integer): integer do
    k = Node._dv(n)
    if k < 0 or k > Sys.peek(n + 120) - Sys.peek(n + 112) do Node._dfail(n) else k end
  end
#: _ds/1 needs _dn/1
  def _ds(n: integer): string do
    k = Node._dn(n)
    a = Sys.peek(n + 112)
    Sys.poke(n + 112, a + k)
    Sys.text(a, k)
  end
#: _d8/3 needs _dfail/1
  def _d8(n: integer, w: integer, i: integer): integer do
    a = Sys.peek(n + 112)
    if i == 0 and Sys.peek(n + 120) - a < 8 do Node._dfail(n) else
      if i == 8 do w else
        Sys.poke(n + 112, a + 1)
        Node._d8(n, Process.__or(Process.__shl(w, 8), Sys.byte(a)), i + 1)
      end
    end
  end
# What is left of the bytes.
#: _drest/1
  def _drest(n: integer): string do
    Sys.text(Sys.peek(n + 112), Sys.peek(n + 120) - Sys.peek(n + 112))
  end

# A value, the word w, is written by the node of its type (codec.go).
#: _e/4 needs _e8/3 _eb/2 _ef/5 _el/5 _em/6 _epid/4 _es/2 _ev/2 _u16/1 _var/2 Sys.flat/1
  def _e(n: integer, node: integer, root: integer, w: integer): integer do
    t = Sys.byte(node + 2)
    if t == 0 do Node._ev(n, w) else if t == 2 or t == 22 do Node._es(n, Process.__any(w)) else if t == 3 do Node._eb(n, if w == 0 do 0 else 1 end) else if t == 24 do Node._e8(n, w, 56) else
      if t == 7 do
        Node._ev(n, Sys.peek(w))
        Node._el(n, node + 3, root, w, Sys.peek(w))
      else if t == 5 or t == 13 do Node._ef(n, node + 4, root, w + 8, Sys.byte(node + 3)) else
        if t == 14 do
          v = Sys.peek(w + 8)
          r = Node._var(node + 4, v)
          Node._ev(n, v)
          Node._ef(n, r + 3, root, w + 16, Sys.byte(r + 2))
        else if t == 4 do
          if w == 0 do Node._eb(n, 0) else
            Node._eb(n, 2)
            Node._e(n, node + 3, root, Sys.peek(w + 8))
          end
        else if t == 6 or t == 31 do
          first = Sys.peek(w) == 1
          Node._eb(n, if t == 31 do if first do 1 else 0 end else if first do 0 else 2 end end)
          if first do Node._e(n, node + 3, root, Sys.peek(w + 8)) else
            if t == 31 do Node._es(n, Process.__any(Sys.peek(w + 8))) else Node._e(n, node + 3 + Node._u16(node + 3), root, Sys.peek(w + 8)) end
          end
        else if t == 8 or t == 25 do
          f = Sys.flat(w)
          Node._ev(n, Sys.peek(f))
          Node._em(n, node + 3, root, f + 8, Sys.peek(f), t)
        else if t == 30 do Node._epid(n, node + 3, root, Sys.peek(w + 8)) else if t == 20 do Node._e(n, root + Node._u16(node + 3), root, w) else
          a = Sys.peek(node + 3)
          Node._e(n, a, a, w)
        end end end end end end end
      end
    end end end end
  end
# Variant v of a sum type whose variants start at r.
#: _var/2 needs _u16/1
  def _var(r: integer, v: integer): integer do
    if v == 0 do r else Node._var(r + Node._u16(r), v - 1) end
  end
#: _el/5 needs _e/4
  def _el(n: integer, node: integer, root: integer, p: integer, k: integer): integer do
    if k == 0 do 0 else
      Node._e(n, node, root, Sys.peek(p + 8))
      Node._el(n, node, root, p + 16, k - 1)
    end
  end
# k fields, the first at a, by the nodes from node.
#: _ef/5 needs _e/4 _u16/1
  def _ef(n: integer, node: integer, root: integer, a: integer, k: integer): integer do
    if k == 0 do 0 else
      Node._e(n, node, root, Sys.peek(a))
      Node._ef(n, node + Node._u16(node), root, a + 8, k - 1)
    end
  end
# k entries of a map (t 8) or elements of a set, the first at a.
#: _em/6 needs _e/4 _u16/1
  def _em(n: integer, node: integer, root: integer, a: integer, k: integer, t: integer): integer do
    if k == 0 do 0 else
      Node._e(n, node, root, Sys.peek(a))
      if t == 8 do Node._e(n, node + Node._u16(node), root, Sys.peek(a + 8)) end
      Node._em(n, node, root, a + 16, k - 1, t)
    end
  end
# A handle as its node's name and its number. A process of this node can
# be reached from the others once it was named in a message.
#: _epid/4 needs _es/2 _ev/2 _export/4 _name/1
  def _epid(n: integer, node: integer, root: integer, q: integer): integer do
    if Sys.peek(q + 320) == 2 do Node._es(n, Process.__any(Sys.peek(q))) else
      Node._export(n, q, node, root)
      Node._es(n, Node._name(n))
    end
    Node._ev(n, Sys.peek(q + 40))
  end
#: _export/4 needs Process._cell/4 Process._g/0 Process._has/2 Process._push/5
  def _export(n: integer, q: integer, node: integer, root: integer): integer do
    g = Process._g()
    if Process._has(n + 40, Sys.peek(q + 40)) != 0 do 0 else Process._push(g, n + 40, Sys.peek(q + 40), q, Process._cell(g, node, root, 0) + 8) end
  end
# The process of that number is no longer reached from other nodes.
#: _unexport/2 needs Process._drop/3 Process._free/2 Process._g/0 Process._has/2
  def _unexport(n: integer, id: integer): integer do
    g = Process._g()
    x = Process._has(n + 40, id)
    if x == 0 do 0 else
      Process._free(g, Sys.peek(x + 24) - 8)
      Process._drop(g, n + 40, id)
    end
  end

# A record of k words behind its count, all zero.
#: _rec/2 needs Process._g/0
  def _rec(count: integer, k: integer): integer do
    g = Process._g()
    w = if k <= 256 do Process.__word(Sys.text(g + 2048, 8 * k)) else
      m = Sys.call(9, 0, 8 * k, 3, 34, -1, 0)
      if m < 0 do System.halt(71) end
      t = Process.__word(Sys.text(m, 8 * k))
      Sys.call(11, m, 8 * k)
      t
    end
    Sys.poke(w, count)
    w
  end
# The value the bytes hold, by the node of its type: its word. Once the
# bytes did not fit, 0, which nothing may read.
#: _d/3 needs _d8/3 _db/1 _df/5 _dfail/1 _dl/5 _dm/4 _dn/1 _dpid/3 _ds/1 _dv/1 _rec/2 _u16/1 _var/2
  def _d(n: integer, node: integer, root: integer): integer do
    t = Sys.byte(node + 2)
    if Sys.peek(n + 128) == 1 do 0 else if t == 0 do Node._dv(n) else if t == 2 or t == 22 do Process.__word(Node._ds(n)) else if t == 3 do Node._db(n) else if t == 24 do Node._d8(n, 0, 0) else
      if t == 7 do
        empty: list[integer] = []
        Node._dl(n, node + 3, root, Node._dn(n), empty)
      else if t == 5 or t == 13 do
        w = Node._rec(Sys.byte(node + 3), Sys.byte(node + 3))
        Node._df(n, node + 4, root, w + 8, Sys.byte(node + 3))
        w
      else if t == 14 do
        v = Node._dv(n)
        if v < 0 or v >= Sys.byte(node + 3) do Node._dfail(n) else
          r = Node._var(node + 4, v)
          w = Node._rec(Sys.byte(r + 2) + 1, Sys.byte(r + 2) + 1)
          Sys.poke(w + 8, v)
          Node._df(n, r + 3, root, w + 16, Sys.byte(r + 2))
          w
        end
      else if t == 4 or t == 6 do
        v = Node._dv(n)
        if v < 0 or v > 1 do Node._dfail(n) else if t == 4 and v == 0 do 0 else
          w = Node._rec(if t == 4 do 1 else 1 - v end, 1)
          Sys.poke(w + 8, Node._d(n, if t == 6 and v == 1 do node + 3 + Node._u16(node + 3) else node + 3 end, root))
          w
        end end
      else if t == 31 do
        v = Node._db(n)
        w = Node._rec(v, 1)
        Sys.poke(w + 8, if v == 1 do Node._d(n, node + 3, root) else Process.__word(Node._ds(n)) end)
        w
      else if t == 8 or t == 25 do Node._dm(n, node + 3, root, t) else if t == 30 do Node._dpid(n, node + 3, root) else if t == 20 do Node._d(n, root + Node._u16(node + 3), root) else
        a = Sys.peek(node + 3)
        Node._d(n, a, a)
      end end end end end end end end
    end end end end end
  end
#: _dl/5 needs Enum.reverse/1 _d/3
  def _dl(n: integer, node: integer, root: integer, k: integer, got: list[integer]): integer do
    if k == 0 or Sys.peek(n + 128) == 1 do Process.__word(Enum.reverse(got)) else
      v = Node._d(n, node, root)
      Node._dl(n, node, root, k - 1, [v | got])
    end
  end
#: _df/5 needs _d/3 _u16/1
  def _df(n: integer, node: integer, root: integer, a: integer, k: integer): integer do
    if k == 0 do 0 else
      Sys.poke(a, Node._d(n, node, root))
      Node._df(n, node + Node._u16(node), root, a + 8, k - 1)
    end
  end
# A map or a set: its entries in the order of their keys, a key that
# comes twice with what came last.
#: _dm/4 needs Enum.sort/2 _cmp/4 _dme/6 _dmw/5 _dn/1 _rec/2
  def _dm(n: integer, node: integer, root: integer, t: integer): integer do
    empty: list[tuple[integer, integer]] = []
    read = Node._dme(n, node, root, Node._dn(n), t, empty)
    if Sys.peek(n + 128) == 1 do 0 else
      sorted = Enum.sort(read, fn a, b -> Node._cmp(node, root, elem(a, 0), elem(b, 0)) >= 0 end)
      w = Node._rec(0, 2 * length(sorted))
      k = Node._dmw(node, root, w, sorted, 0)
      Sys.poke(w, k)
      w
    end
  end
# The entries as read, the last first.
#: _dme/6 needs _d/3 _u16/1
  def _dme(n: integer, node: integer, root: integer, k: integer, t: integer, got: list[tuple[integer, integer]]): list[tuple[integer, integer]] do
    if k == 0 or Sys.peek(n + 128) == 1 do got else
      key = Node._d(n, node, root)
      v = if t == 8 do Node._d(n, node + Node._u16(node), root) else 1 end
      Node._dme(n, node, root, k - 1, t, [{key, v} | got])
    end
  end
# The entries, greatest key first and of equal keys the last read first,
# are written from the end of the record; a key already written is passed
# over. How many were written; they are moved to the front.
#: _dmw/5 needs _dmk/5
  def _dmw(node: integer, root: integer, w: integer, es: list[tuple[integer, integer]], k: integer): integer do
    total = length(es)
    kept = Node._dmk(node, root, w + 8 + 16 * total, es, 0)
    if kept < total do Sys.copy(w + 8, w + 8 + 16 * (total - kept), 16 * kept) end
    kept
  end
#: _dmk/5 needs _cmp/4
  def _dmk(node: integer, root: integer, a: integer, es: list[tuple[integer, integer]], k: integer): integer do
    case es do
      [] -> k
      [{key, v} | rest] ->
        if k > 0 and Node._cmp(node, root, key, Sys.peek(a)) == 0 do Node._dmk(node, root, a, rest, k) else
          Sys.poke(a - 16, key)
          Sys.poke(a - 8, v)
          Node._dmk(node, root, a - 16, rest, k + 1)
        end
    end
  end
# The order of two keys, as the map routines keep it: -1, 0 or 1.
#: _cmp/4 needs _cmpf/5 _u16/1
  def _cmp(node: integer, root: integer, a: integer, b: integer): integer do
    t = Sys.byte(node + 2)
    if t == 0 or t == 3 do if a < b do -1 else if a == b do 0 else 1 end end else
      if t == 2 or t == 22 do
        x: string = Process.__any(a)
        y: string = Process.__any(b)
        if x < y do -1 else if x == y do 0 else 1 end end
      else if t == 24 do
        fx: float = Process.__any(a)
        fy: float = Process.__any(b)
        if fx < fy do -1 else if fx == fy do 0 else 1 end end
      else if t == 5 do Node._cmpf(node + 4, root, a + 8, b + 8, Sys.byte(node + 3)) else if t == 20 do Node._cmp(root + Node._u16(node + 3), root, a, b) else
        Node._cmp(Sys.peek(node + 3), Sys.peek(node + 3), a, b)
      end end end end
    end
  end
#: _cmpf/5 needs _cmp/4 _u16/1
  def _cmpf(node: integer, root: integer, a: integer, b: integer, k: integer): integer do
    if k == 0 do 0 else
      c = Node._cmp(node, root, Sys.peek(a), Sys.peek(b))
      if c != 0 do c else Node._cmpf(node + Node._u16(node), root, a + 8, b + 8, k - 1) end
    end
  end
# A handle: the process itself when it is one of this node whose messages
# are of the type, else the handle of another node's process, which only
# reaches it when that node is connected.
#: _dpid/3 needs Process._has/2 _dfail/1 _ds/1 _dv/1 _fits/5 _handle/5 _name/1 _peer/2
  def _dpid(n: integer, node: integer, root: integer): integer do
    name = Node._ds(n)
    id = Node._dv(n)
    q = if name != Node._name(n) do Node._handle(n, Node._peer(n, name), name, id, [node, root]) else
      x = Process._has(n + 40, id)
      c = if x == 0 do 0 else Sys.peek(x + 24) end
      if x != 0 and Node._fits(node, root, Sys.peek(c), Sys.peek(c + 8), 64) == 1 do Sys.peek(x + 16) else
        Node._dfail(n)
        Node._handle(n, 0, name, id, [0, 0])
      end
    end
    h: pid[integer] = %pid{at: q, k: none}
    Process.__word(h)
  end
# 1 when two nodes describe one type.
#: _fits/5 needs _fitn/6 _u16/1
  def _fits(a: integer, ra: integer, b: integer, rb: integer, fuel: integer): integer do
    ta = Sys.byte(a + 2)
    tb = Sys.byte(b + 2)
    if fuel == 0 do 1 else if ta == 32 do Node._fits(Sys.peek(a + 3), Sys.peek(a + 3), b, rb, fuel) else if tb == 32 do Node._fits(a, ra, Sys.peek(b + 3), Sys.peek(b + 3), fuel) else
      if ta == 20 and tb == 20 do if Node._u16(a + 3) == Node._u16(b + 3) do 1 else Node._fits(ra + Node._u16(a + 3), ra, rb + Node._u16(b + 3), rb, fuel - 1) end else
        if ta == 20 do Node._fits(ra + Node._u16(a + 3), ra, b, rb, fuel - 1) else if tb == 20 do Node._fits(a, ra, rb + Node._u16(b + 3), rb, fuel - 1) else
          if ta != tb do 0 else
            if ta == 4 or ta == 7 or ta == 25 or ta == 30 or ta == 31 do Node._fits(a + 3, ra, b + 3, rb, fuel) else
              if ta == 6 or ta == 8 do Node._fitn(a + 3, ra, b + 3, rb, 2, fuel) else
