    sent = if dialling == 1 do TCP._write(g, b, Sys.addr(mine), 1, d) else "" end
    other = if sent != "" do "" else Node._get(g, b, 1, d) end
    if dialling == 0 and other != "" do TCP._write(g, b, Sys.addr(mine), 1, d) end
    if sent != "" do sent else
      if other == "" do if dialling == 1 do "the other end closed the connection before saying whether it encrypts; it may not be an Alchem node of this version" else "EOF" end else
        if other == mine do "" else
          if mine == "T" and other == "P" do "this node encrypts its connections and the other node does not; start both with the same encrypted: setting" else
            if mine == "P" and other == "T" do "the other node encrypts its connections and this one does not; start both with the same encrypted: setting" else "the other end is not an Alchem node of this version" end
          end
        end
      end
    end
