# TCP: sockets as the pinned runtime has them (compiler/library.go.txt,
# "---- TCP ----"), on Linux system calls (spec/alchem-network.md). A
# descriptor never blocks: a call that has to wait gives way to the other
# processes until poll finds the descriptor ready (Process._fdwait).
#
# A socket is a block: 0 the descriptor, 8 what it is (1 listens, 2 a
# connection, 3 UDP), 16 closed, 24 the process whose end closes it, 32 the
# process given by controlling_process (0: none), 40 how packets are cut
# (0 as they come, 1, 2 or 4 bytes of length before each, 5 lines), 48 the
# pieces of a packet read in part and 128 their bytes, 56 how many packets
# are still to be sent as messages (-1: all), 64 the process that sends
# them (0: none), 72 the options a listener hands on (0: none), 80 what
# was read from the system and 168 how much of that was taken, 88 the
# process that reads
# and 96 those that wait to, 104 its address and 112 the other end's (0:
# none), 120 why the last read gave nothing (0: it gave), 136 the address
# as the system holds it, 144 set once anything was read, 152 set when an
# HTTP answer read in pieces keeps the connection, 176 what TLS keeps for
# it (0: none; library/TLS.alc) and 184, 192 and 200 the functions that
# read, write and close through it.
#
# g + 304 is a mapping of working memory: 0 an address for the system, 128
# small numbers, 4096 up 196608 bytes read or to be joined. The other
# words of g these modules keep: 312 the requests an HTTP server is
# answering, 320 the tables of gzip and deflate (library/HTTP.alc), 328 the
# open stores (library/DiskStore.alc), 344 and 352 the second a Date header
# was last made for and its text, 360 the texts of the status codes, 368
# and 376 what bodies of some kinds begin with, 384 set when the last name
# could not be asked for, 392 and 400 the proxy settings of the
# environment and whether they were read.
#: struct socket also TCP UDP HTTP WebSocket Node Stream.publish TLS
  struct socket do
    at: integer
    k: option[fn[integer, integer]]
  end
  type TCP.Event do
    data(text: string)
    closed
    error(reason: string)
  end
#: _s/0 needs Process._g/0
  def _s(): integer do
    g = Process._g()
    s = Sys.peek(g + 304)
    if s != 0 do s else
      m = Sys.call(9, 0, 262144, 3, 34, -1, 0)
      if m < 0 do System.halt(71) end
      Sys.poke(g + 304, m)
    end
  end
# The index of the last byte c of the n at p, or -1.
#: _last/3
  def _last(p: integer, n: integer, c: integer): integer do
    if n == 0 do -1 else if Sys.byte(p + n - 1) == c do n - 1 else TCP._last(p, n - 1, c) end end
  end
# n bytes of a from index i.
#: _sub/3
  def _sub(a: string, i: integer, n: integer): string do
    Sys.text(Sys.addr(a) + i, n)
  end
# The text in lower case (ASCII).
#: _lower/1 needs _lower1/3 _s/0
  def _lower(a: string): string do
    n = byte_size(a)
    if n > 196608 do a else
      s = TCP._s() + 4096
      TCP._lower1(Sys.addr(a), s, n)
      Sys.text(s, n)
    end
  end
#: _lower1/3
  def _lower1(p: integer, q: integer, n: integer): integer do
    if n == 0 do 0 else
      c = Sys.byte(p)
      Sys.poke(q, if c >= 65 and c <= 90 do c + 32 else c end)
      TCP._lower1(p + 1, q + 1, n - 1)
    end
  end
# net.SplitHostPort: the host, the port, and what is wrong with the address
# ("" when nothing is).
#: _split/1 needs _last/3 _split2/5
  def _split(a: string): tuple[string, string, string] do
    n = byte_size(a)
    p = Sys.addr(a)
    i = TCP._last(p, n, 58)
    if i < 0 do {"", "", "missing port in address"} else
      if Sys.byte(p) == 91 do
        e = Sys.find(p, n, 93)
        if e < 0 do {"", "", "missing ']' in address"} else
          if e + 1 == n do {"", "", "missing port in address"} else
            if e + 1 != i do {"", "", if Sys.byte(p + e + 1) == 58 do "too many colons in address" else "missing port in address" end} else TCP._split2(a, 1, e, i, e + 1) end
          end
        end
      else
        if Sys.find(p, i, 58) >= 0 do {"", "", "too many colons in address"} else TCP._split2(a, 0, i, i, 0) end
      end
    end
  end
#: _split2/5 needs _sub/3
  def _split2(a: string, j: integer, e: integer, i: integer, k: integer): tuple[string, string, string] do
    n = byte_size(a)
    p = Sys.addr(a)
    if Sys.find(p + j, n - j, 91) >= 0 do {"", "", "unexpected '[' in address"} else
      if Sys.find(p + k, n - k, 93) >= 0 do {"", "", "unexpected ']' in address"} else {TCP._sub(a, j, e - j), TCP._sub(a, i + 1, n - i - 1), ""} end
    end
  end
# Decimal digits as Go's parsePort reads them: -1 for anything else.
#: _pnum/3
  def _pnum(p: integer, n: integer, v: integer): integer do
    if n == 0 or v >= 1073741824 do v else
      c = Sys.byte(p) - 48
      if c < 0 or c > 9 do -1 else TCP._pnum(p + 1, n - 1, v * 10 + c) end
    end
  end
# The port a service names for a network: the number, or -1 and why.
#: _port/2 needs _pnum/3 _service/2
  def _port(net: string, t: string): tuple[integer, string] do
    n = byte_size(t)
    p = Sys.addr(t)
    c = if n == 0 do 0 else Sys.byte(p) end
    sign = if c == 43 or c == 45 do 1 else 0 end
    v = TCP._pnum(p + sign, n - sign, 0)
    if v == -1 do
      f = TCP._service(net, t)
      if f < 0 do {-1, "lookup " <> net <> "/" <> t <> ": unknown port"} else {f, ""} end
    else
      if c == 45 and v > 0 or v > 65535 do {-1, "address " <> t <> ": invalid port"} else {v, ""} end
    end
  end
# The whole of a file, "" when it cannot be read.
#: _file/1 needs Sys.open/3 _filed/3 _join/2
  def _file(path: string): string do
    fd = Sys.open(path, 0, 0)
    if fd < 0 do "" else
      empty: list[string] = []
      pieces = TCP._filed(fd, empty, 0)
      Sys.call(3, fd)
      TCP._join(pieces, Enum.reduce(pieces, 0, fn x, acc -> acc + byte_size(x) end))
    end
  end
#: _filed/3 needs _s/0
  def _filed(fd: integer, got: list[string], size: integer): list[string] do
    s = TCP._s() + 4096
    n = Sys.call(0, fd, s, 196608)
    if n == -4 do TCP._filed(fd, got, size) else
      if n <= 0 or size > 67108864 do got else TCP._filed(fd, got ++ [Sys.text(s, n)], size + n) end
    end
  end
# The next word of the n bytes at p, blanks before it passed over: where
# it starts and its length (0: none).
#: _word/2 needs _wend/2
  def _word(p: integer, n: integer): tuple[integer, integer] do
    if n == 0 do {p, 0} else
      c = Sys.byte(p)
      if c == 32 or c == 9 or c == 13 do TCP._word(p + 1, n - 1) else {p, TCP._wend(p, n)} end
    end
  end
#: _wend/2
  def _wend(p: integer, n: integer): integer do
    if n == 0 do 0 else
      c = Sys.byte(p)
      if c == 32 or c == 9 or c == 13 do 0 else 1 + TCP._wend(p + 1, n - 1) end
    end
  end
# The length of the line at p without its comment.
#: _line/2
  def _line(p: integer, n: integer): integer do
    e = Sys.find(p, n, 10)
    m = if e < 0 do n else e end
    h = Sys.find(p, m, 35)
    if h < 0 do m else h end
  end
# /etc/services, then the few Go knows by itself.
#: _service/2 needs _file/1 _lower/1 _svc/4
  def _service(net: string, name: string): integer do
    t = TCP._file("/etc/services")
    w = TCP._lower(name)
    f = TCP._svc(Sys.addr(t), byte_size(t), w, "/" <> net)
    if f >= 0 do f else
      known = if net == "udp" do [{"domain", 53}] else [{"ftp", 21}, {"ftps", 990}, {"gopher", 70}, {"http", 80}, {"https", 443}, {"imap2", 143}, {"imap3", 220}, {"imaps", 993}, {"pop3", 110}, {"pop3s", 995}, {"smtp", 25}, {"submissions", 465}, {"ssh", 22}, {"telnet", 23}] end
      Enum.reduce(known, -1, fn {k, v}, acc -> if k == w do v else acc end end)
    end
  end
#: _svc/4 needs _line/2 _pnum/3 _svcname/3 _word/2
  def _svc(p: integer, n: integer, name: string, net: string): integer do
    if n <= 0 do -1 else
      e = Sys.find(p, n, 10)
      step = if e < 0 do n else e + 1 end
      m = TCP._line(p, n)
      {a, an} = TCP._word(p, m)
      {b, bn} = TCP._word(a + an, m - (a + an - p))
      slash = Sys.find(b, bn, 47)
      port = if slash <= 0 do -1 else TCP._pnum(b, slash, 0) end
      fits = port >= 0 and Sys.text(b + slash, bn - slash) == net
      if fits and TCP._svcname(a, p + m - a, name) == 1 do port else TCP._svc(p + step, n - step, name, net) end
    end
  end
# 1 when one of the words at p is the name; the second is the port and is
# no name.
#: _svcname/3 needs _word/2
  def _svcname(p: integer, n: integer, name: string): integer do
    {a, an} = TCP._word(p, n)
    if an == 0 do 0 else
      if Sys.text(a, an) == name do 1 else TCP._svcname(a + an, n - (a + an - p), name) end
    end
  end
# An IPv4 address as Go reads one: four numbers from 0 to 255 without
# leading zeros. The address as a number, or -1.
#: _ip4/2 needs _ip4n/4
  def _ip4(p: integer, n: integer): integer do
    TCP._ip4n(p, n, 0, 0)
  end
#: _ip4n/4 needs _digits/2 _pnum/3
  def _ip4n(p: integer, n: integer, k: integer, v: integer): integer do
    d = TCP._digits(p, n)
    x = if d == 0 or d > 3 do -1 else TCP._pnum(p, d, 0) end
    if x < 0 or x > 255 or d > 1 and Sys.byte(p) == 48 do -1 else
      if k == 3 do if d == n do v * 256 + x else -1 end else
        if d < n and Sys.byte(p + d) == 46 do TCP._ip4n(p + d + 1, n - d - 1, k + 1, v * 256 + x) else -1 end
      end
    end
  end
#: _digits/2
  def _digits(p: integer, n: integer): integer do
    if n == 0 do 0 else
      c = Sys.byte(p)
      if c < 48 or c > 57 do 0 else 1 + TCP._digits(p + 1, n - 1) end
    end
  end
# An IPv4 address as the C library's inet_aton reads one: one to four
# numbers, each decimal, octal behind 0 or hexadecimal behind 0x, the last
# filling the bytes that are left. The address, or -1.
#: _aton/4 needs Enum.at/3 _atonv/4
  def _aton(p: integer, n: integer, k: integer, v: integer): integer do
    base = if n >= 2 and Sys.byte(p) == 48 and (Sys.byte(p + 1) == 120 or Sys.byte(p + 1) == 88) do 16 else if n >= 1 and Sys.byte(p) == 48 do 8 else 10 end end
    skip = if base == 16 do 2 else 0 end
    {d, x} = TCP._atonv(p + skip, n - skip, base, {0, 0})
    used = skip + d
    if d == 0 and base != 16 or x < 0 do -1 else
      if used == n do
        most = Enum.at([4294967295, 16777215, 65535, 255], k, 0)
        if x > most do -1 else v * (most + 1) + x end
      else
        if k == 3 or x > 255 or Sys.byte(p + used) != 46 do -1 else TCP._aton(p + used + 1, n - used - 1, k + 1, v * 256 + x) end
      end
    end
  end
# The digits of a base at p: how many, and their value (-1 past 32 bits).
#: _atonv/4
  def _atonv(p: integer, n: integer, base: integer, acc: tuple[integer, integer]): tuple[integer, integer] do
    {d, x} = acc
    c = if n == 0 do 0 else Sys.byte(p) end
    v = if c >= 48 and c <= 57 do c - 48 else if c >= 97 and c <= 102 do c - 87 else if c >= 65 and c <= 70 do c - 55 else 99 end end end
    if n == 0 or v >= base do acc else
      if x < 0 or x * base + v > 4294967295 do TCP._atonv(p + 1, n - 1, base, {d + 1, -1}) else TCP._atonv(p + 1, n - 1, base, {d + 1, x * base + v}) end
    end
  end
# An IPv6 address without its zone, as its eight groups; [] when it is
# none.
#: _ip6/2 needs Enum.any?/2 List.duplicate/2 _dcolon/2 _groups/2
  def _ip6(p: integer, n: integer): list[integer] do
    i = TCP._dcolon(p, n)
    if i < 0 do
      g = TCP._groups(p, n)
      if length(g) != 8 or Enum.any?(g, fn x -> x < 0 end) do [] else g end
    else
      head = TCP._groups(p, i)
      tail = TCP._groups(p + i + 2, n - i - 2)
      all = head ++ tail
      if length(all) > 7 or Enum.any?(all, fn x -> x < 0 end) do [] else head ++ List.duplicate(0, 8 - length(all)) ++ tail end
    end
  end
# Where "::" stands, or -1.
#: _dcolon/2
  def _dcolon(p: integer, n: integer): integer do
    i = Sys.find(p, n, 58)
    if i < 0 or i + 1 >= n do -1 else
      if Sys.byte(p + i + 1) == 58 do i else
        r = TCP._dcolon(p + i + 1, n - i - 1)
        if r < 0 do -1 else r + i + 1 end
      end
    end
  end
# Groups of hexadecimal digits with a colon between them, the last maybe an
# IPv4 address; one that is none is -1.
#: _groups/2 needs _atonv/4 _ip4/2
  def _groups(p: integer, n: integer): list[integer] do
    if n == 0 do [] else
      j = Sys.find(p, n, 58)
      if j < 0 do
        if Sys.find(p, n, 46) >= 0 do
          v = TCP._ip4(p, n)
          if v < 0 do [-1] else [div(v, 65536), rem(v, 65536)] end
        else
          {d, x} = TCP._atonv(p, n, 16, {0, 0})
          if d != n or d > 4 do [-1] else [x] end
        end
      else
        {d, x} = TCP._atonv(p, j, 16, {0, 0})
        if d != j or d == 0 or d > 4 or j + 1 == n do [-1] else [x] ++ TCP._groups(p + j + 1, n - j - 1) end
      end
    end
  end
# An address as the system takes it, for IPv4: sixteen bytes.
#: _sa4/2 needs _s/0
  def _sa4(v: integer, port: integer): string do
    s = TCP._s()
    Sys.poke(s, 2 + div(port, 256) * 65536 + rem(port, 256) * 16777216)
    Sys.poke(s + 4, div(v, 16777216) + rem(div(v, 65536), 256) * 256 + rem(div(v, 256), 256) * 65536)
    Sys.poke(s + 7, rem(v, 256))
    Sys.poke(s + 8, 0)
    Sys.text(s, 16)
  end
# And for IPv6, of eight groups and a zone: twenty-eight bytes.
#: _sa6/3 needs _s/0
  def _sa6(g: list[integer], zone: integer, port: integer): string do
    s = TCP._s()
    Sys.poke(s, 10 + div(port, 256) * 65536 + rem(port, 256) * 16777216)
    Enum.reduce(g, s + 8, fn x, a ->
      Sys.poke(a, div(x, 256) + rem(x, 256) * 256)
      a + 2
    end)
    Sys.poke(s + 24, zone)
    Sys.text(s, 28)
  end
# The same address with another port.
#: _ported/2 needs _s/0
  def _ported(a: string, port: integer): string do
    s = TCP._s()
    n = byte_size(a)
    Sys.copy(s, Sys.addr(a), n)
    Sys.poke(s + 2, div(port, 256) + rem(port, 256) * 256 + div(Sys.peek(s + 2), 65536) * 65536)
    Sys.text(s, n)
  end
#: _saport/1
  def _saport(a: string): integer do
    p = Sys.addr(a)
    Sys.byte(p + 2) * 256 + Sys.byte(p + 3)
  end
# The eight groups of an IPv6 address.
#: _sagroups/2
  def _sagroups(p: integer, k: integer): list[integer] do
    if k == 8 do [] else [Sys.byte(p + 8 + 2 * k) * 256 + Sys.byte(p + 9 + 2 * k)] ++ TCP._sagroups(p, k + 1) end
  end
# 1 for the address that stands for every address of the machine.
#: _any/1 needs Enum.all?/2 _sagroups/2
  def _any(a: string): integer do
    p = Sys.addr(a)
    if Sys.byte(p) == 2 do if rem(div(Sys.peek(p), 4294967296), 4294967296) == 0 do 1 else 0 end else
      if Enum.all?(TCP._sagroups(p, 0), fn x -> x == 0 end) do 1 else 0 end
    end
  end
# The number of a zone: an interface's name or a number; 0 for none.
#: _zone/1 needs _pnum/3 _s/0
  def _zone(z: string): integer do
    n = byte_size(z)
    v = if n == 0 do 0 else TCP._pnum(Sys.addr(z), n, 0) end
    if n == 0 or n > 15 do 0 else
      if v >= 0 do v else
        s = TCP._s() + 256
        Sys.poke(s, 0)
        Sys.poke(s + 8, 0)
        Sys.poke(s + 16, 0)
        Sys.copy(s, Sys.addr(z), n)
        fd = Sys.call(41, 2, 0x80002, 0)
        r = Sys.call(16, fd, 0x8933, s)
        Sys.call(3, fd)
        if r < 0 do 0 else rem(Sys.peek(s + 16), 4294967296) end
      end
    end
  end
#: _zonename/1 needs _s/0
  def _zonename(z: integer): string do
    s = TCP._s() + 256
    Sys.poke(s, 0)
    Sys.poke(s + 8, 0)
    Sys.poke(s + 16, z)
    fd = Sys.call(41, 2, 0x80002, 0)
    r = Sys.call(16, fd, 0x8910, s)
    Sys.call(3, fd)
    if r < 0 do "#{z}" else Sys.text(s, Sys.len(s)) end
  end
# An address the host h is written as, without a lookup: "" when it is a
# name. Go's own reading first, then the C library's (inet_aton's 127.1,
# 0x7f.0.0.1, 2130706433), which Windows' GetAddrInfoW does not have.
#: _literal/1 needs Enum.at/3 Enum.take/2 _aton/4 _ip4/2 _ip6/2 _sa4/2 _sa6/3 _sub/3 _zone/1
  def _literal(h: string): string do
    n = byte_size(h)
    p = Sys.addr(h)
    v = TCP._ip4(p, n)
    if v >= 0 do TCP._sa4(v, 0) else
      z = Sys.find(p, n, 37)
      g = TCP._ip6(p, if z < 0 do n else z end)
      if g != [] do
        if Enum.take(g, 6) == [0, 0, 0, 0, 0, 65535] do TCP._sa4(Enum.at(g, 6, 0) * 65536 + Enum.at(g, 7, 0), 0) else
          TCP._sa6(g, if z < 0 do 0 else TCP._zone(TCP._sub(h, z + 1, n - z - 1)) end, 0)
        end
      else
        w = if n == 0 do -1 else if Sys.windows() == 1 do -1 else TCP._aton(p, n, 0, 0) end end
        if w >= 0 do TCP._sa4(w, 0) else "" end
      end
    end
  end
# The addresses /etc/hosts gives a name, in the file's order.
#: _hosts/3 needs _hostsn/3 _line/2 _literal/1 _word/2
  def _hosts(p: integer, n: integer, name: string): list[string] do
    if n <= 0 do [] else
      e = Sys.find(p, n, 10)
      step = if e < 0 do n else e + 1 end
      m = TCP._line(p, n)
      {a, an} = TCP._word(p, m)
      here = if an > 0 and TCP._hostsn(a + an, p + m - a - an, name) == 1 do TCP._literal(Sys.text(a, an)) else "" end
      if here == "" do TCP._hosts(p + step, n - step, name) else [here] ++ TCP._hosts(p + step, n - step, name) end
    end
  end
#: _hostsn/3 needs _lower/1 _word/2
  def _hostsn(p: integer, n: integer, name: string): integer do
    {a, an} = TCP._word(p, n)
    if an == 0 do 0 else
      if TCP._lower(Sys.text(a, an)) == name do 1 else TCP._hostsn(a + an, n - (a + an - p), name) end
    end
  end
# The addresses of a host, each with port 0; [] when it has none. An
# address written out is itself; a name is looked up in /etc/hosts and then
# asked of the name servers of /etc/resolv.conf, which is the order the C
# library's getaddrinfo follows for the pinned runtime on a system set up
# the usual way ("hosts: files dns").
#: _resolve/1 needs Process._g/0 _dns/1 _file/1 _hostname/2 _hosts/3 _literal/1 _lower/1 _sub/3 _usable/1 _wresolve/1
  def _resolve(h: string): list[string] do
    l = TCP._literal(h)
    if l != "" do [l] else
      n = byte_size(h)
      bare = TCP._lower(if n > 1 and Sys.byte(Sys.addr(h) + n - 1) == 46 do TCP._sub(h, 0, n - 1) else h end)
      Sys.poke(Process._g() + 384, 0)
      if Sys.windows() == 1 do TCP._usable(TCP._wresolve(bare)) else
        t = TCP._file("/etc/hosts")
        found = TCP._hosts(Sys.addr(t), byte_size(t), bare)
        TCP._usable(if found != [] or TCP._hostname(Sys.addr(h), n) == 0 do found else TCP._dns(h) end)
      end
    end
  end
# Windows: the addresses of a name as Go's net has them there, from
# GetAddrInfoW (pseudo call 1000107 of the Windows layer, spec/windows.md).
#: _wresolve/1 needs _wgot/3
  def _wresolve(name: string): list[string] do
    room = String.duplicate("\x00", 8192)
    r = Sys.call(1000107, Sys.addr(name <> "\x00"), Sys.addr(room), 8192)
    if r <= 0 do [] else TCP._wgot(Sys.addr(room), r, []) end
  end
#: _wgot/3 needs Enum.reverse/1
  def _wgot(p: integer, n: integer, done: list[string]): list[string] do
    if n == 0 do Enum.reverse(done) else TCP._wgot(p + 1 + Sys.byte(p), n - 1, [Sys.text(p + 1, Sys.byte(p)) | done]) end
  end
# An address as text: host:port, the host of an IPv6 address in brackets.
#: _show/1 needs _host/1 _saport/1
  def _show(a: string): string do
    h = TCP._host(a)
    port = TCP._saport(a)
    if Sys.find(Sys.addr(h), byte_size(h), 58) >= 0 do "[#{h}]:#{port}" else "#{h}:#{port}" end
  end
# Its host alone, as Go's net.IP writes one.
#: _host/1 needs Enum.take/2 _run/4 _sagroups/2 _six/4 _zonename/1
  def _host(a: string): string do
    p = Sys.addr(a)
    if Sys.byte(p) == 2 do "#{Sys.byte(p + 4)}.#{Sys.byte(p + 5)}.#{Sys.byte(p + 6)}.#{Sys.byte(p + 7)}" else
      g = TCP._sagroups(p, 0)
      if Enum.take(g, 6) == [0, 0, 0, 0, 0, 65535] do "#{Sys.byte(p + 20)}.#{Sys.byte(p + 21)}.#{Sys.byte(p + 22)}.#{Sys.byte(p + 23)}" else
        {at, run} = TCP._run(g, 0, {-1, 0}, {-1, 0})
        zone = rem(Sys.peek(p + 24), 4294967296)
        TCP._six(g, 0, if run < 2 do -1 else at end, run) <> (if zone == 0 do "" else "%" <> TCP._zonename(zone) end)
      end
    end
  end
# The longest run of zero groups, the first of several: where and how long.
#: _run/4
  def _run(g: list[integer], i: integer, now: tuple[integer, integer], best: tuple[integer, integer]): tuple[integer, integer] do
    {a, n} = now
    better = if n > elem(best, 1) do now else best end
    case g do
      [] -> better
