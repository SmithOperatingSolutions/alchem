  end
#: _tcpask/4 needs Port._head/3 _answer/2 _block/3 _close/2 _dial1/3 _exact/5 _write/5
  def _tcpask(g: integer, server: string, q: string, d: integer): tuple[integer, list[string]] do
    blank: list[string] = []
    fd = TCP._dial1(g, server, d)
    if fd < 0 do {-1, blank} else
      b = TCP._block(g, fd, 2)
      out = Port._head(byte_size(q), 2, q)
      sent = TCP._write(g, b, Sys.addr(out), byte_size(out), d)
      Sys.poke(b + 120, 0)
      size = if sent != "" do "" else TCP._exact(g, b, d, 2, 0) end
      reply = if size == "" do "" else TCP._exact(g, b, d, Sys.byte(Sys.addr(size)) * 256 + Sys.byte(Sys.addr(size) + 1), 0) end
      TCP._close(g, b)
      if reply == "" do {-1, blank} else TCP._answer(reply, Sys.byte(Sys.addr(q)) * 256 + Sys.byte(Sys.addr(q) + 1)) end
    end
  end
# The addresses a name has for one kind of address, asked of the servers
# in turn, each waited for wait seconds, tries times over: the code (0, 3,
# or -1 when no server answered) and the addresses.
#: _lookup/5 needs Process._due/2 Process._g/0 _ask/4 _question/3 _s/0
  def _lookup(servers: list[string], all: list[string], name: string, kind: integer, o: tuple[integer, integer]): tuple[integer, list[string]] do
    g = Process._g()
    {wait, tries} = o
    blank: list[string] = []
    case servers do
      [] -> if tries <= 1 do {-1, blank} else TCP._lookup(all, all, name, kind, {wait, tries - 1}) end
      [server | rest] ->
        s = TCP._s() + 512
        Sys.call(318, s, 2, 0)
        q = TCP._question(name, kind, Sys.byte(s) * 256 + Sys.byte(s + 1))
        if q == "" do {3, blank} else
          {code, found} = TCP._ask(g, server, q, Process._due(g, wait * 1000))
          if code == 0 or code == 6 do {div(code, 2), found} else TCP._lookup(rest, all, name, kind, o) end
        end
    end
  end
# The addresses the name servers give a name, IPv4 before IPv6: the name
# as it is and with each domain of the search list, in the order the C
# library tries them.
#: _dns/1 needs Enum.filter/2 Enum.map/2 String.split/2 _file/1 _resolv/1 _sub/3 _tryall/3
  def _dns(h: string): list[string] do
    {servers, search, {dots, wait, tries}} = TCP._resolv(TCP._file("/etc/resolv.conf"))
    n = byte_size(h)
    rooted = n > 0 and Sys.byte(Sys.addr(h) + n - 1) == 46
    bare = if rooted do TCP._sub(h, 0, n - 1) else h end
    has = length(String.split(bare, ".")) - 1
    by0 = Enum.map(Enum.filter(search, fn d -> d != "." end), fn d -> bare <> "." <> d end)
    names = if rooted or bare == "" do [bare] else if has >= dots do [bare] ++ by0 else by0 ++ [bare] end end
    TCP._tryall(servers, names, {wait, tries})
  end
#: _tryall/3 needs Process._g/0 _lookup/5
  def _tryall(servers: list[string], names: list[string], o: tuple[integer, integer]): list[string] do
    case names do
      [] -> []
      [name | rest] ->
        {a, four} = TCP._lookup(servers, servers, name, 1, o)
        {b, six} = if a != 0 do {a, four} else TCP._lookup(servers, servers, name, 28, o) end
        if a < 0 or b < 0 do Sys.poke(Process._g() + 384, 1) end
        if four ++ six != [] do four ++ six else TCP._tryall(servers, rest, o) end
    end
  end
