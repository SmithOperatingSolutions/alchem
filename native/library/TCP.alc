#: _usable/1 needs Enum.filter/2 Enum.map/2 _reach/1
  def _usable(l: list[string]): list[string] do
    if length(l) < 2 do l else
      marked = Enum.map(l, fn a -> {TCP._reach(a), a} end)
      pick = fn(way: integer, size: integer): list[string] do Enum.map(Enum.filter(marked, fn {r, a} -> r == way and byte_size(a) == size end), fn {r, a} -> a end) end
      pick(1, 28) ++ pick(1, 16) ++ pick(0, 28) ++ pick(0, 16)
