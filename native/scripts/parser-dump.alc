defmodule ParseNative do
  import "../tools/alchem-parse.alc"
  import "../tools/alchem-json.alc"
  def main() do
    Enum.each(System.argv(), fn path ->
      case File.read(path) do
        error(_) -> IO.puts(path <> " unreadable")
        ok(text) ->
          case AlchemParse.parse(text) do
            error(why) -> IO.puts("[" <> AlchemJson.quoted(path) <> ",\"error\"," <> AlchemJson.quoted(why) <> "]")
            ok(tree) -> IO.puts("[" <> AlchemJson.quoted(path) <> "," <> AlchemJson.encode(tree) <> "]")
          end
      end
    end)
  end
end
