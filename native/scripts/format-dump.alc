defmodule FormatNative do
  import "../tools/alchem-format.alc"
  import "../tools/alchem-json.alc"
  def main() do
    Enum.each(System.argv(), fn path ->
      case File.read(path) do
        error(_) -> IO.puts(path <> " unreadable")
        ok(text) ->
          case AlchemFormat.format(text) do
            error(why) -> IO.puts("[" <> AlchemJson.quoted(path) <> ",\"error\"," <> AlchemJson.quoted(why) <> "]")
            ok(formatted) -> IO.puts("[" <> AlchemJson.quoted(path) <> "," <> AlchemJson.quoted(formatted) <> "]")
          end
      end
    end)
  end
end
