#!/usr/bin/env python3
"""Run a native Windows program under Wine (spec/windows.md).

    scripts/run-windows PROGRAM.exe [ARGS...]

Wine runs on Linux, so a `syscall` left in a Windows image would make a
Linux system call there and seem to work, where Windows would take it for
its own. A seccomp filter therefore ends the process (SIGSYS) at any system
call made from the program's image, 0x3C0000 up to its SizeOfImage: every
one must be ud2, made by the Windows layer with kernel32.

Any other PE file (the pinned compiler's windows/amd64 programs, which are
the reference) runs without the filter.

WINEPREFIX defaults to build/wine (made on first use), WINEDEBUG to -all."""
import ctypes
import os
from pathlib import Path
import struct
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
BASE = 0x3C0000

PR_SET_NO_NEW_PRIVS = 38
SECCOMP_SET_MODE_FILTER = 1
SYS_SECCOMP = 317
BPF_LD_W_ABS = 0x20
BPF_JEQ_K = 0x15
BPF_JGE_K = 0x35
BPF_RET_K = 0x06
SECCOMP_RET_ALLOW = 0x7FFF0000
SECCOMP_RET_KILL_PROCESS = 0x80000000


def image_size(path):
    with open(path, 'rb') as f:
        head = f.read(4096)
    if head[:2] != b'MZ':
        sys.exit(f'run-windows: {path} is not a PE file')
    pe = struct.unpack_from('<I', head, 0x3C)[0]
    if head[pe:pe + 4] != b'PE\0\0':
        sys.exit(f'run-windows: {path} is not a PE file')
    optional = pe + 24
    base = struct.unpack_from('<Q', head, optional + 24)[0]
    if base != BASE:
        return None
    return struct.unpack_from('<I', head, optional + 56)[0]


def install(low, high):
    def insn(code, jt, jf, k):
        return struct.pack('<HBBI', code, jt, jf, k)
    # seccomp_data: nr, arch, instruction_pointer (offset 8, low word first).
    program = b''.join([
        insn(BPF_LD_W_ABS, 0, 0, 12),           # ip >> 32
        insn(BPF_JEQ_K, 0, 4, 0),               # not 0: allow
        insn(BPF_LD_W_ABS, 0, 0, 8),            # ip & 0xffffffff
        insn(BPF_JGE_K, 0, 2, low),             # below the image: allow
        insn(BPF_JGE_K, 1, 0, high),            # past it: allow
        insn(BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS),
        insn(BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW),
    ])
    count = len(program) // 8
    buffer = ctypes.create_string_buffer(program)
    fprog = struct.pack('<HxxxxxxQ', count, ctypes.addressof(buffer))
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        sys.exit('run-windows: prctl failed')
    holder = ctypes.create_string_buffer(fprog)
    libc.syscall.restype = ctypes.c_long
    if libc.syscall(SYS_SECCOMP, SECCOMP_SET_MODE_FILTER, 0, holder) != 0:
        sys.exit(f'run-windows: seccomp failed: {os.strerror(ctypes.get_errno())}')


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    program = sys.argv[1]
    size = image_size(program)
    env = dict(os.environ)
    env.setdefault('WINEDEBUG', '-all')
    prefix = Path(env.setdefault('WINEPREFIX', str(ROOT / 'build/wine')))
    if not (prefix / 'system.reg').exists():
        prefix.mkdir(parents=True, exist_ok=True)
        subprocess.run(['wineboot', '-i'], env=env, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        subprocess.run(['wineserver', '-w'], env=env, check=False)
    if size is not None:
        install(BASE, BASE + size)
    os.execvpe('wine', ['wine', program, *sys.argv[2:]], env)


if __name__ == '__main__':
    main()
