#!/usr/bin/env bash
# Run a command with a ceiling on memory and time, so that a runaway program
# (an endless stream collected into a list, a compile that explodes) is
# killed alone instead of taking the machine down with it.
#
#   scripts/limited COMMAND [ARGS...]
#   ALCHEM_MEMORY=6G    memory for the command and everything it starts
#   ALCHEM_SECONDS=600  wall-clock seconds
#
# The command runs in a systemd user scope with MemoryMax and no swap; when
# no user manager is reachable it falls back to an address-space limit, and
# where there is no prlimit (macOS) to scripts/bounded.py, which watches the
# memory the command is charged for and kills it past the ceiling.
set -euo pipefail
memory="${ALCHEM_MEMORY:-6G}"
seconds="${ALCHEM_SECONDS:-600}"
if systemd-run --user --scope --quiet -p MemoryMax=1G true 2>/dev/null; then
  exec systemd-run --user --scope --quiet -p MemoryMax="$memory" -p MemorySwapMax=0 timeout --signal=KILL "$seconds" "$@"
fi
# In a container with a ceiling of its own (scripts/verify-arm64.sh) that one
# holds: the time alone.
if [[ -f /.dockerenv && -r /sys/fs/cgroup/memory.max && "$(cat /sys/fs/cgroup/memory.max)" != max ]]; then exec timeout --signal=KILL "$seconds" "$@"; fi
if command -v prlimit >/dev/null && command -v numfmt >/dev/null; then
  bytes="$(numfmt --from=iec "$memory")"
  exec prlimit --as="$bytes" timeout --signal=KILL "$seconds" "$@"
fi
# Neither (macOS, which keeps no address-space limit): a watch on what the
# command and its group are charged for (scripts/bounded.py).
python=python3; [[ -x /usr/bin/python3 ]] && python=/usr/bin/python3
exec "$python" "$(dirname "${BASH_SOURCE[0]}")/bounded.py" --memory "$memory" --seconds "$seconds" "$@"
