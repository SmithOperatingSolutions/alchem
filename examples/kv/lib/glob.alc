defmodule Glob do
  @moduledoc """
  Matches keys against patterns where * stands for any text and ? for one
  character.
  """

  @doc """
      alx> Glob.match?("user:*", "user:42")
      true
      alx> Glob.match?("h?llo", "hello")
      true
      alx> Glob.match?("h?llo", "hllo")
      false
  """
  def match?(pattern: string, text: string): boolean do
    matches(String.codepoints(pattern), String.codepoints(text))
  end

  defp matches([]: list[string], []: list[string]): boolean do
    true
  end

  defp matches(["*" | rest], text) do
    matches(rest, text) or (text != [] and matches(["*" | rest], tl(text)))
  end

  defp matches(["?" | rest], [_ | more]) do
    matches(rest, more)
  end

  defp matches([char | rest], [other | more]) do
    char == other and matches(rest, more)
  end

  defp matches(_, _) do
    false
  end
end
